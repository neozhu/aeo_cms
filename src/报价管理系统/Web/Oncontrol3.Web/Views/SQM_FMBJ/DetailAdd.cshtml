@section pagespecific {
    <script type="text/javascript">
        var username;
        $(document).ready(function () {
            var user = '@Oncontrol3.Web.Helpers.SQMHelper.getStaffKey()';
            if (user.length < 1) {
                layer.alert('系统登录已超时，请重新登录', { icon: 2 });
            }
            else {
                username = user;
                //layer.alert('当前登录账户：' + user, { icon: 1 });
            }
            BindAutocompleteMDM();
            // 币种默认为美元
            $("#CURRENCY").select2('val', "CNY");
            //无基础的定价方式默认为绝对值，不可变
            if ("@ViewBag.wjc" == "True") {
                $("#CALCTYPE").select2('val', "A");
                $("#CALCTYPE").attr("disabled", "disabled");
            }
            // 清楚所有控件缓存
            $("#formmainadd").find("input,select,textarea").each(function () {
                $(this).attr("autocomplete", "off");
            });
            $(".form-date").datetimepicker({
                format: "yyyy/mm/dd",
                autoclose: true,
                todayBtn: true,
                todayHighlight: true,
                startView: 2,
                minView: 2,
                clearBtn: true,
                language: "zh-CN"
            });
            //基础数据长度判断
            $('input[datalen="datalen"]').change(function () {
                var calccode = $(this).attr("name");
                var dataval = $(this).val();
                //维护*的不用校验数据了
                if (dataval != "*") {
                    var valall = BindCalcVal(calccode, dataval);
                    var valok = valall.substring(0, 1);
                    var len = valall.substring(1, valall.length);
                    if (valok == "1") {
                        $(this).parent().parent().find(".cdinvalid").remove();
                        $(this).css("border-color", "#a90329");
                        $(this).parent().removeClass('state-success').addClass("state-error");
                        $(this).closest("label").after("<em for=" + calccode + " class='cdinvalid'>整数位最长" + len + "位，请确认！</em>");
                    } else if (valok == "2") {
                        $(this).parent().parent().find(".cdinvalid").remove();
                        $(this).css("border-color", "#a90329");
                        $(this).parent().removeClass('state-success').addClass("state-error");
                        $(this).closest("label").after("<em for=" + calccode + " class='cdinvalid'>小数位最长" + len + "位，请确认！</em>");
                    } else if (valok == "3") {
                        $(this).parent().parent().find(".cdinvalid").remove();
                        $(this).css("border-color", "#a90329");
                        $(this).parent().removeClass('state-success').addClass("state-error");
                        $(this).closest("label").after("<em for=" + calccode + " class='cdinvalid'>数据最长" + len + "位，请确认！</em>");
                    } else if (valok == "4") {
                        $(this).parent().parent().find(".cdinvalid").remove();
                        $(this).css("border-color", "#a90329");
                        $(this).parent().removeClass('state-success').addClass("state-error");
                        $(this).closest("label").after("<em for=" + calccode + " class='cdinvalid'>请维护数字型数据！</em>");
                    } else {
                        $(this).css("border-color", "#7dc27d");
                        $(this).parent().parent().find(".cdinvalid").remove();
                    }
                } else {
                    $(this).css("border-color", "#7dc27d");
                    $(this).parent().parent().find(".cdinvalid").remove();
                }
            });
            if ($("#CALCTYPE").val() == "B") {
                $("#CALCUNIT").val("@ViewBag.calcunit");
            } else {
                $("#CALCUNIT").val("票");
            }
            if ("@ViewBag.djfsrid" != "") {
                $("#DJFSRID").select2('val', "@ViewBag.djfsrid");
            }
            if ("@ViewBag.gdzkey" != "") {
                $("#GDZKEY").select2('val', "@ViewBag.gdzkey");
            }
            if ("@ViewBag.gdzkey" != "0") {
                $(".gdzdiv").show();
            } else {
                $(".gdzdiv").hide();
            }
            if ("@ViewBag.gdzrid" != "") {
                $("#GDZRID").select2('val', "@ViewBag.gdzrid");
            }
        });
        //定价方式change事件
        $("#DJFSRID").change(function () {
            getCalcname(1, null);
        });
        //高低值change事件
        $("#GDZRID").change(function () {
            var gdzrid = $(this).val();
            getCalcname(2, gdzrid);
        });
        //计算方式change事件
        $("#CALCTYPE").change(function () {
            var calctype = $(this).val();
            if (calctype == "A") {
                $("#CALCUNIT").val("票");
            } else {
                $("#CALCUNIT").val("@ViewBag.calcunit");
            }
        });
        //计算基础字段展示
        function getCalcname(key, gdzrid) {
            var gdzkey = '';
            var djfsrid = $("#DJFSRID").val();
            if (djfsrid == undefined) {
                djfsrid = '';
            }
            if (gdzrid == undefined || gdzrid == null) {
                gdzrid = '';
            }
            if (key == 2) {
                gdzkey = $("#GDZKEY").val();
            }
            $("#page1").load("/SQM_FMBJ/DetailAdd?djrid=" + $("#DJRID").val() + "&bjrid=" + $('#BJRID').val() + "&djfsrid=" + djfsrid + "&gdzkey=" + gdzkey + "&gdzrid=" + gdzrid);
            $("#bjAdd").modal("show");
        }

        // 保存
        function dosave() {
            toastr.clear();
            toastr.remove();
            //$(".row").height(105);
            if (!$("#formmainadd").valid()) {
                return;
            }
            if ($("#formmainadd").find(".cdinvalid").length > 0) {
                toastr.error("数据维护错误，请确认！");
                return;
            }
            if (isNaN($("#BJPRICE").val())) {
                toastr.error("请维护有效报价数据！");
                return;
            }
            //var nowtime = new Date(new Date() - 1000 * 60 * 60 * 24);
            //var starttime = new Date(Date.parse($("#STARTDATE").val()));
            //if (starttime < nowtime) {
            //    toastr.error("起始日期不能小于当前日期！");
            //    return;
            //}
            if ($("#ENDDATE").val().length == 0) {
                $("#ENDDATE").val('9999/12/31');
            }
            if ($("#STARTDATE").val() >= $("#ENDDATE").val()) {
                toastr.error("截止日期不能小于或等于起始日期！");
                return;
            }
            toastr.info("数据保存中，请稍候...");
            var postdata = GetWebControls("#formmainadd");
            var djfsrid = $("#DJFSRID").val();
            if (djfsrid == undefined) {
                djfsrid = '';
            }
            var gdzrid = $("#GDZRID").val();
            if (gdzrid == undefined) {
                gdzrid = '';
            }
            try {
                $("#btnSave").attr("disabled", "disabled");
                $.ajax({
                    url: "/SQM_FMBJ/PurSave",
                    type: "post",
                    data: {
                        'postdata': JSON.stringify(postdata),
                        'djrid': $("#DJRID").val(),
                        'bjrid': $("#BJRID").val(),
                        'djfsrid': djfsrid,
                        'gdzrid': gdzrid,
                        'jxjc': "@ViewBag.jxjc",
                        'ifmb': request("ifmb"),
                    },
                    dataType: "json",
                    success: function (data) {
                        toastr.clear();
                        toastr.remove();
                        if (data.Success) {
                            toastr.success(data.Message);
                            $("#bjAdd").modal("hide");
                            window.location.href = window.location.href;
                        } else {
                            toastr.error(data.Message);
                        }
                    },
                    error: function (data) {
                        if (!!data.responseText) {
                            alert(data.responseText);
                        } else {
                            window.alert("请求失败！");
                        }
                    }
                });
            } catch (e) {
                window.alert("保存失败，请重试");
            } finally {
                $("#btnSave").removeAttr("disabled");
            }
        };
        function GetWebControls(element) {
            var postdata = {};
            $(element).find('input,select,textarea').each(function (r) {
                var id = $(this).attr('id');
                var value = $(this).val();
                var type = $(this).attr('type');
                if ($(this).attr("mdmkey") == "") {
                    id = id.substring(0, id.length - 2);
                    var idc = id + "C";
                    $("#" + idc).val(value);
                    postdata[idc] = value;
                } else if ($(this).attr("mdmkey") != undefined) {
                    id = id.substring(0, id.length - 2);
                    $("#" + id).val(value);
                }
                postdata[id] = value;
            });
            postdata["MODIFYUSER"] = username;
            return postdata;
        }
        // 控件绑定数据源
        function BindAutocompleteMDM() {
            $("[mdmtype='MDM']").each(function () {
                if ($("#kyyf").val()) {
                    AutocompleteMDM($(this).attr("id"), "kygj");
                } else {
                    AutocompleteMDM($(this).attr("id"));
                }
            });
            $("[mdmtype='MDMJC']").each(function () {
                AutocompleteMDMJC($(this).attr("id"));
            });
            $("[mdmtype='MDMJC1']").each(function () {
                AutocompleteMDMJCDa($(this).attr("id"));
            });
            $("[mdmtype='MDMGK']").each(function () {
                AutocompleteMDMGK($(this).attr("id"));
            });
            $("[mdmtype='MDMBP']").each(function () {
                AutocompleteMDMBP($(this).attr("id"));
            });
            $("input").change(function () {
                $(this).css("background-color", "#FFFFCC");
            });
        }
        //计算基础数值长度校验
        function BindCalcVal(calccode, dataval) {
            var checkval = "";
            $.ajax({
                url: "@Url.Action("CheckData")",
                data: {
                    calccode: calccode,
                    dataval: dataval,
                },
                dataType: "json",
                async: false,
                success: function (data) {
                    checkval = JSON.stringify(data);
                }
            });
            return checkval;
        }
    </script>
