    //下拉框产品服务费目展示
    function showAllData(sybcode) {
        var prdmsg = "";
        var srvmsg = "";
        var feemsg = "";
        srvArray = [];
        feeArray = [];
        var PRDArray = [];
        //通过主键得到产品信息
        $.ajax({
            url: "@Url.Action("GetAllByRid")",
            data: {
                sybcode: sybcode,
            },
            dataType: "json",
            async: false,
            success: function (data) {
                PRDArray = data[0];
                srvArray = data[1];
                feeArray = data[2];
            }
        });
        var displayPrdCode = [];
        var displaySrvCode = [];
        //产品渲染,PRDArray 为数组包含数组，索引0为code，索引为1为name
        for (var i = 0; i < PRDArray.length; i++) {
            prdmsg += "<div class='row'><section class='col-xs-6 col-sm-12'><span class='prdspan' name='PRD' prdcode=" + PRDArray[i][0] + ">" + PRDArray[i][1] + "</span></section></div>";
        }
        $("#ALLPRD").find("*").remove();
        $("#ALLPRD").append(prdmsg);
        //返回值为多个数组，数组【0】为产品代码，【1】为服务代码，【2】为服务名称
        for (var i = 0; i < srvArray.length; i++) {
            srvmsg += '<section class="col-xs-6 col-sm-12 SRV"><span class="srvspan" name="SRV"  prdcode=' + srvArray[i][0] + ' srvcode=' + srvArray[i][1] + '>' + srvArray[i][2] + '</span></section>';
        }
        $("#ALLSRV").find("*").remove();
        $("#ALLSRV").append(srvmsg);
        //返回值为多个数组，数组【0】为产品代码，【2】为服务代码，【4】为费目名称 【6】 为必选费目标价
        for (var j = 0; j < feeArray.length; j++) {
            if (displayFeeCodeArr.indexOf(feeArray[j][4]) >= 0) {
                if (displayPrdCode.indexOf(feeArray[j][0]) < 0) {
                    displayPrdCode.push(feeArray[j][0]);
                }
                if (displaySrvCode.indexOf(feeArray[j][2]) < 0) {
                    displaySrvCode.push(feeArray[j][2]);
                }
                feemsg += '<section class="col-xs-6 col-sm-4 FEE"><span class="feespan"  name="FEE" type="' + feeArray[j][7] + '" prdcode = "' + feeArray[j][0] + '" srvcode = ' + feeArray[j][2] + ' feecode = ' + feeArray[j][4] + '>' + feeArray[j][5] + '</span></section>';
            }
        }
        // 隐藏产品
        $(".prdspan").each(function () {
            if (displayPrdCode.indexOf($(this).attr("prdcode")) < 0) {
                $(this).parent().parent().css("display", "none");
            }
        });
        $("#ALLFEE").find("*").remove();
        $("#ALLFEE").append(feemsg);

        //点击产品字，显示服务的字并给背景色
        $(".prdspan").click(function () {
            //先清掉所有的背景色
            $(this).parent().parent().parent().find('.prdspan').removeClass('checkme')
            //隐藏所有服务
            $('span[name=SRV]').parent().css('display', 'none');
            //隐藏所有的费目
            $('span[name=FEE]').parent().css('display', 'none');
            var prdcode = $(this).attr('prdcode');
            $(this).addClass('checkme');
            $("#ALLSRV").css('display', 'block');
            $('span[name=SRV][prdcode=' + prdcode + ']').parent().css('display', 'block');
            $(".srvspan").each(function () {
                var srvcode = $(this).attr("srvcode");
                if (displaySrvCode.indexOf($(this).attr("srvcode")) < 0) {
                    $(this).parent().css("display", "none");
                }
            });
        });
        // 点击服务字显示，当前服务对应的费目,并且给服务上背景色
        $('.srvspan').click(function () {
            //先清掉所有的背景色
            $(this).parent().parent().parent().find('.srvspan').removeClass('checkme');
            //隐藏所有的费目
            $('span[name=FEE]').parent().css('display', 'none');
            var srvcode = $(this).attr('srvcode');
            var prdcode = $(this).attr('prdcode');
            $(this).addClass('checkme');
            $("#ALLFEE").css('display', 'block');
            $('span[name=FEE][srvcode=' + srvcode + '][prdcode = ' + prdcode + ']').parent().css('display', 'block');
        });
        // 点击费目，进入询价新增页面，分海运费和空运费
        $('.feespan').click(function () {
            var prdcode = $(this).attr("prdcode");
            var srvcode = $(this).attr("srvcode");
            var feecode = $(this).attr("feecode");
            var orgcode = $("#orgcode").val();
            if ($(this).attr("type") == "0") {// 海运
                document.location.href = "/SQM_ENQUIRY_HKY/HyEdit?code=" + prdcode + "," + srvcode + "," + feecode + "," + orgcode;
            } else if ($(this).attr("type") == "1") {// 空运
                document.location.href = "/SQM_ENQUIRY_HKY/KyEdit?code=" + prdcode + "," + srvcode + "," + feecode + "," + orgcode;
            } else {
                alert("消息提示", "所选费目不支持询价");
            }
        });
    }
