@{
    ViewBag.Title = "费目详情";
    Layout = "~/Views/Shared/_LayoutTM.cshtml";
}
<style>
    body {
        background-color: rgb(248,248,248);
    }

    .active {
        background-color: rgb(19,100,181) !important;
    }

    .head {
        margin-top:6px;
        height: 50px;
        background-color: rgb(19,100,181);
    }

        .head span {
            line-height: 98px;
            font-size: 14px;
            padding: 0px 10px 15px 10px;
            color: #ffffff;
            margin-right: 35px;
            cursor: pointer;
        }

    /*.head .active {
            border-bottom: 2px solid #F8F8F8;
        }*/

    .label {
        color: #4d5d70 !important;
    }

    .inf {
        line-height: 40px;
    }

    .tel-num {
        color: #000;
        font-size: 24px;
        font-weight: bold;
    }

    .dis {
        color: #999;
    }

    #modelname {
        margin-left: 10px;
        font-size: 18px;
    }

    .controls {
        position: relative;
    }

        .controls input[type=radio] {
            opacity: 0;
        }

        .controls label {
            position: absolute;
            top: 5px;
            left: 12px;
            width: 12px;
            height: 12px;
            border-radius: 50%;
            border: 1px solid rgb(223,223,223);
            background-color: rgb(241,241,241);
        }

        .controls input[type=radio]:checked + label:after {
            content: "";
            position: absolute;
            left: 3px;
            bottom: 3px;
            width: 4px;
            height: 4px;
            border: 2px solid rgb(40,129,197);
            background-color: rgb(40,129,197);
            border-radius: 50%;
        }

    .clear {
        background-color: rgb(195,195,195);
        color: #ffffff;
        width: 70px;
    }

    .nmpd-target {
        border: 1px solid rgb(153, 153, 153);
        border-image: none;
        width: 50px;
        height: 30px;
    }

    .label-default {
        background-color: #fff;
        color: #666;
        font-weight: 100;
    }
    /********************************************/
    .font {
        font-size: 20px;
        color: black;
        padding-top: 10px;
    }

    .bjok {
        color: green;
    }

    .bjover {
        color: #f0ad4e;
    }

    .card-box {
        width: 100%;
        /*height: 100px;*/
        float: left; 
        border: 0px solid #ccc;
        background-color: #fff;
        border-radius: 1px;
        margin-top: -15px;
        overflow: hidden;
        position: relative;
        /*padding-bottom: 10px;*/
    }

    .card-box-content {
        margin-top: 10px;
        padding: 6px 6px;
        font-size: 14px;
        color: #4d5d70;
    }

        .card-box-content div {
            /*overflow: hidden;*/
            white-space: nowrap;
            text-overflow: ellipsis;
            margin-top: 2px;
        }

            /*.card-box-content .inf {
            font-weight: bold;
        }*/

            .card-box-content div .tel-num {
                width: 80px;
            }

            .card-box-content div .pickup_btn {
                float: right;
                margin-left: 56px;
                font-size: 9px;
                line-height: 18px;
                width: 70px;
                height: 18px;
                background-color: #319adf;
                color: white;
                text-align: center;
                border-radius: 8px;
            }

    .btns {
        margin-top: 8px;
        margin-bottom: 8px;
    }

    .ColVis {
        display: none;
    }

    .htmlstr {
        position: absolute;
        width: 1400px;
    }

    #numpad4column tbody td {
        height: 75px;
    }

    .dt-toolbar {
        padding: 0px 0px;
        border-bottom: 0px solid #ccc;
        background: #fff
    }
    .dban .col-md-1 {
        width: 12%;
    }
    /*********************************/
    .col-md-8 .syb {
        /*padding-bottom: 10px;*/
        width: 25%;
        display: inline-block;
    }

        .col-md-8 .syb .active {
            background-color: #2e7bcc;
            color: white;
        }

        .col-md-8 .syb .sybname {
            cursor: pointer;
        }

    .fstbox {
        height: 100%;
        padding-bottom: 10px;
        padding-top: 10px;
    }

    .FEE {
        margin-bottom: 15px;
        display: none;
    }

    .open > .dropdown-menu {
        position: inherit;
    }

    .checkme {
        background-color: yellow;
    }

    /*.srvspan {
        margin-left: 20px;
    }*/

    span[name='PRD'], span[name='SRV'], span[name='FEE'] {
        cursor: pointer;
        white-space: normal;
    }

    .panel-body {
        padding-top: 2px !important;
        padding-left: 15px !important;
        padding-right: 15px !important;
        padding-bottom: 10px !important;
        max-height: 500px;
        overflow-y: scroll;
    }
</style>
