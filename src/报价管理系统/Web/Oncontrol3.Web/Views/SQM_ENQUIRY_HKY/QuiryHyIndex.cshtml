@section pagespecific {
<script src="~/Content/QO/scripts/framework.js?v=@DateTime.Now.ToString("yyyyMMddhhmmss")"></script>
<script src="~/Content/QO/scripts/Ewin.js"></script>
<script src="~/Content/QO/toastr/toastr.min.js"></script>
<link rel="stylesheet" href="~/Content/QO/toastr/toastr.min.css">
<script src="~/Content/QO/layer/layer.js"></script>
<script src="/js/lib/jquery.plug-ins.js" type="text/javascript"></script>
<script src="/scripts/plugin/datatables/dataTables.colReorder.min.js" type="text/javascript"></script>
<script src="/scripts/plugin/datatables/dataTables.colVis.min.js" type="text/javascript"></script>
<script src="/scripts/plugin/datatables/dataTables.fixedColumns.min.js" type="text/javascript"></script>
<script src="/scripts/plugin/datatables/dataTables.fixedHeader.js" type="text/javascript"></script>
<link href="~/Content/QO/scripts/bootstrap-fileinput-master/css/fileinput.min.css" rel="stylesheet">
<script src="~/Content/QO/scripts/bootstrap-fileinput-master/js/fileinput.min.js"></script>
<script src="~/Content/QO/scripts/bootstrap-fileinput-master/js/locales/zh.js"></script>
<link href="~/Content/QO/scripts/bootstrap-datetimepicker/css/bootstrap-datetimepicker.min.css" rel="stylesheet">
<script src="~/Content/QO/scripts/bootstrap-datetimepicker/js/bootstrap-datetimepicker.min.js"></script>
<script type="text/javascript" src="~/Content/QO/scripts/bootstrap-datetimepicker/js/locales/bootstrap-datetimepicker.zh-CN.js" charset="UTF-8"></script>
<script src="~/Scripts/plugin/jquery-validate/jquery.validate.min.js"></script>
<link rel="stylesheet" href="~/Content/QO/scripts/jQueryNumPad/jquery.numpad.css">
<script src="~/Content/QO/scripts/jQueryNumPad/jquery.numpad.js"></script>
<link href="~/Content/QO/scripts/icheck/skins/square/blue.css" rel="stylesheet">
<script src="~/Content/QO/scripts/icheck/icheck.min.js"></script>

<script type="text/javascript">
    //全局变量
    var username;
    var IsEdit = false;
    var PRDArray = [];
    var srvArray = [];
    var feeArray = [];
    var displayFeeCodeArr = [];
    var xqlxObj = { "0": "整箱进口", "1": "整箱出口" };
    var ywnrObj = { "0": "海运", "1": "海外服务", "2":"公路运输" };
    var xjlxObj = { "0": "单询", "1": "月度", "2": "标案" };
    var cqObj = { "1": "星期一", "2": "星期二", "3": "星期三", "4": "星期四", "5": "星期五", "6": "星期六", "0": "星期日" };
    var pmObj = {};// 品名字典
    var myfsObj = {};// 贸易方式字典
    var pmArray = @Html.Raw(ViewBag.PM);
    pmArray.forEach(item => pmObj[item.CODE] = item.NAME);
    var myfsArray = @Html.Raw(ViewBag.MYFS);
    myfsArray.forEach(item => myfsObj[item.CODE] = item.NAME);
    var displayFeeCode = @Html.Raw(ViewBag.DisplayFeeCode);
    displayFeeCode.forEach(item => displayFeeCodeArr.push(item.CODE));
    //判断是否选择组织，未选组织，显示提示按钮
    function BanPop() {
        alert("消息提示", "请选择组织");
    }
    // 组织选择框change监控
    $("#ORGRID").on("change", function () {
        var orgcode = $(this).val();
        if (orgcode != "" && orgcode != null && typeof (orgcode) != "undefined") {
            $("#orgcode").val(orgcode);
            $("#realBtn").css("display", "block");
            $("#messageBtn").css("display", "none");
        } else {
            $("#realBtn").css("display", "none");
            $("#messageBtn").css("display", "block");
        }
    });
    // 海运列
    var columnshy = [
        { "title": "创建时间", "data": "CREATETIME", "bVisible": false },
        {
            "title": "操作", "data": "RID", "width": "10", "sortable": false,
            render: function (data, type, row, meta) {
                return '<button title="编辑" class="btn btn-xs btn-default" onclick=doEditHy(\"' + data + '\") ><i class="fa fa-pencil"></i></button>';
            }
        },
        {
            "title": "询价单号", "data": "SERIALNUMBER","width":"130",
            render: function (data, type, row, meta) {
                if (data == null) {
                    data = "";
                }
                var hwlb = row.HWLB == null ? "" : row.HWLB;
                var ysfs = row.YSFS == null ? "" : row.YSFS;
                var yffs = row.YFFS == null ? "" : row.YFFS;
                var cq = row.CQDATE == null ? "" : row.CQDATE;
                if (cq != "" && cq.indexOf(",") >= 0) {
                    var cqArr = cq.split(",");
                    cq = "";
                    cqArr.forEach(item => {
                        cq += cqObj[item] + ",";
                    });
                    cq = cq.substring(0, cq.length - 1);
                } else {
                    cq = row.CQDATE == null ? "" : cqObj[row.CQDATE];
                }
                var xqlx = row.XQLX == null ? "" : xqlxObj[row.XQLX];
                var ywlx = row.YWLX == null ? "" : ywnrObj[row.YWLX];
                var pm = row.PRODUCT == null ? "" : row.PRODUCT;
                var hl = row.HL == null ? "" : row.HL;
                var sblx = row.SBLX == null ? "" : row.SBLX;
                var sblxcode = row.SBLXCODE == null ? "" : row.SBLXCODE;
                var sblxvalue = sblxcode;
                var memo = row.MEMO == null ? "" : row.MEMO;
                var xjrq;
                if (row.CREATETIME == null || row.CREATETIME == undefined)
                    xjrq = "";
                else {
                    xjrq = new Date(formatDate(row.CREATETIME));
                    xjrq.setHours(xjrq.getHours() + 8);
                    xjrq = xjrq.Format("yyyy/MM/dd");
                }

                var dfrq = row.SPONSEDATE == null ? "" : row.SPONSEDATE;
                if (row.SPONSEDATE == null || row.SPONSEDATE == undefined)
                    dfrq = "";
                else {
                    dfrq = new Date(formatDate(row.SPONSEDATE));
                    dfrq.setHours(dfrq.getHours() + 8);
                    dfrq = dfrq.Format("yyyy/MM/dd");
                }
                var htmlStr = data + "<br>";
                htmlStr += "<div class='htmlstr' style='margin-top:5px'><div class='row' style='margin-left:0px;'><span style='font-weight: bold;'>运输方式：</span><span style='padding-right:15px;'>" + ysfs + "</span>";
                htmlStr += "<span style='font-weight: bold;'>业务类型：</span><span style='padding-right:15px;'>" + ywlx + "</span>";
                htmlStr += "<span style='font-weight: bold;'>运费方式：</span><span style='padding-right:15px;'>" + yffs + "</span>";
                htmlStr += "<span style='font-weight: bold;'>品名：</span><span style='padding-right:15px;'>" + pm + "</span>";
                htmlStr += "<span style='font-weight: bold;'>货量：</span><span style='padding-right:15px;'>" + hl + "</span>";
                htmlStr += "<span style='font-weight: bold;'>设备类型：</span><span style='padding-right:15px;'>" + sblxvalue + "</span>";
                htmlStr += "<span style='font-weight: bold;'>询价日期：</span><span style='padding-right:15px;'>" + xjrq + "</span>";
                htmlStr += "<span style='font-weight: bold;'>答复日期：</span><span style='padding-right:15px;'>" + dfrq + "</span>";
                htmlStr += "</div><div class='row' style='margin-left:0px;margin-top:5px;'>";
                htmlStr += "<span style='font-weight: bold;'>船期或时间段：</span><span style='padding-right:15px;'>" + cq + "</span>";
                htmlStr += "<span style='font-weight: bold;'>备注：</span><span style='padding-right:15px;'>" + memo + "</span>";
                htmlStr += "</div></div>";
                return htmlStr;
            }
        },
        { "title": "起运港", "data": "QYG", "width": "160"},
        { "title": "目的港", "data": "MDG", "width": "160" },
        {
            "title": "询价类型", "data": "XJLX", "width": "80",
            render: function (data, type, row, meta) {
                if (data != null) {
                    return xjlxObj[data];
                } else {
                    return "";
                }
            }
        },
        {
            "title": "询价状态", "data": "STATUS", "width": "45",
            render: function (data, type, row, meta) {
                if (data == "2") {
                    return "已答复";
                } else {
                    return "待答复";
                }
            }
        },
        { "title": "询价人", "data": "CREATEUSER", "width": "45" },
        {
            "title": "询价结果", "data": "FEECODE", "width": "45",
            render: function (data, type, row, meta) {
                if (row.STATUS == "1") {
                    return data;
                } else if (row.STATUS == "2") {
                    var djzbrid = row.MXDJZBRID == null ? (row.DJZBRID == null ? "" : row.DJZBRID) : row.MXDJZBRID;
                    var djrid = row.MXDJRID == null ? (row.DJRID == null ? "" : row.DJRID) : row.MXDJRID;
                    var djfsrid = row.MXDJFSRID == null ? (row.DJFSRID == null ? "" : row.DJFSRID) : row.MXDJFSRID;
                    var gdzrid = row.MXGDZRID == null ? (row.GDZRID == null ? "" : row.GDZRID) : row.MXGDZRID;
                    return '<a onclick=viewResult(\"' + djzbrid + '\",\"' + djrid + '\",\"' + djfsrid + '\",\"' + gdzrid + '\") style="text-decoration: underline;cursor: pointer;" >' + data + '</a>';
                }
            }
        }
    ];
    // 空运
    var columnsky = [
        { "title": "创建时间", "data": "CREATETIME", "bVisible": false },
        {
            "title": "操作", "data": "RID", "width": "10", "sortable": false,
            render: function (data, type, row, meta) {
                return '<button title="编辑" class="btn btn-xs btn-default" onclick=doEditKy(\"' + data + '\") ><i class="fa fa-pencil"></i></button>';
            }
        },
        {
            "title": "询价单号", "data": "SERIALNUMBER","width":"130",
            render: function (data, type, row, meta) {
                if (data == null || data == "") {
                    data = "";
                }
                //else {
                //    data = pmObj[data];
                //    if (typeof (data) == "undefined") {
                //        data = "";
                //    }
                //}
                var hwlb = row.HWLB == "0" ? "是" : "否"; //是否危险品
                var myfs = row.MYFS == null ? "" : myfsObj[row.MYFS]; //贸易方式
                var memo = row.MEMO == null ? "" : row.MEMO;
                var sponsedate = "";
                if (row.SPONSEDATE != null) {
                    sponsedate = new Date(row.SPONSEDATE);
                    sponsedate.setHours(sponsedate.getHours() + 8);
                    sponsedate = sponsedate.Format("yyyy-MM-dd");
                }
                var jgdate = "";
                if (row.JGDATE != null) {
                    jgdate = new Date(row.JGDATE);
                    jgdate.setHours(jgdate.getHours() + 8);
