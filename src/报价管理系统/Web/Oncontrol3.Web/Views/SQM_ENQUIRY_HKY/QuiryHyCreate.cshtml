    }

    .head {
        margin-top: 6px;
        height: 50px;
        background-color: rgb(19,100,181);
    }

        .head span {
            line-height: 98px;
            font-size: 14px;
            padding: 0px 10px 15px 10px;
            color: #ffffff;
            margin-right: 35px;
