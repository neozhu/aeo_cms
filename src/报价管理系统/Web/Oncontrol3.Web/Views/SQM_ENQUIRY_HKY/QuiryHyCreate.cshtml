    <script type="text/javascript">
        // 全局数据
        // 船期
        var cqList = [{ Code: '1', Name: '星期一' }, { Code: '2', Name: '星期二' }, { Code: '3', Name: '星期三' }, { Code: '4', Name: '星期四' },
            { Code: '5', Name: '星期五' }, { Code: '6', Name: '星期六' }, { Code: '0', Name: '星期日' }];
        // 设备类型
        var sblxList = @Html.Raw(ViewBag.SBLX);
        var IsEdit = false;
        // 导航
        $("#toxj").click(function () {
            location.href = "/SQM_ENQUIRY_HKY/QuiryHyIndex";
        });
        $("#tobjsy").click(function () {
            location.href = "/QM_Price/QM_PriceIndex";
        });
        $("#tobjmb").click(function () {
            location.href = "/SQM_BJMB/SQM_BJMBIndex";
        });
        $("#tocpzs").click(function () {
            location.href = "/SQM_CPZS/Index";
        });
        $("#tobjsy").click(function () {
            location.href = "/QM_Price/QM_PriceIndex";
        });
        //监听横竖屏切换
        var evt = "onorientationchange" in window ? "orientationchange" : "resize";
        window.addEventListener(evt, function () {
            $("#amenufld").trigger("click");
            return false;
        }, false);
        toastr.options = {
            closeButton: false,
            debug: false,
            progressBar: true,
            positionClass: "toast-top-center",
            onclick: null,
            showDuration: "300",
            hideDuration: "1000",
            timeOut: "3000",
            extendedTimeOut: "1000",
            showEasing: "swing",
            hideEasing: "linear",
            showMethod: "fadeIn",
            hideMethod: "fadeOut"
        };
        function iCheckStyled() {
            $('input').iCheck({
                checkboxClass: 'icheckbox_square-blue',
                radioClass: 'iradio_square-blue'
            });
        }
        var IsEdit = false;
        $(function () {
            var user = '@Oncontrol3.Web.Helpers.SQMHelper.getStaffKey()';
            if (user.length < 1) {
                layer.alert('系统登录已超时，请重新登录', { icon: 2 });
            }
            // 检测是否修改input
            $("input").change(function () {
                IsEdit = true;
            });
            // 检测是否修改input
            $("input").change(function () {
                IsEdit = true;
            });
            iCheckStyled();
            BindAutocompleteMDM();
            // 查看明细
            if (request("keyValue") != null && request("keyValue") != "") {
                // disable所有表单控件
                $("#formdata").find("input,select,textarea").each(function () {
                    $(this).css("background", "rgb(255,255,204)");
                    $(this).attr("disabled", true);
                });
                // 隐藏 提交 按钮
                $("#btnsubmit").css("display", "none");
                // 请求数据
                $.ajax({
                    url: "/SQM_ENQUIRY_HKY/GetFormJson",
                    data: "rid=" + request("keyValue"),
                    type: "Post",
                    async: false,
                    dataType:"Json",
                    success: function (data) {
                        $("#formdata").SetWebControlsForRadio(data);
                    }
                });
            }
            // 清除浏览器自动补全
            $("#formdata").find("input,select,textarea").each(function () {
                $(this).attr("autocomplete", "off");
            });
        });
        
        // 船期
        $(cqList).each(function (k, o) {
            $("#CQDATE").append($("<option></option>").attr("value", o.Code).html(o.Name));
        });
        // 设备类型
        //$(sblxList).each(function (k, o) {
        //    $("#EQUIP_TYPE").append($("<option></option>").attr("value", o.CODE).html(o.CODE + "---" + o.NAME));
        //});
        $("#SBLXCODE").select2({
            data: sblxList,
            multiple: true,
            placeholder: "请选择",
            allowclear: true,
            formatSelection: function (data) {
                return data.id;
            }
        });
        // 提交
        function Commit() {
            //验证表单数据
            if (!checkData()) {
                return false;
            }
            toastr.info("数据提交中，请稍候...");
            var postdata = GetWebControlsForRadio("#formdata");
            $.ajax({
                url: "/SQM_ENQUIRY_HKY/SubmitForm",
                async: false,
                data: {
                    "postdata": JSON.stringify(postdata),
                },
                dataType: "json",
                success: function (data) {
                    toastr.clear();
                    toastr.remove();
                    if (data.Success) {
                        toastr.success(data.Message);
                        setTimeout(function () { location.href = "/SQM_ENQUIRY_HKY/QuiryHyIndex" }, 500);
                    } else {
                        toastr.error(data.Message);
                    }
                }
            });
        }
        // 返回
        function Back() {
            if (IsEdit) {
                Ewin.confirm({ message: "页面有修改，是否放弃保存？" }).on(function (e) {
                    if (!e) {
                        return;
                    }
                    window.location.href = "/SQM_ENQUIRY_HKY/QuiryHyIndex";
                });
            }
            else {
                if (request("sign") == "dj") {
                    window.location.href = "/SQM_ENQUIRY_HKY/QuiryPURIndex";
                } else {
                    window.location.href = "/SQM_ENQUIRY_HKY/QuiryHyIndex";
                }
            }
        }
        // 展示拖车信息
        $("#showtuoche").click(function () {
            $(".tuoche").toggle();
            if ($(".tuoche").eq(0).is(":visible")) {// 元素可见
                $("#iftuoche").val("1");
                $("#showtuoche").find("i").removeClass().addClass("fa fa-caret-up");
            } else {
                $("#iftuoche").val("0");
                $("#showtuoche").find("i").removeClass().addClass("fa fa-caret-down");
            }
        });
        // 清空radio
        function selectNone(name) {
            $('input[name="' + name + '"]').iCheck('uncheck');
        }
        // 获取表单数据
        function GetWebControlsForRadio(element) {
            var postdata = {};
            $(element).find("input,select,textarea").each(function (r) {
                // 单选钮
                if ($(this).attr("type") == "radio") {
                    if ($(this).is(":checked")) {
                        postdata[$(this).attr("name")] = $(this).val();
                    }
                } else if ($(this).attr("id") == "CQDATE") {
                    var value = $(this).val();
                    if (value != "" && value != null) {
                        postdata["CQDATE"] = value.join(",");
                    }
                } else if ($(this).attr("id") == "SBLX") {
                    var value = $("#SBLXCODE").select2("data");
                    var ms = [];
                    value.forEach(item => { ms.push(item.text); })
                    if (ms.length > 0) {
                        postdata["SBLX"] = ms.join(";");
                    }
                } else {
                    var id = $(this).attr("id");
                    var value = $(this).val();
                    postdata[id] = value;
                }
            });
            return postdata;
        }
        // 控件绑定数据源
        function BindAutocompleteMDM() {
            $("[mdmtype='MDM']").each(function () {
                AutocompleteMDM($(this).attr("id"));
            });
            $("[mdmtype='MDMGK']").each(function () {
                AutocompleteMDMGK($(this).attr("id"));
            });
            $("[mdmtype='MDMBP']").each(function () {
                AutocompleteMDMBP($(this).attr("id"));
            });
            $("[mdmtype='MDMJC']").each(function () {
                AutocompleteMDMJC($(this).attr("id"));
            });
            $("input").change(function () {
                $(this).css("background-color", "#FFFFCC");
            });
        }
        //验证表单必填数据
        function checkData() {
            // radio
            var xqlx = 0;
            var ywlx = 0;
            var xjlx = 0;
            var yffs = 0;
            var ysfs = 0;
            $("input[name='XQLX']:radio").each(function () {
                if ($(this).is(":checked")) {
                    xqlx++;
                }
            });
            $("input[name='YWLX']:radio").each(function () {
                if ($(this).is(":checked")) {
                    ywlx++;
                }
            });
            $("input[name='XJLX']:radio").each(function () {
                if ($(this).is(":checked")) {
                    xjlx++;
                }
            });
            $("input[name='YFFS']:radio").each(function () {
                if ($(this).is(":checked")) {
                    yffs++;
                }
            });
            $("input[name='YSFS']:radio").each(function () {
                if ($(this).is(":checked")) {
                    ysfs++;
                }
            });
            //if (xqlx == 0) {
            //    toastr.clear();
            //    toastr.remove();
            //    toastr.error("请选择需求类型");
            //    return false;
            //}
            if (ysfs == 0) {
                toastr.clear();
                toastr.remove();
                toastr.error("请选择运输方式");
                return false;
            }
            if (ywlx == 0) {
                toastr.clear();
                toastr.remove();
                toastr.error("请选择业务内容");
                return false;
            }
            if (xjlx == 0) {
                toastr.clear();
                toastr.remove();
                toastr.error("请选择询价类型");
                return false;
            }
            if (yffs == 0) {
                toastr.clear();
                toastr.remove();
                toastr.error("请选择运费方式");
                return false;
            }
            // input
            if ($.trim($("#QYG").val()) == "") {
                toastr.clear();
                toastr.remove();
                toastr.error("请填写起运港");
                return false;
            }
            if ($.trim($("#MDG").val()) == "") {
                toastr.clear();
                toastr.remove();
                toastr.error("请填写目的港");
                return false;
            }
            //if ($.trim($("#CQDATE").val()) == "") {
            //    toastr.clear();
            //    toastr.remove();
            //    toastr.error("请选择船期");
            //    return false;
            //}
            //if ($.trim($("#PRODUCT").val()) == "") {
            //    toastr.clear();
            //    toastr.remove();
            //    toastr.error("请填写品名");
            //    return false;
            //}
            //if ($.trim($("#HL").val()) == "") {
            //    toastr.clear();
            //    toastr.remove();
            //    toastr.error("请填写货量");
            //    return false;
            //}
            // 校验数据格式
            // 起运港、目的港不能为*号
            if ($("#QYG").val().indexOf("*(*)") >= 0) {
                toastr.clear();
                toastr.remove();
                toastr.error("起运港不能为*");
                return false;
            }
            if ($("#MDG").val().indexOf("*(*)") >= 0) {
                toastr.clear();
                toastr.remove();
                toastr.error("目的港不能为*");
                return false;
            }
            var reg = /\D/gi;
            var hl = $("#HL").val().trim();
            if (reg.test(hl)) {
                toastr.clear();
                toastr.remove();
                toastr.error("货量填写数据是非数字格式");
                return false;
            }
            if ($.trim($("#SBLXCODE").val()) == "") {
                toastr.clear();
                toastr.remove();
                toastr.error("请填写设备类型");
                return false;
            }
            //if ($.trim($("#SHIPPER").val()) == "") {
            //    toastr.clear();
            //    toastr.remove();
            //    toastr.error("请填写发货人");
            //    return false;
            //}
            //if ($.trim($("#CONSIGNEE").val()) == "") {
            //    toastr.clear();
            //    toastr.remove();
            //    toastr.error("请填写收货人");
            //    return false;
            //}
            if ($("#TUOCHE_HL").val() + "" != "") {
                if (reg.test($("#TUOCHE_HL").val())) {
                    toastr.clear();
                    toastr.remove();
                    toastr.error("拖车—货量，填写数据是非数字格式");
                    return false;
                }
            }
            return true;
        }
        // 表单填充
        $.fn.SetWebControlsForRadio = function (data) {
            var $id = $(this);
            for (var key in data) {
                // 给单选钮赋值  YSFS、YWLX、XJLX、YFFS
                if (key == "YSFS" || key == "YWLX" || key == "XJLX" || key == "YFFS") {
                    $("input[value='" + data[key] + "']").iCheck("check");
                } else {
                    var id = $id.find("#" + key);
                    if (id.attr("id")) {
                        var type = id.attr('type');
                        if (id.hasClass("select2")) {
                            type = "select2";
                        }
                        else if (id.hasClass("datepicker") || id.hasClass("form-date")) {
                            type = "datepicker";
                        }
                        else if (id.hasClass("form-datetime")) {
                            type = "datetimepicker";
                        }
                        else if (id.hasClass("form-datetime2")) {
                            type = "datetimepicker2";
                        }
                        var value = data[key];
                        switch (type) {
                            case "checkbox":
                                if (value == 1) {
                                    id.attr("checked", 'checked');
                                } else {
                                    id.removeAttr("checked");
                                }
                                break;
                            case "select2":
                                id.select2("val", value);
                                break;
                            case "datepicker":
                                id.val(formatDate2(value, "yyyy/MM/dd"));
                                break;
                            case "datetimepicker":
                                id.val(formatDate2(value, "yyyy/MM/dd hh:mm:ss"));
                                break;
                            case "datetimepicker2":
                                id.val(formatDate2(value, "yyyy/MM/dd hh:mm"));
                                break;
                            default:
                                id.val(value);
                                break;
                        }
                    }
                }
            }
        }
    </script>
}