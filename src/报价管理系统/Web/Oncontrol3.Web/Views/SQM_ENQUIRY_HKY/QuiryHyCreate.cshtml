        }

    /*.head .active {
            border-bottom: 2px solid #F8F8F8;
        }*/

    .label {
        color: #4d5d70 !important;
    }

    .inf {
        line-height: 40px;
    }

    .tel-num {
        color: #000;
        font-size: 24px;
        font-weight: bold;
    }

    .dis {
        color: #999;
    }

    #modelname {
        margin-left: 10px;
        font-size: 18px;
    }

    .controls {
        position: relative;
    }

        .controls input[type=radio] {
            opacity: 0;
        }

        .controls label {
            position: absolute;
            top: 5px;
            left: 12px;
            width: 12px;
            height: 12px;
            border-radius: 50%;
            border: 1px solid rgb(223,223,223);
            background-color: rgb(241,241,241);
        }

        .controls input[type=radio]:checked + label:after {
            content: "";
            position: absolute;
            left: 3px;
            bottom: 3px;
            width: 4px;
            height: 4px;
            border: 2px solid rgb(40,129,197);
            background-color: rgb(40,129,197);
            border-radius: 50%;
        }

    .clear {
        background-color: rgb(195,195,195);
        color: #ffffff;
        width: 70px;
    }

    .nmpd-target {
        border: 1px solid rgb(153, 153, 153);
        border-image: none;
        width: 50px;
        height: 30px;
    }

    .label-default {
        background-color: #fff;
        color: #666;
        font-weight: 100;
    }
    /********************************************/
    .font {
        font-size: 20px;
        color: black;
        padding-top: 10px;
    }

    .bjok {
        color: green;
    }

    .bjover {
        color: #f0ad4e;
    }

    .card-box {
        width: 100%;
        height: 100px;
        float: left;
        /*border: 1px solid #ccc;*/
        background-color: #fff;
        border-radius: 1px;
        margin-top: 5px;
        overflow: hidden;
        position: relative;
        padding-bottom: 10px;
    }

    .card-box-content {
        padding: 6px 6px;
        font-size: 14px;
        color: #4d5d70;
    }

        .card-box-content div {
            overflow: hidden;
            white-space: nowrap;
            text-overflow: ellipsis;
            margin-top: 4px;
        }

            /*.card-box-content .inf {
            font-weight: bold;
        }*/

            .card-box-content div .tel-num {
                width: 80px;
            }

            .card-box-content div .pickup_btn {
                float: right;
                margin-left: 56px;
                font-size: 9px;
                line-height: 18px;
                width: 70px;
                height: 18px;
                background-color: #319adf;
                color: white;
                text-align: center;
                border-radius: 8px;
            }

    .btns {
        margin-top: 8px;
        margin-bottom: 8px;
    }

    .ColVis {
        display: none;
    }

    .htmlstr {
        position: absolute;
        width: 1400px;
    }

    #numpad4column tbody td {
        height: 60px;
    }

    .dt-toolbar {
        padding: 0px 0px;
        border-bottom: 0px solid #ccc;
        background: #fff
    }

    .dataTables_info {
        display: none;
    }

    .dataTables_length {
        display: none;
    }

    #numpad4column_paginate {
        display: none;
    }

    .dban .col-md-1 {
        width: 12%;
    }

    .tuoche {
        display: none;
        padding-left: 45px;
        padding-right: 20px;
        padding-bottom: 10px;
        margin-top: 5px;
        margin-bottom: 15px;
        margin-left: 16px !important;
        margin-right: 194px !important;
        /*border: 1px solid #ff6a00;*/
    }

    #showtuoche {
        font-style: italic;
        font-weight: 700;
        cursor: pointer;
    }
    /**  控件绑定样式  **/
    .grid {
        margin: 0px;
        border-collapse: collapse;
        table-layout: fixed;
    }

        .grid tbody td {
            text-align: left;
            border-bottom: 1px solid #ccc;
            border-left: 1px solid #ccc;
            border-right: 1px solid #ccc;
            height: 22px;
            word-break: break-all;
        }

        .grid tbody .selected {
            background-color: #6DA47D;
            color: #fff;
            cursor: pointer;
        }

    .clearbtn {
        margin-top: 10px;
        margin-left: -12px;
    }
    /*出现滚动条后页面晃动*/
    html {
        overflow-y: scroll;
        overflow-x: scroll;
    }
</style>
