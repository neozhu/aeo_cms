@{
    ViewBag.Title = "费目详情";
    Layout = "~/Views/Shared/_LayoutTM.cshtml";
}
<style>
    body {
        background-color: rgb(248,248,248);
    }

    .active {
        background-color: rgb(19,100,181) !important;
    }

    .head {
        height: 50px;
        background-color: rgb(19,100,181);
    }

        .head span {
            line-height: 98px;
            font-size: 14px;
            padding: 0px 10px 5px 10px;
            color: #ffffff;
        }

    /*.head .active {
            border-bottom: 2px solid #F8F8F8;
        }*/

    .label {
        color: #4d5d70 !important;
    }

    .inf {
        line-height: 40px;
    }

    .tel-num {
        color: #000;
        font-size: 24px;
        font-weight: bold;
    }

    .dis {
        color: #999;
    }

    #modelname {
        margin-left: 10px;
        font-size: 18px;
    }

    .controls {
        position: relative;
    }

        .controls input[type=radio] {
            opacity: 0;
        }

        .controls label {
            position: absolute;
            top: 5px;
            left: 12px;
            width: 12px;
            height: 12px;
            border-radius: 50%;
            border: 1px solid rgb(223,223,223);
            background-color: rgb(241,241,241);
        }

        .controls input[type=radio]:checked + label:after {
            content: "";
            position: absolute;
            left: 3px;
            bottom: 3px;
            width: 4px;
            height: 4px;
            border: 2px solid rgb(40,129,197);
            background-color: rgb(40,129,197);
            border-radius: 50%;
        }

    .clear {
        background-color: rgb(195,195,195);
        color: #ffffff;
        width: 70px;
    }

    .nmpd-target {
        border: 1px solid rgb(153, 153, 153);
        border-image: none;
        width: 50px;
        height: 30px;
    }

    .label-default {
        background-color: #fff;
        color: #666;
        font-weight: 100;
    }
    /********************************************/
    .font {
        font-size: 20px;
        color: black;
        padding-top: 10px;
    }

    .bjok {
        color: green;
    }

    .bjover {
        color: #f0ad4e;
    }

    .card-box {
        width: 100%;
        height: 100px;
        float: left;
        border: 1px solid #ccc;
        background-color: #fff;
        border-radius: 1px;
        margin-top: 5px;
        overflow: hidden;
        position: relative;
        padding-bottom: 10px;
    }

    .card-box-content {
        padding: 6px 6px;
        font-size: 14px;
        color: #4d5d70;
    }

        .card-box-content div {
            /*overflow: hidden;*/
            white-space: nowrap;
            text-overflow: ellipsis;
            margin-top: 4px;
        }

            /*.card-box-content .inf {
            font-weight: bold;
        }*/

            .card-box-content div .tel-num {
                width: 80px;
            }

            .card-box-content div .pickup_btn {
                float: right;
                margin-left: 56px;
                font-size: 9px;
                line-height: 18px;
                width: 70px;
                height: 18px;
                background-color: #319adf;
                color: white;
                text-align: center;
                border-radius: 8px;
            }

    .btns {
        margin-top: 8px;
        margin-bottom: 8px;
    }

    .ColVis {
        display: none;
    }

    .htmlstr {
        position: absolute;
        width: 1400px;
        margin-right:20px;

    }

    #numpad4column tbody td {
        height: 60px;
    }

    .dt-toolbar {
        padding: 0px 0px;
        border-bottom: 0px solid #ccc;
        background: #fff
    }

    /*.dataTables_info {
        display: none;
    }

    .dataTables_length {
        display: none;
    }*/

    /*#numpad4column_paginate {
        display: none;
    }*/

    .dban .col-md-1 {
        width: 12%;
    }
    span[name='PRD'], span[name='SRV'], span[name='FEE'] {
        cursor: pointer;
    }
</style>
<!--头-->
<div class="row head">
    <div style="float:left">
        <div style="margin-top: -25px;">
            <span>&nbsp;&nbsp;&nbsp; 欢迎您：<span id="user">@Oncontrol3.Web.Helpers.SQMHelper.getStaffKey()</span></span>
        </div>
    </div>
    <div style="float:right; margin-right: 10px; margin-top: -25px;">
        <span class="dis">询价</span>
        <span class="dis" id="tobjmb">报价模板</span>
        <span class="dis" id="tobjmb">非报价模板</span>
        <span class="dis active" id="tobjsy">报价首页</span>
    </div>
</div>
<!--标题-->
<div class="row" style="background-color: #fff;">
    <div class="col-md-12">
        <div class="card-box" style="height:100%;">
            <div class="card-box-content">
                <div class="inf"><span class="tel-num" id="feename">空运费询价列表</span></div>
            </div>
        </div>
    </div>
</div>

<!--主体-->

    <div class="row">
        <div class="col-md-12">
            <div class="card-box" style="height:100%;">
                <div class="card-box-content">
                    <div class="row">
                        <div class="col-md-12">
                            <div class="col-md-3">
                                <div class="btn-group">
                                    <a class="btn btn-success" id="addModal" data-toggle="modal" data-target="#bjAdd" onclick="Add();return false;">增加</a>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12 ptbj">
                            <table id="numpad4column" class="table table-striped table-hover"></table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

@section pagespecific{
    <script src="~/Content/QO/scripts/framework.js?v=@DateTime.Now.ToString("yyyyMMddhhmmss")"></script>
    <script src="~/Content/QO/scripts/Ewin.js"></script>
    <script src="~/Content/QO/toastr/toastr.min.js"></script>
    <link rel="stylesheet" href="~/Content/QO/toastr/toastr.min.css">
    <script src="/js/lib/jquery.plug-ins.js" type="text/javascript"></script>
    <script src="~/Content/QO/layer/layer.js"></script>
    <script src="/scripts/plugin/datatables/dataTables.colReorder.min.js" type="text/javascript"></script>
    <script src="/scripts/plugin/datatables/dataTables.colVis.min.js" type="text/javascript"></script>
    <script src="/scripts/plugin/datatables/dataTables.fixedColumns.min.js" type="text/javascript"></script>
    <script src="/scripts/plugin/datatables/dataTables.fixedHeader.js" type="text/javascript"></script>
    <link href="~/Content/QO/scripts/bootstrap-datetimepicker/css/bootstrap-datetimepicker.min.css" rel="stylesheet">
    <script src="~/Content/QO/scripts/bootstrap-datetimepicker/js/bootstrap-datetimepicker.min.js"></script>
    <script type="text/javascript" src="~/Content/QO/scripts/bootstrap-datetimepicker/js/locales/bootstrap-datetimepicker.zh-CN.js" charset="UTF-8"></script>
    <script src="~/Scripts/plugin/jquery-validate/jquery.validate.min.js"></script>
    <link rel="stylesheet" href="~/Content/QO/scripts/jQueryNumPad/jquery.numpad.css">
    <link href="~/Content/QO/scripts/icheck/skins/square/blue.css" rel="stylesheet">
    <script src="~/Content/QO/scripts/icheck/icheck.min.js"></script>

    <script type="text/javascript">

        $(function () {
            DrawTable();
        })
        function DrawTable() {
            var columns = [
                { "title": "创建时间", "data": "CREATETIME", "bVisible": false },
                //{
                //    "title": "序号", "data": null, "width": "25", "sortable": false
                //},
                {
                    "title": "品名", "data": "PRODUCT",
                    render: function (data, type, row, meta) {
                        if (data == null) {
                            data = "";
                        }
                        var hwlb = row.HWLB == "0" ? "是" : "否"; //是否危险品
                        var myfs = row.MYFS == null ? "" : row.MYFS; //贸易方式
                        var sponsedate = "";
                        if (row.SPONSEDATE != null) {
                            sponsedate = new Date(row.SPONSEDATE);
                            sponsedate.setHours(sponsedate.getHours() + 8);
                            sponsedate = sponsedate.Format("yyyy-MM-dd");
                        }
                        var jgdate = "";
                        if (row.JGDATE != null) {
                            jgdate = new Date(row.JGDATE);
                            jgdate.setHours(jgdate.getHours() + 8);
                            jgdate = jgdate.Format("yyyy-MM-dd");
                        }
                        var htmlStr = data + "<br>";
                        htmlStr += "<div class='htmlstr' style='margin-top:12px'><span style='font-weight: bold;'>是否危险品：</span><span style='padding-right:15px;'>" + hwlb + "</span>";
                        htmlStr += "<span style='font-weight: bold;'>贸易方式：</span><span style='padding-right:40px;'>" + myfs + "</span>";
                        htmlStr += "<span style='font-weight: bold;'>回复日期：</span><span style='padding-right:40px;'>" + sponsedate + "</span>";
                        htmlStr += "<span style='font-weight: bold;'>进港日期：</span><span style='padding-right:40px;'>" + jgdate + "</span>";
                        htmlStr += "</div>";
                        return htmlStr;
                    }
                },
                { "title": "包装规格", "data": "SPECIFICATION" },
                { "title": "起运港", "data": "QYG" },
                { "title": "目的港", "data": "MDG" },
                { "title": "毛重/KG", "data": "GROSSWEIGHT" },
                {
                    "title": "询价状态", "data": "STATUS",
                    render: function (data, type, row, meta) {
                        data = data == 0 || data == "" ? "" : data;
                        return data;
                    }
                },
                {
                    "title": "询价人", "data": "CREATEUSER"
                }

            ];
            var table= $("#numpad4column").dataTable({
                 responsive: true, // 没什么卵用
                "processing": true,
                "serverSide": true,
                "colReorder": true,
                "scrollX": false, // 这个状态为false，禁止横向滚动
                "bStateSave": true,
                "order": [[0, "desc"]],
                "fnDrawCallback": function () {
                    var api = this.api();
                    var startIndex = api.context[0]._iDisplayStart; //获取到本页开始的条数 　
                    api.column(0).nodes().each(function (cell, i) {
                        cell.innerHTML = startIndex + i + 1;
                    }); // 这个应该是序号自增1，取第1列数据
                    //checkOne();
                    //// 绑定计算器
                    //$("#numpad4column .bjEditInput").numpad();
                    //// 保存datatable所有数据
                    //var nTrs = table.fnGetNodes();
                    //djval = [];
                    //for (var i = 0; i < nTrs.length; i++) {
                    //    djval.push(table.fnGetData(nTrs[i]));
                    //}
                },
                "language": {
                    "info": "第 _START_ 到 _END_ 条记录，共 _TOTAL_ 条",
                    "infoEmpty": "第 0 到 0 条记录，共 0 条",
                    'emptyTable': '没有检索到数据',
                    'zeroRecords': '没有检索到数据',
                    'loadingRecords': '加载中...',
                    'processing': '查询中...',
                    "paginate": { "first": "<<", "last": ">>", "next": ">", "previous": "<" }
                },//语言
                "sDom": "<'dt-toolbar'<'col-xs-12 col-sm-6'><'col-sm-6 col-xs-12 hidden-xs'>r>" + "t" +
                "<'dt-toolbar-footer'<'col-sm-6 col-xs-12 hidden-xs'i><'col-xs-12 col-sm-6'plC>>",//整个griddom布局
                "lengthMenu": [[4, 10, 20, 50, 100], [4, 10, 20, 50, 100]],//每页显示key text
                "displayLength": 10,//默认每页显示条目数
                "ajax": {
                    "url": "@Url.Action("HyLists")",//数据源controller
                    "type": "POST",
                    "data": function (d) {//查询参数
                        //d.ifbj = $("#ifbj").val();
                        //d.feecode = $("#feecode").val();
                        //d.unit = $("#unitval").val();
                        d.sort = d.columns[d.order[0].column].data;// 排序列名转换  传到后台为sort order
                        d.order = d.order[0].dir; //asc or desc
                       // d.type = "1";
                        //d.Status = $("#Status").val() == "" ? "1" : $("#Status").val();
                    }
                },
                columns: columns,
                "stateSaveParams": function (settings, data) {
                    localStorage.setItem('DataTables_' + settings.sInstance, JSON.stringify(data));

                },
                "stateLoadCallback": function (settings) {
                    var config = JSON.parse(localStorage.getItem('DataTables_' + settings.sInstance));
                    return config;
                }
            })
        }

      
    </script>
}

