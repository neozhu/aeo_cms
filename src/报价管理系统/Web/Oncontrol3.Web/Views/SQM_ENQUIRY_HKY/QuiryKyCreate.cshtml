@section pagespecific{

    <script src="~/Content/QO/scripts/framework.js?v=@DateTime.Now.ToString("yyyyMMddhhmmss")"></script>
    <script src="~/Content/QO/scripts/Ewin.js"></script>
    <script src="~/Content/QO/toastr/toastr.min.js"></script>
    <link rel="stylesheet" href="~/Content/QO/toastr/toastr.min.css">
    <script src="/js/lib/jquery.plug-ins.js" type="text/javascript"></script>
    <script src="~/Content/QO/layer/layer.js"></script>
    <script src="/scripts/plugin/datatables/dataTables.colReorder.min.js" type="text/javascript"></script>
    <script src="/scripts/plugin/datatables/dataTables.colVis.min.js" type="text/javascript"></script>
    <script src="/scripts/plugin/datatables/dataTables.fixedColumns.min.js" type="text/javascript"></script>
    <script src="/scripts/plugin/datatables/dataTables.fixedHeader.js" type="text/javascript"></script>

    <link href="~/Content/QO/scripts/bootstrap-datetimepicker/css/bootstrap-datetimepicker.min.css" rel="stylesheet">
    <script src="~/Content/QO/scripts/bootstrap-datetimepicker/js/bootstrap-datetimepicker.min.js"></script>
    <script type="text/javascript" src="~/Content/QO/scripts/bootstrap-datetimepicker/js/locales/bootstrap-datetimepicker.zh-CN.js" charset="UTF-8"></script>
    <script src="~/Scripts/plugin/jquery-validate/jquery.validate.min.js"></script>
    <link rel="stylesheet" href="~/Content/QO/scripts/jQueryNumPad/jquery.numpad.css">
    <link href="~/Content/QO/scripts/icheck/skins/square/blue.css" rel="stylesheet">
    <script src="~/Content/QO/scripts/icheck/icheck.min.js"></script>

    <script type="text/javascript">

        //监听横竖屏切换
        var evt = "onorientationchange" in window ? "orientationchange" : "resize";
        window.addEventListener(evt, function () {
            $("#amenufld").trigger("click");
            return false;
        }, false);
        toastr.options = {
            closeButton: false,
            debug: false,
            progressBar: true,
            positionClass: "toast-top-center",
            onclick: null,
            showDuration: "300",
            hideDuration: "1000",
            timeOut: "3000",
            extendedTimeOut: "1000",
            showEasing: "swing",
            hideEasing: "linear",
            showMethod: "fadeIn",
            hideMethod: "fadeOut"
        };
        var IsEdit = false;
        // 导航
        $("#toxj").click(function () {
            location.href = "/SQM_ENQUIRY_HKY/QuiryHyIndex";
        })

        $("#tobjsy").click(function () {
            location.href = "/QM_Price/QM_PriceIndex";
        })

        $("#tobjmb").click(function () {
            location.href = "/SQM_BJMB/SQM_BJMBIndex";
        })

        $("#tocpzs").click(function () {
            location.href = "/SQM_CPZS/Index";
        })
        $("#tobjsy").click(function () {
            location.href = "/QM_Price/QM_PriceIndex";
        });

        function iCheckStyled() {
            $('input').iCheck({
                checkboxClass: 'icheckbox_square-blue',
                radioClass: 'iradio_square-blue'
            });
        }
        $(function () {
            iCheckStyled();
            $(".form-date").datetimepicker({
                format: "yyyy/mm/dd",
                autoclose: true,
                todayBtn: true,
                todayHighlight: true,
                startView: 2,
                minView: 2,
                clearBtn: true,
                language: "zh-CN"
            });

            // 初始化状态
            //$(dataSel).each(function (k, o) {
            //    $("#myfs").append($("<option></option>").attr("value", o.Code).html(o.Name));
            //});
            // 检测是否修改input
            $("input").change(function () {
                IsEdit = true;
            });
            // 检测是否修改input
            $("input").change(function () {
                IsEdit = true;
            });
            BindAutocompleteMDM();
            // 查看明细
            if (request("keyValue") != null && request("keyValue") != "") {
                debugger
                // disable所有表单控件
                $("#formdata").find("input,select,textarea").each(function () {
                    $(this).css("background", "rgb(255,255,204)");
                    $(this).attr("disabled", true);
                });
                // 隐藏 提交 按钮
                $("#btnsubmit").css("display", "none");
                // 请求数据
                $.ajax({
                    url: "/SQM_ENQUIRY_HKY/GetFormJson",
                    data: "rid=" + request("keyValue"),
                    type: "Post",
                    async: false,
                    dataType: "Json",
                    success: function (data) {
                        $("#formdata").SetWebControlsForRadio(data);
                    }
                });
            }
            // 清除浏览器自动补全
            $("#formdata").find("input,select,textarea").each(function () {
                $(this).attr("autocomplete", "off");
            });
        })

        //提交
        function Commit() {
            toastr.info("数据提交中，请稍候...");
            var postdata = GetWebControlsForRadio("#formdata");
            //验证表单数据
            if (!checkData()) {
                return false;
            }
            $.ajax({
                url: "/SQM_ENQUIRY_HKY/SubmitForm",
                async: false,
                data: {
                    "postdata": JSON.stringify(postdata),
                },
                dataType: "json",
                success: function (data) {
                    console.log(data);
                    toastr.clear();
                    toastr.remove();
                    if (data.Success) {
                        toastr.success(data.Message);
                        setTimeout(function () { location.href = "/SQM_ENQUIRY_HKY/QuiryHyIndex" }, 500);
                    } else {
                        toastr.error(data.Message);
                    }
                }
            });
        }
        // 获取表单数据
        function GetWebControlsForRadio(element) {
            var postdata = {};
            $(element).find("input,select,textarea").each(function (r) {
                // 单选钮
                if ($(this).attr("type") == "radio") {
                    if ($(this).is(":checked")) {
                        postdata[$(this).attr("name")] = $(this).val();
                    }
                } else {
                    var id = $(this).attr("id");
                    var value = $(this).val();
                    postdata[id] = value;
                }
            });
            return postdata;
        }
        // 返回
        function Back() {
            if (IsEdit) {
                Ewin.confirm({ message: "页面有修改，是否放弃保存？" }).on(function (e) {
                    if (!e) {
                        return;
                    }
                    window.location.href = "/SQM_ENQUIRY_HKY/QuiryHyIndex";
                });
            }
            else {
                if (request("sign") == "dj") {
                    window.location.href = "/SQM_ENQUIRY_HKY/QuiryPURIndex";
                } else {
                    window.location.href = "/SQM_ENQUIRY_HKY/QuiryHyIndex";
                }
            }
        }
        // 控件绑定数据源
        function BindAutocompleteMDM() {
            $("[mdmtype='MDM']").each(function () {
                AutocompleteMDM($(this).attr("id"));
            });
            $("[mdmtype='MDMGK']").each(function () {
                AutocompleteMDMGK($(this).attr("id"));
            });
            $("[mdmtype='MDMBP']").each(function () {
                AutocompleteMDMBP($(this).attr("id"));
            });
            $("input").change(function () {
                $(this).css("background-color", "#FFFFCC");
            });
        }
        //验证表单必填数据
        function checkData() {
            // checkbox
            var hwlb = 0;
            $("input[name='HWLB']:radio").each(function () {
                if ($(this).is(":checked")) {
                    hwlb++;
                }
            });
            // input
            if ($.trim($("#PRODUCT").val()) == "") {
                toastr.clear();
                toastr.remove();
                toastr.error("请填写品名");
                return false;
            }
            if ($.trim($("#QYG").val()) == "") {
                toastr.clear();
                toastr.remove();
                toastr.error("请填写起运港");
                return false;
            }
            if ($.trim($("#MDG").val()) == "") {
                toastr.clear();
                toastr.remove();
                toastr.error("请填写目的港");
                return false;
            }
            if ($("#SPECIFICATION").val().trim() == "") {
                toastr.clear();
                toastr.remove();
                toastr.error("请填写包装规格");
                return false;
            }
            if ($("#GROSSWEIGHT").val().trim() == "") {
                toastr.clear();
                toastr.remove();
                toastr.error("请填写毛重");
                return false;
            }
            // 校验数据格式
            var reg = /\D/gi;
            var mz = $("#GROSSWEIGHT").val();
            if (reg.test(mz)) {
                toastr.clear();
                toastr.remove();
                toastr.error("毛重填写数据是非数字格式");
                return false;
            }
            if ($.trim($("#JGDATE").val()) == "") {
                toastr.clear();
                toastr.remove();
                toastr.error("请填写进港日期");
                return false;
            }
            if (hwlb == 0) {
                toastr.clear();
                toastr.remove();
                toastr.error("请选择是否危险品");
                return false;
            }
            
            return true;
        } 
        // 表单填充
        $.fn.SetWebControlsForRadio = function (data) {
            var $id = $(this);
            for (var key in data) {
                // 给单选钮赋值  
                if (key == "HWLB") {
                    $("input[value='" + data[key] + "']").iCheck("check");
                } else {
                    var id = $id.find("#" + key);
                    if (id.attr("id")) {
                        var type = id.attr('type');
                        if (id.hasClass("select2")) {
                            type = "select2";
                        }
                        else if (id.hasClass("datepicker") || id.hasClass("form-date")) {
                            type = "datepicker";
                        }
                        else if (id.hasClass("form-datetime")) {
                            type = "datetimepicker";
                        }
                        else if (id.hasClass("form-datetime2")) {
                            type = "datetimepicker2";
                        }
                        var value = data[key];
                        switch (type) {
                            case "checkbox":
                                if (value == 1) {
                                    id.attr("checked", 'checked');
                                } else {
                                    id.removeAttr("checked");
                                }
                                break;
                            case "select2":
                                id.select2("val", value);
                                break;
                            case "datepicker":
                                id.val(formatDate2(value, "yyyy/MM/dd"));
                                break;
                            case "datetimepicker":
                                id.val(formatDate2(value, "yyyy/MM/dd hh:mm:ss"));
                                break;
                            case "datetimepicker2":
                                id.val(formatDate2(value, "yyyy/MM/dd hh:mm"));
                                break;
                            default:
                                id.val(value);
                                break;
                        }
                    }
                }
            }
        }
    </script>
}
