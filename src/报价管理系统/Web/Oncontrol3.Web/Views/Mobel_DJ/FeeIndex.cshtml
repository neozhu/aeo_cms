@{
    ViewBag.title = "费目定价";
    Layout = "~/Views/Shared/_LayoutMobile.cshtml";
}
    <style>
        * {
            padding: 0;
            margin: 0;
        }
        /*基本样式*/
        #box {
            position: absolute;
            height: 100%;
            width: 100%;
            background: #fff !important;
        }

        header {
            width: 100%;
            height: 5%;
            position: fixed;
            overflow: scroll;
            z-index: 1;
        }

            header .row input {
                border: none;
            }

            header .row button {
                background: #fff;
                border: none;
            }

        .innerBox {
            width: 100%;
            height: 88%;
            position: fixed;
            overflow: scroll;
            z-index: 1;
            top: 5%;
            padding: 5px;
            border-top: 2px solid;
            border-bottom: 2px solid;
        }

        footer {
            width: 100%;
            height: 7%;
            position: fixed;
            z-index: 1;
            top: 93%;
        }

            footer div button {
                background: #fff;
            }
        /*选择事业部*/
        .chooseOrg {
            color: #006fc2 !important;
        }

        /*srv*/
        .srv {
            padding: 0px;
            display: inline-block;
        }

            .srv button {
                text-align: left;
            }

        .fee {
            padding: 2px;
        }

        #srvList, #feeList {
            height: 98%;
            padding: 5px;
            overflow: scroll;
        }
        /*定价方式、高低值可滚动*/
        #titleList {
            height: 5%;
            overflow-x: auto;
            white-space: nowrap; /*横向滚动*/
        }

        #gdzList {
            height: 5%;
            overflow-x: auto;
            white-space: nowrap;
        }

        .djfs {
            font-size: 13px;
            box-sizing: border-box;
            white-space: normal;
            word-wrap: break-word;
            word-break: break-all;
            overflow: hidden;
            display: inline-block;
            /*width: 40%;*/
            height: 100%;
            margin-right: 10px;
            padding-top: 5px;
        }

        .currentDjfs {
            border-bottom: 1px solid black;
            color: #3879D9;
        }

        .gdz {
            display: inline-block;
            margin-right: 20px;
            border-bottom: 2px solid #f4f4f4;
        }

        .currentGdz {
            color: #3879D9;
        }

        #detailList {
            height: 90%;
            overflow: scroll;
        }
    </style>

    <div id="box">
        <!--顶部搜索框-->
        <header>
            <div class="row">
                <div class="col-xs-10">
                    <input id="key" class="form-control" placeholder="">
                </div>
                <button class="col-xs-2 btn btn-default searchBtn" style="padding-top:5px;">
                    <i class="fa fa-search fa-lg" aria-hidden="true"></i>
                </button>
            </div>
        </header>
        <!--中间内容-->
        <div class="innerBox">
            <div class="col-xs-12">
                <div id="titleList"></div>
                <div id="gdzList"></div>
            </div>
            <div class="col-xs-12 ">
                <div id="detailList"></div>
            </div>
        </div>
        <!--底部导航栏-->
        <footer>
            <div class='btn-group btn-group-lg col-xs-2 ' style="padding:0px">
                <button id="backBtn" class='btn btn-block' onclick="window.history.go(-1)"><span>&lt;</span></button>
            </div>
            <div class='btn-group col-xs-pull-1 btn-group-lg col-xs-10 '>
                <button id="feename" class='btn btn-block'><span></span></button>
            </div>
        </footer>
    </div>
    <script type="text/javascript" src="~/Scripts/libs/jquery-2.1.1.min.js"></script>
    <script src="/Content/QO/toastr/toastr.min.js"></script>
    <link rel="stylesheet" href="/Content/QO/toastr/toastr.min.css">
    <script type="text/javascript">
        var prdcode = "@ViewBag.prdcode";
        var srvcode = "@ViewBag.srvcode";
        var feecode = "@ViewBag.feecode";
        var djrid = "@ViewBag.djrid";
        var username;
        //权限工号
        var hygh = '10002959,10003579,10000513,20000067,10000698,10001759,10003511';
        var kygh = '';
        $(document).ready(function () {
            var user = '@Oncontrol3.Web.Helpers.SQMHelper.getStaffKey()';
            if (user.length < 1) {
                layer.alert('系统登录已超时，请重新登录', { icon: 2 });
            }
            else {
                username = user;
            }
            InitPage();
            
            $("#feename span").text("@ViewBag.feename");
        });

        String.prototype.trim = function () {
            if (this.length > 5) {
                return this.substring(0, 4) + "...";
            } else {
                return this;
            }
        }
        //定价方式数据
        var djfsArray = [];
        function InitPage() {
            $.ajax({
                url: "/Mobel_DJ/DJFSList",
                data: {
                    user: username,
                    prdcode: prdcode,
                    srvcode: srvcode,
                    feecode: feecode,
                    djrid: djrid
                },
                dataType: "json",
                async: false,
                success: function (data) {
                    djfsArray = data;
                    if (djfsArray.length > 0) {
                        var djfsStr = "";
                        //$("#feename span").text(djfsArray[0][4]);
                        djfsStr += "<div class='btn-group col-xs-12'>";
                        for (var i = 0; i < djfsArray.length; i++) {
                            //djfsStr += "<div class='djfs' djfsrid='" + djfsArray[i][0] + "' gdzkey='" + djfsArray[i][2] + "' feecode='" + djfsArray[i][3] + "' >" + djfsArray[i][1] + "</div>";
                            djfsStr += "<div class='djfs' djfsrid='" + djfsArray[i][0] + "'>" + djfsArray[i][1] + "</div>";
                        }
                        djfsStr += "</div>";
                        $("#titleList").append(djfsStr);
                        showDetail(djfsArray[0][0]);
                        //选择第一个服务
                        $('.djfs').eq(0).addClass("currentDjfs");
                    } else {
                        toastr.info("该产品的此费目下未做定价");
                    }
                }
            });
        }
        var gdzdt = "";
        //当前定价方式下的明细
        function showDetail(djfsrid, gdzrid,gdzkey) {
            $(".djfs").removeClass("currentDjfs");
            $(".djfs[djfsrid=" + djfsrid + "]").addClass("currentDjfs");
            //var gdzkey = ''; //$(".djfs[djfsrid=" + djfsrid + "]").attr("gdzkey");
            $.ajax({
                url: "/Mobel_DJ/PSFdetail",
                type: "get",
                data: {
                    prdcode: prdcode,
                    srvcode: srvcode,
                    feecode: feecode,
                    djfsrid: djfsrid,
                    gdzkey: gdzkey,
                    gdzrid: gdzrid,
                    djrid: djrid,
                },
                dataType: "json",
                async: false,
                success: function (data) {
                    if (data.flag) {
                        var valStr = "";
                        var jsjc = data.jsjcArray;
                        var valdt = data.valdt;
                        //if (gdzkey == "0" || gdzkey == undefined || gdzkey == null) {
                        //    $("#gdzList").html("");
                        //}
                        $("#gdzList").html("");
                        
                        if (!!data.gdzdt&& data.gdzdt.length > 0&&data.gdzdt[0]["GDZKEY"]!="0") {
                            //有高低值数据，重新赋值
                            gdzdt = data.gdzdt;
                            var gdzStr = "";
                            for (var i = 0; i < gdzdt.length; i++) {
                                gdzStr += "<div class='gdz' djfsrid='" + gdzdt[i]["DJFSRID"] + "' gdzrid='" + gdzdt[i]["GDZRID"] + "' gdzkey='" + gdzdt[i]["GDZKEY"] + "' name='" + gdzdt[i]["GDZNAME"] + "'>" + gdzdt[i]["GDZNAME"] + "</div>";
                            }
                            $("#gdzList").html(gdzStr);
                            $('.gdz').eq(0).addClass('currentGdz');
                        }
                        if (valdt.length == 0) {
                            $("#detailList").html("");
                            toastr.remove();
                            toastr.clear();
                            toastr.info("当前产品的费目在此定价方式下未定价！");
                            return;
                        }
                        //拼接计算基础
                        var calctype = "";
                        for (var i = 0; i < valdt.length; i++) {
                            //拼接前面非固定部分
                            valStr += "<div>"
                            calctype = "";
                            for (var j = 0; j < jsjc.length; j++) {
                                //data.jsjc[j][1] 名称  data.jsjc[j][2] //值所在的列
                                var col = jsjc[j][2] + "";
                                valStr += "" + jsjc[j][1] + ":" + valdt[i][col] + "; ";
                            }
                            if (valdt[i]["CALCTYPE"] == "A") {
                                calctype = "绝对值";
                            } else if (valdt[i]["CALCTYPE"] == "B") {
                                calctype = "相对值";
                            }
                            valStr += "<br>计算方式：" + calctype + ";"
                            if (!!valdt[i]["CALCUNIT"]) {
                                //为空会显示null
                                valStr += "计费单位：" + valdt[i]["CALCUNIT"];
                            }
                            valStr += "<br>最低价:" + valdt[i]["MINPRICE"] + "; 最高价：" + valdt[i]["MAXPRICE"] + "; 指导价：" + valdt[i]["GUIDEPRICE"] + "; ";
                            valStr += "MIN:" + (valdt[i]["MIN"] == null ? 0 : valdt[i]["MIN"]) + "; <br>有效期:" + valdt[i]["STARTDATE"].substr(0, 10) + "--" + valdt[i]["ENDDATE"].substr(0, 10) + "<hr></div>";
                        }
                        $("#detailList").html(valStr + "</div>");
                    } else {
                        toastr.remove();
                        toastr.clear();
                        toastr.info("当前产品的费目在此定价方式下未定价！");
                    }
                },
                error: function (data) {

                }
            })
        }

        $("#titleList").on('click', '.djfs', function () {
            showDetail($(this).attr("djfsrid"));
        })

        $("#gdzList").on('click', '.gdz', function () {
            //$('.gdz').removeClass('currentGdz');
            //$(this).addClass('currentGdz');
            showDetail($(this).attr('djfsrid'), $(this).attr('gdzrid'), $(this).attr('gdzkey'));
            $('.gdz').removeClass('currentGdz');
            $('.gdz[gdzrid=' + $(this).attr('gdzrid') + ']').addClass('currentGdz');
        })

        $("header").on('click', '.searchBtn', function () {
            var key = $("#key").val();
            if (!!key) {
                $("#detailList div").each(function () {
                    if (!$(this).text().match(key)) {
                        $(this).hide();
                    }
                })
            } else {
                $("#detailList div").show();
            }
        })
    </script>

