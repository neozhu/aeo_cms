                            var CONDITION = $(this).closest('tr').find('td').eq(13).text();//
                            var JXJC = $(this).closest('tr').find('td').eq(14).text();//JXJC
                            var STAGETYPE = $(this).closest('tr').find('td').eq(15).text();//STAGETYPE
                            //要更新的三个字段  CONDITION,JXJC,STAGETYPE
                            checkArray.push(MRID, FWA,ZVER,ITEMNO, CONDITION, JXJC, STAGETYPE);
                            //checkArray.push($(this).val());
                            //checkArray[i] = $(this).val();
                        }
                    })
                });
            } else {
                $('input[name="checkbox"]').each(function () {
                    $(this).prop("checked", false);
                });
