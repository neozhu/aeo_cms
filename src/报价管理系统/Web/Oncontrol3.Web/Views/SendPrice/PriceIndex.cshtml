                                var val = obj[index];
                                var tr = $('<tr></tr>');
                                tr.append('<td><input type="checkbox" name="checkbox"/></td>' + '<td>' + val.BJNAME + '</td>' + '<td>' + val.ORGNAME + '</td>' + '<td>' + val.BPNAME + '</td>' + '<td>' + val.ZVER + '</td>' + '<td>' + val.PRODUCT_NAME + '</td>' + '<td>' + val.CREATEUSER + '</td>' + '<td>' + val.FWA + '</td>' + '<td>' + val.ITEMNO + '</td>' + '<td>' + val.MODIFYTIME + '</td>' + '<td>' + '' + '</td>' + '<td>' + '' + '</td>'+ '<td style="display:none">' + val.MRID + '</td>' + '<td style="display:none">' + val.CONDITION + '</td>' + '<td style="display:none">' + val.JXJC + '</td>' + '<td style="display:none">' + val.STAGETYPE + '</td>');
                                //tbody.append(tr);
                                $("#tbody").append(tr);
                            });
                            $('#myTable tbody').replaceWith(tbody);
                    }

                   
                });
