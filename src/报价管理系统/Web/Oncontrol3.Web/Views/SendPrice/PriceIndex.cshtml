                        djfsmsg += "<input type='hidden'  class='djfsrid' value='" + djfsArray[i][0] + "' /><input type='button' class='btn btn-default' title='" + djfsArray[i][1] + "'  value='" + djfsArray[i][1] + "'  onclick='SelectBtn(\" "+ djfsArray[i][0] +"\")'  readonly>&nbsp";
