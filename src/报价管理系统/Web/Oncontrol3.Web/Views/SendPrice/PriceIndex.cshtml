        $("#submitTM").click(function () {
            if (checkArray.length < 1) {
                alert("请选择报价数据！");
            } else {
                $.ajax({
                    type: 'POST',
                    url: "/SendPrice/SubmitTM",
                    data: { 'postdata': JSON.stringify(checkArray)},
                    dataType: "JSON",
                   // traditional:true,
                    success: function (data) {
                        console.log(data);
                        $("input[name='checkbox']").each(function () {
                            if ($(this).prop("checked")) {
                                $(this).closest('tr').find('td').eq(10).html(data.Success);//状态 
                                $(this).closest('tr').find('td').eq(11).html(data.Message);//返回结果
                            }
                        })
                    }
