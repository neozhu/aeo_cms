    <script type="text/javascript">
        var djval = [];// 保存定价数据
        // iCheck 选中方法
        //选中数量
        function selectedCount(name) {
            return $("input[name='" + name + "']:checked").length;
        }
        //全选
        function selectAll(name) {
            $('input[name="' + name + '"]').iCheck('check');
        }
        //全不选
        function selectNone(name) {
            $('input[name="' + name + '"]').iCheck('uncheck');
        }
        ///给url添加
        $.fn.numpad.defaults.gridTpl = '<table class="table modal-content"></table>';
        $.fn.numpad.defaults.backgroundTpl = '<div class="modal-backdrop in"></div>';
        $.fn.numpad.defaults.displayTpl = '<input readonly="readonly" type="text" class="form-control" />';
        $.fn.numpad.defaults.buttonNumberTpl = '<button type="button" class="btn btn-default"></button>';
        $.fn.numpad.defaults.buttonFunctionTpl = '<button type="button" class="btn" style="width: 100%;"></button>';
        $.fn.numpad.defaults.onKeypadCreate = function () { $(this).find('.done').addClass('btn-primary'); };
        //监听横竖屏切换
        var evt = "onorientationchange" in window ? "orientationchange" : "resize";
        window.addEventListener(evt, function () {
            $("#amenufld").trigger("click");
            return false;
        }, false);

        toastr.options = {
            closeButton: false,
            debug: false,
            progressBar: true,
            positionClass: "toast-top-center",
            onclick: null,
            showDuration: "300",
            hideDuration: "1000",
            timeOut: "3000",
            extendedTimeOut: "1000",
            showEasing: "swing",
            hideEasing: "linear",
            showMethod: "fadeIn",
            hideMethod: "fadeOut"
        };
        function iCheckStyled() {
            $('input').iCheck({
                checkboxClass: 'icheckbox_square-blue',
                radioClass: 'iradio_square-blue'
            });
        }
        var IsEdit = false;
        $(function () {
            ///////////////////
            $("#amenufld").hide();
            $("#logout").hide();
            $("#amenufld").click();
            ///////////////////
            // 渲染iCheck
            // 1.包干费
            if ("@psfdata.Rows[0]["ISLSC"]" == "1") {
                $("input[name='bgf']:checkbox").iCheck('check');
            }
            // 2.报价方式
            $("input[name='bjfs']:radio").each(function () {
                if ("@psfdata.Rows[0]["BJFS"]" == $(this).val()) {
                    $(this).iCheck('check');
                }
                if ("@psfdata.Rows[0]["BJFS"]" == "1" || "@psfdata.Rows[0]["BJFS"]" == "2") {
                    $(".ptbj").hide();
                    $(".exportexc").attr("disabled", "disabled");
                    $(".importexc").attr("disabled", "disabled");
                }
            });
            $("input[name='bjfs']:radio").each(function () {
                if ("@ViewBag.bjfs" == $(this).val()) {
                    $(this).iCheck('check');
                    $(this).attr("disabled", false);
                }
                //报价方式change事件
                $(this).on("ifChecked", function (event) {
                    if ($(this).val() == '1' || $(this).val() == '2') {
                        $(".ptbj").hide();
                        $(".exportexc").attr("disabled", "disabled");
                        $(".importexc").attr("disabled", "disabled");
                    } else if ($(this).val() == '0') {
                        $(".ptbj").show();
                        $(".exportexc").attr("disabled", false);
                        $(".importexc").attr("disabled", false);
                    }
                });
            });
            // 3.前提条件
            $("input[name='qttj']:radio").each(function () {
                if ("@psfdata.Rows[0]["CONDITION"]" == $(this).val()) {
                    $(this).iCheck('check');
                }
            });
            // 4.费率表规则

            // 5.解析基础
            $("input[name='jxjc']:radio").each(function () {
                if ("@psfdata.Rows[0]["JXJC"]" == $(this).val()) {
                    $(this).iCheck('check');
                }
            });
            // 6.阶段类别
            $("input[name='jdlb']:radio").each(function () {
                if ("@psfdata.Rows[0]["STAGETYPE"]" == $(this).val()) {
                    $(this).iCheck('check');
                }
            });
            // 7.报价单位
            $("input[name='bjdw']:radio").each(function (i) {
                if (i == 0) {
                    $(this).iCheck("check");
                    $("#unitval").val($(this).val());
                }
                $(this).on("ifChecked", function (event) {
                    $("#unitval").val($(this).val());
                    $("#numpad4column").DataTable().search("").draw();
                    return false;
                });
            });
            // 是否报价-默认全部
            $("input[name='ifbj']:radio").each(function (i) {
                if (i == 0) {
                    $(this).iCheck("check");
                    $("#ifbj").val($(this).val());
                }
                $(this).on("ifChecked", function (event) {
                    $("#ifbj").val($(this).val());
                    $("#numpad4column").DataTable().search("").draw();
                    return false;
                });
            });
            // 检测是否修改input
            $("input").change(function () {
                IsEdit = true;
            });
            iCheckStyled();
            DrawTable();

        });
        function Clearqttj() {
            selectNone("qttj");
        }
        function Clearjxjc() {
            selectNone("jxjc");
        }
        function Clearjdlb() {
            selectNone("jdlb");
        }
        // 明细新增
        function Add() {
            // 1.引入html -- 能用，丑陋
            //$("#page1").load("/SQM_BJ_HKYFEE/DetailAdd?djrid=" + $("#DJRID").val() + "&calcunit=" + $('#unitval').val() + "&bjrid=" + $("#BJRID").val());
            //$("#bjAdd").modal("show");
            // 2.页面跳转 -- 不能用
            //window.location.href = "/SQM_BJ_HKYFEE/DetailAdd?djrid=" + $("#DJRID").val() + "&calcunit=" + $("#unitval").val() + "&bjrid=" + $("#BJRID").val();
            // a标签 -- 可以用
            var href = "/SQM_BJ_HKYFEE/DetailAdd?djrid=" + $("#DJRID").val() + "&calcunit=" + $("#unitval").val() + "&bjrid=" + $("#BJRID").val() + "&ifdj=" + ifdj;
            $("#addModal").attr("href", href);
            // ajax -- 不能用
            //$.ajax({ url: "/SQM_BJ_HKYFEE/DetailAdd?djrid=" + $("#DJRID").val() + "&calcunit=" + $("#unitval").val() + "&bjrid=" + $("#BJRID").val()});
        }
        // 导入
        $("#importExcel").click(function () {
            var unit = [];
            $("input[name='bjdw']:radio").each(function () {
                unit.push($(this).val());
            });
            // 1.清除
            $("#div_fileImport").empty();
            // 2.新增
            $("#div_fileImport").append("<input id='fileImport' name='fileImport' type='file' class='file-loading'>");
            new FileInput().Init("fileImport", "/SQM_BJ_HKYFEE/PostExcelData?status=" + "@status" + "&feecode=" + $("#feecode").val() + "&DJRID=" + $("#DJRID").val() + "&BJRID=" + $("#BJRID").val() + "&unit=" + JSON.stringify(unit));
            $("#importExc").modal("show");
        });
        // 导出
        function ExportExc() {
            //if (IsEdit) {

            //}
            var unit = [];
            $("input[name='bjdw']:radio").each(function(){
                unit.push($(this).val());
            });
            // 进度条开始
            toastr.info("数据生成中，请稍候...");
            $.ajax({
                url: "@Url.Action("ExportExcel")",
                type: "Post",
                data: {
                    "DJRID": $("#DJRID").val(),
                    "BJRID": $("#BJRID").val(),
                    "unit": JSON.stringify(unit),
                    "feename": "@psfdata.Rows[0]["FEE_NAME"]",
                    "feecode":"@psfdata.Rows[0]["FEE_CODE"]",
                    "status": "@status"
                },
                dataType: "json",
                success: function (data) {
                    // 进度条结束
                    toastr.clear();
                    toastr.remove();
                    if (data.Success) {
                        // 1.清除
                        $("#div_fileExport").empty();
                        // 2.新增
                        $("#div_fileExport").append("<a id='fileExport' onclick='hidemodal();' name='fileExport' href='" + data.Message + "'>点击此处下载</a>");
                        $("#exportExc").modal("show");
                    }
                    else {
                        toastr.error(data.Message);
                    }
                }
            });
        }
        function hidemodal() {
            $("#exportExc").modal("hide");
        }
        // 保存、确认
        function Save(sign) {
            // 费目复制
            var rids = [];
            var ifcopy = false;
            if (sign == 2) {
                debugger;
                var bjstatus = jadge(CheckIfBj());
                if (bjstatus == "3") {
                    alert("警告", "存在报价无定价，无法确认报价！");
                    return false;
                } else if (bjstatus == "4") {
                    //alert("警告", "存在报价超限，无法确认报价！");
                    //return false;
                }
                var ifcheck = false;
                if ($("input[name='ifcopy']:checkbox").is(":checked")) {
                    ifcheck = true;
                }
                $.ajax({
                    url: "@Url.Action("Duplicate")",
                    async: false,
                    data: {
                        "rid": $("#BJRID").val(),
                        "feecode": $("#feecode").val()
                    },
                    dataType: "json",
                    success: function (data) {
                        if (data) {
                            if (data == "0") {

                            } else {
                                rids = data;
                                if (!ifcheck) {
                                    popDialog("消息提示", "是否复制当前到当前报价其它产品或服务下的相同费目中？", duplicate, noduplicate);
                                } else {
                                    duplicate();
                                }
                            }
                        }
                    }
                });
            } else if (sign == 1) {
                DoSave(ifcopy,sign,"",blag);
            }
            function noduplicate() {
                DoSave(ifcopy, sign,"",blag);
            }
            function duplicate() {
                ifcopy = true;
                DoSave(ifcopy, sign, rids, blag);
            }
        }
        // 是否无定价、是否超限(针对报价项目)
        function jadge(ifbj) {
            var bjstatus = "1";
            $("input.bjEditInput").each(function () {
                if (ifbj[$(this).attr("id")] == 1) {
                    console.log(ifbj[$(this).attr("id")]);
                    if ($(this).css("background-color") == "rgb(255, 69, 0)") {
                        bjstatus = "3";
                        return false;
                    } else if ($(this).css("background-color") == "rgb(255, 255, 0)") {
                        bjstatus = "4";
                    }
                }
            });
            return bjstatus;
        }
        function DoSave(ifcopy, sign, rids, blag) {
            console.log(ifcopy + ":" + sign);
            var feecode = $("#feecode").val();
            // 以下为表单项 全部填入sqm_bj_psf表
            var othername = $("#othername").val(); // 费目别名
            var discount = $("#discount").val(); // 折扣
            var bgf = ""; // 包干费
            var bjfs = ""; // 报价方式
            var qttj = ""; // 前提条件
            var flbgz = ""; // 费率表规则
            var jxjc = ""; // 解析基础
            var jdlb = ""; // 阶段类别
            var jsf = $("#jsf").val(); // 结算方
            var jsfjs = $("#jsfjs").val(); // 结算角色
            // 包干费
            if ($("input[name='bgf']:checkbox").is(":checked")) {
                bgf = "1";
            }
            // 报价方式
            $("input[name='bjfs']:radio").each(function () {
                if ($(this).is(":checked")) {
                    bjfs = $(this).val();
                }
            });
            // 前提条件
            $("input[name='qttj']:radio").each(function () {
                if ($(this).is(":checked")) {
                    qttj = $(this).val();
                }
            });
            // 费率表规则

            // 解析基础
            $("input[name='jxjc']:radio").each(function () {
                if ($(this).is(":checked")) {
                    jxjc = $(this).val();
                }
            });
            // 阶段类别
            $("input[name='jdlb']:radio").each(function () {
                if ($(this).is(":checked")) {
                    jdlb = $(this).val();
                }
            });
            var feeitems = [];
            feeitems = [{
                "ISLSC": bgf,
                "BJFS": bjfs,
                "DISCOUNT": discount,
                "RATERULE": flbgz,
                "STAGETYPE": jdlb,
                "OTHER_NAME": othername,
                "CONDITION": qttj,
                "JXJC": jxjc,
                "JSF": jsf,
                "JSFJS": jsfjs
            }];
            var psfdata = $("#psfdata").val();
            // 是否报价
            var ifbj = CheckIfBj();
            // 是否无定价、是否超限
            var bjstatus = jadge(ifbj);
            $.ajax({
                url: "@Url.Action("DoSaveKYGN")",
                type: "Post",
                data: {
                    "idguidprice": JSON.stringify(GetIdGuidprice(".bjEditInput")),
                    "idminprice":JSON.stringify(GetIdMinprice(".minEditInput")),
                    "djval": JSON.stringify(djval),
                    "feeitems": JSON.stringify(feeitems),
                    "psfdata": psfdata,
                    "sign": sign,
                    "ifcopy": ifcopy == true ? JSON.stringify(rids) : "no",
                    "ifbjitem": JSON.stringify(ifbj),
                    "feecalcid": $("#BJRID").val(),
                    "bjstatus": bjstatus
                },
                dataType: "json",
                success: function (data) {
                    toastr.clear();
                    toastr.remove();
                    if (data.Success) {
                        toastr.success(data.Message);
                        if (blag == '3' || blag == '4') {
                            setTimeout(function () { location.href = "/QM_Price/QM_PriceEdit?keyValue=" + $("#MRID").val() }, 2000);
                        } else {
                            setTimeout("window.location.reload(true)", 1000);
                        }
                    }
                    else {
                        toastr.error(data.Message);
                    }
                }
            });
        }

        // 返回
        function Back() {
            if (IsEdit) {
                Ewin.confirm({ message: "页面有修改，是否放弃保存？" }).on(function (e) {
                    if (!e) {
                        return;
                    }
                    window.location.href = "/QM_Price/QM_PriceEdit?keyValue=" + $("#MRID").val();
                });
            }
            else { window.location.href = "/QM_Price/QM_PriceEdit?keyValue=" + $("#MRID").val(); }
        }

        $("#tobjsy").click(function () {
            location.href = "/QM_Price/QM_PriceIndex";
        });
        function CheckIfBj() {
            var obj = {};
            $("input[name='checkBox']").each(function () {
                if ($(this).is(":checked")) {
                    obj[$(this).val()] = "1";
                } else {
                    obj[$(this).val()] = "0";
                }
            });
            return obj;
        }
        function checkAll() {
            if ($("input[name = 'checkRowIds']").is(":checked")) {
                $("input[name = 'checkBox']").each(function () {
                    if ($(this).is(":unchecked")) {
                        $(this).prop("checked", true);
                    }
                });
            } else if ($("input[name='checkRowIds']").is(":unchecked")) {
                $("input[name='checkBox']").each(function () {
                    if ($(this).is(":checked")) {
                        $(this).prop("checked", false);
                    }
                });
            }
        }
        function checkOne() {
            var unchecked = 0;
            $("input[name ='checkBox']").each(function (i) {
                if ($(this).is(":unchecked")) {
                    unchecked++;
                }
            });
            if (unchecked > 0) {
                $("input[name='checkRowIds']").prop("checked", false);
            }
            else if (unchecked == 0 && $("input[name='checkRowIds']").is(":unchecked")) {
                $("input[name='checkRowIds']").prop("checked", true);
            }
        }

