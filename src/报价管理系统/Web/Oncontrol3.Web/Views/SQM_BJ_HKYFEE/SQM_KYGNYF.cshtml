@{
    ViewBag.Title = "费目详情";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@{
    System.Data.DataTable psfdata = (System.Data.DataTable)ViewBag.PSFDATA;
    string status = psfdata.Rows[0]["BJSTATAUS"] + "";
}
<style>
    body {
        background-color: rgb(248,248,248);
    }

    .active {
        background-color: rgb(19,100,181) !important;
    }

    .head {
        height: 50px;
        background-color: rgb(19,100,181);
    }

        .head span {
            line-height: 98px;
            font-size: 14px;
            padding: 0px 10px 5px 10px;
            color: #ffffff;
        }

    /*.head .active {
            border-bottom: 2px solid #F8F8F8;
        }*/

    .label {
        color: #4d5d70 !important;
    }

    .inf {
        line-height: 40px;
    }

    .tel-num {
        color: #000;
        font-size: 24px;
        font-weight: bold;
    }

    .dis {
        color: #999;
    }

    #modelname {
        margin-left: 10px;
        font-size: 18px;
    }

    .controls {
        position: relative;
    }

        .controls input[type=radio] {
            opacity: 0;
        }

        .controls label {
            position: absolute;
            top: 5px;
            left: 12px;
            width: 12px;
            height: 12px;
            border-radius: 50%;
            border: 1px solid rgb(223,223,223);
            background-color: rgb(241,241,241);
        }

        .controls input[type=radio]:checked + label:after {
            content: "";
            position: absolute;
            left: 3px;
            bottom: 3px;
            width: 4px;
            height: 4px;
            border: 2px solid rgb(40,129,197);
            background-color: rgb(40,129,197);
            border-radius: 50%;
        }

    .clear {
        background-color: rgb(195,195,195);
        color: #ffffff;
        width: 70px;
    }

    .nmpd-target {
        border: 1px solid rgb(153, 153, 153);
        border-image: none;
        width: 50px;
        height: 30px;
    }

    .label-default {
        background-color: #fff;
        color: #666;
        font-weight: 100;
    }
/*********************************************************************/
    .font {
        font-size: 20px;
        color: black;
        padding-top: 10px;
    }

    .bjok {
        color: green;
    }

    .bjover {
        color: #f0ad4e;
    }

    .card-box {
        width: 100%;
        height: 100px;
        float: left;
        border: 1px solid #ccc;
        background-color: #fff;
        border-radius: 1px;
        margin-top: 5px;
        overflow: hidden;
        position: relative;
        padding-bottom: 10px;
    }

    .card-box-content {
        padding: 6px 10px;
        font-size: 14px;
        color: #4d5d70;
    }

        .card-box-content div {
            overflow: hidden;
            white-space: nowrap;
            text-overflow: ellipsis;
            margin-top: 6px;
        }

            .card-box-content div .address {
                font-size: 12px;
                color: #999999;
            }

            .card-box-content div span {
                float: left;
            }

            .card-box-content div .amount {
                text-align: right;
                width: 50px;
                color: #d0031c;
            }

            .card-box-content div .dis {
                margin-left: 30px;
            }

        .card-box-content .inf {
            font-weight: bold;
        }

        .card-box-content div .tel-num {
            width: 80px;
        }

        .card-box-content div .pickup_btn {
            float: right;
            margin-left: 56px;
            font-size: 9px;
            line-height: 18px;
            width: 70px;
            heigth: 18px;
            background-color: #319adf;
            color: white;
            text-align: center;
            border-radius: 8px;
        }

    .btns {
        margin-top: 8px;
        margin-bottom: 8px;
    }


    .ColVis {
        display: none;
    }

    .htmlstr {
        position: absolute;
        width: 1400px;
    }

    #numpad4column tbody td {
        height: 60px;
    }

    .dt-toolbar {
        padding: 0px 0px;
        border-bottom: 0px solid #ccc;
        background: #fff
    }

    .dt-toolbar-footer {
    }

    .dataTables_info {
        display: none;
    }

    .dataTables_length {
        display: none;
    }

    #numpad4column_paginate {
        display: none;
    }
    .dban .col-md-1 {
        width: 12%;
    }
</style>
<div class="row head">
    <div style="float:left">
        <div style="margin-top: -25px;">
            <span>&nbsp;&nbsp;&nbsp; 欢迎您：<span id="user">@Oncontrol3.Web.Helpers.SQMHelper.getStaffKey()</span></span>
        </div>
    </div>
    <div style="float:right; margin-right: 10px; margin-top: -25px;">
        <span class="dis">询价</span>
        <span class="dis" id="tobjmb">报价模板</span>
        <span class="dis" id="tobjmb">非报价模板</span>
        <span class="dis active" id="tobjsy">报价首页</span>
    </div>
</div>
<div style="display:none;">
    <input id="psfdata" value="@ViewBag.psfall" />
    <input id="unitval" />
    <input id="ifbj" />
    <input id="DJRID" value="@ViewBag.DJRID" />
    <input id="BJRID" value="@ViewBag.BJRID" />
    <input id="MRID" value="@psfdata.Rows[0]["MRID"]" />
    <input id="idguidprice" />
    <input id="idminprice" />
    <input id="feecode" value="@psfdata.Rows[0]["FEE_CODE"]" />
</div>
<div class="row" style="background-color: #fff;">
    <div class="col-md-12">
        <div class="card-box" style="height:100%;">
            <div class="card-box-content">
                <div class="inf"><span class="tel-num" id="feename">费目：@psfdata.Rows[0]["FEE_NAME"]</span><span class="dis address" style="margin-left:100px;float: right;" id="bpname">商机：@ViewBag.BIZNAME</span><span class="dis address" id="bizname" style="float: right;">客户：@ViewBag.BPNAME</span></div>
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <div class="card-box" style="height:100%;">
            <div class="card-box-content">
                <div class="row">
                    <div class="col-md-4">
                        <div class="col-md-4" style="margin-top:10px;width:100px;">
                            <h4><label class="label label label-default">结算方</label></h4>
                        </div>
                        <div class="col-md-8">
                            <input id="jsf" type="text" class="form-control col-md-8" placeholder="请输入结算方" value="@if (psfdata.Rows[0]["JSF"] + "" != "") { @Html.Raw(psfdata.Rows[0]["JSF"]);} else {@Html.Raw(ViewBag.BPNAME);}" />
                        </div>

                    </div>
                    <div class="col-md-6">
                        <div class="col-md-4" style="margin-top:10px;width:100px;">
                            <h4><label class="label label label-default">结算角色</label></h4>
                        </div>
                        <div class="col-md-5">
                            <input id="jsfjs" type="text" class="form-control col-md-8" value="@if (psfdata.Rows[0]["JSFJS"] + "" != "") { @Html.Raw(psfdata.Rows[0]["JSFJS"]);} else {@Html.Raw("");}">
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-4">
                        <div class="col-md-4" style="margin-top:10px;width:100px;">
                            <h4><label class="label label label-default">费目别名</label></h4>
                        </div>
                        <div class="col-md-8" style="margin-top:6px;">
                            <input id="othername" type="text" class="form-control col-md-8" placeholder="请输入费目别名" value="@if (psfdata.Rows[0]["OTHER_NAME"] + "" != ""){@Html.Raw(psfdata.Rows[0]["OTHER_NAME"]);}else{@Html.Raw(psfdata.Rows[0]["FEE_NAME"]);} ">
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="col-md-5" style="margin-top:10px;">
                            <h4><label class="label label label-default">折扣</label></h4>
                        </div>
                        <div class="col-md-7" style="margin-top:6px;">
                            <input id="discount" type="text" class="form-control col-md-7" placeholder="请输入折扣" value="@if(psfdata.Rows[0]["DISCOUNT"] + "" == ""){@Html.Raw("100"); }else{@Html.Raw(psfdata.Rows[0]["DISCOUNT"])}" /><label style="margin-top:5px;">%</label>
                        </div>
                    </div>
                    <label class="col-md-3 ptbj" style="margin-top:6px;">
                        <div class="col-md-3">
                            <input type="checkbox" name="bgf" />
                        </div>
                        <div class="col-md-9" style="margin-top:10px;">
                            @*<h4><label>包干费</label></h4>*@
                            <p>包干费</p>
                        </div>
                    </label>
                    <div class="col-md-3">
                        <div class="col-md-4" style="margin-top:10px;width:60px">
                            <h4><label class="label label label-default">状态</label></h4>
                        </div>
                        <div class="col-md-8" style="margin-top:12px;">
                            <p>
                                @if (status == "1")
                                {
                                    @Html.Raw("已保存");
                                }
                                else if (status == "2")
                                {
                                    @Html.Raw("已确认");
                                }
                                else if (status == "0")
                                {
                                    @Html.Raw("未保存")
                                }
                                else if (status == "3")
                                {
                                    @Html.Raw("已保存（报价无定价）")
                                }
                                else if (status == "4")
                                {
                                    @Html.Raw("已保存（报价超限）")
                                }
                                else if (status == "5")
                                {
                                    @Html.Raw("已确认（报价超限）")
                                }
                            </p>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-7" style="padding-right:0px;">
                        <div class="col-md-4" style="margin-top:10px;width:100px;">
                            <h4><label class="label label label-default">报价方式</label></h4>
                        </div>
                        <div class="col-md-8">
                            <label class="col-md-3" style="width:100px;">
                                <div style="float:left;">
                                    <input type="radio" name="bjfs" value="0" />
                                </div>
                                <label style="margin-top:10px;margin-left:10px;">普通报价</label>
                            </label>
                            <label class="col-md-3" style="width:100px;">
                                <div style="float:left">
                                    <input type="radio" name="bjfs" value="1" />
                                </div>
                                <label style="margin-top:10px;margin-left:10px;">At Cost</label>
                            </label>
                            <label class="col-md-3" style="width:100px;">
                                <div style="float:left">
                                    <input type="radio" name="bjfs" value="2" />
                                </div>
                                <label style="margin-top:10px;margin-left:10px;">单票单询</label>
                            </label>
                        </div>
                    </div>
                    <div class="col-md-6 ptbj">
                        <div class="col-md-4" style="margin-top:10px;width:100px;">
                            <h4><label class="label label label-default">报价单位</label></h4>
                        </div>
                        <div class="col-md-8">
                            @for (int i = 0; i < psfdata.Rows.Count; i++)
                {
                    <label class="col-md-3" style="width:100px;">
                        <div style="float:left;">
                            <input type="radio" name="bjdw" value="@psfdata.Rows[i]["CACLUNIT"]" />
                        </div>
                        <label style="margin-top:10px;margin-left:10px;">@psfdata.Rows[i]["CACLUNIT"]</label>
                    </label>
    }
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6 ptbj" style="padding-right:0px;">
                        <div class="col-md-4" style="margin-top:10px;width:100px;">
                            <h4><label class="label label label-default">是否报价</label></h4>
                        </div>
                        <div class="col-md-8">
                            <label class="col-md-3" style="width:100px;">
                                <div style="float:left;">
                                    <input type="radio" name="ifbj" value="" />
                                </div>
                                <label style="margin-top:10px;margin-left:10px;">全部</label>
                            </label>
                            <label class="col-md-3" style="width:100px;">
                                <div style="float:left">
                                    <input type="radio" name="ifbj" value="1" />
                                </div>
                                <label style="margin-top:10px;margin-left:10px;">报价项目</label>
                            </label>
                            <label class="col-md-3" style="width:100px;">
                                <div style="float:left">
                                    <input type="radio" name="ifbj" value="0" />
                                </div>
                                <label style="margin-top:10px;margin-left:10px;">不报价项目</label>
                            </label>
                        </div>
                    </div>
                </div>
                <div class="row ptbj">
                    <div class="col-md-12">
                        <div class="col-md-3">
                            <div class="btn-group">
                                <a class="btn btn-success" id="addModal" data-toggle="modal" data-target="#bjAdd" onclick="Add();return false;">增加</a>
                            </div>
                            <div class="btn-group">
                                <button type="submit" class="btn btn-default" onclick="ImportExc();">导入</button>
                            </div>
                            <div class="btn-group">
                                <button type="submit" class="btn btn-default" onclick="ExportExc();">导出</button>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-12 ptbj">
                        <table id="numpad4column" class="table table-striped table-hover"></table>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-12">
                        <div class="col-md-2" style="margin-top:10px;width:100px;">
                            <h4><label class="label label label-default">前提条件</label></h4>
                        </div>
                        <label class="col-md-2" style="width:170px;">
                            <div class="col-md-3" style="float:left;">
                                <input type="radio" name="qttj" value="ZPRECON_Z01" />
                            </div>
                            <label class="col-md-8" style="margin-top:12px;">ZPRECON_Z01</label>
                        </label>
                        <label class="col-md-2" style="width:170px;">
                            <div class="col-md-3" style="float:left;">
                                <input type="radio" name="qttj" value="ZPRECON_Z02" />
                            </div>
                            <label class="col-md-8" style="margin-top:12px;">ZPRECON_Z02</label>
                        </label>
                        <label class="col-md-2" style="width:170px;">
                            <div class="col-md-3" style="float:left;">
                                <input type="radio" name="qttj" value="ZPRECON_Z03" />
                            </div>
                            <label class="col-md-8" style="margin-top:12px;">ZPRECON_Z03</label>
                        </label>
                        <label class="col-md-2" style="width:170px;">
                            <div class="col-md-3" style="float:left;">
                                <input type="radio" name="qttj" value="ZPRECON_Z04" />
                            </div>
                            <label class="col-md-8" style="margin-top:12px;">ZPRECON_Z04</label>
                        </label>
                        <label class="col-md-2" style="width:170px;">
                            <div class="col-md-3" style="float:left;">
                                <input type="radio" name="qttj" value="ZPRECON_Z05" />
                            </div>
                            <label class="col-md-8" style="margin-top:12px;">ZPRECON_Z05</label>
                        </label>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-12">
                        <div class="col-md-2" style="margin-top:10px;width:100px;">
                        </div>
                        <label class="col-md-2" style="width:170px;">
                            <div class="col-md-3" style="float:left;">
                                <input type="radio" name="qttj" value="ZPRECON_Z06" />
                            </div>
                            <label class="col-md-8" style="margin-top:12px;">ZPRECON_Z06</label>
                        </label>
                        <label class="col-md-2" style="width:170px;">
                            <div class="col-md-3" style="float:left;">
                                <input type="radio" name="qttj" value="ZPRECON_Z07" />
                            </div>
                            <label class="col-md-8" style="margin-top:12px;">ZPRECON_Z07</label>
                        </label>
                        <label class="col-md-2" style="width:170px;">
                            <div class="col-md-3" style="float:left;">
                                <input type="radio" name="qttj" value="ZPRECON_Z08" />
                            </div>
                            <label class="col-md-8" style="margin-top:12px;">ZPRECON_Z08</label>
                        </label>
                        <label class="col-md-2" style="width:170px;">
                            <div class="col-md-3" style="float:left;">
                                <input type="radio" name="qttj" value="ZPRECON_Z09" />
                            </div>
                            <label class="col-md-8" style="margin-top:12px;">ZPRECON_Z09</label>
                        </label>
                        <div class="col-md-2">
                            <div class="btn-group">
                                <button class="btn btn-default" onclick="Clearqttj()">清除</button>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row ptbj">
                    <div class="col-md-12">
                        <div class="col-md-2" style="margin-top:10px;width:150px;">
                            <h4><label class="label label label-default">费率表确定规则</label></h4>
                        </div>
                        <div class="col-md-3" style="margin-top:10px;">
                            <input type="text" class="form-control col-md-8" placeholder="请输入费率表确定规则">
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-12">
                        <div class="col-md-2" style="margin-top:10px;width:100px;">
                            <h4><label class="label label label-default">解析基础</label></h4>
                        </div>
                        <label class="col-md-2" style="width:170px;">
                            <div class="col-md-3" style="float:left;">
                                <input type="radio" name="jxjc" value="Package" />
                            </div>
                            <label class="col-md-8" style="margin-top:12px;">Package</label>
                        </label>
                        <label class="col-md-2" style="width:170px;">
                            <div class="col-md-3" style="float:left;">
                                <input type="radio" name="jxjc" value="Service" />
                            </div>
                            <label class="col-md-8" style="margin-top:12px;">Service</label>
                        </label>
                        <label class="col-md-2" style="width:170px;">
                            <div class="col-md-3" style="float:left;">
                                <input type="radio" name="jxjc" value="Passive Resource" />
                            </div>
                            <label class="col-md-8" style="margin-top:12px;">Passive Resource</label>
                        </label>
                        <div class="col-md-2">
                            <div class="btn-group">
                                <button type="submit" class="btn btn-default" onclick="Clearjxjc()">清除</button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-12">
                        <div class="col-md-2" style="margin-top:10px;width:100px;">
                            <h4><label class="label label label-default">阶段类别</label></h4>
                        </div>
                        <label class="col-md-2" style="width:170px;">
                            <div class="col-md-3" style="float:left;">
                                <input type="radio" name="jdlb" value="P-首程运输段" />
                            </div>
                            <label class="col-md-8" style="margin-top:12px;">P-首程运输段</label>
                        </label>
                        <label class="col-md-2" style="width:170px;">
                            <div class="col-md-3" style="float:left;">
                                <input type="radio" name="jdlb" value="M-主运输段" />
                            </div>
                            <label class="col-md-8" style="margin-top:12px;">M-主运输段</label>
                        </label>
                        <label class="col-md-2" style="width:170px;">
                            <div class="col-md-3" style="float:left;">
                                <input type="radio" name="jdlb" value="O-续运输段" />
                            </div>
                            <label class="col-md-8" style="margin-top:12px;">O-续运输段</label>
                        </label>
                        <div class="col-md-2">
                            <div class="btn-group">
                                <button type="submit" class="btn btn-default" onclick="Clearjdlb()">清除</button>
                            </div>
                        </div>
                    </div>
                </div>
                <label class="col-md-12">
                    <div class="col-md-1">
                        <input type="checkbox" name="ifcopy" value="" />
                    </div>
                    <label class="col-md-8" style="margin-top:12px;">复制到当前报价相同的费目（在不同产品、服务下的同一费目，报价相同）</label>
                </label>
                <div class="col-md-12 ptbj">
                    <div class="col-md-12" style="margin-top:10px;">
                        <h3 style="display:inline;"><label class="label label label-danger" style="background-color:#FFFF00;color:black;">注：黄底数字表示报价超限</label></h3>
                        <h3 style="display:inline;"><label class="label label label-danger" style="background-color:#FF4500;color:black;">橙底数字表示此报价无定价</label></h3>
                    </div>
                </div>
                <div class="col-md-12 dban">
                    <div class="col-md-1">

                    </div>
                    <div class="col-md-1">
                        <div class="btn-group">
                            <button class="btn btn-default" onclick="Save(1);">保存</button>
                        </div>
                    </div>
                    <div class="col-md-1">
                        <div class="btn-group">
                            <button class="btn btn-default" onclick="Save(1,3);">保存并返回</button>
                        </div>
                    </div>
                    <div class="col-md-1">
                        <div class="btn-group">
                            <button class="btn btn-default" onclick="Save(2);">确认</button>
                        </div>
                    </div>
                    <div class="col-md-1">
                        <div class="btn-group">
                            <button class="btn btn-default" onclick="Save(2,4);">保存确认并返回</button>
                        </div>
                    </div>
                    <div class="col-md-1">
                        <div class="btn-group">
                            <button class="btn btn-default exportexc" onclick="ExportExc();">导出</button>
                        </div>
                    </div>
                    <div class="col-md-1">
                        <div class="btn-group">
                            <button class="btn btn-default importexc" onclick="ImportExc();">导入</button>
                        </div>
                    </div>
                    <div class="col-md-1">
                        <div class="btn-group">
                            <button class="btn btn-default" onclick="Back();">返回</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- 明细新增 -->
    <div class="modal fade" id="bjAdd" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
