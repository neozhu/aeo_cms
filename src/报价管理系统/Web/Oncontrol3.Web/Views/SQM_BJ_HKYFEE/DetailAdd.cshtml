@{
    Layout = "~/Views/Shared/_Layout2.cshtml";
}
@model Com.Feiliks.QDM.SQM_MODEDJ_VAL
@{
    bool gyl = @ViewBag.gyl;
    bool khy = @ViewBag.khy;
    bool kyyf = @ViewBag.kyyf;
    System.Data.DataTable FCREFdt = (System.Data.DataTable)ViewBag.FCREFData;
    System.Data.DataTable UNITdt = (System.Data.DataTable)ViewBag.UNITData;
    System.Data.DataTable JSJCdt = (System.Data.DataTable)ViewBag.JSJCdt;
    System.Data.DataTable DJFSdt = (System.Data.DataTable)ViewBag.DJFSData;
}
<style type="text/css">
    .smart-form * {
        box-sizing: inherit;
    }

    .smart-form .row {
        margin: 0;
        width: 50%;
        float: left;
        height: 85px;
    }

    .smart-form .col-3 {
        width: 100%;
    }

    /*表格end*/
    .smart-form fieldset {
        padding: 8px 14px 26px;
        background: #fafafa;
    }

    .smart-form footer {
        background: #fafafa;
    }
    .grid {
        margin: 0px;
        border-collapse: collapse;
        table-layout: fixed;
    }

        .grid tbody td {
            text-align: left;
            border-bottom: 1px solid #ccc;
            border-left: 1px solid #ccc;
            border-right: 1px solid #ccc;
            height: 22px;
            word-break: break-all;
        }

        .grid tbody .selected {
            background-color: #6DA47D;
            color: #fff;
            cursor: pointer;
        }
</style>
<div>
    <section id="widget-grid" class="">
        <div class="row">
            <article class="col-sm-12 col-md-12 col-lg-12 sortable-grid ui-sortable">
                <div class="jarviswidget jarviswidget-sortable" data-widget-colorbutton="false" data-widget-editbutton="false" data-widget-custombutton="false">
                    <header>
                    </header>
                    <div role="content">
                        <div class="jarviswidget-editbox"></div>
                        <div class="widget-body no-padding">
                            <form id="formmain" class="smart-form form-backgroud" target="_blank">
                                <fieldset>
                                    <input type="hidden" value="@ViewBag.DJRID" id="DJRID">
                                    <input type="hidden" value="@ViewBag.BJRID" id="BJRID">
                                    @for (int i = 0; i < FCREFdt.Rows.Count; i++)
                                    {
                                    @*@if (!(FCREFdt.Rows[i]["MDMTYPE"] is System.DBNull) && (String)FCREFdt.Rows[i]["MDMTYPE"] == "XX")*@
                                    if (FCREFdt.Rows[i]["CALCCODE"].ToString().IndexOf("XX") >= 0)
                                    {
                                    <div class="row">   
                                        <section class="col col-3">
                                            <label class="label">@FCREFdt.Rows[i]["CALCNAME"]<i style="color:red">*</i></label>
                                            <label class="input">
                                                <select style="width:100%" id="@FCREFdt.Rows[i]["VALCOL"]" name="@FCREFdt.Rows[i]["CALCCODE"]" class="select2">
                                                    <option value="20GP">20GP</option>
                                                    <option value="40GP">40GP</option>
                                                    <option value="40HQ">40HQ</option>
                                                </select>
                                            </label>    
                                        </section>
                                    </div>
                                    }
                                    else if (FCREFdt.Rows[i]["CALCCODE"].ToString().IndexOf("KHR") >= 0)
                                    {
                                    <div class="row">
                                        <section class="col col-3">
                                            <label class="label">@FCREFdt.Rows[i]["CALCNAME"]<i style="color:red">*</i></label>
                                            <label class="input">
                                                <select style="width:100%" id="@FCREFdt.Rows[i]["VALCOL"]" name="@FCREFdt.Rows[i]["CALCCODE"]" class="select2">
                                                    <option value="MON">MON</option>
                                                    <option value="TUE">TUE</option>
                                                    <option value="WED">WED</option>
                                                    <option value="THU">THU</option>
                                                    <option value="FRI">FRI</option>
                                                    <option value="SAT">SAT</option>
                                                    <option value="SUN">SUN</option>
                                                </select>
                                            </label>
                                        </section>
                                    </div>
                                    }
                                    else if (FCREFdt.Rows[i]["CALCCODE"].ToString().IndexOf("ZL") >= 0)
                                    {
                                    <div class="row">
                                        <section class="col col-3">
                                            <label class="label">@FCREFdt.Rows[i]["CALCNAME"]<i style="color:red">*</i></label>
                                            <label class="input">
                                                <select style="width:100%" id="@FCREFdt.Rows[i]["VALCOL"]" name="@FCREFdt.Rows[i]["CALCCODE"]" class="select2">
                                                    <option value="<45">小于45</option>
                                                    <option value="[45,100]">[45,100]</option>
                                                    <option value="[100,1000]">[100,1000]</option>
                                                    <option value=">1000">大于1000</option>
                                                </select>
                                            </label>
                                        </section>
                                    </div>
                                    }
                                    else if (FCREFdt.Rows[i]["CALCCODE"].ToString().IndexOf("HWLB") >= 0)
                                    {
                                    <div class="row">
                                        <section class="col col-3">
                                            <label class="label">@FCREFdt.Rows[i]["CALCNAME"]<i style="color:red">*</i></label>
                                            <label class="input">
                                                <select style="width:100%" id="@FCREFdt.Rows[i]["VALCOL"]" name="@FCREFdt.Rows[i]["CALCCODE"]" class="select2">
                                                    <option value="普货">普货</option>
                                                    <option value="危险品">危险品</option>
                                                    <option value="冻品">冻品</option>
                                                    <option value="A">A</option>
                                                    <option value="B">B</option>
                                                    <option value="C">C</option>
                                                    <option value="D">D</option>
                                                    <option value="E">E</option>
                                                    <option value="H">H</option>
                                                    <option value="G">G</option>
                                                </select>
                                            </label>
                                        </section>
                                    </div>
                                    }
                                    else if (FCREFdt.Rows[i]["CALCCODE"].ToString().IndexOf("SKB") >= 0)
                                    {
                                    <div class="row">
                                        <section class="col col-3">
                                            <label class="label">@FCREFdt.Rows[i]["CALCNAME"]</label>
                                            <label class="input">
                                                <input type="text" class="form-control" id="@FCREFdt.Rows[i]["VALCOL"]" name="@FCREFdt.Rows[i]["CALCCODE"]" placeholder="格式：15:30">
                                            </label>
                                        </section>
                                    </div>
                                    }
                                    else
                                    {
                                    <div class="row">
                                        <section class="col col-3">
                                            <label class="label">@FCREFdt.Rows[i]["CALCNAME"]<i style="color:red">*</i></label>
                                            <label class="input">
                                                <input type="text" class="form-control" id="@FCREFdt.Rows[i]["VALCOL"]" name="@FCREFdt.Rows[i]["CALCCODE"]" mdmtype="@FCREFdt.Rows[i]["MDMTYPE"]" mdmkey="@FCREFdt.Rows[i]["MDMKEY"]" mdmfieldname="@FCREFdt.Rows[i]["MDMFIELDNAME"]" required>
                                            </label>
                                        </section>
                                    </div>
                                    }
                                    }

                                    @if (DJFSdt != null && DJFSdt.Rows.Count > 0 && !String.IsNullOrEmpty(DJFSdt.Rows[0]["DJFSRID"].ToString()))
                                    {
                                    <div class="row">
                                        <section class="col col-3">
                                            <label class="label">定价方式</label>
                                            <label class="input">
                                                <select style="width:100%" id="DJFSRID" name="DJFSRID" class="select2">
                                                    <option></option>
                                                    @for (int i = 0; i < DJFSdt.Rows.Count; i++)
                                                    {
                                                    <option value="@DJFSdt.Rows[i]["DJFSRID"]">@DJFSdt.Rows[i]["DJFSNAME"]</option>
                                                    }
                                                </select>
                                            </label>
                                        </section>
                                    </div>
                                    }
                                    <div class="row">
                                        <section class="col col-3">
                                            <label class="label">计费单位</label>
                                            <label class="input">
                                                <select style="width:100%" id="CALCUNIT" name="CALCUNIT" class="select2">
                                                    <option></option>
                                                    @for (int i = 0; i < UNITdt.Rows.Count; i++)
                                                    {
                                                    <option value="@UNITdt.Rows[i]["CACLUNIT"]">@UNITdt.Rows[i]["CACLUNIT"]</option>
                                                    }
                                                </select>
                                            </label>
                                        </section>
                                    </div>
                                    @if (gyl)
                                    {
                                    <div class="row">
                                        <section class="col col-3">
                                            <label class="label">计算基础</label>
                                            <label class="input">
                                                <select style="width:100%" id="CALCCODE" name="CALCCODE" class="select2">
                                                    @for (int i = 0; i < JSJCdt.Rows.Count; i++)
                                                    {
                                                    <option value="@JSJCdt.Rows[i]["CALCCODE"]">@JSJCdt.Rows[i]["CALCNAME"]</option>
                                                    }
                                                </select>
                                            </label>
                                        </section>
                                    </div>
                                    }
                                    else
                                    {
                                    <div class="row">
                                        <section class="col col-3">
                                            <label class="label">币种</label>
                                            <label class="input">
                                                <input type="text" class="form-control" id="CURRENCY" name="CURRENCY" mdmtype="MDM" mdmkey="WAERS" mdmfieldname="WAERS,KTEXT" mdmcode="BZCODE">
                                            </label>
                                        </section>
                                    </div>
                                    }
                                    @if(kyyf){
                                        @*<div class="row">
                                            <section class="col col-3">
                                                <label class="label">S</label>
                                                <label class="input">
                                                    <input type="text" class="form-control" id="SPRICE" name="SPRICE" value="">
                                                </label>
                                            </section>
                                        </div>*@
                                        <div class="row">
                                            <section class="col col-3">
                                                <label class="label">MIN</label>
                                                <label class="input">
                                                    <input type="text" class="form-control" id="MIN" name="MIN" value="">
                                                </label>
                                            </section>
                                        </div>
                                    }
                                    
                                    <div class="row">
                                        <section class="col col-3">
                                            <label class="label">报价</label>
                                            <label class="input">
                                                <input type="text" class="form-control" id="BJPRICE" name="BJPRICE" value="">
                                            </label>
                                        </section>
                                    </div>
                                    <div class="row">
                                        <section class="col col-3">
                                            <label class="label">起始日期<i style="color:red">*</i></label>
                                            <label class="input">
                                                <div class="input-group date">
                                                    <input class="form-control form-date" type="text" id="STARTDATE" name="STARTDATE" readonly="readonly">
                                                    <span class="input-group-addon"><i class="fa fa-calendar"></i></span>
                                                </div>
                                            </label>
                                        </section>
                                    </div>
                                    <div class="row">
                                        <section class="col col-3">
                                            <label class="label">截止日期</label>
                                            <label class="input">
                                                <div class="input-group date">
                                                    <input class="form-control form-date" type="text" id="ENDDATE" name="ENDDATE" readonly="readonly" placeholder="默认为:9999/12/31">
                                                    <span class="input-group-addon"><i class="fa fa-calendar"></i></span>
                                                </div>
                                            </label>
                                        </section>
                                    </div>
                                    <div class="row" style="width: 98%;margin:0px 15px;">
                                        <section>
                                            <label class="label">备注</label>
                                            <label class="textarea">
                                                <i class="icon-append fa fa-comment"></i>
                                                <textarea rows="4" name="MEMO" id="MEMO">@Model.MEMO</textarea>
                                            </label>
                                        </section>
                                    </div>
                                </fieldset>
                                <footer>
                                    <button class="btn btn-primary" onclick="dosave(); return false;">
                                        保存
                                    </button>
                                </footer>
                            </form>
                        </div>
                    </div>
                </div>
            </article>
        </div>
    </section>
</div>
<script type="text/javascript">
    var keyValue = "";
    var IsEdit = false;
    var username;
    $(function () {
        if ($("#khy").val()) {
            BindInputChange();
            }
        $("#formmain").find("input,select,textarea").each(function () {
            $(this).attr("autocomplete", "off");
        });
        BindAutocompleteMDM();
        var errorClass = 'invalid';
        var errorElement = 'em';
        // 表单验证
        $('#formmain').validate({
            errorClass: errorClass,
            errorElement: errorElement,
            highlight: function (element) {
                $(element).parent().removeClass('state-success').addClass("state-error");
                $(element).removeClass('valid');
            },
            unhighlight: function (element) {
                $(element).parent().removeClass("state-error").addClass('state-success');
                $(element).addClass('valid');
            },

            // Rules for form validation
            rules: {
                PURPRICE: {
                    required: true
                },
                COSTPRICE: {
                    required: true
                },
                MAXPRICE: {
                    required: true
                },
                MINPRICE: {
                    required: true
                },
                GUIDEPRICE: {
                    required: true
                },
                STARTDATE: {
                    required: true
                },
                SKB: {
                    time: true
                }
            },

            // Messages for form validation
            messages: {
                PURPRICE: {
                    required: '必填'
                },
                COSTPRICE: {
                    required: '必填'
                },
                MAXPRICE: {
                    required: '必填'
                },
                MINPRICE: {
                    required: '必填'
                },
                GUIDEPRICE: {
                    required: '必填'
                },
                STARTDATE: {
                    required: '必填'
                }
            },
            errorPlacement: function (error, element) {
                error.insertAfter(element.parent());
            }
        });
        // 重写validate
        jQuery.validator.addMethod("time", function (value, element) {
            var length = value.length;
            var regName = /^(?:(?:[0-2]{0,1}[0-3])|(?:[0-1]{0,1}[0-9])):[0-5]{0,1}[0-9]$|^$/;
            var regName2 = /^(?:(?:[0-2]{0,1}[0-3])|(?:[0-1]{0,1}[0-9]))：[0-5]{0,1}[0-9]$|^$/;
            return regName.test(value) || regName2.test(value);
        }, "格式不符合要求，参照 15:30");
        keyValue = $("#DJRID").val();
        // 币种默认为美元
        $("#CURRENCY").val("USD");
        // 计费单位默认为：票
        $("#CALCUNIT").val("票");
        $(".form-date").datetimepicker({
            format: "yyyy/mm/dd",
            autoclose: true,
            todayBtn: true,
            todayHighlight: true,
            startView: 2,
            minView: 2,
            clearBtn: true,
            language: "zh-CN"
        });
    });
    var IsEdit = false;
    $(document).ready(function () {
        if ("@ViewBag.djfsrid" != "") {
            $("#DJFSRID").select2('val', "@ViewBag.djfsrid");
        }
        $("input").change(function () {
            IsEdit = true;
        });
    });
    // 保存
    function dosave() {
        if (!$("#formmain").valid()) {
            return;
        }
        //if ($("#CALCUNIT").val() == null) {
        //    toastr.error("请选择计费单位！");
        //    return;
        //}
        var nowtime = new Date(new Date() - 1000 * 60 * 60 * 24);
        var starttime = new Date(Date.parse($("#STARTDATE").val()));
        if (starttime < nowtime) {
            toastr.error("起始日期不能小于当前日期！");
            return;
        }
        if ($("#ENDDATE").val().length == 0) {
            $("#ENDDATE").val('9999/12/31');
        }
        if ($("#STARTDATE").val() >= $("#ENDDATE").val()) {
            toastr.error("截止日期不能小于或等于起始日期！");
            return;
        }
        toastr.info("数据保存中，请稍候...");
        var postdata = GetWebControls("#formmain");
        try {
            $("#btnSave").attr("disabled", "disabled");
            $.ajax({
                url: "/SQM_BJ_HKYFEE/PurSave",
                type: "post",
                data: {
                    'postdata': JSON.stringify(postdata),
                    'djrid': "@ViewBag.DJRID",
                    'bjrid': $("#BJRID").val(),
                    'ifdj':"@ViewBag.IFDJ"
                },
                dataType: "json",
                success: function (data) {
                    toastr.clear();
                    toastr.remove();
                    if (data.Success) {
                        toastr.success(data.Message);
                        $("#bjAdd").modal("hide");
                        $("#numpad4column").DataTable().search("").draw();
                    } else {
                        toastr.error(data.Message);
                    }
                },
                error: function (data) {

                }
            });
        } catch (e) {
            window.alert("保存失败，请重试");
        } finally {
            $("#btnSave").removeAttr("disabled");
        }
    };
    function GetWebControls(element) {
        var postdata = {};
        debugger;
        $(element).find('input,select,textarea').each(function (r) {
            var id = $(this).attr('id');
            if (id == "MIN") {
                id = "MINBJPRICE";
            }
            var value = $(this).val();
            var type = $(this).attr('type');
            postdata[id] = value;
        });
        return postdata;
    }
    // 控件绑定数据源
    function BindAutocompleteMDM() {
        $("[mdmtype='MDM']").each(function () {
            if ($("#kyyf").val()) {
                AutocompleteMDM($(this).attr("id"), "kygj");
            } else {
                AutocompleteMDM($(this).attr("id"));
            }
        });
        $("[mdmtype='MDMGK']").each(function () {
            AutocompleteMDMGK($(this).attr("id"));
        });
        $("input").change(function () {
            $(this).css("background-color", "#FFFFCC");
        });
    }
</script>
