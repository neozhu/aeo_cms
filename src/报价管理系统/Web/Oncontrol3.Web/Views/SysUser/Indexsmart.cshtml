@{
    ViewBag.Title = "系统账号管理";
}
<!-- MAIN CONTENT -->
<style>
    tr .selected {
        background-color: lightgray;
    }
</style>
<div id="content">


    <!-- widget grid -->
    <section id="widget-grid" class="">

        <!-- row -->
        <div class="row">
            <!-- NEW WIDGET START -->
            <article class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
                <!-- Widget ID (each widget will need unique ID)-->
                <div class="jarviswidget jarviswidget-color-blueDark" id="wid-id-2" data-widget-editbutton="false" data-widget-deletebutton="false">
                    <!-- widget options:
                    usage: <div class="jarviswidget" id="wid-id-0" data-widget-editbutton="false">
                    data-widget-colorbutton="false"
                    data-widget-editbutton="false"
                    data-widget-togglebutton="false"
                    data-widget-deletebutton="false"
                    data-widget-fullscreenbutton="false"
                    data-widget-custombutton="false"
                    data-widget-collapsed="true"
                    data-widget-sortable="false"
                    -->
                    <header></header>
                    <!-- widget div-->
                    <div>
                        <!-- end widget edit box -->
                        <div class="widget-body">
                            <form id="form1">
                                <div class="row searchrow">
                                    <label class="col-md-1 control-label">用户名</label>
                                    <div class="col-sm-2">
                                        <input class="form-control" id="Name" name="Name">
                                    </div>
                                    <label class="col-md-1 control-label">登录名</label>
                                    <div class="col-sm-2">
                                        <input class="form-control" id="LoginName" name="LoginName">
                                    </div>
                                    <label class="col-md-1 control-label">状态</label>
                                    <div class="col-sm-2">
                                        <select style="width:100%" id="Status" name="Status" class="select2"></select>
                                    </div>
                                    <div class="clear10"></div>
                                </div>
                                <div style="display:none" id="more_sc">
                                    <div class="row searchrow">
                                        <label class="col-md-1 control-label">创建日期</label>
                                        <div class="col-sm-2">
                                            <div class="input-group">
                                                <input type="text" id="CreateDateS" name="CreateDateS" placeholder="开始" class="form-control datepicker" data-dateformat="mm/dd/yy">
                                                <span class="input-group-addon"><i class="fa fa-calendar"></i></span>
                                            </div>
                                        </div>
                                        <label class="col-md-1 control-label">~</label>
                                        <div class="col-sm-2">
                                            <div class="input-group">
                                                <input type="text" id="CreateDateE" name="CreateDateE" placeholder="结束" class="form-control datepicker" data-dateformat="mm/dd/yy">
                                                <span class="input-group-addon"><i class="fa fa-calendar"></i></span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="sc_more">
                                    <button class="btn btn-primary" id="addnew" style="float:left"><i class="fa fa-plus-square-o"></i> 添加</button>
                                    <a class="control-label" href="javascript:void(0);" id="sc_more">更多查询条件</a>
                                    <button class="btn btn-primary" id="submit_search" style="float:right">查询</button>
                                </div>
                            </form>
                        </div>
                        <!-- widget content -->
                        <div class="widget-body no-padding">
                            <table id="datatable_col_reorder" class="table table-striped table-bordered table-hover" width="100%"></table>
                        </div>
                        <!-- end widget content -->
                    </div>
                    <!-- end widget div -->
                </div>
                <!-- end widget -->
            </article>
            <!-- WIDGET END -->
        </div>
        <!-- end row -->

    </section>
    <!-- end widget grid -->

</div>
<!-- END MAIN CONTENT -->
@section pagespecific {
    <script type="text/javascript">

        $(document).ready(function () {
            //列定义
            var columns = [{
                "title": "操作", "data": "UserID", "width": "60", "orderable": false,
                render: function (data, type, row, meta) {
                    return '<button class="btn btn-xs btn-default" onclick=editrow(\"' + data + '\") ><i class="fa fa-pencil"></i></button>'
                    + '<button class="btn btn-xs btn-default" onclick=deleterow(\"' + data + '\") ><i class="fa fa-times"></i></button>';
                }
            },
                            { "title": "用户名", "orderable": true, "data": "Name", "width": "100" },
                            { "title": "登录名", "data": "LoginName" },
                            { "title": "邮箱", "data": "Email" },
                            {
                                "title": "创建日期", "data": "CreateDate", "width": "100",
                                "render": function (data, type, full, meta) {
                                    return data == null ? "" : data.split('T')[0];//格式化只显示日期部分
                                }
                            }
            ];
            var table = $('#datatable_col_reorder').DataTable({
                "processing": true,
                "serverSide": true,
                "autoWidth": true,
                "order": [[4, "desc"]],//第一次加载默认第5列日期倒排
                "language": { "info": "Total : _TOTAL_", "paginate": { "first": "<<", "last": ">>", "next": ">", "previous": "<" } },//语言
                "sDom": "<'dt-toolbar'<'col-xs-12 col-sm-6'><'col-sm-6 col-xs-12 hidden-xs'>r>" + "t" +
                    "<'dt-toolbar-footer'<'col-sm-6 col-xs-12 hidden-xs'i><'col-xs-12 col-sm-6'pl>>",//整个griddom布局
                "lengthMenu": [[4, 10, 20, 50, 100], [4, 10, 20, 50, 100]],//每页显示key text
                "displayLength": 4,//默认每页显示条目数
                "ajax": {
                    "url": "@Url.Action("Listsmart")",//数据源controller
                    "type": "POST",
                    "data": function (d) {//查询参数
                        d.sort = d.columns[d.order[0].column].data;//排序列名转换
                        d.order = d.order[0].dir;//asc or desc
                        d.LoginName = $("#LoginName").val();
                        d.Name = $("#Name").val();
                        d.Status = $("#Status").val();
                        d.CreateDateE = $("#CreateDateE").val();
                        d.CreateDateS = $("#CreateDateS").val();
                    }
                }, columns: columns
            });
            var dataSel = @Html.Raw(ViewBag.StatusSel);
            $(dataSel).each(function(k, o) {
                $("#Status").append($("<option></option>").attr("value", o.Code).html(o.Name));
            });
        })
        $("#submit_search").click(function () {
            $('#datatable_col_reorder').DataTable().search("").draw();
            return false;
        });

        $("#sc_more").click(function () {
            $("#more_sc").toggle();
            var cls = $(this).attr("class");
            if (cls == 'clk') {
                $(this).removeClass('clk');
            } else {
                $(this).addClass('clk');
            }
        })


        function editrow(id) {
            alert(id);
        }
        function deleterow(id) {
            if(confirm('确认要删除选中的账号吗,账号删除请慎重?'))
            {
                $.ajax({
                    url: "@Url.Action("Delete")",
                    data: { id: id },
                    type: "GET",
                    success: function (data) {
                        alert(data);
                        $("#submit_search").click();
                    }
                });
            }
        }
    </script>
}