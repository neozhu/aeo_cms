@{
    ViewBag.title = "商机列表";
    Layout = "~/Views/Shared/_LayoutMobile.cshtml";
}

    <style>
        * {
            padding: 0;
            margin: 0;
        }
        /*基本样式*/
        #box {
            position: absolute;
            height: 100%;
            width: 100%;
            background: #fff !important;
        }

        header {
            width: 100%;
            height: 5%;
            position: fixed;
            overflow: scroll;
            z-index: 1;
            border-bottom: 3px solid;
        }

            header .row input {
                border: none;
            }

        .innerBox {
            width: 100%;
            height: 88%;
            position: fixed;
            overflow: scroll;
            z-index: 1;
            top: 5%;
            padding: 5px;
        }

        footer {
            width: 100%;
            height: 7%;
            position: fixed;
            z-index: 1;
            top: 93%;
            border-top: 3px solid;
        }

            footer div button {
                background: #fff;
            }

        .sj {
            padding: 10px;
        }

            .sj button {
                background: linear-gradient(#D6DBEC,#6F85A2);
            }
    </style>

    <div id="box">
        <!--顶部搜索框-->
        <header>
            <div class="row">
                <div class="col-xs-10">
                    <input id="key" class="form-control" placeholder="客户名称">
                </div>
                <div class="col-xs-2 searchBtn" style="padding-top:5px;">
                    <i class="fa fa-search fa-lg" aria-hidden="true"></i>
                </div>
            </div>
        </header>
        <!--中间内容-->
        <div class="innerBox">
            <div id="sjList"></div>
        </div>
        <!--底部导航栏-->
        <footer>
            <div class='btn-group btn-group-lg col-xs-2 '>
                <button id="backBtn" class='btn btn-block foot' onclick="window.history.go(-1);"><span>&lt;</span></button>
            </div>
            <div class='btn-group col-xs-pull-1 btn-group-lg col-xs-10 '>
                <button class='btn btn-block foot'><span id="bpname"></span></button>
            </div>
        </footer>
    </div>
    <script type="text/javascript" src="~/Scripts/libs/jquery-2.1.1.min.js"></script>
    <script src="/Content/QO/toastr/toastr.min.js"></script>
    <link rel="stylesheet" href="/Content/QO/toastr/toastr.min.css">
    <script type="text/javascript">

        var username;
        //从服务页点击切换事业部
        var currentOrg = "";
        //权限工号
        var hygh = '10002959,10003579,10000513,20000067,10000698,10001759,10003511';
        var kygh = '';
        $(document).ready(function () {
            var user = '@Oncontrol3.Web.Helpers.SQMHelper.getStaffKey()';
            if (user.length < 1) {
                layer.alert('系统登录已超时，请重新登录', { icon: 2 });
            }
            else {
                username = user;
            }
            InitPage();
        });

        //截取产品名称
        String.prototype.trim = function () {
            if (this.length > 6) {
                return this.substring(0, 5) + "...";
            } else {
                return this;
            }
        }
        //商机
        var sjArray = [];
        function InitPage() {
            //加载组织数据
            $.ajax({
                url: "/Mobel_BJ/SJList",
                data: {
                    bpcode: "@ViewBag.bpcode",
                },
                dataType: "json",
                async: false,
                success: function (data) {
                    sjArray = data;
                    var sjStr = "";
                    for (var i = 0; i < sjArray.length; i++) {
                        sjStr += "<div class='btn-group btn-group-lg col-xs-6 col-sm-3 sj'><button type='submit' class='btn btn-primary btn-block' name = '" + sjArray[i][0] + "' sjcode='" + sjArray[i][1] + "' mrid='" + sjArray[i][2] + "' >" + sjArray[i][0].trim() + "</button></div>";
                    }
                    $("#sjList").append(sjStr);
                    if (sjArray.length > 0) {
                        $("#bpname").text(sjArray[0][2]);
                    }
                }
            });
        }

        $("#sjList").on('click', '.sj button', function () {
            var sjcode = $(this).attr("sjcode");
            window.location.href = "/Mobel_BJ/SJIndex?sjcode=" + sjcode;
        })

        //组织下的商机
        $("#bpList").on('click', '.bp button', function () {
            var bpcode = $(this).attr("bpcode");
            //alert("商机！！！" + bpcode);
            window.location.href = "/Mobel_BJ/bpIndex?bpcode=" + bpcode;

        })

        $("header").on('click', '.searchBtn', function () {
            InitPage();
        })
    </script>
