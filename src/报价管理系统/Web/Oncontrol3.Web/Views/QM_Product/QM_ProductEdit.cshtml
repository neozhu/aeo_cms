@{
    ViewBag.Title = "编辑产品";
    Layout = "~/Views/Shared/_LayoutTM.cshtml";
}
<style type="text/css">
    tr .selected {
        background-color: lightgray;
    }

    .DTFC_LeftWrapper {
        top: -6px !important;
    }

    .DTFC_RightWrapper {
        top: -7px !important;
    }

    .tbbtn {
        margin-left: 50px;
    }

    .fwfmss {
        min-height:0px !important;
    }

        .fwfmss .row {
            float: left;
            width: 40%;
        }

            .fwfmss .row .col-3 {
                width: 48%;
            }

        .fwfmss button {
            width: 45px;
            line-height: 30px;
        }
</style>
<div id="content">
    <section id="widget-grid" class="">
        <div class="row">
            <article class="col-sm-12 col-md-12 col-lg-12 sortable-grid ui-sortable">
                <div class="jarviswidget jarviswidget-sortable" data-widget-colorbutton="false" data-widget-editbutton="false" data-widget-custombutton="false">
                    <header>
                        <span class="widget-icon"><i class="fa fa-edit"></i></span>
                        <h2>报价管理/<span style="color:#ffd600!important">产品维护</span></h2>
                        <div style="float:right;">
                            <button type="submit" class="btn btn-primary" id="btnSave" onclick="dosave(); return false;">
                                保存
                            </button>
                            <button type="submit" class="btn btn-default" id="btnback" onclick="back()">
                                返回
                            </button>
                            @*<button type="submit" class="btn btn-default" id="btnback" onclick="Add(); return false;">
                                    新增有效区间
                                </button>*@
                        </div>
                    </header>
                    <div role="content">
                        <div class="jarviswidget-editbox"></div>
                        <div class="widget-body no-padding">
                            <form id="formmain" class="smart-form form-backgroud">
                                <fieldset>
                                    <div class="row">
                                        <section class="col col-3">
                                            <label class="label">产品代码<span style="color:red">*</span></label>
                                            <label class="input">
                                                <input type="text" class="form-control" id="ID" style="display:none;">
                                                <input type="text" class="form-control" id="PRODUCTKEY" name="pcode">
                                            </label>
                                        </section>
                                        <section class="col col-3">
                                            <label class="label">产品名称<span style="color:red">*</span></label>
                                            <label class="input">
                                                <input type="text" class="form-control" id="SQPRODUCTNAME" name="pname">
                                            </label>
                                        </section>
                                        <section class="col col-3">
                                            <label class="label">事业部<span style="color:red">*</span></label>
                                            <label class="input">
                                                <select style="width:100%" id="BUSINESSORG" name="porg" class="select2"></select>
                                                @*<input type="text" class="form-control" id="BUSINESSORG" name="porg">*@
                                            </label>
                                        </section>
                                        <section class="col col-3">
                                            <label class="label">产品经理<span style="color:red">*</span></label>
                                            <label class="input">
                                                <input type="text" class="form-control" id="PRODUCTMANAGERNAME" name="pmng">
                                            </label>
                                        </section>
                                    </div>
                                    <div class="row" style="display:none;">
                                        <section class="col col-3">
                                            <label class="label">业务类型</label>
                                            <label class="input">
                                                <select style="width:100%" id="BUSINESSTYPE" name="pywlx" class="select2"></select>
                                            </label>
                                        </section>
                                        @*<section class="col col-3">
                                                <label class="label">启用日期开始</label>
                                                <label class="input">
                                                    <div class="input-group date">
                                                        <input class="form-control form-date" type="text" id="DTFROM" readonly="readonly">
                                                        <span class="input-group-addon"><i class="fa fa-calendar"></i></span>
                                                    </div>
                                                </label>
                                            </section>
                                            <section class="col col-3">
                                                <label class="label">启用日期结束</label>
                                                <label class="input">
                                                    <div class="input-group date">
                                                        <input class="form-control form-date" type="text" id="DTTO" readonly="readonly">
                                                        <span class="input-group-addon"><i class="fa fa-calendar"></i></span>
                                                    </div>
                                                </label>
                                            </section>*@
                                        <section class="col col-3">
                                            <label class="label">延期免税毛利率<span style="color:red">*</span></label>
                                            <label class="input">
                                                <input type="text" class="form-control" id="DEAGIRATE" name="prate">
                                            </label>
                                        </section>

                                        @*<section class="col col-3" id="section_dtfrom">
                                                <label class="label">有效起始日<span style="color:red">*</span></label>
                                                <label class="input">
                                                    <div class="input-group date">
                                                        <input class="form-control form-date" type="text" id="DTFROM_HEAD" name="dtfrom" readonly="readonly" >
                                                        <span class="input-group-addon"><i class="fa fa-calendar"></i></span>
                                                    </div>
                                                </label>
                                            </section>
                                            <section class="col col-3"  id="section_dtto">
                                                <label class="label">有效截止日<span style="color:red">*</span></label>
                                                <label class="input">
                                                    <div class="input-group date">
                                                        <input class="form-control form-date" type="text" id="DTTO_HEAD" name="dtto" readonly="readonly">
                                                        <input class="form-control form-date" type="text" id="DTTO_OLD" name="dtto" readonly="readonly" style="display:none;">
                                                        <span class="input-group-addon"><i class="fa fa-calendar"></i></span>
                                                    </div>
                                                </label>
                                            </section>*@
                                    </div>
                                    <div class="row">
                                        <section class="col col-3" style="display:none;">
                                            <label class="label">SAP产品代码</label>
                                            <label class="input">
                                                <input type="text" class="form-control" id="">
                                            </label>
                                        </section>
                                        <section class="col col-3" style="display:none;">
                                            <label class="label">&nbsp;</label>
                                            <label class="checkbox"><input type="checkbox" name="STATUS" id="STATUS"><i></i>启用状态</label>
                                        </section>
                                        <section class="col col-3" style="display:none;">
                                            <label class="label">SORD</label>
                                            <label class="input">
                                                <input type="text" class="form-control" id="SORD">
                                            </label>
                                        </section>
                                    </div>
                                    @*<div class="row">
                                            <section class="col col-3">
                                                <label class="radio"><input type="radio" name="rdSTATUS" id="rdSTATUS"><i></i>单选框</label>
                                            </section>
                                        </div>*@
                                    <section>
                                        <label class="label">备注</label>
                                        <label class="textarea">
                                            <i class="icon-append fa fa-comment"></i>
                                            <textarea rows="4" name="pmemo" id="MEMO"></textarea>
                                        </label>
                                    </section>
                                    <div class="row" style="margin-bottom:20px;">
                                        <button type="button" class="btn btn-success" data-toggle="collapse"
                                                data-target="#table" style="margin-left:20px;">
                                            服务、费目以及计算方式信息
                                        </button>
                                        <button type="submit" class="btn btn-info tbbtn" onclick="ZSyncPSF(); return false;">
                                            同步
                                        </button>
                                    </div>
                                    <div class="widget-body fwfmss">
                                        <form id="form1" class="smart-form form-backgroud">
                                            <div class="row">
                                                <section class="col col-3">
                                                    <label class="input">
                                                        <input class="form-control" id="SERVICENAME" name="SERVICENAME" placeholder="服务名称或类型">
                                                    </label>
                                                </section>
                                                <section class="col col-3">
                                                    <label class="input">
                                                        <input class="form-control" id="TEXTDESC" name="TEXTDESC" placeholder="费目名称或代码">
                                                    </label>
                                                </section>
                                            </div>
                                        </form>
                                        <button type="submit" class="btn btn-default" id="submit_search">
                                            查询
                                        </button>
                                    </div>
                                    <!-- widget content -->
                                    <div class="widget-body no-padding collapse in" id="table">
                                        <table id="datatable_col_reorder" class="table table-striped table-bordered table-hover"></table>
                                    </div>
                                    <div class="row" style="margin-bottom:20px;">
                                        <button type="button" class="btn btn-success" data-toggle="collapse"
                                                data-target="#dateTable" style="margin-left:20px; margin-top:10px">
                                            有效时间区间列表
                                        </button>
                                    </div>
                                    <div class="widget-body no-padding collapse in" id="dateTable">
                                        <table id="datatable_col_reorder_date" class="table table-striped table-bordered table-hover"></table>
                                    </div>
                                    <div class="row" style="margin-bottom:20px; ">
                                        <button type="button" class="btn btn-success" data-toggle="collapse"
                                                data-target="#record" style="margin-left:20px;margin-top:20px; ">
                                            操作记录
                                        </button>
                                    </div>
                                    <div class="row collapse in" id="record">
                                        <section class="col col-3">
                                            <label class="label">创建时间</label>
                                            <label class="input">
                                                <div class="input-group date">
                                                    <input class="form-control form-date" type="text" id="CREATETIME" style="background-color:#eee;" disabled="disabled">
                                                    <span class="input-group-addon"><i class="fa fa-calendar"></i></span>
                                                </div>
                                            </label>
                                        </section>
                                        <section class="col col-3">
                                            <label class="label">创建人</label>
                                            <label class="input">
                                                <input type="text" class="form-control" id="CREATEUSER" style="background-color:#eee;" disabled="disabled">
                                            </label>
                                        </section>
                                        <section class="col col-3">
                                            <label class="label">修改时间</label>
                                            <label class="input">
                                                <div class="input-group date">
                                                    <input class="form-control form-date" type="text" id="MODIFYTIME" style="background-color:#eee;" disabled="disabled">
                                                    <span class="input-group-addon"><i class="fa fa-calendar"></i></span>
                                                </div>
                                            </label>
                                        </section>
                                        <section class="col col-3">
                                            <label class="label">修改人</label>
                                            <label class="input">
                                                <input type="text" class="form-control" id="MODIFYUSER" style="background-color:#eee;" disabled="disabled">
                                            </label>
                                        </section>

                                    </div>
                                    <!-- end widget content -->
                                </fieldset>
                                <footer>
                                    <button class="btn btn-primary" onclick="dosave(); return false;">
                                        保存
                                    </button>
                                </footer>
                            </form>
                        </div>
                    </div>
                </div>
            </article>
        </div>
    </section>
</div>
@section pagespecific {
    <script src="~/Content/QO/scripts/framework.js?v=@DateTime.Now.ToString("yyyyMMddhhmmss")"></script>
    <script src="~/Content/QO/scripts/Ewin.js"></script>
    <script src="/js/lib/jquery.plug-ins.js" type="text/javascript"></script>
    <script src="/scripts/plugin/datatables/dataTables.colReorder.min.js" type="text/javascript"></script>
    <script src="/scripts/plugin/datatables/dataTables.colVis.min.js" type="text/javascript"></script>
    <script src="/scripts/plugin/datatables/dataTables.fixedColumns.min.js" type="text/javascript"></script>
    <script src="/scripts/plugin/datatables/dataTables.fixedHeader.js" type="text/javascript"></script>
    <script src="~/Content/QO/toastr/toastr.min.js"></script>
    <link rel="stylesheet" href="~/Content/QO/toastr/toastr.min.css">
    <link href="~/Content/QO/scripts/bootstrap-datetimepicker/css/bootstrap-datetimepicker.min.css" rel="stylesheet">
    <script src="~/Content/QO/scripts/bootstrap-datetimepicker/js/bootstrap-datetimepicker.min.js"></script>
    <script type="text/javascript" src="~/Content/QO/scripts/bootstrap-datetimepicker/js/locales/bootstrap-datetimepicker.zh-CN.js" charset="UTF-8"></script>
    <script src="~/Scripts/plugin/jquery-validate/jquery.validate.min.js"></script>
    <link href="~/Content/QO/scripts/icheck/skins/square/blue.css" rel="stylesheet">
    <script src="~/Content/QO/scripts/icheck/icheck.min.js"></script>
    <script src="~/Content/QO/layer/layer.js"></script>
    <script type="text/javascript">


        //全局数据
        var dataList = [{ Code: ' ', Name: ' ' }, { Code: 'OI01', Name: '海运出口' }, { Code: 'OI02', Name: '海运进口' }, { Code: 'GXYS', Name: '干线运输' }, { Code: 'GNYS', Name: '国内运输' }, { Code: 'LI01', Name: '陆运出口' }, { Code: 'LI02', Name: '陆运进口' }, { Code: 'GNJZ', Name: '国内结转' }, { Code: 'SFWL', Name: '三方物流' }, { Code: 'OI02', Name: '仅报关' }, { Code: 'DJBS', Name: '叠加保税' }, { Code: 'MY', Name: '贸易' }, { Code: 'GNHY', Name: '国内海运' }, { Code: 'KJQC', Name: '空进全程' }, { Code: 'KCQC', Name: '空出全程' }];
        var busorg = [{ Code: '', Name: '' }, { Code: '海运', Name: '海运' }, { Code: '空运', Name: '空运' }, { Code: '供应链', Name: '供应链' }, { Code: '运输', Name: '运输' }, ]
        var keyValue = "";
        var IsEdit = false;
        var res;
        var dataSel = [{ Code: '', Name: '' }, { Code: '1', Name: '启用' }, { Code: '0', Name: '停用' }];
        var postdata_ext_period;
        var postdata_srvsord;
        var postdata_feesord;
        //初始化icheck
        function iCheckStyled() {
            $('input').iCheck({
                checkboxClass: 'icheckbox_square-blue',
                radioClass: 'iradio_square-blue'
            });
        }

        //表单校验
        var errorClass = 'invalid';
        var errorElement = 'em';

        $('#formmain').validate({
            errorClass: errorClass,
            errorElement: errorElement,
            highlight: function (element) {
                $(element).parent().removeClass('state-success').addClass("state-error");
                $(element).removeClass('valid');
            },
            unhighlight: function (element) {
                $(element).parent().removeClass("state-error").addClass('state-success');
                $(element).addClass('valid');
            },

            // Rules for form validation
            rules: {
                pcode: {
                    required: true
                },
                pname: {
                    required: true
                },
                porg: {
                    required: true
                },
                pmng: {
                    required: true
                },
                prate: {
                    required: true,
                    range: [0, 100]
                },
                //pywlx: {
                //    required: true
                //},
                dtfrom: {
                    required: true,
                },
                dtto: {
                    required: true,
                }
                //pmemo: {
                //    required: true,
                //    rangelength: [10, 100]
                //}
            },

            // Messages for form validation
            messages: {
                pcode: {
                    required: ' 必填'
                },
                pname: {
                    required: ' 必填'
                },
                porg: {
                    required: ' 必填'
                },
                pmng: {
                    required: '必填'
                },
                prate: {
                    required: '必填',
                    range: '请输入0到100的数字'
                },
                //pywlx: {
                //    required: ' 必选'
                //},
                dtfrom: {
                    required: ' 必填'
                },
                dtto: {
                    required: ' 必填'
                }
                //pmemo: {
                //    required: ' 必填',
                //    rangelength: $.validator.format("请输入长度介于 {0} 和 {1} 之间的字符串")
                //}
            },

            // Do not change code below
            errorPlacement: function (error, element) {
                error.insertAfter(element.parent());
            }
        });
        $(function () {
            var user = '@Oncontrol3.Web.Helpers.SQMHelper.getStaffKey()';
            $("#user").text(user);
            if (user.length < 1) {
                layer.alert('系统登录已超时，请重新登录', { icon: 2 });
            }
            //else {
            //    layer.alert('当前登录账户：' + user, { icon: 1 });
            //}
            iCheckStyled();
            $("#amenufld").trigger("click");
            $("#amenufld").css("display", "none");
            $("#logout").css("display", "none");
            $(dataList).each(function (k, o) {
                $("#BUSINESSTYPE").append($("<option></option>").attr("value", o.Code).html(o.Name));
            });
            $(busorg).each(function (k, o) {
                $("#BUSINESSORG").append($("<option></option>").attr("value", o.Code).html(o.Name));
            });

            keyValue = request('keyValue');


            if (!!keyValue) {
                $("#PRODUCTKEY").attr("disabled", "disabled");
                //$("#section_dtfrom").attr("style", "display:none");
                //$("#section_dtto").attr("style", "display:none");
                //基本数据获取
                $.ajax({
                    url: "/QM_Product/GetFormJson",
                    data: { keyValue: keyValue },
                    dataType: "json",
                    async: false,
                    success: function (result) {
                        //console.log(data);
                        res = result.data[0];
                        $("#formmain").SetWebControls(res);
                        var cuser = res["CREATEUSER"];
                        var muser = res["MODIFYUSER"];
                        if (!!result.data2) {
                            for (var i = 0; i < result.data2.length; i++) {
                                if (result.data2[i]["WORKNO"] == cuser) {
                                    $("#CREATEUSER").val(result.data2[i]["NAME"]);
                                }
                                if (result.data2[i]["WORKNO"] == muser) {
                                    $("#MODIFYUSER").val(result.data2[i]["NAME"]);
                                }
                            }
                        }
                    }
                });
                //有效期数据获取
                //$.ajax({
                //    url: "/QM_Product/GetDateJson",
                //    data: { keyValue: keyValue },
                //    dataType: "json",
                //    async: false,
                //    success: function (data) {
                //        console.log(data);
                //        res = data[0];
                //        $("#DTTO").val(formatDate2(res.DTTO, "yyyy/MM/dd"));
                //        $("#DTTO_OLD").val(formatDate2(res.DTTO, "yyyy/MM/dd"));
                //        $("#DTFROM").val(formatDate2(res.DTFROM, "yyyy/MM/dd"));
                //    }
                //});
            }

            toastr.options = {
                closeButton: false,
                debug: false,
                progressBar: true,
                positionClass: "toast-top-center",
                onclick: null,
                showDuration: "300",
                hideDuration: "1000",
                timeOut: "3000",
                extendedTimeOut: "1000",
                showEasing: "swing",
                hideEasing: "linear",
                showMethod: "fadeIn",
                hideMethod: "fadeOut"
            };

            $(".form-date").datetimepicker({
                format: "yyyy/mm/dd",
                autoclose: true,
                todayBtn: true,
                todayHighlight: true,
                startView: 2,
                minView: 2,
                clearBtn: true,
                language: "zh-CN"
            });

        });


        $(document).ready(function () {
            $("input").change(function () {
                IsEdit = true;
            });

            detectmob();

            $("#spinner").spinner();
            $("#spinner-decimal").spinner({
                step: 0.01,
                numberFormat: "n"
            });

            $("#fixedleftnum").val($.cookie("bjfixedcol") || 4);
            DrawTable();
            DrawDateTable();
            $("div[class='ColVis']").hide();

        });

        function DrawTable() {
            //列定义
            var columns = [{
                "title": "序号", "data": null, "width": "60", "orderable": false
            },
            { "title": "产品类型", "data": "PRODUCTCODE", "width": "120", "orderable": false ,"visible": false},
                { "title": "涉及的服务类型", "data": "SERVICETYPECODE", "width": "120", "orderable": false },
                { "title": "涉及的服务名称", "data": "SERVICENAME", "width": "120", "orderable": false },
                {
                    "title": "排序维护", "data": "SERVICETYPECODE", "width": "60", "orderable": false,
                    render: function (data, type, row, meta) {
                        return '<button title="服务排序" class="btn btn-xs btn-default" onclick=" doSrvSort(\'' + data + '\',\'' + row.PRODUCTCODE + '\');return false;"><i class="fa fa-sort"></i></button>'
                    }
                },
                {
                    "title": "服务排序", "data": "SRVSORD", "width": "60", "orderable": false

                },
                { "title": "费目代码", "data": "TCET084", "width": "120", "orderable": false },
                { "title": "费目", "data": "TEXTDESC", "width": "120", "orderable": false },
                             {
                                 "title": "排序维护", "data": "RID", "width": "60", "orderable": false,
                                 render: function (data, type, full, meta) {
                                     if (data != null) {
                                         return '<button title="服务排序" class="btn btn-xs btn-default" onclick=" doFeeSort(\'' + data + '\',\'' + full.FEESORD + '\',\'' + full.TCET084 + '\',\'' + full.SERVICETYPECODE + '\',\'' + full.PRODUCTCODE + '\');return false;"><i class="fa fa-sort"></i></button>'
                                     } else {
                                         return "";
                                     }
                                 }
                             },
                             {
                                 "title": "费目排序", "data": "FEESORD", "width": "60", "orderable": false

                             },
                             {
                                 "title": "必选费目维护", "data": "BXBJ", "width": "80", "orderable": false,
                                 render: function (data, type, full, meta) {
                                     if (full.TCET084 != null) {
                                         return '<button title="必选费目维护" class="btn btn-xs btn-default" onclick=" doFeeBXBJ(\'' + data + '\',\'' + full.RID + '\',\'' + full.SERVICETYPECODE + '\',\'' + full.TCET084 + '\',\'' + full.PRODUCTCODE + '\');return false;"><i class="fa fa-pencil"></i></button>'
                                     } else {
                                         return "";
                                     }
                                 }
                             },
                             {
                                 "title": "必选费目标记", "data": "BXBJ", "width": "80", "orderable": false

                             },
                             { "title": "备注", "data": "MEMO", "width": "340", "orderable": false },
            ];
            var table = $('#datatable_col_reorder').dataTable({
                //"processing": true,
                "serverSide": true,
                "colReorder": true,
                "scrollX": true,
                "fixedColumns": {
                    leftColumns: $.cookie("bjfixedcol") || $("#fixedleftnum").val()
                },
                "bStateSave": true,
                "order": [[1, "desc"]],
                "fnDrawCallback": function () {
                    var api = this.api();
                    var startIndex = api.context[0]._iDisplayStart;        //获取到本页开始的条数 　
                    api.column(0).nodes().each(function (cell, i) {
                        cell.innerHTML = startIndex + i + 1;
                    });
                },
                "language": {
                    "info": "第 _START_ 到 _END_ 条记录，共 _TOTAL_ 条",
                    "infoEmpty": "第 0 到 0 条记录，共 0 条",
                    'emptyTable': '没有检索到数据',
                    'zeroRecords': '没有检索到数据',
                    'loadingRecords': '加载中...',
                    'processing': '查询中...',
                    "paginate": { "first": "<<", "last": ">>", "next": ">", "previous": "<" }
                },//语言
                "sDom": "<'dt-toolbar'<'col-xs-12 col-sm-6'><'col-sm-6 col-xs-12 hidden-xs'>r>" + "t" +
                    "<'dt-toolbar-footer'<'col-sm-6 col-xs-12 hidden-xs'i><'col-xs-12 col-sm-6'plC>>",//整个griddom布局
                "lengthMenu": [[4, 10, 20, 50, 100], [4, 10, 20, 50, 100]],//每页显示key text
                "displayLength": 10,//默认每页显示条目数
                "ajax": {
