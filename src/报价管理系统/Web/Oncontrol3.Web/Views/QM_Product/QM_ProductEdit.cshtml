        //保存时间区间
        function saveDate(rid) {

            //表单校验
            if ($("#DTFROM").val() == null || $("#DTFROM").val() == undefined || $("#DTFROM").val() == "") {
                toastr.error("起始日期不能为空！");
                return;
            }
            if ($("#DTTO").val() == null || $("#DTTO").val() == undefined || $("#DTTO").val() == "") {
                toastr.error("截止日期不能为空！");
                return;
            }
            if ($("#DATE_STATUS").val() == null || $("#DATE_STATUS").val() == undefined || $("#DATE_STATUS").val() == "") {
                toastr.error("启用状态不能为空！");
                return;
            }
            if ($("#DTFROM").val() > $("#DTTO").val()) {
                toastr.error("起始日期不能大于截止日期！");
                return;
            }
            //先保存头部信息
            //dosave();
            postdata_ext_period = {};
            postdata_ext_period["PRODUCTKEY"] = $("#PRODUCTKEY").val();
            postdata_ext_period["DTFROM"] = $("#DTFROM").val();
            postdata_ext_period["DTTO"] = $("#DTTO").val();
            postdata_ext_period["STATUS"] = $("#DATE_STATUS").val();
            postdata_ext_period["MEMO"] = $("#DATE_MEMO").val();

            toastr.info("数据保存中，请稍候...");

            //$("#btnSave_date").attr("disabled", "disabled");
            $.ajax({
                url: "@Url.Action("SubmitDate")",
                type: "post",
                data: {
                    'postdata_ext_period': JSON.stringify(postdata_ext_period),
                    'rid': rid,
                    'keyValue': keyValue
                },
                dataType: "json",
                async: false,
                success: function (data) {
                    toastr.clear();
                    toastr.remove();
                    if (data.Success) {
                        $('#selfAlert').modal('hide');
                        $("#datatable_col_reorder_date").DataTable().search("").draw();

                    } else {
                        toastr.error(data.Message);
                    }

                },
                error: function (data) {
                    if (!!data.responseText) {
                        alert(data.responseText);
                    } else {
                        window.alert("请求失败！");
                    }
                }
            })


        };
