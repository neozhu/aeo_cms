@{
    ViewBag.Title = "报价导入";
    Layout = "~/Views/Shared/_LayoutTM.cshtml";
}
<style>
    .cpfnlb {
        background-color: #ddd;
    }

    .font {
        font-size: 20px;
        color: black;
        padding-top: 10px;
    }

    .bjok {
        color: green;
    }

    .bjover {
        color: #f0ad4e;
    }

    .cshbj {
        color: white;
    }

    .bjwdj {
        color: red;
    }

    .card-box {
        width: 100%;
        height: 100px;
        float: left;
        border: 1px solid #ccc;
        background-color: #fff;
        border-radius: 1px;
        margin-top: 5px;
        overflow: visible;
        position: relative;
    }

    .card-box-content {
        padding: 6px 10px;
        font-size: 14px;
        color: #4d5d70;
    }

        .card-box-content div {
            overflow: hidden;
            white-space: nowrap;
            text-overflow: ellipsis;
            margin-top: 6px;
        }

            .card-box-content div .address {
                font-size: 12px;
                color: #999999;
            }

            .card-box-content div span {
                float: left;
            }

            .card-box-content div .amount {
                text-align: right;
                width: 50px;
                color: #d0031c;
            }

            .card-box-content div .dis {
                margin-left: 30px;
            }

        .card-box-content .inf {
            font-weight: bold;
        }

        .card-box-content div .tel-num {
            width: 80px;
        }

        .card-box-content div .pickup_btn {
            float: right;
            margin-left: 56px;
            font-size: 9px;
            line-height: 18px;
            width: 70px;
            heigth: 18px;
            background-color: #319adf;
            color: white;
            text-align: center;
            border-radius: 8px;
        }

    .btns {
        margin-top: 8px;
        margin-bottom: 8px;
    }

    .title {
        color: red;
        font: 12px;
    }

    .bigtittle {
        color: red;
        font-size: 20px;
        align-content: center;
        text-align: center;
        font-weight: bold;
    }

    .head {
        color: #999;
        margin-top: 7px;
        margin-bottom: 7px;
    }

    .dis {
        margin-right: 50px;
    }

    .fstbox {
        height: 100%;
        padding-bottom: 20px;
        padding-top: 20px;
    }

    .FEE {
        margin-bottom: 15px;
        display: none;
    }

    .SRV {
        display: block;
    }

    .prdhead {
        float: right;
        color: black;
        font-size: 30px;
    }

    .labelright {
        margin-right: 40px;
    }

    .inlabel {
        margin-bottom: 15px;
    }

    .body {
        overflow: scroll !important
    }
</style>
<div class="row head">
    <div style="float:left">
        <span>&nbsp;&nbsp;&nbsp; 欢迎您：@Oncontrol3.Web.Helpers.SQMHelper.getStaffKey()</span>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <div class="card-box fstbox" id="cardbox">
            <div class="btn-group  col-md-1" style="margin-right:20px;">
                <button type="submit" class="btn btn-default" id="ImportExcel"><span class="widget-icon">EXCEL上传</span></button>
            </div>
            @*<div class="btn-group  col-md-1">
                    <button type="submit" class="btn btn-default" onclick="ExportExc();"><span class="widget-icon">EXCEL下载</span></button>
                </div>
                <div class="btn-group  col-md-1">
                    <button type="submit" class="btn btn-default" onclick="Preview();"><span class="widget-icon">报价预览</span></button>
                </div>*@
        </div>
    </div>
</div>

<!-- 模态框（Modal）选择文件 -->
<div class="modal fade" id="importExc" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">
                    &times;
                </button>
                <h4 class="modal-title" id="chooseExc">
                    导入EXCEL文件
                </h4>
            </div>
            <div class="modal-body">
                <form id="importFileForm" method="post" enctype="multipart/form-data" action="">
                    <div id="div_fileImport">
                        <input id="fileImport" name="fileImport" type="file" class="file-loading">
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
<!-- 进度条 -->
<div class="modal fade" id="progressbar" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">
                    &times;
                </button>
                <h4 class="modal-title" id="chooseExc">
                    文件导入中
                </h4>
            </div>
            <div class="modal-body">
                <form id="importFileForm" method="post" enctype="multipart/form-data" action="">
                    <div class="progress progress-striped active">
                        <div class="progress-bar progress-bar-info" aria-valuemax="100" aria-valuemin="0" aria-valuenow="40" style="width:100%"></div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
<!--  弹窗 aria-hidden="true" 模态框不可见  -->
<div class="modal fade" id="modalAlert" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">
                    &times;
                </button>
                <h4 class="modal-title" id="messageAlert">
                    消息提示
                </h4>
            </div>
            <div class="modal-body" style="max-height:350px;overflow-y:scroll;">
                <form id="importFileForm" method="post" enctype="multipart/form-data" action="">
                    <div id="div_fileImport">
                        <div id="message"></div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-dismiss="modal">确定</button>
            </div>
        </div>
    </div>
</div>
<iframe name="frameFile" style="display: none;"></iframe>
@section pagespecific {
    <script src="~/Content/QO/scripts/framework.js?v=@DateTime.Now.ToString("yyyyMMddhhmmss")"></script>
    <script src="~/Content/QO/scripts/Ewin.js"></script>
    <script src="/js/lib/jquery.plug-ins.js" type="text/javascript"></script>
    <script src="/scripts/plugin/datatables/dataTables.colReorder.min.js" type="text/javascript"></script>
    <script src="/scripts/plugin/datatables/dataTables.colVis.min.js" type="text/javascript"></script>
    <script src="/scripts/plugin/datatables/dataTables.fixedColumns.min.js" type="text/javascript"></script>
    <script src="/scripts/plugin/datatables/dataTables.fixedHeader.js" type="text/javascript"></script>
    <script src="~/Content/QO/toastr/toastr.min.js"></script>
    <link href="~/Content/QO/scripts/bootstrap-fileinput-master/css/fileinput.min.css" rel="stylesheet">
    <script src="~/Content/QO/scripts/bootstrap-fileinput-master/js/fileinput.min.js"></script>
    <script src="~/Content/QO/scripts/bootstrap-fileinput-master/js/locales/zh.js"></script>
    <link rel="stylesheet" href="~/Content/QO/toastr/toastr.min.css">
    <link href="~/Content/QO/scripts/bootstrap-datetimepicker/css/bootstrap-datetimepicker.min.css" rel="stylesheet">
    <script src="~/Content/QO/scripts/bootstrap-datetimepicker/js/bootstrap-datetimepicker.min.js"></script>
    <script type="text/javascript" src="~/Content/QO/scripts/bootstrap-datetimepicker/js/locales/bootstrap-datetimepicker.zh-CN.js" charset="UTF-8"></script>
    <link href="~/Content/QO/scripts/icheck/skins/square/blue.css" rel="stylesheet">
    <script src="~/Content/QO/scripts/icheck/icheck.min.js"></script>
    <script src="~/Scripts/plugin/jquery-validate/jquery.validate.min.js"></script>
    <link href="~/Content/QO/scripts/bootstrap-datetimepicker/css/bootstrap-datetimepicker.min.css" rel="stylesheet">
    <script src="~/Content/QO/scripts/bootstrap-datetimepicker/js/bootstrap-datetimepicker.min.js"></script>
    <script type="text/javascript" src="~/Content/QO/scripts/bootstrap-datetimepicker/js/locales/bootstrap-datetimepicker.zh-CN.js" charset="UTF-8"></script>
    <script type="text/javascript">
        // 全局变量
        var alist;
        // 页面开始加载
        $(function () {
            $("#amenufld").hide();
            $("#logout").hide();
            $("#amenufld").click();
            detectmob();
            //resize(true);
            //初始化toast
            toastr.options = {
                closeButton: false,
                debug: false,
                progressBar: true,
                positionClass: "toast-top-center",
                onclick: null,
                showDuration: "300",
                hideDuration: "1000",
                timeOut: "3000",
                extendedTimeOut: "1000",
                showEasing: "swing",
                hideEasing: "linear",
                showMethod: "fadeIn",
                hideMethod: "fadeOut"
            };
            // 初始化fileinput
            var oFileInput = new FileInput();
            oFileInput.Init("fileImport", "/SQM_BJ_IMP_EXP/PostExcelData");
        });
        // toast
        toastr.options = {
            closeButton: false,
            debug: false,
            progressBar: true,
            positionClass: "toast-top-center",
            onclick: null,
            showDuration: "300",
            hideDuration: "1000",
            timeOut: "3000",
            extendedTimeOut: "1000",
            showEasing: "swing",
            hideEasing: "linear",
            showMethod: "fadeIn",
            hideMethod: "fadeOut"
        };
        // Excel上传
        $("#ImportExcel").click(function () {
            // 1.清除
            $("#div_fileImport").empty();
            // 2.新增
            $("#div_fileImport").append("<input id='fileImport' name='fileImport' type='file' class='file-loading'>");
            new FileInput().Init("fileImport", "/SQM_BJ_IMP_EXP/PostExcelData");
            $("#importExc").modal("show");
        });
        // fileinput
        var FileInput = function () {
            var oFile = new Object();
            oFile.Init = function (ctrlName, uploadUrl) {
                var control = $("#" + ctrlName);
                // 初始化上传控件的样式
                control.fileinput({
                    language: "zh",
                    uploadUrl: uploadUrl,
                    allowedFileExtensions: ["xls", "xlsx"],
                    showUpload: true,
                    showCaption: true,
                    browseClass: "btn btn-primary",
                    maxFileCount: 1,
                    enctype: "multipart/form-data",
                    validateInitialCount: true,
                    autoReplace: true, // 是否自动替换当前文件
                    dropZoneEnabled: false, //是否显示拖拽区域
                    maxFileSize: 0, // 单位为kb，如果为0表示不限制文件大小
                    previewFileIcon: "<img src='/Content/QO/scripts/bootstrap-fileinput-master/img/excel.png' />",
                    msgFilesTooMany: "选择上传的文件数量({n}) 超过允许的最大数值{m}!",
                    layoutTemplates: {
                        actionDelete: "", // 去除上传预览的缩略图中的删除图标
                        actionUpload: "", // 去除上传预览缩略图中的上传图
                        actionZoom: "" // 去除上传预览缩略图中的查看详情预览的缩略图标
                    }
                });

                // 导入文件上传上传完成之后的事件
                $("#fileImport").on("fileuploaded", function (event, data, previewId, index) {
                    toastr.clear();
                    toastr.remove();
                    switch (data.response.Code) {
                        case "0": // 成功
                            alert("导入成功", data.response.Message);
                            $('#importExc').modal('hide');
                            break;
                        case "1": // 失败
                            $('#importExc').modal('hide');
                            MessageAlert("导入失败", data.response.Message);
                            break;
                        case "2": // 异常
                            $('#importExc').modal('hide');
                            MessageAlert("导入异常", data.response.Message);
                            break;
                        case "ifexist":// 是否覆盖
                            $('#importExc').modal('hide');
                            alist = data.response.Data;
                            popDialog("消息提示", data.response.Message, overdata, nooverdata);
                    }
                });
                // 导入失败后的事件
                $("#fileImport").on("fileerror", function (event, data, msg) {
                    toastr.error(data.response.Message);
                });
                // 覆盖导入
                function overdata() {
                    $("#progressbar").modal("show");
                    $.ajax({
                        url: "/SQM_BJ_IMP_EXP/PostExcelData",
                        type: "Post",
                        data: {
                            "alist": JSON.stringify(alist)
                        },
                        dataType: "JSON",
                        success: function (data) {
                            $("#progressbar").modal("hide");
                            alert("消息提示","导入成功");
                        }
                    })
                }
                // 不覆盖
                function nooverdata() {
                    $("#selfDialog").modal("hide");
                }
                // 消息提示
                function MessageAlert(type, data) {
                    $("#modalAlert").modal({
                        show: true,
                        backdrop: "static",
                        keyboard: false
                    });
                    $("#messageAlert").html(type);
                    $("#message").html(data);
                }
            }
            return oFile;
        }

        function hidemodal() {
            $("#exportExc").modal("hide");
        }
        // modal 对话框
        function popDialog(title, msg, callbackyes, callbackno) {
            if (!title) {
                title = '对话框';
            }
            var dialogHTML = '<div id="selfDialog" class="modal fade">';
            dialogHTML += '<div class="modal-dialog">';
            dialogHTML += '<div class="modal-content">';
            dialogHTML += '<div class="modal-header">';
            dialogHTML += '<button type="button" class="close" data-dismiss="modal" aria-label="Close">';
            dialogHTML += '<span aria-hidden="true">&times;</span>';
            dialogHTML += '</button>';
            dialogHTML += '<h4 class="modal-title">' + title + '</h4>';
            dialogHTML += '</div>';
            dialogHTML += '<div class="modal-body">';
            dialogHTML += msg;
            dialogHTML += '</div>';
            dialogHTML += '<div class="modal-footer">';
            dialogHTML += '<button type="button" class="btn btn-default" data-dismiss="modal" id="buttonno">取消</button>';
            dialogHTML += '<button type="button" class="btn btn-primary" data-dismiss="modal" id="buttonyes">继续</button>';
            dialogHTML += '</div>';
            dialogHTML += '</div>';
            dialogHTML += '</div>';
            dialogHTML += '</div>';

            $("#selfDialog").remove();
            $("body").append(dialogHTML);
            $("#selfDialog").modal("show");
            // 绑定"取消"方法
            $("#buttonyes").click(function () {
                if (typeof callbackyes == "function") {
                    callbackyes();
                }
            });
            // 绑定"继续"方法
            $("#buttonno").click(function () {
                if (typeof callbackno == "function") {
                    callbackno();
                }
            });
        }
    </script>
}

