                //先销毁之前的dom结构，重写生成d/
                $('div[prdcode=' + prdcode + ']').next().find("*").remove();
                $('div[prdcode=' + prdcode + ']').next().append(msg);
                var res = [];
                //给每个费目加psf rid 和 状态属性
                $(".feebtn").each(function () {
                    $.ajax({
                        url: "@Url.Action("GetRid")",
                        data: {
                            prdcode: $(this).attr("prdcode"),
                            srvcode: $(this).attr("srvcode"),
                            feecode: $(this).attr("feecode"),
                            orgrid: $("#orgrid").val(),
                            alonefee: $(this).attr("alonefee"),
                            vrid: $("#vrid").val()
                        },
                        dataType: "json",
                        async: false,
                        success: function (data) {
                            res = data;
                        }
                    })
                    $(this).attr("djrid", res[0]);
                    $(this).attr("bjrid", res[1]);
                    $(this).attr("status", res[2]);
                });
                $(".feebtn").click(function () {
                    var RID = JSON.stringify([$(this).attr('djrid'), $(this).attr('bjrid')]);
                    var btnFeeCode = $(this).attr('feecode');
                    SaveFormData();
                    if ($("#ifcreateuser").val() == "0") {
                        location.href = "/SQM_FMBJ/FMBJ?RID=" + RID + "&alonefee=" + $(this).attr("alonefee") + "&ifmb=1&sign=mb&mbrid=" + $("#mbrid").val() + "&disabled=1";
                    } else {
                        location.href = "/SQM_FMBJ/FMBJ?RID=" + RID + "&alonefee=" + $(this).attr("alonefee") + "&ifmb=1&sign=mb&mbrid=" + $("#mbrid").val();
                    }
                });
            }
            //无绑定关系费目
            if (feeArr.length > 0) {
                $("#DlFee").show();
                $('span[name=zl]').after($("#DlFee"));
            }
        }
        //选择无绑定关系费目后点击保存
        $(".dlbtnsavefee").click(function(){
            var proserid = $(this).closest("#DlFee").prev().attr("id");
            DlSaveFee(proserid.split("_")[1],proserid.split("_")[2]);
        });
        // 保存未绑定关系费目
        function DlSaveFee(prdcode,srvcode){
            toastr.info("数据保存中，请稍候...");
            //初始化存值数组
            selectedArray = [];
            //费目层
            $('input:checkbox[name=DLFEE]:checked').each(function () {
                var prdobj = {"prdcode": $(this).attr("prdcode"), "srvcodes": [] ,"ifcheck": $(this).is(":checked")};
                var prdcount = 0;
                selectedArray.forEach(v => {
                    if (v.prdcode == prdobj.prdcode) {
                        prdcount++;
                        }
                    });
                if (prdcount == 0) {
                    selectedArray.push(prdobj);
                }
                var srvobj = { "srvcode": $(this).attr("srvcode"), "feecodes": [] };
                var srvcount = 0;
                selectedArray.forEach(p => {
                    if (p.prdcode == $(this).attr("prdcode")) {
                        p.srvcodes.forEach(s => {
                            if (s.srvcode == srvobj.srvcode) {
                                srvcount++;
                                }
                            });
                        if (srvcount == 0) {
                            if ($("input:checkbox[name=PRD][prdcode=" + $(this).attr("prdcode") + "]").is(":checked")){
                                p.srvcodes.push(srvobj);
                            }
                        }
                    }
                })
                selectedArray.forEach(p => {
                    if (p.prdcode == $(this).attr('prdcode')) {
                        p.srvcodes.forEach(s => {
                            if (s.srvcode == $(this).attr('srvcode')) {
                                if (s.feecodes.indexOf($(this).attr('feecode')) == -1) {
                                    var pc = $(this).attr("prdcode");
                                    var sc = $(this).attr("srvcode");
                                    if ($("input[name=SRV][prdcode=" + pc + "][srvcode=" + sc + "]").is(":checked")) {
                                        s.feecodes.push($(this).attr("feecode"));
                                    }
                                }
                            }
                        })
                    }
                })
            });
            //psf表中插入数据
            $.ajax({
                url: "@Url.Action("SaveToMBPSF")",
                type:"Post",
                data: {
                    postdata: JSON.stringify(selectedArray),
                    keyvalue: $("#mbrid").val(),
                    prdcode:prdcode,
                    srvcode:srvcode,
                    aloenfee:"1",
                },
                async: false,
                dataType: "json",
                success: function (data) {
                    toastr.clear();
                    toastr.remove();
                    vrid = data;
                    $("#vrid").val(data);
                    toastr.success("数据保存成功");
                }
            });
            showPSF(vrid);
            $("#btnOk").trigger("click");
        }
