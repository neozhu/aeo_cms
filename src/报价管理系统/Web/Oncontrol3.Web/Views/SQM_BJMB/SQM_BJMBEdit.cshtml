                var count = 0;
                $("input:checkbox[name=FEE][prdcode=" + prdcode + "][srvcode=" + srvcode + "]").each(function () {
                    if ($(this).is(":checked")) {
                        count++;
                    }
                });
                if (count > 0) {// 服务checkboxx勾选状态
                    if (!$("input[name=SRV][prdcode=" + prdcode + "][srvcode=" + srvcode + "]").attr("checked")) {// 如果已经勾选，不执行
                        $("input[name=SRV][prdcode=" + prdcode + "][srvcode=" + srvcode + "]").prop("checked", true).change("1");
                    }
                } else {
                    $("input[name=SRV][prdcode=" + prdcode + "][srvcode=" + srvcode + "]").removeAttr("checked");
                }
            })
        }
        //展示已有的产品、服务、费目
        function showPSF(vrid) {
            var selectData;
            var feeArr = [];
            $.ajax({
                url: "@Url.Action("showPSF")",
                data: {
                    vrid: vrid
                },
                dataType: "json",
                async: false,
                success: function (data) {
                    selectData = data[1];
                    PSFdata = data[1];
                }
            });
            // 将所有checkbox置为非选中状态
            $("input:checkbox").removeAttr("checked");
            // 勾选产品/服务/费目 + 打包数据(将键值对改造成对象形式)
            // 初始化存值数组
            selectedArray = [];
            for (var product in selectData) {// 遍历产品
                // 插入 产品:服务 数据
                var prdobj = { "prdcode": product, "srvcodes": [] };
                selectedArray.push(prdobj);
