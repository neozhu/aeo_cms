        // 保存表单数据
        function SaveFormData() {
            var storage = window.localStorage;
            storage.setItem("rid", $("#RID").val());
            storage.setItem("templatename",$("#TEMPLATENAME").val());
            storage.setItem("templatetype",$("#TEMPLATETYPE").val());
            storage.setItem("status",$("#STATUS").val());
            storage.setItem("sord",$("#SORD").val());
            storage.setItem("remark", $("#REMARK").val());
            storage.setItem("mbrid", $("#mbrid").val());
        }
        //截取费目名称
        String.prototype.trim = function () {
            if (this.length > 8) {
                return this.substring(0, 7) + "...";
            } else {
                return this;
            }
        }
        //获取当前服务下的指令
        function getZLJ(srvcode,pcode) {
            var fee = "&feecodes=";
            for (var s = 0; s < PSFdata[pcode].length; s++) {//服务
                var sfObj = PSFdata[pcode][s];
                for (var service in sfObj) {// 费目
                    if (srvcode == service) {
                        for (var i = 0; i < sfObj[service].length; i++) {
                            fee += sfObj[service][i] + ",";
                        }
                        break;
                    }
                }
            }
            fee = fee.substr(0, fee.length - 1);
            $.ajax({
                url: "@Url.Action("ZLJ")",
                type: "get",
                data: "srvcode=" + srvcode + fee + "&vrid=" + $("#vrid").val(),
                success: function (data) {
                    data = $.parseJSON(data);
                    var ul = $("#zl_div_" + pcode + "_" + srvcode + " ul");
                    $(ul).html("");
                    if (!!data && data.length > 0) {
                        for (var i = 0; i < data.length; i++) {
                            $(ul).append("<li>" + (i+1) + ". " + data[i]["INSNAME"] + "</li>");
                        }
                    } else {
                        $(ul).append("<li>未获取到相关指令！</li>")
                    }
                }, error: function (data) {
                    toastr.error("未获取到相关指令！");
                }
            })
        }
        // 模板预览
        function Preview() {
            $("#previewID").attr("disabled", true);
            toastr.info("预览数据生成中...");
            $.ajax({
                url: "/SQM_BJ_IMP_EXP/PreviewMB",
                type: "Post",
                data: {
                    "ver_id": $("#vrid").val()
                },
                dataType: "json",
                success: function (data) {
                    if (data.Success) {
                        toastr.clear();
                        toastr.remove();
                        if (data.Code == "1") {
                            var url = data.Message + "";
                            if (url != "") {
                                var iTop = (window.screen.height - 600) / 2;// 获得窗口的垂直位置;
                                var iLeft = (window.screen.width - 640) / 2;// 获得窗口的水平位置;
                                var style = "width=640,height=500,scrollbars=yes,top=" + iTop + ",left=" + iLeft;
                                $("#previewID").removeAttr("disabled");
                                window.open(url, "_blank", style);
                            }
                            else {
                                alert("消息提示", "数据未保存");
                            }
                        } else {
                            alert("警告", data.Message);
                        }
                    }
                }
            });
        }
        // 生成模板文件
        function ExportBJMB() {
            $("#bjmbID").attr("disabled", true);
            toastr.info("数据生成中，请稍候...");
            $.ajax({
                url: "/SQM_BJ_IMP_EXP/ExportBJMB",
                type: "Post",
                data: {
                    "ver_id": $("#vrid").val()
                },
                dataType: "json",
                success: function (data) {
                    if (data.Success) {
                        toastr.clear();
                        toastr.remove();
                        $("#bjmbID").removeAttr("disabled");
                        // 1.清除
                        $("#div_fileExport").empty();
                        // 2.新增
                        $("#div_fileExport").append("<a id='fileExport' onclick='hidemodal();' name='fileExport' href='" + data.Message + "'>点击此处下载</a>");
                        $("#exportExcelFile").modal("show");
                    } else {
                        toastr.error(data.Message);
                    }
                }
            });
        }
