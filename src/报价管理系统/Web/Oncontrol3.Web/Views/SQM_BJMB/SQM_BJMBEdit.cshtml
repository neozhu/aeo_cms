                                <i class="fa fa-caret-down"></i>
                            </button> 
                            @*<button type="button" id="btnOk2" class="btn btn-default btn-block" style="padding:10px 16px"  onclick="javascript:alert('消息提示', '请选择组织');">
                                <span style="font-size:12px;">产品/服务/费目</span>
                                <i class="fa fa-caret-down"></i>
                            </button>*@
