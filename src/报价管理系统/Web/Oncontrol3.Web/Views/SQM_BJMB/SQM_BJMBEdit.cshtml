        //保存费目
        function btnSaveFee() {
            var selcount = 0;
            var vrid;// 保存成功返回版本id
            $("[name='FEE']").each(function () {
                if ($(this).is(":checked")) {
                    selcount++;
                }
            })
            if (selcount == 0) {
                toastr.error("请先选择费目！");
                return;
            }
            // 初始化存值数组
            selectedArray = [];
            // 产品层
            $("input:checkbox[name=FEE]:checked").each(function () {
                var prdobj = { "prdcode": $(this).attr("prdcode"), "srvcodes": [] };
                var prdcount = 0;
                selectedArray.forEach(v => {
                    if (v.prdcode == prdobj.prdcode) {
                        prdcount++;
                    }
                })
                if (prdcount == 0) {
                    selectedArray.push(prdobj);
                }
            });
            // 服务层
            $("input:checkbox[name=FEE]:checked").each(function () {
                var srvobj = { "srvcode": $(this).attr("srvcode"), "feecodes": [] };
                var srvcount = 0;
                selectedArray.forEach(p => {
                    if (p.prdcode == $(this).attr("prdcode")) {
                        p.srvcodes.forEach(s => {
                            if (s.srvcode == srvobj.srvcode) {
                                srvcount++;
                            }
                        })
                        if (srvcount == 0) {
                            p.srvcodes.push(srvobj);
                        }
                    }
                })
            });
            //费目层
            $('input:checkbox[name=FEE]:checked').each(function () {
                selectedArray.forEach(p => {
                    if (p.prdcode == $(this).attr('prdcode')) {
                        p.srvcodes.forEach(s => {
                            if (s.srvcode == $(this).attr('srvcode')) {
                                if (s.feecodes.indexOf($(this).attr('feecode')) == -1) {
                                    s.feecodes.push($(this).attr('feecode'));
                                }
                            }
                        })
                    }
                })
            });
            // psf表中插入数据
            $.ajax({
                url: "@Url.Action("SaveToMBPSF")",
                type:"Post",
                data: {
                    postdata: JSON.stringify(selectedArray),
                    orgcode: $("#ORGNAME").val().split("-")[1],
                    orgname: $("#ORGNAME").val(),
                    keyvalue: $("#mbrid").val(),
                },
                async: false,
                dataType: "json",
                success: function (data) {
                    if (data) {
                        toastr.clear();
                        toastr.remove();
                        vrid = data;
                        $("#vrid").val(data);
                        toastr.success("数据保存成功");
                    }
                }
            });
            showPSF(vrid);
            $("#btnOk").trigger("click");
        }
        // 保存
        function dosave() {
            if (!$("#mbformmain").valid()) {
                return;
            }
            toastr.info("数据保存中，请稍候...");
            var postdata = {};
            var flag;
            //报价模板基本信息
            postdata["RID"] = $("#RID").val();//RID
            postdata["TEMPLATENAME"] = $("#TEMPLATENAME").val();//模板名称
            postdata["TEMPLATETYPE"] = $("#TEMPLATETYPE").val();//模板类型
            postdata["STATUS"] = $("#STATUS").val();//状态
            postdata["SORD"] = $("#SORD").val();//排序
            postdata["REMARK"] = $("#REMARK").val();// 模板说明
            postdata["ORGRID"] = $("#ORGNAME").val();// 组织名称+code
            try {
                $("#btnSave").attr("disabled", "disabled");

                $.ajax({
                    url: "/SQM_BJMB/SubmitForm",
                    type: "post",
                    data: {
                        'postdata': JSON.stringify(postdata),
                        'RID': $("#RID").val()
                    },
                    dataType: "json",
                    success: function (data) {
                        toastr.clear();
                        toastr.remove();
                        if (data.Success) {
                            toastr.success(data.Message);
                            setTimeout(function () { location.href = "/SQM_BJMB/SQM_BJMBEdit?RID=" + data.Data }, 200);
                        } else {
                            toastr.error(data.Message);
                        }
                    },
                    error: function (data) {
                        if (!!data.responseText) {
                            alert(data.responseText);
                        } else {
                            window.alert("请求失败！");
                        }
                    }
                });
            } catch (e) {
                window.alert("保存失败，请重试");
            }
            finally {
                $("#btnSave").removeAttr("disabled");
            }
        }
