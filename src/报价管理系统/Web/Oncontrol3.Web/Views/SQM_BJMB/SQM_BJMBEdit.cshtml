                $("[name='PRD'][prdcode='" + product + "']").each(function () {
                    //$(this).iCheck("check");
                    $(this).prop("checked", true);
                });
                for (var s = 0; s < selectData[product].length; s++) {
                    var sfObj = selectData[product][s];
                    for (var service in sfObj) {// 遍历服务
                        // 插入 服务:费目 数据
                        var srvobj = { "srvcode": service, "feecodes": sfObj[service] };
                        selectedArray.forEach(item => {
                            if (item.prdcode == product) {
                                item.srvcodes.push(srvobj);
                            }
                        });
                        // 勾选服务
                        $("[name='SRV'][prdcode='" + product + "'][srvcode='" + service + "']").each(function () {
                            //$(this).iCheck("check");
                            $(this).prop("checked", true);
                        });
                        feeArr = sfObj[service];
                        for (var f = 0; f < feeArr.length; f++) {
                            // 勾选费目
                            $("[name='FEE'][prdcode='" + product + "'][srvcode='" + service + "'][feecode='" + feeArr[f] + "']").each(function () {
                                //$(this).iCheck("check");
                                $(this).prop("checked", true);
                            });
                        }
                    }
                }
            }
            // 数据的回显 先渲染产品
            var prdtittlemsg = "";// 不赋值为空，会加一个undefined在最开始（页面展示）
            // 清空产品
            $("#prdtittle").find("*").remove();
            // 产品渲染,PRDArray 为数组包含数组，索引0为code，索引为1为name
            for (var i = 0; i < selectedArray.length; i++) {
                var prdcode = selectedArray[i].prdcode;
                prdtittlemsg += '<div class="row" style="margin-top:10px;"><div class="col-md-12"><div class="card-box" style="height:100%;padding-bottom:20px;padding-top:20px;border:none;" ><div class="bigtittle" prdcode=' + prdcode + '><span>' + product_dic[prdcode] + '<i class="fa fa-angle-double-down prdhead"></i></span></div><div margin-left:5px;"></div></div></div></div>';
            }
            $("#prdtittle").append(prdtittlemsg);
            $(".bigtittle").each(function () {
                $(this).click(function () {
                    $(this).next().toggle();
                });
            });
            // 渲染产品下服务指令集和对应的费目
            for (var i = 0; i < selectedArray.length; i++) {
                var msg = '';
                var prdcode = selectedArray[i].prdcode;
                for (var j = 0; j < selectedArray[i].srvcodes.length; j++) {
                    // 服务渲染
                    // 通过服务code得到服务名称
                    var srvName = '';
                    var srvcode = selectedArray[i].srvcodes[j].srvcode;
                    srvArray.forEach(srv => {
                        if (srv.SRVCODE == selectedArray[i].srvcodes[j].srvcode) {
                            srvName = srv.SRVNAME;
                        }
                    })
                    //msg += '<ul class="col-md-12 service" style="background-color: #ffffff;"><li class="cpfnlb" > <a href="" style="color:black;"><img width="30" height="30" style="margin-right: 20px;" src="/Images/icon-1.png">服务：' + srvName + '<i class="fa fa-caret-right" style="margin-left: 20px;"></i></a></li></ul>';
                    msg += '<ul class="col-md-12 service" style="background-color: #ffffff;"><li class="cpfnlb" > <a href="" style="color:black;"><img width="30" height="30" style="margin-right: 20px;" src="/Images/icon-1.png">服务：' + srvName + '</a><span style="padding-top:10px;width: 20%;position:absolute;" ><span name="zl" class="zl" id="s_' + prdcode + '_' + srvcode + '" title="指令集" ><i class="fa fa-caret-right" style="margin-left: 20px;"></i></span>';
                    msg += '<div id="zl_div_' + prdcode + '_' + srvcode + '" class="zldiv zlbox" >服务指令<ul></ul></div></span></li></ul>';
                    showDlFee("s_" + prdcode + "_" + srvcode);
                    for (var k = 0; k < selectedArray[i].srvcodes[j].feecodes.length; k++) {
                        var feeName = '';
                        var feecode = selectedArray[i].srvcodes[j].feecodes[k];
                        var alonefee = '0';
                        // 费目渲染
                        // 通过费目code得到费目name
                        feeArray.forEach(fee => {
                            if (fee.FEECODE == selectedArray[i].srvcodes[j].feecodes[k]) {
                                feeName = fee.FEENAME;
                            }
                        });
                        if (feeName == "") {// 未绑定关系费目
                            feeName = feekeyvalue[feecode];
                            alonefee = '1';
                        }
                        if (feeName) {
                            msg += ' <div class="btn-group btn-group-lg col-md-2" style="margin-top:10px;margin-bottom:10px;" ><button type="submit" prdcode="' + prdcode + '" srvcode="' + srvcode + '" feecode="' + feecode + '" alonefee="' + alonefee + '" class="btn btn-default feebtn btn-block"><span class="widget-icon "><i class="fa fa-circle feeEdit cshbj"></i>&nbsp;' + feeName.trim() + '</span></button></div>';
                        }
                    }
                    msg += '</div>';
