@{
    ViewBag.Title = "编辑报价模板";
    Layout = "~/Views/Shared/_LayoutTM.cshtml";
}
<style>
    .cpfnlb {
        list-style: none;
    }

    .font {
        font-size: 20px;
        color: black;
        padding-top: 10px;
    }

    .DTFC_LeftWrapper {
        top: -6px !important;
    }

    .DTFC_RightWrapper {
        top: -7px !important;
    }

    div.DTFC_LeftFootWrapper table, div.DTFC_LeftHeadWrapper table, div.DTFC_RightFootWrapper table, div.DTFC_RightHeadWrapper table, table.DTFC_Cloned tr.even {
        /*background-color:transparent;*/
    }

    .bjok {
        color: green;
    }

    .bjover {
        color: #f0ad4e;
    }

    .cshbj {
        color: white;
    }

    .bjwdj {
        color: red;
    }

    .ckleft {
        margin-left: 10px;
    }

    .card-box {
        width: 100%;
        height: 100px;
        float: left;
        border: 1px solid #ccc;
        background-color: #fff;
        border-radius: 1px;
        /*margin-top: -35px;*/
        overflow: visible;
        position: relative;
    }

    .card-box-content {
        padding: 6px 10px;
        font-size: 14px;
        color: #4d5d70;
    }

        .card-box-content div {
            overflow: hidden;
            white-space: nowrap;
            text-overflow: ellipsis;
            margin-top: 6px;
        }

            .card-box-content div .address {
                font-size: 12px;
                color: #999999;
            }

            .card-box-content div span {
                float: left;
            }

            .card-box-content div .amount {
                text-align: right;
                width: 50px;
                color: #d0031c;
            }

            .card-box-content div .dis {
                margin-left: 30px;
            }

        .card-box-content .inf {
            font-weight: bold;
        }

        .card-box-content div .tel-num {
            width: 80px;
        }

        .card-box-content div .pickup_btn {
            float: right;
            margin-left: 56px;
            font-size: 9px;
            line-height: 18px;
            width: 70px;
            heigth: 18px;
            background-color: #319adf;
            color: white;
            text-align: center;
            border-radius: 8px;
        }

    .btns {
        margin-top: 8px;
        margin-bottom: 8px;
    }

    .title {
        color: red;
        font: 12px;
    }

    .spanbackground {
        background-color: yellow;
    }

    .bigtittle {
        /*background:#ccc;*/
        font-size: 20px;
        align-content: center;
        text-align: center;
        font-weight: bold;
        border-top: 1px solid #ccc;
        border-bottom: 1px solid #ccc;
        padding-bottom: 20px;
        padding-top: 20px;
    }
    /*.bigtittle {
        font-size: 20px;
        align-content: center;
        text-align: center;
        font-weight: bold;
        border-top: 1px solid #ccc;
        border-bottom: 1px solid #ccc;
        padding-bottom: 20px;
        padding-top: 20px;
    }*/

    .head {
        color: #999;
        margin-top: 7px;
        margin-bottom: 7px;
    }

    .dis {
        margin-right: 50px;
    }

    .fstbox {
        height: 100%;
        padding-bottom: 20px;
        padding-top: 20px;
        margin-top: -35px;
    }

    .FEE {
        margin-bottom: 15px;
        display: none;
        cursor: pointer;
    }

    .SRV {
        display: none;
    }

    .prdhead {
        float: right;
        color: black;
        font-size: 30px;
    }

    .groupbtn {
        margin-left: 15px;
        width: 100%;
    }

    .navbar-nav {
        background-color: #ffffff;
    }

    .nav_title {
        width: 100%;
        line-height: 60px;
        text-align: center;
        font-size: 20px;
        color: #000;
    }

    .srvbj {
        background-color: #ffb100;
    }

    .checkme {
        background-color: yellow;
    }

    .panel-body {
        max-height: 500px;
        overflow-y: scroll;
    }

    .cpfnlb {
        margin-top: 6px;
    }

    #zldiv {
        padding-left: 10px;
    }

    .zldiv {
        display: none;
    }

    .zlbox {
        position: absolute;
        margin-left: 50px;
        width: 250px;
        z-index: 1;
        padding: 3px;
        border: black solid 1px;
        background-color: white;
        max-height: 300px;
        overflow-y: scroll;
    }

        .zlbox ul li {
            list-style-type: none;
            margin-left: 20px;
        }

    .zl {
        cursor: pointer;
        float: left;
    }

    #DlFee {
        margin-left: 40px;
        width: 50%;
        font-size: 12px;
        margin-top: -10px;
    }

        #DlFee .DLFEE {
            display: block;
            cursor: pointer;
        }
</style>
<div class="row head">
    <div style="float:left">
        <div style="margin-top: -25px;">
            <span>&nbsp;&nbsp;&nbsp; 欢迎您：<span id="user">@Oncontrol3.Web.Helpers.SQMHelper.getStaffKey()</span></span>
        </div>
    </div>
    <div style="float:right; margin-right: 40px; margin-top: -25px;">
        <span class="dis">询价</span>
        <span class="dis" id="tobjmb">报价模板</span>
        <span class="dis active" id="tobjsy">报价首页</span>
    </div>
    <div style="display:none;">
        <input id="vrid" value="" />
        <input id="mbrid" value="" />
        <input id="ifcreateuser" value="" />
        <input id="orgcode" />
        <input id="orgname" />
        <input id="orgrid" />
    </div>
</div>
