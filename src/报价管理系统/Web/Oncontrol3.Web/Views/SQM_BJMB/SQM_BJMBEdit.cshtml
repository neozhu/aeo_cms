                                                    <option value="@ViewBag.ORG.Rows[i]["RID"]">@ViewBag.ORG.Rows[i]["ORGNAME"]-@ViewBag.ORG.Rows[i]["RID"]</option>
                                                }
                                            </select>*@
                                            <label class="input">
                                                <input type="text" class="form-control" id="ORGNAME" disabled="disabled">
                                            </label>
                                        </section>
                                    </div>
                                    <section>
                                        <label class="label">模板说明</label>
                                        <label class="textarea">
                                            <i class="icon-append fa fa-comment"></i>
                                            <textarea rows="4" name="pmemo" id="REMARK"></textarea>
                                        </label>
                                    </section>
                                </fieldset>
                            </form>
                        </div>
                    </div>
                </div>
                <div class="card-box fstbox" id="cardbox">
                    <div class="btn-group groupbtn">
                        <div class="col-xs-4 col-sm-2">
                            <button type="button" id="btnOk" class="btn btn-default dropdown-toggle btn-block" style="padding:10px 16px" data-toggle="dropdown">
