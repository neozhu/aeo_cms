@model Oncontrol3.Web.Models.LocalPasswordModel
<div class="easyui-panel" id="panelCenter" title="维护您的个人信息" style="width:100%;max-width:400px;padding:10px;">
    @using (Html.BeginForm("Manage", "Account", FormMethod.Post, new { id = "ff" }))
    {
        @Html.AntiForgeryToken()
        <div style="margin-bottom:20px">
            <input class="easyui-textbox" type="password" name="OldPassword" id="OldPassword" style="width:100%" data-options="label:'原密码:',required:true">
        </div>
        <div style="margin-bottom:20px">
            <input class="easyui-textbox" type="password" name="NewPassword" id="NewPassword" style="width:100%" data-options="label:'新密码:',required:false,validtype:length[4,32]">
        </div>
        <div style="margin-bottom:20px">
            <input class="easyui-textbox" type="password" name="ConfirmPassword" id="ConfirmPassword" style="width:100%" data-options="label:'新密码:'">
        </div>
        <div style="margin-bottom:20px">
            @Html.TextAreaFor(m => m.Email, new { style = "width:100%", @class = "easyui-textbox", data_options = "label:'邮箱:',required:true,validType:'email'" })
        </div>


    }
    <div style="text-align:center;padding:5px 0">
        @Html.ValidationSummary()
        <div style="color:red">@ViewBag.StatusMessage</div>
        <a href="javascript:void(0)" class="easyui-linkbutton" onclick="submitForm()" style="width:80px">保存</a>
    </div>
</div>


