                                        <div class="col-sm-2">
                                            <input type="checkbox" id="ZKJBJ" name="ZKJBJ">
                                        </div>
                                        <label class="col-md-1 control-label">资料齐全标记</label>
                                        <div class="col-sm-2">
                                            <input type="checkbox" id="ZZLQQBJ" name="ZZLQQBJ">
                                        </div>
                                        <div class="clear10"></div>
                                   
                                </div>
                                </div>
                                <div class="sc_more">
                                    <a class="control-label" href="javascript:void(0);" id="sc_more">更多查询条件</a>
                                    <div style="width: 200px; float: right;">  
                                        <button class="btn" id="submit_Fixed" style="float: left">锁定列</button>
                                        <input class="form-control" id="fixedleftnum" name="fixedleftnum" style="width: 20px; float: left; padding: 0px;" value="2">
                                        <button class="btn" id="submit_refresh" style="float: left">刷新</button>
                                        <button class="btn btn-primary" id="submit_search" style="float: right">查询</button>
