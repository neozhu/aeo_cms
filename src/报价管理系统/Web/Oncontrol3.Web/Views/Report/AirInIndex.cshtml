                        </div>
                        <!-- widget content -->
                        <div class="widget-body no-padding">
                            <table id="datatable_col_reorder" class="table table-striped table-bordered table-hover"></table>
                        </div>
                        <!-- end widget content -->
                    </div>
                    <!-- end widget div -->
                </div>
                <!-- end widget -->
            </article>
            <!-- WIDGET END -->
        </div>
        <!-- end row -->

    </section>
    <!-- end widget grid -->
    <!-- Modal报关状态 -->
    <div class="modal fade" id="myModalFWA1" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
