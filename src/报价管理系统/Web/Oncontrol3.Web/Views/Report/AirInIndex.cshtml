@section pagespecific {
    <script src="~/Content/QO/scripts/framework.js"></script>
<script src="/js/lib/jquery.plug-ins.js" type="text/javascript"></script>
    <script src="/scripts/plugin/datatables/dataTables.colReorder.min.js" type="text/javascript"></script>
    <script src="/scripts/plugin/datatables/dataTables.colVis.min.js" type="text/javascript"></script>
    <script src="/scripts/plugin/datatables/dataTables.fixedColumns.min.js" type="text/javascript"></script>
    <script src="/scripts/plugin/datatables/dataTables.fixedHeader.js" type="text/javascript"></script>
<link href="~/Content/QO/scripts/icheck/skins/square/blue.css" rel="stylesheet">
<script src="~/Content/QO/layer/layer.js"></script>
<script src="~/Content/QO/scripts/icheck/icheck.min.js"></script>
    <script type="text/javascript">


    $(document).ready(function () {
        $("#JDRQS").val('@DateTime.Now.AddDays(-6).ToString("yyyy/MM/dd")');
        $("#JDRQE").val('@DateTime.Now.ToString("yyyy/MM/dd")');
        $("#fixedleftnum").val($.cookie("kjfixedcol") || 2);
        DrawTable();
        BindAutocompleteMDM();
        $('input').iCheck({
            checkboxClass: 'icheckbox_square-blue',
            radioClass: 'iradio_square-blue'
        });
        @*报关状态
        $('#datatable_col_reorder tbody').on('click', 'tr:eq() td:eq(1)', function () {
            location.href = "@Url.Action("ZbgztIndex", "AirInReport")";

            var index = layer.load(2, { time: 300 * 1000 });
            $.ajax({
                url: RootPath() + "/Report/AirinBgzt",
                type: "post",
                dataType: "json",
                async: false,
                success: function (data) {
                    layer.close(index);
                    console.log(data);
                    //alert(JSON.stringify(data));
                    layer.alert(DealData(data), {
                            skin: 'layui-layer-molv',
                            icon: 1
                            , closeBtn: 0
                        }, function () {
                            location.reload();
                        });

                },
                error: function (data) {
                    layer.close(index);
                    layer.msg("请求失败！");

                }
            })
        })*@
    });
    function SelectTd(table) {


    }
    function DealData(data) {
        return JSON.stringify(data);

    }

    function DrawTable() {
        //列定义
        var columns = [{
            "title": "序号", "orderable": true, "data": null, "width": "40"
        },
                       {
                           "title": "报关状态", "data": "ZBGZT", "width": "100",
                           "render": function (data, type, full, meta) {
                               if (full.ZBGZT == null) {
                                   return "";
                               } else {
                                   return '<a href="@Url.Action("ZbgztIndex", "AirInReport")" data-toggle="modal" data-target="#myModalFWA1">' + full.ZBGZT + '</a>';

                               }
                           }
                       },
                        {
                            "title": "报检状态", "data": "ZBJZT", "width": "100",
                            "render": function (data, type, full, meta) {
                                if (full.ZBJZT == null) {
                                    return "";
                                } else {
                                    return '<a href="@Url.Action("ZbjztIndex", "AirInReport")" data-toggle="modal"  data-target="#myModalFWA2">' + full.ZBJZT + '</a>';

                                }
                            }
                        },
                        {
                            "title": "物流状态", "data": "ZWLZT", "width": "100",
                            "render": function (data, type, full, meta) {
                                if (full.ZWLZT == null) {
                                    return "";
                                } else {
                                    return '<a href=""  class="zwlzthref" data-toggle="modal"  data-target="#myModalFWA3">' + full.ZWLZT + '</a>';

                                }
                            }
                        },
                        {
                            "title": "FWO号", "data": "TRQ_ID", "width": "100",
                            "render": function (data, type, full, meta) {
                                return fqLTrim(full.TRQ_ID);
                            }
                        },
                         { "title": "DBKEY", "data": "DB_KEY", "width": "140" },
                        { "title": "经营单位", "data": "ZJYDWMS", "width": "140" },
                        { "title": "客户自编号", "data": "ZKHZBH", "width": "100" },
                        { "title": "通关方式", "data": "ZTGFSMS", "width": "50" },
                        { "title": "总单号", "data": "ZZDH", "width": "50" },
                        { "title": "分单号", "data": "ZFDH", "width": "50" },
                        {
                            "title": "件数", "data": "QUA_PCS_VAL", "width": "50",
                            "render": function (data, type, full, meta) {

                                return full.QUA_PCS_VAL == null ? "" : parseInt(full.QUA_PCS_VAL);//保留整数
                            }
                        },
                        {
                            "title": "毛重", "data": "GRO_WEI_VAL", "width": "50",
                            "render": function (data, type, full, meta) {
                                return full.GRO_WEI_VAL == null ? "" : full.GRO_WEI_VAL.substring(0, full.GRO_WEI_VAL.indexOf(".") + 4);//保留三位小数点
                            }

                        },
                        { "title": "申报关区", "data": "ZSBGQ", "width": "50" },
                        {
                            "title": "送货日期", "data": "ZJHSHTHRQ", "width": "50",
                            "render": function (data, type, full, meta) {
                                if (full.ZJHSHTHRQ == null || full.ZJHSHTHRQ == undefined || full.ZJHSHTHRQ == "0")
                                    return "";
                                else {
                                    var gmtDate = new Date(formatDate(full.ZJHSHTHRQ));
                                    gmtDate.setHours(gmtDate.getHours() + 8);
                                    return gmtDate.Format("yyyy/MM/dd hh:mm:ss");
                                }
                            }
                        },
                        { "title": "接单人", "data": "ZJDR", "width": "50" },
                        { "title": "订购方", "data": "ZDGFMS", "width": "150" },
                        { "title": "销售组织", "data": "SALES_ORG_ID", "width": "150" },
                        { "title": "进出口口岸", "data": "ZJCKKA", "width": "150" },
                        { "title": "申报方式", "data": "ZSBFSMS", "width": "50" },
                        {
                            "title": "申报日期", "data": "ZSBRQ", "width": "90",
                            "render": function (data, type, full, meta) {
                                if (full.ZSBRQ == null || full.ZSBRQ == undefined)
                                    return "";
                                else {
                                    var gmtDate = new Date(formatDate(full.ZSBRQ));
                                    gmtDate.setHours(gmtDate.getHours() + 8);
                                    return gmtDate.Format("yyyy/MM/dd hh:mm:ss");
                                }
                            }
                        },
                        { "title": "收货方", "data": "ZSHFMS", "width": "140" },
                         {
                             "title": "接单日期", "orderable": false, "data": "CREATED_ON", "width": "100",
                             "render": function (data, type, full, meta) {
                                 if (full.CREATED_ON == null || full.CREATED_ON == undefined)
                                     return "";
                                 else {
                                     var gmtDate = new Date(formatDate(full.CREATED_ON));
                                     gmtDate.setHours(gmtDate.getHours() + 8);
                                     return gmtDate.Format("yyyy/MM/dd hh:mm:ss");
                                 }
                             }
                         },
