        //获取crm合同有效期
        function getQZRQ() {
            var list = [];
            $.ajax({
                url: "@Url.Action("GetContrsctDate")",
                data: {
                    businessid: pidArray.toString(),
                    customerno: $("#customName").val()
                },
                dataType: "json",
                async: false,
                success: function (data) {
                    list = data;
                }
            });
            if (list != undefined && list.length != 0) {
                var CONTRACTSTARTDATE = list[0].CONTRACTSTARTDATE;
                if (CONTRACTSTARTDATE != null && $("#DTFROM").val() == "") {
                    crmdtfrom = CONTRACTSTARTDATE.subDate();
                    $("#DTFROM").val(crmdtfrom);
                }
                var CONTRACTENDDATE = list[0].CONTRACTENDDATE;
                if (CONTRACTENDDATE != null && $("#DTTO").val() == "") {
                    crmdtto = CONTRACTENDDATE.subDate();
                    $("#DTTO").val(crmdtto);
                }
                var CONTRSCTNUM = list[0].CONTRACTCODE;
                if (CONTRSCTNUM != null) {
                    $("#CONTRSCTNUM").val(list[0].CONTRACTCODE);
                }
            } else {
                $("#DTFROM").val("");
                $("#DTTO").val("");
            }
        }
