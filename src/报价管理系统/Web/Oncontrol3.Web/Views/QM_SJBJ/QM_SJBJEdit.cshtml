@{
    ViewBag.Title = "商机报价编辑";
    Layout = "~/Views/Shared/_LayoutTM.cshtml";
}
@model Com.Feiliks.QDM.SQM_BJ_VER
<style type="text/css">
    tr .selected {
        background-color: lightgray;
    }

    .DTFC_LeftWrapper {
        top: -6px !important;
    }

    .DTFC_RightWrapper {
        top: -7px !important;
    }

    .tjrqqj .valid {
        background: #f0fff0;
        border-color: #7dc27d;
    }

    .rqqj {
        width: 38px;
        padding: 5px;
        cursor: pointer;
        text-align: center;
    }

    .select2-container-multi {
        width: 200% !important;
    }

    /*f防止商机名称过长换行时，导致第二行错位*/
    .col-2 {
        clear: left !important;
    }
</style>

<div id="content">
    <section id="widget-grid" class="">
        <div class="row">
            <article class="col-sm-12 col-md-12 col-lg-12 sortable-grid ui-sortable">
                <div class="jarviswidget jarviswidget-sortable" data-widget-colorbutton="false" data-widget-editbutton="false" data-widget-custombutton="false">
                    <header>
                        <span class="widget-icon"><i class="fa fa-edit"></i></span>
                        <h2>报价管理/<span style="color:#ffd600!important">商机报价编辑</span></h2>
                        <div style="float:right;">
                            <button type="submit" class="btn btn-success" id="btnadd">
                                保存
                            </button>
                            <button type="submit" class="btn btn-default" id="btnback">
                                返回
                            </button>
                        </div>
                    </header>
                    <div role="content">
                        <div class="jarviswidget-editbox"></div>
                        <div class="widget-body">
                            <form id="formmain" class="smart-form form-backgroud">
                                <div class="row">
                                    <label class="col col-2 label">
                                        客户选择
                                    </label>
                                    <div id="showData">
                                    </div>
                                </div>
                                <div class="sc_more">
                                    <a class="control-label" href="javascript:void(0);" id="sc_more">更多客户选择</a>
                                </div>
                                <div class="row">
                                    <label class="col col-2 label">客户名称</label>
                                    <div class="col col-3">
                                        <div class="input">
                                            <select style="width:100%" id="customName" class="select2" name="cname">
                                                <option></option>
                                            </select>
                                        </div>
                                    </div>
                                    <label class="col col-1 label" style="width: 10.5%;">BP九位码选择</label>
                                    <div class="col col-3">
                                        <div class="input">
                                            <select multiple style="width:100%" class="select2" id="BPCODE9">
                                                <option value=""></option>
                                            </select>
                                            @*<input type="text" class="form-control select2-container-multi" id="BPCODE" disabled="disabled" style="display:none;" />*@
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <label class="col col-2 label" style="margin-top:20px;">商机名称</label>
                                    <div id="showBdata"></div>
                                </div>
                                <div class="row">
                                    <label class="col col-2 label">报价名称</label>
                                    <div class="col col-3">
                                        <div class="input">
                                            <input type="text" class="form-control" name="pname" id="PNAME" />
                                        </div>
                                    </div>
                                    <section class="col col-3" style="width:58%;">
                                        <label class="label col col-4" style="width:17%;">起始日期</label>
                                        <label class="input col col-8" style="width: 32.67%;">
                                            <div class="input-group date">
                                                <input class="form-control form-date" type="text" id="DTFROM" name="dtfrom" readonly="readonly">
                                                <span class="input-group-addon"><i class="fa fa-calendar"></i></span>
                                            </div>
                                        </label>
                                        <label class="tjrqqj" style="width:45%;">
                                            <a class="rqqj" href="javascript:void(0);">一个月</a>
                                            <a class="rqqj" href="javascript:void(0);">三个月</a>
                                            <a class="rqqj" href="javascript:void(0);">半年</a>
                                            <a class="rqqj" href="javascript:void(0);">一年</a>
                                        </label>
                                    </section>
                                </div>
                                <div class="row" @*style="margin-left: 41.5%;"*@>
                                    <label class="label col col-4" style="display:none">合同编号</label>
                                    <label class="input col col-8" style="display:none">
                                        <input type="text" id="CONTRSCTNUM" name="CONTRSCTNUM">
                                    </label>
                                    <label class="col col-2 label">英文报价名称</label>
                                    <div class="col col-3">
                                        <div class="input">
                                            <input type="text" class="form-control" name="ename" id="ENAME" />
                                        </div>
                                    </div>
                                    <section class="col col-5" style="width:52%;">
                                        <label class="label col col-4">截止日期</label>
                                        <label class="input col col-8" style="width: 65%;">
                                            <div class="input-group date">
                                                <input class="form-control form-date" type="text" id="DTTO" name="dtto" readonly="readonly">
                                                <span class="input-group-addon"><i class="fa fa-calendar"></i></span>
                                            </div>
                                        </label>
                                    </section>
                                </div>
                                <div class="row" style="margin-bottom:10px;">
                                    <label class="col col-2 label">币种</label>
                                    <div class="col col-6">
                                        <div class="input" style="width:50%;">
                                            <select style="width:50%" class="select2" id="WAERS">
                                                <option value=""></option>
                                            </select>
                                        </div>
                                    </div>
                                    <label class="col col-4 label"></label>
                                </div>
                                <div class="row">
                                    <label class="col col-2 label">报价组织</label>
                                    <div class="col col-10">
                                        <div class="input-group">
                                            <input type="text" class="form-control" name="porg" id="PORG" disabled="disabled" />
                                            <span class="input-group-addon"><i class="fa fa-edit" onclick="editORG()"></i></span>
                                        </div>
                                    </div>
                                </div>
                                <div class="row" style="margin-top:20px;">
                                    <label class="col col-2 label">备注</label>
                                    <div class="col col-10">
                                        <label class="textarea">
                                            <i class="icon-append fa fa-comment"></i>
                                            <textarea rows="4" name="pmemo" id="MEMO"></textarea>
                                        </label>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </article>
        </div>
    </section>
</div>
@section pagespecific {
    <script src="~/Content/QO/scripts/framework.js"></script>
    <script src="~/Content/QO/scripts/Ewin.js"></script>
    @*<script src="~/Content/plugins/toastr.min.js"></script>
        <script src="~/Content/plugins/jquery.ajaxupload.js"></script>
        <script src="~/Content/plugins/jquery.bootpag.min.js"></script>
        <script src="~/Content/plugins/jquery.guid.js"></script>
        <script src="~/Content/plugins/base.js"></script>*@
    <script src="/js/lib/jquery.plug-ins.js" type="text/javascript"></script>
    <script src="/scripts/plugin/datatables/dataTables.colReorder.min.js" type="text/javascript"></script>
    <script src="/scripts/plugin/datatables/dataTables.colVis.min.js" type="text/javascript"></script>
    <script src="/scripts/plugin/datatables/dataTables.fixedColumns.min.js" type="text/javascript"></script>
    <script src="/scripts/plugin/datatables/dataTables.fixedHeader.js" type="text/javascript"></script>
    <script src="~/Content/QO/toastr/toastr.min.js"></script>
    <link rel="stylesheet" href="~/Content/QO/toastr/toastr.min.css">
    <link href="~/Content/QO/scripts/bootstrap-datetimepicker/css/bootstrap-datetimepicker.min.css" rel="stylesheet">
    <script src="~/Content/QO/scripts/bootstrap-datetimepicker/js/bootstrap-datetimepicker.min.js"></script>
    <script type="text/javascript" src="~/Content/QO/scripts/bootstrap-datetimepicker/js/locales/bootstrap-datetimepicker.zh-CN.js" charset="UTF-8"></script>
    <link href="~/Content/QO/scripts/icheck/skins/square/blue.css" rel="stylesheet">
    <script src="~/Content/QO/layer/layer.js"></script>
    <script src="~/Content/QO/scripts/icheck/icheck.min.js"></script>
    <script type="text/javascript">

        var FBstate = request("FBstate");
        var SendStatus = request("SendStatus");
        //全局变量
        var dataList;
        var businessList;
        var gylnum = "0";
        var bpcode9;
        var bjorgcode;
        var crmdtfrom;//crm合同起始日期
        var crmdtto;//crm合同截止日期
        var pnameArray = [];//选择的商机名称
        var pnameStr = "";
        var pidArray = [];//选择的商机ID
        function iCheckStyled() {
            $('input').iCheck({
                checkboxClass: 'icheckbox_square-blue',
                radioClass: 'iradio_square-blue'
            });
        }
        //点击时间区间
        if (SendStatus != "1" && SendStatus != "2" && SendStatus != "3" && SendStatus != "4" && SendStatus != "5" && SendStatus != "6") {
            $(".rqqj").click(function () {
                $(this).addClass("valid");
                $(this).siblings().removeClass("valid");
                var dtfrom = $("#DTFROM").val();
                var newdtto;
                if (dtfrom.length != 0) {
                    var olddtto = new Date(dtfrom);
                    if ($(this).text() == '一个月') {
                        olddtto.setMonth(olddtto.getMonth() + 1);
                    } else if ($(this).text() == '三个月') {
                        olddtto.setMonth(olddtto.getMonth() + 3);
                    } else if ($(this).text() == '半年') {
                        olddtto.setMonth(olddtto.getMonth() + 6);
                    } else if ($(this).text() == '一年') {
                        olddtto.setMonth(olddtto.getMonth() + 12);
                    }
                    newdtto = olddtto.getFullYear() + '/' + ((olddtto.getMonth() < 9 ? '0' : '') + (olddtto.getMonth() + 1)) + '/' + (olddtto.getDate() < 10 ? '0' : '') + olddtto.getDate();
                    $("#DTTO").val(newdtto);
                }
            });
        }
        //保存列表信息
        $("#btnadd").click(function () {
            toastr.clear();
            toastr.remove();
            if ($("#customName").select2("data") == undefined) {
                toastr.error("请先选择客户");
                return;
            }
            var cuscode = $("#customName").select2("data").id;
            var cusname = $("#customName").select2("data").text;
            if ($("#PNAME").val() == "") {
                toastr.error("请先选择商机");
                return;
            }
            if ($("#PNAME").val() == "") {
                toastr.error("请维护报价名称");
                return;
            }
            var WAERS = $("#WAERS").val();
            var bpcode9 = $("#BPCODE9").val();
            var bpcode = $("#BPCODE").val();
            var bpcode9val = '';
            //取消9位码必填校验，传接口的时候会校验
            //if (gylnum == "1" && bpcode9 == null && bpcode == null) {
            //    toastr.error("请维护BP九位码！");
            //    return;
            //}
            if (bpcode9 != null) {
                bpcode9val = bpcode9.join(",");
            } else if (bpcode != "") {
                bpcode9val = bpcode;
            }
            if ($("#DTFROM").val() == "") {
                toastr.error("请填写起始日期");
                return;
            }
            if ($("#DTTO").val() == "") {
                toastr.error("请填写截止日期");
                return;
            }
            var busArray = [];
            var orgArray = [];
            $("input[type='checkbox']").each(function () {
                if ($(this).is(":checked")) {
                    var obj = { buscode: "", busname: "" };
                    if (typeof ($(this).attr('buscode')) != "undefined" && typeof ($(this).attr('busname')) != "undefined") {
                        obj.buscode = $(this).attr('buscode');
                        obj.busname = $(this).attr('busname');
                        busArray.push(obj);
                    }
                    var obj1 = { orgcode: "", orgname: "" };
                    if (typeof ($(this).attr('orgcode')) != "undefined" && typeof ($(this).attr('orgname')) != "undefined") {
                        obj1.orgcode = $(this).attr('orgcode');
                        obj1.orgname = $(this).attr('orgname');
                        orgArray.push(obj1);
                    }
                }
            });
            var orgcode = orgArray[0].orgcode;
            var orgname = orgArray[0].orgname;
            var priceName = $("#PNAME").val();
            var enpriceName = $("#ENAME").val();
            var dtfrom = $("#DTFROM").val();
            var dtto = $("#DTTO").val();
            var memo = $("#MEMO").val();
            var contrsctnum = $("#CONTRSCTNUM").val();
            var res = {};
            if (request("keyValue") != "" && request("keyValue") != null) {// 产品报价进入
                $.ajax({
                    url: "@Url.Action("SaveSJBJ")",
                    data: {
                        keyvalue: request("keyValue"),
                        zversion: request("zversion"),
                        cuscode: cuscode,
                        cusname: cusname,
                        busArray: JSON.stringify(busArray),
                        orgcode: orgcode,
                        orgname: orgname,
                        priceName: priceName,
                        priceName_en: enpriceName,
                        dtfrom: dtfrom,
                        dtto: dtto,
                        contrsctnum:contrsctnum,
                        memo: memo,
                        bpcode9: bpcode9val,
                        WAERS: WAERS
                    },
                    async: false,
                    dataType: "json",
                    success: function (data) {
                        toastr.clear();
                        toastr.remove();
                        if (data.Success) {
                            if (data.Code == "1") {
                                toastr.success(data.Message);
                                setTimeout(function () { location.href = "/QM_Price/QM_PriceEdit?keyValue=" + request("keyValue") + "&state=" + FBstate; }, 200);
                            } else if (data.Code == "2") {
                                alert("消息提示", data.Message);
                            } else if (data.Code == "3") {// 商机未包含产品
                                alert("消息提示", "所选商机未包含产品：" + data.Data)
                            }
                        } else {
                            toastr.error(data.Message);
                        }
                    }
                });
            } else if (request("CustomID") != "" && request("CustomID") != null) {
                $.ajax({
                    url: "@Url.Action("SaveNEWSJBJ")",
                    data: {
                        keyvalue: request("keyValue"),
                        zversion: request("zversion"),
                        cuscode: cuscode,
                        cusname: cusname,
                        busArray: JSON.stringify(busArray),
                        orgcode: orgcode,
                        orgname: orgname,
                        priceName: priceName,
                        dtfrom: dtfrom,
                        dtto: dtto,
                        contrsctnum:contrsctnum,
                        memo: memo,
                        bpcode9: bpcode9val,
                        WAERS: WAERS
                    },
                    async: false,
                    dataType: "json",
                    success: function (data) {
                        toastr.clear();
                        toastr.remove();
                        if (data.Success) {
                            toastr.success(data.Message);
                            setTimeout(function () { location.href = "/QM_Price/QM_PriceEdit?keyValue=" + data.Data }, 200);
                        } else {
                            toastr.error(data.Message);
                        }
                    }
                });
            }
        });
        $(function () {
            var user = '@Oncontrol3.Web.Helpers.SQMHelper.getStaffKey()';
            if (user.length < 1) {
                layer.alert('系统登录已超时，请重新登录', { icon: 2 });
            }
            $("#amenufld").trigger("click");
            toastr.options = {
                closeButton: false,
                debug: false,
                progressBar: true,
                positionClass: "toast-top-center",
                onclick: null,
                showDuration: "300",
                hideDuration: "1000",
                timeOut: "3000",
                extendedTimeOut: "1000",
                showEasing: "swing",
                hideEasing: "linear",
                showMethod: "fadeIn",
                hideMethod: "fadeOut"
            };
            var errorClass = 'invalid';
            var errorElement = 'em';
            //form validation Begain
            $('#formmain').validate({
                errorClass: errorClass,
                errorElement: errorElement,
                highlight: function (element) {
                    $(element).parent().removeClass('state-success').addClass("state-error");
                    $(element).removeClass('valid');
                },
                unhighlight: function (element) {
                    $(element).parent().removeClass("state-error").addClass('state-success');
                    $(element).addClass('valid');
                },
                // Rules
                rules: {
                    cname: {
                        required: true
                    },
                    pname: {
                        required: true
                    },
                    pmemo: {
                        required: true,
                        rangelength: [10, 100]
                    },
                    dtfrom: {
                        required: true
                    },
                    dtto: {
                        required: true
                    }
                },
                // Messages
                messages: {
                    cname: {
                        required: ' 必选'
                    },
                    pname: {
                        required: ' 必填'
                    },
                    dtfrom: {
                        required: '必填'
                    },
                    dtto: {
                        required: '必填'
                    },
                    pmemo: {
                        required: ' 必填',
                        rangelength: $.validator.format("请输入长度介于 {0} 和 {1} 之间的字符串")
                    }
                },
                // Do not change code below
                errorPlacement: function (error, element) {
                    error.insertAfter(element.parent());
                }
            });
            //时间空间初始化
            $(".form-date").datetimepicker({
                format: "yyyy/mm/dd",
                autoclose: true,
                todayBtn: true,
                todayHighlight: true,
                startView: 2,
                minView: 2,
                clearBtn: true,
                language: "zh-CN"
            });
            //form validation End
            //crm接口拿到客户数据
            $.ajax({
                url: "/QM_Price/GetCustomFromCrm",
                data: {
                    user: "",
                    customname: "",
                    mrid: request("keyValue"),
                },
                dataType: "json",
                async: false,
                success: function (data) {
                    //console.log(data);
                    if (data != "") {
                        //dataList = JSON.parse(data);
                        bjorgcode = data[0];
                        $("#PORG").val(data[1]);
                        dataList = JSON.parse(data[2]);
                    }
                }
            });
            //客户数据渲染
            var showDateMsg = "";
            if (dataList != null && dataList != undefined) {
                for (var i = 0; i < dataList.length; i++) {
                    showDateMsg += "<section class='col col-3'><a href='javascript:void(0);' onclick='chooseCustom(\"" + dataList[i].ID + "\",\"" + dataList[i].NAME + "\");return false;'>" + dataList[i].NAME + "</a></section>";
                    if (i == 5) {
                        showDateMsg += "<div style='display:none' id='more_sc'>";
                    }
                    if ((i + 1) % 3 == 0) {
                        showDateMsg += " <label class='col col-2 label'>&nbsp;</label >";
                    }
                    if (i == dataList.length - 1) {
                        showDateMsg += "</div>";
                    }
                }
            }
            $("#showData").append(showDateMsg);
            //客户名称下拉框
            $(dataList).each(function (k, o) {
                $("#customName").append($("<option></option>").attr("value", o.ID).html(o.NAME));
            });
            //币种
            getTuccr();

            //跳转该页面有两种情况
            //1 已有报价选择商机
            //2 无报价选择商机
            if (request("keyValue") != "" && request("keyValue") != null) {// 已有报价选择商机
                var mrid = request("keyValue");
                var zversion = request("zversion");
                showAllData(mrid, zversion);
            }
            else if (request("CustomID") != "" && request("CustomID") != null) {// 无报价选择商机
                var CustomID = request("CustomID");
                $("#customName").select2("val", CustomID);
                $("#customName").prop("disabled", true);
                //自动带出商机
                $.ajax({
                    url: "@Url.Action("getbusiness")",
                    data: {
                        loginname: '@Oncontrol3.Web.Helpers.SQMHelper.getStaffKey()',
                        customerid: CustomID
                    },
                    dataType: "json",
                    async: false,
                    success: function (data) {
                        businessList = data;
                    }
                });
                var dataMsg = "";
                if (businessList.length > 0) {
                    for (var j = 0; j < businessList.length; j++) {
                        var businessName = businessList[j].BUSINESSNAME;
                        var busimessId = businessList[j].ID;
                        var companyName = businessList[j].COMPANYNAME;
                        var companyId = businessList[j].COMPANYID;
                        if (businessName != null && companyName != null) {
                            if ((j + 1) % 3 == 0) {
                                dataMsg += '<section class="col col-3"><label class="label">&nbsp;</label><label class="checkbox"><input type="checkbox" busname = ' + businessName + ' buscode=' + busimessId + ' orgcode=' + companyId + ' orgname= ' + companyName + ' class = "all"><i></i>' + businessName + '-' + companyName + '</label></section><section class="col col-2"><label class="label">&nbsp;</label></section>';
                            } else {
                                dataMsg += '<section class="col col-3"><label class="label">&nbsp;</label><label class="checkbox"><input type="checkbox" busname = ' + businessName + ' buscode=' + busimessId + ' orgcode=' + companyId + ' orgname= ' + companyName + ' class = "all"><i></i>' + businessName + '-' + companyName + '</label></section>';
                            }
                        }
                    }
                }
                $("#showBdata").append(dataMsg);
                //商机支持多选，但是只能多选同一组织下的商机
                $(":checkbox").change(function () {
                    getbpcode9();
                    var index = $(this).parent().text().indexOf("-");
                    var length = $(this).parent().text().length;
                    var checkOnly = "";
                    var orgName = "";
                    if ($(this).is(':checked')) {
                        checkOnly = $(this).attr("orgcode");
                        $(".all").each(function () {
                            if ($(this).attr('orgcode') != checkOnly) {
                                $(this).attr('disabled', 'disabled');
                            }
                        });
                        orgName = $(this).parent().text().substring(index + 1, length);
                        pnameArray.push($(this).parent().text().substring(0, index));
                        pnameStr = pnameArray.toString();
                        pidArray.push($(this).parent().find(".all").attr("buscode"));
                        $("#PNAME").val(pnameStr);
                        $("#PORG").val(orgName);
                        getQZRQ();
                    } else {
                        checkOnly = $(this).attr("orgcode");
                        var count = 0;
                        $(".all").each(function () {
                            if ($(this).attr('orgcode') == checkOnly && $(this).is(':checked')) {
                                count++;
                            }
                        });
                        if (count == 0) {
                            $(".all").removeAttr('disabled');
                            $("#PORG").val(" ");
                        };
                        pnameArray.splice($.inArray($(this).parent().text().substring(0, index), pnameArray), 1);
                        pidArray.splice($.inArray($(this).parent().find(".all").attr("buscode"), pidArray), 1);
                        pnameStr = pnameArray.toString();
                        $("#PNAME").val(pnameStr);
                        getQZRQ();
                    }
                });
            }
            getbpcode9();
            if (gylnum == "0") {
                $("#BPCODE9").attr("disabled", "disabled");
            }
            if (SendStatus == "1" || SendStatus == "2" || SendStatus == "3" || SendStatus == "4" || SendStatus == "5" || SendStatus == "6") {
                $("#PNAME").attr("disabled", true);
                $("#MEMO").attr("disabled", true);
                $("#DTFROM").attr("disabled", true);
                $("#DTTO").attr("disabled", true);
            }
        });

        //更多客户选择点击折叠
        $("#sc_more").click(function () {
            $("#more_sc").toggle();
            var cls = $(this).attr("class");
            if (cls == 'clk') {
                $(this).removeClass('clk');
            } else {
                $(this).addClass('clk');
            }
        });
        //获取BP9位码
        function getbpcode9() {
            var mrid = '';
            if (request("keyValue") != "" && request("keyValue") != null) {// 已有报价选择商机
                mrid = request("keyValue");
            }
            var CustomID = $("#customName").val();
            //选择的商机
            var busArray = [];
            $("input[type='checkbox']").each(function () {
