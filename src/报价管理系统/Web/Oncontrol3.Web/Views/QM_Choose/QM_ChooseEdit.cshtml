        //$("#fixedleftnum").val($.cookie("bjfixedcol") || 4);
        //DrawTable();
        //$("div[class='ColVis']").hide();
        
    });

    function showResult(){
        $("#result").css("display", "block");
        $("#fixedleftnum").val($.cookie("bjfixedcol") || 4);
        DrawTable();
        $("div[class='ColVis']").hide();
    };
    //使菜单框点击其他地方不自动消失
    $("body").on('click', '[data-stopPropagation]', function (e) {
        e.stopPropagation();
    });
    $(document).ready(function () {
        detectmob();
        //初始化datapicker
        $(".form-date").datetimepicker({
            format: "yyyy/mm/dd",
            autoclose: true,
            todayBtn: true,
            todayHighlight: true,
            startView: 2,
            minView: 2,
            clearBtn: true,
            language: "zh-CN"
        });
    });
    function DrawTable() {
        //列定义
        var columns =
            [
                {
                    "title": "序号", "data": null, "width": "30"
        },
                         {
                             "title": "操作", "data": "ID", "width": "40",
                             render: function (data, type, row, meta) {
                                 return '<button title="编辑" class="btn btn-xs btn-default" onclick=doEdit(\"' + data + '\") ><i class="fa fa-pencil"></i></button>'
                                     + '<button title="删除" class="btn btn-xs btn-default" onclick=doDelete(\"' + data + '\") ><i class="fa fa-times"></i></button>';
                             }
                         },
                        { "title": "产品代码",  "data": "CODE", "width": "120" },
                        { "title": "产品名称",  "data": "NAME", "width": "240" },
                        { "title": "事业部",  "data": "SYB", "width": "200" },
                        { "title": "业务类型",  "data": "YWLX", "width": "100" },
                        { "title": "产品经理",  "data": "CPJL", "width": "100" },
                        { "title": "启用日期开始",  "data": "DTFROM", "width": "120",
                            "render": function (data, type, full, meta) {
                                if (full.DTFROM == null || full.DTFROM == undefined)
                                    return "";
                                else {
                                    var gmtDate = new Date(formatDate(full.DTFROM));
                                    gmtDate.setHours(gmtDate.getHours() + 8);
                                    return gmtDate.Format("yyyy/MM/dd");
                                }
                            }
                        },
                        { "title": "启用日期结束",  "data": "DTTO", "width": "120",
                            "render": function (data, type, full, meta) {
                                if (full.DTTO == null || full.DTTO == undefined)
                                    return "";
                                else {
                                    var gmtDate = new Date(formatDate(full.DTTO));
                                    gmtDate.setHours(gmtDate.getHours() + 8);
                                    return gmtDate.Format("yyyy/MM/dd");
                                }
                            }
                        },
                        { "title": "启用状态",  "data": "STATUS", "width": "100" },
                        { "title": "创建日期",  "data": "CREATETIME", "width": "120" ,
                            "render": function (data, type, full, meta) {
                                if (full.CREATETIME == null || full.CREATETIME == undefined)
                                    return "";
                                else {
                                    var gmtDate = new Date(formatDate(full.CREATETIME));
                                    gmtDate.setHours(gmtDate.getHours() + 8);
                                    return gmtDate.Format("yyyy/MM/dd hh:mm:ss");
                                }
                            }},
                        { "title": "最后修改日期",  "data": "MODIFYTIME", "width": "120" },
                        { "title": "备注",  "data": "MEMO", "width": "200" }
        ];
        var table = $('#datatable_col_reorder').dataTable({
            "processing": true,
            "serverSide": true,
            "colReorder": true,
