@section pagespecific {
    <script src="~/Content/QO/scripts/framework.js"></script>
    <script src="~/Content/QO/scripts/Ewin.js"></script>
    <script src="~/Content/QO/toastr/toastr.min.js"></script>
    <link rel="stylesheet" href="~/Content/QO/toastr/toastr.min.css">
    <script src="~/Content/QO/layer/layer.js"></script>
    <script src="/js/lib/jquery.plug-ins.js" type="text/javascript"></script>
    <script src="/scripts/plugin/datatables/dataTables.colReorder.min.js" type="text/javascript"></script>
    <script src="/scripts/plugin/datatables/dataTables.colVis.min.js" type="text/javascript"></script>
    <script src="/scripts/plugin/datatables/dataTables.fixedColumns.min.js" type="text/javascript"></script>
    <script src="/scripts/plugin/datatables/dataTables.fixedHeader.js" type="text/javascript"></script>
    <link href="~/Content/QO/scripts/bootstrap-fileinput-master/css/fileinput.min.css" rel="stylesheet">
    <script src="~/Content/QO/scripts/bootstrap-fileinput-master/js/fileinput.min.js"></script>
    <script src="~/Content/QO/scripts/bootstrap-fileinput-master/js/locales/zh.js"></script>
    <link href="~/Content/QO/scripts/bootstrap-datetimepicker/css/bootstrap-datetimepicker.min.css" rel="stylesheet">
    <script src="~/Content/QO/scripts/bootstrap-datetimepicker/js/bootstrap-datetimepicker.min.js"></script>
    <script type="text/javascript" src="~/Content/QO/scripts/bootstrap-datetimepicker/js/locales/bootstrap-datetimepicker.zh-CN.js" charset="UTF-8"></script>
    <script type="text/javascript">
        var gdzkey = '';
        var jtlj = "";
        // 询价 2018/7/24 chenbo
        function back2() {
            location.href = "/SQM_ENQUIRY_HKY/QuiryPURIndex";
        }
        if (request("sign") == "q") {
            // Datatable 绘制完成后执行方法
            //$("#datatable_col_reorder").on("draw.dt", function () {
            //    alert("", localStorage.getItem("QYG") + "," + localStorage.getItem("MDG") + "," + localStorage.getItem("CQ"));
            //});
            $("#responseQ").show();
            var psf = request("psf");
            $("#btnback").attr("onclick", "back2()");
            // 填充组织
            //$("#ZZMC").val(request("orgcode"));
            var zz = request("orgcode");
            $("#ZZMC").attr("disabled", true);
            $("#ZZMC").select2("val", request("orgcode"));
        }

        $("#submit_search").click(function () {
            $('#datatable_col_reorder').DataTable().search("").draw();
            return false;
        });
        $(".djfb").click(function () {
            var ifdpdx = '';
            var ifcost = '';
            if ($("input[name='DPDX']:checked").val() == "on") {
                ifdpdx = '1';
            }
            if ($("input[name='COST']:checked").val() == "on") {
                ifcost = '1';
            }
            var zzmcarr = $("#ZZMC").val();
            if (zzmcarr == null) {
                toastr.clear();
                toastr.remove();
                toastr.error("组织名称不能为空！");
                return false;
            }
            var djfs = $("input[name='DJFS']:checked").val();
            djfbAllRows(djfs, ifdpdx, ifcost);
            //var checkBoxs = $("input[name='checkBox']:checked");
            //var djfs = $("input[name='DJFS']:checked").val();
            //if (checkBoxs.length == 0 && djfs == '0' && ifdpdx != "1" && ifcost!="1") {
            //    toastr.clear();
            //    toastr.remove();
            //    toastr.error("请选择需要发布的数据行！");
            //    return false;
            //} else {
            //    djfbAllRows(djfs, ifdpdx,ifcost);
            //}
        });
        //批量发布
        function djfbAllRows(djfs, ifdpdx, ifcost) {
            var zzmcarr = $("#ZZMC").val();
            var orgcode = zzmcarr.join(",");
            var rowIds = [];
            var checkBoxs = $("input[name='checkBox']:checked");
            checkBoxs.each(function () {
                if (rowIds.indexOf($(this).val()) == -1) {
                    rowIds.push($(this).val());
                }
            });
            $.ajax({
                type: 'POST',
                url: "/SQM_PUR/PurCreate",
                data: {
                    ORGCODE: orgcode,
                    RID: "@Model.RID",
                    FEECODE: "@Model.FEECODE",
                    ROWIDS: rowIds.join(","),
                    DJFS: $("input[name='DJFS']:checked").val(),
                    IFDPDX: ifdpdx,
                    IFCOST: ifcost
                },
                dataType: "json",
                success: function (data) {
                    toastr.clear();
                    toastr.remove();
                    if (data.Success) {
                        toastr.success(data.Message);
                        if (djfs != '0') {
                            setTimeout(function () { location.href = "/SQM_PUR/Index" }, 2000);
                        }
                        $('#datatable_col_reorder').DataTable().search("").draw();
                    } else {
                        toastr.error(data.Message);
                    }
                },
                error: function (data) {
                    if (!!data.responseText) {
                        alert(data.responseText);
                    } else {
                        window.alert("请求失败！");
                    }
                }
            });
        }
        // fileinput
        var FileInput = function () {
            var oFile = new Object();
            oFile.Init = function (ctrlName, uploadUrl) {
                var control = $("#" + ctrlName);
                // 初始化上传控件的样式
                control.fileinput({
                    language: "zh",//设置语言
                    uploadUrl: uploadUrl,//上传的地址
                    allowedFileExtensions: ["xls", "xlsx"],//接收的文件后缀
                    showUpload: true,//是否显示上传按钮
                    showCaption: true,//是否显示标题
                    browseClass: "btn btn-primary",//按钮样式 
                    maxFileCount: 1,//表示允许同时上传的最大文件个数
                    enctype: "multipart/form-data",
                    validateInitialCount: true,
                    autoReplace: true, // 是否自动替换当前文件
                    dropZoneEnabled: false, //是否显示拖拽区域
                    maxFileSize: 0, // 单位为kb，如果为0表示不限制文件大小
                    previewFileIcon: "<img src='/Content/QO/scripts/bootstrap-fileinput-master/img/excel.png' />",
                    msgFilesTooMany: "选择上传的文件数量({n}) 超过允许的最大数值{m}!",
                    layoutTemplates: {
                        actionDelete: "", // 去除上传预览的缩略图中的删除图标
                        actionUpload: "", // 去除上传预览缩略图中的上传图
                        actionZoom: "" // 去除上传预览缩略图中的查看详情预览的缩略图标
                    }
                });

                // 导入文件上传上传完成之后的事件
                $("#fileImport").on("fileuploaded", function (event, data, previewId, index) {
                    toastr.clear();
                    toastr.remove();
                    switch (data.response.Code) {
                        case "0": // 成功
                            alert("消息提示", data.response.Message);
                            //toastr.success(data.response.Message);
                            $('#importExc').modal('hide');
                            $('#datatable_col_reorder').DataTable().search("").draw();
                            break;
                        case "1": // 失败
                            alert("消息提示", data.response.Message);
                            //toastr.error(data.response.Message);
                            $('#importExc').modal('hide');
                            $('#datatable_col_reorder').DataTable().search("").draw();
                            break;
                        case "2": // 异常
                            alert("消息提示", data.response.Message);
                            //toastr.error(data.response.Message);
                            $('#importExc').modal('hide');
                            $('#datatable_col_reorder').DataTable().search("").draw();
                            break;
                    }
                });
                // 导入失败后的事件
                $("#fileImport").on("fileerror", function (event, data, msg) {
