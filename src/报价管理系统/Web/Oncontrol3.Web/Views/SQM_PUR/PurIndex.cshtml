                toastr.error("无绑定关系的费目不能复制！");
                return;
            }
            $("input[name = 'djfz']").prop("checked", true);
            popDialog("提示", "复制将会把已定价的信息置为失效，是否继续？", godjfz, nodjfz);
        }
        function godjfz() {
            // 引入html
            $("#page1").load("/SQM_PUR/PurCopyIndex?feecode=" + "@Model.FEECODE" + "&djrid=" + "@Model.RID" + "&prdcode=" + "@Model.PRDCODE");
            $("#djfzAdd").modal("show");
        }
        //不复制
        function nodjfz() {
            $("input[name = 'djfz']").prop("checked", false);
            $(".modal-backdrop").hide();
        }
        //展示GDZKEY
        function showGdzKey(gdzkey) {
            var GDZKEYArray = [];
            $.ajax({
                url: "@Url.Action("GetGdzKey")",
                data: {
                    feecode: "@Model.FEECODE",
                    djfsrid: $(".dlc").find(".active").find(".djfsrid").val(),
                },
                dataType: "json",
                async: false,
                success: function (data) {
                    GDZKEYArray = data[0];
                }
            });
            ////高低值渲染
            if (GDZKEYArray.length > 0) {
                for (var i = 0; i < GDZKEYArray.length; i++) {
                    $("input[name='GDZKEY'][value='" + GDZKEYArray[i][0] + "']").removeAttr("disabled");
                }
                if (gdzkey == "") {
                    $("input[name='GDZKEY'][value='" + GDZKEYArray[0][0] + "']").prop("checked", true);
                } else {
                    $("input[name='GDZKEY'][value='" + gdzkey + "']").prop("checked", true);
                }
            }
        }
        //展示高低值名称列表
        function showGdzData(gdzkey) {
            var backflag = true;
            var gdzmsg = "";
            var GDZArray = [];
            $.ajax({
                url: "@Url.Action("GetGdzData")",
                data: {
                    feecode: "@Model.FEECODE",
                    djfsrid: $(".dlc").find(".active").find(".djfsrid").val(),
                    gdzkey: gdzkey,
                },
                dataType: "json",
                async: false,
                success: function (data) {
                    GDZArray = data[0];
                }
            });
            ////高低值渲染
            if (GDZArray.length > 0) {
                for (var i = 0; i < GDZArray.length; i++) {
                    gdzmsg += "<div class='gdz'><input type='hidden' class='gdzrid' value=" + GDZArray[i][0] + " /><input type='text' class='form-control gdzname' title='" + GDZArray[i][1] + "'  value=" + GDZArray[i][1] + " readonly></div>";
                }
            } else {
                //toastr.clear();
                //toastr.remove();
                //toastr.error("未维护基础数据！");
                $(".gdzdiv").find(".gdz").remove();
                backflag = false;
            }
            $(".gdzdiv").find(".gdz").remove();
            $(".gdzdiv").append(gdzmsg);
            return backflag;
        }
        //列表字段展示
        function getPurIndex(flag) {
            var gdzrid = '';
            var djfsrid = $(".dlc").find(".active").find(".djfsrid").val();
            if (djfsrid == undefined) {
                djfsrid = '';
            }
            if (flag == 2) {
                var gdzrid = $(".gdzdiv").find(".active").find(".gdzrid").val();
                if (gdzrid == undefined) {
                    gdzrid = '';
                }
            }
            var djfs = $("input[name='DJFS']:checked").val();
            var gdzkey = $("input[name='GDZKEY']:checked").val();
            if (gdzkey == undefined) {
                gdzkey = '';
            }
            if (request("sign") == "q") {
                location.href = '/SQM_PUR/PurIndex?djrid=' + "@Model.RID" + '&djfsrid=' + djfsrid + '&djfs=' + djfs + '&gdzkey=' + gdzkey + '&gdzrid=' + gdzrid + '&sign=q&orgcode=' + request("orgcode");
            } else {
                location.href = '/SQM_PUR/PurIndex?djrid=' + "@Model.RID" + '&djfsrid=' + djfsrid + '&djfs=' + djfs + '&gdzkey=' + gdzkey + '&gdzrid=' + gdzrid;
            }

        }
        //定价编辑页
        function goPurEdit(id) {
            toastr.clear();
            toastr.remove();
            if ("@ViewBag.gdznum" == "False") {
                toastr.error("高低值比较最少需要两组计算基础，请确认！");
                return false;
            }
            if ("@ViewBag.czfee" == "False") {
                toastr.error("请维护该费目下的定价方式！");
                return false;
            }
            if (id == undefined) {
                id = '';
            }
            var djfs = $("input[name='DJFS']:checked").val();
            var gdzkey = $("input[name='GDZKEY']:checked").val();
            if (gdzkey == undefined) {
                gdzkey = '';
            }
            var gdzrid = $(".gdzdiv").find(".active").find(".gdzrid").val();
            if (gdzrid == undefined) {
                gdzrid = '';
            }
            if (request("sign") == "q") {
                document.location.href = '/SQM_PUR/PurEdit?id=' + id + '&djrid=' + "@Model.RID" + '&djfsrid=' + "@ViewBag.djfsrid" + '&djfs=' + djfs + '&gdzkey=' + gdzkey + '&gdzrid=' + gdzrid + '&sign=q&orgcode=' + request("orgcode");
            } else {
                document.location.href = '/SQM_PUR/PurEdit?id=' + id + '&djrid=' + "@Model.RID" + '&djfsrid=' + "@ViewBag.djfsrid" + '&djfs=' + djfs + '&gdzkey=' + gdzkey + '&gdzrid=' + gdzrid;
            }
        }
        // modal 对话框
        function popDialog(title, msg, callbackyes, callbackno) {
            if (!title) {
                title = '对话框';
            }
            var dialogHTML = '<div id="selfDialog" class="modal fade">';
            dialogHTML += '<div class="modal-dialog">';
            dialogHTML += '<div class="modal-content">';
            dialogHTML += '<div class="modal-header">';
            dialogHTML += '<button type="button" class="close" data-dismiss="modal" aria-label="Close">';
            dialogHTML += '<span aria-hidden="true">&times;</span>';
            dialogHTML += '</button>';
            dialogHTML += '<h4 class="modal-title">' + title + '</h4>';
            dialogHTML += '</div>';
            dialogHTML += '<div class="modal-body">';
            dialogHTML += msg;
            dialogHTML += '</div>';
            dialogHTML += '<div class="modal-footer">';
            dialogHTML += '<button type="button" class="btn btn-default" data-dismiss="modal" id="buttonno">否</button>';
            dialogHTML += '<button type="button" class="btn btn-primary" data-dismiss="modal" id="buttonyes">是</button>';
            dialogHTML += '</div>';
            dialogHTML += '</div>';
            dialogHTML += '</div>';
            dialogHTML += '</div>';

            $("#selfDialog").remove();
            $("body").append(dialogHTML);
            $("#selfDialog").modal("show");
            // 绑定"是"方法
            $("#buttonyes").click(function () {
                if (typeof callbackyes == "function") {
                    callbackyes();
                }
            });
            // 绑定"否"方法
            $("#buttonno").click(function () {
                if (typeof callbackno == "function") {
                    callbackno();
                }
            });
        }
        /*对询价进行发布*/
        function btnxjdf() {
            debugger
            // 按钮置灰
            $("#responseQ").attr("disabled", true);
            //var checks = $("input[name='checkBox']:checked");
            ////滚动datatable,实际上是两个table,全选中时数量会有问题，选择左边的固定的表进行筛选
            var checks = $('.DTFC_LeftBodyWrapper input[name="checkBox"]:checked');
            //if (checks.length > 1) {
            //    $("#responseQ").attr("disabled", false);
            //    alert("Error!", "只能对一条定价明细进行询价答复！");
            //    return false;
            //}
            if (checks.length == 0) {
                $("#responseQ").attr("disabled", false);
                alert("Error!", "请选择至少一条定价明细进行询价答复！");
                return false;
            } else {
                var data = "";
                for (var i = 0; i < checks.length; i++) {
                    data += checks[i].value + ",";
                }
                data = data.substr(0,data.length - 1);
                //var data = checks[0].value;//当前选中的值
                var sehrid = sessionStorage.getItem("sehrid");
                $.ajax({
                    url: "@Url.Action("ResponseQuery", "SQM_ENQUIRY_HKY")",
                    type: "post",
                    data: {
                        "DJZBRIDS": data,
                        "RID": sehrid
                    },
                    success: function (data) {
                        if (data == '1') {
                            sessionStorage.removeItem("sehrid");
                            toastr.success(data.Message);
                            //window.location.href = "/SQM_ENQUIRY_HKY/QuiryPURIndex";
                            setTimeout(function () { location.href = "/SQM_ENQUIRY_HKY/QuiryPURIndex" }, 1000);
                            //$("#responseQ").attr("disabled", false);
                        } else {
                            alert("警告", "数据提交失败！");
                            $("#responseQ").attr("disabled", false);
                        }
                    }, error: function (data) {
                        alert("警告！", "数据提交失败");
                        $("#responseQ").attr("disabled", false);
                    }
                })
            }
            return false;
        }
        // 重置查询条件
        function ResetQueryValue() {
            // 清空查询控件
            $("#form1").find("input,select").each(function () {
                $(this).val("");
            });
            // 失效->有效
            $("#STATUS").select2("val", 1);
            // 刷新页面
            $('#datatable_col_reorder').DataTable().search("").draw();
            return false;
        }
    </script>
