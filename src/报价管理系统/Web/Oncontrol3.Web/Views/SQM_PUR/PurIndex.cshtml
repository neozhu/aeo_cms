        // 批量替换起止日期
        function ghqzrq() {
            var djfsrid = $(".dlc").find(".active").find(".djfsrid").val();
            if (djfsrid == undefined) {
                djfsrid = '';
            }
            var postdata = GetWebControlsForRadio("#form1");
            try {
                $("#qzrq").attr("disabled", "disabled");
                $.ajax({
                    url: "/SQM_PUR/ChangeQZ",
                    type: "post",
                    data: {
                        'postdata': JSON.stringify(postdata),
                        'djrid': "@Model.RID",
                        "qsdate": $("#QSDATE").val(),
                        "jzdate": $("#JZDATE").val(),
                        "djfsrid": djfsrid,
                    },
                    dataType: "json",
                    success: function (data) {
                        toastr.clear();
                        toastr.remove();
                        if (data.Success) {
                            toastr.success(data.Message);
                            $('#datatable_col_reorder').DataTable().search("").draw();
                        } else {
                            toastr.error(data.Message);
                        }
                    },
                    error: function (data) {
                        if (!!data.responseText) {
                            alert(data.responseText);
                        } else {
                            toastr.clear();
                            toastr.remove();
                            toastr.error("请求失败！");
                        }
                    }
                });
            } catch (e) {
                toastr.clear();
                toastr.remove();
                toastr.error("请求失败，请重试");
