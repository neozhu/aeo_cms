        // 返回
        function back() {
            if (IsEdit) {
                Ewin.confirm({ message: "页面有修改，是否放弃保存？" }).on(function (e) {
                    if (!e) {
                        return;
                    }
                    window.location.href = "@Url.Action("Index")";
                });
            }
            else { window.location.href = "@Url.Action("Index")"; }
        }
        // 保存
        function dosave()
        {
            if (!$("#formmain").valid()) {
                return;
            }
            toastr.info("数据保存中，请稍候...");
            var postdata = GetWebControlsForRadio("#formmain");
            try {
                $("#btnSave").attr("disabled", "disabled");
                $.ajax({
                    url: "/SQM_COST_KYGJ/SubmitForm",
                    type: "post",
                    data: {
                        'postdata': JSON.stringify(postdata),
                        'keyValue': keyValue
                    },
                    dataType: "json",
                    success: function (data) {
                        toastr.clear();
                        toastr.remove();
                        if (data.Message.indexOf("修改失败") >= 0) {
                            toastr.error(data.Message);
                        } else if (data.Message.indexOf("新增失败") >= 0) {
                            toastr.error(data.Message);
                        } else {
                            if (data.Success) {
                                toastr.success(data.Message);
                                //$("#ID").val(data.Data.RID);
                                //setTimeout(function () { location.href = "/SQM_COST_KYGJ/Edit?keyValue=" + $("#ID").val(); }, 200);
                                setTimeout(function () { location.href = "/SQM_COST_KYGJ/Index" }, 200);
                            } else {
                                toastr.error(data.Message);
                            }
                        }
                    },
                    error: function (data) {
                        if (!!data.responseText) {
                            alert(data.responseText);
                        } else {
                            window.alert("请求失败！");
                        }
                    }
                });
            } catch (e)
            {
                window.alert("保存失败，请重试");
            }
            finally { $("#btnSave").removeAttr("disabled"); }
        };

        function GetWebControlsForRadio(element) {
            var postdata = {};
            $(element).find('input,select,textarea').each(function (r) {
                var id = $(this).attr('id');
                if (id != "MODIFYTIME" && id != "MODIFYUSER") {
                    var value = $(this).val();
                    var type = $(this).attr('type');
                    switch (type) {
                        case "radio":
                            if ($(this).is(':checked')) {
                                if (id == "rdFALSE") {
                                    postdata["STATUS"] = 0;
                                } else if (id == "rdTRUE") {
                                    postdata["STATUS"] = 1;
                                }
                            }
                            break;
                        default:
                            //postdata[id] = value;
                            if (id == "HKGSC") {
                                postdata["HKGSCODE"] = value;
                            } else {
                                postdata[id] = value;
                            }
                            break;
                    }
                }
            });
            postdata["MODIFYUSER"] = username;
            return postdata;
        }
