@{
    ViewBag.Title = "代运协议";
    Layout = "~/Views/Shared/_IndexDYXY.cshtml";
}
<script>
    $(function () {
        InitialPage();
        GetGrid();
    });
    //初始化页面
    function InitialPage() {
        //resize重设(表格、树形)宽高
        $(window).resize(function (e) {
            window.setTimeout(function () {
                $('#gridTable').setGridWidth(($('.gridPanel').width()) - 3.5);
                $("#gridTable").setGridHeight($(window).height() - 266.5);
            }, 200);
            e.stopPropagation();
        });
    }
    //加载表格
    function GetGrid() {
        var selectedRowIndex = 0;
        var $gridTable = $('#gridTable');
        $gridTable.jqGrid({
            url: "/ForwarderAgreement/Lists",
            //datatype: "json",
            datatype: "local",
            height: $(window).height() - 136.5,
            autowidth: true,
            colModel: [
                //{ label: '协议DBKEY', name: 'DB_KEY', hidden: true },
                { label: '协议KEY', name: 'DB_KEY', index: 'DB_KEY', width: 90, align: 'left', hidden: true },
                { label: '协议号', name: 'FAGRMNTID044', index: 'FAGRMNTID044', width: 90, align: 'left' },
                { label: '协议描述', name: 'MNEMONIC', index: 'MNEMONIC', width: 90, align: 'left' },
                { label: '产品描述', name: 'REF_SP_TEXT', index: 'REF_SP_TEXT', width: 90, align: 'left' },
                { label: '项目号', name: 'ITEM_NO', index: 'ITEM_NO', width: 90, align: 'left' },
                { label: '项目号KEY', name: 'ITEM_DB_KEY', index: 'ITEM_DB_KEY', width: 90, align: 'left', hidden: true },
                { label: '订购方', name: 'PTYINTID_ID133_I', index: 'PTYINTID_ID133_I', width: 90, align: 'left' },
                { label: '订购方KEY', name: 'PARTY_UUID', index: 'PARTY_UUID', width: 90, align: 'left', hidden: true },
                { label: '销售组织', name: 'ORG_EXT_ID', index: 'ORG_EXT_ID', width: 90, align: 'left' },
                { label: '销售员', name: 'ZXSY', index: 'ZXSY', width: 90, align: 'left' },
                { label: '协议类型', name: 'FAGTYPEID103', index: 'FAGTYPEID103', width: 90, align: 'left' },
                { label: '服务产品', name: 'SERVICE_PRODUCT_ID', index: 'SERVICE_PRODUCT_ID', width: 90, align: 'left' }
            ],
            viewrecords: true,
            rowNum: 200,
            rowList: [200, 500],
            pager: "#gridPager",
            sortname: 'FAGRMNTID044 asc,FAGTYPEID103 desc',
            rownumbers: true,
            shrinkToFit: false,
            gridview: true,
            onSelectRow: function () {
                selectedRowIndex = $("#" + this.id).getGridParam('selrow');
            },
            ondblClickRow: function () {
                selectedRowIndex = $("#" + this.id).getGridParam('selrow');
                btn_add();
            },
            gridComplete: function () {
                $("#" + this.id).setSelection(selectedRowIndex, false);
            }
        });
        //查询事件
        $("#btn_Search").click(function () {
            var queryJson = {
                "xy": $("#xy").val(),
                "xyms": $("#xyms").val(),
                "ywhb": $("#ywhb").val()
                //"ywhbms": $("#ywhbms").val()
            }
            $gridTable.jqGrid('setGridParam', {
                datatype: 'json',
                postData: { queryJson: JSON.stringify(queryJson) }, page: 1
            }).trigger('reloadGrid');
        });
        //查询回车
        $('.form-control').bind('keypress', function (event) {
            if (event.keyCode == "13") {
                $('#btn_Search').trigger("click");
            }
        });
    }

    function btn_add()
    {
        var keyValue = $("#gridTable").jqGridRowValue("DB_KEY");
        if (keyValue) {
            //mrbig
            window.$('#fag_key').val(keyValue);
            window.$('#DAIYUNXIEYI').val(fqLTrim($("#gridTable").jqGridRowValue("FAGRMNTID044")));
            window.$('#DAIYUNXIEYIDESC').html($("#gridTable").jqGridRowValue("MNEMONIC"));
            window.$('#DAIYUNXIEYIDESC').attr('title', $("#gridTable").jqGridRowValue("MNEMONIC"));
            window.$('#XIANGMU').val($("#gridTable").jqGridRowValue("ITEM_NO"));
            window.$('#fag_item_key').val($("#gridTable").jqGridRowValue("ITEM_DB_KEY"));
            window.$('#SERVICE_PRODUCT_ID').val($("#gridTable").jqGridRowValue("SERVICE_PRODUCT_ID"));
            window.$('#zfwcpms').html($("#gridTable").jqGridRowValue("REF_SP_TEXT"));
            window.$('#zfwcpms').attr("title",$("#gridTable").jqGridRowValue("REF_SP_TEXT"));
            window.$('#order_party_id').val($("#gridTable").jqGridRowValue("PTYINTID_ID133_I"));
            window.$('#order_party_key').val($("#gridTable").jqGridRowValue("PARTY_UUID"));
            //1.协议带出的订购方赋值至收发货方（现有）；增加赋值至原、目标位置
            window.$('#shipper_id').val($("#gridTable").jqGridRowValue("PTYINTID_ID133_I"));
            window.$('#shipper_key').val($("#gridTable").jqGridRowValue("PARTY_UUID"));
            window.$('#consignee_id').val($("#gridTable").jqGridRowValue("PTYINTID_ID133_I"));
            window.$('#consignee_key').val($("#gridTable").jqGridRowValue("PARTY_UUID"));
            window.$('#src_loc_id').val($("#gridTable").jqGridRowValue("PTYINTID_ID133_I"));
            window.$('#src_loc_key').val($("#gridTable").jqGridRowValue("PARTY_UUID"));
            window.$('#des_loc_id').val($("#gridTable").jqGridRowValue("PTYINTID_ID133_I"));
            window.$('#des_loc_key').val($("#gridTable").jqGridRowValue("PARTY_UUID"));

            window.$('#sales_org_id').val($("#gridTable").jqGridRowValue("ORG_EXT_ID"));
            window.$('#XIAOSHOUYUAN').val($("#gridTable").jqGridRowValue("ZXSY"));

            CPMS();//带出产品描述
            autoInsertService();

            //dialogClose();
            $("#myModalFWA").modal('hide');
        } else {
            layer.msg('请选择需要添加的代运协议！');
        }
    }
    function CPMS() {//产品自动补全描述
        var cpmsname = "";
        itmval = $('#SERVICE_PRODUCT_ID').val();
        if (!!itmval) {
            $.ajax({
                url: "/MDM/GetProductDescription",
                data: { 'qstr': itmval },
                type: "GET",
                async: false,
                success: function (rtn) {
                    cpmsname = rtn;
                }
            });
            $('#zfwcpms').html(cpmsname);
            $('#zfwcpms').attr('title', cpmsname);
        }
    }
    function btn_clear() {
        window.$('#fag_key').val('');
        window.$('#DAIYUNXIEYI').val('');
        window.$('#DAIYUNXIEYIDESC').html('');
        window.$('#DAIYUNXIEYIDESC').attr('title', '');
        window.$('#XIANGMU').val('');
        window.$('#fag_item_key').val('');
        window.$('#SERVICE_PRODUCT_ID').val('');
        window.$('#order_party_id').val('');
        window.$('#order_party_key').val('');
        window.$('#shipper_id').val('');
        window.$('#shipper_key').val('');
        window.$('#consignee_id').val('');
        window.$('#consignee_key').val('');
        window.$('#src_loc_id').val('');
        window.$('#src_loc_key').val('');
        window.$('#des_loc_id').val('');
        window.$('#des_loc_key').val('');
        window.$('#FHFMS').html('');
        window.$('#SHFMS').html('');
        //window.$('#sales_org_id').val('');
        window.$('#XIAOSHOUYUAN').val('');
        //dialogClose();
        $("#myModalFWA").modal('hide');
    }

    function autoInsertService()
    {
        var pid = window.$('#SERVICE_PRODUCT_ID').val();
        var nothadsrv = true;
        $('input:checkbox[name=icheckbox]').each(function () {
            nothadsrv = false;
        });
        if (pid.length > 1 && nothadsrv)
        {
            if (pid == "") {
                return;
            }
            var text = "";
            $.ajax({
                url: "/SystemServiceType/GetserviceType",
                data: { Pid: pid },
                type: "GET",
                async: false,
                success: function (data) {
                    data = JSON.parse(data);
                    for (var i = 0; i < data.length; i++) {
                        var fqid = fqgenguid();
                        var html = "";
                        var co = data[i].SERVICETYPE;
                        //动态创建表单
                        //调取后台接口，取出表单项，加载。
                        html += ' <fieldset name="fooservice" srvkey="' + fqid + '" id="' + fqid + 'fieldset"><header style="margin-bottom:20px;"><label style="width:auto;font-size:13px" ><i>&nbsp;</i><input id="cksrv' + fqid + '" type="checkbox" srvkey="' + fqid + '" srvcode="' + co + '" name="icheckbox"><i>&nbsp;</i>' + data[i].SERVICENAME + " </label></header>";

                        var mm = "";
                        var foo = "";
                        //从后台查取扩展属性展示
                        $.ajax({
                            url: "/SystemServiceType/GetEXTList",
                            data: { code: co },
                            type: "GET",
                            async: false,
                            success: function (data) {
                                data = JSON.parse(data);
                                for (var i = 0; i < data.length; i++) {
                                    //if (data[i].INFOCODE == "foo" || data[i].INFOCODE == "fo" || data[i].INFOCODE == "fb") {
                                    if (data[i].INFOCODE == "foo") {
                                        foo = ' <div class="col-xs-3 cols"><label class="col-md-5 control-label label">FOO</label><div class="col-md-5"><div class="input-group"><input type="text" disabled="disabled" class="form-control" id="' + fqid + '" ><input type="text" style="display:none;" class="form-control" id="' + fqid + 'transsrvreq_code" name="transsrvreq_code" rwfld="rwfld" value="' + co + '"><input type="text" style="display:none;" class="form-control" rwfld="rwfld" name="servicedbkey" value="' + fqid + '"></div></div></div>';
                                        continue;
                                    }
                                    //绑定数据源
                                    if (data[i].MDMKEY != "" && data[i].MDMKEY != null) {
                                        var mdmtype = "MDM";
                                        if (data[i].MDMKEY == "MDMORG") {
                                            mdmtype = "MDMORG";
                                        }
                                        if (data[i].MDMKEY == "MDMBP") {
                                            mdmtype = "MDMBP";
                                        }
                                        if ('zbgfs' == data[i].INFOCODE) {
                                            mm += ' <div class="col-xs-3 cols"><label class="col-md-5 control-label label">' + data[i].INFONAME + '</label><div class="col-md-5"><div class="input-group"><input type="text" class="form-control" id="' + fqid + data[i].INFOCODE + '" value="01" name="' + data[i].INFOCODE + '" rwfld="rwfld"  mdmtype="' + mdmtype + '"  mdmkey="' + data[i].MDMKEY + '\" mdmfieldname="' + data[i].FIELDNAME + '"></div></div> </div>';
                                        }
                                        else if ('zgqsx' == data[i].INFOCODE && co == 'O00005') {   //新增逻辑当服务为场站时关区属性默认为02
                                            mm += ' <div class="col-xs-3 cols"><label class="col-md-5 control-label label">' + data[i].INFONAME + '</label><div class="col-md-5"><div class="input-group"><input type="text" class="form-control" id="' + fqid + data[i].INFOCODE + '" value="02" name="' + data[i].INFOCODE + '" rwfld="rwfld"  mdmtype="' + mdmtype + '"  mdmkey="' + data[i].MDMKEY + '\" mdmfieldname="' + data[i].FIELDNAME + '"></div></div> </div>';
                                        }
                                        else if (data[i].INFOCODE == "zwtfs")  //委托方式显示中文
                                        {
                                            mm += ' <div class="col-xs-3 cols"><label class="col-md-5 control-label label">' + data[i].INFONAME + '</label><div class="col-md-5"><div class="input-group"><input style="width:34%;" type="text" class="form-control" id="' + fqid + data[i].INFOCODE + '" name="' + data[i].INFOCODE + '" rwfld="rwfld"  mdmtype="' + mdmtype + '"  mdmkey="' + data[i].MDMKEY + '\" mdmfieldname="' + data[i].FIELDNAME + '"><input style="width:58%;" disabled="disabled" type="text" class="form-control" id="' + fqid + data[i].INFOCODE + 'MS"></div></div> </div>';
                                        }
                                        else if (data[i].INFOCODE == "zbgjydw") { //报关经营单位显示中文
                                            mm += ' <div class="col-xs-5 cols"><label class="col-md-3 control-label label">' + data[i].INFONAME + '</label><div class="col-md-3"><div class="input-group"><input type="text" class="form-control" id="' + fqid + data[i].INFOCODE + '" name="' + data[i].INFOCODE + '" rwfld="rwfld"  mdmtype="' + mdmtype + '"  mdmkey="' + data[i].MDMKEY + '\" mdmfieldname="' + data[i].FIELDNAME + '"></div></div><div class="col-md-6"><div ><input style="width:120%;" disabled="disabled" type="text" class="form-control" id="' + fqid + data[i].INFOCODE + 'MS" ></div> </div>';
                                        }
                                        else {
                                            mm += ' <div class="col-xs-3 cols"><label class="col-md-5 control-label label">' + data[i].INFONAME + '</label><div class="col-md-5"><div class="input-group"><input type="text" class="form-control" id="' + fqid + data[i].INFOCODE + '" name="' + data[i].INFOCODE + '" rwfld="rwfld"  mdmtype="' + mdmtype + '"  mdmkey="' + data[i].MDMKEY + '\" mdmfieldname="' + data[i].FIELDNAME + '"></div></div> </div>';
                                        }
                                    } else {
                                        mm += ' <div class="col-xs-3 cols"><label class="col-md-5 control-label label">' + data[i].INFONAME + '</label><div class="col-md-5"><div class="input-group"><input type="text" class="form-control" id="' + fqid + data[i].INFOCODE + '" name="' + data[i].INFOCODE + '" rwfld="rwfld" > </div></div> </div>';
                                    }
                                }
                                mm = foo + mm + "</fieldset>";
                            }
                        });
                        text += html + mm;
                    }
                }
            });

            $("#EXTList").append(text);
            iCheckStyled();
            DisabledCtrl();
            //加载数据源
            BindAutocompleteMDM();
            var $span = $('<span class="input-group-addon"><i class="fa fa-calendar"></i></span>')
            //$("input[name='zjhbgrq']").addClass("datepicker").attr("data-dateformat", 'yy/mm/dd');
            $('input[name=zjhbgrq]').each(function () {
                if (!$(this).parent().hasClass("form_datetime")) {
                    $(this).parent().addClass("date form_datetime").append($span);
                    $(this).parent().datetimepicker({
                        minView: "month", //选择日期后，不会再跳转去选择时分秒 
                        language: 'zh-CN',
                        format: 'yyyy-mm-dd',
                        todayBtn: 1,
                        autoclose: 1,
                    });
                }
            })
        }

        hideServices();
    }
</script>
<div class="titlePanel">
    <div class="title-search">
        <table>
            <tr>
                <td style="padding-left: 2px;">
                    <input id="xy" type="text" class="form-control" placeholder="协议号" style="width: 110px;" />
                </td>
                <td style="padding-left: 2px;">
                    <input id="xyms" type="text" class="form-control" placeholder="协议描述" style="width: 110px;" />
                </td>
                <td style="padding-left: 2px;">
                    <input id="ywhb" mdmtype="MDMBP" mdmcode="ywhb" mdmkey="" mdmdesc="" type="text" class="form-control" placeholder="业务伙伴" style="width: 110px;" />
                </td>
                <td style="padding-left: 5px;">
                    <a id="btn_Search" class="btn btn-primary"><i class="fa fa-search"></i>&nbsp;查询</a>
                </td>
            </tr>
        </table>
    </div>
    <div class="toolbar">
        <div class="btn-group">
            <a id="seladd" class="btn btn-success" onclick="btn_add()"><i style="color:#FFF" class="fa fa-plus"></i>&nbsp;确定</a>
            <a id="selclear" class="btn btn-default" onclick="btn_clear()"><i class="fa fa-trash-o"></i>&nbsp;清空</a>
        </div>
    </div>
</div>
<div class="gridPanel" style="margin-left:4px;margin-bottom:2px;margin-top:4px;">
    <table id="gridTable"></table>
    <div id="gridPager"></div>
</div>
