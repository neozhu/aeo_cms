        function GetWebControlsForRadio(element) {
            var postdata = {};
            $(element).find('input,select,textarea').each(function (r) {
                var id = $(this).attr('id');
                var value = $(this).val();
                var type = $(this).attr('type');
                if ($(this).attr("mdmkey") == "") {
                    id = id.substring(0, id.length - 2);
                    var idc = id + "C";
                    $("#" + idc).val(value);
                    postdata[idc] = value;
                }
                postdata[id] = value;
            });
            postdata["MODIFYUSER"] = username;
            return postdata;
        }
        // 控件绑定数据源
        function BindAutocompleteMDM() {
            $("[mdmtype='MDM']").each(function () {
                if ($("#kyyf").val()) {
                    AutocompleteMDM($(this).attr("id"), "kygj");
                } else {
                    AutocompleteMDM($(this).attr("id"));
                }
            });
            $("[mdmtype='MDMJC']").each(function () {
                AutocompleteMDMJC($(this).attr("id"));
            });
            $("[mdmtype='MDMGK']").each(function () {
                AutocompleteMDMGK($(this).attr("id"));
            });
            $("[mdmtype='MDMBP']").each(function () {
                AutocompleteMDMBP($(this).attr("id"));
            });
            $("input").change(function () {
                $(this).css("background-color", "#FFFFCC");
            });
        }
        // input change监听 khy
        function BindInputChange() {
            $("#formmain").find("input,select").each(function () {
                if ($(this).attr("id") != "PURPRICE" && $(this).attr("id") != "COSTPRICE") {
                    $(this).bind("keyup", function (e) {
                        if (e.which != 13 && e.which != 40 && e.which != 38) {
                            GetPrice();
                        }
                    }).focus(function () {
                        $(this).select();
                        GetPrice();
                    }).change(function () {
                        GetPrice();
                    });
                }
            });
            // 返回成本
            function GetPrice() {
                if ($("#STARTDATE").val() == "" || $("#ENDDATE").val() == "") {
                    return false;
                }
                $.ajax({
                    url: '/SQM_PUR/GetPrice',
                    type: "Post",
                    dataType: "json",
                    async: false,
                    data: {
                        "postdata": JSON.stringify(GetWebControlsForCost("#formmain")),
                        "type": $("#khy").attr("khytype")
                    },
                    success: function (data) {
                        if (data.Success) {
                            $("#COSTPRICE").val(data.Message);
                            $("#PURPRICE").val(data.Message);
                            // 成本rid
                            $("#COSTRID").val(data.Data);
                            console.log($("#COSTRID").val(data.Data));
                        }
                    }
                });
            }
        }
        //计算基础数值长度校验
        function BindCalcVal(calccode, dataval) {
            var checkval = "";
            $.ajax({
                url: "@Url.Action("CheckData")",
                data: {
                    calccode: calccode,
                    dataval: dataval,
                },
                dataType: "json",
                async: false,
                success: function (data) {
                    checkval = JSON.stringify(data);
                }
            });
            return checkval;
        }
        function GetWebControlsForCost(element) {
            var postdata = {};
            $(element).find('input,select,textarea').each(function (r) {
                var volCode = $(this).attr("name");
                var value = $(this).val();
                if ($(this).attr("id") == "STARTDATE" || $(this).attr("id") == "ENDDATE") {
                    volCode = $(this).attr("id");
                } else if ($(this).attr("id") == "CURRENCY") {
                    volCode = "BZ";
                }
                postdata[volCode] = value;
            });
            return postdata;
        }
    </script>
