        //计算基础字段展示
        function getCalcname(key, gdzrid) {
            var gdzkey = '';
            var djfsrid = $("#DJFSRID").val();
            if (djfsrid == undefined) {
                djfsrid = '';
            }
            if (gdzrid == undefined || gdzrid == null) {
                gdzrid = '';
            }
            if (key == 2) {
                gdzkey = $("#GDZKEY").val();
            }
            location.href = '/SQM_PUR/PurEdit?djrid=' + "@ViewBag.djrid" + '&djfsrid=' + djfsrid + '&gdzkey=' + gdzkey + '&gdzrid=' + gdzrid;
        }
