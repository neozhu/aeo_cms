                                setTimeout(function () { location.href = "/SQM_PUR/PurIndex?djrid=" + "@ViewBag.djrid" + "&gdzkey=" + gdzkey + "&gdzrid=" + gdzrid + "&djfsrid=" + djfsrid + "&djfs=" + "@ViewBag.djfs" + "&sign=q" }, 200);
