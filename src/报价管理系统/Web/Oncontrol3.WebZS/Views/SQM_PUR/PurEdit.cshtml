@{
    ViewBag.Title = "定价维护";
    Layout = "~/Views/Shared/_LayoutTM.cshtml";
}
@model Com.Feiliks.QDM.SQM_MODEDJ_VAL
@{
    bool gyl = @ViewBag.gyl;
    bool khy = @ViewBag.khy;
    bool min = @ViewBag.min;
    System.Data.DataTable FCREFdt = (System.Data.DataTable)ViewBag.FCREFData;
    System.Data.DataTable GDZdt = (System.Data.DataTable)ViewBag.GDZdt;
    System.Data.DataTable GDZDATAdt = (System.Data.DataTable)ViewBag.GDZDATAdt;
    System.Data.DataTable JSJCdt = (System.Data.DataTable)ViewBag.JSJCdt;
    System.Data.DataTable DJFSdt = (System.Data.DataTable)ViewBag.DJFSData;
    System.Data.DataTable BZdt = (System.Data.DataTable)ViewBag.BZdtData;
}
<style type="text/css">
    .smart-form * {
        box-sizing: inherit;
    }

    .smart-form .row {
        margin: 0;
        width: 25%;
        float: left;
        height: 85px;
    }

    .smart-form .col-3 {
        width: 100%;
    }

    .select2 {
        width: 314%;
    }

    .service_lb .checkbox {
        width: 8%;
    }

    .label {
        text-align: center;
        margin-top: 10px;
    }

    .cols {
        margin-bottom: 20px;
    }

    .service_lb .checkbox {
        width: 8%;
    }

    .margin_left {
        margin-left: 5px;
    }

    .form-backgroud {
        background: #9393FF;
    }

    .form-control {
        padding-left: 2px;
    }

    .smart-form header {
        clear: both;
        background: #FBFBFF;
    }

    /*表格begin*/
    .grid {
        margin: 0px;
        border-collapse: collapse;
        table-layout: fixed;
    }

        .grid thead td {
            border-top: 1px solid #ccc;
            border-left: 1px solid #ccc;
            border-right: 1px solid #ccc;
            border-bottom: 1px solid #ccc;
            text-align: left;
            text-overflow: ellipsis;
            font-weight: normal;
            word-break: keep-all;
            overflow: hidden;
            background-color: #F7F7F7;
        }

            .grid thead td .table-header {
                padding: 6px 2px;
                background-color: #F2F2F2;
                background: -webkit-linear-gradient(top,#ffffff 0,#F2F2F2 100%);
                background: -moz-linear-gradient(top,#ffffff 0,#F2F2F2 100%);
                background: -o-linear-gradient(top,#ffffff 0,#F2F2F2 100%);
                background: linear-gradient(to bottom,#ffffff 0,#F2F2F2 100%);
                background-repeat: repeat-x;
                filter: progid:DXImageTransform.Microsoft.gradient(startColorstr=#ffffff,endColorstr=#F2F2F2,GradientType=0);
            }

        .grid tbody td {
            text-align: left;
            border-bottom: 1px solid #ccc;
            border-left: 1px solid #ccc;
            border-right: 1px solid #ccc;
            height: 22px;
            word-break: break-all;
        }

        .grid .txt {
            border: 0px solid #fff;
            padding: 0px;
            height: 22px;
            line-height: 22px;
            width: 100%;
            font-family: Consolas,微软雅黑,宋体,Arial,Helvetica,Verdana,sans-serif;
            font-size: 9pt;
            color: #000000;
        }

        .grid .disabled {
            background-color: #F7F7F7;
        }

        .grid .txtselect {
            border: 0px solid #fff;
            height: 22px;
            line-height: 22px;
            display: inline-block;
            width: 100%;
            font-family: Consolas,微软雅黑,宋体,Arial,Helvetica,Verdana,sans-serif;
            font-size: 9pt;
            color: #000000;
        }

        .grid .td-div {
            background-color: #F7F7F7;
            color: #222;
            cursor: pointer;
        }

        .grid td img {
            vertical-align: middle;
            border: 0px solid #fff;
        }

        .grid tbody .selected {
            background-color: #6DA47D;
            color: #fff;
            cursor: pointer;
        }

        .grid tbody .tdhover {
            background-color: #eee;
            cursor: pointer;
        }

        .grid .tdwarning {
            border-bottom: 1px solid #E74D3C;
        }

    .groupgrid {
        margin: 0px;
        border-collapse: collapse;
        table-layout: fixed;
    }

        .groupgrid thead td {
            border-bottom: 1px solid #ccc;
            text-align: left;
            padding: 6px 2px;
            color: #666;
            font-weight: bold;
            background-color: #F7F7F7;
        }

        .groupgrid tbody td {
            text-align: left;
            border-bottom: 1px solid #ccc;
            padding: 5px 2px;
            word-break: break-all;
        }

            .groupgrid tbody td img {
                vertical-align: middle;
                border: 0px solid #fff;
            }

            .groupgrid tbody td .grouptitle {
                float: left;
                font-weight: bold;
            }

        .groupgrid tbody .active {
            background-color: #6DA47D;
            color: #fff;
            cursor: pointer;
        }

        .groupgrid tbody .tdhover {
            background-color: #eee;
            cursor: pointer;
        }
    /*表格end*/
    .input-button {
        font-weight: bolder;
        border: none;
        right: -2px;
        top: 50%;
        width: 14px;
        height: 16px;
        margin-top: -10px;
        cursor: pointer;
        overflow: hidden;
        position: absolute;
        z-index: 100;
    }

    .input-link {
        font-weight: bolder;
        border: none;
        top: 50%;
        width: 16px;
        height: 16px;
        margin-top: -10px;
        cursor: pointer;
        overflow: hidden;
        position: absolute;
        z-index: 100;
    }

    .bpdescription {
        width: 60px;
        text-overflow: ellipsis;
        overflow: hidden;
        white-space: nowrap;
    }

    .icheckbox_square-blue {
        zoom: 76%;
    }

    .cols {
        margin-bottom: 10px;
    }

    .smart-form fieldset {
        padding: 8px 14px 26px;
        background: #fafafa;
    }

    .smart-form footer {
        background: #fafafa;
    }

    .cdinvalid {
        display: block;
        margin-top: 6px;
        padding: 0 1px;
        font-style: normal;
        font-size: 11px;
        line-height: 15px;
        color: #d56161;
    }
</style>
<div id="content">
    <section id="widget-grid" class="">
        <div class="row">
            <article class="col-sm-12 col-md-12 col-lg-12 sortable-grid ui-sortable">
                <div class="jarviswidget jarviswidget-sortable" data-widget-colorbutton="false" data-widget-editbutton="false" data-widget-custombutton="false">
                    <header>
                        <input id="khy" value="@ViewBag.khy" khytype="@ViewBag.tbtitle" type="hidden" />
                        <input id="gyl" value="@ViewBag.gyl" type="hidden" />
                        <input id="min" value="@ViewBag.min" type="hidden" />
                        <input id="kyyf" value="@ViewBag.kyyf" khytype="@ViewBag.tbtitle" type="hidden" />
                        <span class="widget-icon"><i class="fa fa-edit"></i></span>
                        <h2>@ViewBag.tbtitle/<span style="color:#ffd600!important">定价维护</span></h2>
                        <div style="float:right;">
                            <button type="submit" class="btn btn-primary" id="btnSave" onclick="dosave(); return false;">
                                保存
                            </button>
                            <button type="submit" class="btn btn-default" id="btnback" onclick="back()">
                                返回
                            </button>
                        </div>
                    </header>
                    <div role="content">
                        <div class="jarviswidget-editbox"></div>
                        <div class="widget-body no-padding">
                            <form id="formmain" class="smart-form form-backgroud">
                                <fieldset>
                                    <input type="hidden" value="@Model.RID" id="RID" />
                                    <input type="hidden" value="" id="COSTRID" />
                                    @for (int i = 0; i < FCREFdt.Rows.Count; i++)
                                    {
                                        if ((String)FCREFdt.Rows[i]["CALCCODE"] == "ZKHR" || (String)FCREFdt.Rows[i]["CALCCODE"] == "ZKHRQ")
                                        {
                                            <div class="row">
                                                <section class="col col-3">
                                                    <label class="label">@FCREFdt.Rows[i]["CALCNAME"]<i style="color:red">*</i></label>
                                                    <label class="input">
                                                        <select style="width:100%" id="@FCREFdt.Rows[i]["VALCOL"]" name="@FCREFdt.Rows[i]["CALCCODE"]" class="select2">
                                                            <option value="MON">MON</option>
                                                            <option value="TUE">TUE</option>
                                                            <option value="WED">WED</option>
                                                            <option value="THU">THU</option>
                                                            <option value="FRI">FRI</option>
                                                            <option value="SAT">SAT</option>
                                                            <option value="SUN">SUN</option>
                                                        </select>
                                                    </label>
                                                </section>
                                            </div>
                                        }
                                        @*else if ((String)FCREFdt.Rows[i]["CALCCODE"] == "YZL")
                                        {
                                            <div class="row">
                                                <section class="col col-3">
                                                    <label class="label">@FCREFdt.Rows[i]["CALCNAME"]<i style="color:red">*</i></label>
                                                    <label class="input">
                                                        <select style="width:100%" id="@FCREFdt.Rows[i]["VALCOL"]" name="@FCREFdt.Rows[i]["CALCCODE"]" class="select2">
                                                            <option value="0-45KG">0-45KG</option>
                                                            <option value="+45KG">+45KG</option>
                                                            <option value="+100KG">+100KG</option>
                                                            <option value="+500KG">+500KG</option>
                                                            <option value="+1000KG">+1000KG</option>
                                                        </select>
                                                    </label>
                                                </section>
                                            </div>
                                        }*@
                                        else if ((String)FCREFdt.Rows[i]["CALCCODE"] == "ZHWLB")
                                        {
                                            <div class="row">
                                                <section class="col col-3">
                                                    <label class="label">@FCREFdt.Rows[i]["CALCNAME"]<i style="color:red">*</i></label>
                                                    <label class="input">
                                                        <select style="width:100%" id="@FCREFdt.Rows[i]["VALCOL"]" name="@FCREFdt.Rows[i]["CALCCODE"]" class="select2">
                                                            <option value="普货">普货</option>
                                                            <option value="危险品">危险品</option>
                                                            <option value="冻品">冻品</option>
                                                            <option value="A">A</option>
                                                            <option value="B">B</option>
                                                            <option value="C">C</option>
                                                            <option value="D">D</option>
                                                            <option value="E">E</option>
                                                            <option value="H">H</option>
                                                            <option value="G">G</option>
                                                        </select>
                                                    </label>
                                                </section>
                                            </div>
                                        }
                                        else if (!(FCREFdt.Rows[i]["CALCTYPE"] is System.DBNull) && (String)FCREFdt.Rows[i]["CALCTYPE"] == "X")
                                        {
                                            <div class="row">
                                                <section class="col col-3">
                                                    <input type="hidden" id="@FCREFdt.Rows[i]["VALCOL"]" />
                                                    <input type="hidden" id="@FCREFdt.Rows[i]["VALCOL"]C" />
                                                    <label class="label">@FCREFdt.Rows[i]["CALCNAME"]<i style="color:red">*</i></label>
                                                    <label class="input">
                                                        <select style="width:100%" id="@FCREFdt.Rows[i]["VALCOL"]ZS" name="@FCREFdt.Rows[i]["CALCCODE"]" class="select2" mdmkey>
                                                            <option value="">空</option>
                                                            <option value="X">X</option>
                                                        </select>
                                                    </label>
                                                </section>
                                            </div>
                                        }
                                        else if (!(FCREFdt.Rows[i]["CALCTYPE"] is System.DBNull) && (String)FCREFdt.Rows[i]["CALCTYPE"] == "Y")
                                        {
                                            <div class="row">
                                                <section class="col col-3">
                                                    <input type="hidden" id="@FCREFdt.Rows[i]["VALCOL"]" />
                                                    <input type="hidden" id="@FCREFdt.Rows[i]["VALCOL"]C" />
                                                    <label class="label">@FCREFdt.Rows[i]["CALCNAME"]<i style="color:red">*</i></label>
                                                    <label class="input">
                                                        <select style="width:100%" id="@FCREFdt.Rows[i]["VALCOL"]ZS" name="@FCREFdt.Rows[i]["CALCCODE"]" class="select2" mdmkey>
                                                            <option value="Y">Y</option>
                                                            <option value="N">N</option>
                                                        </select>
                                                    </label>
                                                </section>
                                            </div>
                                        }
                                        else if ((String)FCREFdt.Rows[i]["CALCCODE"] == "ZSKB")
                                        {
                                            <div class="row">
                                                <section class="col col-3">
                                                    <label class="label">@FCREFdt.Rows[i]["CALCNAME"]<i style="color:red">*</i></label>
                                                    <label class="input">
                                                        <input type="text" class="form-control" id="@FCREFdt.Rows[i]["VALCOL"]" name="@FCREFdt.Rows[i]["CALCCODE"]" placeholder="格式：15:30" required>
                                                    </label>
                                                </section>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="row">
                                                <section class="col col-3">
                                                    <label class="label">@FCREFdt.Rows[i]["CALCNAME"]<i style="color:red">*</i></label>
                                                    <label class="input">
                                                        <input type="hidden" id="@FCREFdt.Rows[i]["VALCOL"]" />
                                                        <input type="hidden" id="@FCREFdt.Rows[i]["VALCOL"]C" />
                                                        <input type="text" class="form-control" id="@FCREFdt.Rows[i]["VALCOL"]ZS" name="@FCREFdt.Rows[i]["CALCCODE"]" mdmtype="@FCREFdt.Rows[i]["MDMTYPE"]" mdmkey="@FCREFdt.Rows[i]["MDMKEY"]" mdmfieldname="@FCREFdt.Rows[i]["MDMFIELDNAME"]" mdmloctype="@FCREFdt.Rows[i]["MDMLOCTYPE"]" datalen="datalen" required>
                                                    </label>
                                                </section>
                                            </div>
                                        }
                                    }
                                    @if (DJFSdt != null && DJFSdt.Rows.Count > 0 && !String.IsNullOrEmpty(DJFSdt.Rows[0]["DJFSRID"].ToString()))
                                    {
                                        <div class="row">
                                            <section class="col col-3">
                                                <label class="label">定价方式</label>
                                                <label class="input">
                                                    <select style="width:100%" id="DJFSRID" name="DJFSRID" class="select2">
                                                        <option></option>
                                                        @for (int i = 0; i < DJFSdt.Rows.Count; i++)
                                                        {
                                                            <option value="@DJFSdt.Rows[i]["DJFSRID"]">@DJFSdt.Rows[i]["DJFSNAME"]</option>
                                                        }
                                                    </select>
                                                </label>
                                            </section>
                                        </div>
                                    }
                                    @if (GDZdt != null && GDZdt.Rows.Count > 0 && !String.IsNullOrEmpty(GDZdt.Rows[0]["GDZKEY"].ToString()))
                                    {
                                        <div class="row">
                                            <section class="col col-3">
                                                <label class="label">高低值比较</label>
                                                <label class="input">
                                                    <select style="width:100%" id="GDZKEY" name="GDZKEY" class="select2">
                                                        @for (int i = 0; i < GDZdt.Rows.Count; i++)
                                                        {
                                                            <option value="@GDZdt.Rows[i]["GDZKEY"]">@GDZdt.Rows[i]["GDZKEYNAME"]</option>
                                                        }
                                                    </select>
                                                </label>
                                            </section>
                                        </div>
                                    }
                                    @if (GDZDATAdt != null && GDZDATAdt.Rows.Count > 0 && !String.IsNullOrEmpty(GDZDATAdt.Rows[0]["GDZRID"].ToString()))
                                    {
                                        <div class="row gdzdiv">
                                            <section class="col col-3">
                                                <label class="label">高低值</label>
                                                <label class="input">
                                                    <select style="width:100%" id="GDZRID" name="GDZRID" class="select2">
                                                        @for (int i = 0; i < GDZDATAdt.Rows.Count; i++)
                                                        {
                                                            <option value="@GDZDATAdt.Rows[i]["GDZRID"]">@GDZDATAdt.Rows[i]["GDZNAME"]</option>
                                                        }
                                                    </select>
                                                </label>
                                            </section>
                                        </div>
                                    }
                                    <div class="row">
                                        <section class="col col-3">
                                            <label class="label">计算方式</label>
                                            <label class="input">
                                                <select style="width:100%" id="CALCTYPE" name="CALCTYPE" class="select2">
                                                    <option value="B">相对值</option>
                                                    <option value="A">绝对值</option>
                                                </select>
                                            </label>
                                        </section>
                                    </div>
                                    <div class="row">
                                        <section class="col col-3">
                                            <label class="label">计费单位</label>
                                            <label class="input">
                                                <input type="text" class="form-control" id="CALCUNIT" name="CALCUNIT" disabled="disabled">
                                            </label>
                                        </section>
                                    </div>
                                    @if (gyl)
                                    {
                                        <div class="row">
                                            <section class="col col-3">
                                                <label class="label">计算基础</label>
                                                <label class="input">
                                                    <select style="width:100%" id="CALCCODE" name="CALCCODE" class="select2">
                                                        @for (int i = 0; i < JSJCdt.Rows.Count; i++)
                                                        {
                                                            <option value="@JSJCdt.Rows[i]["CALCCODE"]">@JSJCdt.Rows[i]["CALCNAME"]</option>
                                                        }
                                                    </select>
                                                </label>
                                            </section>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="row">
                                            <section class="col col-3">
                                                <label class="label">币种</label>
                                                <label class="input">
                                                    @*<input type="text" class="form-control" id="CURRENCY" name="CURRENCY" mdmtype="MDM" mdmkey="WAERS" mdmfieldname="WAERS,KTEXT" mdmcode="BZCODE">*@
                                                    <select style="width:100%" id="CURRENCY" name="CURRENCY" class="select2">
                                                        @for (int i = 0; i < BZdt.Rows.Count; i++)
                                                        {
                                                            <option value="@BZdt.Rows[i]["WAERS"]">@BZdt.Rows[i]["KTEXT"]--@BZdt.Rows[i]["WAERS"]</option>
                                                        }
                                                    </select>
                                                </label>
                                            </section>
                                        </div>
                                    }
                                    @if (min)
                                    {
                                        <div class="row">
                                            <section class="col col-3">
                                                <label class="label">MIN<i style="color:red">*</i></label>
                                                <label class="input">
                                                    <input type="text" class="form-control" id="MIN" name="MIN" distype="price" value="@ViewBag.mindata">
                                                </label>
                                            </section>
                                        </div>
                                    }
                                    <div class="row">
                                        <section class="col col-3">
                                            <label class="label">采购价<i style="color:red">*</i></label>
                                            <label class="input">
                                                @if (false)
                                                {
                                                    <input type="text" class="form-control" id="PURPRICE" name="PURPRICE" value="@Model.PURPRICE" disabled="disabled" placeholder="成本管理维护">
                                                }
                                                else
                                                {
                                                    <input type="text" class="form-control" id="PURPRICE" name="PURPRICE" distype="price">
                                                }
                                            </label>
                                        </section>
                                    </div>
                                    <div class="row">
                                        <section class="col col-3">
                                            <label class="label">成本价<i style="color:red">*</i></label>
                                            <label class="input">
                                                @if (false)
                                                {
                                                    <input type="text" class="form-control" id="COSTPRICE" name="COSTPRICE" disabled="disabled" placeholder="成本管理维护">
                                                }
                                                else
                                                {
                                                    <input type="text" class="form-control" id="COSTPRICE" name="COSTPRICE" distype="price">
                                                }
                                            </label>
                                        </section>
                                    </div>
                                    <div class="row">
                                        <section class="col col-3">
                                            <label class="label">最高价<i style="color:red">*</i></label>
                                            <label class="input">
                                                <input type="text" class="form-control" id="MAXPRICE" name="MAXPRICE" distype="price">
                                            </label>
                                        </section>
                                    </div>
                                    <div class="row">
                                        <section class="col col-3">
                                            <label class="label">最低价<i style="color:red">*</i></label>
                                            <label class="input">
                                                <input type="text" class="form-control" id="MINPRICE" name="MINPRICE" distype="price">
                                            </label>
                                        </section>
                                    </div>
                                    <div class="row">
                                        <section class="col col-3">
                                            <label class="label">指导价<i style="color:red">*</i></label>
                                            <label class="input">
                                                <input type="text" class="form-control" id="GUIDEPRICE" name="GUIDEPRICE" distype="price">
                                            </label>
                                        </section>
                                    </div>
                                    <div class="row">
                                        <section class="col col-3">
                                            <label class="label">起始日期<i style="color:red">*</i></label>
                                            <label class="input">
                                                <div class="input-group date">
                                                    <input class="form-control form-date" type="text" id="STARTDATE" name="STARTDATE" readonly="readonly">
                                                    <span class="input-group-addon"><i class="fa fa-calendar"></i></span>
                                                </div>
                                                @*<div class="input-group date form-date">
                                                        <input class="form-control" type="text">
                                                        <span class="input-group-addon"><i class="fa fa-calendar"></i></span>
                                                    </div>*@
                                            </label>
                                        </section>
                                    </div>
                                    <div class="row">
                                        <section class="col col-3">
                                            <label class="label">截止日期</label>
                                            <label class="input">
                                                <div class="input-group date">
                                                    <input class="form-control form-date" type="text" id="ENDDATE" name="ENDDATE" readonly="readonly" placeholder="默认为:9999/12/31">
                                                    <span class="input-group-addon"><i class="fa fa-calendar"></i></span>
                                                </div>
                                            </label>
                                        </section>
                                        @*<section class="col col-3" style="margin-top: 32px;">
                                                <label class="col-md-3 label">状态</label>
                                                <label class="radio-inline" style="padding:10px;"><input type="radio" checked class="radiobox" name="STATUS" value="1"><span>有效</span></label>
                                                <label class="radio-inline"><input type="radio" class="radiobox" name="STATUS" value="0"><span>无效</span></label>
                                            </section>*@
                                    </div>
                                    <div class="row" style="width: 98%;margin:0px 15px;">
                                        <section>
                                            <label class="label">备注</label>
                                            <label class="textarea">
                                                <i class="icon-append fa fa-comment"></i>
                                                <textarea rows="4" name="MEMO" id="MEMO" distype="price"></textarea>
                                            </label>
                                        </section>
                                    </div>
                                </fieldset>
                                <footer>
                                    <button id="bottomSave" class="btn btn-primary" onclick="dosave(); return false;">
                                        保存
                                    </button>
                                </footer>
                            </form>
                        </div>
                    </div>
                </div>
            </article>
        </div>
    </section>
</div>
@section pagespecific {
    <script src="~/Content/QO/scripts/framework.js?v=@DateTime.Now.ToString("yyyyMMddhhmmss")"></script>
    <script src="~/Content/QO/scripts/Ewin.js"></script>
    <script src="~/Content/QO/toastr/toastr.min.js"></script>
    <link rel="stylesheet" href="~/Content/QO/toastr/toastr.min.css">
