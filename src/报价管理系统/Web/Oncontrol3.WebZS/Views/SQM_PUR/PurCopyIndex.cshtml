@{
    Layout = "~/Views/Shared/_LayoutTM.cshtml";
}
@{
    System.Data.DataTable prodt = (System.Data.DataTable)ViewBag.ProData;
    System.Data.DataTable serdt = (System.Data.DataTable)ViewBag.SerData;
}
<!-- MAIN CONTENT -->
<style>
    /*表格end*/
    #datatable_col_reordercop td {
        white-space: nowrap;
    }

    #datatable_col_reordercop th {
        white-space: nowrap;
    }

    .widget-body {
        min-height: 0px !important;
    }

    #copform1 .row {
        width: 100%;
    }

        #copform1 .row .col-3 {
            width: 50%;
        }
</style>
<div id="contentcop">
    <section id="widget-gridcop" class="">
        <div class="row">
            <article class="col-sm-12 col-md-12 col-lg-12 sortable-grid ui-sortable">
                <div class="jarviswidget jarviswidget-sortable" data-widget-colorbutton="false" data-widget-editbutton="false" data-widget-custombutton="false">
                    <header>
                        @*<span class="widget-icon"> <i class="fa fa-edit"></i> </span>*@
                        <div style="float:right; ">
                            <button type="submit" class="btn btn-success purcopy">复制</button>
                            <button type="submit" id="submit_searchcop" class="btn btn-default">查询</button>
                            <button type="submit" class="btn btn-default" onclick="CopReset();">重置</button>
                        </div>
                    </header>
                    <!-- widget div-->
                    <div role="content">
                        <!-- end widget edit box -->
                        <div class="jarviswidget-editbox"></div>
                        <div class="widget-body">
                            <form id="copform1" class="smart-form form-backgroud">
                                <div class="row">
                                    <section class="col col-3">
                                        <label class="input">
                                            <select style="width:100%" id="PRODUCTKEY" name="PRODUCTKEY" class="select2" placeholder="产品">
                                                <option value=""></option>
                                                @for (int i = 0; i < prodt.Rows.Count; i++)
                                                {
                                                    <option value="@prodt.Rows[i]["PRODUCTKEY"]">@prodt.Rows[i]["SQPRODUCTNAME"]--@prodt.Rows[i]["PRODUCTKEY"]</option>
                                                }
                                            </select>
                                        </label>
                                    </section>
                                    <section class="col col-3">
                                        <label class="input">
                                            <select style="width:100%" id="SERVICETYPE" name="SERVICETYPE" class="select2" placeholder="服务">
                                                <option value=""></option>
                                                @for (int i = 0; i < serdt.Rows.Count; i++)
                                                {
                                                    <option value="@serdt.Rows[i]["SERVICETYPE"]">@serdt.Rows[i]["SERVICENAME"]--@serdt.Rows[i]["SERVICETYPE"]</option>
                                                }
                                            </select>
                                        </label>
                                    </section>
                                </div>
                            </form>
                        </div>
                        <!-- widget content -->
                        <div class="widget-body no-padding">
                            <table id="datatable_col_reordercop" class="table table-striped table-bordered table-hover" style="width:100%;"></table>
                        </div>
                        <!-- end widget content -->
                    </div>
                </div>
            </article>
        </div>
    </section>
</div>
@section pagespecific {
    <script type="text/javascript">
        var dataval = [];// 保存table数据
        toastr.options = {
            closeButton: false,
            debug: false,
            progressBar: true,
            positionClass: "toast-top-center",
            onclick: null,
            showDuration: "300",
            hideDuration: "1000",
            timeOut: "3000",
            extendedTimeOut: "1000",
            showEasing: "swing",
            hideEasing: "linear",
            showMethod: "fadeIn",
            hideMethod: "fadeOut"
        };
        //查询
        $("#submit_searchcop").click(function () {
            $('#datatable_col_reordercop').DataTable().search("").draw();
            return false;
        });
        //复制
        $(".purcopy").click(function () {
            toastr.clear();
            toastr.remove();
            //判断是否勾选需要复制的项
            var ifcop = CheckIfCop();
            var ifcopstr = JSON.stringify(ifcop);
            if (ifcopstr.indexOf('\"1\"') == -1) {
                toastr.error("请选择需要复制的项");
                return false;
            }
            $.ajax({
                url: "@Url.Action("IfPurCopy")",
                type: "Post",
                data: {
                    "dataval": JSON.stringify(dataval),
                    "ifcop": ifcopstr,
                },
                dataType: "json",
                success: function (data) {
                    if (data.Success) {
                        if (data.Code == "1") {
                            dodjfz(data.Message);
                        } else {
                            //popDialog("提示", "所选产品服务费目已有定价，是否覆盖？", dodjfz(data.Message), nodjfz);
                            dodjfz(data.Message);
                        }
                    } else {
                        toastr.error(data.Message);
                    }
                },
                error: function (data) {
                    if (!!data.responseText) {
                        alert(data.responseText);
                    } else {
                        window.alert("请求失败！");
                    }
                }
            });
        });
        $(document).ready(function () {
            //列定义
            var columns = [
                {
                    "title": "<input type='checkbox' name='checkRowCops' onclick='copcheckAll()' />", "width": "10", "sortable": false,
                    render: function (data, type, row, meta) {
                        return "<input type='checkbox' name='copcheckBox' onclick='checkOne()' value='" + row.PRODUCTKEY + "'/>";
                    }
                },
                { "title": "事业部", "data": "BUSINESSORG", "sClass": "hidden" },
                { "title": "产品", "orderable": false, "data": "SQPRODUCTNAME", "width": "150" },
                { "title": "产品代码", "data": "PRODUCTKEY", "sClass": "hidden" },
                { "title": "服务", "orderable": false, "data": "SERVICENAME", "width": "100" },
                { "title": "服务代码", "data": "SERVICETYPE", "sClass": "hidden" },
                { "title": "费目", "orderable": false, "data": "TEXTDESC", "width": "150" },
                { "title": "费目代码", "data": "TCET084", "sClass": "hidden" },
            ];
            var table = $('#datatable_col_reordercop').dataTable({
                "scrollY": "300px",
                "scrollCollapse": "true",
                "paging": "false",
                "processing": true,
                "serverSide": true,
                "autoWidth": true,
                "scrollX": true,
                "order": [[0, "asc"]],
                "fnDrawCallback": function () {
                    checkOne();
                    // 保存datatable所有数据
                    var nTrs = table.fnGetNodes();
                    dataval = [];
                    for (var i = 0; i < nTrs.length; i++) {
                        dataval.push(table.fnGetData(nTrs[i]));
                    }
                },
                "language": { "info": "Total : _TOTAL_", "paginate": { "first": "<<", "last": ">>", "next": ">", "previous": "<" } },//语言
                "sDom": "<'dt-toolbar'<'col-xs-12 col-sm-6'><'col-sm-6 col-xs-12 hidden-xs'>r>" + "t" +
                    "<'dt-toolbar-footer'<'col-sm-6 col-xs-12 hidden-xs'i><'col-xs-12 col-sm-6'pl>>",//整个griddom布局
                "lengthMenu": [[50, 100], [50, 100]],//每页显示key text
                "displayLength": 50,//默认每页显示条目数
                "ajax": {
                    "url": "@Url.Action("PurCopyLists")",//数据源controller
                    "type": "POST",
                    "data": function (d) {//查询参数
                        d.sort = d.columns[d.order[0].column].data;//排序列名转换
                        d.order = d.order[0].dir;//asc or desc
                        d.PRODUCTKEY = $("#PRODUCTKEY").val();
                        d.SERVICETYPE = $("#SERVICETYPE").val();
                        d.FEECODE = "@ViewBag.feecode";
                        d.PRDCODE = "@ViewBag.prdcode";
                    }
                }, columns: columns
            });
        });
        //复制
        function dodjfz(coppsfrids) {
            toastr.clear();
            toastr.remove();
            $.ajax({
                type: 'POST',
                url: "/SQM_PUR/PurCopy",
                data: {
                    DJRID: "@ViewBag.djrid",
                    COPPSFRIDS: coppsfrids,
                },
                dataType: "json",
                success: function (data) {
                    if (data.Success) {
                        toastr.success(data.Message);
                        $("#djfzAdd").modal("hide");
                        $(".modal-backdrop").hide();
                    } else {
                        toastr.error(data.Message);
                    }
                },
                error: function (data) {
                    if (!!data.responseText) {
                        alert(data.responseText);
                    } else {
                        window.alert("请求失败！");
                    }
                }
            });
        }
        function copcheckAll() {
            if ($("input[name = 'checkRowCops']").is(":checked")) {
                $("input[name = 'copcheckBox']").each(function () {
                    if ($(this).is(":unchecked")) {
                        $(this).prop("checked", true);
                    }
                });
            } else if ($("input[name='checkRowCops']").is(":unchecked")) {
                $("input[name='copcheckBox']").each(function () {
                    if ($(this).is(":checked")) {
                        $(this).prop("checked", false);
                    }
                });
            }
        }
        function checkOne() {
            var unchecked = 0;
            $("input[name ='copcheckBox']").each(function (i) {
                if ($(this).is(":unchecked")) {
                    unchecked++;
                }
            });
            if (unchecked > 0) {
                $("input[name='checkRowCops']").prop("checked", false);
            }
            else if (unchecked == 0 && $("input[name='checkRowCops']").is(":unchecked")) {
                $("input[name='checkRowCops']").prop("checked", true);
            }
        }
        //复制的项
        function CheckIfCop() {
            var obj = {};
            $("input[name='copcheckBox']").each(function () {
                if ($(this).is(":checked")) {
                    obj[$(this).val()] = "1";
                } else {
                    obj[$(this).val()] = "0";
                }
            });
            return obj;
        }
        // 重置查询条件
        function CopReset() {
            // 清空查询控件
            $("#copform1").find("select").each(function () {
                $(this).select2("val", "");
            });
            // 刷新页面
            $('#datatable_col_reordercop').DataTable().search("").draw();
            return false;
        }
    </script>
}