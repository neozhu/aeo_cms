@{
    ViewBag.Title = "DatePicker";
    Layout = "~/Views/Shared/_IndexDYXY.cshtml";
}
<script>
    var p_key = "";
    var has_id = "";
    var hashref = "";
    function GetQueryString(name) {
        var reg = new RegExp("(^|&)" + name + "=([^&]*)(&|$)");
        var r = window.location.search.substr(1).match(reg);
        if (r != null) return unescape(r[2]); return null;
    }

    $(document).ready(function () {
        p_key = "@ViewData["p_key"]";
        has_id = "@ViewData["has_id"]";
    });

    $(function () {
        InitialPage();
        GetGrid();
        $("#gridPager_right").hide();
    });
    //初始化页面
    function InitialPage() {
        //resize重设(表格、树形)宽高
        $(window).resize(function (e) {
            window.setTimeout(function () {
                $('#gridTable').setGridWidth(($('.gridPanel').width()));
                $("#gridTable").setGridHeight($(window).height() - 136.5);
            }, 200);
            e.stopPropagation();
        });
    }
    //加载表格
    function GetGrid() {
        var selectedRowIndex = 0;
        var $gridTable = $('#gridTable');
        $gridTable.jqGrid({
            url: "/DatePicker/Service_ProCode_Lists?has_id=" + has_id + "",
            datatype: "json",
            height: $(window).height() - 136.5,
            autowidth: true,
            colModel: [
                { label: '代码', name: 'Service_Product_Id', index: 'Service_Product_Id', width: 120, align: 'left' },
                { label: '名称', name: 'Service_Product_Name', index: 'Service_Product_Name', width: 400, align: 'left' },
            ],
            viewrecords: true,
            multiselect: true,
            rowNum: 20,
            rowList: [20, 50, 100],
            pager: "#gridPager",
            sortname: 'Service_Product_Id asc,Service_Product_Name desc',
            rownumbers: true,
            shrinkToFit: false,
            gridview: true,
            onSelectRow: function () {
                selectedRowIndex = $("#" + this.id).getGridParam('selrow');
            },
            gridComplete: function () {
                $("#" + this.id).setSelection(selectedRowIndex, false);
            }
        });
        //查询事件
        $("#btn_Search").click(function () {
            var queryJson = {
                "Search_data": $("#Search_data").val()
            }
            $gridTable.jqGrid('setGridParam', {
                postData: { queryJson: JSON.stringify(queryJson) }, page: 1
            }).trigger('reloadGrid');
        });
        //查询回车
        $('#Search_data').bind('keypress', function (event) {
            if (event.keyCode == "13") {
                $('#btn_Search').trigger("click");
            }
        });
    }

    function btn_add() {
        var keyValue = $("#gridTable").jqGridRowValue("Service_Product_Id").replace(/\s/g, "");
        var hasvalue = window.$(".dlc input[p_key='" + p_key + "']").val();
        var newvalue = "";
        hashref = window.$(".dlc a[p_key='" + p_key + "']").attr("href");
        if (hashref.indexOf("&") > 0) {
            hashref = hashref.substring(0, hashref.indexOf("&"));
        }
        var newhref = "";
        if (hasvalue.length > 0) {
            newvalue = hasvalue + "," + keyValue;
        } else {
            newvalue = keyValue;
        }
        if (keyValue) {
            if (p_key != undefined && p_key != null && p_key.toString().length >= 1) {
                window.$(".dlc a[p_key='" + p_key + "']").attr("href", hashref);
                window.$(".dlc input[p_key='" + p_key + "']").val(newvalue);
                newhref = hashref + "&has_id=" + newvalue + "";
                window.$(".dlc a[p_key='" + p_key + "']").attr("href", newhref);
            }
            $("#myModalFWA").modal('hide');
        } else {
            layer.msg('请选择需要添加的BP！');
        }
    }
    function btn_clear() {
        hashref = window.$(".dlc a[p_key='" + p_key + "']").attr("href");
        if (hashref.indexOf("&") > 0) {
            hashref = hashref.substring(0, hashref.indexOf("&"));
        }
        if (p_key != undefined && p_key != null && p_key.toString().length >= 1) {
            window.$(".dlc a[p_key='" + p_key + "']").attr("href", hashref);
            window.$(".dlc input[p_key='" + p_key + "']").val('');
        }
        $("#myModalFWA").modal('hide');
    }
</script>
<div class="titlePanel">
    <div class="title-search">
        <table>
            <tr>
                <td style="padding-left: 2px;">
                    <input id="Search_data" type="text" class="form-control" placeholder="查询条件" style="width: 200px;" />
                </td>
                <td style="padding-left: 5px;">
                    <a id="btn_Search" class="btn btn-primary"><i class="fa fa-search"></i>&nbsp;查询</a>
                </td>
            </tr>
        </table>
    </div>
    <div class="toolbar">
        <div class="btn-group">
            <a id="seladd" class="btn btn-success" onclick="btn_add()"><i style="color:#FFF" class="fa fa-plus"></i>&nbsp;确定</a>
            <a id="selclear" class="btn btn-default" onclick="btn_clear()"><i class="fa fa-trash-o"></i>&nbsp;清空</a>
        </div>
    </div>
</div>
<div class="gridPanel">
    <table id="gridTable"></table>
    <div id="gridPager"></div>
</div>
