@{
    ViewBag.Title = "账号维护";
}
@model OnControl.Model.P_CUSTOMER
<div class="container">
    @using (Html.BeginForm(Html.ViewContext.RouteData.Values["id"] != null ? "Edit" : "Create", "P_CUSTOMER", FormMethod.Post, new { id = "ff" }))
    {
        @Html.AntiForgeryToken()
        <div class="order_title">
            <span>基础信息</span>
        </div>
        <div class="ord_main">
            <span class="fld_label">名称</span>
            <span class="fld_input">@Html.TextBoxFor(m => m.COMPANY, new { style = "width:100%", @class = "easyui-textbox", data_options = "required:true" })</span>
            <span class="fld_label">编号</span>
            <span class="fld_input">@Html.TextBoxFor(m => m.STORERKEY, new { style = "width:100%", @class = "easyui-textbox", data_options = "required:true,validType:'length[4,32]'" })</span>
            <span class="fld_label">类型</span>
            <span class="fld_input">@Html.TextBoxFor(m => m.TYPE, new { style = "width:100%", @class = "easyui-combobox", data_options = "required:true,valueField:'Code',textField:'Name',editable:false" })</span>
            <span class="fld_label">国家</span>
            <span class="fld_input">@Html.TextBoxFor(m => m.COUNTRY, new { style = "width:100%", @class = "easyui-textbox" })</span>
            <div class="clear15"></div>
            <span class="fld_label">街道</span>
            <span class="fld_input">@Html.TextBoxFor(m => m.ADDRESS1, new { style = "width:100%", @class = "easyui-textbox" })</span>
            <span class="fld_label">城市</span>
            <span class="fld_input">@Html.TextBoxFor(m => m.CITY, new { style = "width:100%", @class = "easyui-textbox" })</span>
            <span class="fld_label">电话</span>
            <span class="fld_input">@Html.TextBoxFor(m => m.PHONE1, new { style = "width:100%", @class = "easyui-textbox" })</span>
            <span class="fld_label">E-Mail</span>
            <span class="fld_input">@Html.TextBoxFor(m => m.EMAIL1, new { style = "width:100%", @class = "easyui-textbox" })</span>
            <div class="clear15"></div>
            <span class="fld_label">简称</span>
            <span class="fld_input">@Html.TextBoxFor(m => m.SUSR3, new { style = "width:100%", @class = "easyui-textbox" })</span>
            <span class="fld_label">厂别</span>
            <span class="fld_input">@Html.TextBoxFor(m => m.ADDRESS2, new { style = "width:100%", @class = "easyui-textbox" })</span>
            <span class="fld_label">邮编</span>
            <span class="fld_input">@Html.TextBoxFor(m => m.ZIP, new { style = "width:100%", @class = "easyui-textbox" })</span>
            <span class="fld_label">地区</span>
            <span class="fld_input">@Html.TextBoxFor(m => m.STATE, new { style = "width:100%", @class = "easyui-textbox" })</span>
            <div class="clear"></div>
        </div>
        <div class="order_title">
            <span>扩展信息</span>
        </div>
        <div class="ord_main">
            <span class="fld_label">备注</span>
            <span>@Html.TextAreaFor(m => m.DESCRIPTION, new { style = "width:100%;height:60px", data_options = "required:false" })</span>
            <span class="fld_label">注释</span>
            <span>@Html.TextAreaFor(m => m.NOTES1, new { style = "width:100%;height:60px", data_options = "required:false" })</span>
        </div>
    }
    <div style="text-align:center;padding:5px 0;">
        @Html.ValidationSummary()
        <div style="color:red">@ViewBag.StatusMessage</div>
        <a href="javascript:void(0)" class="easyui-linkbutton" onclick="submitForm()" style="width: 80px; display: none; ">保存</a>&nbsp;&nbsp;
        <a href="@Url.Action("Index")" class="easyui-linkbutton" style="width:80px">返回</a>
    </div>
</div>
@section Scripts {
    @*@Scripts.Render("~/bundles/jqueryval")*@
    <script type="text/javascript">
        $("#TYPE").combobox({ data: [{ Code: '1', Name: '1' }, { Code: '5', Name: '5' }, { Code: '10', Name: '10' }] });

        $("#CREATEID").popcombobox({
            method: 'get',
            nameField:'CreateName',//用于保存对应数据库Name的字段,对应createid,默认为查询条件
            //url: '@Url.Action("GetDatas","Common")?q='+$("#CreateId").val(),//自动完成的数据源,绑定已有id,第一次需要传入参数,未指定则调用datasql
            valueField: 'UserID',
            mode:'remote',
            textField: 'Name',
            limitToList:true,
            dialogWidth:400,
            dialogHeight:500,
            datasql:"select USERID \"UserID\",NAME \"Name\",LOGINNAME \"LoginName\" from SYSUSER where STATUS='1'",//列表数据源
            displaynames:{LoginName:'登录名',Name:'姓名'},//列表显示字段
            sort:'NAME',//排序字段
            order:'desc'//排序方式
        });
        function submitForm() {
            if ($("#ff").form('validate')) {
                $("#ff").submit();//同步提交
            }
        }
        readonlyForm("ff", true);
    </script>
}
