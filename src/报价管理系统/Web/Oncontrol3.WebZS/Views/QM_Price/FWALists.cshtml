@{
    ViewBag.Title = "协议管理";
    Layout = "~/Views/Shared/_LayoutTM.cshtml";
}
<!-- MAIN CONTENT -->
<style>
    tr .selected { background-color: lightgray; }
</style>
<div id="content">


    <!-- widget grid -->
    <section id="widget-grid" class="">

        <!-- row -->
        <div class="row">
            <!-- NEW WIDGET START -->
            <article class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
                <!-- Widget ID (each widget will need unique ID)-->
                @*<div class="jarviswidget jarviswidget-color-blueDark" id="wid-id-2" data-widget-editbutton="false" data-widget-deletebutton="false">*@
                <div class="jarviswidget jarviswidget-sortable" data-widget-colorbutton="false" data-widget-editbutton="false" data-widget-custombutton="false">
                    <!-- widget options:
        usage: <div class="jarviswidget" id="wid-id-0" data-widget-editbutton="false">
        data-widget-colorbutton="false"
        data-widget-editbutton="false"
        data-widget-togglebutton="false"
        data-widget-deletebutton="false"
        data-widget-fullscreenbutton="false"
        data-widget-custombutton="false"
        data-widget-collapsed="true"
        data-widget-sortable="false"
        -->
                    <header><span class="widget-icon"><i class="fa fa-edit"></i></span><h2>协议管理</h2></header>
                    <!-- widget div-->
                    <div>
                        <!-- end widget edit box -->
                        <div class="widget-body">
                            <form id="form1">
                                <div class="row searchrow">
                                    @*<label class="col-md-1 control-label">协议号</label>*@
                                    <div class="col-sm-2">
                                        <input class="form-control" id="FWA" name="FWA" placeholder="请输入协议号...">
                                    </div>
                                    <div class="clear10"></div>
                                </div>
                                <div style="display:none" id="more_sc">
                                    <div class="row searchrow">
                                        @*<label class="col-md-1 control-label">创建日期</label>*@
                                        <div class="col-sm-2">
                                            <div class="input-group">
                                                <input type="text" id="CreateDateS" name="CreateDateS" placeholder="创建日期起" class="form-control datepicker" data-dateformat="yy/mm/dd">
                                                <span class="input-group-addon"><i class="fa fa-calendar"></i></span>
                                            </div>
                                        </div>
                                        <label class="col-md-1 control-label">~</label>
                                        <div class="col-sm-2">
                                            <div class="input-group">
                                                <input type="text" id="CreateDateE" name="CreateDateE" placeholder="创建日期止" class="form-control datepicker" data-dateformat="yy/mm/dd">
                                                <span class="input-group-addon"><i class="fa fa-calendar"></i></span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="sc_more">
                                    <button class="btn btn-primary" id="submit_search" style="float:left"><i class="fa fa-search" aria-hidden="true"></i> 查询</button>
                                    <button class="btn btn-default" id="reset" style="float:left">重置</button>
                                    <a class="control-label" href="javascript:void(0);" id="sc_more">更多查询条件</a>
                                </div>
                            </form>
                        </div>
                        <!-- widget content -->
                        <div class="widget-body no-padding">
                            <table id="datatable_col_reorder" class="table table-striped table-bordered table-hover" width="100%"></table>
                        </div>
                        <!-- end widget content -->
                    </div>
                    <!-- end widget div -->
                </div>
                <!-- end widget -->
            </article>
            <!-- WIDGET END -->
        </div>
        <!-- end row -->

    </section>
    <!-- end widget grid -->

</div>
<!-- END MAIN CONTENT -->
@section pagespecific {
<script src="~/Content/QO/layer/layer.js"></script>
    <script type="text/javascript">
        formatDate = function (v, format) {
            if (!v) return "";
            var d = v;
            if (typeof v === 'string') {
                if (v.indexOf("/Date(") > -1)
                    d = new Date(parseInt(v.replace("/Date(", "").replace(")/", ""), 10));
                else
                    d = new Date(Date.parse(v.replace(/-/g, "/").replace("T", " ").split(".")[0]));//.split(".")[0] 用来处理出现毫秒的情况，截取掉.xxx，否则会出错
            }
            var o = {
                "M+": d.getMonth() + 1,  //month
                "d+": d.getDate(),       //day
                "h+": d.getHours(),      //hour
                "m+": d.getMinutes(),    //minute
                "s+": d.getSeconds(),    //second
                "q+": Math.floor((d.getMonth() + 3) / 3),  //quarter
                "S": d.getMilliseconds() //millisecond
            };
            if (/(y+)/.test(format)) {
                format = format.replace(RegExp.$1, (d.getFullYear() + "").substr(4 - RegExp.$1.length));
            }
            for (var k in o) {
                if (new RegExp("(" + k + ")").test(format)) {
                    format = format.replace(RegExp.$1, RegExp.$1.length == 1 ? o[k] : ("00" + o[k]).substr(("" + o[k]).length));
                }
            }
            return format;
        };

        $(document).ready(function () {
            //列定义
            var columns = [{
                "title": "操作", "data": "RID", "width": "60", "orderable": false,
                render: function (data, type, row, meta) {
                    return '<button class="btn btn-xs btn-default" onclick=deleterow(\"' + data + '\") ><i class="fa fa-times"></i></button>';
                }
            },
                            { "title": "协议号", "orderable": true, "data": "FWA", "width": "250" },
                            { "title": "版本号", "data": "ZVER", "width": "100" },
                            { "title": "创建人", "data": "CREATEUSER", "width": "200" },
                            {
                                "title": "创建日期", "data": "CREATETIME",
                                "render": function (data, type, full, meta) {
                                    //return data == null ? "" : data.split('T')[0];//格式化只显示日期部分
                                    return data == null ? "" : formatDate(data, "yyyy/MM/dd hh:mm:ss");
                                }
                            }
            ];
            var table = $('#datatable_col_reorder').DataTable({
                "processing": true,
                "serverSide": true,
                "autoWidth": true,
                "order": [[4, "desc"]],//第一次加载默认第5列日期倒排
                "language": { "info": "Total : _TOTAL_", "paginate": { "first": "<<", "last": ">>", "next": ">", "previous": "<" } },//语言
                "sDom": "<'dt-toolbar'<'col-xs-12 col-sm-6'><'col-sm-6 col-xs-12 hidden-xs'>r>" + "t" +
                    "<'dt-toolbar-footer'<'col-sm-6 col-xs-12 hidden-xs'i><'col-xs-12 col-sm-6'pl>>",//整个griddom布局
                "lengthMenu": [[10, 20, 50, 100], [10, 20, 50, 100]],//每页显示key text
                "displayLength": 10,//默认每页显示条目数
                "ajax": {
                    "url": "@Url.Action("Lists")",//数据源controller
                    "type": "POST",
                    "data": function (d) {//查询参数
                        d.sort = d.columns[d.order[0].column].data;//排序列名转换
                        d.order = d.order[0].dir;//asc or desc
                        d.FWA = $("#FWA").val();
                        d.CreateDateE = $("#CreateDateE").val();
                        d.CreateDateS = $("#CreateDateS").val();
                    }
                }, columns: columns
            });
            //查询回车
            $('.form-control').bind('keypress', function (event) {
                if (event.keyCode == "13") {
                    $('#submit_search').trigger("click");
                }
            });
        });
        $("#submit_search").click(function () {
            $('#datatable_col_reorder').DataTable().search("").draw();
            return false;
        });
        $("#reset").click(function () {
            $(".form-control").each(function () {
                $(this).val('');
            });
            return false;
        });

        $("#sc_more").click(function () {
            $("#more_sc").toggle();
            var cls = $(this).attr("class");
            if (cls == 'clk') {
                $(this).removeClass('clk');
            } else {
                $(this).addClass('clk');
            }
        })

        function deleterow(rid) {
            layer.confirm('确定要删除报价系统协议？', {
                icon: 7,
                title: "<strong>提示</strong>",
                btn: ['删除', '取消'] //按钮
            }, function () {
                
                var index = layer.load(2, { time: 300 * 1000 });
                try {
                    $.ajax({
                        url: "@Url.Action("DeleteFWA")",
                        data: { keyvalue: rid },
                        type: "post",
                        dataType: "json",
                        async: true,
                        success: function (data) {
                            layer.close(index);
                            if (data.Success) {
                                layer.msg('报价系统协议已删除。<br/>请进入TM系统删除协议或行项目！', {
                                    time: 20000, //20s后自动关闭
                                    btn: ['明白了', '知道了']
                                });
                                $("#submit_search").click();
                            }
                            else {
                                layer.msg('报价系统删除协议失败...');
                            }
                        }
                    });

                } catch (e)
                { layer.msg("同步失败，请重试"); layer.close(index); }

            }, function () {

            });

        }
    </script>
}

