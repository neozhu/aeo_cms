                       + '<button class="btn btn-xs btn-default" onclick=doDelete(\"' + data + '\") ><i class="fa fa-times"></i></button>';
                                }
                            },
                            { "title": "产品代码", "orderable": false, "data": "CODE", "width": "100" },
                            { "title": "产品名称", "orderable": false, "data": "NAME", "width": "240" },
                            { "title": "事业部", "orderable": false, "data": "SYB", "width": "240" },
                            { "title": "业务类型", "orderable": false, "data": "YWLX", "width": "240" },
                            { "title": "产品经理", "orderable": false, "data": "CPJL", "width": "240" },
                            { "title": "启用日期开始", "orderable": false, "data": "DTFROM", "width": "240" },
                            { "title": "启用日期结束", "orderable": false, "data": "DTTO", "width": "240" },
                            { "title": "启用状态", "orderable": false, "data": "STATUS", "width": "100" },
            ];
            var table = $('#datatable_col_reorder').DataTable({
                "processing": true,
                "serverSide": true,
                "autoWidth": true,
                "order": [[2, "desc"]],//第一次加载默认第5列日期倒排
                "language": { "info": "Total : _TOTAL_", "paginate": { "first": "<<", "last": ">>", "next": ">", "previous": "<" } },//语言
                "sDom": "<'dt-toolbar'<'col-xs-12 col-sm-6'><'col-sm-6 col-xs-12 hidden-xs'>r>" + "t" +
                    "<'dt-toolbar-footer'<'col-sm-6 col-xs-12 hidden-xs'i><'col-xs-12 col-sm-6'pl>>",//整个griddom布局
                "lengthMenu": [[4, 10, 20, 50, 100], [4, 10, 20, 50, 100]],//每页显示key text
                "displayLength": 10,//默认每页显示条目数
                "ajax": {
                    "url": "@Url.Action("Lists")",//数据源controller
                    "type": "POST",
                    "data": function (d) {//查询参数
                        d.sort = d.columns[d.order[0].column].data;//排序列名转换
                        d.order = d.order[0].dir;//asc or desc

                        d.CODE = $("#Code").val();
                        d.NAME = $("#Name").val();

                        d.CreateDateS = $("#CreateDateS").val();
                        d.CreateDateE = $("#CreateDateE").val();
                    }
                }, columns: columns
            });
            //$('#datatable_col_reorder tbody').on('click', 'tr', function () {
