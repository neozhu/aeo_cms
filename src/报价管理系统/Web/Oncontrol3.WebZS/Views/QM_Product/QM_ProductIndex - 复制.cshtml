@{
    ViewBag.Title = "产品列表";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<!-- MAIN CONTENT -->
<style>
        /*tr .selected {
            background-color: lightgray;
        }

    #datatable_col_reorder td{white-space:nowrap;}
    #datatable_col_reorder th{white-space:nowrap;}*/
</style>
<div id="content">
    <section id="widget-grid" class="">
        <div class="row">
            <article class="col-sm-12 col-md-12 col-lg-12 sortable-grid ui-sortable">
                <div class="jarviswidget jarviswidget-sortable" data-widget-colorbutton="false" data-widget-editbutton="false" data-widget-custombutton="false">
                    <header>
                        <span class="widget-icon"><i class="fa fa-edit"></i></span>
                        <h2>报价管理/<span style="color:#ffd600!important">产品列表</span></h2>
                        <div style="float:right;">
                            <button type="submit" class="btn btn-success" id="btnadd">
                                新增
                            </button>
                            <button type="submit" class="btn btn-default" id="submit_search">
                                查询
                            </button>
                        </div>
                    </header>
                    <!-- widget div-->
                    <div role="content">
                        <!-- end widget edit box -->
                        <div class="jarviswidget-editbox"></div>
                        <div class="widget-body">
                            <form id="form1" class="smart-form form-backgroud">
                                <div class="row">
                                    <section class="col col-3">
                                        <label class="label">产品代码</label>
                                        <label class="input">
                                            <input class="form-control" id="Code" name="Code" placeholder="产品代码">
                                        </label>
                                    </section>
                                    <section class="col col-3">
                                        <label class="label">产品名称</label>
                                        <label class="input">
                                            <input class="form-control" id="Name" name="Name" placeholder="产品名称">
                                        </label>
                                    </section>
                                    <section class="col col-3">
                                        <label class="label">状态</label>
                                        <label class="input">
                                            <select style="width:100%" id="Status" class="select2"></select>
                                        </label>
                                    </section>
                                </div>
                                <div style="display:none" id="more_sc">
                                    <div class="row">
                                        <section class="col col-3">
                                            <label class="label">创建日期开始</label>
                                            <label class="input">
                                                <div class="input-group date form_datetime">
                                                    <input class="form-control" type="text" id="CreateDateS">
                                                    <span class="input-group-addon"><i class="fa fa-calendar"></i></span>
                                                </div>
                                            </label>
                                        </section>
                                        <section class="col col-3">
                                            <label class="label">创建日期结束</label>
                                            <label class="input">
                                                <div class="input-group date form_datetime">
                                                    <input class="form-control" type="text" id="CreateDateE">
                                                    <span class="input-group-addon"><i class="fa fa-calendar"></i></span>
                                                </div>
                                            </label>
                                        </section>
                                    </div>
                                </div>
                                <div class="sc_more">
                                    <a class="control-label" href="javascript:void(0);" id="sc_more">更多查询条件</a>
                                </div>
                            </form>
                        </div>
                        <!-- widget content -->
                        <div class="widget-body no-padding">
                            <table id="datatable_col_reorder" class="table table-striped table-bordered table-hover" width="100%"></table>
                        </div>
                        <!-- end widget content -->
                    </div>
                    <!-- end widget div -->
                </div>
                <!-- end widget -->
            </article>
            <!-- WIDGET END -->
        </div>
        <!-- end row -->

    </section>
    <!-- end widget grid -->

</div>
@section pagespecific {
    <script src="~/Content/QO/scripts/framework.js"></script>
<script src="~/Content/QO/scripts/Ewin.js"></script>
    <script src="~/Content/plugins/toastr.min.js"></script>
    <script src="~/Content/plugins/jquery.ajaxupload.js"></script>
    <script src="~/Content/plugins/jquery.bootpag.min.js"></script>
    <script src="~/Content/plugins/jquery.guid.js"></script>
    <script src="~/Content/plugins/base.js"></script>
<link href="~/Content/QO/scripts/bootstrap-datetimepicker/css/bootstrap-datetimepicker.min.css" rel="stylesheet">
<script src="~/Content/QO/scripts/bootstrap-datetimepicker/js/bootstrap-datetimepicker.min.js"></script>
<script type="text/javascript" src="~/Content/QO/scripts/bootstrap-datetimepicker/js/locales/bootstrap-datetimepicker.zh-CN.js" charset="UTF-8"></script>
    <script type="text/javascript">

        $(document).ready(function () {
            $("#CreateDateS").val('@DateTime.Now.AddDays(-6).ToString("yyyy/MM/dd")');
            $("#CreateDateE").val('@DateTime.Now.ToString("yyyy/MM/dd")');

            $(".form_datetime").datetimepicker({
                format: "yyyy/mm/dd",
                autoclose: true,
                todayBtn: true,
                todayHighlight: true,
                startView: 2,
                minView: 2,
                clearBtn: true,
                language: "zh-CN"
            });

            @*var user = '@(Oncontrol3.Web.Helpers.SessionHelper.GetSessionUser<Oncontrol3.Web.Controllers.FLD_QO_USER>().staffkey)';
            if (user.length < 1) {
                layer.alert('系统登录已超时，请重新登录', { icon: 2 });
                $('#btnadd').attr('disabled', 'disabled');
            }*@
        });
        function addNew()
        {
            document.location.href = '/QM_Product/QM_ProductEdit';
            return false;
        }
        function doEdit(prdid) {
            document.location.href = '/QM_Product/QM_ProductEdit?keyValue=' + prdid;
        }
        function doDelete(prdid)
        {
            Ewin.alert(prdid);
        }
        $("#btnadd").click(function () {
            addNew();
            return false;
        });
        $("#submit_search").click(function () {
            $('#datatable_col_reorder').DataTable().search("").draw();
            return false;
        });
        $("#sc_more").click(function () {
            $("#more_sc").toggle();
            var cls = $(this).attr("class");
            if (cls == 'clk') {
                $(this).removeClass('clk');
            } else {
                $(this).addClass('clk');
            }
        });
        $(document).ready(function () {
            //$("[mdmtype='MDMBP']").each(function () {
            //    AutocompleteMDMBP($(this).attr("id"));
            //});
            //列定义
            var columns = [
            //    {
            //    "title": "选择", "data": "TRQ_ID", "width": "60", "orderable": false,
            //    render: function (data, type, row, meta) {
            //        var content = '<label style="margin-left:32px;" class="mt-checkbox mt-checkbox-single mt-checkbox-outline">';
            //        content += '    <input type="checkbox"  name="sh" class="group-checkable"     value="' + data + '" />';
            //        content += '</label>';
            //        return content;
            //    }
            //},
            //{
            //    "title": "复制", "data": "TRQ_ID", "width": "60", "orderable": false,
