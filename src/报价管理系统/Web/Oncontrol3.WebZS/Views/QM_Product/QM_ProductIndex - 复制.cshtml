            $('#datatable_col_reorder tbody').on('dblclick', 'tr', function () {
                var fwo = $('#datatable_col_reorder').DataTable().row(this).data()['ID'];
                location.href = '/QM_Product/QM_ProductEdit?keyValue=' + fwo;
            });
            var dataSel = @Html.Raw(ViewBag.StatusSel);
            $("#Status").append($("<option></option>").attr("value", "").html(""));
            $(dataSel).each(function(k, o) {
                $("#Status").append($("<option></option>").attr("value", o.Code).html(o.Name));
            });
