            //        return '<button title="点击复制整单" class="btn btn-xs btn-default" onclick=doCopy(\"' + data + '\") ><i class="fa fa-copy"></i></button>';
            //    }
            //},
            //{
            //    "title": "TM", "data": "DB_KEY", "width": "60", "orderable": false,
            //    render: function (data, type, row, meta) {
            //        return '<button title="点击打开TM链接" class="btn btn-xs btn-default" onclick=TMLink(\"' + data + '\") ><i class="fa fa-external-link"></i></button>';
            //    }
            //},
                            //{
                            //    "title": "FWO", "orderable": false, "data": "TRQ_ID",
                            //    "render": function (data, type, full, meta) {
                            //        return fqLTrim(full.TRQ_ID);
                            //    }
                            //},
                            {
                                "title": "操作", "data": "ID", "width": "60", "orderable": false,
                                render: function (data, type, row, meta) {
                        //            return '<button class="btn btn-xs btn-default" onclick=doEdit(\"' + data + '\") ><i class="fa fa-pencil"></i></button>'
