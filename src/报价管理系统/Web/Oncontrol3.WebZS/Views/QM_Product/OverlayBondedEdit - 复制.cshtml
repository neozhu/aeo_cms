        function LoadFWOData() {
            var index = layer.load(0, {
                shade: [0.1, '#fff'], //0.1透明度的白色背景
                time: 300 * 1000
            });
            try {
                $.ajax({
                    url: RootPath() + "/QO_OverlayBonded/QOFWO403",
                    type: "post",
                    data: { 'fwo': keyvalue },
                    dataType: "json",
                    async: false,
                    success: function (data) {
                        layer.close(index);
                        if (data.Success) {
                            initControl(data.Data);
                            hideServices();
                        } else {
                            layer.alert(data.Message, { title: '错误', icon: 2 });
                            console.log(data.Message);
                        }
                    },
                    error: function (data) {
                        layer.close(index);
                        if (!!data.responseText) {
                            layer.msg(data.responseText, { time: 5000 });
                        } else {
                            layer.msg("请求失败！");
                        }
                    }
                });

