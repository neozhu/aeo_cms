        // 删除服务
        function del_services() {
            var strArr = [];
            $('input:checkbox[name=icheckbox]:checked').each(function () {
                if (true == $(this).is(':checked')) {
                    strArr.push($(this).attr('srvkey'));
                }
            });
            if (strArr.length > 0) {
                if (confirm("确定要删除该服务？")) {
                    var bdel = true;
                    $(strArr).each(function (index, value) {
                        if (($('#' + value).val() + "").length > 2) {
                            bdel = false;
                            return false;
                        }
                    });
                    if (!bdel) {
                        layer.msg("已创建FOO的服务不能删除！", { time: 5000 });
                        return;
                    }
                    $(strArr).each(function (index, value) {
                        $("fieldset").each(function () {
                            var delid = $(this).attr("id") + "";
                            if (delid == value + 'fieldset') {
                                if (delid.length == 32) {
                                    g_delsrvsArr.push(delid);
                                }
                                $('#' + delid).remove();
                                IsEdit = true;
                            }
                        });
                    });
                }
            } else {
                layer.msg("请选择要删除的服务！", { time: 5000 });
            }
        }
