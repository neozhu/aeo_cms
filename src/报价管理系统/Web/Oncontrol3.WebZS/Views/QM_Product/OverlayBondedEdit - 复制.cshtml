        function ZFFWO() {
            if ($('#ZFBJ').is(':checked')) {
                $('#content').find('*').attr('disabled', 'disabled');
                $('#btnback').removeAttr('disabled');
                $('#btnCopy').removeAttr('disabled');
                $('a').removeAttr('href');//去掉a标签中的href属性
            }
        }
        function BindTMLink() {
            $("a[name='rwfldlink']").click(function () {
                if ($(this).attr('rwfldlinkkey').length != 32) {
                    layer.msg("KEY不存在，无法跳转到TM！");
                    return;
                }
                else if ($(this).attr('rwfldlinktype') == 'FWO') {
                    var urlprefix = "@Oncontrol3.Web.Helpers.ConfigHelper.AppSettings("QO_FWO")";
                    window.open(urlprefix + $(this).attr('rwfldlinkkey'), "_blank");
                }
                else if ($(this).attr('rwfldlinktype') == 'FO' || $(this).attr('rwfldlinktype') == 'FOO') {
                    var urlprefix = "@Oncontrol3.Web.Helpers.ConfigHelper.AppSettings("QO_FOFOO")";
                    window.open(urlprefix + $(this).attr('rwfldlinkkey'), "_blank");
                }
                else if ($(this).attr('rwfldlinktype') == 'FB') {
                    var urlprefix = "@Oncontrol3.Web.Helpers.ConfigHelper.AppSettings("QO_FB")";
                    window.open(urlprefix + $(this).attr('rwfldlinkkey'), "_blank");
                }
            });
