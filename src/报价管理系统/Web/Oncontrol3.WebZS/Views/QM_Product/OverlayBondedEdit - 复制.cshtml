        function DoLock() {
            if (g_zlock_internal == '02') {
                $('#content').find('*').attr('disabled', 'disabled');
                $('#btnback').removeAttr('disabled');
                $('#btnCopy').removeAttr('disabled');
                $('a').removeAttr('href');//去掉a标签中的href属性
                $("i[name='fbfobtn']").each(function () {
                    $(this).hide();
                });
                return;
            }
            if (g_zlock_internal == '01' || g_zlock_external == '01') {
                $.ajax({
                    url: RootPath() + "/MDM/GetDatasLock",
                    type: "post",
                    data: {
                        'ztype': $('#trq_type').val(),
                        'zlock_internal': g_zlock_internal,
                        'zlock_external': g_zlock_external
                    },
                    dataType: "json",
                    async: false,
                    success: function (data) {
                        if (data != null && data.Data != null) {
                            //console.log(data.Data);
                            $.each(data.Data, function (n, lf) {
                                if (lf.LOCKFIELD == 'fag_id')//代运协议
                                {
                                    $('a').removeAttr('href');//去掉a标签中的href属性
                                }
                                else if (lf.LOCKFIELD == 'party_idzfw1')//进口企业结算方
                                {
                                    $('#JKQYJSFCODE').attr('disabled', 'disabled');
                                }
                                else if (lf.LOCKFIELD == 'party_idzfw2')//出口企业结算方
                                {
                                    $('#CKQYJSFCODE').attr('disabled', 'disabled');
                                }
                                else if (lf.LOCKFIELD == 'party_idzfw3')//HUB仓进结算方
                                {
                                    $('#HUBCJJSFCODE').attr('disabled', 'disabled');
                                }
                                else if (lf.LOCKFIELD == 'party_idzfw4')//HUB仓出结算方
                                {
                                    $('#HUBCCJSFCODE').attr('disabled', 'disabled');
                                }
                                else {
                                    $('#' + lf.LOCKFIELD).attr('disabled', 'disabled');
                                    $('input:text[name=' + lf.LOCKFIELD + ']').each(function () {
                                        $(this).attr("disabled", "disabled");
                                    });
                                }
                            });
                        }
                    },
                    error: function (data) {
                        if (!!data.responseText) {
                            layer.msg(data.responseText, { time: 5000 });
                        } else {
                            layer.msg("请求失败！");
                        }
                    }
                });
            }
            //if (g_zlock_external == '01') { }
        }
