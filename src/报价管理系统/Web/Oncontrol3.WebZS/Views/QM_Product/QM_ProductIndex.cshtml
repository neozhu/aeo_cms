@{
    ViewBag.Title = "产品列表";
    Layout = "~/Views/Shared/_LayoutTM.cshtml";
}
<!-- MAIN CONTENT -->
<style>
    tr .selected {
        background-color: lightgray;
    }

    .DTFC_LeftWrapper {
        top: -6px !important;
    }

    .DTFC_RightWrapper {
        top: -7px !important;
    }

    /*.DTFC_LeftHeadWrapper {left: -2px !important; }
    .DTFC_LeftBodyWrapper {left: -2px !important; }*/
    /*.col-sm-1 { padding: 0px; }

    .jarviswidget > div { font-size: 12px; }*/


    /*#datatable_col_reorder td{white-space:nowrap;}
    #datatable_col_reorder th{white-space:nowrap;}*/
</style>

<div id="content">
    <section id="widget-grid" class="">
        <div class="row">
            <article class="col-sm-12 col-md-12 col-lg-12 sortable-grid ui-sortable">
                <div class="jarviswidget jarviswidget-sortable" data-widget-colorbutton="false" data-widget-editbutton="false" data-widget-custombutton="false">
                    <header>
                        <span class="widget-icon"><i class="fa fa-edit"></i></span>
                        <h2>报价管理/<span style="color:#ffd600!important">产品列表</span></h2>
                        <div style="float:right;">
                            <button type="submit" class="btn btn-success" id="btnadd">
                                新建
                            </button>
                            <button type="submit" class="btn btn-default" id="submit_search">
                                查询
                            </button>
                        </div>
                    </header>
                    <!-- widget div-->
                    <div role="content">
                        <!-- end widget edit box -->
                        <div class="jarviswidget-editbox"></div>
                        <div class="widget-body">
                            <form id="form1" class="smart-form form-backgroud">
                                <div class="row">
                                    <section class="col col-3">
                                        <label class="label">产品代码</label>
                                        <label class="input">
                                            <input class="form-control" id="PRODUCTKEY" name="PRODUCTKEY" placeholder="产品代码">
                                        </label>
                                    </section>
                                    <section class="col col-3">
                                        <label class="label">产品名称</label>
                                        <label class="input">
                                            <input class="form-control" id="SQPRODUCTNAME" name="SQPRODUCTNAME" placeholder="产品名称">
                                        </label>
                                    </section>
                                    <section class="col col-3">
                                        <label class="input">
                                            <select style="width:100%" name="BUSINESSORG" id="BUSINESSORG" class="select2">
                                                <option></option>
                                                <option value="空运">空运</option>
                                                <option value="海运">海运</option>
                                                <option value="供应链">供应链</option>
                                                <option value="运输">运输</option>
                                            </select>
                                        </label>
                                    </section>
                                    <section class="col col-3">
                                        <label class="label">产品经理</label>
                                        <label class="input">
                                            <input class="form-control" id="PRODUCTMANAGERNAME" name="PRODUCTMANAGERNAME" placeholder="产品经理">
                                        </label>
                                    </section>
                                </div>
                                <div style="display:none" id="more_sc">
                                    <input class="form-control" id="fixedleftnum" name="fixedleftnum" style="display:none;" value="4">
                                    <div class="row">
                                        <section class="col col-3">
                                            <label class="label">启用状态</label>
                                            <label class="input">
                                                <select style="width:100%" id="Status" class="select2"><option></option></select>
                                            </label>
                                        </section>
                                        <section class="col col-3">
                                            <label class="label">创建日期开始</label>
                                            <label class="input">
                                                <div class="input-group date">
                                                    <input class="form-control form-date" type="text" id="CreateDateS" placeholder="创建日期开始">
                                                    <span class="input-group-addon"><i class="fa fa-calendar"></i></span>
                                                </div>
                                            </label>
                                        </section>
                                        <section class="col col-3">
                                            <label class="label">创建日期结束</label>
                                            <label class="input">
                                                <div class="input-group date">
                                                    <input class="form-control form-date" type="text" id="CreateDateE" placeholder="创建日期结束">
                                                    <span class="input-group-addon"><i class="fa fa-calendar"></i></span>
                                                </div>
                                            </label>
                                        </section>
                                    </div>
                                </div>
                                <div class="sc_more">
                                    <a class="control-label" href="javascript:void(0);" id="sc_more">更多查询条件</a>
                                </div>
                            </form>
                        </div>
                        <!-- widget content -->
                        <div class="widget-body no-padding" style="margin-bottom:30px;">
                            <table id="datatable_col_reorder" class="table table-striped table-bordered table-hover"></table>
                        </div>
                        <!-- end widget content -->
                    </div>
                    <!-- end widget div -->
                </div>
                <!-- end widget -->
            </article>
            <!-- WIDGET END -->
        </div>
        <!-- end row -->

    </section>
    <!-- end widget grid -->

</div>
