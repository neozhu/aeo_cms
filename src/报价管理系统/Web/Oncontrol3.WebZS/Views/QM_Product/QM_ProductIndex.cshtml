        //产品排序维护
        function doSort(data) {
            console.log(data);
            prdkey = data;
            //请求后台拿扩展表的完整数据
            $.ajax({
                url: "@Url.Action("FindByPK")",//数据源controller
                data: {
                    'prdkey': prdkey,
                },
                dataType: "json",
                async: false,
                success: function (data) {
                    console.log(data);
                    postdata_ext = data.Data;
                }
            });
            var msg = "<form id='formmain'>";
            msg += "<div class='row'>";
            msg += "<section class='col col-3'>";
            msg += " <label style='margin-right:30px;'>产品排序号</label>";
            msg += "<label class='input'><input class='form-control' id= 'SORD' name='sord' placeholder= '产品排序号' ></label >";
            msg += "<button class='btn btn-success' style='margin-left:30px;' onclick = saveSorid()>保存</button>"
            msg += "</section>";
            msg += "</div>";
            msg += "</form>"
            alert("产品排序维护", msg);
            //隐藏弹出框确定按钮
            $(".modal-footer").children('button').hide();
            if (postdata_ext.SORD != null) {
                $("#SORD").val(postdata_ext.SORD);
            };
            var errorClass = 'invalid';
            var errorElement = 'em';
            //表单校验初始化
            $('#formmain').validate({
                errorClass: errorClass,
                errorElement: errorElement,
                highlight: function (element) {
                    $(element).parent().removeClass('state-success').addClass("state-error");
                    $(element).removeClass('valid');
                },
                unhighlight: function (element) {
                    $(element).parent().removeClass("state-error").addClass('state-success');
                    $(element).addClass('valid');
                },
                // Rules for form validation
                rules: {
                    sord: {
                        required: true,
                        digits: true,
                        range: [1, 1000],
                    }
                },

                // Messages for form validation
                messages: {

                    sord: {
                        required: '必填',
                        digits: '请输入1和1000之间的整数',
                        range: $.validator.format("请输入{0}和{1}之间的整数")
                    }
                },

                // Do not change code below
                errorPlacement: function (error, element) {
                    error.insertAfter(element.parent());
                }
            });
        }
        //保存排序字段到后台
        function saveSorid() {
            if (!$("#formmain").valid()) {
                return;
            }
            toastr.info("数据保存中，请稍候...");
            postdata_ext.SORD = $("#SORD").val();
            //产品扩展数据日期
            console.log($("#SORD").val());
            console.log(prdkey);
            $.ajax({
                url: "@Url.Action("SAVESORT")",//数据源controller
                data: {
                    'prdkey': prdkey,
                    'postdata_ext': JSON.stringify(postdata_ext),
                },
                dataType: "json",
                async: false,
                success: function (data) {
                    toastr.clear();
                    toastr.remove();
                    if (data.Success) {
                        toastr.success(data.Message);
                        $("#PRODUCTKEY").val(data.Data.PRODUCTKEY);
                    } else {
                        toastr.error(data.Message);
                    }
                },
                error: function (data) {
                    if (!!data.responseText) {
                        alert(data.responseText);
                    } else {
                        window.alert("请求失败！");
                    }
                }
            })
        };
