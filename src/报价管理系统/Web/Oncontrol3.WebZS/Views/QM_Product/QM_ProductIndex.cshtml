            Prokey = PRODUCTKEY;
            popDialog("删除", "确定要删除本条记录吗？", deleteRow);
        }
        // 对话框回调函数
        function deleteRow() {
            $.ajax({
                url: "@Url.Action("dodelete")",
                type: "Post",
                async: false,
                dataType: "json",
                data: {
                    'PROKEY': Prokey
                },
                success: function (data) {
                    toastr.clear();
                    toastr.remove();
                   // console.log(data.Message);
                    if (data.Message=="删除成功") {
                        toastr.success("删除成功!");
                        $('#datatable_col_reorder').DataTable().search("").draw();
                    } else {
                        toastr.error("删除失败!"+data.Message);
                    }
                }
            });
        }
        $("#btnadd").click(function () {
            addNew();
            return false;
        });
        $("#submit_search").click(function () {
            $('#datatable_col_reorder').DataTable().search("").draw();
            return false;
        });
        $("#sc_more").click(function () {
            $("#more_sc").toggle();
            var cls = $(this).attr("class");
            if (cls == 'clk') {
                $(this).removeClass('clk');
            } else {
                $(this).addClass('clk');
            }
            $("#sc_more").hide();
        });

