@{
    ViewBag.Title = "FileUpload";
}

<form id="importFileForm" method="post" enctype="multipart/form-data" action="/P_KITTING/PostExcelData">
    <table style="margin:5px;height:60px;">
        <tr>
            <td>请选择文件</td>
            <td width="5px;"></td>
            <td><input type="file" class="textbox" id="fileImport" name="fileImport" style="width:260px;"></td>
            <td></td>
        </tr>
        <tr>
            <td colspan="4"><label id="fileName" /></td>
        </tr>
        <tr>
            <td colspan="4">
                <label id="uploadInfo"></label>
            </td>
        </tr>
    </table><div style="text-align:center;clear:both;margin:5px;">
        <a id="uploadFile" class="easyui-linkbutton" onclick="importFileClick();" href="javascript:void(0)">上传</a>
        <a class="easyui-linkbutton" onclick="closeImportClick();" href="javascript:void(0)">关闭</a>
    </div>
</form>
@Scripts.Render("~/bundles/jquery")
@section Scripts {
    <script>
        //关闭导入弹出窗口
        var closeImportClick = function () {
            document.getElementById('fileImport').value = null;
            document.getElementById('fileName').innerHTML = "";
            document.getElementById('uploadInfo').innerHTML = "";
            window.parent.window.$('#import-excel-template').window('close');
            window.parent.window.MaskUtil.unmask();
        }

        //导入文件
        var importFileClick = function () {
            window.parent.window.MaskUtil.mask("上传中....");
            //获取上传文件控件内容
            var file = document.getElementById('fileImport');
            try {
                file = file.files[0];
            }
            catch (e) { file=file.value}
            //判断控件中是否存在文件内容，如果不存在，弹出提示信息，阻止进一步操作
            if (file == null||file=="") {
                document.getElementById('fileName').innerHTML = "<span style='color:Red'>错误，请选择文件</span>";
                window.parent.window.MaskUtil.unmask(); return;
            }
            //获取文件名称
            var fileName = file.name||file;
            //获取文件类型名称
            var file_typename = fileName.substring(fileName.lastIndexOf('.'), fileName.length);
            //这里限定上传文件文件类型必须为.xlsx，如果文件类型不符，提示错误信息
            if (file_typename == '.xlsx' || file_typename == '.xls') {
                //计算文件大小
                var fileSize = 0;
                //如果文件大小大于1024字节X1024字节，则显示文件大小单位为MB，否则为KB
                if (file.size > 1024 * 1024) {
                    fileSize = Math.round(file.size * 100 / (1024 * 1024)) / 100;

                    if (fileSize > 10) {
                        alert('错误，文件超过10MB，禁止上传！'); return;
                    }
                    fileSize = fileSize.toString() + 'MB';
                }
                else {
                    fileSize = (Math.round(file.size * 100 / 1024) / 100).toString() + 'KB';
                }
                //将文件名和文件大小显示在前端label文本中
                document.getElementById('fileName').innerHTML = "<span style='color:Blue'>文件名: " + file.name + ',大小: ' + fileSize + "</span>";
                //获取form数据
                //调用apicontroller后台action方法，将form数据传递给后台处理。contentType必须设置为"multipart/form-data"
                /*var formData = new FormData($("#importFileForm")[0]);//H5支持,低版本浏览器不支持
                $.ajax({
                    url: "/P_KITTING/PostExcelData",
                    type: 'POST',
                    data: formData,
                    async: false,
                    cache: false,
                    contentType: "multipart/form-data",
                    processData: false,
                    success: function (returnInfo) {
                        //上传成功后将控件内容清空，并显示上传成功信息
                        document.getElementById('fileImport').value = null;
                        document.getElementById('uploadInfo').innerHTML = "<span style='color:Red'>" + returnInfo + "</span>";
                    },
                    error: function (returnInfo) {
                        //上传失败时显示上传失败信息
                        document.getElementById('uploadInfo').innerHTML = "<span style='color:Red'>" + returnInfo + "</span>";
                    }
                });*/
                document.forms["importFileForm"].submit();
            }
            else {
                //将错误信息显示在前端label文本中
                document.getElementById('fileName').innerHTML = "<span style='color:Red'>错误提示:上传文件应该是.xlsx或者.xls后缀而不应该是" + file_typename + ",请重新选择文件</span>";
                window.parent.window.MaskUtil.unmask();
            }
        }
        if ("@ViewBag.UploadMsg" == "上传成功!") {
            alert("上传已完成!");
            //window.parent.window.$('#import-excel-template').window('close');
            window.parent.window.$("#submit_search").click();
            window.parent.window.MaskUtil.unmask();
        }
        else if ("@ViewBag.UploadMsg"!="") {
            alert("@ViewBag.UploadMsg");
            window.parent.window.MaskUtil.unmask();
        }
    </script>
}


