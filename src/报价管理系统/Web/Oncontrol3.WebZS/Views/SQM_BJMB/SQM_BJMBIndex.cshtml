@{
    ViewBag.Title = "报价模板列表";
    Layout = "~/Views/Shared/_LayoutTM.cshtml";
}

<style>
    tr .selected {
        background-color: lightgray;
    }

    .DTFC_LeftWrapper {
        top: -6px !important;
    }

    .DTFC_RightWrapper {
        top: -7px !important;
    }

    .head {
        height: 50px;
        background-color: rgb(19,100,181);
        color: #999;
        margin-top: 7px;
        margin-bottom: 7px;
    }

        .head span {
            line-height: 98px;
            font-size: 14px;
            padding: 0px 20px 15px 10px;
            color: #ffffff;
        }

    /*.head .active {
            border-bottom: 2px solid #F8F8F8;
        }*/
    .dis {
        color: #999;
        cursor: pointer;
    }
</style>
<div class="row head">
    <div style="float:left">
        <div style="margin-top: -25px;">
            <span>&nbsp;&nbsp;&nbsp; 欢迎您：<span id="user">@Oncontrol3.Web.Helpers.SQMHelper.getStaffKey()</span></span>
        </div>
    </div>
    <div style="float:right; margin-right: 40px; margin-top: -25px;">
        <span class="dis" id="toxj">询价</span>
        <span class="dis" id="tobjmb">报价模板</span>
        <span class="dis" id="tocpzs">产品展示</span>
        @*<span class="dis" id="tobjmb">非标报价</span>*@
        <span class="dis active" id="tobjsy">报价首页</span>
    </div>
</div>
<div id="content">
    <section id="widget-grid" class="">
        <div class="row">
            <article class="col-sm-12 col-md-12 col-lg-12 sortable-grid ui-sortable">
                <div class="jarviswidget jarviswidget-sortable" data-widget-colorbutton="false" data-widget-editbutton="false" data-widget-custombutton="false">
                    <header>
                        <span class="widget-icon"><i class="fa fa-edit"></i></span>
                        <h2>报价模板</h2>
                        <div style="float:right;">
                            <button type="submit" class="btn btn-success" id="btnadd">
                                新建
                            </button>
                            <button type="submit" class="btn btn-default" id="submit_search">
                                查询
                            </button>
                        </div>
                    </header>
                    <!-- widget div-->
                    <div role="content">
                        <!-- end widget edit box -->
                        <div class="jarviswidget-editbox"></div>
                        <div class="widget-body">
                            <form id="form1" class="smart-form form-backgroud">
                                <div class="row">
                                    <section class="col  col-1">
                                        <input type="checkbox" checked="checked" id="personalMB" value="个人模板">个人模板
                                    </section>
                                    <section class="col col-1">
                                        <input type="checkbox" checked="checked" id="publicMB" value="公共模板">公共模板
                                    </section>
                                    <section class="col col-3">
                                        <label class="input">
                                            <input class="form-control" id="TEMPLATENAME" name="TEMPLATENAME" placeholder="模板名称">
                                        </label>
                                    </section>
                                    <section class="col col-3">
                                        <label class="input">
                                            <select style="width:100%" id="Status" class="select2"></select>
                                        </label>
                                    </section>
                                </div>
                            </form>
                        </div>
                        <div class="widget-body no-padding" style="margin-bottom:30px;">
                            <table id="datatable_col_reorder" class="table table-striped table-bordered table-hover"></table>
                        </div>
                    </div>
                </div>
            </article>
        </div>
    </section>

</div>
<!-- 选择组织 -->
<div class="modal fade" id="chooseORG" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">
                    &times;
                </button>
                <h4 class="modal-title">
                    选择组织
                </h4>
            </div>
            <div class="modal-body">
                <form id="formmain" class="smart-form form-backgroud">
                    <fieldset style="padding-top:5px">
                        <select style="width:100%" id="ORGRID" name="ORGRID" class="select2" placeholder="">
                             <option value=""></option>
                             @for (int i = 0; i < ViewBag.ORG.Rows.Count; i++)
                              {
                                  <option value="@ViewBag.ORG.Rows[i]["RID"]">@ViewBag.ORG.Rows[i]["ORGNAME"]-@ViewBag.ORG.Rows[i]["RID"]</option>
                              }
                        </select>
                    </fieldset>
                    <footer>
                        <button class="btn btn-primary" id="btnSaveOrg" onclick="return false;">
                            保存
                        </button>
                        <button class="btn btn-primary" onclick="btnCancel(); return false;">
                            取消
                        </button>
                    </footer>
                </form>
            </div>
        </div>
    </div>
</div>
@section pagespecific {
    <script src="~/Content/QO/scripts/framework.js"></script>
    <script src="~/Content/QO/scripts/Ewin.js"></script>
    <script src="/js/lib/jquery.plug-ins.js" type="text/javascript"></script>
    <script src="/scripts/plugin/datatables/dataTables.colReorder.min.js" type="text/javascript"></script>
    <script src="/scripts/plugin/datatables/dataTables.colVis.min.js" type="text/javascript"></script>
    <script src="/scripts/plugin/datatables/dataTables.fixedColumns.min.js" type="text/javascript"></script>
    <script src="/scripts/plugin/datatables/dataTables.fixedHeader.js" type="text/javascript"></script>
    <script src="~/Content/QO/toastr/toastr.min.js"></script>
    <link rel="stylesheet" href="~/Content/QO/toastr/toastr.min.css">
    <link href="~/Content/QO/scripts/bootstrap-datetimepicker/css/bootstrap-datetimepicker.min.css" rel="stylesheet">
    <script src="~/Content/QO/scripts/bootstrap-datetimepicker/js/bootstrap-datetimepicker.min.js"></script>
    <script type="text/javascript" src="~/Content/QO/scripts/bootstrap-datetimepicker/js/locales/bootstrap-datetimepicker.zh-CN.js" charset="UTF-8"></script>
    <script src="~/Content/QO/layer/layer.js"></script>
    <script src="~/Scripts/plugin/jquery-validate/jquery.validate.min.js"></script>


    <script type="text/javascript">
        //全局数据
        var prdkey;
        var postdata_ext;
        function placeholderSupport() {
            return 'placeholder' in document.createElement('input');
        }
        $(document).ready(function () {
            var dataSel = [{ Code: '1', Name: '启用' }, { Code: '0', Name: '停用' }];
            $("#Status").select2("val", "启用");
            $(dataSel).each(function (k, o) {
                $("#Status").append($("<option></option>").attr("value", o.Code).html(o.Name));
            });
            $("#Status").select2({
                placeholder: "启用状态",
                allowClear: true
            });
            var user = '@Oncontrol3.Web.Helpers.SQMHelper.getStaffKey()';
            $("#user").text(user);
            if (user.length < 1) {
                layer.alert('系统登录已超时，请重新登录', { icon: 2 });
            }
            if (placeholderSupport()) {
                $("label[class='label']").hide();
            }
            var errorClass = 'invalid';
            var errorElement = 'em';

            toastr.options = {
                closeButton: false,
                debug: false,
                progressBar: true,
                positionClass: "toast-top-center",
                onclick: null,
                showDuration: "300",
                hideDuration: "1000",
                timeOut: "3000",
                extendedTimeOut: "1000",
                showEasing: "swing",
                hideEasing: "linear",
                showMethod: "fadeIn",
                hideMethod: "fadeOut"
            };
        });
        function addNew() {
            document.location.href = '/SQM_BJMB/SQM_BJMBEdit';
            return false;
        }
        function doEdit(RID) {
            document.location.href = '/SQM_BJMB/SQM_BJMBEdit?RID=' + RID;
        }
        function doDelete(RID) {
            Ewin.alert(TEMPLATENAME);
        }
        $("#toxj").click(function () {
            location.href = "/SQM_ENQUIRY_HKY/QuiryHyIndex";
        })
        $("#tocpzs").click(function () {
            location.href = "/SQM_CPZS/Index";
        })
        $("#btnadd").click(function () {
            $("#chooseORG").modal("show");
            //addNew();
            return false;
        });
        //选组织取消按钮
        function btnCancel() {
            $("#chooseORG").modal("hide");
        }
        $("#tobjsy").click(function () {
            location.href = "/QM_Price/QM_PriceIndex";
        })
        $("#submit_search").click(function () {
            $('#datatable_col_reorder').DataTable().search("").draw();
            return false;
        });
        $(document).ready(function () {
            $("#amenufld").trigger("click");
            $("#amenufld").css("display", "none");
            $("#logout").css("display", "none");
            $("#fixedleftnum").val($.cookie("bjfixedcol") || 4);
            DrawTable();
            $("div[class='ColVis']").hide();
            detectmob();
        });
        function DrawTable() {
            //列定义
            var columns = [{
                "title": "序号",
                "data": null,
                "width": "30"
            },
            {
                "title": "操作",
                "data": "RID",
                "width": "40",
                render: function (data, type, row, meta) {
                    return '<button title="编辑" class="btn btn-xs btn-default" onclick=doEdit(\"' + data + '\") ><i class="fa fa-pencil"></i></button>';

                }
            },
            { "title": "模板名称", "data": "TEMPLATENAME", "width": "120", },
            { "title": "模板类型", "data": "TEMPLATETYPE", "width": "280" },

            {
                "title": "启用状态",
                "data": "STATUS",
                "width": "100",
                render: function (data, type, full, meta) {
                    if (full.STATUS == 1) {
                        return "启用";
                    } else if (full.STATUS == 0) {
                        return "停用";
                    } else {
                        return "";
                    }
                }
            },
            {
                "title": "最新更新时间", "data": "MODIFYTIME", "width": "120",
                "render": function (data, type, full, meta) {
                    if (data != null) {
                        return data.subDate();
                    } else {
                        return "";
                    }
                }
            },
            {
                "title": "最新更新人", "data": "MODIFYNAME", "width": "100", "render":
                function (data, type, full, meta) {
                    if (full.MODIFYNAME == null || full.MODIFYNAME == undefined) {
                        if (full.CREATENAME) {
                            return full.CREATENAME;
                        }
                    } else {
                        return full.MODIFYNAME;
                    }
                }
            },
            { "title": "说明", "data": "REMARK", "width": "300" }
            ];
            var table = $('#datatable_col_reorder').dataTable({
                "processing": true,
                "serverSide": true,
                "colReorder": true,
                //"fixedHeader": true,scrollY:"80px",
                @*"aoColumnDefs":[{"aTargets":[1],"mRender":function(data,type,full){
                    return "<a href="@Url.Action("ZbgztIndex", "AirInReport")" data-toggle=\"modal\" onclick=\"preUpdate(‘"+data+"‘)\"> <i class=\"fa fa-lg-2 fa-pencil\"> </i> </a> "}
                }],*@
                "scrollX": true,
                "fixedColumns": {
                    leftColumns: $.cookie("bjfixedcol") || $("#fixedleftnum").val()
                },
                "bSort": true, //排序功能
                "bStateSave": true,
                "order": [[4, "asc"]],
                "fnDrawCallback": function () {
                    var api = this.api();
                    var startIndex = api.context[0]._iDisplayStart;        //获取到本页开始的条数 　
                    api.column(0).nodes().each(function (cell, i) {
                        cell.innerHTML = startIndex + i + 1;
                    });
                },
                //"fnRowCallback": function (nRow, aData, iDisplayIndex) {
                //    $("td:first", nRow).html(iDisplayIndex + 1);//设置序号位于第一列，并顺次加一
                //    return nRow;
                //},
                "language": {
                    "info": "第 _START_ 到 _END_ 条记录，共 _TOTAL_ 条",
                    "infoEmpty": "第 0 到 0 条记录，共 0 条",
                    'emptyTable': '没有检索到数据',
                    'zeroRecords': '没有检索到数据',
                    'loadingRecords': '加载中...',
                    'processing': '查询中...',
                    "paginate": { "first": "<<", "last": ">>", "next": ">", "previous": "<" }
                },//语言
                "sDom": "<'dt-toolbar'<'col-xs-12 col-sm-6'><'col-sm-6 col-xs-12 hidden-xs'>r>" + "t" +
                    "<'dt-toolbar-footer'<'col-sm-6 col-xs-12 hidden-xs'i><'col-xs-12 col-sm-6'plC>>",//整个griddom布局
                "lengthMenu": [[4, 10, 20, 50, 100], [4, 10, 20, 50, 100]],//每页显示key text
                "displayLength": 10,//默认每页显示条目数
                "ajax": {
                    "url": "@Url.Action("Lists")",//数据源controller
                    "type": "POST",
                    "data": function (d) {//查询参数
                        d.sort = d.columns[d.order[0].column].data;//排序列名转换
                        d.order = d.order[0].dir;//asc or desc
                        d.TEMPLATENAME = $("#TEMPLATENAME").val() + "";
                        d.STATUS = $("#Status").val() + "";
                        d.PERSONALMB = $("#personalMB").is(":checked") == true ? "个人模板" : "";
                        d.PUBLICMB = $("#publicMB").is(":checked") == true ? "公共模板" : "";
                    }
                }, columns: columns,
                "stateSaveParams": function (settings, data) {
                    localStorage.setItem('DataTables_' + settings.sInstance, JSON.stringify(data));
                    // 把这些数据保存在服务器上，上面的代码标识使用本地储存来存储这些数据
                    /**$.ajax( {
                            "url": "/state_save",
                            "data": data,
                            "dataType": "json",
                            "type": "POST",
                            "success": function () {}
                        } );
                     **/

                },
                "stateLoadCallback": function (settings) {
                    //console.log("stateLoadCallback");
                    var config = JSON.parse(localStorage.getItem('DataTables_' + settings.sInstance));
                    return config;
                    //从服务器取数，采用同步的方式获取到保存在服务器里的数据
                    /**var o;
                     $.ajax( {
                        "url": "/state_load",
                        "async": false,
                        "dataType": "json",
                        "success": function (json) {
                            o = json;
                        }
                    } );
                     return o;**/
                }

            });
        };

        String.prototype.subDate = function () {
            return this.substring(0, this.indexOf('T'));
        }
        // 新建模板
        $("#btnSaveOrg").click(function () {
            document.location.href = "/SQM_BJMB/SQM_BJMBEdit?orgrid=" + $("#ORGRID").val() + "&orgname=" + escape($(".select2-chosen").text());
        });
    </script>
}

