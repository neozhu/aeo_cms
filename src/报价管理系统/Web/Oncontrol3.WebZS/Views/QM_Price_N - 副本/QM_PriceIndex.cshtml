                var ZVER = allPriceArray[i].ZVER;
                if (ZVER == null) {
                    ZVER = "";
                }
                var BPNAME = allPriceArray[i].BPNAME;
                if (BPNAME == null) {
                    BPNAME = "";
                }
                var MODIFYTIME = allPriceArray[i].MDTIME;
                if (MODIFYTIME == null) {
                    MODIFYTIME = "";
                }

                if (i < 16) {
                    pricemsg += '<div class="col-md-3 card"><div class="card-box" style= "height:120px;" ><div class="card-box-content"><div title=' + BJNAME + '>' + BJNAME.substring(0, 14) + '<span class="widget-icon dis " style="margin-top: -4px;"><i class="fa fa-times doDelete1" rid = ' + allPriceArray[i].RID + ' title="删除"></i></span><span class="widget-icon dis "><i class="fa fa-edit doEdit1" rid = ' + allPriceArray[i].RID + '></i></span></div><div class="inf"><span class="address">版本信息</span><span class="dis address">' + ZVER + '</span><span class="address">' + STATUS + '</span></div><div><span class="address">' + BPNAME + '</span></div><div class="inf"><span class="address">更新时间</span><span class="dis address">' + MODIFYTIME.subDate() + '</span></div></div></div></div>';
                } else {
                    pricemsg += '<div class="col-md-3 card hiddendiv"><div class="card-box" style= "height:120px;" ><div class="card-box-content"><div title=' + BJNAME + '>' + BJNAME.substring(0, 14) + '<span class="widget-icon dis " style="margin-top: -4px;"><i class="fa fa-times doDelete1" rid = ' + allPriceArray[i].RID + ' title="删除"></i></span><span class="widget-icon dis "><i class="fa fa-edit doEdit1" rid = ' + allPriceArray[i].RID + '></i></span></div><div class="inf"><span class="address">版本信息</span><span class="dis address">' + ZVER + '</span><span class="address">' + STATUS + '</span></div><div><span class="address">' + BPNAME + '</span></div><div class="inf"><span class="address">更新时间</span><span class="dis address">' + MODIFYTIME.subDate() + '</span></div></div></div></div>';
                }
            }
            pricemsg += '<div class="col-md-12" id="Fbpricemore">更多</div>';
            $("#FbPrice").append(pricemsg);
            //非标报价编辑
            $(".doEdit1").click(function () {
                localStorage.setItem("ver", "");
                localStorage.setItem("SendStatus", "");
                location.href = "/QM_Price/QM_PriceEdit?state=false&keyValue=" + $(this).attr('rid');
            });
            //删除非标报价
            $(".doDelete1").click(function () {
                bjmrid = $(this).attr('rid');
                popDialog("删除", "确定要删除该报价吗？", deleteBj);
            });
            //展开更多报价
            $("#Fbpricemore").click(function () {
                $("#FbPrice .hiddendiv").toggle();
            });
        }
        // modal 对话框
        function popDialog(title, msg, callbackyes, callbackno) {
            if (!title) {
                title = '对话框';
            }
            var dialogHTML = '<div id="selfDialog" class="modal fade">';
            dialogHTML += '<div class="modal-dialog">';
            dialogHTML += '<div class="modal-content">';
            dialogHTML += '<div class="modal-header">';
            dialogHTML += '<button type="button" class="close" data-dismiss="modal" aria-label="Close">';
            dialogHTML += '<span aria-hidden="true">&times;</span>';
            dialogHTML += '</button>';
            dialogHTML += '<h4 class="modal-title">' + title + '</h4>';
            dialogHTML += '</div>';
            dialogHTML += '<div class="modal-body">';
            dialogHTML += msg;
            dialogHTML += '</div>';
            dialogHTML += '<div class="modal-footer">';
            dialogHTML += '<button type="button" class="btn btn-default" data-dismiss="modal" id="buttonno">否</button>';
            dialogHTML += '<button type="button" class="btn btn-primary" data-dismiss="modal" id="buttonyes">是</button>';
            dialogHTML += '</div>';
            dialogHTML += '</div>';
            dialogHTML += '</div>';
            dialogHTML += '</div>';

            $("#selfDialog").remove();
            $("body").append(dialogHTML);
            $("#selfDialog").modal("show");
            // 绑定"是"方法
            $("#buttonyes").click(function () {
                if (typeof callbackyes == "function") {
                    callbackyes();
                }
            });
            // 绑定"否"方法
            $("#buttonno").click(function () {
                if (typeof callbackno == "function") {
                    callbackno();
                }
            });
        }
    </script>
}

