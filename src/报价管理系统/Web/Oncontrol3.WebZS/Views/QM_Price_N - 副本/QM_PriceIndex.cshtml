<div class="row" style="text-align:center;">
    <div class="btn-group btn-group-lg">
        <button type="submit" class="btn btn-default btns" id="btnAddNew">新建报价</button>
        <button type="submit" class="btn btn-default btns" id="clickme" style="display:none;">clickme</button>
    </div>
</div>
<div class="row">
    <div class="container" style="width:100%;">
        <nav class="navbar navbar-default" style=" margin:0 0 0 0;">
            <div class="container-fluid font" style="text-align:center;">
                客户商机报价
            </div>
            <div class="col-md-12 search">
                <div class="col-md-1">
