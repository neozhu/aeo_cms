</div>
<div id="sjbjList">
</div>
<div class="row">
    <div class="container" style="width:100%;">
        <nav class="navbar navbar-default" style=" margin:7px 0 0 0;">
            <div class="container-fluid font" style="text-align:center;">
                已有报价
            </div>
            <div class="col-md-12 search">
                <div class="col-md-1">
                    <label class="label label label-default">报价名称</label>
                </div>
                <div class="col-md-3" style="margin-top: -10px;padding-bottom: 20px;">
                    <input type="text" class="form-control" placeholder="请输入报价名称" id="BJTEMPLATENAME">
                </div>
                <div class="btn-group col-md-2" style="margin-top: -10px;">
                    <button type="submit" class="btn btn-default" id="btnSearchBJ">查询</button>
                </div>
                <div class="btn-group col-md-2" style="margin-top: -10px;margin-left: -50px;">
                    <button type="submit" class="btn btn-default" id="btnChooseBP">客户查询</button>
