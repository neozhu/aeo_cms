<!-- 选择客户名称 -->
<div class="modal fade" id="chooseBP" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">
                    &times;
                </button>
                <h4 class="modal-title">
                    选择客户
                </h4>
            </div>
            <div class="modal-body">
                <div>
                    <div id="div_bpname"></div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- 选择组织 -->
<div class="modal fade" id="chooseORG" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">
                    &times;
                </button>
                <h4 class="modal-title">
                    选择组织
                </h4>
            </div>
            <div class="modal-body">
                <form id="formmain" class="smart-form form-backgroud">
                    <fieldset style="padding-top:5px">
                        <select style="width:100%" id="ORGRID" name="ORGRID" class="select2" placeholder="组织名称">
                            <option value=""></option>
                            @for (int i = 0; i < orgdt.Rows.Count; i++)
                            {
                                <option value="@orgdt.Rows[i]["RID"]">@orgdt.Rows[i]["ORGNAME"]-@orgdt.Rows[i]["RID"]</option>
                            }
                        </select>
                    </fieldset>
                    <footer>
                        <button class="btn btn-primary" id="btnSaveOrg" onclick="return false;">
                            保存
                        </button>
                        <button class="btn btn-primary" onclick="btnCancel(); return false;">
                            取消
                        </button>
                    </footer>
                </form>
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="container" style="width:100%;">
        <nav class="navbar navbar-default" style=" margin:7px 0 0 0;">
            <div class="container-fluid font" style="text-align:center;">
                非标报价
            </div>
            <div class="col-md-12 search">
                <div class="col-md-1">
                    <label class="label label label-default">报价名称</label>
                </div>
                <div class="col-md-3" style="margin-top: -10px;padding-bottom: 20px;">
                    <input type="text" class="form-control" placeholder="请输入报价名称" id="BFTEMPLATENAME">
                </div>
                <div class="btn-group col-md-2" style="margin-top: -10px;">
                    <button type="submit" class="btn btn-default" id="btnFB">查询</button>
                </div>
                <div class="btn-group col-md-2" style="margin-top: -10px;margin-left: -50px;">
                    <button type="submit" class="btn btn-default" id="btnFBBP">客户查询</button>
                </div>
            </div>
        </nav>
        <div id="FbPrice" class="row"></div>
    </div>
</div>
@section pagespecific {
    <script src="~/Content/QO/scripts/framework.js?v=@DateTime.Now.ToString("yyyyMMddhhmmss")"></script>
    <script src="~/Content/QO/scripts/Ewin.js"></script>
    <script src="/js/lib/jquery.plug-ins.js" type="text/javascript"></script>
    <script src="/scripts/plugin/datatables/dataTables.colReorder.min.js" type="text/javascript"></script>
    <script src="/scripts/plugin/datatables/dataTables.colVis.min.js" type="text/javascript"></script>
    <script src="/scripts/plugin/datatables/dataTables.fixedColumns.min.js" type="text/javascript"></script>
    <script src="/scripts/plugin/datatables/dataTables.fixedHeader.js" type="text/javascript"></script>
    <script src="~/Content/QO/toastr/toastr.min.js"></script>
    <link rel="stylesheet" href="~/Content/QO/toastr/toastr.min.css">
    <link href="~/Content/QO/scripts/bootstrap-datetimepicker/css/bootstrap-datetimepicker.min.css" rel="stylesheet">
    <script src="~/Content/QO/scripts/bootstrap-datetimepicker/js/bootstrap-datetimepicker.min.js"></script>
    <script type="text/javascript" src="~/Content/QO/scripts/bootstrap-datetimepicker/js/locales/bootstrap-datetimepicker.zh-CN.js" charset="UTF-8"></script>
    <script src="~/Scripts/plugin/jquery-validate/jquery.validate.min.js"></script>
    <script src="~/Content/QO/layer/layer.js"></script>
    <script type="text/javascript">
        //全局变量
        var PRDRes;
        var CustomRes;
        var PRDArray = [];
        var user;
        var bjmrid = '';
        $(document).ready(function () {
            user = '@Oncontrol3.Web.Helpers.SQMHelper.getStaffKey()';
            $("#user").text(user);
            if (user.length < 1) {
                layer.alert('系统登录已超时，请重新登录', { icon: 2 });
            }
            $("#amenufld").trigger("click");
            toastr.options = {
                closeButton: false,
                debug: false,
                progressBar: true,
                positionClass: "toast-top-center",
                onclick: null,
                showDuration: "300",
                hideDuration: "1000",
                timeOut: "3000",
                extendedTimeOut: "1000",
                showEasing: "swing",
                hideEasing: "linear",
                showMethod: "fadeIn",
                hideMethod: "fadeOut"
            };
            showPRD();
            showAllPrice();
            showCustom();
            showFbPrice();
        });


        function sjEdit() {
            location.href = "/QM_SJBJ/QM_SJBJEdit"
        }

        //新建报价
        $("#btnAddNew").click(function () {
            toastr.clear();
            toastr.remove();
            var count = 0;
            $(".card-box button").each(function () {
                if ($(this).hasClass("btnclicked")) {
                    count++;
                    return false;
                }
            });
            if (count != 0) {
                $("#chooseORG").modal("show");
            } else {
                toastr.error("请选择产品再进行报价！");
            }
        });
        $("#btnSaveOrg").click(function () {
            var Array = [];
            $(".card-box button").each(function () {
                if ($(this).hasClass("btnclicked")) {
                    PRDArray.push($(this).attr("name"))
                    var obj = { prdcode: $(this).attr("code"), prdname: $(this).attr("name"), businessorg: $(this).attr("flag") };
                    Array.push(obj);
                }
            });
            var keyValue = "";
            //新增报价
            $.ajax({
                url: "@Url.Action("AddNewPrice")",
                data: {
                    postdata: JSON.stringify(Array),
                    orgrid: $("#ORGRID").val(),
                    orgname: $(".select2-chosen").text(),
                },
                dataType: "json",
                async: false,
                success: function (data) {
                    keyValue = data;
                }
            })
            location.href = "/QM_Price/QM_PriceEdit?keyValue=" + keyValue;
        });
        //选组织取消按钮
        function btnCancel() {
            $("#chooseORG").modal("hide");
        }
        //选组织保存按钮

        $("#toxj").click(function () {
            location.href = "/SQM_ENQUIRY_HKY/QuiryHyIndex";
        })


        $("#tobjsy").click(function () {
            location.href = "/QM_Price/QM_PriceIndex";
        })

        $("#tobjmb").click(function () {
            location.href = "/SQM_BJMB/SQM_BJMBIndex";
        })

        $("#tocpzs").click(function () {
            location.href = "/SQM_CPZS/Index";
        })
        //截取产品名称
        String.prototype.trim = function () {
            if (this.length > 6) {
                return this.substring(0, 5) + "...";
            } else {
                return this;
            }
        }

        //日期字符串统一处理
        String.prototype.subDate = function () {
            return this.substring(0, this.indexOf('T'));
        }

        //产品信息展示
        function showPRD() {
            $.ajax({
                url: "@Url.Action("GetPrdFromCrm")",
                data: {
                    userid: "",
                    FromSystem:""//"XSY"
                },
                dataType: "json",
                async: false,
                success: function (data) {
                    console.log(data);
                    PRDRes = data;
                    //将所有的产品信息放在localstorage中便于其他页面拿数据
                    localStorage.setItem("PRDmsg", data);
                }
            });
            var hymsg = "";
            var hycount = 0;
            var kymsg = "";
            var kycount = 0;
            var gylmsg = "";
            var gylcount = 0;
            var ysmsg = "";
            var yscount = 0;
            for (var i = 0; i < PRDRes.length; i++) {
                switch (PRDRes[i].DIVISION) {
                    case "海运":
                        hycount++;
                        if (hycount <= 6) {
                            hymsg += "<div class='btn-group btn-group-lg col-md-4' style = 'margin-bottom: 10px;'><button type='submit' title='" + PRDRes[i].PRODUCTSNAME + "' class='btn btn-block' flag='海运' code='" + PRDRes[i].PRODUCTDESCRIPTION + "' name = '" + PRDRes[i].PRODUCTSNAME + "'>" + PRDRes[i].PRODUCTSNAME.trim() + "</button></div>";
                        } else {
                            hymsg += "<div class='btn-group btn-group-lg col-md-4 hiddendiv' style = 'margin-bottom: 10px;'><button type='submit' title='" + PRDRes[i].PRODUCTSNAME + "' class='btn btn-block' flag='海运'  code='" + PRDRes[i].PRODUCTDESCRIPTION + "' name = '" + PRDRes[i].PRODUCTSNAME + "'>" + PRDRes[i].PRODUCTSNAME.trim() + "</button></div>";
                        }
                        break;
                    case "空运":
                        kycount++;
                        if (kycount <= 6) {
                            kymsg += "<div class='btn-group btn-group-lg col-md-4' style = 'margin-bottom: 10px;'><button type='submit' title='" + PRDRes[i].PRODUCTSNAME + "' class='btn btn-block' flag='空运'  code='" + PRDRes[i].PRODUCTDESCRIPTION + "' name = '" + PRDRes[i].PRODUCTSNAME + "'>" + PRDRes[i].PRODUCTSNAME.trim() + "</button></div>";
                        } else {
                            kymsg += "<div class='btn-group btn-group-lg col-md-4 hiddendiv' style = 'margin-bottom: 10px;'><button type='submit' title='" + PRDRes[i].PRODUCTSNAME + "' class='btn btn-block' flag='空运'  code='" + PRDRes[i].PRODUCTDESCRIPTION + "' name = '" + PRDRes[i].PRODUCTSNAME + "'>" + PRDRes[i].PRODUCTSNAME.trim() + "</button></div>";
                        }
                        break;
                    case "供应链":
                        gylcount++;
                        if (gylcount <= 6) {
                            gylmsg += "<div class='btn-group btn-group-lg col-md-4' style = 'margin-bottom: 10px;'><button type='submit' title='" + PRDRes[i].PRODUCTSNAME + "' class='btn btn-block' flag='供应链'  code='" + PRDRes[i].PRODUCTDESCRIPTION + "' name = '" + PRDRes[i].PRODUCTSNAME + "'>" + PRDRes[i].PRODUCTSNAME.trim() + "</button></div>";
                        } else {
                            gylmsg += "<div class='btn-group btn-group-lg col-md-4 hiddendiv' style = 'margin-bottom: 10px;'><button type='submit' title='" + PRDRes[i].PRODUCTSNAME + "' class='btn btn-block' flag='供应链' code='" + PRDRes[i].PRODUCTDESCRIPTION + "' name = '" + PRDRes[i].PRODUCTSNAME + "'>" + PRDRes[i].PRODUCTSNAME.trim() + "</button></div>";
                        }
                        break;
                    case "运输":
                        yscount++;
                        if (yscount <= 6) {
