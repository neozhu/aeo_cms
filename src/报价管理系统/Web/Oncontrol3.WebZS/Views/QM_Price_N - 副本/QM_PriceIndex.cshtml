@{
    ViewBag.Title = "报价列表";
    Layout = "~/Views/Shared/_LayoutTM.cshtml";
}
@{
    System.Data.DataTable orgdt = (System.Data.DataTable)ViewBag.OrgData;
}
<style>
    _::-webkit-full-page-media, _:future, :root .row {
        padding-right: 15px; /*jnp add for ipad*/
    }

    body {
        background-color: rgb(248, 248, 248);
    }

    .row {
        margin-top: 15px;
    }

    .head {
        height: 50px;
        background-color: rgb(19, 100, 181);
    }

        .head span {
            line-height: 98px;
            font-size: 14px;
            padding: 0px 10px 15px 10px;
            color: #ffffff;
            margin-right: 35px;
            cursor: pointer;
        }

        .head .active {
            border-bottom: 2px solid #F8F8F8;
        }

    nav {
        border: 1px solid #ddd;
    }

    .font {
        line-height: 76px;
        background-color: #ffffff;
        font-size: 24px;
        color: rgb(101, 101, 101);
        border-radius: 8px;
    }

    .card-box {
        border: 1px solid #ddd;
        border-radius: 4px;
        background-color: #ffffff;
    }

    .title {
        font-size: 16px;
        color: #000000;
    }

    #kymore, #hymore, #gylmore, #ysmore {
        color: rgb(148, 148, 148);
    }

    .btn {
        height: 50px;
        border: 1px solid #ccc;
        background-color: rgb(244, 244, 244);
    }

    #btnAddNew {
        width: 150px;
        height: 50px;
        background-color: #ffffff;
        border: 1px solid rgb(19, 100, 181);
        color: rgb(19, 100, 181);
        font-size: 18px;
        border-radius: 4px;
    }

    .search {
        background-color: #ffffff;
    }

    .label {
        background-color: #ffffff;
        font-size: 16px;
        color: #000;
        font-weight: 100;
        vertical-align: middle;
    }

    input.form-control {
        border: 1px solid #ddd;
        height: 40px;
        border-radius: 4px !important;
    }

    #btnSearchSJ {
        height: 40px;
        width: 95px;
        background-color: rgb(19, 100, 181);
        border-radius: 4px;
        border: none;
        color: #ffffff;
        font-size: 16px;
    }

    #btnSearchBJ, #btnChooseBP, #btnFB, #btnFBBP {
        height: 40px;
        width: 95px;
        background-color: rgb(19, 100, 181);
        border-radius: 4px;
        border: none;
        color: #ffffff;
        font-size: 16px;
    }

    #sjbjList table {
        margin-top: 30px;
    }

        #sjbjList table tr td {
            background-color: #ffffff;
        }

        #sjbjList table .card-box {
            border: none;
        }

        #sjbjList table tr td p {
            font-size: 15px;
            margin-top: 10px;
            color: rgb(88, 88, 88);
            overflow: visible;
        }

            #sjbjList table tr td p span {
                color: #999;
                margin-right: 20px;
            }

    #custommore, #pricemore, #Fbpricemore {
        line-height: 60px;
        width: 100%;
        text-align: center;
        font-size: 18px;
        color: #999;
        background-color: #ffffff;
        /*margin-top: -18px;*/
    }

    #allPrice, #FbPrice {
        /*background-color: #ffffff;*/
        background-color: #efefef;
        padding: 13px;
        margin: 0;
    }

        #allPrice .col-md-3 {
            padding: 0;
        }

        #allPrice card .card-box {
            border: none;
        }

        #allPrice card .service {
            float: left;
            font-size: 18px;
        }

        #allPrice card i {
            font-size: 18px;
            color: #999;
        }

        #allPrice .card .widget-icon, #FbPrice .card .widget-icon {
            float: right;
            cursor: pointer;
            font-size: 16px;
            margin: 0px 6px;
        }

        #allPrice .address {
            padding-right: 50px;
            color: #999;
        }

        #allPrice .inf span:not(:first-child) {
            text-align: center;
        }

        #FbPrice .col-md-3 {
            padding: 0;
        }

        #FbPrice card .card-box {
            border: none;
        }

        #FbPrice card .service {
            float: left;
            font-size: 18px;
        }

        #FbPrice card i {
            font-size: 18px;
            color: #999;
        }

        #FbPrice .address {
            /*display: inline-block;
        width: 99px;*/
            margin-right: 50px;
            color: #999;
        }

        #FbPrice .inf span:not(:first-child) {
            text-align: center;
        }

    .doEdit, .doEdit1 {
        float: right;
    }

    .title i {
        color: rgb(153, 153, 153);
        font-size: 16px;
        margin-right: 10px;
    }

    .customName p:last-child span {
        font-size: 14px;
    }

    .btnclicked {
        box-sizing: border-box;
        /*background-color: rgb(19,100,181);*/
        border-style: solid;
        border-width: 2px;
        border-color: rgb(19, 100, 181);
    }

    .card-box-content {
        padding: 6px 10px;
        font-size: 14px;
        color: #4d5d70;
    }

        .card-box-content div {
            overflow: visible;
            white-space: nowrap;
            /*text-overflow: ellipsis;*/
            margin-top: 6px;
        }
        /*
            .card-box-content div .address {
                font-size: 12px;
                color: #999999;
            }

            .card-box-content div span {
                float: left;
            }

            .card-box-content div .amount {
                text-align: right;
                width: 50px;
                color: #d0031c;
            }

            .card-box-content div .dis {
                margin-left: 30px;
            }*/
        .card-box-content .inf {
            /*font-weight: bold;*/
        }

        .card-box-content div .tel-num {
            width: 80px;
        }

        .card-box-content div .pickup_btn {
            float: right;
            margin-left: 56px;
            font-size: 9px;
            line-height: 18px;
            width: 70px;
            height: 18px;
            background-color: #319adf;
            color: white;
            text-align: center;
            border-radius: 8px;
        }

    .btns {
        margin-top: 8px;
        margin-bottom: 8px;
    }
    /*.title{
        color:red;
        font:12px;
    }*/
    .head {
        color: #999;
        margin-top: 7px;
        margin-bottom: 7px;
    }

    .hiddendiv {
        display: none;
    }

    .customName {
        margin: 10px 0 10px 0;
    }

    .bpdiv {
        display: inline;
        margin-left: 13px;
    }

    .bpbutton {
        width: 250px;
        height: 50px;
    }

    .btn-primary {
        background-color: #3276b1;
        border-color: #2c699d;
    }
</style>
