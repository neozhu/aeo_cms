        // 两个数组取交集
        function arrayInterSection(a, b) {
            var ai = 0;
            var bi = 0;
            var result = [];
            // 适用有序数组
            //while (ai < a.length && bi < b.length) {
            //    if (a[ai] < b[bi]) {
            //        ai++;
            //    } else if (a[ai] > b[bi]) {
            //        bi++;
            //    } else {
            //        result.push(a[ai]);
            //        ai++;
            //        bi++;
            //    }
            //}
            for (var i = a.length - 1; i >= 0 ; i--){
                for (var j = b.length - 1; j >= 0; j--){
                    if (a[i] == b[j]){
                        result.push(a[i]);
                        a.splice(i,1);
                        b.splice(j,1);
                        break;
                    }
                }
            }
            return result;
        }
