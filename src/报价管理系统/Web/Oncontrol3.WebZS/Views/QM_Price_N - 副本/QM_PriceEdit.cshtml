            var fee = "&feecodes=";
            var mrid = "&mrid="+request("keyValue");
            var zver = "&zver="+$("#zversion_cb").val();
            for (var s = 0; s < PSFdata[pcode].length; s++) {//服务
                var sfObj = PSFdata[pcode][s];
                //for (var i = 0; i < sfObj[srvcode].length; i++) {
                //    fee += sfObj[srvcode][i] + ",";
                //}
                for (var service in sfObj) {// 费目
                    if (srvcode == service) {
                        for (var i = 0; i < sfObj[service].length; i++) {
                            fee += sfObj[service][i] + ",";
                        }
                        break;
                    }
                }
            }
            fee = fee.substr(0, fee.length - 1);
            $.ajax({
                url: "@Url.Action("ZLJ")",
                type: "get",
                data: "srvcode=" + srvcode+fee+mrid+zver,
                success: function (data) {
                    data = $.parseJSON(data);
                    var ul = $("#zl_div_" + pcode + "_" + srvcode + " ul");
                    $(ul).html("");
                    if (!!data && data.length > 0) {
                        for (var i = 0; i < data.length; i++) {
                            $(ul).append("<li>" + (i+1) + ". " + data[i]["INSNAME"] + "</li>");
                        }
                    } else {
                        $(ul).append("<li>未获取到相关指令！</li>")
                    }
                }, error: function (data) {
                    toastr.error("未获取到相关指令！");
                }
            })
        }
        //获取指令
        $(document).ready(function(){
            $("span[name=zl]").on("click", function(e){
                var pcode = $(this).attr("id").split("_")[1];
                var srvcode = $(this).attr("id").split("_")[2];
                if (!!srvcode) {
                    if ($("#zl_div_" + pcode + "_" + srvcode).hasClass("zldiv")) {
                        getZLJ(srvcode, pcode);
                    }
                    $(".zlbox").each(function(){
                        if ($(this).attr("id")=="zl_div_" + pcode + "_" + srvcode) {
                            if ($(this).css("display")=="block") {
                                $(this).hide();
                            }else {
                                $(this).show();
                            }
                        }else {
                            $(this).hide();
                        }
                    });
                }
                $(document).one("click", function(){
                    $(".zlbox").hide();
                });
                e.stopPropagation();
                $(".zlbox").on("click", function(e){
                    e.stopPropagation();
                });
            });
        });


    </script>
}
