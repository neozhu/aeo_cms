        //保存版本信息
        function saveVer() {
            var verdtto = $("#VERDTTO").val();
            var verdtfrom = $("#VERDTFROM").val();
            var rid = $("#ZVER").attr("rid");
            var vermemo = $("#VERMEMO").val();
            var contrsctnum = $("#CONTRSCTNUM").val();
            var bpcode = $("span#bpCode").text();
            if(bpcode == ""){
                toastr.error("保存失败:请先选择客户！")
            }else{
                $.ajax({
                    url: "@Url.Action("saveVer")",
                    async: false,
                    data: {
                        verdtto: verdtto,
                        verdtfrom: verdtfrom,
                        rid: rid,
                        vermemo: vermemo,
                        contrsctnum: contrsctnum,
                        bpcode:bpcode

                    },
                    dataType: "json",
                    success: function (data) {
                        if (data.Success) {
                            toastr.success(data.Message);
                            setTimeout(function () { location.reload() }, 500);
                        } else {
                            toastr.error(data.Message);
                        }
                    }
                })
            }
            return false;
        }

        function deleteVer(){
            var vrid = $("#ZVER").attr("rid");
            var status = $("#btntm").attr("status");
            var statustm=$("#btntm").attr("statustm");
            var flag = true;
            if(status == "6"){
                toastr.error("作废失败！已经是作废状态。")
                flag = false;
            }
            if(statustm != ""){
                toastr.error("作废失败！已提交TM。")
                flag = false;
            }
            if(flag==true){
                $.ajax({
                    url: "@Url.Action("deleteVer")",
                    data: {
                        vrid: vrid,
                    },
                    async: false,
                    dataType: "json",
                    success: function (data) {
                        if (data.Success) {
                            toastr.success(data.Message);
                            setTimeout(function () { location.reload() }, 500);
                        } else {
                            toastr.error(data.Message);
                        }
                    }
                })
            }

        }
