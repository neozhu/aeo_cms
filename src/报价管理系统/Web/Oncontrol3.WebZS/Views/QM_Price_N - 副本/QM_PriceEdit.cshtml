        function StartFlow() {
            var reason = "";
            var reasonother = "";
            var reasonname = "";
            if (!FBstate) { // 非标报价，保存非标原因
                var fbReason = $("#FBREASONCODE").val();
                if (!fbReason) {
                    toastr.error("提交失败：请先选择非标原因。");
                    return;
                }
                $("#FBREASONCODE").select2("data").forEach(function (item, index) {
                    reasonname += item.id + ":" + item.text.replace(/--\d*/g,'') + ",";
                });
                reasonname = reasonname.replace(/,$/g, '');
                reason = fbReason.join();
                if ($.inArray('04', fbReason) >= 0) {
                    if (!$("#FBMEMO").val()) {
                        toastr.error("提交失败：请填写非标备注。");
                        return;
                    }
                    //reasonother = $("#FBREASONOTHER").val();
                    //if (!reasonother) {
                    //    toastr.error("提交失败：非标其他原因必填。");
                    //    return;
                    //}
                }
            }
            if($("#MEMO").val() != ""||reason||$("#FBMEMO").val()){
                var memo = $("#MEMO").val();
                $.ajax({
                    url: "@Url.Action("SetMemo")",
                    data: {
                        vrid: $("#bjmb").attr('vrid'),
                        memo: memo,
                        fbreason: reason,
                        fbreasonother: reasonother,
                        fbreasonname:reasonname,
                        fbmemo:$("#FBMEMO").val()
                    },
                    dataType: "json",
                    async: false,
                })
            }
            // return;
            if($("span#uploadfile").text()!="" ||$("span#uploadfile2").text()!=""){
                if($("span#bpCode").text()==""){
                    toastr.error("提交失败：请先选择客户。");
                }else{
                    $.ajax({
                        url: "@Url.Action("CGSCWorkFlowXML")",
                        data: {
                            rid: request("keyValue"),
                            vrid: $("#bjmb").attr('vrid')
                            //webport: "8041"
                        },
                        dataType: "json",
                        async: false,
                        success: function (data) {
                            if (data.Message == "提交成功") {
                                toastr.success(data.Message);
                                window.location.reload();
                            } else {
                                toastr.error(data.Message);
                            }
                        }
                    })
                }
            }else{
                toastr.error("无报价文件,请上传。");
            }
        }
