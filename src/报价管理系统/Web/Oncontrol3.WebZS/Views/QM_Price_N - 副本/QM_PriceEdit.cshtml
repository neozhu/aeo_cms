        // 匹配提示信息
        function matchMessage(curp, mbp, verid, data) {
            var curpArr = [];
            var mbpArr = [];
            var curpObj = {};
            var message = "当前报价产品：<BR>";
            curp.forEach(item => {
                curpArr.push(item["PRODUCT_CODE"]);
            curpObj[item["PRODUCT_CODE"]] = item["PRODUCT_NAME"];
            message += "\"" + item["PRODUCT_NAME"] + "(" + item["PRODUCT_CODE"] + ")" + "\"" + "<BR>";
        });
        message += "模板产品：<BR>";
        mbp.forEach(item => {
            mbpArr.push(item["PRODUCT_CODE"]);
        message += "\"" + item["PRODUCT_NAME"] + "(" + item["PRODUCT_CODE"] + ")" + "\"" + "<BR>";
        });
        var interArr = arrayInterSection(curpArr, mbpArr);// 取交集，为当前报价产品...将被模板覆盖
        if (interArr.length == 0) {
            message += "当前报价无产品可被模板覆盖。";
        } else {
            var interStr = "";
            for (var i = 0; i < interArr.length; i++){
                interStr += "\"" + curpObj[interArr[i]] + "\",";
            }
            message += "选择\"继续\"当前报价中产品：" + interStr.substring(0, interStr.length - 1) + " 将被模板覆盖。";
        }
        MessageAlert3("消息提示", message, verid, data);
