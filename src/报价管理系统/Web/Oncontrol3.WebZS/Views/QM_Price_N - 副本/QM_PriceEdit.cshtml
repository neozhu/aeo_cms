            window.open("/Excel/output/" + $("#uploadfile2").text());
        }

        
        //显示当前报价的版本信息
        function verTable() {
            var tableArray = [];
            var tablemsg = "";
            $.ajax({
                url: "@Url.Action("verTable")",
                data: {
                    keyvalue: request("keyValue")
                },
                async: false,
                dataType: "json",
                success: function (data) {
                    tableArray = data;
                }
            });
            // 选择最新版本号
            var zvers = localStorage.getItem("ver");
            var zStatus = localStorage.getItem("SendStatus");
            if(zvers!=""&&zvers!=null){
                zversion=zvers;
                SendStatus=zStatus;
            }else{
                zversion = tableArray[0].ZVER;
                SendStatus=tableArray[0].STATUS;
            }
            $("#versionTittle").html("报价版本：" + zversion);
            $("#zversion_cb").val(zversion);
            // 渲染version列表
            for (var i = 0; i < tableArray.length; i++) {
                var bjbh=tableArray[i].FWA==null?'':tableArray[i].FWA;
                var dtfrom = tableArray[i].DTFROM;
                if (dtfrom == null) {
                    dtfrom = "";
                } else {
                    dtfrom = dtfrom.substring(0, dtfrom.indexOf("T"));
                }
                var dtto = tableArray[i].DTTO;
                if (dtto == null) {
                    dtto = "";
                } else {
                    dtto = dtto.substring(0, dtto.indexOf("T"));
                }
                var modifytime = tableArray[i].MODIFYTIME;
                if (modifytime == null) {
                    modifytime = "";
                } else {
                    modifytime = modifytime.subDate();
                }
                //状态判定
                var status = tableArray[i].STATUS;
                if(bjbh != null && bjbh != ""){
                    status = "已提交TM";
                }else{
                    if (status == "0") {
                        status = "已保存";
                    } else if (status == "1") {
                        status = "审批中";
                    } else if (status == "2") {
                        status = "审批通过";
                    } else if (status == "3") {
                        status = "审批退回";
