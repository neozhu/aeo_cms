@{
    ViewBag.title = "移动平台";
    Layout = "~/Views/Shared/_LayoutMobile.cshtml";
}

    <style>
        * {
            padding: 0;
            margin: 0;
        }

        .searchbtn {
            padding: 20px;
            text-align: center;
            margin-top: 90px;
        }

            .searchbtn button {
                width: 100%;
                background: linear-gradient(#D6DBEC,#6F85A2);
            }

        .footer {
            width: 100%;
            height: 45px;
            background-color: #fff;
            position: fixed;
            bottom: 0;
            text-align: center;
            line-height: 45px;
            font-size: 17px;
        }
    </style>

    <div>
        <header></header>
        <div class="row center" style="height:100%">
            <div class="col-xs-12 searchbtn">
                <button class="btn btn-lg btn-default " id="djcx" onclick="javascript: void (0);">定价查询</button>
            </div>
            <div class="col-xs-12 searchbtn" style="margin-top:0px;">
                <button class="btn btn-lg btn-default " id="bjcx" onclick="javascript: void (0);">报价查询</button>
            </div>
        </div>
        <footer class="footer">报价系统</footer>
    </div>
    <script type="text/javascript" src="~/Content/QO/scripts/jquery/jquery-1.10.2.min.js"></script>
<script type="text/javascript" src="~/Content/QO/layer/layer.js"></script>
    <script type="text/javascript">

