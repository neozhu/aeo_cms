@{
    ViewBag.Title = "BP";
    Layout = "~/Views/Shared/_IndexDYXY.cshtml";
}
<script>
    var rtnkey = "";
    var rtncode = "";
    var rtnname = "";
    function GetQueryString(name) {
        var reg = new RegExp("(^|&)" + name + "=([^&]*)(&|$)");
        var r = window.location.search.substr(1).match(reg);
        if (r != null) return unescape(r[2]); return null;
    }

    $(document).ready(function () {
        rtnkey = GetQueryString("rtnkey");
        rtncode = GetQueryString("rtncode");
        rtnname = GetQueryString("rtnname");
    });

    $(function () {
        InitialPage();
        GetGrid();
    });
    //初始化页面
    function InitialPage() {
        //resize重设(表格、树形)宽高
        $(window).resize(function (e) {
            window.setTimeout(function () {
                $('#gridTable').setGridWidth(($('.gridPanel').width()));
                $("#gridTable").setGridHeight($(window).height() - 136.5);
            }, 200);
            e.stopPropagation();
        });
    }
    //加载表格
    function GetGrid() {
        var selectedRowIndex = 0;
        var $gridTable = $('#gridTable');
        $gridTable.jqGrid({
            url: "/BP/Lists",
            datatype: "json",
            height: $(window).height() - 136.5,
            autowidth: true,
            colModel: [
                { label: '主键', name: 'RID', index: 'RID', hidden: true },
                { label: '业务伙伴代码', name: 'BPKEY', index: 'BPKEY', width: 120, align: 'left' },
                { label: '业务伙伴名称', name: 'BPNAME', index: 'BPNAME', width: 140, align: 'left' }
            ],
            viewrecords: true,
            rowNum: 20,
            rowList: [20, 50, 100],
            pager: "#gridPager",
            sortname: 'BPKEY asc,BPNAME desc',
            rownumbers: true,
            shrinkToFit: false,
            gridview: true,
            onSelectRow: function () {
                selectedRowIndex = $("#" + this.id).getGridParam('selrow');
            },
            ondblClickRow: function () {
                selectedRowIndex = $("#" + this.id).getGridParam('selrow');
                btn_add();
            },
            gridComplete: function () {
                $("#" + this.id).setSelection(selectedRowIndex, false);
            }
        });
        //查询事件
        $("#btn_Search").click(function () {
            var queryJson = {
                "BPKey": $("#BPKey").val(),
                "BPName": $("#BPName").val()
            }
            $gridTable.jqGrid('setGridParam', {
                postData: { queryJson: JSON.stringify(queryJson) }, page: 1
            }).trigger('reloadGrid');
        });
        //查询回车
        $('#BPKey').bind('keypress', function (event) {
            if (event.keyCode == "13") {
                $('#btn_Search').trigger("click");
            }
        });
        //查询回车
        $('#BPName').bind('keypress', function (event) {
            if (event.keyCode == "13") {
                $('#btn_Search').trigger("click");
            }
        });
    }

    function btn_add()
    {
        var SELRID = $("#gridTable").jqGridRowValue("RID");
        var SELBPKEY = $("#gridTable").jqGridRowValue("BPKEY");
        var SELBPNAME = $("#gridTable").jqGridRowValue("BPNAME");
        if (SELRID) {
            if (rtnkey != undefined && rtnkey != null && rtnkey.toString().length >= 1) {
                parent.window.$('#' + rtnkey).val(SELRID);
            }
            if (rtncode != undefined && rtncode != null && rtncode.toString().length >= 1) {
                parent.window.$('#' + rtncode).val(SELBPKEY);
            }
            if (rtnname != undefined && rtnname != null && rtnname.toString().length >= 1) {
                parent.window.$('#' + rtnname).html(SELBPNAME);
                parent.window.$('#' + rtnname).attr('title', SELBPNAME);
            }
            dialogClose();
        } else {
            layer.msg('请选择需要添加的BP！');
        }
    }
    function btn_clear() {
        if (rtnkey != undefined && rtnkey != null && rtnkey.toString().length >= 1) {
            parent.window.$('#' + rtnkey).val('');
        }
        if (rtncode != undefined && rtncode != null && rtncode.toString().length >= 1) {
            parent.window.$('#' + rtncode).val('');
        }
        if (rtnname != undefined && rtnname != null && rtnname.toString().length >= 1) {
            parent.window.$('#' + rtnname).html('');
            parent.window.$('#' + rtnname).attr('title', '');
        }
        dialogClose();
    }
</script>
<div class="titlePanel">
    <div class="title-search">
        <table>
            <tr>
                <td style="padding-left: 2px;">
                    <input id="BPKey" type="text" class="form-control" placeholder="业务伙伴代码" style="width: 100px;" />
                </td>
                <td style="padding-left: 2px;">
                    <input id="BPName" type="text" class="form-control" placeholder="业务伙伴名称" style="width: 100px;" />
                </td>
                <td style="padding-left: 5px;">
                    <a id="btn_Search" class="btn btn-primary"><i class="fa fa-search"></i>&nbsp;查询</a>
                </td>
            </tr>
        </table>
    </div>
    <div class="toolbar">
        <div class="btn-group">
            <a id="seladd" class="btn btn-success" onclick="btn_add()"><i style="color:#FFF" class="fa fa-plus"></i>&nbsp;确定</a>
            <a id="selclear" class="btn btn-default" onclick="btn_clear()"><i class="fa fa-trash-o"></i>&nbsp;清空</a>
        </div>
    </div>
</div>
<div class="gridPanel">
    <table id="gridTable"></table>
    <div id="gridPager"></div>
</div>
