@{
    ViewBag.Title = "费目维护";
    Layout = "~/Views/Shared/_LayoutTM.cshtml";
}
@model Com.Feiliks.QDM.SQM_FEE_CALC
@{
    System.Data.DataTable dt = (System.Data.DataTable)ViewBag.Data;
    System.Data.DataTable djfsdt = (System.Data.DataTable)ViewBag.djfsdt;
    System.Data.DataTable fftypedt = (System.Data.DataTable)ViewBag.fftypedt;
}

<!-- Basic Styles -->
<link rel="stylesheet" type="text/css" media="screen" href="/content/css/bootstrap.min.css">
<link rel="stylesheet" type="text/css" media="screen" href="/content/css/font-awesome.min.css">

<!-- SmartAdmin Styles : Caution! DO NOT change the order -->
<link rel="stylesheet" type="text/css" media="screen" href="/content/css/smartadmin-production-plugins.min.css">
<link rel="stylesheet" type="text/css" media="screen" href="/content/css/smartadmin-production.min.css">
<link rel="stylesheet" type="text/css" media="screen" href="/content/css/smartadmin-skins.min.css">
<style type="text/css">
    #gbox_jqgrid {
        margin: 0px 5px !important;
        width: 99% !important;
    }

    #search_jqgrid {
        display: none !important;
    }

    #delmodjqgrid {
        display: none !important;
    }

    #alertmod_jqgrid {
        display: none !important;
    }

    #pjqgrid_center {
        display: none;
    }

    .smart-form .form-group {
        display: flex;
        margin-bottom: 15px;
    }

    .smart-form .control-label {
        width: 15%;
        padding-top: 6px;
    }

    .smart-form .form-group .col-md-3 {
        margin-right: 200px;
    }

    .smart-form .form-group .radio-inline {
        float: left;
    }

    .ui-jqgrid .ui-paging-info {
        margin-right: 65px;
    }

    .ui-pg-selbox {
        min-height: 25px;
    }

    .editable {
        width: 100% !important;
    }

    .ui-jqgrid tr.jqgrow td {
        white-space: normal !important;
        height: auto;
        vertical-align: text-top;
        padding-top: 2px;
        word-break: break-all;
    }

    .ui-jqgrid tr.jqgrow td {
        vertical-align: middle;
    }

    .form-control {
        padding: 0px 12px;
    }

    .djfs, .gdz {
        margin-right: 40px;
        margin-bottom: 10px;
    }

    .dlc .active .form-control, .gdzdiv .active .form-control {
        background-color: #3276b1;
        color: white;
    }

    .select2-container {
        width: 260px !important;
    }

    .delete_djfs {
        font-size: 20px;
        margin: 5px -5px;
    }

    .ui-jqgrid-btable .ui-widget-content td:nth-child(9) {
        padding-right: 40px;
    }

    .smart-form .form-group .col-md-3 {
        margin-right: 0px;
    }

    .calcdisable {
        border: none;
        background-color: #d9edf7;
    }

    .col-md-1 {
        display: flex;
        width: 12%;
    }
</style>
<div id="content">
    <section id="widget-grid" class="">
        <div class="row">
            <article class="col-sm-12 col-md-12 col-lg-12 sortable-grid ui-sortable">
                <div class="jarviswidget jarviswidget-sortable" data-widget-colorbutton="false" data-widget-editbutton="false" data-widget-custombutton="false">
                    <header>
                        <span class="widget-icon"> <i class="fa fa-edit"></i> </span>
                        <h2>@ViewBag.Title</h2>
                        @*<div style="float:right; ">
                                <button type="submit" id="calc_main" class="btn btn-success">计算基础绑主数据</button>
                            </div>*@
                        <div style="float:right;">
                            <button type="submit" class="btn btn-primary fmbc">
                                保存
                            </button>
                            <button type="submit" class="btn btn-default" id="btnback" onclick="back()">
                                返回
                            </button>
                        </div>
                    </header>
                    <div role="content">
                        <div class="jarviswidget-editbox">
                        </div>
                        <div class="widget-body no-padding">
                            <form id="formmain" class="smart-form form-backgroud">
                                <fieldset>
                                    <input type="hidden" value="@Model.RID" id="RID">
                                    <div class="form-group">
                                        <label class="col-md-2 control-label">费目名称<i style="color:red">*</i></label>
                                        <div class="col-md-3">
                                            <select style="width:100%" id="FEECODE" name="FEECODE" class="select2">
                                                <option value=""></option>
                                                @for (int i = 0; i < dt.Rows.Count; i++)
                                                {
                                                    @*<option value="@dt.Rows[i]["FEECODE"]">@dt.Rows[i]["FEENAME"]--@dt.Rows[i]["FEECODE"]</option>*@
                                                    <option value="@dt.Rows[i]["TCET084"]">@dt.Rows[i]["TEXTDESC"]--@dt.Rows[i]["TCET084"]</option>
                                                }
                                            </select>
                                        </div>
                                        <label class="col-md-2 control-label">前提条件</label>
                                        <div class="col-md-3">
                                            <select style="width:100%" name="PRECOND" id="PRECOND" class="select2">
                                                <option value="">请选择</option>
                                                <option value="ZPRECON-Z01">ZPRECON-Z01</option>
                                                <option value="ZPRECON-Z02">ZPRECON-Z02</option>
                                                <option value="ZPRECON-Z03">ZPRECON-Z03</option>
                                                <option value="ZPRECON-Z04">ZPRECON-Z04</option>
                                                <option value="ZPRECON-Z05">ZPRECON-Z05</option>
                                                <option value="ZPRECON-Z06">ZPRECON-Z06</option>
                                                <option value="ZPRECON-Z07">ZPRECON-Z07</option>
                                                <option value="ZPRECON-Z08">ZPRECON-Z08</option>
                                                <option value="ZPRECON-Z09">ZPRECON-Z09</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="form-group mulbjfs">
                                        <label class="col-md-2 control-label" style="width:13%;">是否多报价方式<i style="color:red">*</i></label>
                                        <div class="col-md-3">
                                            <label class="radio radio-inline"><input type="radio" class="radiobox" name="MULBJFS" value="1"><span>是</span></label>
                                            <label class="radio radio-inline"><input type="radio" checked class="radiobox" name="MULBJFS" value="0"><span>否</span></label>
                                        </div>
                                    </div>
                                    <div class="form-group dlc fshh" style="display:none;">
                                        <input type="button" title="新增" class="btn btn-primary add_djfs" style="width:20px;margin:7px;float:left;" value=" + " />
                                        @if (djfsdt != null && djfsdt.Rows.Count > 0)
                                        {
                                            for (int i = 0; i < djfsdt.Rows.Count; i++)
                                            {
                                                <div class="col-md-1 djfs">
                                                    <input type="hidden" class="djfsrid" value="@djfsdt.Rows[i]["DJFSRID"]" />
                                                    <input type="text" class="form-control djfsname" title="@djfsdt.Rows[i]["DJFSNAME"]" value="@djfsdt.Rows[i]["DJFSNAME"]">
                                                    <input class="btn delete_djfsarea" type="button" value=" X " style="float:left;width:30px;height:34px;">
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <div class="col-md-1 djfs">
                                                <input type="hidden" class="djfsrid" />
                                                <input type="text" class="form-control djfsname" value="定价方式">
                                            </div>
                                        }
                                    </div>
                                    <div class="form-group dlc" style="display:none;">
                                        <label class="col-md-2 control-label">最低收费</label>
                                        <div class="col-md-3">
                                            <select style="width:100%" name="FSMIN" id="FSMIN" class="select2">
                                                <option value="0">无</option>
                                                <option value="1">有</option>
                                            </select>
                                        </div>
                                        <label class="col-md-2 control-label">是否展示</label>
                                        <div class="col-md-3">
                                            <select style="width:100%" name="FSDISP" id="FSDISP" class="select2">
                                                <option value="1">是</option>
                                                <option value="0">否</option>
                                            </select>
                                        </div>
                                        <label class="col-md-2 control-label" style="display:none;">前提条件</label>
                                        <div class="col-md-3" style="display:none;">
                                            <select style="width:100%" name="FSPRECOND" id="FSPRECOND" class="select2">
                                                <option value="">请选择</option>
                                                <option value="ZPRECON-Z01">ZPRECON-Z01</option>
                                                <option value="ZPRECON-Z02">ZPRECON-Z02</option>
                                                <option value="ZPRECON-Z03">ZPRECON-Z03</option>
                                                <option value="ZPRECON-Z04">ZPRECON-Z04</option>
                                                <option value="ZPRECON-Z05">ZPRECON-Z05</option>
                                                <option value="ZPRECON-Z06">ZPRECON-Z06</option>
                                                <option value="ZPRECON-Z07">ZPRECON-Z07</option>
                                                <option value="ZPRECON-Z08">ZPRECON-Z08</option>
                                                <option value="ZPRECON-Z09">ZPRECON-Z09</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="form-group dlc" style="display:none;">
                                        <label class="col-md-2 control-label">高低值比较</label>
                                        <div class="col-md-3">
                                            <label class="radio radio-inline"><input type="radio" checked class="radiobox" name="GDZKEY" value="0"><span>无</span></label>
                                            <label class="radio radio-inline"><input type="radio" class="radiobox" name="GDZKEY" value="A"><span>A</span></label>
                                            <label class="radio radio-inline"><input type="radio" class="radiobox" name="GDZKEY" value="H"><span>H</span></label>
                                            <label class="radio radio-inline"><input type="radio" class="radiobox" name="GDZKEY" value="L"><span>L</span></label>
                                        </div>
                                        <label class="col-md-2 control-label">排序</label>
                                        <div class="col-md-3">
                                            <input style="width:72%" class="form-control" name="FSSORT" id="FSSORT">
                                        </div>
                                    </div>
                                    <div class="form-group gdzdiv fshh" style="display:none;">
                                        <input type="button" title="新增" class="btn btn-primary add_gdz" style="width:20px;margin:7px;float:left;" value=" + " />
                                    </div>
                                    <!--仓租费信息-->
                                    <div class="form-group czf" style="display:none">
                                        <label class="col-md-2 control-label">计算方法类型</label>
                                        <div class="col-md-3">
                                            @if (fftypedt != null && fftypedt.Rows.Count > 0)
                                            {
                                                <select style="width:100%" name="JSFFlX" id="JSFFLX" class="select2">
                                                    <option value="">请选择</option>
                                                    @for (int i = 0; i < fftypedt.Rows.Count; i++)
                                                    {
                                                        <option value="@fftypedt.Rows[i]["FFTYPE"]">@fftypedt.Rows[i]["FFTYPENAME"]--@fftypedt.Rows[i]["FFTYPE"]</option>
                                                    }
                                                </select>
                                            }
                                        </div>
                                        <label class="col-md-2 control-label">计算方法</label>
                                        <div class="col-md-3">
                                            <select style="width:100%" name="JSFF" id="JSFF" class="select2">
                                                <option></option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="form-group dlc" style="display:none;">
                                        <label class="col-md-2 control-label">阶梯累计</label>
                                        <div class="col-md-3">
                                            <select style="width:100%" name="JTLJ" id="JTLJ" class="select2">
                                                <option value="1">是</option>
                                                <option value="0">否</option>
                                            </select>
                                        </div>
                                        <label class="col-md-2 control-label">建议解析基础</label>
                                        <div class="col-md-3">
                                            <select style="width:100%" name="FSRSLBASE" id="FSRSLBASE" class="select2">
                                                <option value="">请选择</option>
                                                <option value="SERVICE">SERVICE</option>
                                                <option value="RESOURCE">RESOURCE</option>
                                                <option value="PRODUCT">PRODUCT</option>
                                                <option value="PACKAGE">PACKAGE</option>
                                                <option value="CONTAINER">CONTAINER</option>
                                                <option value="ACTIVE_RESOURCE">ACTIVE_RESOURCE</option>
                                                <option value="PASSIVE_RESOURCE">PASSIVE_RESOURCE</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="form-group dlc" style="display:none;">
                                        <label class="col-md-2 control-label">费目单位</label>
                                        <div class="col-md-3">
                                            <input style="width:72%" class="form-control" name="FEEUNIT" id="FEEUNIT">
                                        </div>
                                        <label class="col-md-2 control-label">阶段类别</label>
                                        <div class="col-md-3">
                                            <select style="width:100%" name="FSJDLB" id="FSJDLB" class="select2">
                                                <option value="">请选择</option>
                                                <option value="P">P-首程运输段</option>
                                                <option value="M">M-主运输段</option>
                                                <option value="O">O-续运输段</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="form-group dlc" style="display:none;">
                                        <label class="col-md-2 control-label">英文费目单位</label>
                                        <div class="col-md-3">
                                            <input style="width:72%" class="form-control" name="FEEUNIT_EN" id="FEEUNIT_EN">
                                        </div>
                                    </div>
                                    <div class="form-group dlc" id="IsSetCustomer" style="display:none;">
                                        <label class="col-md-2 control-label" >指定客户</label>
                                        <div class="col-md-3">
                                            <select style="width:100%" name="FSSETCUSTOMER" id="FSSETCUSTOMER" class="select2">
                                                <option value="0" selected="selected">否</option>
                                                <option value="1">是</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="form-group dlc" style="display:none;">
                                        <label class="col-md-2 control-label">费用说明</label>
                                        <div class="col-md-7">
                                            <textarea class="form-control" name="FSFYSM" id="FSFYSM" style="height:80px;"></textarea>
                                        </div>
                                    </div>
                                    <div class="form-group dlc" style="display:none;">
                                        <label class="col-md-2 control-label">英文费用说明</label>
                                        <div class="col-md-7">
                                            <textarea class="form-control" name="FSFYSM_EN" id="FSFYSM_EN" style="height:80px;"></textarea>
                                        </div>
                                    </div>
                                    <div class="form-group dlc" style="display:none;">
                                        <label class="col-md-2 control-label">场景费用说明</label>
                                        <div class="col-md-7">
                                            <textarea class="form-control" name="SIGHT_FSFYSM" id="SIGHT_FSFYSM" style="height:80px;"></textarea>
                                        </div>
                                    </div>
                                </fieldset>
                                <div role="main" class="main" style="display:none;">
                                    <div id="content">
                                        <section id="widget-grid" class="">
                                            <div class="row">
                                                <article class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
                                                    <table id="jqgrid"></table>
                                                    <div id="pjqgrid"></div>
                                                </article>
                                            </div>
                                        </section>
                                    </div>
                                </div>
                                <footer>
                                    <input type="button" class="btn btn-primary fmbc" value="保存" />
                                </footer>
                            </form>
                        </div>
                    </div>
                </div>
            </article>
        </div>
    </section>
</div>

@section pagespecific {
    <script src="~/Content/QO/scripts/framework.js?v=@DateTime.Now.ToString("yyyyMMddhhmmss")"></script>
    <script src="~/Content/QO/scripts/Ewin.js"></script>
    <script src="~/Content/QO/toastr/toastr.min.js"></script>
    <link rel="stylesheet" href="~/Content/QO/toastr/toastr.min.css">
    <script src="~/Content/QO/layer/layer.js"></script>
    <link href="~/Content/QO/scripts/bootstrap-datetimepicker/css/bootstrap-datetimepicker.min.css" rel="stylesheet">
    <script src="~/Content/QO/scripts/bootstrap-datetimepicker/js/bootstrap-datetimepicker.min.js"></script>
    <script type="text/javascript" src="~/Content/QO/scripts/bootstrap-datetimepicker/js/locales/bootstrap-datetimepicker.zh-CN.js" charset="UTF-8"></script>
    <script src="~/Scripts/plugin/jquery-validate/jquery.validate.min.js"></script>
    <script type="text/javascript">
        var keyValue = "";
        var IsEdit = false;
        var gdzkey = '';
        var username;
        $(document).ready(function () {
            var user = '@Oncontrol3.Web.Helpers.SQMHelper.getStaffKey()';
            if (user.length < 1) {
                layer.alert('系统登录已超时，请重新登录', { icon: 2 });
            }
            else {
                username = user;
                //layer.alert('当前登录账户：' + user, { icon: 1 });
            }
            $(".mulbjfs").hide();
            $("[name='MULBJFS'][value='1']").prop("checked", true);
            keyValue = $("#RID").val();
            //if (!!keyValue) {
            if (!!keyValue) {
                //有rid,是修改，不可
                $("#FEECODE").attr("disabled", "disabled");
                $(".main").show();
            }
            var allowcacloffer = "@Model.ALLOWCACLOFFER";
            if (allowcacloffer.length > 0) {
                $("[name='ALLOWCACLOFFER'][value='" + allowcacloffer + "']").prop("checked", true);
            }
            //if ($("#FSSETCUSTOMER").val() == '0') {
            //    $("#IsSetCustomer").hide();//选“否”，隐藏此div
            //}
            //非数值型的计算基础CODE
            var calcstr = ","+"@ViewBag.calcstr";
            //是否多报价方式
            //var mulbjfs = "@Model.MULBJFS";
            var mulbjfs = "1";
            //定价方式里初始化数据
            if (mulbjfs == "0") {
                $("#FSRSLBASE").select2('val', "@Model.RSLBASE");
                $("#FSMIN").select2('val', "@Model.MINPRICE");
            } else {
                $("#FSRSLBASE").select2('val', "@ViewBag.fsrslbase");
                $("#FSMIN").select2('val', "@ViewBag.fsmin");
                $("#FSDISP").select2('val', "@ViewBag.fsdisp");
                $("#FSSETCUSTOMER").select2('val', "@ViewBag.fssetcustomer");//是否指定客户
                $("#FSSORT").select2('val', "@ViewBag.fssort");
                $("#JSFFLX").select2('val', "@ViewBag.jsfflx");
                $(".fshh").css("display", "inline-block");
                $(".fshh").css("width", "100%");
            }
            $("div").find(".djfs").first().addClass("active");
            if ($(".dlc").find(".active").find(".djfsrid").val().length == 0) {
                $(".dlc").find(".active").find(".djfsrid").val(fqgenguid());
            }
            if (mulbjfs.length > 0) {
                $("[name='MULBJFS'][value='" + mulbjfs + "']").prop("checked", true);
            }
            $("[name='MULBJFS']").change(function () {
                if ($(this).val() == '1') {
                    gdzkey = $('input:radio[name="GDZKEY"]:checked').val();
                    $(".dlc").show();
                    $(".fshh").css("display", "inline-block");
                    $(".fshh").css("width", "100%");
                    if (gdzkey != "0") {
                        $(".gdzdiv").show();
                    }
                    $("div").find(".djfs").first().addClass("active");
                    $("div").find(".djfs").first().siblings().removeClass("active");
                    showFSData();
                } else {
                    gdzkey = "0";
                    $(".dlc").hide();
                    $(".gdzdiv").hide();
                    $("div").find(".djfs").removeClass("active");
                    $("#FSRSLBASE").select2('val', "@Model.RSLBASE");
                    $("#FSMIN").select2('val', "@Model.MINPRICE" == "" ? "0" : "@Model.MINPRICE");
                }
                //更新计算基础列表数据
                showRefData(gdzkey);
            });
            gdzkey = "@ViewBag.gdzkey";
            if (gdzkey.length > 0 && mulbjfs == "1") {
                $("[name='GDZKEY'][value='" + gdzkey + "']").prop("checked", true);
                //更新定价方式里面数据
                showFSData();
                showGdzData(gdzkey);
                $("div").find(".gdz").first().addClass("active");
                $("div").find(".gdz").first().siblings().removeClass("active");
            }
            //是否高低值,新增时gdzkey=""
            if (gdzkey == '0' || gdzkey == "") {
                $(".gdzdiv").hide();
            } else {
                $(".gdzdiv").show();
            }
            $("[name='GDZKEY']").change(function () {
                gdzkey = $(this).val();
                if (gdzkey == '0') {
                    $(".gdzdiv").hide();
                } else {
                    $(".gdzdiv").show();
                    showGdzData(gdzkey);
                    //$("input[name='GDZKEY']:radio").attr("disabled", "disabled");
                    $("div").find(".gdz").first().addClass("active");
                    $("div").find(".gdz").first().siblings().removeClass("active");
                    if ($(".gdzdiv").find(".active").find(".gdzrid").val().length == 0) {
                        $(".gdzdiv").find(".active").find(".gdzrid").val(fqgenguid());
                    }
                }
                //更新计算基础列表数据
                showRefData(gdzkey);
            });
            if (mulbjfs == '1') {
                $(".dlc").show();
            } else {
                $("div").find(".djfs").removeClass("active");
            }

            //$("#CACLCODE").attr("disabled", "disabled");
            $.ajax({
                url: "/FEE/GetFormJson",
                data: { keyValue: keyValue },
                dataType: "json",
                async: false,
                success: function (data) {
                    $("#formmain").SetWebControls(data);
                }
            });
            //更新计算基础列表数据
            showRefData(gdzkey);
            // }
            $("input").change(function () {
                IsEdit = true;
            });
            $("select").change(function () {
                IsEdit = true;
            });
            //计算方法类型变更事件
            getjsffdata("@ViewBag.jsfflx");
            $("#JSFFLX").change(function () {
                getjsffdata($(this).val());
            });
            //新增定价方式
            $(".add_djfs").click(function () {
                var add_area = $("div").find(".djfs").last();
                add_area.after('<div class="col-md-1 djfs"><input type="hidden" class="djfsrid"/><input type="text" class="form-control djfsname" value="定价方式" style="float:left;"><input class="btn delete_djfsarea" type="button" value=" X " style="float:left;width:30px;height:34px;"></div>');
            });
            //定价方式删除
            $("#formmain").on("click", ".delete_djfsarea", function (event) {
                popDialog("删除", "确定要删除该方式？", deletedjfs, nodelete);
                //if ($(this).parent().hasClass("active")) {
                //    $("div").find(".djfsname").first().click();
                //}
                //$(this).parent().remove();
            });
            function deletedjfs() {
                var deldjfsrid = $(".dlc").find(".active").find(".djfsrid").val();
                $.ajax({
                    type: 'POST',
                    url: "/FEE/delDjfs",
                    data: {
                        djfsrid: deldjfsrid == undefined ? '' : deldjfsrid,
                        gdzrid: '',
                    },
                    success: function (data) {
                        var data = $.parseJSON(data);
                        if (data.Success) {
                            toastr.success(data.Message);
                            window.location.href = '/FEE/FEECreate?id=' + "@Model.RID";
                        } else {
                            toastr.error(data.Message);
                            $(".ui-widget-overlay").hide();
                        }
                    },
                    error: function (data) {
                        if (!!data.responseText) {
