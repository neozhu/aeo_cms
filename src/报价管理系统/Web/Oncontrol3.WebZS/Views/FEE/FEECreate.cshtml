                    rids += rowData.RID + ',';
                }
                rids = rids.substring(0, rids.length - 1);
                $.ajax({
                    type: 'POST',
                    url: "/FEE/delFeeCalcRef",
                    data: {
                        RIDS: rids,
                        djfsrid: djfsrid,
                        gdzrid: gdzrid,
                    },
                    success: function (data) {
                        var data = $.parseJSON(data);
                        if (data.Success) {
                            toastr.success(data.Message);
                            window.location.href = '/FEE/FEECreate?id=' + "@Model.RID";
                        } else {
                            toastr.error(data.Message);
                            $(".ui-widget-overlay").hide();
                        }
                    },
                    error: function (data) {
                        if (!!data.responseText) {
                            alert(data.responseText);
                        } else {
                            window.alert("请求失败！");
                        }
                    }
                });
            }
            //仓租费计算方法类型
            if ("@Model.JSFFZS" == "1") {
                $(".czf").show();
            } else {
                $(".czf").hide();
            }
            //$("#").find("input,select,textarea").each(function () {
            //    $(this).attr("autocomplete", "off");
            //});
            $("#FEEUNIT").attr("autocomplete", "off");
        })
        //展示高低值名称列表
        function showGdzData(gdzkey) {
            var gdzmsg = "";
            var GDZArray = [];
            var gdzname = '';
            if (gdzkey == "H") {
                gdzname = "高A";
            } else if (gdzkey == "L") {
                gdzname = "低A";
            } else if (gdzkey == "A") {
                gdzname = "顺A";
            }
            $.ajax({
                url: "@Url.Action("GetGdzData")",
                data: {
                    feecode: "@Model.FEECODE",
                    djfsrid: $(".dlc").find(".active").find(".djfsrid").val(),
                    gdzkey: gdzkey,
                },
                dataType: "json",
                async: false,
                success: function (data) {
                    GDZArray = data[0];
                }
            });
            ////高低值渲染
            if (GDZArray.length > 0) {
                for (var i = 0; i < GDZArray.length; i++) {
                    gdzmsg += "<div class='col-md-1 gdz'><input type='hidden' class='gdzrid' value=" + GDZArray[i][0] + " /><input type='text' class='form-control gdzname' title='" + GDZArray[i][1] + "' value=" + GDZArray[i][1] + "><input class='btn delete_gdzarea' type='button' value=' X ' style='float:left;width:30px;height:34px;'></div>";
                }
            } else {
                gdzmsg = "<div class='col-md-1 gdz active'><input type='hidden' class='gdzrid' value=" + fqgenguid() + " /><input type='text' class='form-control gdzname' title='" + gdzname + "' value=" + gdzname + "></div>";
            }
            $(".gdzdiv").find(".gdz").remove();
            $(".add_gdz").after(gdzmsg);
        }
        //更新计算基础列表数据
        function showRefData(gdzkey) {
            var djfsrid = '';
            var gdzrid = '';
            $("#FEEUNIT").val("");
            if ($(".dlc").children().hasClass("active")) {
                djfsrid = $(".dlc").find(".active").find(".djfsrid").val();
            }
            if ($(".gdzdiv").children().hasClass("active")) {
                gdzrid = $(".gdzdiv").find(".active").find(".gdzrid").val();
            }
            //var caclunit = $("#CACLCODE").find("option:selected").text().substring(0, $("#CACLCODE").find("option:selected").text().indexOf('-'));
            $("#jqgrid").jqGrid('setGridParam', {
                url: "/FEE/getRefData",
                datatype: 'json',
                //loadComplete: function () {
                //    if ($("#FEEUNIT").val() == "") {
                //        //加载完成调用，否则数据显示有异常
                //        $("#FEEUNIT").val(getFEEUNIT());
                //    }
                //},
                postData: { 'FEECODE': $("#FEECODE").val(), 'DJFSRID': djfsrid, 'GDZRID': gdzrid, 'GDZKEY': gdzkey }
            }).trigger("reloadGrid"); //重新载入

            //var jsfflx = '';
            //var jsff = '';
            //获取计算方法、类型的数据,仓租费特有
            //if ($("#FEECODE").val() == "S1000CZF0001") {

            $.ajax({
                url: "/FEE/JSFFByGdzRid",
                type: "get",
                async: false,
                data: "djfsrid=" + djfsrid + "&gdzrid=" + gdzrid + "&gdzkey=" + gdzkey,
                success: function (data) {
                    if (data != null && data != undefined) {
                        var result = $.parseJSON(data);
                        if (result.length > 0) {
                            if ("@Model.JSFFZS" == "1") {
                                //设置计算方法类型
                                $("#JSFFLX").select2('val', result[0]['JSFFLX']);
                                //重新请求此类型的数据
                                getjsffdata(result[0]['JSFFLX']);
                                $("#JSFF").select2('val', result[0]['JSFF']);
                            }
                            if (!!result[0]["JTLJ"]) {
                                $("#JTLJ").select2("val", result[0]["JTLJ"]);
                            } else {
                                $("#JTLJ").select2("val", "0");
                            }
                            if (!!result[0]["FSRSLBASE"]) { //建议解析基础
                                $("#FSRSLBASE").select2("val", result[0]["FSRSLBASE"]);
                            } else {
                                $("#FSRSLBASE").select2("val", "");
                            }
                            if (!!result[0]["FEEUNIT"]) { //费目单位
                                $("#FEEUNIT").val(result[0]["FEEUNIT"]);
                            }
                            if (!!result[0]["FEEUNIT_EN"]) { //英文费目单位
                                $("#FEEUNIT_EN").val(result[0]["FEEUNIT_EN"]);
                            }
                            if (!!result[0]["FSJDLB"]) {
                                $("#FSJDLB").select2("val", result[0]["FSJDLB"]);
                            } else {
                                $("#FSJDLB").select2("val", "");
                            }
                            if (!!result[0]["FSFYSM"]) { //费目说明
                                $("#FSFYSM").val(result[0]["FSFYSM"]);
                            } else {
                                $("#FSFYSM").val("");
                            }
                            if (!!result[0]["SIGHT_FSFYSM"]) { //场景费目说明
                                $("#SIGHT_FSFYSM").val(result[0]["SIGHT_FSFYSM"]);
                            } else {
                                $("#SIGHT_FSFYSM").val("");
                            }
                            if (!!result[0]["FSFYSM_EN"]) { //英文费目说明
                                $("#FSFYSM_EN").val(result[0]["FSFYSM_EN"]);
                            } else {
                                $("#FSFYSM_EN").val("");
                            }
                        } else {
                            $("#JTLJ").select2("val", "0");
                            $("#FSRSLBASE").select2("val", "");
                            $("#FSJDLB").select2("val", "");
                            $("#FSFYSM").val("");
                            $("#FSFYSM_EN").val("");  //英文费目说明
                            $("#FEEUNIT_EN").val("FEEUNIT_EN");//英文费目单位
                            $("#SIGHT_FSFYSM").val("");//场景费用说明
                        }
                    } else {
                        $("#JTLJ").select2("val", "0");
                        $("#FSRSLBASE").select2("val", "");
                        $("#FSJDLB").select2("val", "");
                        $("#FSFYSM").val("");
                        $("#FSFYSM_EN").val("");
                        $("#SIGHT_FSFYSM").val("");//场景费用说明
                    }
                }, error: function () {
                    toastr.error("获取数据失败");
                }
            })
        }
