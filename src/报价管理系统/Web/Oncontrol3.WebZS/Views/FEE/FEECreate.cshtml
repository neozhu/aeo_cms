        //获取计算方法主数据
        function getjsffdata(jsfftype) {
            var jsfflist;
            var jsff;
            //自动带出计算方法
            $.ajax({
                url: "@Url.Action("getJsff")",
                data: {
                    jsfftype: jsfftype,
                    djfsrid: $(".dlc").find(".active").find(".djfsrid").val(),
                    feecode: "@Model.FEECODE",
                },
                dataType: "json",
                async: false,
                success: function (data) {
                    jsfflist = data[0];
                    jsff = data[1];
                }
            });
            $("#JSFF").find("*").remove();
            if (jsfflist.length > 0) {
                for (var i = 0; i < jsfflist.length; i++) {
                    if (jsfflist[i].FFCODE == null) {
                        $("#JSFF").append($("<option value=''>空</option>"));
                    } else {
                        $("#JSFF").append($("<option></option>").attr("value", jsfflist[i].FFCODE).html(jsfflist[i].FFNAME));
                    }
                }
            }
            $("#JSFF").select2('val', jsff);
        }
        // 返回
        function back() {
            if (IsEdit) {
                Ewin.confirm({ message: "页面有修改，是否放弃保存？" }).on(function (e) {
                    if (!e) {
                        return;
                    }
                    window.location.href = "@Url.Action("FEEIndex")";
                });
            }
            else { window.location.href = "@Url.Action("FEEIndex")"; }
        }
        // modal 对话框
        function popDialog(title, msg, callbackyes, callbackno) {
            if (!title) {
                title = '对话框';
            }
            var dialogHTML = '<div id="selfDialog" class="modal fade">';
            dialogHTML += '<div class="modal-dialog">';
            dialogHTML += '<div class="modal-content">';
            dialogHTML += '<div class="modal-header">';
            dialogHTML += '<button type="button" class="close" data-dismiss="modal" aria-label="Close">';
            dialogHTML += '<span aria-hidden="true">&times;</span>';
            dialogHTML += '</button>';
            dialogHTML += '<h4 class="modal-title">' + title + '</h4>';
            dialogHTML += '</div>';
            dialogHTML += '<div class="modal-body">';
            dialogHTML += msg;
            dialogHTML += '</div>';
            dialogHTML += '<div class="modal-footer">';
            dialogHTML += '<button type="button" class="btn btn-default" data-dismiss="modal" id="buttonno">否</button>';
            dialogHTML += '<button type="button" class="btn btn-primary" data-dismiss="modal" id="buttonyes">是</button>';
            dialogHTML += '</div>';
            dialogHTML += '</div>';
            dialogHTML += '</div>';
            dialogHTML += '</div>';

            $("#selfDialog").remove();
            $("body").append(dialogHTML);
            $("#selfDialog").modal("show");
            // 绑定"是"方法
            $("#buttonyes").click(function () {
                if (typeof callbackyes == "function") {
                    callbackyes();
                }
            });
            // 绑定"否"方法
            $("#buttonno").click(function () {
                if (typeof callbackno == "function") {
                    callbackno();
                }
            });
        }

        //获取费目单位
        function getFEEUNIT() {
            if (!!$("#FEEUNIT").val()) {//原本有单位
                return $("#FEEUNIT").val();
            }
            var str = "";
            //没有手动维护单位，设默认值
            $("#jqgrid tbody tr").each(function () {
                var unit = $(this).children('td').eq(4).text();
                //if (!str.match(unit)) {
                //    str += unit + "/"; //错，立方米  米
                //}
                if (unit.trim() != "") {
                    str += unit + "/";
                }
            });
            return str.substr(0, str.length - 1);
        }

        //解决保存表格数据刷新页面数据丢失问题
        function getTmpData() {
            var data = [];
            data[0] = $("#JSFFLX").val();
            data[1] = $("#JSFF").val();
            data[2] = $("#JTLJ").val();
            data[3] = $("#FSRSLBASE").val();
            data[4] = $("#FEEUNIT").val();
            data[5] = $("#FSJDLB").val();
            data[6] = $("#FSFYSM").val();
            data[7] = $("#FEEUNIT_EN").val();//英文费目单位
            data[8] = $("#FSFYSM_EN").val();//英文费目说明
            data[9] = $("#SIGHT_FSFYSM").val();//场景费用说明

            return data;
        }

    </script>
