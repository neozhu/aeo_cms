        //获取计算方法主数据
        function getjsffdata(jsfftype) {
            var jsfflist;
            var jsff;
            //自动带出计算方法
            $.ajax({
                url: "@Url.Action("getJsff","FEE")",
                data: {
                    jsfftype: jsfftype,
                    djfsrid: $(".dlc").find(".active").find(".djfsrid").val(),
                    feecode: $("#feecode").val(),
                },
                dataType: "json",
                async: false,
                success: function (data) {
                    jsfflist = data[0];
                    jsff = data[1];
                }
            });
            $("#JSFF").find("*").remove();
            if (jsfflist.length > 0) {
                for (var i = 0; i < jsfflist.length; i++) {
                    if (jsfflist[i].FFCODE == null) {
                        $("#JSFF").append($("<option value=''>空</option>"));
                    } else {
                        $("#JSFF").append($("<option></option>").attr("value", jsfflist[i].FFCODE).html(jsfflist[i].FFNAME));
                    }
                }
            }
            $("#JSFF").select2('val', jsff);
        }

