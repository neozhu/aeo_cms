                        <div class="col-md-6" style="width:100%;padding-right:0px;">
                            <div class="col-md-10">
                                <h4><label class="label label label-default">高低值</label></h4>
                            </div>
                            <div class="col-md-8 gdzdiv dlc">
                                @for (int i = 0; i < GDZDATAdt.Rows.Count; i++)
                                {
                                    <div class="djfs" onclick='djfsqh("@GDZDATAdt.Rows[i]["DJFSRID"]","@GDZDATAdt.Rows[i]["GDZRID"]")'>
                                        <input type="hidden" class="djfsrid" value="@GDZDATAdt.Rows[i]["GDZRID"]" />
                                        <input type="text" class="form-control djfsname" title="@GDZDATAdt.Rows[i]["GDZNAME"]" value="@GDZDATAdt.Rows[i]["GDZNAME"]" readonly>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
                <div class="row ptbj czfjsff">
