                                    </div>
                                    <label style="margin-top:10px;margin-left:10px;">A</label>
                                </label>
                                <label class="col-md-3" style="width:100px;">
                                    <div style="float:left">
                                        <input type="radio" name="GDZKEY" value="H" disabled="disabled" />
                                    </div>
                                    <label style="margin-top:10px;margin-left:10px;">H</label>
                                </label>
                                <label class="col-md-3" style="width:100px;">
                                    <div style="float:left">
                                        <input type="radio" name="GDZKEY" value="L" disabled="disabled" />
                                    </div>
                                    <label style="margin-top:10px;margin-left:10px;">L</label>
                                </label>
