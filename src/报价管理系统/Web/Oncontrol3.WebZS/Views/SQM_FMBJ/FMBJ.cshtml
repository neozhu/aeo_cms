@{
    ViewBag.Title = "费目详情";
    Layout = "~/Views/Shared/_LayoutTM.cshtml";
}
@{
    System.Data.DataTable psfdata = (System.Data.DataTable)ViewBag.PSFDATA;
    System.Data.DataTable FCREFdt = (System.Data.DataTable)ViewBag.FCREFData;
    System.Data.DataTable DJFSdt = (System.Data.DataTable)ViewBag.DJFSData;
    System.Data.DataTable GDZDATAdt = (System.Data.DataTable)ViewBag.GDZDATAdt;
    System.Data.DataTable fftypedt = (System.Data.DataTable)ViewBag.fftypedt;
    System.Data.DataTable SEARFCREFdt = (System.Data.DataTable)ViewBag.SEARFCREFdt;
    string status = psfdata.Rows[0]["BJSTATAUS"] + "";
    bool min = @ViewBag.min;
}
<style>
    _::-webkit-full-page-media, _:future, :root .row {
        padding-right: 15px; /*jnp add for ipad*/
    }

    body {
        background-color: rgb(248,248,248);
    }

    #ribbon {
        display: none;
    }

    #left-panel {
        display: none;
    }

    .demo {
        display: none;
    }

    .active {
        background-color: rgb(19,100,181) !important;
    }

    .head {
        height: 50px;
        background-color: rgb(19,100,181);
        color: #999;
        margin-top: 7px;
        margin-bottom: 7px;
    }

        .head span {
            line-height: 98px;
            font-size: 14px;
            padding: 0px 20px 15px 10px;
            color: #ffffff;
        }

    .label {
        color: #4d5d70 !important;
    }

    .inf {
        line-height: 40px;
    }

    .tel-num {
        color: #000;
        font-size: 24px;
        font-weight: bold;
    }

    .dis {
        color: #999;
        cursor: pointer;
    }

    #modelname {
        margin-left: 10px;
        font-size: 18px;
    }

    .controls {
        position: relative;
    }

        .controls input[type=radio] {
            opacity: 0;
        }

        .controls label {
            position: absolute;
            top: 5px;
            left: 12px;
            width: 12px;
            height: 12px;
            border-radius: 50%;
            border: 1px solid rgb(223,223,223);
            background-color: rgb(241,241,241);
        }

        .controls input[type=radio]:checked + label:after {
            content: "";
            position: absolute;
            left: 3px;
            bottom: 3px;
            width: 4px;
            height: 4px;
            border: 2px solid rgb(40,129,197);
            background-color: rgb(40,129,197);
            border-radius: 50%;
        }

    .clear {
        background-color: rgb(195,195,195);
        color: #ffffff;
        width: 70px;
    }

    .nmpd-target {
        border: 1px solid rgb(153, 153, 153);
        border-image: none;
        width: 50px;
        height: 30px;
    }

    .label-default {
        background-color: #fff !important;
        color: #666 !important;
        font-weight: 100 !important;
    }
    /********************************************/
    .font {
        font-size: 20px;
        color: black;
        padding-top: 10px;
    }

    .bjok {
        color: green;
    }

    .bjover {
        color: #f0ad4e;
    }

    .card-box {
        width: 100%;
        height: 100px;
        float: left;
        border: 1px solid #ccc;
        background-color: #fff;
        border-radius: 1px;
        margin-top: 5px;
        overflow: hidden;
        position: relative;
        padding-bottom: 10px;
    }

        .card-box .divys {
            margin-top: 15px;
        }

    .card-box-content {
        padding: 6px 6px;
        font-size: 14px;
        color: #4d5d70;
    }

        .card-box-content .divys, .card-box-content .divys div {
            white-space: nowrap;
            text-overflow: ellipsis;
            margin-top: 4px;
        }

        /*.card-box-content .inf {
            font-weight: bold;
        }*/

        .card-box-content div .djfs {
            margin-bottom: 10px;
            margin-right: 5px;
            width: 11.33333333%;
            float: left;
            display: inline-block;
        }

            .card-box-content div .djfs .active {
                background-color: #2e7bcc;
                color: white;
            }

            .card-box-content div .djfs .djfsname {
                cursor: pointer;
            }

        .card-box-content div .tel-num {
            width: 80px;
        }

        .card-box-content div .pickup_btn {
            float: right;
            margin-left: 56px;
            font-size: 9px;
            line-height: 18px;
            width: 70px;
            height: 18px;
            background-color: #319adf;
            color: white;
            text-align: center;
            border-radius: 8px;
        }

    .btns {
        margin-top: 8px;
        margin-bottom: 8px;
    }

    .ColVis {
        display: none;
    }

    .htmlstr {
        position: absolute;
        width: 1400px;
    }

    #numpad4column tbody td {
        height: 60px;
    }

    .dt-toolbar {
        padding: 0px 0px;
        border-bottom: 0px solid #ccc;
        background: #fff;
    }

    .dataTables_info {
        display: none;
    }

    .dataTables_length {
        display: none;
    }

    #numpad4column_paginate {
        display: none;
    }

    #numpad4column tbody {
        font-size: 10px;
    }

    .col-md-8 .djfs .active {
        background-color: #2e7bcc;
        color: white;
    }

    .col-md-8 .djfs .djfsname {
        cursor: pointer;
    }

    .col-md-4 {
        width: 45%;
    }

    .col-md-10 {
        width: 100px;
        margin-top: 15px;
        padding-top: 10px;
    }

    .fstbox {
        height: 100%;
        padding-bottom: 10px;
        padding-top: 10px;
    }

    .FEE {
        margin-bottom: 15px;
        display: none;
        cursor: pointer;
    }

    .open > .dropdown-menu {
        position: inherit;
    }

    .srvbj {
        background-color: #ffb100;
    }

    .checkme {
        background-color: yellow;
    }

    .srvspan {
        margin-left: 20px;
        cursor: pointer;
    }

    .prdspan {
        cursor: pointer;
    }

    .bgffm {
        float: left;
        margin: 10px 0px;
    }

    .dban .col-md-1 {
        width: 12%;
    }

    .dlc {
        width: 90%;
        display: inline-block;
    }

    .dateset {
        width: 50%;
        display: inline-block;
    }

        .dateset .col-md-8 {
            padding-right: 0px;
        }
    /*

        .paddingset .col-md-10,.paddingset .col-md-8 {
            padding-left:0px;
        }
    */
    /*仓租费计算*/
    .czfjsff {
        margin-top: 4px;
        display: none;
    }

    #czxgForm .row {
        margin-bottom: 20px;
    }

        #czxgForm .row lable {
            width: 120px;
        }

        #czxgForm .row .col-md-4 {
            margin-top: -10px;
        }

    .invalid {
        color: red;
        font-style: normal;
    }
    /*#czftj tr td{
        border:1px solid #000;
        border-collapse:collapse;
    }*/
    .ui-jqgrid {
        width: 100% !important;
    }

    #pjqgrid_center, #search_jqgrid {
        display: none;
    }

    .ui-jqgrid tr.jqgrow td {
        white-space: normal !important;
        height: auto;
        vertical-align: text-top;
        padding-top: 2px;
        word-break: break-all;
    }

    .ui-jqgrid tr.jqgrow td {
        vertical-align: middle;
    }

    #delmodjqgrid {
        display: none !important;
    }

    #alertmod_jqgrid {
        display: none !important;
    }

    .grid {
        margin: 0px;
        border-collapse: collapse;
        table-layout: fixed;
    }

        .grid tbody td {
            text-align: left;
            border-bottom: 1px solid #ccc;
            border-left: 1px solid #ccc;
            border-right: 1px solid #ccc;
            height: 22px;
            word-break: break-all;
        }

        .grid tbody .selected {
            background-color: #6DA47D;
            color: #fff;
            cursor: pointer;
        }

    .fsmore, .fsless {
        margin-top: 4px;
        height: 32px;
        width: 20px;
        float: left;
        margin-right: 5px;
    }
</style>
<div class="row head">
    <div style="float:left">
        <div style="margin-top: -25px;">
            <span>&nbsp;&nbsp;&nbsp; 欢迎您：<span id="user">@Oncontrol3.Web.Helpers.SQMHelper.getStaffKey()</span></span>
        </div>
    </div>
    <div style="float:right; margin-right: 40px; margin-top: -25px;">
        <span class="dis" id="toxj">询价</span>
        <span class="dis" id="tobjmb">报价模板</span>
        <span class="dis" id="tocpzs">产品展示</span>
        @*<span class="dis" id="tobjmb">非标报价</span>*@
        <span class="dis active" id="tobjsy">报价首页</span>
    </div>
</div>
<div style="display:none;">
    <input id="psfdata" value="@ViewBag.psfall" />
    <input id="ifbj" />
    <input id="DJRID" value="@ViewBag.DJRID" />
    <input id="BJRID" value="@ViewBag.BJRID" />
    <input id="FSFEEUNIT" value="@ViewBag.fsfeeunit" />
    <input id="MRID" value="@psfdata.Rows[0]["MRID"]" />
    <input id="VRID" value="@psfdata.Rows[0]["VRID"]" />
    <input id="idguidprice" />
    <input id="feecode" value="@psfdata.Rows[0]["FEE_CODE"]" />
</div>
<div class="row" style="background-color: #fff;">
    <div class="col-md-12">
        <div class="card-box" style="height:100%;">
            <div class="card-box-content">
                <div class="inf"><span class="tel-num" id="feename">费目：@psfdata.Rows[0]["FEE_NAME"]-@psfdata.Rows[0]["FEE_CODE"]</span><span class="dis address" style="margin-left:100px;float: right;" id="bpname">商机：@ViewBag.BIZNAME</span><span class="dis address" id="bizname" style="float: right;">客户：@ViewBag.BPNAME</span></div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="card-box" style="height:100%;">
            <div class="card-box-content">
                <div class="row divys">
                    <div class="col-md-4">
                        <div class="col-md-10">
                            <h4><label class="label label label-default">结算方</label></h4>
                        </div>
                        <div class="col-md-6">
                            <div class="input">
                                @*<select style="width:100%" id="jsf" class="select2" name="cname">
                                        <option value="@psfdata.Rows[0]["JSFCODE"]">@psfdata.Rows[0]["JSF"]</option>
                                    </select>*@
                                <input type="hidden" id="jsf" value="@if (psfdata.Rows[0]["JSF"] + "" != "") { @Html.Raw(psfdata.Rows[0]["JSF"]);} else {@Html.Raw("");}">
                                <input type="hidden" id="jsfC" value="@if (psfdata.Rows[0]["JSFCODE"] + "" != "") { @Html.Raw(psfdata.Rows[0]["JSFCODE"]);} else {@Html.Raw("");}">
                                <input type="text" class="form-control" id="jsfZS" name="jsf" mdmtype="MDMBPBJ" value="@if (psfdata.Rows[0]["JSF"] + "" != "") { @Html.Raw(psfdata.Rows[0]["JSF"]);} else {@Html.Raw("");}" />
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="col-md-10">
                            <h4><label class="label label label-default">结算角色</label></h4>
                        </div>
                        <div class="col-md-6">
                            <div class="input">
                                <input type="hidden" id="jsfjs" value="@if (psfdata.Rows[0]["JSFJS"] + "" != "") { @Html.Raw(psfdata.Rows[0]["JSFJS"]);} else {@Html.Raw("");}">
                                <input type="hidden" id="jsfjsC" value="@if (psfdata.Rows[0]["JSFJSCODE"] + "" != "") { @Html.Raw(psfdata.Rows[0]["JSFJSCODE"]);} else {@Html.Raw("");}">
                                <input type="text" class="form-control" id="jsfjsZS" name="jsfjs" mdmtype="MDM" mdmkey="PTRO" mdmfieldname="PARTY_ROLE012,DESCRIPTION" value="@if (psfdata.Rows[0]["JSFJS"] + "" != "") { @Html.Raw(psfdata.Rows[0]["JSFJS"]);} else {@Html.Raw("");}" />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row divys">
                    <div class="col-md-4">
                        <div class="col-md-10">
                            <h4><label class="label label label-default">费目别名</label></h4>
                        </div>
                        <div class="col-md-8">
                            @if (psfdata.Rows[0]["OTHER_NAME"] + "" != "")
                            {
                                <input id="othername" type="text" class="form-control col-md-8" placeholder="请输入费目别名" value="@psfdata.Rows[0]["OTHER_NAME"]">
                            }
                            else
                            {
                                <input id="othername" type="text" class="form-control col-md-8" placeholder="请输入费目别名" value="@psfdata.Rows[0]["FEE_NAME"]">
                            }
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="col-md-10">
                            <h4><label class="label label label-default">折扣</label></h4>
                        </div>
                        <div class="col-md-5">
                            <input id="discount" type="text" class="form-control col-md-7" placeholder="请输入折扣" value="@if(psfdata.Rows[0]["DISCOUNT"] + "" == ""){@Html.Raw("100"); }else{@Html.Raw(psfdata.Rows[0]["DISCOUNT"])}">
                            <div style="margin-top: 10px">
                                <span>&nbsp;%</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-2 ptbj" style="margin-top: 10px;">
                        <label class="col-md-3">
                            <input type="checkbox" name="bgf" />
                        </label>
                        <div style="margin-top: 6px;">
                            <span> 包干费</span>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="col-md-4" style="margin-top:10px;width:60px">
                            <h4><label class="label label label-default">状态</label></h4>
                        </div>
                        <div class="col-md-8" style="margin-top:12px;">
                            <p>
                                @if (status == "1")
                                {
                                    @Html.Raw("已保存");
                                }
                                else if (status == "2")
                                {
                                    @Html.Raw("已确认");
                                }
                                else if (status == "0")
                                {
                                    @Html.Raw("未保存")
                                }
                                else if (status == "3")
                                {
                                    @Html.Raw("已保存（报价无定价）")
                                }
                                else if (status == "4")
                                {
                                    @Html.Raw("已保存（报价超限）")
                                }
                                else if (status == "5")
                                {
                                    @Html.Raw("已确认（报价超限）")
                                }
                            </p>
                        </div>
                    </div>
                </div>
                <div class="row divys">
                    <div class="col-md-4 bjfscss">
                        <div class="col-md-10">
                            <h4><label class="label label label-default">报价方式</label></h4>
                        </div>
                        <div class="col-md-8">
                            <div>
                                <label class="col-md-3" style="width:100px;">
                                    <input type="radio" name="bjfs" value="0" checked />
                                    <label style="margin-top:10px;margin-left:10px;">普通报价</label>
                                </label>
                            </div>
                            @*<div>
                                    <label class="col-md-3" style="width:100px;">
                                        <input type="radio" name="bjfs" value="1" />
                                        <label style="margin-top:10px;margin-left:10px;">At Cost</label>
                                    </label>
                                </div>*@
                            <div>
                                <label class="col-md-3" style="width:100px;">
                                    <input type="radio" name="bjfs" value="2" />
                                    <label style="margin-top:10px;margin-left:10px;">单票单询</label>
                                </label>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="dateset">
                            <div class="col-md-10">
                                <h4><label class="label label label-default">起始日期</label></h4>
                            </div>
                            <div class="col-md-8">
                                <div class="col-md-8 input-group date" style="width:auto;">
                                    <input class="form-control form-date" type="text" id="BJSTARTDATE" name="BJSTARTDATE">
                                    <span class="input-group-addon"><i class="fa fa-calendar"></i></span>
                                </div>
                            </div>
                        </div>
                        <div class="dateset paddingset">
                            <div class="col-md-10">
                                <h4><label class="label label label-default">截止日期</label></h4>
                            </div>
                            <div class="col-md-8">
                                <div class="col-md-8 input-group date" style="width:auto;">
                                    <input class="form-control form-date" type="text" id="BJENDDATE" name="BJENDDATE">
                                    <span class="input-group-addon"><i class="fa fa-calendar"></i></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                @if (DJFSdt != null && DJFSdt.Rows.Count > 0 && DJFSdt.Rows[0]["DJFSRID"].ToString() != "")
                {
                    <div class="row ptbj divys">
                        <div class="col-md-6" style="width:100%">
                            <div class="col-md-10">
                                <h4><label class="label label label-default">定价方式</label></h4>
                            </div>
                            <div class="ptdj dlc col-md-8">
                                <button class="fsmore" id="fsmore" title="展开"><i class="fa fa-caret-down"></i></button>
                                <button id="fsless" class="fsless" title="收起" style="display:none;"><i class="fa fa-caret-up"></i></button>
                                @for (int i = 0; i < DJFSdt.Rows.Count; i++)
                                {
                                    <div class="djfs djfszs" onclick='djfsqh("@DJFSdt.Rows[i]["DJFSRID"]","")' fsdisp="@DJFSdt.Rows[i]["FSDISP"]">
                                        <input type="hidden" class="djfsrid" value="@DJFSdt.Rows[i]["DJFSRID"]" />
                                        <input type="text" class="form-control djfsname" title="@DJFSdt.Rows[i]["DJFSNAME"]" value="@DJFSdt.Rows[i]["DJFSNAME"]" readonly>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="row ptbj divys">
                        <div class="col-md-6" style="padding-right:0px;">
                            <div class="col-md-4" style="margin-top:10px;width:100px;">
                                <h4><label class="label label label-default">高低值比较</label></h4>
                            </div>
                            <div class="col-md-8">
