@{
    ViewBag.Title = "字典管理";
    Layout = "~/Views/Shared/_LayoutTM.cshtml";
}
<!-- MAIN CONTENT -->
<style>
    tr .selected {
        background-color: lightgray;
    }

    .DTFC_LeftWrapper {
        top: -6px !important;
    }

    .DTFC_RightWrapper {
        top: -7px !important;
    }

    .grid {
        margin: 0px;
        border-collapse: collapse;
        table-layout: fixed;
    }

        .grid tbody td {
            text-align: left;
            border-bottom: 1px solid #ccc;
            border-left: 1px solid #ccc;
            border-right: 1px solid #ccc;
            height: 22px;
            word-break: break-all;
        }

        .grid tbody .selected {
            background-color: #6DA47D;
            color: #fff;
            cursor: pointer;
        }
    /*.DTFC_LeftHeadWrapper {left: -2px !important; }
    .DTFC_LeftBodyWrapper {left: -2px !important; }*/
    /*.col-sm-1 { padding: 0px; }

    .jarviswidget > div { font-size: 12px; }*/


    /*#datatable_col_reorder td{white-space:nowrap;}
    #datatable_col_reorder th{white-space:nowrap;}*/

    /*模态框modal-body 样式*/
    .modal-div-row {
        margin: 10px 10px;
        display: flex;
        align-items: center;
    }
        .modal-div-row label {
            width: 70px;
        }

        .modal-div-row input {
            height: 32px;
            width: 180px;
            line-height: 32px;
            padding: 5px 7px;
            margin-right: 5px;
            border: 1px solid #ccc;
        }

        .modal-div-row textarea {
            width: 430px;
            padding: 5px 7px;
            border: 1px solid #ccc;
        }

    .checkBox {
        display: inline-block;
    }

        .checkBox li {
            list-style: none;
            float: left;
            margin-right: 15px;
        }

            .checkBox li input {
                width: 18px;
                height: 18px;
                vertical-align: middle;
                margin-top: -2px;
            }
</style>

<div id="content">
    <section id="widget-grid" class="">
        <div class="row">
            <article class="col-sm-12 col-md-12 col-lg-12 sortable-grid ui-sortable">
                <div class="jarviswidget jarviswidget-sortable" data-widget-colorbutton="false" data-widget-editbutton="false" data-widget-custombutton="false">
                    <header>
                        <span class="widget-icon"><i class="fa fa-edit"></i></span>
                        <h2>字典管理/<span style="color:#ffd600!important">字典列表</span></h2>
                        <div style="float:right;">
                            <button type="submit" class="btn btn-success" id="btnadd">
                                新建
                            </button>
                            @*<button type="submit" class="btn btn-success" id="btndelete">
                                    删除
                                </button>*@
                            <button type="submit" class="btn btn-default" id="submit_search">
                                查询
                            </button>
                            <button type="submit" class="btn btn-default" onclick="ResetQueryValue();">
                                查询重置
                            </button>
                        </div>
                    </header>
                    <!-- widget div-->
                    <div role="content">
                        <!-- end widget edit box -->
                        <div class="jarviswidget-editbox"></div>
                        <div class="widget-body">
                            <form id="form1" class="smart-form form-backgroud">
                                <div class="row">
                                    <section class="col col-3">
                                        <label class="label">字典名称</label>
                                        <label class="input">
                                            <input type="text" class="form-control" id="DICNAME" name="DICNAME" placeholder="字典名称">
                                        </label>
                                    </section>
                                    <section class="col col-3">
                                        <label class="label">字典代码</label>
                                        <label class="input">
                                            <input type="text" class="form-control" id="DICCODE" name="DICCODE" placeholder="字典代码">
                                        </label>
                                    </section>
                                    <section class="col col-3">
                                        <label class="label">状态</label>
                                        <label class="input">
                                            <select style="width:100%" id="SIGN" name="SIGN" class="select2"><option></option></select>
                                        </label>
                                    </section>
                                </div>
                            </form>
                        </div>
                        <div class="widget-body no-padding">
                            <table id="datatable_col_reorder" class="table table-striped table-bordered table-hover" style="width:100%"></table>
                        </div>
                    </div>
                </div>
            </article>
        </div>
    </section>
    <!-- end widget grid -->
    <!-- 新建字典弹窗 -->
    <div class="modal fade" id="addDict" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                    <h4 class="modal-title">新建字典</h4>
                </div>
                <div class="modal-body modal-div">
                    <form id="dictform">
                        <div hidden>
                            <input id="RID_mol" />
                            <input id="CREATETIME_mol" />
                            <input id="CREATEUSER_mol" />
                            <input id="MODIFYTIME_mol" />
                        </div>
                        <div class="modal-div-row">
                            <label>字典名称</label>
                            <input class="modal-input" id="DICNAME_mol"/>
                            <label>字典代码</label>
                            <input class="modal-input" id="DICCODE_mol"/>
                        </div>
                        <div class="modal-div-row">
                            <label>状态</label>
                            <div class="checkBox">
                                <ul>
                                    <li>
                                        <input type="radio" id="yx" name="SIGN" value="1" /><span>有效</span>
                                    </li>
                                    <li>
                                        <input type="radio" id="sx" name="SIGN" value="0" /><span>失效</span>
                                    </li>
                                </ul>
                            </div>
                        </div>
                        <div class="modal-div-row" style="clear:both;">
                            <label>描述</label>
                            <textarea rows="3" id="DESCRIPTION_mol"></textarea>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">取消</button>
                    <button type="button" class="btn btn-primary" onclick="SaveForm();">确定</button>
                </div>
            </div>
        </div>
    </div>
</div>
@section pagespecific {
    <script src="~/Content/QO/scripts/framework.js"></script>
    <script src="~/Content/QO/scripts/Ewin.js"></script>
    <script src="~/Content/QO/toastr/toastr.min.js"></script>
    <link rel="stylesheet" href="~/Content/QO/toastr/toastr.min.css">
    <script src="~/Content/QO/layer/layer.js"></script>
    <script src="/js/lib/jquery.plug-ins.js" type="text/javascript"></script>
    <script src="/scripts/plugin/datatables/dataTables.colReorder.min.js" type="text/javascript"></script>
    <script src="/scripts/plugin/datatables/dataTables.colVis.min.js" type="text/javascript"></script>
    <script src="/scripts/plugin/datatables/dataTables.fixedColumns.min.js" type="text/javascript"></script>
    <script src="/scripts/plugin/datatables/dataTables.fixedHeader.js" type="text/javascript"></script>
    <link href="~/Content/QO/scripts/bootstrap-fileinput-master/css/fileinput.min.css" rel="stylesheet">
    <script src="~/Content/QO/scripts/bootstrap-fileinput-master/js/fileinput.min.js"></script>
    <script src="~/Content/QO/scripts/bootstrap-fileinput-master/js/locales/zh.js"></script>

    <link href="~/Content/QO/scripts/bootstrap-datetimepicker/css/bootstrap-datetimepicker.min.css" rel="stylesheet">
    <script src="~/Content/QO/scripts/bootstrap-datetimepicker/js/bootstrap-datetimepicker.min.js"></script>
    <script type="text/javascript" src="~/Content/QO/scripts/bootstrap-datetimepicker/js/locales/bootstrap-datetimepicker.zh-CN.js" charset="UTF-8"></script>
    <script type="text/javascript">
        var username; 
        var sign;
        // 状态
        var dataSel = [{ Code: '1', Name: '有效' }, { Code: '0', Name: '失效' }];
        // toast
        toastr.options = {
            closeButton: false,
            debug: false,
            progressBar: true,
            positionClass: "toast-top-center",
            onclick: null,
            showDuration: "300",
            hideDuration: "1000",
            timeOut: "3000",
            extendedTimeOut: "1000",
            showEasing: "swing",
            hideEasing: "linear",
            showMethod: "fadeIn",
            hideMethod: "fadeOut"
        };
        function placeholderSupport() {
            return 'placeholder' in document.createElement('input');
        }
        // 模态框显示
        function showmodal() {
            $("#addDict").modal({
                show: true,
                backdrop: "static",
                keyboard: false
            });
        }
        // 模态框消失
        function hidemodal() {
            $("#addDict").modal("hide");
        }
        // 模态框消失清除表单数据
        $("body").on("hidden.bs.modal", ".modal", function () {
            $("#addDict").find("input,select,textarea").each(function () {
                $(this).val("");
                $(this).text("");
            });
        });
        // 字典新增
        function addNew()
        {
            sign = "create";
            showmodal();
        }
        // 保存表单数据
        function SaveForm() {
            if (!$("#DICNAME_mol").val()) {
                toastr.error("请填写字典名称！");
                return false;
            } else if ($("#DICNAME_mol").val().indexOf("/") >= 0) {
                toastr.error("字典名称中不允许出现字符：\"/\"");
                return false;
            }
            if (!$("#DICCODE_mol").val()) {
                toastr.error("请填写字典代码！");
                return false;
            } else if ($("#DICCODE_mol").val().indexOf("/") >= 0) {
                toastr.error("字典代码中不允许出现字符：\"/\"");
                return false;
            }
            if (!$("#DESCRIPTION_mol").val()) {
                toastr.error("请填写描述！");
                return false;
            }
            var postdata = GetFormDatas("#dictform");
            $.ajax({
                url: "@Url.Action("SaveDict")",
                type: "POST",
                data: { "postdata": JSON.stringify(postdata), "sign": sign },
                dataType:"Json",
                success: function (msg) {
                    if (msg.Success) {
                        hidemodal();
                        toastr.success("保存成功");
                        $('#datatable_col_reorder').DataTable().search("").draw();
                    } else {
                        toastr.error("保存失败：" + msg.Message);
                    }
                }
            });
        }
        // 编辑选中字典
        function doEdit(row) {
            var data = JSON.parse(unescape(row));
            showmodal();
            sign = "edit";
            $("#dictform").find("input,select,textarea").each(function () {
                var id = $(this).attr("id").replace("_mol","");
                var type = $(this).attr("type");
                switch (type){
                    case "radio":
                        if (data.SIGN == $(this).val()) {
                            $(this).prop("checked", true);
                        }
                        break;
                    default:
                        $(this).val(data[id]);
                        break;
                }
            });
        }
        // 删除选中字典
        function doDelete(prdid)
        {
            popDialog("删除", "确定要删除本条记录吗？", deleteRow);
            // 对话框回调函数
            function deleteRow() {
                $.ajax({
                    url: "/SQM_WEBCONFIG/Delete",
                    type: "Post",
                    async: false,
                    data: {
                        "rowId": prdid
                    },
                    success: function (msg) {
                        toastr.clear();
                        toastr.remove();
                        if (msg.indexOf("成功!") >= 0) {
                            toastr.success("删除成功!");
                            $('#datatable_col_reorder').DataTable().search("").draw();
                        } else {
                            toastr.error(msg);
                        }
                    }
                });
            }
        }
        // 查看字典明细
        function doViewDetail(mrid, dicname) {
            document.location.href = "/SQM_WEBCONFIG/DictDetail?mrid=" + mrid + "&dicname=" + dicname;
        }

        $("#btnadd").click(function () {
            addNew();
            return false;
        });
        $("#submit_search").click(function () {
            $("#datatable_col_reorder").DataTable().search("").draw();
            return false;
        });
       
        $(document).ready(function () {
            ///////////////////
            $("#amenufld").hide();
            $("#logout").hide();
            $("#amenufld").click();
            ///////////////////
            @*var user = '@Oncontrol3.Web.Helpers.SQMHelper.getStaffKey()';
            if (user.length < 1) {
                layer.alert('系统登录已超时，请重新登录', { icon: 2 });
            }
            else {
                username = user;
                //layer.alert('当前登录账户：' + user, { icon: 1 });
            }*@
            // input清除缓存
            $("#form1").find("input,select,textarea").each(function () {
                $(this).attr("autocomplete", "off");
            });
            // 初始化状态
            $(dataSel).each(function (k, o) {
                $("#SIGN").append($("<option></option>").attr("value", o.Code).html(o.Name));
            });
            $("#SIGN").select2({
                placeholder: "状态",
                allowClear: true
            });
            $("#SIGN").select2("val", 1);

            if (placeholderSupport()) {
                $("label[class='label']").hide();
            }
            // 列表初始化
            DrawTable();
            $("div[class='ColVis']").hide();
            // 设备检测
            detectmob();
        });
        // 不能删除的字典
        var dicArr = ["enquiry", "ys", "gyl", "mb", "code"];
        function DrawTable() {
            // 列定义
            var columns = [
                { "title": "创建时间", "data": "CREATETIME", "bVisible": false },
                { "title": "序号", "data": null, "width": "25", "sortable": false},
                {
                    "title": "操作", "data": "RID", "width": "70", "sortable": false,
                    render: function (data, type, row, meta) {
                        var rowstr = escape(JSON.stringify(row));
                        var dicname = escape(row.DICNAME + "/" + row.DICCODE);
                        var text = '<button title="编辑" class="btn btn-xs btn-default" onclick=doEdit(\"' + rowstr + '\") ><i class="fa fa-pencil"></i></button>';
                        if ($.inArray(row.DICCODE, dicArr) < 0) {
                            text += '<button title="删除" class="btn btn-xs btn-default" onclick=doDelete(\"' + data + '\") ><i class="fa fa-times"></i></button>';
                        }
                        text += '<button title="查看明细" class="btn btn-xs btn-default" onclick=doViewDetail(\"' + data + '\",\"' + dicname + '\") ><i class="fa fa-eye"></i></button>';
                        return text;
                    }
                },
                { "title": "字典名称", "data": "DICNAME", "width": "160" },
                { "title": "字典代码", "data": "DICCODE", "width": "160" },
                {
                    "title": "状态", "data": "SIGN", "width": "60",
                    render: function (data, type, row, meta) {
                        if (data == "0") {
                            return "失效";
                        } else {
                            return "有效";
                        }
                    }
                },
                { "title": "描述", "data": "DESCRIPTION", "width": "400" }
            ];
            var table = $('#datatable_col_reorder').dataTable({
                "processing": true,
                "serverSide": true,
                "colReorder": true,
                "scrollX": true,
                "fixedColumns": {
                    leftColumns: 0
                },
                "bStateSave": true,
                "order": [[0, "desc"]],
                "fnDrawCallback": function () {
                    var api = this.api();
                    var startIndex = api.context[0]._iDisplayStart; //获取到本页开始的条数 　
                    api.column(1).nodes().each(function (cell, i) {
                        cell.innerHTML = startIndex + i + 1;
                    });
                    // 取消标题的checkbox选中
                    $("input[name='checkRowIds']").prop("checked", false);
                    // “失效”标题checkbox disabled
                    if ($("#SIGN").val() == "0"){
                        $("input[name = 'checkRowIds']").attr("onclick", "return false;");
                    } else {
                        $("input[name = 'checkRowIds']").attr("onclick", "checkAll();");
                    }
                },
                //"fnRowCallback": function (nRow, aData, iDisplayIndex) {
                //    $("td:first", nRow).html(iDisplayIndex + 1);//设置序号位于第一列，并顺次加一
                //    return nRow;
                //},
                "language": { "info": "第 _START_ 到 _END_ 条记录，共 _TOTAL_ 条",
                    "infoEmpty": "第 0 到 0 条记录，共 0 条",
                    'emptyTable': '没有检索到数据',
                    'zeroRecords': '没有检索到数据',
                    'loadingRecords': '加载中...',
                    'processing': '查询中...',
                    "paginate": { "first": "<<", "last": ">>", "next": ">", "previous": "<" }
                },//语言
                "sDom": "<'dt-toolbar'<'col-xs-12 col-sm-6'><'col-sm-6 col-xs-12 hidden-xs'>r>" + "t" +
                        "<'dt-toolbar-footer'<'col-sm-6 col-xs-12 hidden-xs'i><'col-xs-12 col-sm-6'plC>>",//整个griddom布局
                "lengthMenu": [[4, 10, 20, 50, 100], [4, 10, 20, 50, 100]],//每页显示key text
                "displayLength": 10,//默认每页显示条目数
                "ajax": {
                    "url": "@Url.Action("Lists")",//数据源controller
                    "type": "POST",
                    "data": function (d) {//查询参数
                        d.sort = d.columns[d.order[0].column].data;//排序列名转换
                        d.order = d.order[0].dir;//asc or desc
                        d.DICNAME = $("#DICNAME").val();
                        d.DICCODE = $("#DICCODE").val();
                        d.SIGN = $("#SIGN").val() == "" ? "1" : $("#SIGN").val();
                    }
                },columns: columns,
                "stateSaveParams": function (settings, data) {
                    localStorage.setItem('DataTables_' + settings.sInstance, JSON.stringify(data));
                },
                "stateLoadCallback": function (settings) {
                    var config = JSON.parse(localStorage.getItem('DataTables_' + settings.sInstance));
                    return config;
                }
            });
            //$('#datatable_col_reorder tbody').on('dblclick', 'tr', function () {
            //    var fwo = $('#datatable_col_reorder').DataTable().row(this).data()['RID'];
            //    if ($('#datatable_col_reorder').DataTable().row(this).data()['STATUS'] == "1"){
            //        location.href = '/SQM_COST_HY/Edit?keyValue=' + fwo;
            //    }
            //});
        }

        // modal 对话框
        function popDialog(title, msg, callback) {
            if (!title) {
                title = '对话框';
            }
            var dialogHTML = '<div id="selfDialog" class="modal fade">';
            dialogHTML += '<div class="modal-dialog">';
            dialogHTML += '<div class="modal-content">';
            dialogHTML += '<div class="modal-header">';
            dialogHTML += '<button type="button" class="close" data-dismiss="modal" aria-label="Close">';
            dialogHTML += '<span aria-hidden="true">&times;</span>';
            dialogHTML += '</button>';
            dialogHTML += '<h4 class="modal-title">' + title + '</h4>';
            dialogHTML += '</div>';
            dialogHTML += '<div class="modal-body">';
            dialogHTML += msg;
            dialogHTML += '</div>';
            dialogHTML += '<div class="modal-footer">';
            dialogHTML += '<button type="button" class="btn btn-default" data-dismiss="modal">取消</button>';
            dialogHTML += '<button type="button" class="btn btn-primary" data-dismiss="modal" id="certainDelete">确定</button>';
            dialogHTML += '</div>';
            dialogHTML += '</div>';
            dialogHTML += '</div>';
            dialogHTML += '</div>';

            $("#selfDialog").remove();
            $("body").append(dialogHTML);
            $("#selfDialog").modal("show");
            // 绑定"确定"方法
            $("#certainDelete").click(function(){
                if (typeof callback == "function") {
                    callback();
                }
            });
        }
        // 重置查询条件
        function ResetQueryValue() {
            // 清空查询控件
            $("#form1").find("input,select").each(function () {
                $(this).val("");
            });
            // 失效->有效
            $("#SIGN").select2("val", 1);
            // 刷新页面
            $('#datatable_col_reorder').DataTable().search("").draw();
            return false;
        }
        // 存储表单数据
        function GetFormDatas(element) {
            var postdata = {};
            $(element).find("input,select,textarea").each(function (r) {
                var id = $(this).attr("id").replace("_mol","");
                var type = $(this).attr("type");
                switch (type) {
                    case "radio":
                        if ($(this).is(":checked")) {
                            postdata[$(this).attr("name")] = $(this).val();
                        }
                        break;
                    default:
                        postdata[id] = $(this).val();
                        break;
                }
            });
            postdata["MODIFYUSER"] = username;
            return postdata;
        }
    </script>
}