    }

    .nmpd-wrapper {
        display: none;
    }

    .nmpd-target {
        cursor: pointer;
    }

    .nmpd-grid {
        position: absolute;
        left: 50px;
        top: 50px;
        z-index: 5000;
        -khtml-user-select: none;
        padding: 10px;
        width: initial;
    }

    .nmpd-overlay {
        z-index: 4999;
    }

    input.nmpd-display {
        text-align: right;
    }
