    }

    .bjok {
        color: green;
    }

    .bjover {
        color: #f0ad4e;
    }

    .card-box {
        width: 100%;
        height: 100px;
        float: left;
        border: 1px solid #ccc;
        background-color: #fff;
        border-radius: 1px;
        margin-top: 5px;
        overflow: hidden;
        position: relative;
        padding-bottom: 10px;
    }

    .card-box-content {
        padding: 6px 10px;
        font-size: 14px;
        color: #4d5d70;
    }

