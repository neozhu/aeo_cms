@{
    ViewBag.Title = "成本管理";
    Layout = "~/Views/Shared/_LayoutTM.cshtml";
    System.Data.DataTable HXdt = (System.Data.DataTable)ViewBag.HXdtData;
    //System.Data.DataTable GJDQdt = (System.Data.DataTable)ViewBag.GJDQdtData;

}
<!-- MAIN CONTENT -->
<style>
    tr .selected {
        background-color: lightgray;
    }

    .DTFC_LeftWrapper {
        top: -6px !important;
    }

    .DTFC_RightWrapper {
        top: -7px !important;
    }

    .grid {
        margin: 0px;
        border-collapse: collapse;
        table-layout: fixed;
    }

        .grid tbody td {
            text-align: left;
            border-bottom: 1px solid #ccc;
            border-left: 1px solid #ccc;
            border-right: 1px solid #ccc;
            height: 22px;
            word-break: break-all;
        }

        .grid tbody .selected {
            background-color: #6DA47D;
            color: #fff;
            cursor: pointer;
        }
    /*.DTFC_LeftHeadWrapper {left: -2px !important; }
    .DTFC_LeftBodyWrapper {left: -2px !important; }*/
