@model WebApp.Models.InquiryRef
<div id="inquiryrefdlg" class="easyui-dialog"
     title="InquiryRef" style="width:600px;height:300px; display:none"
     data-options="
                iconCls: 'fal fa-window',
                modal:true,
                closed:true,
                cache: false,
                resizable:true,
                width:620,
                height:300,
                onOpen:function(){
                   $('#inquiryref_form').form('disableValidation');
                },
                buttons: [{
                    text:'确认',
                    handler:function(){
                        confirm_inquiryrefform();
                    }
                },{
                    text:'取消',
                    handler:function(){
                        $('#inquiryrefdlg').dialog('close');
                    }
                }]
            ">
<div class="panel-container show">
      <div class="panel-content p-0">
        <form id="inquiryref_form" class="form-horizontal needs-validation" novalidate>
          <fieldset class="form-group">
            <div class="row h-100 align-items-center m-0 pt-1">
    <!--系统主键-->
	@Html.HiddenFor(model => model.Id)		
             
    <!--询价单号-->
        <label class="col-md-2 form-label text-right p-0" for="@Html.IdFor(model => model.InquiryNo)" ><span class="text-danger">*</span> @Html.DisplayNameFor(model => model.InquiryNo) </label>
<div class="col-md-4 mb-1">
		<input id="@Html.IdFor(model => model.InquiryNo)" 
							name="@Html.NameFor(model => model.InquiryNo)" 
							value="@Html.ValueFor(model => model.InquiryNo)"
							tabindex="1" 
			     			class="easyui-textbox" 
							type="text" 
                            style="width:100%"
							data-options="prompt:'@Html.DisplayNameFor(model => model.InquiryNo)',
     						 required:true ,validType:'length[0,20]'" />
    </div>
             
    <!--任务单号-->
        <label class="col-md-2 form-label text-right p-0" for="@Html.IdFor(model => model.TaskNo)" > @Html.DisplayNameFor(model => model.TaskNo) </label>
<div class="col-md-4 mb-1">
		<input id="@Html.IdFor(model => model.TaskNo)" 
							name="@Html.NameFor(model => model.TaskNo)" 
							value="@Html.ValueFor(model => model.TaskNo)"
							tabindex="2" 
			     			class="easyui-textbox" 
							type="text" 
                            style="width:100%"
							data-options="prompt:'@Html.DisplayNameFor(model => model.TaskNo)',
     						 required:false ,validType:'length[0,20]'" />
    </div>
             
    <!--状态-->
        <label class="col-md-2 form-label text-right p-0" for="@Html.IdFor(model => model.Status)" ><span class="text-danger">*</span> @Html.DisplayNameFor(model => model.Status) </label>
<div class="col-md-4 mb-1">
		<input id="@Html.IdFor(model => model.Status)" 
							name="@Html.NameFor(model => model.Status)" 
							value="@Html.ValueFor(model => model.Status)"
							tabindex="3" 
			     			class="easyui-textbox" 
							type="text" 
                            style="width:100%"
							data-options="prompt:'@Html.DisplayNameFor(model => model.Status)',
     						 required:true ,validType:'length[0,20]'" />
    </div>
             
     <!--询价日期-->
          <label class="col-md-2 form-label text-right p-0" for="@Html.IdFor(model => model.BeginDate)" ><span class="text-danger">*</span> @Html.DisplayNameFor(model => model.BeginDate) </label>
		  <div class="col-md-4 mb-1">
          <input id="@Html.IdFor(model => model.BeginDate)" 
							name="@Html.NameFor(model => model.BeginDate)" 
							tabindex="4" 
							class="easyui-datebox" 
                            type="text"
                            style="width:100%"
							value="@Html.ValueFor(model => model.BeginDate)"
							data-options="prompt:'@Html.DisplayNameFor(model => model.BeginDate)',
								 formatter:dateformatter,
                                 required:true " />
     </div>
             
    <!--业务员-->
        <label class="col-md-2 form-label text-right p-0" for="@Html.IdFor(model => model.Salesman)" > @Html.DisplayNameFor(model => model.Salesman) </label>
<div class="col-md-4 mb-1">
		<input id="@Html.IdFor(model => model.Salesman)" 
							name="@Html.NameFor(model => model.Salesman)" 
							value="@Html.ValueFor(model => model.Salesman)"
							tabindex="5" 
			     			class="easyui-textbox" 
							type="text" 
                            style="width:100%"
							data-options="prompt:'@Html.DisplayNameFor(model => model.Salesman)',
     						 required:false ,validType:'length[0,20]'" />
    </div>
             
    <!--部门-->
        <label class="col-md-2 form-label text-right p-0" for="@Html.IdFor(model => model.Dept)" > @Html.DisplayNameFor(model => model.Dept) </label>
<div class="col-md-4 mb-1">
		<input id="@Html.IdFor(model => model.Dept)" 
							name="@Html.NameFor(model => model.Dept)" 
							value="@Html.ValueFor(model => model.Dept)"
							tabindex="6" 
			     			class="easyui-textbox" 
							type="text" 
                            style="width:100%"
							data-options="prompt:'@Html.DisplayNameFor(model => model.Dept)',
     						 required:false ,validType:'length[0,80]'" />
    </div>
             
    <!--系统版本号-->
        <label class="col-md-2 form-label text-right p-0" for="@Html.IdFor(model => model.Ver)" ><span class="text-danger">*</span> @Html.DisplayNameFor(model => model.Ver) </label>
<div class="col-md-4 mb-1">
		<input id="@Html.IdFor(model => model.Ver)"
							name="@Html.NameFor(model => model.Ver)" 
							value="@Html.ValueFor(model => model.Ver)"
							tabindex="7" 
							class="easyui-numberbox" 
							type="text" 
                            style="width:100%"
							data-options="prompt:'@Html.DisplayNameFor(model => model.Ver)',
								 required:true,
                                 formatter:intformatter,
                                 parser:parsernumber
                                 " />
    </div>
             
      <!--询价单-->
      <input type="hidden" id="InquiryInquiryNo" name="InquiryInquiryNo" value="">
	  <input id="@Html.IdFor(model => model.InquiryId)"
			       name="@Html.NameFor(model => model.InquiryId)"
				   value="@Html.ValueFor(model => model.InquiryId)"
                   type="hidden" />
             
  
           </div>
       </fieldset>
    </form>
  </div>
</div>
</div>
<script type="text/javascript">
     var form_state = 'Added';
     var current_index = -1;
     var inquiryref = {};
 
     function open_inquiryrefdlg(index, row, state) {
         form_state = state;
         current_index = index;
         inquiryref = row;
         $('#inquiryrefdlg').dialog('open');
         if (form_state === 'Added') {
             $('#inquiryrefdlg').dialog('setTitle', '新增明细');
         } else {
             $('#inquiryrefdlg').dialog('setTitle', '修改明细');
         }
         $('#inquiryref_form').form('reset');
         $('#inquiryref_form').form('load', inquiryref);
     }
     function confirm_inquiryrefform() {
         $inquiryrefform = $('#inquiryref_form');
         if ($inquiryrefform.form('enableValidation').form('validate')) {
             inquiryref = $inquiryrefform.serializeJSON();
             if (form_state === 'Added') {
                 $(document).trigger('inquiryref_form.add', [current_index, inquiryref])
             } else {
                 $(document).trigger('inquiryref_form.edit', [current_index, inquiryref])
             }
             $('#inquiryrefdlg').dialog('close');
         }
     }
 </script>

 