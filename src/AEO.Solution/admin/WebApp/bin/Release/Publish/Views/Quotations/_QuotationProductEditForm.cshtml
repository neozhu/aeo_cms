@model WebApp.Models.QuotationProduct
<div id="quotationproductdlg" class="easyui-dialog"
     title="编辑产品信息" style="width:680px;height:390px; display:none"
     data-options="
                iconCls: 'fal fa-window',
                modal:true,
                closed:true,
                cache: false,
                resizable:true,
                onOpen:function(){
                   $('#quotationproduct_form').form('disableValidation');
                },
                buttons: [{
                    text:'确认',
                    handler:function(){
                        confirm_quotationproductform();
                    }
                },{
                    text:'取消',
                    handler:function(){
                        $('#quotationproductdlg').dialog('close');
                    }
                }]
            ">
  <div class="panel-container show">
    <div class="panel-content p-0">
      <form id="quotationproduct_form" class="form-horizontal needs-validation" novalidate>
        <div class="d-flex">
          <fieldset class="form-group flex-grow-1">
            <div class="row h-100 align-items-center m-0 pt-1">
              <!--系统主键-->
              @Html.HiddenFor(model => model.Id)
              @Html.HiddenFor(model => model.SupplierCode)
              @Html.HiddenFor(model => model.SupplierName)
              @Html.HiddenFor(model => model.Logo)
              @Html.HiddenFor(model => model.QpNo)
              @Html.HiddenFor(model => model.QuotationId)
              @Html.HiddenFor(model => model.SupplierProductNo)
              @Html.HiddenFor(model => model.Cur)

              <!--产品类别-->
              <label class="col-md-2 form-label text-right p-0" for="@Html.IdFor(model => model.CategoryName)"> @Html.DisplayNameFor(model => model.CategoryName) </label>
              <div class="col-md-4 mb-1">
                <input id="@Html.IdFor(model => model.CategoryName)"
                       name="@Html.NameFor(model => model.CategoryName)"
                       value="@Html.ValueFor(model => model.CategoryName)"
                       tabindex="3"
                       class="easyui-textbox"
                       type="text"
                       style="width:100%"
                       data-options="prompt:'@Html.DisplayNameFor(model => model.CategoryName)',
     						 required:false ,validType:'length[0,50]',readonly:true" />
              </div>
              <!--产品编号(自动生成,可手工修改)-->
              <label class="col-md-2 form-label text-right p-0" for="@Html.IdFor(model => model.ProductNo)"> @Html.DisplayNameFor(model => model.ProductNo) </label>
              <div class="col-md-4 mb-1">
                <input id="@Html.IdFor(model => model.ProductNo)"
                       name="@Html.NameFor(model => model.ProductNo)"
                       value="@Html.ValueFor(model => model.ProductNo)"
                       tabindex="1"
                       class="easyui-textbox"
                       type="text"
                       style="width:100%"
                       data-options="prompt:'@Html.DisplayNameFor(model => model.ProductNo)',
     						      required:false ,validType:'length[0,50]',readonly:true" />
              </div>

              <!--中文品名-->
              <label class="col-md-2 form-label text-right p-0" for="@Html.IdFor(model => model.ProductName)"> @Html.DisplayNameFor(model => model.ProductName) </label>
              <div class="col-md-4 mb-1">
                <input id="@Html.IdFor(model => model.ProductName)"
                       name="@Html.NameFor(model => model.ProductName)"
                       value="@Html.ValueFor(model => model.ProductName)"
                       tabindex="2"
                       class="easyui-textbox"
                       type="text"
                       style="width:100%"
                       data-options="prompt:'@Html.DisplayNameFor(model => model.ProductName)',
     						 required:false ,validType:'length[0,200]',readonly:true" />
              </div>

              <!--英文品名-->
              <label class="col-md-2 form-label text-right p-0" for="@Html.IdFor(model => model.ProductEnName)"> @Html.DisplayNameFor(model => model.ProductEnName) </label>
              <div class="col-md-4 mb-1">
                <input id="@Html.IdFor(model => model.ProductEnName)"
                       name="@Html.NameFor(model => model.ProductEnName)"
                       value="@Html.ValueFor(model => model.ProductEnName)"
                       tabindex="4"
                       class="easyui-textbox"
                       type="text"
                       style="width:100%"
                       data-options="prompt:'@Html.DisplayNameFor(model => model.ProductEnName)',
     						 required:false ,validType:'length[0,200]'" />
              </div>
              <!--规格型号-->
              <label class="col-md-2 form-label text-right p-0" for="@Html.IdFor(model => model.Spec)"> @Html.DisplayNameFor(model => model.Spec) </label>
              <div class="col-md-10 mb-1">
                <input id="@Html.IdFor(model => model.Spec)"
                       name="@Html.NameFor(model => model.Spec)"
                       value="@Html.ValueFor(model => model.Spec)"
                       tabindex="5"
                       class="easyui-textbox"
                       type="text"
                       style="width:100%"
                       data-options="prompt:'@Html.DisplayNameFor(model => model.Spec)',
     						 required:false " />
              </div>
              <!--中文描述-->
              <label class="col-md-2 form-label text-right p-0" for="@Html.IdFor(model => model.CnDescription)"> @Html.DisplayNameFor(model => model.CnDescription) </label>
              <div class="col-md-10 mb-1">
                <input id="@Html.IdFor(model => model.CnDescription)"
                       name="@Html.NameFor(model => model.CnDescription)"
                       value="@Html.ValueFor(model => model.CnDescription)"
                       tabindex="5"
                       class="easyui-textbox"
                       type="text"
                       style="width:100%"
                       data-options="prompt:'@Html.DisplayNameFor(model => model.CnDescription)',
     						 required:false " />
              </div>

              <!--英文描述-->
              <label class="col-md-2 form-label text-right p-0" for="@Html.IdFor(model => model.EnDescription)"> @Html.DisplayNameFor(model => model.EnDescription) </label>
              <div class="col-md-10 mb-1">
                <input id="@Html.IdFor(model => model.EnDescription)"
                       name="@Html.NameFor(model => model.EnDescription)"
                       value="@Html.ValueFor(model => model.EnDescription)"
                       tabindex="6"
                       class="easyui-textbox"
                       type="text"
                       style="width:100%"
                       data-options="prompt:'@Html.DisplayNameFor(model => model.EnDescription)',
     						 required:false " />
              </div>




              <!--厂商货号-->
              <label class="col-md-2 form-label text-right p-0" for="@Html.IdFor(model => model.ThirdProductNo)"> @Html.DisplayNameFor(model => model.ThirdProductNo) </label>
              <div class="col-md-4 mb-1">
                <input id="@Html.IdFor(model => model.ThirdProductNo)"
                       name="@Html.NameFor(model => model.ThirdProductNo)"
                       value="@Html.ValueFor(model => model.ThirdProductNo)"
                       tabindex="13"
                       class="easyui-textbox"
                       type="text"
                       style="width:100%"
                       data-options="prompt:'@Html.DisplayNameFor(model => model.ThirdProductNo)',
     						 required:false ,validType:'length[0,128]'" />
              </div>
              <!--询价数量-->
              <label class="col-md-2 form-label text-right p-0" for="@Html.IdFor(model => model.Qty)"><span class="text-danger">*</span> @Html.DisplayNameFor(model => model.Qty) </label>
              <div class="col-md-4 mb-1">
                <input id="@Html.IdFor(model => model.Qty)"
                       name="@Html.NameFor(model => model.Qty)"
                       value="@Html.ValueFor(model => model.Qty)"
                       tabindex="8"
                       class="easyui-numberbox"
                       type="text"
                       style="width:100%"
                       data-options="prompt:'@Html.DisplayNameFor(model => model.Qty)',
                                 precision:2,onChange:function(){ calgoodsamount() },
								 required:true,validType:'integer',
                                 formatter:intformatter,
                                 parser:parsernumber
                                 " />
              </div>

              <!--单位-->
              <label class="col-md-2 form-label text-right p-0" for="@Html.IdFor(model => model.Unit)"> @Html.DisplayNameFor(model => model.Unit) </label>
              <div class="col-md-4 mb-1">
                <input id="@Html.IdFor(model => model.Unit)"
                       name="@Html.NameFor(model => model.Unit)"
                       value="@Html.ValueFor(model => model.Unit)"
                       tabindex="9"
                       class="easyui-combobox"
                       type="text"
                       style="width:100%"
                       data-options="prompt:'@Html.DisplayNameFor(model => model.Unit)',
     						 required:false,data:unitdatasource ,validType:'length[0,10]'" />
              </div>





              <!--报价金额-->
              <label class="col-md-2 form-label text-right p-0" for="@Html.IdFor(model => model.Price)"><span class="text-danger">*</span> @Html.DisplayNameFor(model => model.Price) </label>
              <div class="col-md-4 mb-1">
                <input id="@Html.IdFor(model => model.Price)"
                       name="@Html.NameFor(model => model.Price)"
                       value="@Html.ValueFor(model => model.Price)"
                       tabindex="15"
                       class="easyui-numberbox"
                       type="text"
                       style="width:100%"
                       data-options="prompt:'@Html.DisplayNameFor(model => model.Price)',
                                 precision:2,
								 required:true,onChange:function(){ calgoodsamount() },
                                 formatter:intformatter,
                                 parser:parsernumber
                                 " />
              </div>
              <!--价格类型-->
              <label class="col-md-2 form-label text-right p-0" for="@Html.IdFor(model => model.PriceType)"><span class="text-danger">*</span> @Html.DisplayNameFor(model => model.PriceType) </label>
              <div class="col-md-4 mb-1">
                <input id="@Html.IdFor(model => model.PriceType)"
                       name="@Html.NameFor(model => model.PriceType)"
                       value="@Html.ValueFor(model => model.PriceType)"
                       tabindex="14"
                       class="easyui-combobox"
                       type="text"
                       style="width:100%"
                       data-options="prompt:'@Html.DisplayNameFor(model => model.PriceType)',
     						 required:true ,validType:'length[0,30]',data:pricetypedatasource,panelHeight:'auto'" />
              </div>
              <!--总价-->
              <label class="col-md-2 form-label text-right p-0" for="Amount"> 金额 </label>
              <div class="col-md-4 mb-1">
                <input id="Amount"
                       name="Amount"
                       value=""
                       tabindex="10"
                       class="easyui-numberbox"
                       type="text"
                       style="width:100%"
                       data-options="prompt:'总价',
     						 required:false,readonly:true" />
              </div>
              <!--执行人-->
              <label class="col-md-2 form-label text-right p-0" for="@Html.IdFor(model => model.Executor)"><span class="text-danger">*</span> @Html.DisplayNameFor(model => model.Executor) </label>
              <div class="col-md-4 mb-1">
                <input id="@Html.IdFor(model => model.Executor)"
                       name="@Html.NameFor(model => model.Executor)"
                       value="@Html.ValueFor(model => model.Executor)"
                       tabindex="10"
                       class="easyui-textbox"
                       type="text"
                       style="width:100%"
                       data-options="prompt:'@Html.DisplayNameFor(model => model.Executor)',
     						 required:true ,validType:'length[0,20]'" />
              </div>











            </div>
          </fieldset>
          <div class="p-2 align-content-center text-center">
            <input type="file" id="samplepricturefile" style="display:none" />
            <img id="sampleimg" data-src="holder.js/160x160"
                 class="rounded mx-auto d-block"
                 alt="160x160"
                 src="~/Scripts/holder.js"
                 data-holder-rendered="true" style="width: 160px; height: 160px;">
            <button type="button" class="mt-1 ml-auto btn btn-outline-primary btn-sm btn-pills waves-effect waves-themed" onclick="uploadsamplepric()">上传图片</button>
          </div>
        </div>
      </form>
    </div>
  </div>
</div>
<script type="text/javascript">
  var form_state = 'Added';
  var current_index = -1;
  var quotationproduct = {};
  function calgoodsamount() {
    const v1 = parseFloat($('#quotationproduct_form #Qty').numberbox('getValue'));
    const v2 = parseFloat($('#quotationproduct_form #Price').numberbox('getValue'));
    $('#quotationproduct_form #Amount').numberbox('setValue',v1*v2);
  }
  function open_quotationproductdlg(index, row, state) {
    form_state = state;
    current_index = index;
    quotationproduct = row;
    $('#quotationproductdlg').dialog('open');
    
    $('#quotationproduct_form').form('reset');
    $('#quotationproduct_form').form('load', quotationproduct);
  }
  function confirm_quotationproductform() {
    $quotationproductform = $('#quotationproduct_form');
    if ($quotationproductform.form('enableValidation').form('validate')) {
      quotationproduct = $quotationproductform.serializeJSON();
      if (form_state === 'Added') {
        $(document).trigger('quotationproduct_form.add', [current_index, quotationproduct])
      } else {
        $(document).trigger('quotationproduct_form.edit', [current_index, quotationproduct])
      }
      $('#quotationproductdlg').dialog('close');
    }
  }
</script>

