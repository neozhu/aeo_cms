﻿@model WebApp.Models.Category
  <div class="form-row">
   @Html.HiddenFor(x=>x.Id)
         <!--类别名称-->
        <div class="col-xs-12 col-sm-6 col-md-4 col-lg-3">
            <label class="form-label">  @Html.DisplayNameFor(model => model.Name)</label>
			@Html.EditorFor(x => x.Name, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.Name) } })
      
         </div>

        <!--英文名称-->
        <div class="col-xs-12 col-sm-6 col-md-4 col-lg-3">
            <label class="form-label">  @Html.DisplayNameFor(model => model.EName)</label>
			@Html.EditorFor(x => x.EName, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.EName) } })
      
         </div>

        <!--图标-->
        <div class="col-xs-12 col-sm-6 col-md-4 col-lg-3">
            <label class="form-label">  @Html.DisplayNameFor(model => model.Icon)</label>
			@Html.EditorFor(x => x.Icon, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.Icon) } })
      
         </div>

     
       <!--上级类别-->
       <div class="col-xs-12 col-sm-6 col-md-4 col-lg-3">
            <label class="form-label">  @Html.DisplayNameFor(model => model.ParentId)</label>
   	        @Html.DropDownListFor(model => model.ParentId, ViewBag.ParentId as List<SelectListItem>, htmlAttributes: new { @class = "form-control" }) 
       </div>

	    
</div>

