﻿@model WebApp.Models.CustomerShare
  <div class="form-row">
   @Html.HiddenFor(x=>x.Id)
         <!--共享人-->
        <div class="col-xs-12 col-md-6">
            <label class="form-label text-danger">@Html.DisplayNameFor(model => model.Owner)</label>
			@Html.EditorFor(x => x.Owner, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.Owner) } })
      
         </div>

        <!--部门-->
        <div class="col-xs-12 col-md-6">
            <label class="form-label ">@Html.DisplayNameFor(model => model.Dept)</label>
			@Html.EditorFor(x => x.Dept, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.Dept) } })
      
         </div>

        <!--人员-->
        <div class="col-xs-12 col-md-6">
            <label class="form-label text-danger">@Html.DisplayNameFor(model => model.ShareTo)</label>
			@Html.EditorFor(x => x.ShareTo, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.ShareTo) } })
      
         </div>

        <!--模块-->
        <div class="col-xs-12 col-md-6">
            <label class="form-label ">@Html.DisplayNameFor(model => model.Module)</label>
			@Html.EditorFor(x => x.Module, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.Module) } })
      
         </div>

		
      <!--查询-->
      <div class="col-xs-12 col-md-6">
              <label class="form-label text-danger">@Html.DisplayNameFor(model => model.Searchable)</label>
              <div class="custom-control custom-checkbox">
                 <input id="@Html.IdFor(model => model.Searchable)"
                       name="@Html.NameFor(model => model.Searchable)"
                       value="true" @(Model.Searchable ? "checked=\"checked\"" : "")
                       class="custom-control-input"
                       tabindex="6"
                       type="checkbox" />
                <label class="custom-control-label" for="@Html.IdFor(model => model.Searchable)">@Html.DisplayNameFor(model => model.Searchable)</label>
            </div>
      </div>

		
      <!--编辑-->
      <div class="col-xs-12 col-md-6">
              <label class="form-label text-danger">@Html.DisplayNameFor(model => model.Editable)</label>
              <div class="custom-control custom-checkbox">
                 <input id="@Html.IdFor(model => model.Editable)"
                       name="@Html.NameFor(model => model.Editable)"
                       value="true" @(Model.Editable ? "checked=\"checked\"" : "")
                       class="custom-control-input"
                       tabindex="6"
                       type="checkbox" />
                <label class="custom-control-label" for="@Html.IdFor(model => model.Editable)">@Html.DisplayNameFor(model => model.Editable)</label>
            </div>
      </div>

     
       <!--所属客户-->
       <div class="col-xs-12 col-md-6">
            <label class="form-label text-danger">@Html.DisplayNameFor(model => model.CustomerId)</label>
   	        @Html.DropDownListFor(model => model.CustomerId, ViewBag.CustomerId as List<SelectListItem>, htmlAttributes: new { @class = "form-control" }) 
       </div>

        <!--客户编号-->
        <div class="col-xs-12 col-md-6">
            <label class="form-label text-danger">@Html.DisplayNameFor(model => model.CustomerCode)</label>
			@Html.EditorFor(x => x.CustomerCode, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.CustomerCode) } })
      
         </div>

        <!--客户名称-->
        <div class="col-xs-12 col-md-6">
            <label class="form-label text-danger">@Html.DisplayNameFor(model => model.CustomerName)</label>
			@Html.EditorFor(x => x.CustomerName, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.CustomerName) } })
      
         </div>

	    
</div>

