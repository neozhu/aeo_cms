﻿@model WebApp.Models.QuotationCharge
  <div class="form-row">
   @Html.HiddenFor(x=>x.Id)
         <!--费用名称(中文)-->
        <div class="col-xs-12 col-sm-6 col-md-4 col-lg-3">
            <label class="form-label">  @Html.DisplayNameFor(model => model.Name)</label>
			@Html.EditorFor(x => x.Name, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.Name) } })
      
         </div>

        <!--费用名称(英文)-->
        <div class="col-xs-12 col-sm-6 col-md-4 col-lg-3">
            <label class="form-label">  @Html.DisplayNameFor(model => model.EName)</label>
			@Html.EditorFor(x => x.EName, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.EName) } })
      
         </div>

		<!--金额-->
        <div class="col-xs-12 col-sm-6 col-md-4 col-lg-3">
            <label class="form-label"> <span class="text-danger">*</span> @Html.DisplayNameFor(model => model.Amount)</label>
            @Html.EditorFor(x => x.Amount, new { htmlAttributes = new { @class = "form-control",@type="number", placeholder = Html.DisplayNameFor(x => x.Amount) } })

        </div>

     
       <!--报价单-->
       <div class="col-xs-12 col-sm-6 col-md-4 col-lg-3">
            <label class="form-label"> <span class="text-danger">*</span> @Html.DisplayNameFor(model => model.QuotationId)</label>
   	        @Html.DropDownListFor(model => model.QuotationId, ViewBag.QuotationId as List<SelectListItem>, htmlAttributes: new { @class = "form-control" }) 
       </div>

	    
</div>

