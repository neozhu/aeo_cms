﻿@model WebApp.Models.InquiryTask
  <div class="form-row">
   @Html.HiddenFor(x=>x.Id)
         <!--任务单号-->
        <div class="col-xs-12 col-sm-6 col-md-4 col-lg-3">
            <label class="form-label"> <span class="text-danger">*</span> @Html.DisplayNameFor(model => model.TaskNo)</label>
			@Html.EditorFor(x => x.TaskNo, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.TaskNo) } })
      
         </div>

        <!--状态-->
        <div class="col-xs-12 col-sm-6 col-md-4 col-lg-3">
            <label class="form-label"> <span class="text-danger">*</span> @Html.DisplayNameFor(model => model.Status)</label>
			@Html.EditorFor(x => x.Status, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.Status) } })
      
         </div>

        <!--业务员-->
        <div class="col-xs-12 col-sm-6 col-md-4 col-lg-3">
            <label class="form-label"> <span class="text-danger">*</span> @Html.DisplayNameFor(model => model.Salesman)</label>
			@Html.EditorFor(x => x.Salesman, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.Salesman) } })
      
         </div>

     
       <!--公司-->
       <div class="col-xs-12 col-sm-6 col-md-4 col-lg-3">
            <label class="form-label"> <span class="text-danger">*</span> @Html.DisplayNameFor(model => model.CompanyId)</label>
   	        @Html.DropDownListFor(model => model.CompanyId, ViewBag.CompanyId as List<SelectListItem>, htmlAttributes: new { @class = "form-control" }) 
       </div>

        <!--公司名称-->
        <div class="col-xs-12 col-sm-6 col-md-4 col-lg-3">
            <label class="form-label">  @Html.DisplayNameFor(model => model.CompanyName)</label>
			@Html.EditorFor(x => x.CompanyName, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.CompanyName) } })
      
         </div>

     
       <!--客户-->
       <div class="col-xs-12 col-sm-6 col-md-4 col-lg-3">
            <label class="form-label"> <span class="text-danger">*</span> @Html.DisplayNameFor(model => model.CustomerId)</label>
   	        @Html.DropDownListFor(model => model.CustomerId, ViewBag.CustomerId as List<SelectListItem>, htmlAttributes: new { @class = "form-control" }) 
       </div>

        <!--客户编号-->
        <div class="col-xs-12 col-sm-6 col-md-4 col-lg-3">
            <label class="form-label"> <span class="text-danger">*</span> @Html.DisplayNameFor(model => model.CustomerCode)</label>
			@Html.EditorFor(x => x.CustomerCode, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.CustomerCode) } })
      
         </div>

        <!--客户名称-->
        <div class="col-xs-12 col-sm-6 col-md-4 col-lg-3">
            <label class="form-label"> <span class="text-danger">*</span> @Html.DisplayNameFor(model => model.CustomerName)</label>
			@Html.EditorFor(x => x.CustomerName, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.CustomerName) } })
      
         </div>

        <!--国家地区-->
        <div class="col-xs-12 col-sm-6 col-md-4 col-lg-3">
            <label class="form-label">  @Html.DisplayNameFor(model => model.Country)</label>
			@Html.EditorFor(x => x.Country, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.Country) } })
      
         </div>

        <!--币种-->
        <div class="col-xs-12 col-sm-6 col-md-4 col-lg-3">
            <label class="form-label">  @Html.DisplayNameFor(model => model.Cur)</label>
			@Html.EditorFor(x => x.Cur, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.Cur) } })
      
         </div>

		<!--汇率-->
        <div class="col-xs-12 col-sm-6 col-md-4 col-lg-3">
            <label class="form-label">  @Html.DisplayNameFor(model => model.ExchangeRate)</label>
            @Html.EditorFor(x => x.ExchangeRate, new { htmlAttributes = new { @class = "form-control",@type="number", placeholder = Html.DisplayNameFor(x => x.ExchangeRate) } })

        </div>

        <!--联系人-->
        <div class="col-xs-12 col-sm-6 col-md-4 col-lg-3">
            <label class="form-label"> <span class="text-danger">*</span> @Html.DisplayNameFor(model => model.ContactName)</label>
			@Html.EditorFor(x => x.ContactName, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.ContactName) } })
      
         </div>

        <!--联系方式-->
        <div class="col-xs-12 col-sm-6 col-md-4 col-lg-3">
            <label class="form-label">  @Html.DisplayNameFor(model => model.ContactInfo)</label>
			@Html.EditorFor(x => x.ContactInfo, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.ContactInfo) } })
      
         </div>

       <!--开始日期-->
       <div class="col-xs-12 col-sm-6 col-md-4 col-lg-3">
            <label class="form-label"> <span class="text-danger">*</span> @Html.DisplayNameFor(model => model.BeginDate)</label>
            <div class="input-group">
			  @Html.EditorFor(x => x.BeginDate, 
                         new { htmlAttributes = new { @class = "form-control datepicker",
                               placeholder = Html.DisplayNameFor(x => x.BeginDate ) } })
               <div class="input-group-append">
                                                            <span class="input-group-text fs-xl">
                                                                <i class="fal fa-calendar-alt"></i>
                                                            </span>
                                                        </div>
			 </div>
         </div>

       <!--结束日期-->
       <div class="col-xs-12 col-sm-6 col-md-4 col-lg-3">
            <label class="form-label"> <span class="text-danger">*</span> @Html.DisplayNameFor(model => model.Enddate)</label>
            <div class="input-group">
			  @Html.EditorFor(x => x.Enddate, 
                         new { htmlAttributes = new { @class = "form-control datepicker",
                               placeholder = Html.DisplayNameFor(x => x.Enddate ) } })
               <div class="input-group-append">
                                                            <span class="input-group-text fs-xl">
                                                                <i class="fal fa-calendar-alt"></i>
                                                            </span>
                                                        </div>
			 </div>
         </div>

        <!--紧急程度-->
        <div class="col-xs-12 col-sm-6 col-md-4 col-lg-3">
            <label class="form-label">  @Html.DisplayNameFor(model => model.Urgency)</label>
			@Html.EditorFor(x => x.Urgency, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.Urgency) } })
      
         </div>

        <!--询价要求-->
        <div class="col-xs-12 col-sm-6 col-md-4 col-lg-3">
            <label class="form-label">  @Html.DisplayNameFor(model => model.Demande)</label>
			@Html.EditorFor(x => x.Demande, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.Demande) } })
      
         </div>

		<!--到期提醒-->
        <div class="col-xs-12 col-sm-6 col-md-4 col-lg-3">
            <label class="form-label"> <span class="text-danger">*</span> @Html.DisplayNameFor(model => model.PreRemind)</label>
            @Html.EditorFor(x => x.PreRemind, new { htmlAttributes = new { @class = "form-control",@type="number", placeholder = Html.DisplayNameFor(x => x.PreRemind) } })

        </div>

		
      <!--创建人-->
      <div class="col-xs-12 col-sm-6 col-md-4 col-lg-3">
              <label class="form-label"> <span class="text-danger">*</span> @Html.DisplayNameFor(model => model.Check1)</label>
              <div class="custom-control custom-checkbox">
                 <input id="@Html.IdFor(model => model.Check1)"
                       name="@Html.NameFor(model => model.Check1)"
                       value="true" @(Model.Check1 ? "checked=\"checked\"" : "")
                       class="custom-control-input"
                       tabindex="6"
                       type="checkbox" />
                <label class="custom-control-label" for="@Html.IdFor(model => model.Check1)">@Html.DisplayNameFor(model => model.Check1)</label>
            </div>
      </div>

        <!--创建人-->
        <div class="col-xs-12 col-sm-6 col-md-4 col-lg-3">
            <label class="form-label">  @Html.DisplayNameFor(model => model.Creator)</label>
			@Html.EditorFor(x => x.Creator, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.Creator) } })
      
         </div>

        <!--执行人-->
        <div class="col-xs-12 col-sm-6 col-md-4 col-lg-3">
            <label class="form-label">  @Html.DisplayNameFor(model => model.Executor)</label>
			@Html.EditorFor(x => x.Executor, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.Executor) } })
      
         </div>

		
      <!--Check2-->
      <div class="col-xs-12 col-sm-6 col-md-4 col-lg-3">
              <label class="form-label"> <span class="text-danger">*</span> @Html.DisplayNameFor(model => model.Check2)</label>
              <div class="custom-control custom-checkbox">
                 <input id="@Html.IdFor(model => model.Check2)"
                       name="@Html.NameFor(model => model.Check2)"
                       value="true" @(Model.Check2 ? "checked=\"checked\"" : "")
                       class="custom-control-input"
                       tabindex="6"
                       type="checkbox" />
                <label class="custom-control-label" for="@Html.IdFor(model => model.Check2)">@Html.DisplayNameFor(model => model.Check2)</label>
            </div>
      </div>

		
      <!--责任人-->
      <div class="col-xs-12 col-sm-6 col-md-4 col-lg-3">
              <label class="form-label"> <span class="text-danger">*</span> @Html.DisplayNameFor(model => model.Check3)</label>
              <div class="custom-control custom-checkbox">
                 <input id="@Html.IdFor(model => model.Check3)"
                       name="@Html.NameFor(model => model.Check3)"
                       value="true" @(Model.Check3 ? "checked=\"checked\"" : "")
                       class="custom-control-input"
                       tabindex="6"
                       type="checkbox" />
                <label class="custom-control-label" for="@Html.IdFor(model => model.Check3)">@Html.DisplayNameFor(model => model.Check3)</label>
            </div>
      </div>

        <!--责任人-->
        <div class="col-xs-12 col-sm-6 col-md-4 col-lg-3">
            <label class="form-label">  @Html.DisplayNameFor(model => model.Owner)</label>
			@Html.EditorFor(x => x.Owner, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.Owner) } })
      
         </div>

	    
</div>

