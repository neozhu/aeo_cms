@model WebApp.Models.CustomerSales
<div id="customersalesdlg" class="easyui-dialog"
     title="CustomerSales" style="width:600px;height:300px; display:none"
     data-options="
                iconCls: 'fal fa-window',
                modal:true,
                closed:true,
                cache: false,
                resizable:true,
                width:620,
                height:300,
                onOpen:function(){
                   $('#customersales_form').form('disableValidation');
                },
                buttons: [{
                    text:'确认',
                    handler:function(){
                        confirm_customersalesform();
                    }
                },{
                    text:'取消',
                    handler:function(){
                        $('#customersalesdlg').dialog('close');
                    }
                }]
            ">
<div class="panel-container show">
      <div class="panel-content p-0">
        <form id="customersales_form" class="form-horizontal needs-validation" novalidate>
          <fieldset class="form-group">
            <div class="row h-100 align-items-center m-0 pt-1">
    <!--系统主键-->
	@Html.HiddenFor(model => model.Id)		
             
    <!--状态-->
        <label class="col-md-2 form-label text-right p-0" for="@Html.IdFor(model => model.Status)" >@Html.DisplayNameFor(model => model.Status) </label>
<div class="col-md-4 mb-1">
		<input id="@Html.IdFor(model => model.Status)" 
							name="@Html.NameFor(model => model.Status)" 
							value="@Html.ValueFor(model => model.Status)"
							tabindex="1" 
			     			class="easyui-textbox" 
							type="text" 
                            style="width:100%"
							data-options="prompt:'@Html.DisplayNameFor(model => model.Status)',
     						 required:false ,validType:'length[0,20]'" />
    </div>
             
    <!--业务员-->
        <label class="col-md-2 form-label text-right p-0" for="@Html.IdFor(model => model.Salesman)" >@Html.DisplayNameFor(model => model.Salesman) </label>
<div class="col-md-4 mb-1">
		<input id="@Html.IdFor(model => model.Salesman)" 
							name="@Html.NameFor(model => model.Salesman)" 
							value="@Html.ValueFor(model => model.Salesman)"
							tabindex="2" 
			     			class="easyui-textbox" 
							type="text" 
                            style="width:100%"
							data-options="prompt:'@Html.DisplayNameFor(model => model.Salesman)',
     						 required:false ,validType:'length[0,20]'" />
    </div>
             
    <!--所属部门-->
        <label class="col-md-2 form-label text-right p-0" for="@Html.IdFor(model => model.Dept)" >@Html.DisplayNameFor(model => model.Dept) </label>
<div class="col-md-4 mb-1">
		<input id="@Html.IdFor(model => model.Dept)" 
							name="@Html.NameFor(model => model.Dept)" 
							value="@Html.ValueFor(model => model.Dept)"
							tabindex="3" 
			     			class="easyui-textbox" 
							type="text" 
                            style="width:100%"
							data-options="prompt:'@Html.DisplayNameFor(model => model.Dept)',
     						 required:false ,validType:'length[0,20]'" />
    </div>
             
    <!--分配人-->
        <label class="col-md-2 form-label text-right p-0" for="@Html.IdFor(model => model.Assigner)" >@Html.DisplayNameFor(model => model.Assigner) </label>
<div class="col-md-4 mb-1">
		<input id="@Html.IdFor(model => model.Assigner)" 
							name="@Html.NameFor(model => model.Assigner)" 
							value="@Html.ValueFor(model => model.Assigner)"
							tabindex="4" 
			     			class="easyui-textbox" 
							type="text" 
                            style="width:100%"
							data-options="prompt:'@Html.DisplayNameFor(model => model.Assigner)',
     						 required:false ,validType:'length[0,20]'" />
    </div>
             
     <!--分配时间-->
          <label class="col-md-2 form-label text-right p-0" for="@Html.IdFor(model => model.AssignDate)" >@Html.DisplayNameFor(model => model.AssignDate) </label>
		  <div class="col-md-4 mb-1">
          <input id="@Html.IdFor(model => model.AssignDate)" 
							name="@Html.NameFor(model => model.AssignDate)" 
							tabindex="5" 
							class="easyui-datebox" 
                            type="text"
                            style="width:100%"
							value="@Html.ValueFor(model => model.AssignDate)"
							data-options="prompt:'@Html.DisplayNameFor(model => model.AssignDate)',
								 formatter:dateformatter,
                                 required:false " />
     </div>
             
    <!--终止理由-->
        <label class="col-md-2 form-label text-right p-0" for="@Html.IdFor(model => model.StopCase)" >@Html.DisplayNameFor(model => model.StopCase) </label>
<div class="col-md-4 mb-1">
		<input id="@Html.IdFor(model => model.StopCase)" 
							name="@Html.NameFor(model => model.StopCase)" 
							value="@Html.ValueFor(model => model.StopCase)"
							tabindex="6" 
			     			class="easyui-textbox" 
							type="text" 
                            style="width:100%"
							data-options="prompt:'@Html.DisplayNameFor(model => model.StopCase)',
     						 required:false ,validType:'length[0,256]'" />
    </div>
             
    <!--备注-->
        <label class="col-md-2 form-label text-right p-0" for="@Html.IdFor(model => model.Remark)" >@Html.DisplayNameFor(model => model.Remark) </label>
<div class="col-md-4 mb-1">
		<input id="@Html.IdFor(model => model.Remark)" 
							name="@Html.NameFor(model => model.Remark)" 
							value="@Html.ValueFor(model => model.Remark)"
							tabindex="7" 
			     			class="easyui-textbox" 
							type="text" 
                            style="width:100%"
							data-options="prompt:'@Html.DisplayNameFor(model => model.Remark)',
     						 required:false ,validType:'length[0,256]'" />
    </div>
             
      <!--所属客户-->
      <input type="hidden" id="CustomerCustomerCode" name="CustomerCustomerCode" value="">
	  <input id="@Html.IdFor(model => model.CustomerId)"
			       name="@Html.NameFor(model => model.CustomerId)"
				   value="@Html.ValueFor(model => model.CustomerId)"
                   type="hidden" />
             
    <!--客户编号-->
        <label class="col-md-2 form-label text-right p-0" for="@Html.IdFor(model => model.CustomerCode)" >@Html.DisplayNameFor(model => model.CustomerCode) <span class="text-danger">*</span></label>
<div class="col-md-4 mb-1">
		<input id="@Html.IdFor(model => model.CustomerCode)" 
							name="@Html.NameFor(model => model.CustomerCode)" 
							value="@Html.ValueFor(model => model.CustomerCode)"
							tabindex="9" 
			     			class="easyui-textbox" 
							type="text" 
                            style="width:100%"
							data-options="prompt:'@Html.DisplayNameFor(model => model.CustomerCode)',
     						 required:true ,validType:'length[0,20]'" />
    </div>
             
    <!--客户名称-->
        <label class="col-md-2 form-label text-right p-0" for="@Html.IdFor(model => model.CustomerName)" >@Html.DisplayNameFor(model => model.CustomerName) <span class="text-danger">*</span></label>
<div class="col-md-4 mb-1">
		<input id="@Html.IdFor(model => model.CustomerName)" 
							name="@Html.NameFor(model => model.CustomerName)" 
							value="@Html.ValueFor(model => model.CustomerName)"
							tabindex="10" 
			     			class="easyui-textbox" 
							type="text" 
                            style="width:100%"
							data-options="prompt:'@Html.DisplayNameFor(model => model.CustomerName)',
     						 required:true ,validType:'length[0,80]'" />
    </div>
             
  
           </div>
       </fieldset>
    </form>
  </div>
</div>
</div>
<script type="text/javascript">
     var form_state = 'Added';
     var current_index = -1;
     var customersales = {};
 
     function open_customersalesdlg(index, row, state) {
         form_state = state;
         current_index = index;
         customersales = row;
         $('#customersalesdlg').dialog('open');
         if (form_state === 'Added') {
             $('#customersalesdlg').dialog('setTitle', '新增明细');
         } else {
             $('#customersalesdlg').dialog('setTitle', '修改明细');
         }
         $('#customersales_form').form('reset');
         $('#customersales_form').form('load', customersales);
     }
     function confirm_customersalesform() {
         $customersalesform = $('#customersales_form');
         if ($customersalesform.form('enableValidation').form('validate')) {
             customersales = $customersalesform.serializeJSON();
             if (form_state === 'Added') {
                 $(document).trigger('customersales_form.add', [current_index, customersales])
             } else {
                 $(document).trigger('customersales_form.edit', [current_index, customersales])
             }
             $('#customersalesdlg').dialog('close');
         }
     }
 </script>

 