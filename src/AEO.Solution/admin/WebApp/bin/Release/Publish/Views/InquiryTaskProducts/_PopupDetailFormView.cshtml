<!-- 弹出编辑对话框 -->

<!--begin popup detailview javascript block -->
<script type="text/javascript">
 //当初始的 HTML 文档被完全加载和解析完成之后
 document.addEventListener('DOMContentLoaded', function () {
     //绑定按钮事件
    $('button[name="saveitembutton"]').on('click', saveinquirytaskproductitem);
    $('button[name="deleteitembutton"]').on('click', deleteinquirytaskproductitem);
  });
    //判断新增编辑状态
    var MODELSTATE = 'Added';
    var inquirytaskproductid = null;
    function openinquirytaskproductdetailwindow(data,state) {
         MODELSTATE = state;
         //判断是否显示功能按钮
        if (MODELSTATE === 'Added') {
          $('#deleteitem-btn-group').hide();
        } else {
          $('#deleteitem-btn-group').show();
        }
        initinquirytaskproductdetailview();
         inquirytaskproductid = (data.Id || 0);
         $('#inquirytaskproductdetailwindow').window('open');
         $('#inquirytaskproduct_form').form('reset');
         $('#inquirytaskproduct_form').form('load', data);
             }
  //删除当前记录
  function deleteinquirytaskproductitem() {
    $.messager.confirm('确认', '你确定要删除该记录?', result => {
      if (result) {
        const url = `/InquiryTaskProducts/Delete/${inquirytaskproductid}`;
        $.get(url).done(res => {
          if (res.success) {
            toastr.success("删除成功");
            $('#inquirytaskproductdetailwindow').window('close');
            reloadData();
          } else {
            $.messager.alert('错误', res.err, 'error');
          }
        });
      }
    });
  }
    //async 保存数据
    async function saveinquirytaskproductitem() { 
      const $inquirytaskproductform = $('#inquirytaskproduct_form');
      if ($inquirytaskproductform.form('enableValidation').form('validate')) {
            let inquirytaskproduct = $inquirytaskproductform.serializeJSON();
            let url = '/InquiryTaskProducts/Edit';
            //判断是新增或是修改方法
            if (MODELSTATE === 'Added') {
                url = '/InquiryTaskProducts/Create';
            }
            var token = $('input[name="__RequestVerificationToken"]', $inquirytaskproductform).val();
            $.ajax({
                    type: "POST",
                    url: url,
                    data: {
                        __RequestVerificationToken: token,
                        inquirytaskproduct:inquirytaskproduct
                    },
                    dataType: 'json',
                    contentType: 'application/x-www-form-urlencoded; charset=utf-8'
                })
                .done(response => {
                    if (response.success) {
                        hook = false;
                        $inquirytaskproductform.form('disableValidation');
                        $('#inquirytaskproductdetailwindow').window("close");
                        toastr.success("保存成功"); 
                        reloadData();
                    } else {
                        $.messager.alert("错误",   response.err, "error");
                    }
                    })
                .fail((jqXHR, textStatus, errorThrown) => {
                       $.messager.alert('异常', `${jqXHR.status}: ${jqXHR.statusText} `, 'error');
                    });
        }
    }
     //判断是否有没有保存的记录
     function inquirytaskproducthasmodified() {
            return hook;

     }


function initinquirytaskproductdetailview() {
//回车光标移动到下个输入控件
    //如果是枚举类型需要把numberbox改成combobox
    //询价数量
	$('#Qty').numberbox('textbox').bind('keydown', function (e) {
      if (e.keyCode == 13) {
        $(e.target).emulateTab();
      }
    });
    //如果是枚举类型需要把numberbox改成combobox
    //报价金额
	$('#Price').numberbox('textbox').bind('keydown', function (e) {
      if (e.keyCode == 13) {
        $(e.target).emulateTab();
      }
    });
    //询价任务默认外键使用combobox,也可以使用combogrid
	$('#InquiryTaskId').combobox('textbox').bind('keydown', function (e) {
      if (e.keyCode == 13) {
        $(e.target).emulateTab();
      }
    });
}
</script>

