@model WebApp.Models.CustomerFollow
<script type="text/javascript">
  //全屏事件
  document.addEventListener('panel.onfullscreen', () => {
       $customerfollowdg.datagrid('resize');
   });
    //是否开启行内编辑
    var SUBEDITINLINE = true;
   //初始化 CustomerFollow datagrid
   var $customerfollowdg = $('#customerfollow_datagrid');
   //当前行记录
   var customerfollow = {};
   //datagrid CRUD method
    var customerfollow_editIndex = undefined;
    //取消编辑恢复状态
    function customerfollow_rejectChanges() {
		$customerfollowdg.datagrid('rejectChanges');
		customerfollow_editIndex = undefined;
    }
    //重新加载数据
    function customerfollow_reloadData() {
			$customerfollowdg.datagrid('unselectAll');
            $customerfollowdg.datagrid('uncheckAll');
	        $customerfollowdg.datagrid('reload');
	}
    //关闭编辑状态
	function customerfollow_endEditing() {
			if (customerfollow_editIndex === undefined) {
                return true; 
            }
			if ($customerfollowdg.datagrid('validateRow', customerfollow_editIndex)) {
				$customerfollowdg.datagrid('endEdit', customerfollow_editIndex);
				customerfollow_editIndex = undefined;
                return true;
			} else {
				const invalidinput = $('input.validatebox-invalid',$customerfollowdg.datagrid('getPanel'));
                const fieldnames = invalidinput.map((index, item) => {
                  return $(item).attr('placeholder') || $(item).attr('id');
                });
                $.messager.alert('提示', `${Array.from(fieldnames)} 输入有误.`, 'error');
				return false;
			}
		}
    //单击列开启编辑功能
	function customerfollow_onClickCell(index, field) {
			const _operates = ['_operate1', 'ck'];
             $('button[name*=\'customerfollowdeleterowbutton\']').prop('disabled', false);
			if (!SUBEDITINLINE || $.inArray(field, _operates) >= 0) {
				return false;
			}
			if (customerfollow_editIndex !== index) {
				if (customerfollow_endEditing()) {
					$customerfollowdg.datagrid('selectRow', index)
							.datagrid('beginEdit', index);
                    //customerfollow_editIndex = index;
					var ed = $customerfollowdg.datagrid('getEditor', { index: index, field: field });
					if (ed) {
						($(ed.target).data('textbox') ? $(ed.target).textbox('textbox') : $(ed.target)).focus();
					}
				} else {
					$customerfollowdg.datagrid('selectRow', customerfollow_editIndex);
				}
			}
		}
    //双击弹出编辑当前行对话框
    function customerfollow_onDblClickRow(index, row) {
        if (!SUBEDITINLINE) {
            open_customerfollowdlg(index, row, 'Modified');
        }
    }
    //订阅对话框新增返回事件
    $(document).on('customerfollow_form.add', (e, index,item) => {
        $customerfollowdg.datagrid("insertRow",
            {
                index: 0,
                row: item
            });
    });
    //订阅对话框修改返回事件
    $(document).on('customerfollow_form.edit', (e,index, item) => {
        $customerfollowdg.datagrid('updateRow', {
            index: index,
            row: item
        });
    });
    //新增记录
  function customerfollow_appendItem() {
    const $customerform = $('#customer_form');
    if ($customerform.form('enableValidation').form('validate')) {
      const customer = $customerform.serializeJSON();
      const item = {
        ContactName:null,
        Owner:$.getusername(),
        FollowDate: moment().format('YYYY-MM-DD HH:mm:ss'),
        CustomerId: customer.Id,
        CustomerCode: customer.CustomerCode,
        CustomerName: customer.CustomerName,

        CustomerId: customer.Id
      };

      open_customerfollowdlg(0, item, 'Added');

    }
  }
    //删除编辑的行
	function customerfollow_removeItem() {
    customerfollow_deleteChecked()
	}
    //删除选中的行
    function customerfollow_deleteChecked() {
            const rows = $customerfollowdg.datagrid('getChecked');
            if (rows.length > 0) {
                var id = rows.filter(item=>item.Id!=null).map(item => {
                    return item.Id;
                });
                $.messager.confirm('确认', `你确定要删除这 <span class='badge bg-color-red'>${id.length}</span> 行记录?`,result => {
                    if (result) {
                        $.post('/CustomerFollows/DeleteChecked', { id: id })
                         .done(response => {
                            if (response.success) {
                                $customerfollowdg.datagrid('reload');
                            } else {
                                $.messager.alert('错误', response.err,'error');
                            }
                         });
                    }
                });  
            } else {
                $.messager.alert('提示', '请先选择要删除的记录!','question');
            }
      }
  //获取修改的行
  function customerfollow_getChanges() {
    if (customerfollow_endEditing()) {
      if ($customerfollowdg.datagrid('getChanges').length > 0) {
        const inserted = $customerfollowdg.datagrid('getChanges', 'inserted').map(item => {
          item.TrackingState = 1;
          return item;
        });
        const deleted = $customerfollowdg.datagrid('getChanges', 'deleted').map(item => {
          item.TrackingState = 3;
          return item;
        });
        const updated = $customerfollowdg.datagrid('getChanges', 'updated').map(item => {
          item.TrackingState = 2;
          return item;
        });
        //过滤已删除的重复项
        const changed = inserted.concat(updated.filter(item => {
          return !deleted.includes(item);
        })).concat(deleted);
        return { success: true, changed };
      } else {
        return { success: true, changed:undefined};
      }
    } else {
      return { success: false,changed:undefined };
    }
  }
  //提交修改的数据
  //function customerfollow_acceptChanges() {
  //  $customerfollowdg.datagrid('acceptChanges');
  //}
  //提交保存后台数据库
  async function customerfollow_acceptChanges() {
			if (customerfollow_endEditing()) {
				if ($customerfollowdg.datagrid('getChanges').length > 0) {
					const inserted = $customerfollowdg.datagrid('getChanges', 'inserted').map(item => {
                       item.TrackingState = 1;
                       return item;
                    });
					const deleted = $customerfollowdg.datagrid('getChanges', 'deleted').map(item => {
                       item.TrackingState = 3;
                       return item;
                    });
					const updated = $customerfollowdg.datagrid('getChanges', 'updated').map(item => {
                       item.TrackingState = 2;
                       return item;
                    });
					//过滤已删除的重复项
                    const changed = inserted.concat(updated.filter(item => {
                           return !deleted.includes(item);
                         })).concat(deleted);
                   //console.table(changed);
				  if (MODELSTATE === 'Added') {
                    return { success:true, changed };
                  } else {
                    const response = await $.post('/CustomerFollows/SaveData', {customerfollows:changed});
                    response.changed = undefined;
    				if (response.success) {
							toastr.success('保存明细成功'); 
							$customerfollowdg.datagrid('acceptChanges');
							customerfollow_reloadData()
                            return { success:true}; 
				    } else {
                           $.messager.alert('错误', response.err ,'error');
                           return { success:false, err:response.err };
                    }
                   }
				} else {
                  return { success: true, changed: undefined};
                }
			} else {
               return { success: false };
            }
      }


  $(() => {
    $customerfollowdg.datagrid({
      fit: false,
      height: 300,
      rownumbers: true,
      striped: true,
      idField: 'Id',
      sortName: 'Id',
      sortOrder: 'asc',
      remoteFilter: true,
      singleSelect: true,
      checkOnSelect: false,
      selectOnCheck: false,
      method: 'get',
      pageList: [10, 20, 50, 100, 1000],
      pagination: true,
      clientPaging: false,
      pagination: true,
      onBeforeLoad: function () {

      },
      onLoadSuccess: function (data) {
        customerfollow_editIndex = undefined;
        $("button[name*='customerfollow_deleterowbutton']").prop('disabled', true);
        $("button[name*='customerfollow_cancelchangesbutton']").prop('disabled', true);
        $("button[name*='customerfollow_savechangesbutton']").prop('disabled', true);
      },
      onCheck: function () {
        $("button[name*='customerfollow_deleterowbutton']").prop('disabled', false);
      },
      onUncheck: function () {
        const checked = $(this).datagrid('getChecked').length > 0;
        $("button[name*='customerfollow_deleterowbutton']").prop('disabled', !checked);
      },
      onCheckAll: function (rows) {
        if (rows.length > 0) {
          $("button[name*='customerfollow_deleterowbutton']").prop('disabled', false);
        }
      },
      onUncheckAll: function () {
        $("button[name*='customerfollow_deleterowbutton']").prop('disabled', true);
      },
      onSelect: function (index, row) {
        customerfollow = row;
      },
      onBeforeEdit: function (index, row) {
        customerfollow_editIndex = index;
        row.editing = true;
        $("button[name*='customerfollow_deleterowbutton']").prop('disabled', false);
        $("button[name*='customerfollow_cancelchangesbutton']").prop('disabled', false);
        $("button[name*='customerfollow_savechangesbutton']").prop('disabled', false);
        $(this).datagrid('refreshRow', index);
      },
      onBeginEdit: function (index, row) {
        //const editors = $(this).datagrid('getEditors', index);

      },
      onEndEdit: function (index, row) {

      },
      onAfterEdit: function (index, row) {
        row.editing = false;
        customerfollow_editIndex = undefined;
        $(this).datagrid('refreshRow', index);
      },
      onCancelEdit: function (index, row) {
        customerfollow_editIndex = undefined;
        row.editing = false;
        $("button[name*='customerfollow_deleterowbutton']").prop('disabled', true);
        $("button[name*='customerfollow_cancelchangesbutton']").prop('disabled', true);
        $("button[name*='customerfollow_savechangesbutton']").prop('disabled', true);
        $(this).datagrid('refreshRow', index);
      },
      columns: [[
        { field: 'ck', checkbox: true },

        {    /*客户联系人*/
          field: 'ContactName',
          title: '<span class="text-danger">*</span>  @Html.DisplayNameFor(model => model.ContactName)',
          width: 160,
          editor: {
            type: 'textbox',
            options: {
              id: 'editor_ContactName',
              prompt: '@Html.DescriptionFor(model => model.ContactName)',
              required: true,
              validType: 'length[0,80]'
            }
          },
          sortable: true,
          hidden: false,
          resizable: true
        },
        {    /*跟进方式*/
          field: 'FollowType',
          title: '  @Html.DisplayNameFor(model => model.FollowType)',
          width: 120,
          editor: {
            type: 'textbox',
            options: {
              id: 'editor_FollowType',
              prompt: '@Html.DescriptionFor(model => model.FollowType)',
              required: false,
              validType: 'length[0,20]'
            }
          },
          sortable: true,
          hidden: false,
          resizable: true
        },
        {    /*跟进状态*/
          field: 'Status',
          title: '  @Html.DisplayNameFor(model => model.Status)',
          width: 100,
          align: 'right',
          hidden: false,
          editor: {
            /*需要在键值对中维护status枚举值并生成JavaScript才能使用*/
            type: 'statuseditor',
            options: {
              id: 'editor_Status',
              prompt: '@Html.DescriptionFor(model => model.Status)',
              required: false
            }
          },
          formatter: statusformatter
        },
        {    /*跟进人*/
          field: 'Owner',
          title: '  @Html.DisplayNameFor(model => model.Owner)',
          width: 120,
          editor: {
            type: 'textbox',
            options: {
              id: 'editor_Owner',
              prompt: '@Html.DescriptionFor(model => model.Owner)',
              required: false,
              validType: 'length[0,20]'
            }
          },
          sortable: true,
          hidden: false,
          resizable: true
        },
        {   /*跟进时间*/
          field: 'FollowDate',
          title: '<span class="text-danger">*</span>  @Html.DisplayNameFor(model => model.FollowDate)',
          width: 100,
          align: 'right',
          hidden: false,
          editor: {
            type: 'datebox',
            options: {
              id: 'editor_FollowDate',
              prompt: '@Html.DescriptionFor(model => model.FollowDate)',
              required: true
            }
          },
          sortable: true,
          resizable: true,
          formatter: dateformatter
        },
        {    /*跟进内容*/
          field: 'Content',
          title: '  @Html.DisplayNameFor(model => model.Content)',
          width: 200,
          editor: {
            type: 'textbox',
            options: {
              id: 'editor_Content',
              prompt: '@Html.DescriptionFor(model => model.Content)',
              required: false,
              validType: 'length[0,512]'
            }
          },
          sortable: true,
          hidden: false,
          resizable: true
        }
       
      ]]
    })
      .datagrid('enableFilter', [
        /*需要在键值队维护好status枚举值*/
        {    /*跟进状态*/
          field: 'Status',
          type: 'statusfilter',
          options: {

          }
        },
        {     /*跟进时间*/
          field: 'FollowDate',
          type: 'dateRange',
          options: {
          }
        },
        {     /*设置提醒时间*/
          field: 'ReminderTime',
          type: 'dateRange',
          options: {
          }
        },
      ]);
  });
      
</script>


 