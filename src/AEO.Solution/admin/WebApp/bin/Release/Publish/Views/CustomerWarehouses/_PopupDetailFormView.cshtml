<!-- 弹出窗体form表单 -->
<!-- 弹出编辑对话框 -->

<!--begin popup detailview javascript block -->
<script type="text/javascript">
 //当初始的 HTML 文档被完全加载和解析完成之后
 document.addEventListener('DOMContentLoaded', function () {
     //绑定按钮事件
    $('button[name="saveitembutton"]').on('click', savecustomerwarehouseitem);
    $('button[name="deleteitembutton"]').on('click', deletecustomerwarehouseitem);
  });
    //判断新增编辑状态
    var MODELSTATE = 'Added';
    var customerwarehouseid = null;
    function opencustomerwarehousedetailwindow(data,state) {
         MODELSTATE = state;
         //判断是否显示功能按钮
        if (MODELSTATE === 'Added') {
          $('#deleteitem-btn-group').hide();
        } else {
          $('#deleteitem-btn-group').show();
        }
        initcustomerwarehousedetailview();
         customerwarehouseid = (data.Id || 0);
         $('#customerwarehousedetailwindow').window('open');
         $('#customerwarehouse_form').form('reset');
         $('#customerwarehouse_form').form('load', data);
             }
  //删除当前记录
  function deletecustomerwarehouseitem() {
    $.messager.confirm('确认', '你确定要删除该记录?', result => {
      if (result) {
        const url = `/CustomerWarehouses/Delete/${customerwarehouseid}`;
        $.get(url).done(res => {
          if (res.success) {
            toastr.success("删除成功");
            $('#customerwarehousedetailwindow').window('close');
            reloadData();
          } else {
            $.messager.alert('错误', res.err, 'error');
          }
        });
      }
    });
  }
    //async 保存数据
    async function savecustomerwarehouseitem() { 
      const $customerwarehouseform = $('#customerwarehouse_form');
      if ($customerwarehouseform.form('enableValidation').form('validate')) {
            let customerwarehouse = $customerwarehouseform.serializeJSON();
            let url = '/CustomerWarehouses/Edit';
            //判断是新增或是修改方法
            if (MODELSTATE === 'Added') {
                url = '/CustomerWarehouses/Create';
            }
            var token = $('input[name="__RequestVerificationToken"]', $customerwarehouseform).val();
            $.ajax({
                    type: "POST",
                    url: url,
                    data: {
                        __RequestVerificationToken: token,
                        customerwarehouse:customerwarehouse
                    },
                    dataType: 'json',
                    contentType: 'application/x-www-form-urlencoded; charset=utf-8'
                })
                .done(response => {
                    if (response.success) {
                        hook = false;
                        $customerwarehouseform.form('disableValidation');
                        $('#customerwarehousedetailwindow').window("close");
                        toastr.success("保存成功"); 
                        reloadData();
                    } else {
                        $.messager.alert("错误",   response.err, "error");
                    }
                    })
                .fail((jqXHR, textStatus, errorThrown) => {
                       $.messager.alert('异常', `${jqXHR.status}: ${jqXHR.statusText} `, 'error');
                    });
        }
    }
     //判断是否有没有保存的记录
     function customerwarehousehasmodified() {
            return hook;

     }


function initcustomerwarehousedetailview() {
//回车光标移动到下个输入控件
    //所属客户默认外键使用combobox,也可以使用combogrid
	$('#CustomerId').combobox('textbox').bind('keydown', function (e) {
      if (e.keyCode == 13) {
        $(e.target).emulateTab();
      }
    });
}
</script>

