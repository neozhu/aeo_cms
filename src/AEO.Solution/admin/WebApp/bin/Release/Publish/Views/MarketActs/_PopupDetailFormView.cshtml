﻿@model WebApp.Models.MarketAct
<!-- 弹出编辑窗体表单 -->
<div id="marketactdetailwindow" class="easyui-window"
     title="编辑市场活动"
     data-options="modal:true,
                    closed:true,
                    minimizable:false,
                    collapsible:false,
                    maximized:false,
                    iconCls:'fal fa-window',
                    onBeforeClose:function(){
                      var that = $(this);
                      if(marketacthasmodified()){
                        $.messager.confirm('确认','你确定要放弃保存修改的记录?',function(r){
                        if (r){
                          var opts = that.panel('options');
                          var onBeforeClose = opts.onBeforeClose;
                          opts.onBeforeClose = function(){};
                          that.panel('close');
                          opts.onBeforeClose = onBeforeClose;
                          hook = false;
                        }
                        });
                        return false;
                      }
                    },
                    onOpen:function(){
                       $(this).window('vcenter');
                       $(this).window('hcenter');
                    },
                    onRestore:function(){
                    },
                    onMaximize:function(){
                    }
                    " style="width:720px;height:550px;display:none">
  <!-- toolbar -->
  <div class="panel-content py-2 rounded-bottom border-faded border-left-0 border-right-0  text-muted bg-subtlelight-fade sticky-top">
    <div class="d-flex justify-content-end pr-4">
      <div class="btn-group btn-group-sm mr-1">
        <button name="saveitembutton" class="btn btn-default">
          <i class="fal fa-save"></i> @Html.L("Save")
        </button>
      </div>
      <div class="btn-group btn-group-sm mr-1" id="deleteitem-btn-group">
        <button name="deleteitembutton" class="btn btn-danger">
          <i class="fal fa-trash-alt"></i> @Html.L("Delete")
        </button>
      </div>
    </div>
  </div>
  <!-- panel container form  -->
  <div class="panel-container show">
    <div class="container">
      <div class="panel-content">
        <form id="marketact_form"
              class="easyui-form form-horizontal padding-10"
              method="post"
              data-options="novalidate:true,
                            onChange: function(target){
                              hook = true;
                              $('button[name*=\'saveitembutton\']').prop('disabled', false);
                             },
                             onLoadSuccess:function(data){
                               hook = false;
                               $('button[name*=\'saveitembutton\']').prop('disabled', true);
                             }">
          @Html.AntiForgeryToken()
          <!--Primary Key-->
          @Html.HiddenFor(model => model.Id)
          <fieldset class="form-group">
            <div class="row h-100 align-items-center">

              <!--市场活动名称-->
              <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"><span class="text-danger">*</span> @Html.DisplayNameFor(model => model.Name)</label>
              <div class="col-md-4 mb-1 pl-1">
                <input id="@Html.IdFor(model => model.Name)"
                       name="@Html.NameFor(model => model.Name)"
                       value="@Html.ValueFor(model => model.Name)"
                       tabindex="0" required
                       class="easyui-textbox"
                       style="width:100%"
                       type="text"
                       data-options="prompt:'@Html.DescriptionFor(model => model.Name)',
								 required:true,
                                 validType: 'length[0,128]'
                                 " />
              </div>

              <!--负责人-->
              <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"><span class="text-danger">*</span> @Html.DisplayNameFor(model => model.Owner)</label>
              <div class="col-md-4 mb-1 pl-1">
                <input id="@Html.IdFor(model => model.Owner)"
                       name="@Html.NameFor(model => model.Owner)"
                       value="@Html.ValueFor(model => model.Owner)"
                       tabindex="1" required
                       class="easyui-textbox"
                       style="width:100%"
                       type="text"
                       data-options="prompt:'@Html.DescriptionFor(model => model.Owner)',
								 required:true,
                                 validType: 'length[0,20]'
                                 " />
              </div>


              <!--活动状态-->
              <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"><span class="text-danger">*</span> @Html.DisplayNameFor(model => model.Status)</label>
              <div class="col-md-4 mb-1 pl-1">
                <input id="@Html.IdFor(model => model.Status)"
                       name="@Html.NameFor(model => model.Status)"
                       value="@Html.ValueFor(model => model.Status)"
                       tabindex="2" required
                       class="easyui-combobox"
                       style="width:100%"
                       type="text"
                       data-options="prompt:'@Html.DescriptionFor(model => model.Status)',
								 required:true,panelHeight:'auto',data:actstatusdatasource,
                                 validType: 'length[0,20]'
                                 " />
              </div>

              <!--活动类型-->
              <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"><span class="text-danger">*</span> @Html.DisplayNameFor(model => model.ActType)</label>
              <div class="col-md-4 mb-1 pl-1">
                <input id="@Html.IdFor(model => model.ActType)"
                       name="@Html.NameFor(model => model.ActType)"
                       value="@Html.ValueFor(model => model.ActType)"
                       tabindex="3" required
                       class="easyui-combobox"
                       style="width:100%"
                       type="text"
                       data-options="prompt:'@Html.DescriptionFor(model => model.ActType)',
								 required:true,panelHeight:'auto',data:acttypedatasource,
                                 validType: 'length[0,56]'
                                 " />
              </div>


              <!--计划开始日期-->
              <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"> @Html.DisplayNameFor(model => model.PlanStartDate)</label>
              <div class="col-md-4 mb-1 pl-1">
                <input id="@Html.IdFor(model => model.PlanStartDate)"
                       name="@Html.NameFor(model => model.PlanStartDate)"
                       value="@Html.ValueFor(model => model.PlanStartDate)"
                       tabindex="4"
                       class="easyui-datebox"
                       style="width:100%"
                       type="text"
                       data-options="prompt:'@Html.DescriptionFor(model => model.PlanStartDate)',
								 required:false,
								 formatter:dateformatter" />
              </div>

              <!--计划完成日期-->
              <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"> @Html.DisplayNameFor(model => model.PlanFinishDate)</label>
              <div class="col-md-4 mb-1 pl-1">
                <input id="@Html.IdFor(model => model.PlanFinishDate)"
                       name="@Html.NameFor(model => model.PlanFinishDate)"
                       value="@Html.ValueFor(model => model.PlanFinishDate)"
                       tabindex="5"
                       class="easyui-datebox"
                       style="width:100%"
                       type="text"
                       data-options="prompt:'@Html.DescriptionFor(model => model.PlanFinishDate)',
								 required:false,
								 formatter:dateformatter" />
              </div>


              <!--费用预算-->
              <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"> @Html.DisplayNameFor(model => model.BudgetExpense)</label>
              <div class="col-md-4 mb-1 pl-1">
                <input id="@Html.IdFor(model => model.BudgetExpense)"
                       name="@Html.NameFor(model => model.BudgetExpense)"
                       value="@Html.ValueFor(model => model.BudgetExpense)"
                       tabindex="6"
                       class="easyui-numberbox"
                       style="width:100%"
                       type="text"
                       data-options="prompt:'@Html.DescriptionFor(model => model.BudgetExpense)',
								 required:false,formatter:numberformatter,
                                 parser:parsernumber,precision:2,

                                 " />

              </div>

              <!--币种-->
              <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"> @Html.DisplayNameFor(model => model.Cur)</label>
              <div class="col-md-4 mb-1 pl-1">
                <input id="@Html.IdFor(model => model.Cur)"
                       name="@Html.NameFor(model => model.Cur)"
                       value="@Html.ValueFor(model => model.Cur)"
                       tabindex="7"
                       class="easyui-textbox"
                       style="width:100%"
                       type="text"
                       data-options="prompt:'@Html.DescriptionFor(model => model.Cur)',
								 required:false,
                                 validType: 'length[0,56]'
                                 " />
              </div>


              <!--活动地点-->
              <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"> @Html.DisplayNameFor(model => model.Address)</label>
              <div class="col-md-10 mb-1 pl-1">
                <input id="@Html.IdFor(model => model.Address)"
                       name="@Html.NameFor(model => model.Address)"
                       value="@Html.ValueFor(model => model.Address)"
                       tabindex="8"
                       class="easyui-textbox"
                       style="width:100%"
                       type="text"
                       data-options="prompt:'@Html.DescriptionFor(model => model.Address)',
								 required:false,
                                 validType: 'length[0,128]'
                                 " />
              </div>

              <!--活动计划-->
              <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"> @Html.DisplayNameFor(model => model.PlanDesc)</label>
              <div class="col-md-10 mb-1 pl-1">
                <input id="@Html.IdFor(model => model.PlanDesc)"
                       name="@Html.NameFor(model => model.PlanDesc)"
                       value="@Html.ValueFor(model => model.PlanDesc)"
                       tabindex="9"
                       class="easyui-textbox"
                       style="width:100%"
                       type="text"
                       data-options="prompt:'@Html.DescriptionFor(model => model.PlanDesc)',
								 required:false,multiline:true,
                                 validType: 'length[0,512]'
                                 " />
              </div>


              <!--实际开始日期-->
              <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"> @Html.DisplayNameFor(model => model.ActualStartDate)</label>
              <div class="col-md-4 mb-1 pl-1">
                <input id="@Html.IdFor(model => model.ActualStartDate)"
                       name="@Html.NameFor(model => model.ActualStartDate)"
                       value="@Html.ValueFor(model => model.ActualStartDate)"
                       tabindex="10"
                       class="easyui-datebox"
                       style="width:100%"
                       type="text"
                       data-options="prompt:'@Html.DescriptionFor(model => model.ActualStartDate)',
								 required:false,
								 formatter:dateformatter" />
              </div>

              <!--实际完成日期-->
              <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"> @Html.DisplayNameFor(model => model.ActualFinishDate)</label>
              <div class="col-md-4 mb-1 pl-1">
                <input id="@Html.IdFor(model => model.ActualFinishDate)"
                       name="@Html.NameFor(model => model.ActualFinishDate)"
                       value="@Html.ValueFor(model => model.ActualFinishDate)"
                       tabindex="11"
                       class="easyui-datebox"
                       style="width:100%"
                       type="text"
                       data-options="prompt:'@Html.DescriptionFor(model => model.ActualFinishDate)',
								 required:false,
								 formatter:dateformatter" />
              </div>


              <!--实际投入-->
              <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"> @Html.DisplayNameFor(model => model.ActExpense)</label>
              <div class="col-md-4 mb-1 pl-1">
                <input id="@Html.IdFor(model => model.ActExpense)"
                       name="@Html.NameFor(model => model.ActExpense)"
                       value="@Html.ValueFor(model => model.ActExpense)"
                       tabindex="12"
                       class="easyui-numberbox"
                       style="width:100%"
                       type="text"
                       data-options="prompt:'@Html.DescriptionFor(model => model.ActExpense)',
								 required:false,formatter:numberformatter,
                                 parser:parsernumber,precision:2,

                                 " />

              </div>

              <!--预计收入-->
              <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"> @Html.DisplayNameFor(model => model.Income)</label>
              <div class="col-md-4 mb-1 pl-1">
                <input id="@Html.IdFor(model => model.Income)"
                       name="@Html.NameFor(model => model.Income)"
                       value="@Html.ValueFor(model => model.Income)"
                       tabindex="13"
                       class="easyui-numberbox"
                       style="width:100%"
                       type="text"
                       data-options="prompt:'@Html.DescriptionFor(model => model.Income)',
								 required:false,formatter:numberformatter,
                                 parser:parsernumber,precision:2,

                                 " />

              </div>


              <!--执行情况-->
              <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"> @Html.DisplayNameFor(model => model.ExecDesc)</label>
              <div class="col-md-10 mb-1 pl-1">
                <input id="@Html.IdFor(model => model.ExecDesc)"
                       name="@Html.NameFor(model => model.ExecDesc)"
                       value="@Html.ValueFor(model => model.ExecDesc)"
                       tabindex="14"
                       class="easyui-textbox"
                       style="width:100%"
                       type="text"
                       data-options="prompt:'@Html.DescriptionFor(model => model.ExecDesc)',
								 required:false,multiline:true,
                                 validType: 'length[0,512]'
                                 " />
              </div>

              <!--活动总结-->
              <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"> @Html.DisplayNameFor(model => model.SumaryDesc)</label>
              <div class="col-md-10 mb-1 pl-1">
                <input id="@Html.IdFor(model => model.SumaryDesc)"
                       name="@Html.NameFor(model => model.SumaryDesc)"
                       value="@Html.ValueFor(model => model.SumaryDesc)"
                       tabindex="15"
                       class="easyui-textbox"
                       style="width:100%"
                       type="text"
                       data-options="prompt:'@Html.DescriptionFor(model => model.SumaryDesc)',
								 required:false,multiline:true,
                                 validType: 'length[0,512]'
                                 " />
              </div>


              <!--评估效果-->
              <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"> @Html.DisplayNameFor(model => model.EffectDesc)</label>
              <div class="col-md-10 mb-1 pl-1">
                <input id="@Html.IdFor(model => model.EffectDesc)"
                       name="@Html.NameFor(model => model.EffectDesc)"
                       value="@Html.ValueFor(model => model.EffectDesc)"
                       tabindex="16"
                       class="easyui-textbox"
                       style="width:100%"
                       type="text"
                       data-options="prompt:'@Html.DescriptionFor(model => model.EffectDesc)',
								 required:false,multiline:true,
                                 validType: 'length[0,512]'
                                 " />
              </div>

            </div>
          </fieldset>
        </form>
      </div>
    </div>
  </div>
</div>

<!-- 弹出窗体form表单 -->
<!-- 弹出编辑对话框 -->
<!--begin popup detailview javascript block -->
<script type="text/javascript">
  //当初始的 HTML 文档被完全加载和解析完成之后
  document.addEventListener('DOMContentLoaded', function () {
    //绑定按钮事件
    $('button[name="saveitembutton"]').on('click', savemarketactitem);
    $('button[name="deleteitembutton"]').on('click', deletemarketactitem);
  });
  //判断新增编辑状态
  var MODELSTATE = 'Added';
  var marketactid = null;
  function openmarketactdetailwindow(data, state) {
    MODELSTATE = state;
    //判断是否显示功能按钮
    if (MODELSTATE === 'Added') {
      $('#deleteitem-btn-group').hide();
    } else {
      $('#deleteitem-btn-group').show();
    }
    initmarketactdetailview();
    marketactid = (data.Id || 0);
    $('#marketactdetailwindow').window('open');
    $('#marketact_form').form('reset');
    $('#marketact_form').form('load', data);
  }
  //删除当前记录
  function deletemarketactitem() {
    $.messager.confirm('确认', '你确定要删除该记录?', result => {
      if (result) {
        const url = `/MarketActs/Delete/${marketactid}`;
        $.get(url).done(res => {
          if (res.success) {
            toastr.success("删除成功");
            $('#marketactdetailwindow').window('close');
            reloadData();
          } else {
            $.messager.alert('错误', res.err, 'error');
          }
        });
      }
    });
  }
  //async 保存数据
  async function savemarketactitem() {
    const $marketactform = $('#marketact_form');
    if ($marketactform.form('enableValidation').form('validate')) {
      let marketact = $marketactform.serializeJSON();
      let url = '/MarketActs/Edit';
      //判断是新增或是修改方法
      if (MODELSTATE === 'Added') {
        url = '/MarketActs/Create';
      }
      var token = $('input[name="__RequestVerificationToken"]', $marketactform).val();
      $.ajax({
        type: "POST",
        url: url,
        data: {
          __RequestVerificationToken: token,
          marketact: marketact
        },
        dataType: 'json',
        contentType: 'application/x-www-form-urlencoded; charset=utf-8'
      })
        .done(response => {
          if (response.success) {
            hook = false;
            $marketactform.form('disableValidation');
            $('#marketactdetailwindow').window("close");
            toastr.success("保存成功");
            reloadData();
          } else {
            $.messager.alert("错误", response.err, "error");
          }
        })
        .fail((jqXHR, textStatus, errorThrown) => {
          $.messager.alert('异常', `${jqXHR.status}: ${jqXHR.statusText} `, 'error');
        });
    }
  }
  //判断是否有没有保存的记录
  function marketacthasmodified() {
    return hook;

  }


  function initmarketactdetailview() {
    //回车光标移动到下个输入控件
    //如果是枚举类型需要把numberbox改成combobox
    //费用预算
    $('#BudgetExpense').numberbox('textbox').bind('keydown', function (e) {
      if (e.keyCode == 13) {
        $(e.target).emulateTab();
      }
    });
    //如果是枚举类型需要把numberbox改成combobox
    //实际投入
    $('#ActExpense').numberbox('textbox').bind('keydown', function (e) {
      if (e.keyCode == 13) {
        $(e.target).emulateTab();
      }
    });
    //如果是枚举类型需要把numberbox改成combobox
    //预计收入
    $('#Income').numberbox('textbox').bind('keydown', function (e) {
      if (e.keyCode == 13) {
        $(e.target).emulateTab();
      }
    });
    //日期类型 计划开始日期
    $('#PlanStartDate').datebox('textbox').bind('keydown', function (e) {
      if (e.keyCode == 13) {
        $(e.target).emulateTab();
      }
    });
    //日期类型 计划完成日期
    $('#PlanFinishDate').datebox('textbox').bind('keydown', function (e) {
      if (e.keyCode == 13) {
        $(e.target).emulateTab();
      }
    });
    //日期类型 实际开始日期
    $('#ActualStartDate').datebox('textbox').bind('keydown', function (e) {
      if (e.keyCode == 13) {
        $(e.target).emulateTab();
      }
    });
    //日期类型 实际完成日期
    $('#ActualFinishDate').datebox('textbox').bind('keydown', function (e) {
      if (e.keyCode == 13) {
        $(e.target).emulateTab();
      }
    });
  }
</script>

