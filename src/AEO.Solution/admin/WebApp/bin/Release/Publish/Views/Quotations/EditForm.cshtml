﻿@model WebApp.Models.Quotation
  <div class="form-row">
   @Html.HiddenFor(x=>x.Id)
         <!--报价单号-->
        <div class="col-xs-12 col-sm-6 col-md-4 col-lg-3">
            <label class="form-label">  @Html.DisplayNameFor(model => model.QpNo)</label>
			@Html.EditorFor(x => x.QpNo, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.QpNo) } })
      
         </div>

        <!--业务员-->
        <div class="col-xs-12 col-sm-6 col-md-4 col-lg-3">
            <label class="form-label"> <span class="text-danger">*</span> @Html.DisplayNameFor(model => model.Salesman)</label>
			@Html.EditorFor(x => x.Salesman, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.Salesman) } })
      
         </div>

     
       <!--公司-->
       <div class="col-xs-12 col-sm-6 col-md-4 col-lg-3">
            <label class="form-label"> <span class="text-danger">*</span> @Html.DisplayNameFor(model => model.CompanyId)</label>
   	        @Html.DropDownListFor(model => model.CompanyId, ViewBag.CompanyId as List<SelectListItem>, htmlAttributes: new { @class = "form-control" }) 
       </div>

        <!--公司代码-->
        <div class="col-xs-12 col-sm-6 col-md-4 col-lg-3">
            <label class="form-label"> <span class="text-danger">*</span> @Html.DisplayNameFor(model => model.CompanyCode)</label>
			@Html.EditorFor(x => x.CompanyCode, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.CompanyCode) } })
      
         </div>

        <!--公司名称-->
        <div class="col-xs-12 col-sm-6 col-md-4 col-lg-3">
            <label class="form-label">  @Html.DisplayNameFor(model => model.CompanyName)</label>
			@Html.EditorFor(x => x.CompanyName, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.CompanyName) } })
      
         </div>

     
