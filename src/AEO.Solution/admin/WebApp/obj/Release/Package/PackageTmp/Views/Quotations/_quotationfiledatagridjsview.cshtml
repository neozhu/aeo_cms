@model WebApp.Models.QuotationFile
<script type="text/javascript">
  //全屏事件
  document.addEventListener('panel.onfullscreen', () => {
       $quotationfiledg.datagrid('resize');
   });
    //是否开启行内编辑
    var SUBEDITINLINE = true;
   //初始化 QuotationFile datagrid
   var $quotationfiledg = $('#quotationfile_datagrid');
   //当前行记录
   var quotationfile = {};
   //datagrid CRUD method
    var quotationfile_editIndex = undefined;

  //下载文件
  function downloadFile(path) {
    const url = `/FileUpload/Download?file=${path}`;
    $.fileDownload(url)
      .done(() => {
        //console.log('file download a success!');
        toastr.success('下载完成!');
      })
      .fail(() => {
        $.messager.alert('下载失败', `没有找到文件!`, 'error');
      });
  }
    //重新加载数据
    function quotationfile_reloadData() {
			$quotationfiledg.datagrid('unselectAll');
            $quotationfiledg.datagrid('uncheckAll');
	        $quotationfiledg.datagrid('reload');
	}
    
     
    //新增记录
    function quotationfile_appendItem() {
      openuploadfilemodal();
	 }
    //删除编辑的行
	function quotationfile_removeItem() {
    quotationfile_deleteChecked()
	}
    //删除选中的行
    function quotationfile_deleteChecked() {
            const rows = $quotationfiledg.datagrid('getChecked');
            if (rows.length > 0) {
                var id = rows.filter(item=>item.Id!=null).map(item => {
                    return item.Id;
                });
                $.messager.confirm('确认', `你确定要删除这 <span class='badge bg-color-red'>${id.length}</span> 行记录?`,result => {
                    if (result) {
                        $.post('/QuotationFiles/DeleteChecked', { id: id })
                         .done(response => {
                            if (response.success) {
                                $quotationfiledg.datagrid('reload');
                            } else {
                                $.messager.alert('错误', response.err,'error');
                            }
                         });
                    }
                });
            } else {
                $.messager.alert('提示', '请先选择要删除的记录!','question');
            }
      }
  


  $(() => {
    $quotationfiledg.datagrid({
      fit: false,
      height: 500,
      rownumbers: true,
      striped: true,
      idField: 'Id',
      sortName: 'Id',
      sortOrder: 'asc',
      remoteFilter: true,
      singleSelect: true,
      checkOnSelect: false,
      selectOnCheck: false,
      method: 'get',
      pageList: [10, 20, 50, 100, 1000],
      pagination: true,
      clientPaging: false,
      pagination: true,
      onBeforeLoad: function () {

      },
      onLoadSuccess: function (data) {
        quotationfile_editIndex = undefined;
        $("button[name*='quotationfile_deleterowbutton']").prop('disabled', true);
      },
      onCheck: function () {
        $("button[name*='quotationfile_deleterowbutton']").prop('disabled', false);
      },
      onUncheck: function () {
        const checked = $(this).datagrid('getChecked').length > 0;
        $("button[name*='quotationfile_deleterowbutton']").prop('disabled', !checked);
      },
      onCheckAll: function (rows) {
        if (rows.length > 0) {
          $("button[name*='quotationfile_deleterowbutton']").prop('disabled', false);
        }
      },
      onUncheckAll: function () {
        $("button[name*='quotationfile_deleterowbutton']").prop('disabled', true);
      },
      onSelect: function (index, row) {
        quotationfile = row;
      },
      columns: [[
        { field: 'ck', checkbox: true },
        {
          field: 'action',
          title: '操作',
          align: 'center',
          width: 65,
          formatter: function (v, row) {
            return `<button onclick="downloadFile('${row.RelativePath}')" class="btn btn-outline-primary btn-sm btn-icon waves-effect waves-themed" data-toggle="tooltip" data-placement="right" title="下载" ><i class="fal fa-download"></i> </button>`
          }
        },
        {    /*文件名*/
          field: 'FileName',
          title: '<span class="text-danger">*</span>  @Html.DisplayNameFor(model => model.FileName)',
          width: 230,
          sortable: true,
          hidden: false,
          resizable: true
        },
        {    /*大小*/
          field: 'Size',
          title: '<span class="text-danger">*</span>  @Html.DisplayNameFor(model => model.Size)',
          width: 100,
          align: 'right',
          hidden: false,
          sortable: true,
          resizable: true,
          formatter: filesizeformatter
        },
        {    /*上传用户*/
          field: 'Owner',
          title: '  @Html.DisplayNameFor(model => model.Owner)',
          width: 120,
          sortable: true,
          hidden: false,
          resizable: true
        },
        {   /*上传时间*/
          field: 'Upload',
          title: '<span class="text-danger">*</span>  @Html.DisplayNameFor(model => model.Upload)',
          width: 100,
          align: 'right',
          hidden: false,
          sortable: true,
          resizable: true,
          formatter: dateformatter
        }
      ]]
    });
  });

</script>


