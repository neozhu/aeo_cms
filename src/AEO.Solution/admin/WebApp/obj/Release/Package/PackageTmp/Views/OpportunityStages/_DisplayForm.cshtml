﻿@model WebApp.Models.OpportunityStage
  <div class="form-row">
   @Html.HiddenFor(x=>x.Id)
         <!--阶段-->
        <div class="col-xs-12 col-md-6">
            <label class="form-label ">@Html.DisplayNameFor(model => model.Stage)</label>
			@Html.EditorFor(x => x.Stage, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.Stage) } })
      
         </div>

		<!--成功率-->
        <div class="col-xs-12 col-md-6">
            <label class="form-label text-danger">@Html.DisplayNameFor(model => model.SuccessRate)</label>
            @Html.EditorFor(x => x.SuccessRate, new { htmlAttributes = new { @class = "form-control",@type="number", placeholder = Html.DisplayNameFor(x => x.SuccessRate) } })

        </div>

       <!--确认时间-->
       <div class="col-xs-12 col-md-6">
            <label class="form-label text-danger">@Html.DisplayNameFor(model => model.ConfirmDate)</label>
            <div class="input-group">
			  @Html.EditorFor(x => x.ConfirmDate, 
                         new { htmlAttributes = new { @class = "form-control datepicker hasDatepicker",
                               placeholder = Html.DisplayNameFor(x => x.ConfirmDate ) } })
               <span class="input-group-addon"><i class="fa fa-calendar"></i></span>
			 </div>
         </div>

        <!--备注-->
        <div class="col-xs-12 col-md-6">
            <label class="form-label ">@Html.DisplayNameFor(model => model.Remark)</label>
			@Html.EditorFor(x => x.Remark, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.Remark) } })
      
         </div>

     
       <!--商机-->
       <div class="col-xs-12 col-md-6">
            <label class="form-label text-danger">@Html.DisplayNameFor(model => model.BusinessOpportunityId)</label>
   	        @Html.DropDownListFor(model => model.BusinessOpportunityId, ViewBag.BusinessOpportunityId as List<SelectListItem>, htmlAttributes: new { @class = "form-control" }) 
       </div>

	    
</div>

