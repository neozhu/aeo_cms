﻿@model WebApp.Models.MarketAct
  <div class="form-row">
   @Html.HiddenFor(x=>x.Id)
         <!--市场活动名称-->
        <div class="col-xs-12 col-md-6">
            <label class="form-label text-danger">@Html.DisplayNameFor(model => model.Name)</label>
			@Html.EditorFor(x => x.Name, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.Name) } })
      
         </div>

        <!--负责人-->
        <div class="col-xs-12 col-md-6">
            <label class="form-label text-danger">@Html.DisplayNameFor(model => model.Owner)</label>
			@Html.EditorFor(x => x.Owner, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.Owner) } })
      
         </div>

        <!--活动状态-->
        <div class="col-xs-12 col-md-6">
            <label class="form-label text-danger">@Html.DisplayNameFor(model => model.Status)</label>
			@Html.EditorFor(x => x.Status, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.Status) } })
      
         </div>

        <!--活动类型-->
        <div class="col-xs-12 col-md-6">
            <label class="form-label text-danger">@Html.DisplayNameFor(model => model.ActType)</label>
			@Html.EditorFor(x => x.ActType, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.ActType) } })
      
         </div>

       <!--计划开始日期-->
       <div class="col-xs-12 col-md-6">
            <label class="form-label ">@Html.DisplayNameFor(model => model.PlanStartDate)</label>
            <div class="input-group">
			  @Html.EditorFor(x => x.PlanStartDate, 
                         new { htmlAttributes = new { @class = "form-control datepicker hasDatepicker",
                               placeholder = Html.DisplayNameFor(x => x.PlanStartDate ) } })
               <span class="input-group-addon"><i class="fa fa-calendar"></i></span>
			 </div>
         </div>

       <!--计划完成日期-->
       <div class="col-xs-12 col-md-6">
            <label class="form-label ">@Html.DisplayNameFor(model => model.PlanFinishDate)</label>
            <div class="input-group">
			  @Html.EditorFor(x => x.PlanFinishDate, 
                         new { htmlAttributes = new { @class = "form-control datepicker hasDatepicker",
                               placeholder = Html.DisplayNameFor(x => x.PlanFinishDate ) } })
               <span class="input-group-addon"><i class="fa fa-calendar"></i></span>
			 </div>
         </div>

		<!--费用预算-->
        <div class="col-xs-12 col-md-6">
            <label class="form-label ">@Html.DisplayNameFor(model => model.BudgetExpense)</label>
            @Html.EditorFor(x => x.BudgetExpense, new { htmlAttributes = new { @class = "form-control",@type="number", placeholder = Html.DisplayNameFor(x => x.BudgetExpense) } })

        </div>

        <!--币种-->
        <div class="col-xs-12 col-md-6">
            <label class="form-label ">@Html.DisplayNameFor(model => model.Cur)</label>
			@Html.EditorFor(x => x.Cur, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.Cur) } })
      
         </div>

        <!--活动地点-->
        <div class="col-xs-12 col-md-6">
            <label class="form-label ">@Html.DisplayNameFor(model => model.Address)</label>
			@Html.EditorFor(x => x.Address, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.Address) } })
      
         </div>

        <!--活动计划-->
        <div class="col-xs-12 col-md-6">
            <label class="form-label ">@Html.DisplayNameFor(model => model.PlanDesc)</label>
			@Html.EditorFor(x => x.PlanDesc, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.PlanDesc) } })
      
         </div>

       <!--实际开始日期-->
       <div class="col-xs-12 col-md-6">
            <label class="form-label ">@Html.DisplayNameFor(model => model.ActualStartDate)</label>
            <div class="input-group">
			  @Html.EditorFor(x => x.ActualStartDate, 
                         new { htmlAttributes = new { @class = "form-control datepicker hasDatepicker",
                               placeholder = Html.DisplayNameFor(x => x.ActualStartDate ) } })
               <span class="input-group-addon"><i class="fa fa-calendar"></i></span>
			 </div>
         </div>

       <!--实际完成日期-->
       <div class="col-xs-12 col-md-6">
            <label class="form-label ">@Html.DisplayNameFor(model => model.ActualFinishDate)</label>
            <div class="input-group">
			  @Html.EditorFor(x => x.ActualFinishDate, 
                         new { htmlAttributes = new { @class = "form-control datepicker hasDatepicker",
                               placeholder = Html.DisplayNameFor(x => x.ActualFinishDate ) } })
               <span class="input-group-addon"><i class="fa fa-calendar"></i></span>
			 </div>
         </div>

		<!--实际投入-->
        <div class="col-xs-12 col-md-6">
            <label class="form-label ">@Html.DisplayNameFor(model => model.ActExpense)</label>
            @Html.EditorFor(x => x.ActExpense, new { htmlAttributes = new { @class = "form-control",@type="number", placeholder = Html.DisplayNameFor(x => x.ActExpense) } })

        </div>

		<!--预计收入-->
        <div class="col-xs-12 col-md-6">
            <label class="form-label ">@Html.DisplayNameFor(model => model.Income)</label>
            @Html.EditorFor(x => x.Income, new { htmlAttributes = new { @class = "form-control",@type="number", placeholder = Html.DisplayNameFor(x => x.Income) } })

        </div>

        <!--执行情况-->
        <div class="col-xs-12 col-md-6">
            <label class="form-label ">@Html.DisplayNameFor(model => model.ExecDesc)</label>
			@Html.EditorFor(x => x.ExecDesc, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.ExecDesc) } })
      
         </div>

        <!--活动总结-->
        <div class="col-xs-12 col-md-6">
            <label class="form-label ">@Html.DisplayNameFor(model => model.SumaryDesc)</label>
			@Html.EditorFor(x => x.SumaryDesc, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.SumaryDesc) } })
      
         </div>

        <!--评估效果-->
        <div class="col-xs-12 col-md-6">
            <label class="form-label ">@Html.DisplayNameFor(model => model.EffectDesc)</label>
			@Html.EditorFor(x => x.EffectDesc, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.EffectDesc) } })
      
         </div>

	    
</div>

