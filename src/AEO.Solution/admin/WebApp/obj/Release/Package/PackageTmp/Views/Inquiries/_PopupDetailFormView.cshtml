﻿@model WebApp.Models.Inquiry
<!-- 弹出编辑窗体表单 -->
<div id="inquirydetailwindow" class="easyui-window"
     title="编辑询价单"
     data-options="modal:true,
                    closed:true,
                    minimizable:false,
                    collapsible:false,
                    maximized:false,
                    iconCls:'fal fa-window',
                    onBeforeClose:function(){
                      var that = $(this);
                      if(inquiryhasmodified()){
                        $.messager.confirm('确认','你确定要放弃保存修改的记录?',function(r){
                        if (r){
                          var opts = that.panel('options');
                          var onBeforeClose = opts.onBeforeClose;
                          opts.onBeforeClose = function(){};
                          that.panel('close');
                          opts.onBeforeClose = onBeforeClose;
                          hook = false;
                        }
                        });
                        return false;
                      }
                    },
                    onOpen:function(){
                       $(this).window('vcenter');
                       $(this).window('hcenter');
                    },
                    onRestore:function(){
                      $inquiryfiledg.datagrid('resize');
                      $inquiryproductdg.datagrid('resize');
                      $inquiryrefdg.datagrid('resize');
                    },
                    onMaximize:function(){
                      $inquiryfiledg.datagrid('resize');
                      $inquiryproductdg.datagrid('resize');
                      $inquiryrefdg.datagrid('resize');
                    }
                    " style="width:800px;height:510px;display:none">
  <!-- toolbar -->
  <div class="panel-content py-2 rounded-bottom border-faded border-left-0 border-right-0  text-muted bg-subtlelight-fade sticky-top">
    <div class="d-flex justify-content-end pr-4">
      <div class="btn-group btn-group-sm mr-1">
        <button name="saveitembutton" class="btn btn-default">
          <i class="fal fa-save"></i> @Html.L("Save")
        </button>
      </div>
      <div class="btn-group btn-group-sm mr-1" id="deleteitem-btn-group">
        <button name="deleteitembutton" class="btn btn-danger">
          <i class="fal fa-trash-alt"></i> @Html.L("Delete")
        </button>
      </div>
    </div>
  </div>
  <!-- panel container form  -->
  <div class="panel-container show">
    <div class="container">
      <div class="panel-content">
        
        <ul class="nav nav-tabs nav-tabs-clean" role="tablist">
          <li class="nav-item">
            <a class="nav-link active"
               data-toggle="tab"
               data-model="inquiry"
               href="#tab-inquiry"
               role="tab">询价单信息</a>
          </li>
          <li class="nav-item">
            <a class="nav-link "
               data-toggle="tab"
               data-model="inquiryproduct"
               href="#tab-inquiryproduct"
               role="tab">产品信息</a>
          </li>
          <li class="nav-item">
            <a class="nav-link "
               data-toggle="tab"
               data-model="inquiryref"
               href="#tab-inquiryref"
               role="tab">关联任务单</a>
          </li>
          <li class="nav-item">
            <a class="nav-link "
               data-toggle="tab"
               data-model="inquiryfile"
               href="#tab-inquiryfile"
               role="tab">附件信息</a>
          </li>
        </ul>
        <div class="tab-content p-0">
          <div class="tab-pane fade show active"
               id="tab-inquiry"
               data-model="inquiry"
               role="tabpanel"
               aria-labelledby="tab-inquiry">

            <div class="d-flex justify-content-start flex-wrap p-2">
              <form id="inquiry_form"
                    class="easyui-form form-horizontal padding-10"
                    method="post"
                    data-options="novalidate:true,
                            onChange: function(target){
                              hook = true;
                              $('button[name*=\'saveitembutton\']').prop('disabled', false);
                             },
                             onLoadSuccess:function(data){
                               hook = false;
                               $('button[name*=\'saveitembutton\']').prop('disabled', true);
                             }">
                @Html.AntiForgeryToken()
                <!--Primary Key-->
                @Html.HiddenFor(model => model.Id)
                @Html.HiddenFor(model => model.CustomerCode)
                @Html.HiddenFor(model => model.CustomerName)
                <!--紧急程度-->
                @Html.HiddenFor(model => model.Urgency)
                <!--到期提醒-->
                @Html.HiddenFor(model => model.PreRemind)
                <!--创建人-->
                @Html.HiddenFor(model => model.Check1)
                <!--创建人-->
                @Html.HiddenFor(model => model.Creator)
                <!--执行人-->
                @Html.HiddenFor(model => model.Executor)
                <!--执行人-->
                @Html.HiddenFor(model => model.Check2)
                <!--责任人-->
                @Html.HiddenFor(model => model.Check3)
                <!--责任人-->
                @Html.HiddenFor(model => model.Owner)
                <!--公司名称-->
                @Html.HiddenFor(model => model.CompanyName)
                <!--系统版本号-->
                @Html.HiddenFor(model => model.Ver)
                @Html.HiddenFor(model => model.Country)
                @Html.HiddenFor(model => model.Cur)
                @Html.HiddenFor(model => model.ExchangeRate)
                @Html.HiddenFor(model => model.EndDate)

                <fieldset class="form-group">
                  <div class="row h-100 align-items-center">

                    <!--询价单号-->
                    <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"><span class="text-danger">*</span> @Html.DisplayNameFor(model => model.InquiryNo)</label>
                    <div class="col-md-4 mb-1 pl-1">
                      <input id="@Html.IdFor(model => model.InquiryNo)"
                             name="@Html.NameFor(model => model.InquiryNo)"
                             value="@Html.ValueFor(model => model.InquiryNo)"
                             tabindex="0"
                             class="easyui-textbox"
                             style="width:100%"
                             type="text"
                             data-options="prompt:'@Html.DescriptionFor(model => model.InquiryNo)',
								 required:false, validType: 'length[0,20]'
                                 " />
                    </div>
                    <!--公司-->
                    <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"><span class="text-danger">*</span> @Html.DisplayNameFor(model => model.CompanyId)</label>
                    <div class="col-md-4 mb-1 pl-1">
                      <input id="@Html.IdFor(model => model.CompanyId)"
                             name="@Html.NameFor(model => model.CompanyId)"
                             value="@Html.ValueFor(model => model.CompanyId)"
                             tabindex="16" required
                             class="easyui-combobox"
                             style="width:100%"
                             data-options="prompt:'@Html.DescriptionFor(model => model.CompanyId)' ,
						                   required:true ,
						                   valueField: 'Id',
						                   textField:  'Name' ,
                               panelHeight:'auto',
                               editable:false,
						                   url: '/Inquiries/GetCompanies' ,
						                   onSelect: function(item) {
						                    //console.log(item);
				                       }">
                    </div>
                    <!--任务单号-->
                    <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"> @Html.DisplayNameFor(model => model.TaskNo)</label>
                    <div class="col-md-4 mb-1 pl-1">
                      <input id="@Html.IdFor(model => model.TaskNo)"
                             name="@Html.NameFor(model => model.TaskNo)"
                             value="@Html.ValueFor(model => model.TaskNo)"
                             tabindex="1"
                             class="easyui-textbox"
                             style="width:100%"
                             type="text"
                             data-options="prompt:'@Html.DescriptionFor(model => model.TaskNo)',
								                 required:false,readonly:true,
                                 validType: 'length[0,256]'
                                 " />
                    </div>


                    <!--状态-->
                    <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"><span class="text-danger">*</span> @Html.DisplayNameFor(model => model.Status)</label>
                    <div class="col-md-4 mb-1 pl-1">
                      <input id="@Html.IdFor(model => model.Status)"
                             name="@Html.NameFor(model => model.Status)"
                             value="@Html.ValueFor(model => model.Status)"
                             tabindex="2" required
                             class="easyui-textbox"
                             style="width:100%"
                             type="text"
                             data-options="prompt:'@Html.DescriptionFor(model => model.Status)',
								 required:true,readonly:true,
                                 validType: 'length[0,20]'
                                 " />
                    </div>

                    <!--业务员-->
                    <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"><span class="text-danger">*</span> @Html.DisplayNameFor(model => model.Salesman)</label>
                    <div class="col-md-4 mb-1 pl-1">
                      <input id="@Html.IdFor(model => model.Salesman)"
                             name="@Html.NameFor(model => model.Salesman)"
                             value="@Html.ValueFor(model => model.Salesman)"
                             tabindex="3" required
                             class="easyui-textbox"
                             style="width:100%"
                             type="text"
                             data-options="prompt:'@Html.DescriptionFor(model => model.Salesman)',
								 required:true,
                                 validType: 'length[0,20]'
                                 " />
                    </div>

                    <!--客户-->
                    <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"><span class="text-danger">*</span> @Html.DisplayNameFor(model => model.CustomerId)</label>
                    <div class="col-md-4 mb-1 pl-1">
                      <input id="@Html.IdFor(model => model.CustomerId)"
                             name="@Html.NameFor(model => model.CustomerId)"
                             value="@Html.ValueFor(model => model.CustomerId)"
                             tabindex="7" required
                             class="easyui-combogrid"
                             style="width:100%"
                             data-options="prompt:'@Html.DescriptionFor(model => model.CustomerId)' ,
						              required:true ,
						              idField: 'Id',
						              textField:  'CustomerName' ,
                          panelHeight:'auto',
                          panelWidth:490,
                          editable:true,
                          method:'get',
                          mode: 'remote',
                          fitColumns:true,
                          pagination: true,
                           clientPaging:false,
                          pageList: [10, 20, 50, 100, 500],
						              url: '/Customers/GetCustomerComboGridData' ,
                          columns:[[
                           {field:'CustomerCode',title:'客户编码',width:90},
                           {field:'CustomerName',title:'客户名称',width:150}
                          ]],
						              onClickRow: function(index,item){
                              console.log(item)
						                  $('#inquiry_form #CustomerCode').val(item.CustomerCode);
                              $('#inquiry_form #CustomerName').val(item.CustomerName);
                              $('#inquiry_form #Country').val(item.Country);
                              $('#inquiry_form #ContactName').combobox('reload','/CustomerContacts/GetComboData?customerId=' + item.Id);
                              $('#inquiry_form #ContactName').combobox('setValue',item.ContactName)
                              $('#inquiry_form #ContactInfo').textbox('setValue',item.Telephone)
                       }">
                    </div>
                    <!--询价日期-->
                    <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"><span class="text-danger">*</span> @Html.DisplayNameFor(model => model.BeginDate)</label>
                    <div class="col-md-4 mb-1 pl-1">
                      <input id="@Html.IdFor(model => model.BeginDate)"
                             name="@Html.NameFor(model => model.BeginDate)"
                             value="@Html.ValueFor(model => model.BeginDate)"
                             tabindex="4" required
                             class="easyui-datebox"
                             style="width:100%"
                             type="text"
                             data-options="prompt:'@Html.DescriptionFor(model => model.BeginDate)',
								 required:true,
								 formatter:dateformatter" />
                    </div>

                    <!--反馈日期-->
                    <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"><span class="text-danger">*</span> @Html.DisplayNameFor(model => model.FeedbackDate)</label>
                    <div class="col-md-4 mb-1 pl-1">
                      <input id="@Html.IdFor(model => model.FeedbackDate)"
                             name="@Html.NameFor(model => model.FeedbackDate)"
                             value="@Html.ValueFor(model => model.FeedbackDate)"
                             tabindex="5"
                             class="easyui-datebox"
                             style="width:100%"
                             type="text"
                             data-options="prompt:'@Html.DescriptionFor(model => model.FeedbackDate)',
								 required:true,
								 formatter:dateformatter" />
                    </div>


                    <!--询价要求-->
                    <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"> @Html.DisplayNameFor(model => model.Demande)</label>
                    <div class="col-md-10 mb-1 pl-1">
                      <input id="@Html.IdFor(model => model.Demande)"
                             name="@Html.NameFor(model => model.Demande)"
                             value="@Html.ValueFor(model => model.Demande)"
                             tabindex="6"
                             class="easyui-textbox"
                             style="width:100%"
                             type="text"
                             data-options="prompt:'@Html.DescriptionFor(model => model.Demande)',
								 required:false,multiline:true,
                                 validType: 'length[0,256]'
                                 " />
                    </div>




                    

 

                 

                    <!--联系人-->
                    <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"><span class="text-danger">*</span> @Html.DisplayNameFor(model => model.ContactName)</label>
                    <div class="col-md-4 mb-1 pl-1">
                      <input id="@Html.IdFor(model => model.ContactName)"
                             name="@Html.NameFor(model => model.ContactName)"
                             value="@Html.ValueFor(model => model.ContactName)"
                             tabindex="13" required
                             class="easyui-combobox"
                             style="width:100%"
                             type="text"
                             data-options="prompt:'@Html.DescriptionFor(model => model.ContactName)',
								                 required:true,textField:'Name',valueField:'Name',panelHeight:'auto',
                                 validType: 'length[0,80]',
                                 onSelect:function(item){
                                    $('#inquiry_form #ContactInfo').textbox('setValue',item.PhoneNumber||item.Email)
                                 }
                                 " />
                    </div>


                    <!--联系方式-->
                    <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"> @Html.DisplayNameFor(model => model.ContactInfo)</label>
                    <div class="col-md-4 mb-1 pl-1">
                      <input id="@Html.IdFor(model => model.ContactInfo)"
                             name="@Html.NameFor(model => model.ContactInfo)"
                             value="@Html.ValueFor(model => model.ContactInfo)"
                             tabindex="14"
                             class="easyui-textbox"
                             style="width:100%"
                             type="text"
                             data-options="prompt:'@Html.DescriptionFor(model => model.ContactInfo)',
								 required:false,                              validType: 'length[0,128]'
                                 " />
                    </div>

                 



                  </div>
                </fieldset>
              </form>

            </div>
  
          </div>
          <div class="tab-pane fade "
               id="tab-inquiryfile"
               data-model="inquiryfile"
               role="tabpanel"
               aria-labelledby="tab-inquiryfile">

            <div class="d-flex justify-content-start flex-wrap p-2">
              <div class="btn-group btn-group-sm mr-2" role="group" aria-label="操作明细按钮">
                <button name="inquiryfile_searchbutton"
                        type="button"
                        class="btn btn-default waves-effect waves-themed"
                        onclick="inquiryfile_reloadData()">
                  查询
                </button>
                <button name="inquiryfile_appenditembutton"
                        type="button"
                        class="btn btn-default waves-effect waves-themed">
                  上传文件
                </button>
                <button name="inquiryfile_deleterowbutton"
                        type="button"
                        class="btn btn-default waves-effect waves-themed">
                  删除
                </button>
                 
              </div>

            </div>
            <div class="table-responsive">
              <table class="m-0" id="inquiryfile_datagrid">
              </table>
            </div>
          </div>
          <div class="tab-pane fade"
               id="tab-inquiryproduct"
               data-model="inquiryproduct"
               role="tabpanel"
               aria-labelledby="tab-inquiryproduct">

            <div class="d-flex justify-content-start flex-wrap p-2">
              <div class="btn-group btn-group-sm mr-2" role="group" aria-label="操作明细按钮">
                <button name="inquiryproduct_searchbutton"
                        type="button"
                        class="btn btn-default waves-effect waves-themed"
                        onclick="inquiryproduct_reloadData()">
                  查询
                </button>
                <button name="inquiryproduct_appenditembutton"
                        type="button"
                        class="btn btn-default waves-effect waves-themed">
                  添加产品
                </button>
                <button name="inquiryproduct_deleterowbutton"
                        type="button"
                        class="btn btn-default waves-effect waves-themed">
                  删除
                </button>
                <button name="inquiryproduct_cancelchangesbutton"
                        type="button"
                        class="btn btn-default waves-effect waves-themed">
                  取消
                </button>
                <button name="inquiryproduct_savechangesbutton"
                        type="button"
                        class="btn btn-default waves-effect waves-themed">
                  保存
                </button>
              </div>

            </div>
            <div class="table-responsive">
              <table class="m-0" id="inquiryproduct_datagrid">
              </table>
            </div>
          </div>
          <div class="tab-pane fade  "
               id="tab-inquiryref"
               data-model="inquiryref"
               role="tabpanel"
               aria-labelledby="tab-inquiryref">

            <div class="d-flex justify-content-start flex-wrap p-2">
              <div class="btn-group btn-group-sm mr-2" role="group" aria-label="关联任务单">
                <button name="inquiryref_searchbutton"
                        type="button"
                        class="btn btn-default waves-effect waves-themed"
                        onclick="inquiryref_reloadData()">
                  查询
                </button>
                 
              </div>

            </div>
            <div class="table-responsive">
              <table class="m-0" id="inquiryref_datagrid">
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- 弹出窗体form表单 -->
<!-- 弹出编辑对话框 -->
<!-- inquiryfile datagrid  javascript block -->
@Html.Partial("_InquiryFileEditForm", new WebApp.Models.InquiryFile())
<!-- inquiryproduct datagrid  javascript block -->
@Html.Partial("_InquiryProductEditForm", new WebApp.Models.InquiryProduct())
<!-- inquiryref datagrid  javascript block -->
@Html.Partial("_InquiryRefEditForm", new WebApp.Models.InquiryRef())

<!--begin popup detailview javascript block -->
<script type="text/javascript">
  //当初始的 HTML 文档被完全加载和解析完成之后
  document.addEventListener('DOMContentLoaded', function () {
    //绑定按钮事件
    $('button[name="saveitembutton"]').on('click', saveinquiryitem);
    $('button[name="deleteitembutton"]').on('click', deleteinquiryitem);
    $('button[name="inquiryfile_searchbutton"]').on('click', inquiryfile_reloadData);
    $('button[name="inquiryfile_appenditembutton"]').on('click', inquiryfile_appendItem);
    $('button[name="inquiryfile_deleterowbutton"]').on('click', inquiryfile_removeItem);
    
  
    $('button[name="inquiryproduct_searchbutton"]').on('click', inquiryproduct_reloadData);
    $('button[name="inquiryproduct_appenditembutton"]').on('click', inquiryproduct_appendItem);
    $('button[name="inquiryproduct_deleterowbutton"]').on('click', inquiryproduct_removeItem);
    $('button[name="inquiryproduct_cancelchangesbutton"]').on('click', inquiryproduct_rejectChanges);
    $('button[name="inquiryproduct_savechangesbutton"]').on('click', inquiryproduct_acceptChanges);
    $('button[name="inquiryref_searchbutton"]').on('click', inquiryref_reloadData);
    $('a[data-toggle="tab"]').on('shown.bs.tab', (e) => {
   
      const model = $(e.target).data('model');
     
      $(`#${model}_datagrid`).datagrid('resize');
    })
  });
  //判断新增编辑状态
  var MODELSTATE = 'Added';
  var inquiryid = null;
  function openinquirydetailwindow(data, state) {
    MODELSTATE = state;
    //判断是否显示功能按钮
    if (MODELSTATE === 'Added') {
      $('#deleteitem-btn-group').hide();
      $('button[name="inquiryfile_appenditembutton"]').attr('disabled', 'disabled');
    } else {
      $('#deleteitem-btn-group').show();
      $('button[name="inquiryfile_appenditembutton"]').removeAttr('disabled');
    }
    initinquirydetailview();
    inquiryid = (data.Id || 0);
    $('#inquirydetailwindow').window('open');
    $('#inquiry_form').form('reset');
    $('#inquiry_form').form('load', data);
    var url = '/InquiryFiles/GetDataByInquiryId?inquiryid=' + inquiryid;
    $inquiryfiledg.datagrid('load', url);
    $inquiryfiledg.datagrid('resize');
    var url = '/InquiryProducts/GetDataByInquiryId?inquiryid=' + inquiryid;
    $inquiryproductdg.datagrid('load', url);
    $inquiryproductdg.datagrid('resize');
    var url = '/InquiryRefs/GetDataByInquiryId?inquiryid=' + inquiryid;
    $inquiryrefdg.datagrid('load', url);
    $inquiryrefdg.datagrid('resize');
  }
  //删除当前记录
  function deleteinquiryitem() {
    $.messager.confirm('确认', '你确定要删除该记录?', result => {
      if (result) {
        const url = `/Inquiries/Delete/${inquiryid}`;
        $.get(url).done(res => {
          if (res.success) {
            toastr.success("删除成功");
            $('#inquirydetailwindow').window('close');
            reloadData();
          } else {
            $.messager.alert('错误', res.err, 'error');
          }
        });
      }
    });
  }
  //async 保存数据
  async function saveinquiryitem() {
    const $inquiryform = $('#inquiry_form');
    if ($inquiryform.form('enableValidation').form('validate')) {
      let inquiry = $inquiryform.serializeJSON();
      //获取明细表数据

      


      const inquiryproduct_result = await inquiryproduct_acceptChanges();
      if (!inquiryproduct_result.success) {
        return false;
      } else {
        inquiry.Inquiryproducts = inquiryproduct_result.changed;
      }


       

      let url = '/Inquiries/Edit';
      //判断是新增或是修改方法
      if (MODELSTATE === 'Added') {
        url = '/Inquiries/Create';
      }
      var token = $('input[name="__RequestVerificationToken"]', $inquiryform).val();
      $.ajax({
        type: "POST",
        url: url,
        data: {
          __RequestVerificationToken: token,
          inquiry: inquiry
        },
        dataType: 'json',
        contentType: 'application/x-www-form-urlencoded; charset=utf-8'
      })
        .done(response => {
          if (response.success) {
            hook = false;
            $inquiryform.form('disableValidation');
            $('#inquirydetailwindow').window("close");
            toastr.success("保存成功");
            reloadData();
          } else {
            $.messager.alert("错误", response.err, "error");
          }
        })
        .fail((jqXHR, textStatus, errorThrown) => {
          $.messager.alert('异常', `${jqXHR.status}: ${jqXHR.statusText} `, 'error');
        });
    }
  }
  //判断是否有没有保存的记录
  function inquiryhasmodified() {
    if (!hook) {
      if (!inquiryproduct_endEditing()) {
        return true;
      }
      const inquiryproducts = $inquiryproductdg.datagrid("getChanges");
      if (MODELSTATE == 'Modified' && inquiryproducts.length > 0) {
        return true;
      }
 
       

    } else {
      return hook;
    }

  }


  function initinquirydetailview() {
    //回车光标移动到下个输入控件
    //如果是枚举类型需要把numberbox改成combobox
    //汇率
    //$('#ExchangeRate').numberbox('textbox').bind('keydown', function (e) {
    //  if (e.keyCode == 13) {
    //    $(e.target).emulateTab();
    //  }
    //});
    //如果是枚举类型需要把numberbox改成combobox
    //到期提醒
    //$('#PreRemind').numberbox('textbox').bind('keydown', function (e) {
    //  if (e.keyCode == 13) {
    //    $(e.target).emulateTab();
    //  }
    //});
    //如果是枚举类型需要把numberbox改成combobox
    //系统版本号
    //$('#Ver').numberbox('textbox').bind('keydown', function (e) {
    //  if (e.keyCode == 13) {
    //    $(e.target).emulateTab();
    //  }
    //});
    //日期类型 询价日期
    //$('#BeginDate').datebox('textbox').bind('keydown', function (e) {
    //  if (e.keyCode == 13) {
    //    $(e.target).emulateTab();
    //  }
    //});
    //日期类型 反馈日期
    //$('#FeedbackDate').datebox('textbox').bind('keydown', function (e) {
    //  if (e.keyCode == 13) {
    //    $(e.target).emulateTab();
    //  }
