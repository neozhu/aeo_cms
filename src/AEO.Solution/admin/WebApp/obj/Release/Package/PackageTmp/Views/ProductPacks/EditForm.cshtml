﻿@model WebApp.Models.ProductPack
  <div class="form-row">
   @Html.HiddenFor(x=>x.Id)
         <!--包装单位-->
        <div class="col-xs-12 col-sm-6 col-md-4 col-lg-3">
            <label class="form-label"> <span class="text-danger">*</span> @Html.DisplayNameFor(model => model.Package)</label>
			@Html.EditorFor(x => x.Package, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.Package) } })
      
         </div>

		<!--内装数量-->
        <div class="col-xs-12 col-sm-6 col-md-4 col-lg-3">
            <label class="form-label">  @Html.DisplayNameFor(model => model.InnerBoxQty)</label>
            @Html.EditorFor(x => x.InnerBoxQty, new { htmlAttributes = new { @class = "form-control",@type="number", placeholder = Html.DisplayNameFor(x => x.InnerBoxQty) } })

        </div>

		<!--长-->
        <div class="col-xs-12 col-sm-6 col-md-4 col-lg-3">
            <label class="form-label">  @Html.DisplayNameFor(model => model.Length)</label>
            @Html.EditorFor(x => x.Length, new { htmlAttributes = new { @class = "form-control",@type="number", placeholder = Html.DisplayNameFor(x => x.Length) } })

        </div>

		<!--宽-->
        <div class="col-xs-12 col-sm-6 col-md-4 col-lg-3">
            <label class="form-label">  @Html.DisplayNameFor(model => model.Width)</label>
            @Html.EditorFor(x => x.Width, new { htmlAttributes = new { @class = "form-control",@type="number", placeholder = Html.DisplayNameFor(x => x.Width) } })

        </div>

		<!--高-->
        <div class="col-xs-12 col-sm-6 col-md-4 col-lg-3">
            <label class="form-label">  @Html.DisplayNameFor(model => model.Height)</label>
            @Html.EditorFor(x => x.Height, new { htmlAttributes = new { @class = "form-control",@type="number", placeholder = Html.DisplayNameFor(x => x.Height) } })

        </div>

        <!--长度单位-->
        <div class="col-xs-12 col-sm-6 col-md-4 col-lg-3">
            <label class="form-label">  @Html.DisplayNameFor(model => model.Unit)</label>
			@Html.EditorFor(x => x.Unit, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.Unit) } })
      
         </div>

		<!--毛重(kg)-->
        <div class="col-xs-12 col-sm-6 col-md-4 col-lg-3">
            <label class="form-label">  @Html.DisplayNameFor(model => model.GWeight)</label>
            @Html.EditorFor(x => x.GWeight, new { htmlAttributes = new { @class = "form-control",@type="number", placeholder = Html.DisplayNameFor(x => x.GWeight) } })

        </div>

		<!--净重(kg)-->
        <div class="col-xs-12 col-sm-6 col-md-4 col-lg-3">
            <label class="form-label">  @Html.DisplayNameFor(model => model.NWeight)</label>
            @Html.EditorFor(x => x.NWeight, new { htmlAttributes = new { @class = "form-control",@type="number", placeholder = Html.DisplayNameFor(x => x.NWeight) } })

        </div>

		<!--体积(m3)-->
        <div class="col-xs-12 col-sm-6 col-md-4 col-lg-3">
            <label class="form-label">  @Html.DisplayNameFor(model => model.Volume)</label>
            @Html.EditorFor(x => x.Volume, new { htmlAttributes = new { @class = "form-control",@type="number", placeholder = Html.DisplayNameFor(x => x.Volume) } })

        </div>

		<!--20尺装量-->
        <div class="col-xs-12 col-sm-6 col-md-4 col-lg-3">
            <label class="form-label">  @Html.DisplayNameFor(model => model.TwentyQtc)</label>
            @Html.EditorFor(x => x.TwentyQtc, new { htmlAttributes = new { @class = "form-control",@type="number", placeholder = Html.DisplayNameFor(x => x.TwentyQtc) } })

        </div>

		<!--40尺装量-->
        <div class="col-xs-12 col-sm-6 col-md-4 col-lg-3">
            <label class="form-label">  @Html.DisplayNameFor(model => model.FortyQtc)</label>
            @Html.EditorFor(x => x.FortyQtc, new { htmlAttributes = new { @class = "form-control",@type="number", placeholder = Html.DisplayNameFor(x => x.FortyQtc) } })

        </div>

		<!--40HQ装量-->
        <div class="col-xs-12 col-sm-6 col-md-4 col-lg-3">
            <label class="form-label">  @Html.DisplayNameFor(model => model.FortyHQQtc)</label>
            @Html.EditorFor(x => x.FortyHQQtc, new { htmlAttributes = new { @class = "form-control",@type="number", placeholder = Html.DisplayNameFor(x => x.FortyHQQtc) } })

        </div>

		
      <!--默认包装-->
      <div class="col-xs-12 col-sm-6 col-md-4 col-lg-3">
              <label class="form-label"> <span class="text-danger">*</span> @Html.DisplayNameFor(model => model.Default)</label>
              <div class="custom-control custom-checkbox">
                 <input id="@Html.IdFor(model => model.Default)"
                       name="@Html.NameFor(model => model.Default)"
                       value="true" @(Model.Default ? "checked=\"checked\"" : "")
                       class="custom-control-input"
                       tabindex="6"
                       type="checkbox" />
                <label class="custom-control-label" for="@Html.IdFor(model => model.Default)">@Html.DisplayNameFor(model => model.Default)</label>
            </div>
      </div>

     
       <!--所属产品-->
       <div class="col-xs-12 col-sm-6 col-md-4 col-lg-3">
            <label class="form-label"> <span class="text-danger">*</span> @Html.DisplayNameFor(model => model.ProductId)</label>
   	        @Html.DropDownListFor(model => model.ProductId, ViewBag.ProductId as List<SelectListItem>, htmlAttributes: new { @class = "form-control" }) 
       </div>

	    
</div>

