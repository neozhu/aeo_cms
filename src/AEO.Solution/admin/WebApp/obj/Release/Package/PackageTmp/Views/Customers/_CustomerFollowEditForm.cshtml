@model WebApp.Models.CustomerFollow
<div id="customerfollowdlg" class="easyui-dialog"
     title="CustomerFollow" style="width:600px;height:300px; display:none"
     data-options="
                iconCls: 'fal fa-window',
                modal:true,
                closed:true,
                cache: false,
                resizable:true,
                width:620,
                height:300,
                onOpen:function(){
                   $('#customerfollow_form').form('disableValidation');
                },
                buttons: [{
                    text:'确认',
                    handler:function(){
                        confirm_customerfollowform();
                    }
                },{
                    text:'取消',
                    handler:function(){
                        $('#customerfollowdlg').dialog('close');
                    }
                }]
            ">
  <div class="panel-container show">
    <div class="panel-content p-0">
      <form id="customerfollow_form" class="form-horizontal needs-validation" novalidate>
        <fieldset class="form-group">
          <div class="row h-100 align-items-center m-0 pt-2">
            <!--系统主键-->
            @Html.HiddenFor(model => model.Id)
            @Html.HiddenFor(model => model.CustomerId)
            @Html.HiddenFor(model => model.CustomerCode)
            @Html.HiddenFor(model => model.CustomerName)

            <!--客户联系人-->
            <label class="col-md-2 form-label text-right p-0" for="@Html.IdFor(model => model.ContactName)"><span class="text-danger">*</span> @Html.DisplayNameFor(model => model.ContactName) </label>
            <div class="col-md-4 mb-1">
              <input id="@Html.IdFor(model => model.ContactName)"
                     name="@Html.NameFor(model => model.ContactName)"
                     value="@Html.ValueFor(model => model.ContactName)"
                     tabindex="1"
                     class="easyui-combobox"
                     type="text"
                     style="width:100%"
                     data-options="prompt:'@Html.DisplayNameFor(model => model.ContactName)',
     						 required:true ,validType:'length[0,80]',textField:'Name',valueField:'Name',
                     panelHeight:'auto'
                     " />
            </div>
            <!--跟进人-->
            <label class="col-md-2 form-label text-right p-0" for="@Html.IdFor(model => model.Owner)">@Html.DisplayNameFor(model => model.Owner) </label>
            <div class="col-md-4 mb-1">
              <input id="@Html.IdFor(model => model.Owner)"
                     name="@Html.NameFor(model => model.Owner)"
                     value="@Html.ValueFor(model => model.Owner)"
                     tabindex="4"
                     class="easyui-textbox"
                     type="text"
                     style="width:100%"
                     data-options="prompt:'@Html.DisplayNameFor(model => model.Owner)',
     						 required:false ,validType:'length[0,20]'" />
            </div>
            <!--跟进方式-->
            <label class="col-md-2 form-label text-right p-0" for="@Html.IdFor(model => model.FollowType)"><span class="text-danger">*</span>@Html.DisplayNameFor(model => model.FollowType) </label>
            <div class="col-md-4 mb-1">
              <input id="@Html.IdFor(model => model.FollowType)"
                     name="@Html.NameFor(model => model.FollowType)"
                     value="@Html.ValueFor(model => model.FollowType)"
                     tabindex="2"
                     class="easyui-combobox"
                     type="text"
                     style="width:100%"
                     data-options="prompt:'@Html.DisplayNameFor(model => model.FollowType)',
     						 required:true ,validType:'length[0,20]',
                     data:followtypedatasource,panelHeight:'auto'" />
            </div>

            <!--跟进状态-->
            <label class="col-md-2 form-label text-right p-0" for="@Html.IdFor(model => model.Status)"><span class="text-danger">*</span>@Html.DisplayNameFor(model => model.Status) </label>
            <div class="col-md-4 mb-1">
              <input id="@Html.IdFor(model => model.Status)"
                     name="@Html.NameFor(model => model.Status)"
                     value="@Html.ValueFor(model => model.Status)"
                     tabindex="3"
                     class="easyui-combobox"
                     type="text"
                     style="width:100%"
                     data-options="prompt:'@Html.DisplayNameFor(model => model.Status)',
     						 required:true ,validType:'length[0,20]',data:followstatusdatasource,panelHeight:'auto'" />
            </div>





            <!--跟进内容-->
            <label class="col-md-2 form-label text-right p-0" for="@Html.IdFor(model => model.Content)">@Html.DisplayNameFor(model => model.Content) </label>
            <div class="col-md-10 mb-1">
              <input id="@Html.IdFor(model => model.Content)"
                     name="@Html.NameFor(model => model.Content)"
                     value="@Html.ValueFor(model => model.Content)"
                     tabindex="6"
                     class="easyui-textbox"
                     type="text"
                     style="width:100%;height:80px"
                     data-options="prompt:'@Html.DisplayNameFor(model => model.Content)',
     						 required:false,multiline:true ,validType:'length[0,512]'" />
            </div>

            <!--跟进时间-->
            <label class="col-md-2 form-label text-right p-0" for="@Html.IdFor(model => model.FollowDate)"><span class="text-danger">*</span>@Html.DisplayNameFor(model => model.FollowDate)  </label>
            <div class="col-md-4 mb-1">
              <input id="@Html.IdFor(model => model.FollowDate)"
                     name="@Html.NameFor(model => model.FollowDate)"
                     tabindex="5"
                     class="easyui-datebox"
                     type="text"
                     style="width:100%"
                     value="@Html.ValueFor(model => model.FollowDate)"
                     data-options="prompt:'@Html.DisplayNameFor(model => model.FollowDate)',
								 formatter:dateformatter,
                                 required:true " />
            </div>


          </div>
        </fieldset>
      </form>
    </div>
  </div>
</div>
<script type="text/javascript">
  var form_state = 'Added';
  var current_index = -1;
  var customerfollow = {};

  function open_customerfollowdlg(index, row, state) {
    form_state = state;
    current_index = index;
    customerfollow = row;
    $('#customerfollow_form #ContactName').combobox('reload', '/CustomerContacts/GetComboData?customerId=' + row.CustomerId);
    $('#customerfollowdlg').dialog('open');
    if (form_state === 'Added') {
      $('#customerfollowdlg').dialog('setTitle', '新增跟进记录');
    } else {
      $('#customerfollowdlg').dialog('setTitle', '编辑跟进记录');
    }
    $('#customerfollow_form').form('reset');
    $('#customerfollow_form').form('load', customerfollow);
  }
  function confirm_customerfollowform() {
    $customerfollowform = $('#customerfollow_form');
    if ($customerfollowform.form('enableValidation').form('validate')) {
      customerfollow = $customerfollowform.serializeJSON();
      if (form_state === 'Added') {
        const url = '/CustomerFollows/Create';
        $.post(url, { customerfollow: customerfollow }).done(res => {
          $('#customerfollowdlg').dialog('close');
          customerfollow_reloadData();
        });
      } else {
        const url = '/CustomerFollows/Edit';
        $.post(url, { customerfollow: customerfollow }).done(res => {
          $('#customerfollowdlg').dialog('close');
          customerfollow_reloadData();
        });
      }
     
    }
  }
</script>

