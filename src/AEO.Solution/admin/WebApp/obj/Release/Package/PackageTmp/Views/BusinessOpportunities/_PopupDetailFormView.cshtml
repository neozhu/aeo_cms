﻿@model WebApp.Models.BusinessOpportunity
<!-- 弹出编辑窗体表单 -->
<div id="businessopportunitydetailwindow" class="easyui-window"
     title="明细数据"
     data-options="modal:true,
                    closed:true,
                    minimizable:false,
                    collapsible:false,
                    maximized:false,
                    iconCls:'fal fa-window',
                    onBeforeClose:function(){
                      var that = $(this);
                      if(businessopportunityhasmodified()){
                        $.messager.confirm('确认','你确定要放弃保存修改的记录?',function(r){
                        if (r){
                          var opts = that.panel('options');
                          var onBeforeClose = opts.onBeforeClose;
                          opts.onBeforeClose = function(){};
                          that.panel('close');
                          opts.onBeforeClose = onBeforeClose;
                          hook = false;
                        }
                        });
                        return false;
                      }
                    },
                    onOpen:function(){
                       $(this).window('vcenter');
                       $(this).window('hcenter');
                    },
                    onRestore:function(){
                    },
                    onMaximize:function(){
                    }
                    " style="width:800px;height:450px;display:none">
  <!-- toolbar -->
  <div class="panel-content py-2 rounded-bottom border-faded border-left-0 border-right-0  text-muted bg-subtlelight-fade sticky-top">
    <div class="d-flex justify-content-end pr-4">
      <div class="btn-group btn-group-sm mr-1">
        <button name="saveitembutton" class="btn btn-default">
          <i class="fal fa-save"></i> @Html.L("Save")
        </button>
      </div>
      <div class="btn-group btn-group-sm mr-1" id="deleteitem-btn-group">
        <button name="deleteitembutton" class="btn btn-danger">
          <i class="fal fa-trash-alt"></i> @Html.L("Delete")
        </button>
      </div>
    </div>
  </div>
  <!-- panel container form  -->
  <div class="panel-container show">
    <div class="container">
      <div class="panel-content">
        <form id="businessopportunity_form"
              class="easyui-form form-horizontal padding-10"
              method="post"
              data-options="novalidate:true,
                            onChange: function(target){
                              hook = true;
                              $('button[name*=\'saveitembutton\']').prop('disabled', false);
                             },
                             onLoadSuccess:function(data){
                               hook = false;
                               $('button[name*=\'saveitembutton\']').prop('disabled', true);
                             }">
          @Html.AntiForgeryToken()
          <!--Primary Key-->
          @Html.HiddenFor(model => model.Id)
          @Html.HiddenFor(model => model.CustomerCode)
          @Html.HiddenFor(model => model.CustomerName)
          <fieldset class="form-group">
            <div class="row h-100 align-items-center">

              <!--商机名称-->
              <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"><span class="text-danger">*</span> @Html.DisplayNameFor(model => model.Name)</label>
              <div class="col-md-4 mb-1 pl-1">
                <input id="@Html.IdFor(model => model.Name)"
                       name="@Html.NameFor(model => model.Name)"
                       value="@Html.ValueFor(model => model.Name)"
                       tabindex="0" required
                       class="easyui-textbox"
                       style="width:100%"
                       type="text"
                       data-options="prompt:'@Html.DescriptionFor(model => model.Name)',
								 required:true,
                                 validType: 'length[0,128]'
                                 " />
              </div>

              <!--负责人-->
              <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"><span class="text-danger">*</span> @Html.DisplayNameFor(model => model.Owner)</label>
              <div class="col-md-4 mb-1 pl-1">
                <input id="@Html.IdFor(model => model.Owner)"
                       name="@Html.NameFor(model => model.Owner)"
                       value="@Html.ValueFor(model => model.Owner)"
                       tabindex="1" required
                       class="easyui-textbox"
                       style="width:100%"
                       type="text"
                       data-options="prompt:'@Html.DescriptionFor(model => model.Owner)',
								 required:true,
                                 validType: 'length[0,20]'
                                 " />
              </div>


              <!--所属客户-->
              <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"><span class="text-danger">*</span> @Html.DisplayNameFor(model => model.CustomerId)</label>
              <div class="col-md-4 mb-1 pl-1">
                <input id="@Html.IdFor(model => model.CustomerId)"
                       name="@Html.NameFor(model => model.CustomerId)"
                       value="@Html.ValueFor(model => model.CustomerId)"
                       tabindex="2" required
                       class="easyui-combobox"
                       style="width:100%"
                       data-options="prompt:'@Html.DescriptionFor(model => model.CustomerId)' ,
						              required:true ,
						              valueField: 'Id',
						              textField:  'CustomerName' ,
                          panelHeight:'auto',
                          editable:false,
                          method:'get',
						              url: '/Customers/GetComboData' ,
						              onSelect: function(item){
						                $('#businessopportunity_form #CustomerName').val(item.CustomerName)
                            $('#businessopportunity_form #CustomerCode').val(item.CustomerCode)
                            $('#businessopportunity_form #ContactName').combobox('reload','/CustomerContacts/GetComboData?customerId=' + item.Id);
                            $('#businessopportunity_form #ContactName').combobox('setValue',item.ContactName)
				        }">
              </div>

              <!--联系人-->
              <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"><span class="text-danger">*</span> @Html.DisplayNameFor(model => model.ContactName)</label>
              <div class="col-md-4 mb-1 pl-1">
                <input id="@Html.IdFor(model => model.ContactName)"
                       name="@Html.NameFor(model => model.ContactName)"
                       value="@Html.ValueFor(model => model.ContactName)"
                       tabindex="3" required
                       class="easyui-combobox"
                       style="width:100%"
                       type="text"
                       data-options="prompt:'@Html.DescriptionFor(model => model.ContactName)',
								 required:true, validType: 'length[0,80]',textField:'Name',valueField:'Name',
                       panelHeight:'auto'
                                 " />
              </div>


              <!--发现日期-->
              <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"><span class="text-danger">*</span> @Html.DisplayNameFor(model => model.OpDate)</label>
              <div class="col-md-4 mb-1 pl-1">
                <input id="@Html.IdFor(model => model.OpDate)"
                       name="@Html.NameFor(model => model.OpDate)"
                       value="@Html.ValueFor(model => model.OpDate)"
                       tabindex="4" required
                       class="easyui-datebox"
                       style="width:100%"
                       type="text"
                       data-options="prompt:'@Html.DescriptionFor(model => model.OpDate)',
								 required:true,
								 formatter:dateformatter" />
              </div>

              <!--提供人-->
              <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"> @Html.DisplayNameFor(model => model.ProvidePeople)</label>
              <div class="col-md-4 mb-1 pl-1">
                <input id="@Html.IdFor(model => model.ProvidePeople)"
                       name="@Html.NameFor(model => model.ProvidePeople)"
                       value="@Html.ValueFor(model => model.ProvidePeople)"
                       tabindex="5"
                       class="easyui-textbox"
                       style="width:100%"
                       type="text"
                       data-options="prompt:'@Html.DescriptionFor(model => model.ProvidePeople)',
								 required:false,
                                 validType: 'length[0,80]'
                                 " />
              </div>


              <!--机会来源-->
              <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"><span class="text-danger">*</span> @Html.DisplayNameFor(model => model.Source)</label>
              <div class="col-md-4 mb-1 pl-1">
                <input id="@Html.IdFor(model => model.Source)"
                       name="@Html.NameFor(model => model.Source)"
                       value="@Html.ValueFor(model => model.Source)"
                       tabindex="6" required
                       class="easyui-combobox"
                       style="width:100%"
                       type="text"
                       data-options="prompt:'@Html.DescriptionFor(model => model.Source)',
								 required:true,data:sourcedatasource,panelHeight:'auto',
                                 validType: 'length[0,50]'
                                 " />
              </div>

              <!--市场活动-->
              <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"> @Html.DisplayNameFor(model => model.MarketAction)</label>
              <div class="col-md-4 mb-1 pl-1">
                <input id="@Html.IdFor(model => model.MarketAction)"
                       name="@Html.NameFor(model => model.MarketAction)"
                       value="@Html.ValueFor(model => model.MarketAction)"
                       tabindex="7"
                       class="easyui-textbox"
                       style="width:100%"
                       type="text"
                       data-options="prompt:'@Html.DescriptionFor(model => model.MarketAction)',
								 required:false,
                                 validType: 'length[0,128]'
                                 " />
              </div>


              <!--跟进状态-->
              <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"> @Html.DisplayNameFor(model => model.Status)</label>
              <div class="col-md-4 mb-1 pl-1">
                <input id="@Html.IdFor(model => model.Status)"
                       name="@Html.NameFor(model => model.Status)"
                       value="@Html.ValueFor(model => model.Status)"
                       tabindex="8"
                       class="easyui-textbox"
                       style="width:100%"
                       type="text"
                       data-options="prompt:'@Html.DescriptionFor(model => model.Status)',
								 required:false,
                                 validType: 'length[0,50]'
                                 " />
              </div>

              <!--币种-->
              <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"> @Html.DisplayNameFor(model => model.Curr)</label>
              <div class="col-md-4 mb-1 pl-1">
                <input id="@Html.IdFor(model => model.Curr)"
                       name="@Html.NameFor(model => model.Curr)"
                       value="@Html.ValueFor(model => model.Curr)"
                       tabindex="9"
                       class="easyui-textbox"
                       style="width:100%"
                       type="text"
                       data-options="prompt:'@Html.DescriptionFor(model => model.Curr)',
								 required:false,
                                 validType: 'length[0,50]'
                                 " />
              </div>


              <!--预计签单日期-->
              <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"> @Html.DisplayNameFor(model => model.PrDate)</label>
              <div class="col-md-4 mb-1 pl-1">
                <input id="@Html.IdFor(model => model.PrDate)"
                       name="@Html.NameFor(model => model.PrDate)"
                       value="@Html.ValueFor(model => model.PrDate)"
                       tabindex="10"
                       class="easyui-datebox"
                       style="width:100%"
                       type="text"
                       data-options="prompt:'@Html.DescriptionFor(model => model.PrDate)',
								 required:false,
								 formatter:dateformatter" />
              </div>

              <!--预计成交金额-->
              <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"> @Html.DisplayNameFor(model => model.Amount)</label>
              <div class="col-md-4 mb-1 pl-1">
                <input id="@Html.IdFor(model => model.Amount)"
                       name="@Html.NameFor(model => model.Amount)"
                       value="@Html.ValueFor(model => model.Amount)"
                       tabindex="11"
                       class="easyui-numberbox"
                       style="width:100%"
                       type="text"
                       data-options="prompt:'@Html.DescriptionFor(model => model.Amount)',
								 required:false,formatter:numberformatter,
                                 parser:parsernumber,precision:2,

                                 " />

              </div>


              <!--商机内容-->
              <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"> @Html.DisplayNameFor(model => model.Content)</label>
              <div class="col-md-10 mb-1 pl-1">
                <input id="@Html.IdFor(model => model.Content)"
                       name="@Html.NameFor(model => model.Content)"
                       value="@Html.ValueFor(model => model.Content)"
                       tabindex="12"
                       class="easyui-textbox"
                       style="width:100%"
                       type="text"
                       data-options="prompt:'@Html.DescriptionFor(model => model.Content)',
								 required:false,multiline:true,
                                 validType: 'length[0,512]'
                                 " />
              </div>

              <!--当前阶段-->
              <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"> @Html.DisplayNameFor(model => model.Stage)</label>
              <div class="col-md-4 mb-1 pl-1">
                <input id="@Html.IdFor(model => model.Stage)"
                       name="@Html.NameFor(model => model.Stage)"
                       value="@Html.ValueFor(model => model.Stage)"
                       tabindex="13"
                       class="easyui-combobox"
                       style="width:100%"
                       type="text"
                       data-options="prompt:'@Html.DescriptionFor(model => model.Stage)',
								 required:false,data:stagedatasource,panelHeight:'auto',
                                 validType: 'length[0,128]'
                                 " />
              </div>


              <!--更新时间-->
              <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"> @Html.DisplayNameFor(model => model.StageDate)</label>
              <div class="col-md-4 mb-1 pl-1">
                <input id="@Html.IdFor(model => model.StageDate)"
                       name="@Html.NameFor(model => model.StageDate)"
                       value="@Html.ValueFor(model => model.StageDate)"
                       tabindex="14"
                       class="easyui-datebox"
                       style="width:100%"
                       type="text"
                       data-options="prompt:'@Html.DescriptionFor(model => model.StageDate)',
								 required:false,
								 formatter:dateformatter" />
              </div>

              <!--备注-->
              <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"> @Html.DisplayNameFor(model => model.Remark)</label>
              <div class="col-md-4 mb-1 pl-1">
                <input id="@Html.IdFor(model => model.Remark)"
                       name="@Html.NameFor(model => model.Remark)"
                       value="@Html.ValueFor(model => model.Remark)"
                       tabindex="15"
                       class="easyui-textbox"
                       style="width:100%"
                       type="text"
                       data-options="prompt:'@Html.DescriptionFor(model => model.Remark)',
								 required:false,
                                 validType: 'length[0,128]'
                                 " />
              </div>


               

            </div>
          </fieldset>
        </form>
      </div>
    </div>
  </div>
</div>

<!-- 弹出窗体form表单 -->
<!-- 弹出编辑对话框 -->
<!--begin popup detailview javascript block -->
<script type="text/javascript">
  //当初始的 HTML 文档被完全加载和解析完成之后
  document.addEventListener('DOMContentLoaded', function () {
    //绑定按钮事件
    $('button[name="saveitembutton"]').on('click', savebusinessopportunityitem);
    $('button[name="deleteitembutton"]').on('click', deletebusinessopportunityitem);
  });
  //判断新增编辑状态
  var MODELSTATE = 'Added';
  var businessopportunityid = null;
  function openbusinessopportunitydetailwindow(data, state) {
    MODELSTATE = state;
    //判断是否显示功能按钮
    if (MODELSTATE === 'Added') {
      $('#deleteitem-btn-group').hide();
    } else {
      $('#deleteitem-btn-group').show();
    }
    initbusinessopportunitydetailview();
    businessopportunityid = (data.Id || 0);
    $('#businessopportunitydetailwindow').window('open');
    $('#businessopportunity_form').form('reset');
    $('#businessopportunity_form').form('load', data);
  }
  //删除当前记录
  function deletebusinessopportunityitem() {
    $.messager.confirm('确认', '你确定要删除该记录?', result => {
      if (result) {
        const url = `/BusinessOpportunities/Delete/${businessopportunityid}`;
        $.get(url).done(res => {
          if (res.success) {
            toastr.success("删除成功");
            $('#businessopportunitydetailwindow').window('close');
            reloadData();
          } else {
            $.messager.alert('错误', res.err, 'error');
          }
        });
      }
    });
  }
  //async 保存数据
  async function savebusinessopportunityitem() {
    const $businessopportunityform = $('#businessopportunity_form');
    if ($businessopportunityform.form('enableValidation').form('validate')) {
      let businessopportunity = $businessopportunityform.serializeJSON();
      let url = '/BusinessOpportunities/Edit';
      //判断是新增或是修改方法
      if (MODELSTATE === 'Added') {
        url = '/BusinessOpportunities/Create';
      }
      var token = $('input[name="__RequestVerificationToken"]', $businessopportunityform).val();
      $.ajax({
        type: "POST",
        url: url,
        data: {
          __RequestVerificationToken: token,
          businessopportunity: businessopportunity
        },
        dataType: 'json',
        contentType: 'application/x-www-form-urlencoded; charset=utf-8'
      })
        .done(response => {
          if (response.success) {
            hook = false;
            $businessopportunityform.form('disableValidation');
            $('#businessopportunitydetailwindow').window("close");
            toastr.success("保存成功");
            reloadData();
          } else {
            $.messager.alert("错误", response.err, "error");
          }
        })
        .fail((jqXHR, textStatus, errorThrown) => {
          $.messager.alert('异常', `${jqXHR.status}: ${jqXHR.statusText} `, 'error');
        });
    }
  }
  //判断是否有没有保存的记录
  function businessopportunityhasmodified() {
    return hook;

  }


  function initbusinessopportunitydetailview() {
    //回车光标移动到下个输入控件
    //如果是枚举类型需要把numberbox改成combobox
    //预计成交金额
    $('#Amount').numberbox('textbox').bind('keydown', function (e) {
      if (e.keyCode == 13) {
        $(e.target).emulateTab();
      }
    });
    //日期类型 发现日期
    $('#OpDate').datebox('textbox').bind('keydown', function (e) {
      if (e.keyCode == 13) {
        $(e.target).emulateTab();
      }
    });
    //日期类型 预计签单日期
    $('#PrDate').datebox('textbox').bind('keydown', function (e) {
      if (e.keyCode == 13) {
        $(e.target).emulateTab();
      }
    });
    //日期类型 更新时间
    $('#StageDate').datebox('textbox').bind('keydown', function (e) {
      if (e.keyCode == 13) {
        $(e.target).emulateTab();
      }
    });
    //所属客户默认外键使用combobox,也可以使用combogrid
    $('#CustomerId').combobox('textbox').bind('keydown', function (e) {
      if (e.keyCode == 13) {
        $(e.target).emulateTab();
      }
    });
  }
</script>

