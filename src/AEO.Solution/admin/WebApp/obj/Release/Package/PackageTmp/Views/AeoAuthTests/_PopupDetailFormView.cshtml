<!-- aeoquestion datagrid  javascript block -->
@Html.Partial("_AeoQuestionEditForm", new WebApp.Models.AeoQuestion())

<!--begin popup detailview javascript block -->
<script type="text/javascript">
  //当初始的 HTML 文档被完全加载和解析完成之后
  document.addEventListener('DOMContentLoaded', function () {
    //绑定按钮事件
    $('button[name="saveitembutton"]').on('click', saveaeoauthtestitem);
    $('button[name="deleteitembutton"]').on('click', deleteaeoauthtestitem);
    
  });
  //获取公司信息
  function getcompany(id) {
    $.get('/Companies/GetItem/' + id).done(res => {
      //console.log(res);
      $('#aeoauthtest_form #TradeCode').val(res.TradeCode);
      $('#aeoauthtest_form #CreditCode').val(res.CreditCode);
      $('#aeoauthtest_form #Ctype').val(res.Ctype);
    })
  }
  //加载模板
  async function loadquestiontpl(tpl) {
    if (MODELSTATE != 'Added') {
      return
    }
    var bar = new ProgressBar.Line('#progressbarjs', {
      strokeWidth: 1,
      easing: 'easeInOut',
      duration: 1400,
      color: '#51aef6',
      trailColor: '#f6f6f6',
      trailWidth: 1,
      svgStyle: { width: '100%', height: '100%' }
    });
    bar.animate(1.0);
    const res = await $.get('/QuestionTpls/GetTpl?authtype=' + tpl);
    //console.log(res);
    $('#questiontable > tbody').empty();
    if (res && res.length > 0) {
      const category = [...new Set(res.map(item => item.Category))];
     
      category.map(g => {
        //console.log(g)
        var items = res.filter(item => item.Category == g);
        //console.log(items)
        const tr =`<tr>
                  <td colspan="7" class="bg-primary-100">
                    ${g}-${items[0].Description}
                  </td>
                </tr>`
        $('#questiontable > tbody').append(tr);
        items.map(q => {
          const itr = `<tr>
                   <td>${q.Title}</td>
                  <td>${q.Code}</td>
                  <td>${q.Short}</td>
                  <td>${q.StdDescription}</td>
                  <td>${q.Notes}</td>
                  <td>
                    <select  name="score_select" data-id="${q.Id}" required class="form-control form-control-sm" id="score_${q.Id}">
                      <option value="" disabled selected hidden>请选择</option>
                      <option value="0">基本达标</option>
                      <option value="-1">不达标</option>
                      <option value="-2">不适用</option>
                    </select>
                    <div class="invalid-feedback">
                      请评分
                    </div>
                  </td>
                  <td> ${q.Remark||''}</td>
                </tr>`
          $('#questiontable > tbody').append(itr);

        });


      });
    }
     

    bar.destroy();
    $('#questiontable > tbody').on('change', 'select', function () {
      //console.log($(this).val())
      hook = true;
      caltotalscore();
    });
 
  }
  //加载答题记录
  async function loadquestion(id) {
    var bar = new ProgressBar.Line('#progressbarjs', {
      strokeWidth: 1,
      easing: 'easeInOut',
      duration: 1400,
      color: '#51aef6',
      trailColor: '#f6f6f6',
      trailWidth: 1,
      svgStyle: { width: '100%', height: '100%' }
    });

    bar.animate(1.0);
    const res = await $.get('/AeoQuestions/GetQuestions?testId=' + id);
    //console.log(res);
    $('#questiontable > tbody').empty();
    if (res && res.length > 0) {
      const category = [...new Set(res.map(item => item.Category))];

      category.map(g => {
        //console.log(g)
        var items = res.filter(item => item.Category == g);
        //console.log(items)
        const tr = `<tr>
                  <td colspan="7" class="bg-primary-100">
                    ${g}-${items[0].Description}
                  </td>
                </tr>`
        $('#questiontable > tbody').append(tr);
        items.map(q => {
          const itr = `<tr>
                   <td>${q.Title}</td>
                  <td>${q.Code}</td>
                  <td>${q.Short}</td>
                  <td>${q.StdDescription}</td>
                  <td>${q.Notes}</td>
                  <td>
                    <select disabled  name="score_select" data-id="${q.Id}" required class="form-control form-control-sm" id="score_${q.Id}">
                      <option value="0" ${q.Score==0?'selected':''}>基本达标</option>
                      <option value="-1" ${q.Score == -1 ? 'selected' : ''}>不达标</option>
                      <option value="-2" ${q.Score == -2 ? 'selected' : ''}>不适用</option>
                    </select>
                    <div class="invalid-feedback">
                      请评分
                    </div>
                  </td>
                  <td> ${q.Remark || ''}</td>
                </tr>`
          $('#questiontable > tbody').append(itr);

        });


      });
    }


    bar.destroy();
  }
  //汇总计算评分
  function caltotalscore() {
    let total = 0;
    $('select[name="score_select"]').each((index, ele) => {
      total += parseInt(($(ele).val() || 0));

    });
    //console.log(total);
    const score = 100 + total;
    $('#aeoauthtest_form #Score').numberbox('setValue', score);
    const stdscore = parseInt($('#aeoauthtest_form #StdScore').numberbox('getValue'));
    if (score >= stdscore) {
      $('#aeoauthtest_form #Result').textbox('setValue', '合格')
      $('#aeoauthtest_form #Result').textbox('textbox').css('color', '#48a80f');
    } else {
      $('#aeoauthtest_form #Result').textbox('setValue', '不合格')
      $('#aeoauthtest_form #Result').textbox('textbox').css('color', '#d90334');
    }
  }
  //判断新增编辑状态
  var MODELSTATE = 'Added';
  var aeoauthtestid = null;
  function openaeoauthtestdetailwindow(data, state) {
    MODELSTATE = state;
    //判断是否显示功能按钮
    initaeoauthtestdetailview();
    
    $('#aeoauthtestdetailwindow').window('open');
    $('#aeoauthtest_form').form('reset');
    console.log(data)
    $('#aeoauthtest_form').form('load', data);
    if (MODELSTATE == 'Added') {
      $('#aeoauthtest_form').form('enable');
      $('#deleteitem-btn-group').hide();
      $('#saveitembutton-group1').show();
      $('#saveitembutton-group2').show();
      $('#questiontable > tbody').empty();
    } else {
      $('#aeoauthtest_form').form('disable');
      $('#deleteitem-btn-group').show();
      $('#saveitembutton-group1').hide();
      $('#saveitembutton-group2').hide();
      loadquestion(data.Id);
    }
    
  }
  //删除当前记录
  function deleteaeoauthtestitem() {
    $.messager.confirm('确认', '你确定要删除该记录?', result => {
      if (result) {
        const url = `/AeoAuthTests/Delete/${aeoauthtestid}`;
        $.get(url).done(res => {
          if (res.success) {
            toastr.success("删除成功");
            $('#aeoauthtestdetailwindow').window('close');
            reloadData();
          } else {
            $.messager.alert('错误', res.err, 'error');
          }
        });
      }
    });
  }
  //async 保存数据
  async function saveaeoauthtestitem() {
    
    const $aeoauthtestform = $('#aeoauthtest_form');
    if ($aeoauthtestform.form('enableValidation').form('validate')) {
      var form = document.getElementById('aeoauthtest_form');
      form.classList.add("needs-validation")
      var validate = form.reportValidity();
      if (validate == false) {
        form.classList.add("was-validated")
        return;
      } else {
        //form.classList.remove("was-validated")
      }
      let aeoauthtest = $aeoauthtestform.serializeJSON();
      aeoauthtest.Answers = [];
      $('select[name="score_select"]').each((index, ele) => {
        const tplid = $(ele).data("id");
        const score = $(ele).val();
        aeoauthtest.Answers.push({ tplId: tplid, Score: score });
      });
      const url = '/AeoAuthTests/Create';
      var token = $('input[name="__RequestVerificationToken"]', $aeoauthtestform).val();
      $.ajax({
        type: "POST",
        url: url,
        data: {
          __RequestVerificationToken: token,
          aeoauthtest: aeoauthtest
        },
        dataType: 'json',
        contentType: 'application/x-www-form-urlencoded; charset=utf-8'
      })
        .done(response => {
          if (response.success) {
            hook = false;
            $aeoauthtestform.form('disableValidation');
            $('#aeoauthtestdetailwindow').window("close");
            toastr.success("保存成功");
            reloadData();
          } else {
            $.messager.alert("错误", response.err, "error");
          }
        })
        .fail((jqXHR, textStatus, errorThrown) => {
          $.messager.alert('异常', `${jqXHR.status}: ${jqXHR.statusText} `, 'error');
        });
    }
  }
  //判断是否有没有保存的记录
  function aeoauthtesthasmodified() {
    if (MODELSTATE == 'Added') {
      return hook;
    } else {
      return false;
    }

  }


  function initaeoauthtestdetailview() {
     
  }
</script>

