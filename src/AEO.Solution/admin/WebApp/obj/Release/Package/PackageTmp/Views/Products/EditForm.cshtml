      <!--标志位-->
      <div class="col-xs-12 col-sm-6 col-md-4 col-lg-3">
              <label class="form-label"> <span class="text-danger">*</span> @Html.DisplayNameFor(model => model.Flag1)</label>
              <div class="custom-control custom-checkbox">
                 <input id="@Html.IdFor(model => model.Flag1)"
                       name="@Html.NameFor(model => model.Flag1)"
                       value="true" @(Model.Flag1 ? "checked=\"checked\"" : "")
                       class="custom-control-input"
                       tabindex="6"
                       type="checkbox" />
                <label class="custom-control-label" for="@Html.IdFor(model => model.Flag1)">@Html.DisplayNameFor(model => model.Flag1)</label>
            </div>
      </div>

		
      <!--标志位-->
      <div class="col-xs-12 col-sm-6 col-md-4 col-lg-3">
              <label class="form-label"> <span class="text-danger">*</span> @Html.DisplayNameFor(model => model.Flag2)</label>
