@model WebApp.Models.CustomerBank
<div id="customerbankdlg" class="easyui-dialog"
     title="CustomerBank" style="width:600px;height:300px; display:none"
     data-options="
                iconCls: 'fal fa-window',
                modal:true,
                closed:true,
                cache: false,
                resizable:true,
                width:620,
                height:300,
                onOpen:function(){
                   $('#customerbank_form').form('disableValidation');
                },
                buttons: [{
                    text:'确认',
                    handler:function(){
                        confirm_customerbankform();
                    }
                },{
                    text:'取消',
                    handler:function(){
                        $('#customerbankdlg').dialog('close');
                    }
                }]
            ">
<div class="panel-container show">
      <div class="panel-content p-0">
        <form id="customerbank_form" class="form-horizontal needs-validation" novalidate>
          <fieldset class="form-group">
            <div class="row h-100 align-items-center m-0 pt-1">
    <!--系统主键-->
	@Html.HiddenFor(model => model.Id)		
             
    <!--开户名称-->
        <label class="col-md-2 form-label text-right p-0" for="@Html.IdFor(model => model.AccountName)" >@Html.DisplayNameFor(model => model.AccountName) <span class="text-danger">*</span></label>
<div class="col-md-4 mb-1">
		<input id="@Html.IdFor(model => model.AccountName)" 
							name="@Html.NameFor(model => model.AccountName)" 
							value="@Html.ValueFor(model => model.AccountName)"
							tabindex="1" 
			     			class="easyui-textbox" 
							type="text" 
                            style="width:100%"
							data-options="prompt:'@Html.DisplayNameFor(model => model.AccountName)',
     						 required:true ,validType:'length[0,100]'" />
    </div>
             
    <!--银行名称-->
        <label class="col-md-2 form-label text-right p-0" for="@Html.IdFor(model => model.Bank)" >@Html.DisplayNameFor(model => model.Bank) </label>
<div class="col-md-4 mb-1">
		<input id="@Html.IdFor(model => model.Bank)" 
							name="@Html.NameFor(model => model.Bank)" 
							value="@Html.ValueFor(model => model.Bank)"
							tabindex="2" 
			     			class="easyui-textbox" 
							type="text" 
                            style="width:100%"
							data-options="prompt:'@Html.DisplayNameFor(model => model.Bank)',
     						 required:false ,validType:'length[0,100]'" />
    </div>
             
    <!--银行账号-->
        <label class="col-md-2 form-label text-right p-0" for="@Html.IdFor(model => model.AccountNo)" >@Html.DisplayNameFor(model => model.AccountNo) <span class="text-danger">*</span></label>
<div class="col-md-4 mb-1">
		<input id="@Html.IdFor(model => model.AccountNo)" 
							name="@Html.NameFor(model => model.AccountNo)" 
							value="@Html.ValueFor(model => model.AccountNo)"
							tabindex="3" 
			     			class="easyui-textbox" 
							type="text" 
                            style="width:100%"
							data-options="prompt:'@Html.DisplayNameFor(model => model.AccountNo)',
     						 required:true ,validType:'length[0,100]'" />
    </div>
             
    <!--账户用途-->
        <label class="col-md-2 form-label text-right p-0" for="@Html.IdFor(model => model.BankUse)" >@Html.DisplayNameFor(model => model.BankUse) </label>
<div class="col-md-4 mb-1">
		<input id="@Html.IdFor(model => model.BankUse)" 
							name="@Html.NameFor(model => model.BankUse)" 
							value="@Html.ValueFor(model => model.BankUse)"
							tabindex="4" 
			     			class="easyui-textbox" 
							type="text" 
                            style="width:100%"
							data-options="prompt:'@Html.DisplayNameFor(model => model.BankUse)',
     						 required:false ,validType:'length[0,100]'" />
    </div>
             
    <!--SWIFT号-->
        <label class="col-md-2 form-label text-right p-0" for="@Html.IdFor(model => model.SWIFT)" >@Html.DisplayNameFor(model => model.SWIFT) </label>
<div class="col-md-4 mb-1">
		<input id="@Html.IdFor(model => model.SWIFT)" 
							name="@Html.NameFor(model => model.SWIFT)" 
							value="@Html.ValueFor(model => model.SWIFT)"
							tabindex="5" 
			     			class="easyui-textbox" 
							type="text" 
                            style="width:100%"
							data-options="prompt:'@Html.DisplayNameFor(model => model.SWIFT)',
     						 required:false ,validType:'length[0,50]'" />
    </div>
             
    <!--币值-->
        <label class="col-md-2 form-label text-right p-0" for="@Html.IdFor(model => model.CUR)" >@Html.DisplayNameFor(model => model.CUR) </label>
<div class="col-md-4 mb-1">
		<input id="@Html.IdFor(model => model.CUR)" 
							name="@Html.NameFor(model => model.CUR)" 
							value="@Html.ValueFor(model => model.CUR)"
							tabindex="6" 
			     			class="easyui-textbox" 
							type="text" 
                            style="width:100%"
							data-options="prompt:'@Html.DisplayNameFor(model => model.CUR)',
     						 required:false ,validType:'length[0,10]'" />
    </div>
             
    <!--备注说明-->
        <label class="col-md-2 form-label text-right p-0" for="@Html.IdFor(model => model.Remark)" >@Html.DisplayNameFor(model => model.Remark) </label>
<div class="col-md-4 mb-1">
		<input id="@Html.IdFor(model => model.Remark)" 
							name="@Html.NameFor(model => model.Remark)" 
							value="@Html.ValueFor(model => model.Remark)"
							tabindex="7" 
			     			class="easyui-textbox" 
							type="text" 
                            style="width:100%"
							data-options="prompt:'@Html.DisplayNameFor(model => model.Remark)',
     						 required:false ,validType:'length[0,512]'" />
    </div>
             
      <!--所属客户-->
      <input type="hidden" id="CustomerCustomerCode" name="CustomerCustomerCode" value="">
	  <input id="@Html.IdFor(model => model.CustomerId)"
			       name="@Html.NameFor(model => model.CustomerId)"
				   value="@Html.ValueFor(model => model.CustomerId)"
                   type="hidden" />
             
    <!--客户编号(保存时系统自动分配也可以手工选择)-->
        <label class="col-md-2 form-label text-right p-0" for="@Html.IdFor(model => model.CustomerCode)" >@Html.DisplayNameFor(model => model.CustomerCode) </label>
<div class="col-md-4 mb-1">
		<input id="@Html.IdFor(model => model.CustomerCode)" 
							name="@Html.NameFor(model => model.CustomerCode)" 
							value="@Html.ValueFor(model => model.CustomerCode)"
							tabindex="9" 
			     			class="easyui-textbox" 
							type="text" 
                            style="width:100%"
							data-options="prompt:'@Html.DisplayNameFor(model => model.CustomerCode)',
     						 required:false ,validType:'length[0,20]'" />
    </div>
             
    <!--单位名称-->
        <label class="col-md-2 form-label text-right p-0" for="@Html.IdFor(model => model.CustomerName)" >@Html.DisplayNameFor(model => model.CustomerName) <span class="text-danger">*</span></label>
<div class="col-md-4 mb-1">
		<input id="@Html.IdFor(model => model.CustomerName)" 
							name="@Html.NameFor(model => model.CustomerName)" 
							value="@Html.ValueFor(model => model.CustomerName)"
							tabindex="10" 
			     			class="easyui-textbox" 
							type="text" 
                            style="width:100%"
							data-options="prompt:'@Html.DisplayNameFor(model => model.CustomerName)',
     						 required:true ,validType:'length[0,80]'" />
    </div>
             
  
           </div>
       </fieldset>
    </form>
  </div>
</div>
</div>
<script type="text/javascript">
     var form_state = 'Added';
     var current_index = -1;
     var customerbank = {};
 
     function open_customerbankdlg(index, row, state) {
         form_state = state;
         current_index = index;
         customerbank = row;
         $('#customerbankdlg').dialog('open');
         if (form_state === 'Added') {
             $('#customerbankdlg').dialog('setTitle', '新增明细');
         } else {
             $('#customerbankdlg').dialog('setTitle', '修改明细');
         }
         $('#customerbank_form').form('reset');
         $('#customerbank_form').form('load', customerbank);
     }
     function confirm_customerbankform() {
         $customerbankform = $('#customerbank_form');
         if ($customerbankform.form('enableValidation').form('validate')) {
             customerbank = $customerbankform.serializeJSON();
             if (form_state === 'Added') {
                 $(document).trigger('customerbank_form.add', [current_index, customerbank])
             } else {
                 $(document).trigger('customerbank_form.edit', [current_index, customerbank])
             }
             $('#customerbankdlg').dialog('close');
         }
     }
 </script>

 