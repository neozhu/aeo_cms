@model WebApp.Models.ProductPurchaseHistoricalPrice
<script type="text/javascript">
    //是否开启行内编辑
    var SUBEDITINLINE = true;
   //初始化 ProductPurchaseHistoricalPrice datagrid
   var $productpurchasehistoricalpricedg = $('#productpurchasehistoricalprice_datagrid');
   //当前行记录
   var productpurchasehistoricalprice = {};
   //datagrid CRUD method
    var productpurchasehistoricalprice_editIndex = undefined;
    //取消编辑恢复状态
    function productpurchasehistoricalprice_rejectChanges() {
		$productpurchasehistoricalpricedg.datagrid('rejectChanges');
		productpurchasehistoricalprice_editIndex = undefined;
    }
    //重新加载数据
    function productpurchasehistoricalprice_reloadData() {
			$productpurchasehistoricalpricedg.datagrid('unselectAll');
            $productpurchasehistoricalpricedg.datagrid('uncheckAll');
	        $productpurchasehistoricalpricedg.datagrid('reload');
	}
    //关闭编辑状态
	function productpurchasehistoricalprice_endEditing() {
			if (productpurchasehistoricalprice_editIndex === undefined) {
                return true; 
            }
			if ($productpurchasehistoricalpricedg.datagrid('validateRow', productpurchasehistoricalprice_editIndex)) {
				$productpurchasehistoricalpricedg.datagrid('endEdit', productpurchasehistoricalprice_editIndex);
				productpurchasehistoricalprice_editIndex = undefined;
                return true;
			} else {
				const invalidinput = $('input.validatebox-invalid',$productpurchasehistoricalpricedg.datagrid('getPanel'));
                const fieldnames = invalidinput.map((index, item) => {
                  return $(item).attr('placeholder') || $(item).attr('id');
                });
                $.messager.alert('提示', `${Array.from(fieldnames)} 输入有误.`, 'error');
				return false;
			}
		}
    //单击列开启编辑功能
	function productpurchasehistoricalprice_onClickCell(index, field) {
			const _operates = ['_operate1', 'ck'];
             $('button[name*=\'productpurchasehistoricalpricedeletebutton\']').prop('disabled', false);
			if (!SUBEDITINLINE || $.inArray(field, _operates) >= 0) {
				return false;
			}
			if (productpurchasehistoricalprice_editIndex !== index) {
				if (productpurchasehistoricalprice_endEditing()) {
					$productpurchasehistoricalpricedg.datagrid('selectRow', index)
							.datagrid('beginEdit', index);
                    //productpurchasehistoricalprice_editIndex = index;
					var ed = $productpurchasehistoricalpricedg.datagrid('getEditor', { index: index, field: field });
					if (ed) {
						($(ed.target).data('textbox') ? $(ed.target).textbox('textbox') : $(ed.target)).focus();
					}
				} else {
					$productpurchasehistoricalpricedg.datagrid('selectRow', productpurchasehistoricalprice_editIndex);
				}
			}
		}
    //双击弹出编辑当前行对话框
    function productpurchasehistoricalprice_onDblClickRow(index, row) {
        if (!SUBEDITINLINE) {
            open_productpurchasehistoricalpricedlg(index, row, 'Modified');
        }
    }
    //订阅对话框新增返回事件
    $(document).on('productpurchasehistoricalprice_form.add', (e, index,item) => {
        $productpurchasehistoricalpricedg.datagrid("insertRow",
            {
                index: 0,
                row: item
            });
    });
    //订阅对话框修改返回事件
    $(document).on('productpurchasehistoricalprice_form.edit', (e,index, item) => {
        $productpurchasehistoricalpricedg.datagrid('updateRow', {
            index: index,
            row: item
        });
    });
    //新增记录
    function productpurchasehistoricalprice_appendItem() {
       const $productform = $('#product_form');
       if ($productform.form('enableValidation').form('validate')) {
          const product = $productform.serializeJSON();
       const item = {
          QuoteDate: moment().format('YYYY-MM-DD HH:mm:ss'), 
CUR: 'CNY', 
Source: '手工录入', 

          ProductId:product.Id
        };
      if (!SUBEDITINLINE) {
        open_productpurchasehistoricalpricedlg(0, item, 'Added');
      } else {
			if (productpurchasehistoricalprice_endEditing()) {
				//对必填字段进行默认值初始化
				$productpurchasehistoricalpricedg.datagrid('insertRow', 
                               { index: 0,
                                  row: item 
                               });
				productpurchasehistoricalprice_editIndex = 0;
				$productpurchasehistoricalpricedg.datagrid('selectRow', productpurchasehistoricalprice_editIndex)
						.datagrid('beginEdit', productpurchasehistoricalprice_editIndex);
			}
        }
        }
	 }
    //删除编辑的行
	function productpurchasehistoricalprice_removeItem() {
		if (productpurchasehistoricalprice_editIndex !== undefined) {  
            const delindex = orderdetail_editIndex;
			$productpurchasehistoricalpricedg.datagrid('cancelEdit', delindex)
					           .datagrid('deleteRow', delindex);
            $("button[name*='productpurchasehistoricalprice_cancelbutton']").prop('disabled', false);
            $("button[name*='productpurchasehistoricalprice_savebutton']").prop('disabled', false);
        } else {
           const rows = $productpurchasehistoricalpricedg.datagrid('getChecked');
           rows.slice().reverse().forEach(row => {
                const rowindex = $productpurchasehistoricalpricedg.datagrid('getRowIndex', row);
                $productpurchasehistoricalpricedg.datagrid('deleteRow', rowindex);
                $("button[name*='productpurchasehistoricalprice_cancelbutton']").prop('disabled', false);
                $("button[name*='productpurchasehistoricalprice_savebutton']").prop('disabled', false);
            });
        }
	}
    //删除选中的行
    function productpurchasehistoricalprice_deleteChecked() {
            const rows = $productpurchasehistoricalpricedg.datagrid('getChecked');
            if (rows.length > 0) {
                var id = rows.filter(item=>item.Id!=null).map(item => {
                    return item.Id;
                });
                $.messager.confirm('确认', `你确定要删除这 <span class='badge bg-color-red'>${id.length}</span> 行记录?`,result => {
                    if (result) {
                        $.post('/ProductPurchaseHistoricalPrices/DeleteChecked', { id: id })
                         .done(response => {
                            if (response.success) {
                                $productpurchasehistoricalpricedg.datagrid('reload');
                            } else {
                                $.messager.alert('错误', response.err,'error');
                            }
                         });
                    }
                });  
            } else {
                $.messager.alert('提示', '请先选择要删除的记录!','question');
            }
      }
  //获取修改的行
  function productpurchasehistoricalprice_getChanges() {
    if (productpurchasehistoricalprice_endEditing()) {
      if ($productpurchasehistoricalpricedg.datagrid('getChanges').length > 0) {
        const inserted = $productpurchasehistoricalpricedg.datagrid('getChanges', 'inserted').map(item => {
          item.TrackingState = 1;
          return item;
        });
        const deleted = $productpurchasehistoricalpricedg.datagrid('getChanges', 'deleted').map(item => {
          item.TrackingState = 3;
          return item;
        });
        const updated = $productpurchasehistoricalpricedg.datagrid('getChanges', 'updated').map(item => {
          item.TrackingState = 2;
          return item;
        });
        //过滤已删除的重复项
        const changed = inserted.concat(updated.filter(item => {
          return !deleted.includes(item);
        })).concat(deleted);
        return { success: true, changed };
      } else {
        return { success: true, changed:undefined};
      }
    } else {
      return { success: false,changed:undefined };
    }
  }
  //提交修改的数据
  //function productpurchasehistoricalprice_acceptChanges() {
  //  $productpurchasehistoricalpricedg.datagrid('acceptChanges');
  //}
  //提交保存后台数据库
  async function productpurchasehistoricalprice_acceptChanges() {
			if (productpurchasehistoricalprice_endEditing()) {
				if ($productpurchasehistoricalpricedg.datagrid('getChanges').length > 0) {
					const inserted = $productpurchasehistoricalpricedg.datagrid('getChanges', 'inserted').map(item => {
                       item.TrackingState = 1;
                       return item;
                    });
					const deleted = $productpurchasehistoricalpricedg.datagrid('getChanges', 'deleted').map(item => {
                       item.TrackingState = 3;
                       return item;
                    });
					const updated = $productpurchasehistoricalpricedg.datagrid('getChanges', 'updated').map(item => {
                       item.TrackingState = 2;
                       return item;
                    });
					//过滤已删除的重复项
                    const changed = inserted.concat(updated.filter(item => {
                           return !deleted.includes(item);
                         })).concat(deleted);
                   //console.table(changed);
				  if (MODELSTATE === 'Added') {
                    return { success:true, changed };
                  } else {
                    const response = await $.post('/ProductPurchaseHistoricalPrices/SaveData', {productpurchasehistoricalprices:changed});
                    response.changed = undefined;
    				if (response.success) {
							toastr.success('保存明细成功'); 
							$productpurchasehistoricalpricedg.datagrid('acceptChanges');
							productpurchasehistoricalprice_reloadData()
                            return { success:true}; 
				    } else {
                           $.messager.alert('错误', response.err ,'error');
                           return { success:false, err:response.err };
                    }
                   }
				} else {
                  return { success: true, changed: undefined};
                }
			} else {
               return { success: false };
            }
      }


