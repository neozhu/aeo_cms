﻿@model WebApp.Models.OpportunityStage
<!-- 弹出编辑窗体表单 -->
 <div id="opportunitystagedetailwindow" class="easyui-window" 
      title="明细数据" 
      data-options="modal:true,
                    closed:true,
                    minimizable:false,
                    collapsible:false,
                    maximized:false,
                    iconCls:'fal fa-window',
                    onBeforeClose:function(){
                      var that = $(this);
                      if(opportunitystagehasmodified()){
                        $.messager.confirm('确认','你确定要放弃保存修改的记录?',function(r){
                        if (r){
                          var opts = that.panel('options');
                          var onBeforeClose = opts.onBeforeClose;
                          opts.onBeforeClose = function(){};
                          that.panel('close');
                          opts.onBeforeClose = onBeforeClose;
                          hook = false;
                        }
                        });
                        return false;
                      }
                    },
                    onOpen:function(){
                       $(this).window('vcenter');
                       $(this).window('hcenter');
                    },
                    onRestore:function(){
                    },
                    onMaximize:function(){
                    }
                    " style="width:800px;height:450px;display:none">
  <!-- toolbar -->
  <div class="panel-content py-2 rounded-bottom border-faded border-left-0 border-right-0  text-muted bg-subtlelight-fade sticky-top">
  <div class="d-flex justify-content-end pr-4">
        <div class="btn-group btn-group-sm mr-1">
          <button name="saveitembutton"   class="btn btn-default">
            <i class="fal fa-save"></i> @Html.L("Save")
          </button>
        </div>
        <div class="btn-group btn-group-sm mr-1" id="deleteitem-btn-group">
          <button  name="deleteitembutton" class="btn btn-danger">
            <i class="fal fa-trash-alt"></i> @Html.L("Delete")
          </button>
        </div>
    </div>
  </div>
 <!-- panel container form  -->
 <div class="panel-container show">
   <div class="container">
    <div class="panel-content">
           <form id="opportunitystage_form" 
              class="easyui-form form-horizontal padding-10" 
              method="post" 
              data-options="novalidate:true,
                            onChange: function(target){
                              hook = true;
                              $('button[name*=\'saveitembutton\']').prop('disabled', false);
                             },
                             onLoadSuccess:function(data){
                               hook = false;
                               $('button[name*=\'saveitembutton\']').prop('disabled', true);
                             }">
  @Html.AntiForgeryToken()
   <!--Primary Key-->
  @Html.HiddenFor(model=>model.Id)
   <fieldset class="form-group">
   <div class="row h-100 align-items-center">

   <!--阶段-->
        <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"> @Html.DisplayNameFor(model => model.Stage)</label>
		<div class="col-md-4 mb-1 pl-1">  
			<input id="@Html.IdFor(model => model.Stage)" 
				   name="@Html.NameFor(model => model.Stage)" 
				   value="@Html.ValueFor(model => model.Stage)"
				   tabindex="0" 
				   class="easyui-textbox" 
                   style="width:100%"
				   type="text" 
				   data-options="prompt:'@Html.DescriptionFor(model => model.Stage)',
								 required:false, 
                                 validType: 'length[0,128]'
                                 " />
       </div>
				   
   <!--成功率-->
       <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"><span class="text-danger">*</span> @Html.DisplayNameFor(model => model.SuccessRate)</label>
	   <div class="col-md-4 mb-1 pl-1">  
             <input id="@Html.IdFor(model => model.SuccessRate)"
				   name="@Html.NameFor(model => model.SuccessRate)" 
				   value="@Html.ValueFor(model => model.SuccessRate)"
				   tabindex="1" 
				   class="easyui-numberbox" 
                   style="width:100%"
				   type="text" 
				   data-options="prompt:'@Html.DescriptionFor(model => model.SuccessRate)',
								 required:true,formatter:numberformatter,
                                 parser:parsernumber,precision:2,
                                 
                                 "  />

        </div>
				   

   <!--确认时间-->
        <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"><span class="text-danger">*</span> @Html.DisplayNameFor(model => model.ConfirmDate)</label>
		<div class="col-md-4 mb-1 pl-1">  
                <input id="@Html.IdFor(model => model.ConfirmDate)" 
			       name="@Html.NameFor(model => model.ConfirmDate)"
                   value="@Html.ValueFor(model => model.ConfirmDate)"
           		   tabindex="2"  required
				   class="easyui-datebox" 
                   style="width:100%"
				   type="text" 
				   data-options="prompt:'@Html.DescriptionFor(model => model.ConfirmDate)',
								 required:true,
								 formatter:dateformatter" />
     </div>
				   
   <!--备注-->
        <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"> @Html.DisplayNameFor(model => model.Remark)</label>
		<div class="col-md-4 mb-1 pl-1">  
			<input id="@Html.IdFor(model => model.Remark)" 
				   name="@Html.NameFor(model => model.Remark)" 
				   value="@Html.ValueFor(model => model.Remark)"
				   tabindex="3" 
				   class="easyui-textbox" 
                   style="width:100%"
				   type="text" 
				   data-options="prompt:'@Html.DescriptionFor(model => model.Remark)',
								 required:false, 
                                 validType: 'length[0,128]'
                                 " />
       </div>
				   

    <!--商机-->
        <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"><span class="text-danger">*</span> @Html.DisplayNameFor(model => model.BusinessOpportunityId)</label>
		<div class="col-md-4 mb-1 pl-1">   	
            <input id="@Html.IdFor(model => model.BusinessOpportunityId)"
			       name="@Html.NameFor(model => model.BusinessOpportunityId)"
				   value="@Html.ValueFor(model => model.BusinessOpportunityId)"
                   tabindex="4" required
              	   class="easyui-combobox"      
                   style="width:100%"
                   data-options="prompt:'@Html.DescriptionFor(model => model.BusinessOpportunityId)' ,
						required:true ,
						valueField: 'Id',
						textField:  'Name' ,
                        panelHeight:'auto',
                        editable:false,
						url: '/OpportunityStages/GetBusinessOpportunities' ,
						onSelect: function(item){
						  //console.log(item);
				        }">
       </div>
	   
	    </div> 
      </fieldset>
   </form>
    </div>
    </div>
    </div>
</div>

<!-- 弹出窗体form表单 -->
<!-- 弹出编辑对话框 -->

<!--begin popup detailview javascript block -->
<script type="text/javascript">
 //当初始的 HTML 文档被完全加载和解析完成之后
 document.addEventListener('DOMContentLoaded', function () {
     //绑定按钮事件
    $('button[name="saveitembutton"]').on('click', saveopportunitystageitem);
    $('button[name="deleteitembutton"]').on('click', deleteopportunitystageitem);
  });
    //判断新增编辑状态
    var MODELSTATE = 'Added';
    var opportunitystageid = null;
    function openopportunitystagedetailwindow(data,state) {
         MODELSTATE = state;
         //判断是否显示功能按钮
        if (MODELSTATE === 'Added') {
          $('#deleteitem-btn-group').hide();
        } else {
          $('#deleteitem-btn-group').show();
        }
        initopportunitystagedetailview();
         opportunitystageid = (data.Id || 0);
         $('#opportunitystagedetailwindow').window('open');
         $('#opportunitystage_form').form('reset');
         $('#opportunitystage_form').form('load', data);
             }
  //删除当前记录
  function deleteopportunitystageitem() {
    $.messager.confirm('确认', '你确定要删除该记录?', result => {
      if (result) {
        const url = `/OpportunityStages/Delete/${opportunitystageid}`;
        $.get(url).done(res => {
          if (res.success) {
            toastr.success("删除成功");
            $('#opportunitystagedetailwindow').window('close');
            reloadData();
          } else {
            $.messager.alert('错误', res.err, 'error');
          }
        });
      }
    });
  }
    //async 保存数据
    async function saveopportunitystageitem() { 
      const $opportunitystageform = $('#opportunitystage_form');
      if ($opportunitystageform.form('enableValidation').form('validate')) {
            let opportunitystage = $opportunitystageform.serializeJSON();
            let url = '/OpportunityStages/Edit';
            //判断是新增或是修改方法
            if (MODELSTATE === 'Added') {
                url = '/OpportunityStages/Create';
            }
            var token = $('input[name="__RequestVerificationToken"]', $opportunitystageform).val();
            $.ajax({
                    type: "POST",
                    url: url,
                    data: {
                        __RequestVerificationToken: token,
                        opportunitystage:opportunitystage
                    },
                    dataType: 'json',
                    contentType: 'application/x-www-form-urlencoded; charset=utf-8'
                })
                .done(response => {
                    if (response.success) {
                        hook = false;
                        $opportunitystageform.form('disableValidation');
                        $('#opportunitystagedetailwindow').window("close");
                        toastr.success("保存成功"); 
                        reloadData();
                    } else {
                        $.messager.alert("错误",   response.err, "error");
                    }
                    })
                .fail((jqXHR, textStatus, errorThrown) => {
                       $.messager.alert('异常', `${jqXHR.status}: ${jqXHR.statusText} `, 'error');
                    });
        }
    }
     //判断是否有没有保存的记录
     function opportunitystagehasmodified() {
            return hook;

     }


function initopportunitystagedetailview() {
//回车光标移动到下个输入控件
    //如果是枚举类型需要把numberbox改成combobox
    //成功率
	$('#SuccessRate').numberbox('textbox').bind('keydown', function (e) {
      if (e.keyCode == 13) {
        $(e.target).emulateTab();
      }
    });
    //日期类型 确认时间
	$('#ConfirmDate').datebox('textbox').bind('keydown', function (e) {
      if (e.keyCode == 13) {
        $(e.target).emulateTab();
      }
    });
    //商机默认外键使用combobox,也可以使用combogrid
	$('#BusinessOpportunityId').combobox('textbox').bind('keydown', function (e) {
      if (e.keyCode == 13) {
        $(e.target).emulateTab();
      }
    });
}
</script>

