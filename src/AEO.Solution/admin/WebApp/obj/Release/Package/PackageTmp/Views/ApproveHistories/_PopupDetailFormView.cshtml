﻿@model WebApp.Models.ApproveHistory
<!-- 弹出编辑窗体表单 -->
 <div id="approvehistorydetailwindow" class="easyui-window" 
      title="编辑审批历史记录" 
      data-options="modal:true,
                    closed:true,
                    minimizable:false,
                    collapsible:false,
                    maximized:false,
                    iconCls:'fal fa-window',
                    onBeforeClose:function(){
                      var that = $(this);
                      if(approvehistoryhasmodified()){
                        $.messager.confirm('确认','你确定要放弃保存修改的记录?',function(r){
                        if (r){
                          var opts = that.panel('options');
                          var onBeforeClose = opts.onBeforeClose;
                          opts.onBeforeClose = function(){};
                          that.panel('close');
                          opts.onBeforeClose = onBeforeClose;
                          hook = false;
                        }
                        });
                        return false;
                      }
                    },
                    onOpen:function(){
                       $(this).window('vcenter');
                       $(this).window('hcenter');
                    },
                    onRestore:function(){
                    },
                    onMaximize:function(){
                    }
                    " style="width:800px;height:450px;display:none">
  <!-- toolbar -->
  <div class="panel-content py-2 rounded-bottom border-faded border-left-0 border-right-0  text-muted bg-subtlelight-fade sticky-top">
  <div class="d-flex justify-content-end pr-4">
        <div class="btn-group btn-group-sm mr-1">
          <button name="saveitembutton"   class="btn btn-default">
            <i class="fal fa-save"></i> @Html.L("Save")
          </button>
        </div>
        <div class="btn-group btn-group-sm mr-1" id="deleteitem-btn-group">
          <button  name="deleteitembutton" class="btn btn-danger">
            <i class="fal fa-trash-alt"></i> @Html.L("Delete")
          </button>
        </div>
    </div>
  </div>
 <!-- panel container form  -->
 <div class="panel-container show">
   <div class="container">
    <div class="panel-content">
           <form id="approvehistory_form" 
              class="easyui-form form-horizontal padding-10" 
              method="post" 
              data-options="novalidate:true,
                            onChange: function(target){
                              hook = true;
                              $('button[name*=\'saveitembutton\']').prop('disabled', false);
                             },
                             onLoadSuccess:function(data){
                               hook = false;
                               $('button[name*=\'saveitembutton\']').prop('disabled', true);
                             }">
  @Html.AntiForgeryToken()
   <!--Primary Key-->
  @Html.HiddenFor(model=>model.Id)
   <fieldset class="form-group">
   <div class="row h-100 align-items-center">

   <!--关联ID-->
       <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"> @Html.DisplayNameFor(model => model.RefId)</label>
	   <div class="col-md-4 mb-1 pl-1">  
			<input id="@Html.IdFor(model => model.RefId)"
				   name="@Html.NameFor(model => model.RefId)" 
				   value="@Html.ValueFor(model => model.RefId)"
				   tabindex="0" 
				   class="easyui-numberbox" 
                   style="width:100%"
				   type="text" 
				   data-options="prompt:'@Html.DescriptionFor(model => model.RefId)',
								 required:false,formatter:intformatter,
                                 parser:parsernumber,
                                 " />
      </div>
				   
   <!--关联单号-->
        <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"> @Html.DisplayNameFor(model => model.RekKey)</label>
		<div class="col-md-4 mb-1 pl-1">  
			<input id="@Html.IdFor(model => model.RekKey)" 
				   name="@Html.NameFor(model => model.RekKey)" 
				   value="@Html.ValueFor(model => model.RekKey)"
				   tabindex="1" 
				   class="easyui-textbox" 
                   style="width:100%"
				   type="text" 
				   data-options="prompt:'@Html.DescriptionFor(model => model.RekKey)',
								 required:false, 
                                 validType: 'length[0,128]'
                                 " />
       </div>
				   

   <!--状态-->
        <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"> @Html.DisplayNameFor(model => model.Status)</label>
		<div class="col-md-4 mb-1 pl-1">  
			<input id="@Html.IdFor(model => model.Status)" 
				   name="@Html.NameFor(model => model.Status)" 
				   value="@Html.ValueFor(model => model.Status)"
				   tabindex="2" 
				   class="easyui-textbox" 
                   style="width:100%"
				   type="text" 
				   data-options="prompt:'@Html.DescriptionFor(model => model.Status)',
								 required:false, 
                                 validType: 'length[0,32]'
                                 " />
       </div>
				   
   <!--发起人-->
        <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"> @Html.DisplayNameFor(model => model.Initiator)</label>
		<div class="col-md-4 mb-1 pl-1">  
			<input id="@Html.IdFor(model => model.Initiator)" 
				   name="@Html.NameFor(model => model.Initiator)" 
				   value="@Html.ValueFor(model => model.Initiator)"
				   tabindex="3" 
				   class="easyui-textbox" 
                   style="width:100%"
				   type="text" 
				   data-options="prompt:'@Html.DescriptionFor(model => model.Initiator)',
								 required:false, 
                                 validType: 'length[0,32]'
                                 " />
       </div>
				   

   <!--提交时间-->
        <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"> @Html.DisplayNameFor(model => model.SubmitDate)</label>
		<div class="col-md-4 mb-1 pl-1">  
                <input id="@Html.IdFor(model => model.SubmitDate)" 
			       name="@Html.NameFor(model => model.SubmitDate)"
                   value="@Html.ValueFor(model => model.SubmitDate)"
           		   tabindex="4"  
				   class="easyui-datebox" 
                   style="width:100%"
				   type="text" 
				   data-options="prompt:'@Html.DescriptionFor(model => model.SubmitDate)',
								 required:false,
								 formatter:dateformatter" />
     </div>
				   
   <!--待审人-->
        <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"> @Html.DisplayNameFor(model => model.ToAuditor)</label>
		<div class="col-md-4 mb-1 pl-1">  
			<input id="@Html.IdFor(model => model.ToAuditor)" 
				   name="@Html.NameFor(model => model.ToAuditor)" 
				   value="@Html.ValueFor(model => model.ToAuditor)"
				   tabindex="5" 
				   class="easyui-textbox" 
                   style="width:100%"
				   type="text" 
				   data-options="prompt:'@Html.DescriptionFor(model => model.ToAuditor)',
								 required:false, 
                                 validType: 'length[0,32]'
                                 " />
       </div>
				   

   <!--审批人-->
        <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"> @Html.DisplayNameFor(model => model.Approver)</label>
		<div class="col-md-4 mb-1 pl-1">  
			<input id="@Html.IdFor(model => model.Approver)" 
				   name="@Html.NameFor(model => model.Approver)" 
				   value="@Html.ValueFor(model => model.Approver)"
				   tabindex="6" 
				   class="easyui-textbox" 
                   style="width:100%"
				   type="text" 
				   data-options="prompt:'@Html.DescriptionFor(model => model.Approver)',
								 required:false, 
                                 validType: 'length[0,32]'
                                 " />
       </div>
				   
   <!--审批时间-->
        <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"> @Html.DisplayNameFor(model => model.ApprovedDate)</label>
		<div class="col-md-4 mb-1 pl-1">  
                <input id="@Html.IdFor(model => model.ApprovedDate)" 
			       name="@Html.NameFor(model => model.ApprovedDate)"
                   value="@Html.ValueFor(model => model.ApprovedDate)"
           		   tabindex="7"  
				   class="easyui-datebox" 
                   style="width:100%"
				   type="text" 
				   data-options="prompt:'@Html.DescriptionFor(model => model.ApprovedDate)',
								 required:false,
								 formatter:dateformatter" />
     </div>
				   

   <!--审批意见-->
        <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"> @Html.DisplayNameFor(model => model.Result)</label>
		<div class="col-md-4 mb-1 pl-1">  
			<input id="@Html.IdFor(model => model.Result)" 
				   name="@Html.NameFor(model => model.Result)" 
				   value="@Html.ValueFor(model => model.Result)"
				   tabindex="8" 
				   class="easyui-textbox" 
                   style="width:100%"
				   type="text" 
				   data-options="prompt:'@Html.DescriptionFor(model => model.Result)',
								 required:false, 
                                 validType: 'length[0,512]'
                                 " />
       </div>
				   
   <!--审批说明-->
        <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"> @Html.DisplayNameFor(model => model.Comment)</label>
		<div class="col-md-4 mb-1 pl-1">  
			<input id="@Html.IdFor(model => model.Comment)" 
				   name="@Html.NameFor(model => model.Comment)" 
				   value="@Html.ValueFor(model => model.Comment)"
				   tabindex="9" 
				   class="easyui-textbox" 
                   style="width:100%"
				   type="text" 
				   data-options="prompt:'@Html.DescriptionFor(model => model.Comment)',
								 required:false, 
                                 validType: 'length[0,512]'
                                 " />
       </div>
				   

   <!--审批备注-->
        <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"> @Html.DisplayNameFor(model => model.Remark)</label>
		<div class="col-md-4 mb-1 pl-1">  
			<input id="@Html.IdFor(model => model.Remark)" 
				   name="@Html.NameFor(model => model.Remark)" 
				   value="@Html.ValueFor(model => model.Remark)"
				   tabindex="10" 
				   class="easyui-textbox" 
                   style="width:100%"
				   type="text" 
				   data-options="prompt:'@Html.DescriptionFor(model => model.Remark)',
								 required:false, 
                                 validType: 'length[0,512]'
                                 " />
       </div>
				   
	    </div> 
      </fieldset>
   </form>
    </div>
    </div>
    </div>
</div>

<!-- 弹出窗体form表单 -->
<!-- 弹出编辑对话框 -->

<!--begin popup detailview javascript block -->
<script type="text/javascript">
 //当初始的 HTML 文档被完全加载和解析完成之后
 document.addEventListener('DOMContentLoaded', function () {
     //绑定按钮事件
    $('button[name="saveitembutton"]').on('click', saveapprovehistoryitem);
    $('button[name="deleteitembutton"]').on('click', deleteapprovehistoryitem);
  });
    //判断新增编辑状态
    var MODELSTATE = 'Added';
    var approvehistoryid = null;
    function openapprovehistorydetailwindow(data,state) {
         MODELSTATE = state;
         //判断是否显示功能按钮
        if (MODELSTATE === 'Added') {
          $('#deleteitem-btn-group').hide();
        } else {
          $('#deleteitem-btn-group').show();
        }
        initapprovehistorydetailview();
         approvehistoryid = (data.Id || 0);
         $('#approvehistorydetailwindow').window('open');
         $('#approvehistory_form').form('reset');
         $('#approvehistory_form').form('load', data);
             }
  //删除当前记录
  function deleteapprovehistoryitem() {
    $.messager.confirm('确认', '你确定要删除该记录?', result => {
      if (result) {
        const url = `/ApproveHistories/Delete/${approvehistoryid}`;
        $.get(url).done(res => {
          if (res.success) {
            toastr.success("删除成功");
            $('#approvehistorydetailwindow').window('close');
            reloadData();
          } else {
            $.messager.alert('错误', res.err, 'error');
          }
        });
      }
    });
  }
    //async 保存数据
    async function saveapprovehistoryitem() { 
      const $approvehistoryform = $('#approvehistory_form');
      if ($approvehistoryform.form('enableValidation').form('validate')) {
            let approvehistory = $approvehistoryform.serializeJSON();
            let url = '/ApproveHistories/Edit';
            //判断是新增或是修改方法
            if (MODELSTATE === 'Added') {
                url = '/ApproveHistories/Create';
            }
            var token = $('input[name="__RequestVerificationToken"]', $approvehistoryform).val();
            $.ajax({
                    type: "POST",
                    url: url,
                    data: {
                        __RequestVerificationToken: token,
                        approvehistory:approvehistory
                    },
                    dataType: 'json',
                    contentType: 'application/x-www-form-urlencoded; charset=utf-8'
                })
                .done(response => {
                    if (response.success) {
                        hook = false;
                        $approvehistoryform.form('disableValidation');
                        $('#approvehistorydetailwindow').window("close");
                        toastr.success("保存成功"); 
                        reloadData();
                    } else {
                        $.messager.alert("错误",   response.err, "error");
                    }
                    })
                .fail((jqXHR, textStatus, errorThrown) => {
                       $.messager.alert('异常', `${jqXHR.status}: ${jqXHR.statusText} `, 'error');
                    });
        }
    }
     //判断是否有没有保存的记录
     function approvehistoryhasmodified() {
            return hook;

     }


function initapprovehistorydetailview() {
//回车光标移动到下个输入控件
    //如果是枚举类型需要把numberbox改成combobox
    //关联ID
	$('#RefId').numberbox('textbox').bind('keydown', function (e) {
      if (e.keyCode == 13) {
        $(e.target).emulateTab();
      }
    });
    //日期类型 提交时间
	$('#SubmitDate').datebox('textbox').bind('keydown', function (e) {
      if (e.keyCode == 13) {
        $(e.target).emulateTab();
      }
    });
    //日期类型 审批时间
	$('#ApprovedDate').datebox('textbox').bind('keydown', function (e) {
      if (e.keyCode == 13) {
        $(e.target).emulateTab();
      }
    });
}
</script>

