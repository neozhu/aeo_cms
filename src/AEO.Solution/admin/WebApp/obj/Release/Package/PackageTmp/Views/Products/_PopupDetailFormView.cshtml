        $(e.target).emulateTab();
      }
    });
    //如果是枚举类型需要把numberbox改成combobox
    //宽
    $('#Width').numberbox('textbox').bind('keydown', function (e) {
      if (e.keyCode == 13) {
        $(e.target).emulateTab();
      }
    });
    //如果是枚举类型需要把numberbox改成combobox
    //高
    $('#High').numberbox('textbox').bind('keydown', function (e) {
      if (e.keyCode == 13) {
        $(e.target).emulateTab();
      }
    });
  }

  document.addEventListener('DOMContentLoaded', (event) => {
    $('.upload').on('click', function (e) {
      console.log('click')
      var el = window._protected_reference= document.getElementById("picturesinput");
      el.type = "file";
      el.accept = "image/*";
      el.multiple = "multiple"; // remove to have a single file selection

      // (cancel will not trigger 'change')
      el.addEventListener('change', function (ev2) {
