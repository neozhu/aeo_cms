                             class="easyui-textbox"
                             style="width:100%"
                             type="text"
                             data-options="prompt:'@Html.DescriptionFor(model => model.ProductNo)',
								 required:false,
                                 validType: 'length[0,128]'
                                 " />
                    </div>

                    <!--产品类别-->
