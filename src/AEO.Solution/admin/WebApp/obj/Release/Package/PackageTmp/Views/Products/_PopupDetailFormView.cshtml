    //          }
    //        })
    //    });
    //};
  }
  //删除当前记录
  function deleteproductitem() {
    $.messager.confirm('确认', '你确定要删除该记录?', result => {
      if (result) {
        const url = `/Products/Delete/${productid}`;
        $.get(url).done(res => {
          if (res.success) {
            toastr.success("删除成功");
            $('#productdetailwindow').window('close');
            reloadData();
          } else {
            $.messager.alert('错误', res.err, 'error');
          }
        });
      }
    });
  }
  //async 保存数据
  async function saveproductitem() {
    const $productform = $('#product_form');
    if ($productform.form('enableValidation').form('validate')) {
      let product = $productform.serializeJSON();
      //获取明细表数据
      let fileidarray = [];
      $('#js-lightgallery > a').each(function () {
        fileidarray.push($(this).data("id"));
      });
      product.Pictures = fileidarray;
      


      const productpurchasehistoricalprice_result = await productpurchasehistoricalprice_acceptChanges();
      if (!productpurchasehistoricalprice_result.success) {
        return false;
      } else {
        product.ProductPurchaseHistoricalPrices = productpurchasehistoricalprice_result.changed;
      }


      const productsaleshistoricalprice_result = await productsaleshistoricalprice_acceptChanges();
      if (!productsaleshistoricalprice_result.success) {
        return false;
      } else {
        product.ProductSalesHistoricalPrices = productsaleshistoricalprice_result.changed;
      }

      let url = '/Products/Edit';
      //判断是新增或是修改方法
      if (MODELSTATE === 'Added') {
        url = '/Products/Create';
      }
      var token = $('input[name="__RequestVerificationToken"]', $productform).val();
      $.ajax({
        type: "POST",
        url: url,
        data: {
          __RequestVerificationToken: token,
          product: product
        },
        dataType: 'json',
        contentType: 'application/x-www-form-urlencoded; charset=utf-8'
      })
        .done(response => {
          if (response.success) {
            hook = false;
            $productform.form('disableValidation');
            $('#productdetailwindow').window("close");
            toastr.success("保存成功");
            reloadData();
          } else {
            $.messager.alert("错误", response.err, "error");
          }
        })
        .fail((jqXHR, textStatus, errorThrown) => {
          $.messager.alert('异常', `${jqXHR.status}: ${jqXHR.statusText} `, 'error');
        });
    }
  }
  //关闭窗口
  function closeproductdetailwindow() {
    $('#productdetailwindow').window('close');
  }
  //判断是否有没有保存的记录
  function producthasmodified() {
    if (!hook) {
       
      if (!productpurchasehistoricalprice_endEditing()) {
        return true;
      }
      const productpurchasehistoricalprices = $productpurchasehistoricalpricedg.datagrid("getChanges");
      if (MODELSTATE == 'Modified' && productpurchasehistoricalprices.length > 0) {
        return true;
      }
      if (!productsaleshistoricalprice_endEditing()) {
        return true;
      }
      const productsaleshistoricalprices = $productsaleshistoricalpricedg.datagrid("getChanges");
      if (MODELSTATE == 'Modified' && productsaleshistoricalprices.length > 0) {
        return true;
      }
      return false;
    } else {
      return hook;
    }

  }


