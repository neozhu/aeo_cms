    $productpurchasehistoricalpricedg.datagrid('resize');
    var url = '/ProductSalesHistoricalPrices/GetDataByProductId?productid=' + productid;
    $productsaleshistoricalpricedg.datagrid('load', url);
    $productsaleshistoricalpricedg.datagrid('resize');
    var url = '/ActionLogs/GetDataByRefKey?refkey=' + data.ProductNo;
    $actionlogdg.datagrid('load', url);
    $actionlogdg.datagrid('resize');
    $('#js-lightgallery').empty();
    if (state != 'Added') {
      loadPictureList(data.Id);
    }
    //var $initScope = $('#js-lightgallery');
    //if ($initScope.length) {
