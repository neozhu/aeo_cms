  function loadPictureList(productid) {
    $.get('/ProductPrictures/GetDataByProductId?productid=' + productid).done(res => {
      //console.log(res);
      if (res.length > 0) {
        res.forEach(item => {
          const el = `<a class="" href="${item.RelativePath}" data-id="${item.FileId}" data-sub-html="${item.FileName}">
                   <img class="img-responsive" src="${item.RelativePath}" alt="${item.FileName}">
                 </a>`
          $('#js-lightgallery').append(el)
        });
        var $initScope = $('#js-lightgallery');
        if ($initScope.length) {
          $initScope.justifiedGallery(
            {
              border: -1,
              rowHeight: 60,
              margins: 5,
              waitThumbnailsLoad: true,
              randomize: false,
            }).on('jg.complete', function () {
              if ($initScope.data("lightGallery")) {
                $initScope.data('lightGallery').destroy(true)
              }
              $initScope.lightGallery(
                {
                  thumbnail: true,
                  animateThumb: true,
                  showThumbByDefault: true,
                  onDeletePicture: function (item) {
                    console.log('onDeletePicture', item, $(item).data("id"));
                    $.get('/Products/DeleteFile/' + $(item).data("id")).done(res => {
                      $(`a[data-id="${$(item).data("id")}"]`).remove();
                    });
                  }
                })
            });

        };
      }
    });
  }
  function appendpicturegallay(list) {
    list.forEach(item => {
      const el = `<a class="" href="${item.RelativePath}" data-id="${item.FileId}" data-sub-html="${item.FileName}">
                   <img class="img-responsive" src="${item.RelativePath}" alt="${item.FileName}">
                 </a>`
      $('#js-lightgallery').append(el)

    })
    
    var $initScope = $('#js-lightgallery');
    if ($initScope.length) {
      $initScope.justifiedGallery(
        {
          border: -1,
          rowHeight: 60,
          margins: 5,
          waitThumbnailsLoad: true,
          randomize: false,
        }).on('jg.complete', function () {
          if ($initScope.data("lightGallery")) {
            $initScope.data('lightGallery').destroy(true)
          }
          $initScope.lightGallery(
            {
              thumbnail: true,
              animateThumb: true,
              showThumbByDefault: true,
              onDeletePicture: function (item) {
                console.log('onDeletePicture', item, $(item).data("id"));
                $.get('/Products/DeleteFile/'+ $(item).data("id")).done(res => {
                  $(`a[data-id="${$(item).data("id")}"]`).remove();
                });
              }
            })
        });
      
    };
