								               required:true,
    						               valueField: 'id',
						                   textField:  'text' ,
                               panelHeight:'auto',
                               editable:true,
						                   url: '/Categories/GetComboTreeData' ,
                               method:'get',
						                   onSelect: function(item){
						                     console.log(item);
                                 $('#product_form #Category').val(item.text);
				                       }
                                 " />
                    </div>


                    <!--中文品名-->
