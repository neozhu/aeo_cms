        <!--职务-->
        <div class="col-xs-12 col-md-6">
            <label class="form-label text-danger">@Html.DisplayNameFor(model => model.Job)</label>
			@Html.EditorFor(x => x.Job, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.Job) } })
      
         </div>

        <!--微信-->
        <div class="col-xs-12 col-md-6">
            <label class="form-label ">@Html.DisplayNameFor(model => model.Wx)</label>
			@Html.EditorFor(x => x.Wx, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.Wx) } })
      
         </div>

        <!--电话-->
        <div class="col-xs-12 col-md-6">
            <label class="form-label ">@Html.DisplayNameFor(model => model.PhoneNumber)</label>
			@Html.EditorFor(x => x.PhoneNumber, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.PhoneNumber) } })
      
         </div>

        <!--邮箱-->
        <div class="col-xs-12 col-md-6">
            <label class="form-label text-danger">@Html.DisplayNameFor(model => model.Email)</label>
			@Html.EditorFor(x => x.Email, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.Email) } })
      
         </div>

        <!--备注-->
        <div class="col-xs-12 col-md-6">
            <label class="form-label ">@Html.DisplayNameFor(model => model.ContactRemark)</label>
			@Html.EditorFor(x => x.ContactRemark, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.ContactRemark) } })
      
         </div>

        <!--客户状态-->
        <div class="col-xs-12 col-md-6">
            <label class="form-label ">@Html.DisplayNameFor(model => model.Status)</label>
			@Html.EditorFor(x => x.Status, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.Status) } })
      
         </div>

		
      <!--标志-->
      <div class="col-xs-12 col-md-6">
              <label class="form-label text-danger">@Html.DisplayNameFor(model => model.Flag)</label>
              <div class="custom-control custom-checkbox">
                 <input id="@Html.IdFor(model => model.Flag)"
                       name="@Html.NameFor(model => model.Flag)"
                       value="true" @(Model.Flag ? "checked=\"checked\"" : "")
                       class="custom-control-input"
                       tabindex="6"
                       type="checkbox" />
                <label class="custom-control-label" for="@Html.IdFor(model => model.Flag)">@Html.DisplayNameFor(model => model.Flag)</label>
            </div>
      </div>

        <!--客户图片-->
        <div class="col-xs-12 col-md-6">
            <label class="form-label ">@Html.DisplayNameFor(model => model.Logo)</label>
			@Html.EditorFor(x => x.Logo, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.Logo) } })
      
         </div>

       <!--最近联系时间-->
       <div class="col-xs-12 col-md-6">
            <label class="form-label ">@Html.DisplayNameFor(model => model.LastContactDate)</label>
            <div class="input-group">
			  @Html.EditorFor(x => x.LastContactDate, 
                         new { htmlAttributes = new { @class = "form-control datepicker hasDatepicker",
                               placeholder = Html.DisplayNameFor(x => x.LastContactDate ) } })
               <span class="input-group-addon"><i class="fa fa-calendar"></i></span>
			 </div>
         </div>

	    
</div>

