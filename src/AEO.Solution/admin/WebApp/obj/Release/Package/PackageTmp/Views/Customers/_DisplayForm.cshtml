        <!--统一社会信用代码-->
        <div class="col-xs-12 col-md-6">
            <label class="form-label text-danger">@Html.DisplayNameFor(model => model.CreditCode)</label>
			@Html.EditorFor(x => x.CreditCode, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.CreditCode) } })
      
         </div>

        <!--主联系人-->
        <div class="col-xs-12 col-md-6">
            <label class="form-label text-danger">@Html.DisplayNameFor(model => model.ContactName)</label>
			@Html.EditorFor(x => x.ContactName, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.ContactName) } })
      
         </div>

        <!--称谓-->
        <div class="col-xs-12 col-md-6">
            <label class="form-label ">@Html.DisplayNameFor(model => model.Appellation)</label>
			@Html.EditorFor(x => x.Appellation, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.Appellation) } })
      
