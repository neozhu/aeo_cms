﻿@model WebApp.Models.ApproveHistory
  <div class="form-row">
   @Html.HiddenFor(x=>x.Id)
 		<!--关联ID-->
        <div class="col-xs-12 col-sm-6 col-md-4 col-lg-3">
            <label class="form-label">  @Html.DisplayNameFor(model => model.RefId)</label>
            @Html.EditorFor(x => x.RefId, new { htmlAttributes = new { @class = "form-control",@type="number", placeholder = Html.DisplayNameFor(x => x.RefId) } })

        </div>

        <!--关联单号-->
        <div class="col-xs-12 col-sm-6 col-md-4 col-lg-3">
            <label class="form-label">  @Html.DisplayNameFor(model => model.RekKey)</label>
			@Html.EditorFor(x => x.RekKey, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.RekKey) } })
      
         </div>

        <!--状态-->
        <div class="col-xs-12 col-sm-6 col-md-4 col-lg-3">
            <label class="form-label">  @Html.DisplayNameFor(model => model.Status)</label>
			@Html.EditorFor(x => x.Status, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.Status) } })
      
         </div>

        <!--发起人-->
        <div class="col-xs-12 col-sm-6 col-md-4 col-lg-3">
            <label class="form-label">  @Html.DisplayNameFor(model => model.Initiator)</label>
			@Html.EditorFor(x => x.Initiator, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.Initiator) } })
      
         </div>

       <!--提交时间-->
       <div class="col-xs-12 col-sm-6 col-md-4 col-lg-3">
            <label class="form-label">  @Html.DisplayNameFor(model => model.SubmitDate)</label>
            <div class="input-group">
			  @Html.EditorFor(x => x.SubmitDate, 
                         new { htmlAttributes = new { @class = "form-control datepicker",
                               placeholder = Html.DisplayNameFor(x => x.SubmitDate ) } })
               <div class="input-group-append">
                                                            <span class="input-group-text fs-xl">
                                                                <i class="fal fa-calendar-alt"></i>
                                                            </span>
                                                        </div>
			 </div>
         </div>

        <!--待审人-->
        <div class="col-xs-12 col-sm-6 col-md-4 col-lg-3">
            <label class="form-label">  @Html.DisplayNameFor(model => model.ToAuditor)</label>
			@Html.EditorFor(x => x.ToAuditor, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.ToAuditor) } })
      
         </div>

        <!--审批人-->
        <div class="col-xs-12 col-sm-6 col-md-4 col-lg-3">
            <label class="form-label">  @Html.DisplayNameFor(model => model.Approver)</label>
			@Html.EditorFor(x => x.Approver, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.Approver) } })
      
         </div>

       <!--审批时间-->
       <div class="col-xs-12 col-sm-6 col-md-4 col-lg-3">
            <label class="form-label">  @Html.DisplayNameFor(model => model.ApprovedDate)</label>
            <div class="input-group">
			  @Html.EditorFor(x => x.ApprovedDate, 
                         new { htmlAttributes = new { @class = "form-control datepicker",
                               placeholder = Html.DisplayNameFor(x => x.ApprovedDate ) } })
               <div class="input-group-append">
                                                            <span class="input-group-text fs-xl">
                                                                <i class="fal fa-calendar-alt"></i>
                                                            </span>
                                                        </div>
			 </div>
         </div>

        <!--审批意见-->
        <div class="col-xs-12 col-sm-6 col-md-4 col-lg-3">
            <label class="form-label">  @Html.DisplayNameFor(model => model.Result)</label>
			@Html.EditorFor(x => x.Result, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.Result) } })
      
         </div>

        <!--审批说明-->
        <div class="col-xs-12 col-sm-6 col-md-4 col-lg-3">
            <label class="form-label">  @Html.DisplayNameFor(model => model.Comment)</label>
			@Html.EditorFor(x => x.Comment, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.Comment) } })
      
         </div>

        <!--审批备注-->
        <div class="col-xs-12 col-sm-6 col-md-4 col-lg-3">
            <label class="form-label">  @Html.DisplayNameFor(model => model.Remark)</label>
			@Html.EditorFor(x => x.Remark, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.Remark) } })
      
         </div>

	    
</div>

