﻿@model WebApp.Models.CustomerFollow
<!-- 弹出编辑窗体表单 -->
 <div id="customerfollowdetailwindow" class="easyui-window" 
      title="明细数据" 
      data-options="modal:true,
                    closed:true,
                    minimizable:false,
                    collapsible:false,
                    maximized:false,
                    iconCls:'fal fa-window',
                    onBeforeClose:function(){
                      var that = $(this);
                      if(customerfollowhasmodified()){
                        $.messager.confirm('确认','你确定要放弃保存修改的记录?',function(r){
                        if (r){
                          var opts = that.panel('options');
                          var onBeforeClose = opts.onBeforeClose;
                          opts.onBeforeClose = function(){};
                          that.panel('close');
                          opts.onBeforeClose = onBeforeClose;
                          hook = false;
                        }
                        });
                        return false;
                      }
                    },
                    onOpen:function(){
                       $(this).window('vcenter');
                       $(this).window('hcenter');
                    },
                    onRestore:function(){
                    },
                    onMaximize:function(){
                    }
                    " style="width:800px;height:450px;display:none">
  <!-- toolbar -->
  <div class="panel-content py-2 rounded-bottom border-faded border-left-0 border-right-0  text-muted bg-subtlelight-fade sticky-top">
  <div class="d-flex flex-row-reverse pr-4">
        <div class="btn-group btn-group-sm mr-1">
          <button name="saveitembutton" onclick="savecustomerfollowitem()" class="btn btn-default">
            <i class="fal fa-save"></i> @Html.L("Save")
          </button>
        </div>
        <div class="btn-group btn-group-sm mr-1" id="deleteitem-btn-group">
          <button onclick="deletecustomerfollowitem()" class="btn btn-danger">
            <i class="fal fa-trash-alt"></i> @Html.L("Delete")
          </button>
        </div>
    </div>
  </div>
 <!-- panel container form  -->
 <div class="panel-container show">
   <div class="container">
    <div class="panel-content">
           <form id="customerfollow_form" 
              class="easyui-form form-horizontal padding-10" 
              method="post" 
              data-options="novalidate:true,
                            onChange: function(target){
                              hook = true;
                              $('button[name*=\'saveitembutton\']').prop('disabled', false);
                             },
                             onLoadSuccess:function(data){
                               hook = false;
                               $('button[name*=\'saveitembutton\']').prop('disabled', true);
                             }">
  @Html.AntiForgeryToken()
   <!--Primary Key-->
  @Html.HiddenFor(model=>model.Id)
   <fieldset class="form-group">
   <div class="row h-100 align-items-center">

   <!--客户联系人-->
        <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"><span class="text-danger">*</span> @Html.DisplayNameFor(model => model.ContactName)</label>
		<div class="col-md-4 mb-1 pl-1">  
			<input id="@Html.IdFor(model => model.ContactName)" 
				   name="@Html.NameFor(model => model.ContactName)" 
				   value="@Html.ValueFor(model => model.ContactName)"
				   tabindex="0" required
				   class="easyui-textbox" 
                   style="width:100%"
				   type="text" 
				   data-options="prompt:'@Html.DescriptionFor(model => model.ContactName)',
								 required:true, 
                                 validType: 'length[0,80]'
                                 " />
       </div>
				   
   <!--跟进方式-->
        <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"> @Html.DisplayNameFor(model => model.FollowType)</label>
		<div class="col-md-4 mb-1 pl-1">  
			<input id="@Html.IdFor(model => model.FollowType)" 
				   name="@Html.NameFor(model => model.FollowType)" 
				   value="@Html.ValueFor(model => model.FollowType)"
				   tabindex="1" 
				   class="easyui-textbox" 
                   style="width:100%"
				   type="text" 
				   data-options="prompt:'@Html.DescriptionFor(model => model.FollowType)',
								 required:false, 
                                 validType: 'length[0,20]'
                                 " />
       </div>
				   

   <!--跟进状态-->
        <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"> @Html.DisplayNameFor(model => model.Status)</label>
		<div class="col-md-4 mb-1 pl-1">  
			<input id="@Html.IdFor(model => model.Status)" 
				   name="@Html.NameFor(model => model.Status)" 
				   value="@Html.ValueFor(model => model.Status)"
				   tabindex="2" 
				   class="easyui-textbox" 
                   style="width:100%"
				   type="text" 
				   data-options="prompt:'@Html.DescriptionFor(model => model.Status)',
								 required:false, 
                                 validType: 'length[0,20]'
                                 " />
       </div>
				   
   <!--跟进人-->
        <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"> @Html.DisplayNameFor(model => model.Owner)</label>
		<div class="col-md-4 mb-1 pl-1">  
			<input id="@Html.IdFor(model => model.Owner)" 
				   name="@Html.NameFor(model => model.Owner)" 
				   value="@Html.ValueFor(model => model.Owner)"
				   tabindex="3" 
				   class="easyui-textbox" 
                   style="width:100%"
				   type="text" 
				   data-options="prompt:'@Html.DescriptionFor(model => model.Owner)',
								 required:false, 
                                 validType: 'length[0,20]'
                                 " />
       </div>
				   

   <!--跟进时间-->
        <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"><span class="text-danger">*</span> @Html.DisplayNameFor(model => model.FollowDate)</label>
		<div class="col-md-4 mb-1 pl-1">  
                <input id="@Html.IdFor(model => model.FollowDate)" 
			       name="@Html.NameFor(model => model.FollowDate)"
                   value="@Html.ValueFor(model => model.FollowDate)"
           		   tabindex="4"  required
				   class="easyui-datebox" 
                   style="width:100%"
				   type="text" 
				   data-options="prompt:'@Html.DescriptionFor(model => model.FollowDate)',
								 required:true,
								 formatter:dateformatter" />
     </div>
				   
   <!--跟进内容-->
        <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"> @Html.DisplayNameFor(model => model.Content)</label>
		<div class="col-md-4 mb-1 pl-1">  
			<input id="@Html.IdFor(model => model.Content)" 
				   name="@Html.NameFor(model => model.Content)" 
				   value="@Html.ValueFor(model => model.Content)"
				   tabindex="5" 
				   class="easyui-textbox" 
                   style="width:100%"
				   type="text" 
				   data-options="prompt:'@Html.DescriptionFor(model => model.Content)',
								 required:false, 
                                 validType: 'length[0,50]'
                                 " />
       </div>
				   

   <!--设置提醒时间-->
      <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"> @Html.DisplayNameFor(model => model.ReminderTime)</label>
		<div class="col-md-4 mb-1 pl-1">  
			<input id="@Html.IdFor(model => model.ReminderTime)" 
			       name="@Html.NameFor(model => model.ReminderTime)" 
                   value="@Html.ValueFor(model => model.ReminderTime)"
				   tabindex="6" 
				   class="easyui-datetimebox" 
                   style="width:100%"
				   type="text" 
				   data-options="prompt:'@Html.DescriptionFor(model => model.ReminderTime)',
								 required:false,
								 formatter:datetimeformatter" />
    </div>
				   
   <!--提醒内容-->
        <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"> @Html.DisplayNameFor(model => model.ReminderContent)</label>
		<div class="col-md-4 mb-1 pl-1">  
			<input id="@Html.IdFor(model => model.ReminderContent)" 
				   name="@Html.NameFor(model => model.ReminderContent)" 
				   value="@Html.ValueFor(model => model.ReminderContent)"
				   tabindex="7" 
				   class="easyui-textbox" 
                   style="width:100%"
				   type="text" 
				   data-options="prompt:'@Html.DescriptionFor(model => model.ReminderContent)',
								 required:false, 
                                 validType: 'length[0,50]'
                                 " />
       </div>
				   

   <!--提醒人员-->
        <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"> @Html.DisplayNameFor(model => model.ReminderTo)</label>
		<div class="col-md-4 mb-1 pl-1">  
			<input id="@Html.IdFor(model => model.ReminderTo)" 
				   name="@Html.NameFor(model => model.ReminderTo)" 
				   value="@Html.ValueFor(model => model.ReminderTo)"
				   tabindex="8" 
				   class="easyui-textbox" 
                   style="width:100%"
				   type="text" 
				   data-options="prompt:'@Html.DescriptionFor(model => model.ReminderTo)',
								 required:false, 
                                 validType: 'length[0,200]'
                                 " />
       </div>
				   
   <!--客户编号-->
        <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"><span class="text-danger">*</span> @Html.DisplayNameFor(model => model.CustomerCode)</label>
		<div class="col-md-4 mb-1 pl-1">  
			<input id="@Html.IdFor(model => model.CustomerCode)" 
				   name="@Html.NameFor(model => model.CustomerCode)" 
				   value="@Html.ValueFor(model => model.CustomerCode)"
				   tabindex="9" required
				   class="easyui-textbox" 
                   style="width:100%"
				   type="text" 
				   data-options="prompt:'@Html.DescriptionFor(model => model.CustomerCode)',
								 required:true, 
                                 validType: 'length[0,20]'
                                 " />
       </div>
				   

   <!--客户名称-->
        <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"><span class="text-danger">*</span> @Html.DisplayNameFor(model => model.CustomerName)</label>
		<div class="col-md-4 mb-1 pl-1">  
			<input id="@Html.IdFor(model => model.CustomerName)" 
				   name="@Html.NameFor(model => model.CustomerName)" 
				   value="@Html.ValueFor(model => model.CustomerName)"
				   tabindex="10" required
				   class="easyui-textbox" 
                   style="width:100%"
				   type="text" 
				   data-options="prompt:'@Html.DescriptionFor(model => model.CustomerName)',
								 required:true, 
                                 validType: 'length[0,80]'
                                 " />
       </div>
				   
    <!--所属客户-->
        <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"><span class="text-danger">*</span> @Html.DisplayNameFor(model => model.CustomerId)</label>
		<div class="col-md-4 mb-1 pl-1">   	
            <input id="@Html.IdFor(model => model.CustomerId)"
			       name="@Html.NameFor(model => model.CustomerId)"
				   value="@Html.ValueFor(model => model.CustomerId)"
                   tabindex="11" required
              	   class="easyui-combobox"      
                   style="width:100%"
                   data-options="prompt:'@Html.DescriptionFor(model => model.CustomerId)' ,
						required:true ,
						valueField: 'Id',
						textField:  'CustomerCode' ,
                        validateOnCreate:false,
                        validateOnBlur:true,
                        validType:'combocheck[\'#CustomerId\',\'请选择所属客户\']',
						url: '/CustomerFollows/GetCustomers' ,
						onSelect: function(item){
						  //console.log(item);
				        }">
       </div>
	   
	    </div> 
      </fieldset>
   </form>
    </div>
    </div>
    </div>
</div>

<!-- 弹出窗体form表单 -->
<!-- 弹出编辑对话框 -->

<!--begin popup detailview javascript block -->
<script type="text/javascript">
    //判断新增编辑状态
    var MODELSTATE = 'Added';
    var customerfollowid = null;
    function opencustomerfollowdetailwindow(data,state) {
         MODELSTATE = state;
         initcustomerfollowdetailview();
         customerfollowid = (data.Id || 0);
         $('#customerfollowdetailwindow').window('open');
         $('#customerfollow_form').form('reset');
         $('#customerfollow_form').form('load', data);
             }
  //删除当前记录
  function deletecustomerfollowitem() {
    $.messager.confirm('确认', '你确定要删除该记录?', result => {
      if (result) {
        const url = `/CustomerFollows/Delete/${customerfollowid}`;
        $.get(url).done(res => {
          if (res.success) {
            toastr.success("删除成功");
            $('#customerfollowdetailwindow').window('close');
            reloadData();
          } else {
            $.messager.alert('错误', res.err, 'error');
          }
        });
      }
    });
  }
    //async 保存数据
    async function savecustomerfollowitem() { 
      const $customerfollowform = $('#customerfollow_form');
      if ($customerfollowform.form('enableValidation').form('validate')) {
            let customerfollow = $customerfollowform.serializeJSON();
            let url = '/CustomerFollows/Edit';
            //判断是新增或是修改方法
            if (MODELSTATE === 'Added') {
                url = '/CustomerFollows/Create';
            }
            var token = $('input[name="__RequestVerificationToken"]', $customerfollowform).val();
            $.ajax({
                    type: "POST",
                    url: url,
                    data: {
                        __RequestVerificationToken: token,
                        customerfollow:customerfollow
                    },
                    dataType: 'json',
                    contentType: 'application/x-www-form-urlencoded; charset=utf-8'
                })
                .done(response => {
                    if (response.success) {
                        hook = false;
                        $customerfollowform.form('disableValidation');
                        $('#customerfollowdetailwindow').window("close");
                        toastr.success("保存成功"); 
                        reloadData();
                    } else {
                        $.messager.alert("错误",   response.err, "error");
                    }
                    })
                .fail((jqXHR, textStatus, errorThrown) => {
                       $.messager.alert('异常', `${jqXHR.status}: ${jqXHR.statusText} `, 'error');
                    });
        }
    }
    //关闭窗口
    function closecustomerfollowdetailwindow() {
        $('#customerfollowdetailwindow').window('close');
    }
     //判断是否有没有保存的记录
     function customerfollowhasmodified() {
            return hook;

     }


function initcustomerfollowdetailview() {
  //判断是否显示功能按钮
  if (MODELSTATE === 'Added') {
    $('#deleteitem-btn-group').hide();
  } else {
    $('#deleteitem-btn-group').show();
  }

//回车光标移动到下个输入控件
    //日期类型 跟进时间
	$('#FollowDate').datebox('textbox').bind('keydown', function (e) {
      if (e.keyCode == 13) {
        $(e.target).emulateTab();
      }
    });
    //日期类型 设置提醒时间
	$('#ReminderTime').datebox('textbox').bind('keydown', function (e) {
      if (e.keyCode == 13) {
        $(e.target).emulateTab();
      }
    });
    //所属客户默认外键使用combobox,也可以使用combogrid
	$('#CustomerId').combobox('textbox').bind('keydown', function (e) {
      if (e.keyCode == 13) {
        $(e.target).emulateTab();
      }
    });
}
</script>

