﻿@model WebApp.Models.CustomerFollow
  <div class="form-row">
   @Html.HiddenFor(x=>x.Id)
         <!--客户联系人-->
        <div class="col-xs-12 col-md-6">
            <label class="form-label text-danger">@Html.DisplayNameFor(model => model.ContactName)</label>
			@Html.EditorFor(x => x.ContactName, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.ContactName) } })
      
         </div>

        <!--跟进方式-->
        <div class="col-xs-12 col-md-6">
            <label class="form-label ">@Html.DisplayNameFor(model => model.FollowType)</label>
			@Html.EditorFor(x => x.FollowType, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.FollowType) } })
      
         </div>

        <!--跟进状态-->
        <div class="col-xs-12 col-md-6">
            <label class="form-label ">@Html.DisplayNameFor(model => model.Status)</label>
			@Html.EditorFor(x => x.Status, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.Status) } })
      
         </div>

        <!--跟进人-->
        <div class="col-xs-12 col-md-6">
            <label class="form-label ">@Html.DisplayNameFor(model => model.Owner)</label>
			@Html.EditorFor(x => x.Owner, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.Owner) } })
      
         </div>

       <!--跟进时间-->
       <div class="col-xs-12 col-md-6">
            <label class="form-label text-danger">@Html.DisplayNameFor(model => model.FollowDate)</label>
            <div class="input-group">
			  @Html.EditorFor(x => x.FollowDate, 
                         new { htmlAttributes = new { @class = "form-control datepicker hasDatepicker",
                               placeholder = Html.DisplayNameFor(x => x.FollowDate ) } })
               <span class="input-group-addon"><i class="fa fa-calendar"></i></span>
			 </div>
         </div>

        <!--跟进内容-->
        <div class="col-xs-12 col-md-6">
            <label class="form-label ">@Html.DisplayNameFor(model => model.Content)</label>
			@Html.EditorFor(x => x.Content, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.Content) } })
      
         </div>

       <!--设置提醒时间-->
       <div class="col-xs-12 col-md-6">
            <label class="form-label ">@Html.DisplayNameFor(model => model.ReminderTime)</label>
            <div class="input-group">
			  @Html.EditorFor(x => x.ReminderTime, 
                         new { htmlAttributes = new { @class = "form-control datepicker hasDatepicker",
                               placeholder = Html.DisplayNameFor(x => x.ReminderTime ) } })
               <span class="input-group-addon"><i class="fa fa-calendar"></i></span>
			 </div>
         </div>

        <!--提醒内容-->
        <div class="col-xs-12 col-md-6">
            <label class="form-label ">@Html.DisplayNameFor(model => model.ReminderContent)</label>
			@Html.EditorFor(x => x.ReminderContent, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.ReminderContent) } })
      
         </div>

        <!--提醒人员-->
        <div class="col-xs-12 col-md-6">
            <label class="form-label ">@Html.DisplayNameFor(model => model.ReminderTo)</label>
			@Html.EditorFor(x => x.ReminderTo, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.ReminderTo) } })
      
         </div>

        <!--客户编号-->
        <div class="col-xs-12 col-md-6">
            <label class="form-label text-danger">@Html.DisplayNameFor(model => model.CustomerCode)</label>
			@Html.EditorFor(x => x.CustomerCode, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.CustomerCode) } })
      
         </div>

        <!--客户名称-->
        <div class="col-xs-12 col-md-6">
            <label class="form-label text-danger">@Html.DisplayNameFor(model => model.CustomerName)</label>
			@Html.EditorFor(x => x.CustomerName, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.CustomerName) } })
      
         </div>

     
       <!--所属客户-->
       <div class="col-xs-12 col-md-6">
            <label class="form-label text-danger">@Html.DisplayNameFor(model => model.CustomerId)</label>
   	        @Html.DropDownListFor(model => model.CustomerId, ViewBag.CustomerId as List<SelectListItem>, htmlAttributes: new { @class = "form-control" }) 
       </div>

	    
</div>

