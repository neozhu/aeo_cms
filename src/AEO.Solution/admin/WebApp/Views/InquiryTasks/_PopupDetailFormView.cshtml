    //});
    ////如果是枚举类型需要把numberbox改成combobox
    ////到期提醒
    //$('#PreRemind').numberbox('textbox').bind('keydown', function (e) {
    //  if (e.keyCode == 13) {
    //    $(e.target).emulateTab();
    //  }
    //});
    ////日期类型 开始日期
    //$('#BeginDate').datebox('textbox').bind('keydown', function (e) {
    //  if (e.keyCode == 13) {
    //    $(e.target).emulateTab();
    //  }
    //});
    ////日期类型 结束日期
    //$('#Enddate').datebox('textbox').bind('keydown', function (e) {
    //  if (e.keyCode == 13) {
    //    $(e.target).emulateTab();
    //  }
    //});
    ////公司默认外键使用combobox,也可以使用combogrid
    //$('#CompanyId').combobox('textbox').bind('keydown', function (e) {
    //  if (e.keyCode == 13) {
    //    $(e.target).emulateTab();
    //  }
    //});
    ////客户默认外键使用combobox,也可以使用combogrid
    //$('#CustomerId').combobox('textbox').bind('keydown', function (e) {
    //  if (e.keyCode == 13) {
    //    $(e.target).emulateTab();
    //  }
    //});
