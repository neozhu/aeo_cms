      <!--询价任务-->
      <input type="hidden" id="InquiryTaskTaskNo" name="InquiryTaskTaskNo" value="">
	  <input id="@Html.IdFor(model => model.InquiryTaskId)"
			       name="@Html.NameFor(model => model.InquiryTaskId)"
