@model WebApp.Models.InquiryTaskProduct
<div id="inquirytaskproductdlg" class="easyui-dialog"
     title="InquiryTaskProduct" style="width:600px;height:300px; display:none"
     data-options="
                iconCls: 'fal fa-window',
                modal:true,
                closed:true,
                cache: false,
                resizable:true,
                width:620,
                height:300,
                onOpen:function(){
                   $('#inquirytaskproduct_form').form('disableValidation');
                },
                buttons: [{
                    text:'确认',
                    handler:function(){
                        confirm_inquirytaskproductform();
                    }
                },{
                    text:'取消',
                    handler:function(){
                        $('#inquirytaskproductdlg').dialog('close');
                    }
                }]
            ">
<div class="panel-container show">
      <div class="panel-content p-0">
        <form id="inquirytaskproduct_form" class="form-horizontal needs-validation" novalidate>
          <fieldset class="form-group">
            <div class="row h-100 align-items-center m-0 pt-1">
    <!--系统主键-->
	@Html.HiddenFor(model => model.Id)		
             
    <!--产品编号(自动生成,可手工修改)-->
