﻿@model WebApp.Models.CustomerWarehouse
  <div class="form-row">
   @Html.HiddenFor(x=>x.Id)
         <!--仓库代码-->
        <div class="col-xs-12 col-sm-6 col-md-4 col-lg-3">
            <label class="form-label">  @Html.DisplayNameFor(model => model.WarehouseCode)</label>
			@Html.EditorFor(x => x.WarehouseCode, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.WarehouseCode) } })
      
         </div>

        <!--仓库名称-->
        <div class="col-xs-12 col-sm-6 col-md-4 col-lg-3">
            <label class="form-label">  @Html.DisplayNameFor(model => model.WarehouseName)</label>
			@Html.EditorFor(x => x.WarehouseName, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.WarehouseName) } })
      
