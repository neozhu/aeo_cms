                 field:'InquiryNo', 
                 title:'@Html.DisplayNameFor(model => model.InquiryNo)', 
                 width:120,
                 hidden:false,
                 editor:{
                          type:'textbox',
                          options:{
                             id:'editor_InquiryNo',
                             prompt:'@Html.DescriptionFor(model => model.InquiryNo)',
                             required:true, 
                             validType: 'length[0,20]' 
                             }  
                       },
                 sortable:true,
                 resizable:true 
            },
            {    /*任务单号*/
                 field:'TaskNo', 
                 title:'@Html.DisplayNameFor(model => model.TaskNo)', 
                 width:120,
                 hidden:false,
                 editor:{
                          type:'textbox',
                          options:{
                             id:'editor_TaskNo',
                             prompt:'@Html.DescriptionFor(model => model.TaskNo)',
                             required:false, 
                             validType: 'length[0,20]' 
                             }  
                       },
                 sortable:true,
                 resizable:true 
            },
           {     /*系统版本号*/
                 field:'Ver', 
                 title:'@Html.DisplayNameFor(model => model.Ver)', 
                 width:100, 
                 align:'right',
                 hidden:false,
                 editor:{
                        type:'numberbox',
                        options:{
                                 id:'editor_Ver',
                                 prompt:'@Html.DescriptionFor(model => model.Ver)', 
                                 required:true,
                                 
                                } 
                        },
                formatter:intformatter,
                sortable:true,
                resizable:true 
            },
            {   /*询价单*/
                field:'InquiryId',
                title:'@Html.DisplayNameFor(model => model.InquiryId)',
                width:160, 
                sortable:true, 
                resizable:true,
                hidden:false,
                formatter:(value,row) => {
                        return row.InquiryInquiryNo;
                    },
                editor:{
                        type:'combobox',
                        options:{
                                id:'editor_InquiryId',
                                prompt:'@Html.DescriptionFor(model => model.InquiryId)' ,
                                mode: 'remote',
                                panelHeight:'auto',
                                editable: false,
                                valueField:'Id',
                                textField:'InquiryNo',
                                method:'get',
                                url:'/InquiryProducts/GetInquiries',
                                required:true
                            }
                        }
            },
                 ]]
           }).datagrid('columnMoving')
             .datagrid('resetColumns')
             .datagrid('enableFilter',[
                {   /*询价数量*/
                      field: 'Qty',
                      type: 'numberbox',
                      op:['equal','notequal','less','lessorequal','greater','greaterorequal']
                  },
                {   /*报价金额*/
                      field: 'Price',
                      type: 'numberbox',
                      op:['equal','notequal','less','lessorequal','greater','greaterorequal']
                  },
                {   /*最小订单量*/
                      field: 'MinQty',
                      type: 'numberbox',
                      op:['equal','notequal','less','lessorequal','greater','greaterorequal']
                  },
                {   /*系统版本号*/
                      field: 'Ver',
                      type: 'numberbox',
                      op:['equal','notequal','less','lessorequal','greater','greaterorequal']
                  },
                {     /*厂价有效期*/
                      field: 'PriceDate',
                      type: 'dateRange',
                      options: {
                      }
                  },
                {   /*推荐采纳*/
                      field: 'Recommended',
                      type: 'booleanfilter'
                 },
           {   /*询价单*/
                 field: 'InquiryId',
                 type:'combobox',
                 options:{  
                                panelHeight:'auto',
                                valueField:'Id',
                                textField:'InquiryNo',
                                method:'get',
                                url:'/InquiryProducts/GetInquiries',
                                onChange: value => {
                                if (value === '' || value === null) {
                                    $dg.datagrid('removeFilterRule', 'InquiryId');
                                } else {
                                    $dg.datagrid('addFilterRule', {
                                        field: 'InquiryId',
                                        op: 'equal',
                                        value: value
                                });
                            }
                            $dg.datagrid('doFilter');
                        }
                    }
           },
           ])
           .datagrid('load', '/InquiryProducts/GetData');
           
     });
 
</script>



}

 
