                 hidden:false,
                 editor:{
                        type:'numberbox',
                        options:{ 
                                  id:'editor_Price',
                                  prompt:'@Html.DescriptionFor(model => model.Price)',
                                  required:false, 
                                  precision:2, 
                                  
                                } 
                        },
                formatter:numberformatter,
                sortable:true,
                resizable:true 
            },
            {    /*币种*/
                 field:'Cur', 
                 title:'@Html.DisplayNameFor(model => model.Cur)', 
                 width:120,
                 hidden:false,
                 editor:{
                          type:'textbox',
                          options:{
                             id:'editor_Cur',
                             prompt:'@Html.DescriptionFor(model => model.Cur)',
                             required:false, 
                             validType: 'length[0,20]' 
                             }  
                       },
                 sortable:true,
                 resizable:true 
            },
            {    /*最小订单量*/
                 field:'MinQty', 
                 title:'@Html.DisplayNameFor(model => model.MinQty)', 
                 width:100, 
                 align:'right',
                 hidden:false,
                 editor:{
                        type:'numberbox',
                        options:{ 
                                  id:'editor_MinQty',
                                  prompt:'@Html.DescriptionFor(model => model.MinQty)',
                                  required:false, 
