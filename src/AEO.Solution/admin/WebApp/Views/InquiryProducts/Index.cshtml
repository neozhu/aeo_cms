            {   /*厂价有效期*/
                field:'PriceDate', 
                title:'@Html.DisplayNameFor(model => model.PriceDate)', 
                width:100, 
                align:'right',
                hidden:false,
                editor:{
                      type:'datebox',
                      options:{
                             id:'editor_PriceDate',
                             prompt:'@Html.DescriptionFor(model => model.PriceDate)',
                             required:false
                             }  
                      },
                formatter:dateformatter, 
                sortable:true, 
                resizable:true
            } ,
            {    /*反馈说明*/
                 field:'Feedback', 
                 title:'@Html.DisplayNameFor(model => model.Feedback)', 
                 width:200,
                 hidden:false,
                 editor:{
                          type:'textbox',
                          options:{
                             id:'editor_Feedback',
                             prompt:'@Html.DescriptionFor(model => model.Feedback)',
                             required:false, 
                             validType: 'length[0,50]' 
                             }  
                       },
                 sortable:true,
                 resizable:true 
            },
            {  /*推荐采纳*/
               field:'Recommended', 
               title:'@Html.DisplayNameFor(model => model.Recommended)', 
               width:90, 
               align:'center',
               hidden:false,
               editor:{
                      type:'checkbox',
                      options:{
                                 id:'editor_Recommended',
                                 prompt:'@Html.DescriptionFor(model => model.Recommended)', 
                                 required:true
                               } 
                      },
                formatter:checkboxformatter,
                sortable:true, 
                resizable:true 
            },
            {    /*产品备注*/
                 field:'SamplePic', 
                 title:'@Html.DisplayNameFor(model => model.SamplePic)', 
                 width:200,
                 hidden:false,
                 editor:{
                          type:'textbox',
                          options:{
                             id:'editor_SamplePic',
