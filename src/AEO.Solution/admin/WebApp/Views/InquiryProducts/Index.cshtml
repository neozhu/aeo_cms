                          type:'textbox',
                          options:{
                             id:'editor_SupplierProductNo',
                             prompt:'@Html.DescriptionFor(model => model.SupplierProductNo)',
                             required:false, 
                             validType: 'length[0,128]' 
                             }  
                       },
                 sortable:true,
                 resizable:true 
            },
            {    /*价格类型*/
                 field:'PriceType', 
