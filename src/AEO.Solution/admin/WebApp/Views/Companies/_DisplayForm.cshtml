﻿@model WebApp.Models.Company
  <div class="form-row">
   @Html.HiddenFor(x=>x.Id)
         <!--企业名称-->
        <div class="col-xs-12 col-md-6">
            <label class="form-label text-danger">@Html.DisplayNameFor(model => model.Name)</label>
			@Html.EditorFor(x => x.Name, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.Name) } })
      
         </div>

        <!--企业十位编码-->
        <div class="col-xs-12 col-md-6">
            <label class="form-label ">@Html.DisplayNameFor(model => model.TradeCode)</label>
			@Html.EditorFor(x => x.TradeCode, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.TradeCode) } })
      
         </div>

        <!--主管海关代码-->
        <div class="col-xs-12 col-md-6">
            <label class="form-label ">@Html.DisplayNameFor(model => model.MasterCustom)</label>
			@Html.EditorFor(x => x.MasterCustom, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.MasterCustom) } })
      
         </div>

        <!--统一社会信用代码-->
        <div class="col-xs-12 col-md-6">
            <label class="form-label text-danger">@Html.DisplayNameFor(model => model.CreditCode)</label>
			@Html.EditorFor(x => x.CreditCode, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.CreditCode) } })
      
         </div>

        <!--备案号-->
        <div class="col-xs-12 col-md-6">
            <label class="form-label ">@Html.DisplayNameFor(model => model.Code)</label>
			@Html.EditorFor(x => x.Code, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.Code) } })
      
         </div>

        <!--企业类型-->
        <div class="col-xs-12 col-md-6">
            <label class="form-label ">@Html.DisplayNameFor(model => model.Ctype)</label>
			@Html.EditorFor(x => x.Ctype, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.Ctype) } })
      
         </div>

        <!--经营范围-->
        <div class="col-xs-12 col-md-6">
            <label class="form-label ">@Html.DisplayNameFor(model => model.Scope)</label>
			@Html.EditorFor(x => x.Scope, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.Scope) } })
      
         </div>

        <!--地址-->
        <div class="col-xs-12 col-md-6">
            <label class="form-label ">@Html.DisplayNameFor(model => model.Address)</label>
			@Html.EditorFor(x => x.Address, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.Address) } })
      
         </div>

        <!--法人-->
        <div class="col-xs-12 col-md-6">
            <label class="form-label ">@Html.DisplayNameFor(model => model.LegalPerson)</label>
			@Html.EditorFor(x => x.LegalPerson, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.LegalPerson) } })
      
         </div>

        <!--联系人-->
        <div class="col-xs-12 col-md-6">
            <label class="form-label ">@Html.DisplayNameFor(model => model.Contect)</label>
			@Html.EditorFor(x => x.Contect, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.Contect) } })
      
         </div>

        <!--联系电话-->
        <div class="col-xs-12 col-md-6">
            <label class="form-label ">@Html.DisplayNameFor(model => model.PhoneNumber)</label>
			@Html.EditorFor(x => x.PhoneNumber, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.PhoneNumber) } })
      
         </div>

       <!--注册日期-->
       <div class="col-xs-12 col-md-6">
            <label class="form-label text-danger">@Html.DisplayNameFor(model => model.RegisterDate)</label>
            <div class="input-group">
			  @Html.EditorFor(x => x.RegisterDate, 
                         new { htmlAttributes = new { @class = "form-control datepicker hasDatepicker",
                               placeholder = Html.DisplayNameFor(x => x.RegisterDate ) } })
               <span class="input-group-addon"><i class="fa fa-calendar"></i></span>
			 </div>
         </div>

       <!--有效期-->
       <div class="col-xs-12 col-md-6">
            <label class="form-label ">@Html.DisplayNameFor(model => model.ExpirationDate)</label>
            <div class="input-group">
			  @Html.EditorFor(x => x.ExpirationDate, 
                         new { htmlAttributes = new { @class = "form-control datepicker hasDatepicker",
                               placeholder = Html.DisplayNameFor(x => x.ExpirationDate ) } })
               <span class="input-group-addon"><i class="fa fa-calendar"></i></span>
			 </div>
         </div>

     
       <!--母公司-->
       <div class="col-xs-12 col-md-6">
            <label class="form-label ">@Html.DisplayNameFor(model => model.ParentId)</label>
   	        @Html.DropDownListFor(model => model.ParentId, ViewBag.ParentId as List<SelectListItem>, htmlAttributes: new { @class = "form-control" }) 
       </div>

	    
</div>

