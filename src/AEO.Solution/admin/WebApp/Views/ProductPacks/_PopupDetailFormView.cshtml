<!-- 弹出编辑对话框 -->

<!--begin popup detailview javascript block -->
<script type="text/javascript">
    //判断新增编辑状态
    var MODELSTATE = 'Added';
    var productpackid = null;
    function openproductpackdetailwindow(data,state) {
         MODELSTATE = state;
         initproductpackdetailview();
         productpackid = (data.Id || 0);
         $('#productpackdetailwindow').window('open');
         $('#productpack_form').form('reset');
         $('#productpack_form').form('load', data);
             }
  //删除当前记录
  function deleteproductpackitem() {
    $.messager.confirm('确认', '你确定要删除该记录?', result => {
      if (result) {
        const url = `/ProductPacks/Delete/${productpackid}`;
        $.get(url).done(res => {
          if (res.success) {
            toastr.success("删除成功");
            $('#productpackdetailwindow').window('close');
            reloadData();
          } else {
            $.messager.alert('错误', res.err, 'error');
          }
        });
      }
    });
  }
    //async 保存数据
    async function saveproductpackitem() { 
      const $productpackform = $('#productpack_form');
      if ($productpackform.form('enableValidation').form('validate')) {
            let productpack = $productpackform.serializeJSON();
            let url = '/ProductPacks/Edit';
            //判断是新增或是修改方法
            if (MODELSTATE === 'Added') {
                url = '/ProductPacks/Create';
            }
            var token = $('input[name="__RequestVerificationToken"]', $productpackform).val();
            $.ajax({
                    type: "POST",
                    url: url,
                    data: {
                        __RequestVerificationToken: token,
                        productpack:productpack
                    },
                    dataType: 'json',
                    contentType: 'application/x-www-form-urlencoded; charset=utf-8'
                })
                .done(response => {
                    if (response.success) {
                        hook = false;
                        $productpackform.form('disableValidation');
                        $('#productpackdetailwindow').window("close");
                        toastr.success("保存成功"); 
                        reloadData();
                    } else {
                        $.messager.alert("错误",   response.err, "error");
                    }
                    })
                .fail((jqXHR, textStatus, errorThrown) => {
                       $.messager.alert('异常', `${jqXHR.status}: ${jqXHR.statusText} `, 'error');
                    });
        }
    }
    //关闭窗口
    function closeproductpackdetailwindow() {
        $('#productpackdetailwindow').window('close');
    }
     //判断是否有没有保存的记录
     function productpackhasmodified() {
            return hook;

     }


function initproductpackdetailview() {
  //判断是否显示功能按钮
  if (MODELSTATE === 'Added') {
    $('#deleteitem-btn-group').hide();
  } else {
    $('#deleteitem-btn-group').show();
  }

//回车光标移动到下个输入控件
    //如果是枚举类型需要把numberbox改成combobox
    //内装数量
	$('#InnerBoxQty').numberbox('textbox').bind('keydown', function (e) {
      if (e.keyCode == 13) {
        $(e.target).emulateTab();
