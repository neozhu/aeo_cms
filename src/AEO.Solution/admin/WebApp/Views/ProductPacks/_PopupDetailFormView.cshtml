        $(e.target).emulateTab();
      }
    });
    //所属产品默认外键使用combobox,也可以使用combogrid
	$('#ProductId').combobox('textbox').bind('keydown', function (e) {
      if (e.keyCode == 13) {
        $(e.target).emulateTab();
      }
    });
}
</script>

