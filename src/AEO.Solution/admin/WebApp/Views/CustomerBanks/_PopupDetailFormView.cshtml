<!-- 弹出窗体form表单 -->
<!-- 弹出编辑对话框 -->

<!--begin popup detailview javascript block -->
<script type="text/javascript">
    //判断新增编辑状态
    var MODELSTATE = 'Added';
    var customerbankid = null;
    function opencustomerbankdetailwindow(data,state) {
         MODELSTATE = state;
         initcustomerbankdetailview();
         customerbankid = (data.Id || 0);
         $('#customerbankdetailwindow').window('open');
         $('#customerbank_form').form('reset');
         $('#customerbank_form').form('load', data);
             }
  //删除当前记录
  function deletecustomerbankitem() {
    $.messager.confirm('确认', '你确定要删除该记录?', result => {
      if (result) {
        const url = `/CustomerBanks/Delete/${customerbankid}`;
        $.get(url).done(res => {
          if (res.success) {
            toastr.success("删除成功");
            $('#customerbankdetailwindow').window('close');
            reloadData();
          } else {
            $.messager.alert('错误', res.err, 'error');
          }
        });
      }
    });
  }
    //async 保存数据
    async function savecustomerbankitem() { 
      const $customerbankform = $('#customerbank_form');
      if ($customerbankform.form('enableValidation').form('validate')) {
            let customerbank = $customerbankform.serializeJSON();
            let url = '/CustomerBanks/Edit';
            //判断是新增或是修改方法
            if (MODELSTATE === 'Added') {
                url = '/CustomerBanks/Create';
            }
            var token = $('input[name="__RequestVerificationToken"]', $customerbankform).val();
            $.ajax({
                    type: "POST",
                    url: url,
                    data: {
                        __RequestVerificationToken: token,
                        customerbank:customerbank
                    },
                    dataType: 'json',
                    contentType: 'application/x-www-form-urlencoded; charset=utf-8'
                })
                .done(response => {
                    if (response.success) {
                        hook = false;
                        $customerbankform.form('disableValidation');
                        $('#customerbankdetailwindow').window("close");
                        toastr.success("保存成功"); 
                        reloadData();
                    } else {
                        $.messager.alert("错误",   response.err, "error");
                    }
                    })
                .fail((jqXHR, textStatus, errorThrown) => {
                       $.messager.alert('异常', `${jqXHR.status}: ${jqXHR.statusText} `, 'error');
                    });
        }
    }
    //关闭窗口
    function closecustomerbankdetailwindow() {
        $('#customerbankdetailwindow').window('close');
    }
     //判断是否有没有保存的记录
     function customerbankhasmodified() {
            return hook;

     }


function initcustomerbankdetailview() {
  //判断是否显示功能按钮
  if (MODELSTATE === 'Added') {
    $('#deleteitem-btn-group').hide();
  } else {
    $('#deleteitem-btn-group').show();
  }

//回车光标移动到下个输入控件
    //所属客户默认外键使用combobox,也可以使用combogrid
	$('#CustomerId').combobox('textbox').bind('keydown', function (e) {
      if (e.keyCode == 13) {
        $(e.target).emulateTab();
      }
    });
}
</script>

