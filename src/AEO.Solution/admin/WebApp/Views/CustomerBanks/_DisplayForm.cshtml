﻿@model WebApp.Models.CustomerBank
  <div class="form-row">
   @Html.HiddenFor(x=>x.Id)
         <!--客户编号(保存时系统自动分配也可以手工选择)-->
        <div class="col-xs-12 col-md-6">
            <label class="form-label ">@Html.DisplayNameFor(model => model.CustomerCode)</label>
			@Html.EditorFor(x => x.CustomerCode, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.CustomerCode) } })
      
         </div>

        <!--单位名称-->
        <div class="col-xs-12 col-md-6">
            <label class="form-label text-danger">@Html.DisplayNameFor(model => model.CustomerName)</label>
			@Html.EditorFor(x => x.CustomerName, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.CustomerName) } })
      
         </div>

        <!--开户名称-->
        <div class="col-xs-12 col-md-6">
            <label class="form-label text-danger">@Html.DisplayNameFor(model => model.AccountName)</label>
			@Html.EditorFor(x => x.AccountName, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.AccountName) } })
      
         </div>

        <!--银行名称-->
        <div class="col-xs-12 col-md-6">
            <label class="form-label ">@Html.DisplayNameFor(model => model.Bank)</label>
			@Html.EditorFor(x => x.Bank, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.Bank) } })
      
         </div>

        <!--银行账号-->
        <div class="col-xs-12 col-md-6">
            <label class="form-label text-danger">@Html.DisplayNameFor(model => model.AccountNo)</label>
			@Html.EditorFor(x => x.AccountNo, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.AccountNo) } })
      
         </div>

        <!--账户类型-->
        <div class="col-xs-12 col-md-6">
            <label class="form-label text-danger">@Html.DisplayNameFor(model => model.AccountType)</label>
			@Html.EditorFor(x => x.AccountType, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.AccountType) } })
      
         </div>

        <!--银行国家-->
        <div class="col-xs-12 col-md-6">
            <label class="form-label ">@Html.DisplayNameFor(model => model.BankCountry)</label>
			@Html.EditorFor(x => x.BankCountry, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.BankCountry) } })
      
         </div>

        <!--账户用途-->
        <div class="col-xs-12 col-md-6">
            <label class="form-label ">@Html.DisplayNameFor(model => model.BankUse)</label>
			@Html.EditorFor(x => x.BankUse, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.BankUse) } })
      
         </div>

        <!--开户行地址-->
        <div class="col-xs-12 col-md-6">
            <label class="form-label ">@Html.DisplayNameFor(model => model.BankAddress1)</label>
			@Html.EditorFor(x => x.BankAddress1, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.BankAddress1) } })
      
         </div>

        <!--开户行英文地址-->
        <div class="col-xs-12 col-md-6">
            <label class="form-label ">@Html.DisplayNameFor(model => model.BankAddress2)</label>
			@Html.EditorFor(x => x.BankAddress2, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.BankAddress2) } })
      
         </div>

        <!--SWIFT号-->
        <div class="col-xs-12 col-md-6">
            <label class="form-label ">@Html.DisplayNameFor(model => model.SWIFT)</label>
			@Html.EditorFor(x => x.SWIFT, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.SWIFT) } })
      
         </div>

        <!--币值-->
        <div class="col-xs-12 col-md-6">
            <label class="form-label ">@Html.DisplayNameFor(model => model.CUR)</label>
			@Html.EditorFor(x => x.CUR, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.CUR) } })
      
         </div>

        <!--备注说明-->
        <div class="col-xs-12 col-md-6">
            <label class="form-label ">@Html.DisplayNameFor(model => model.Remark)</label>
			@Html.EditorFor(x => x.Remark, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.Remark) } })
      
         </div>

     
       <!--所属客户-->
       <div class="col-xs-12 col-md-6">
            <label class="form-label text-danger">@Html.DisplayNameFor(model => model.CustomerId)</label>
   	        @Html.DropDownListFor(model => model.CustomerId, ViewBag.CustomerId as List<SelectListItem>, htmlAttributes: new { @class = "form-control" }) 
       </div>

	    
</div>

