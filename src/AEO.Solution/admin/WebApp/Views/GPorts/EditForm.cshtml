﻿@model WebApp.Models.GPort
  <div class="form-row">
   @Html.HiddenFor(x=>x.Id)
         <!--代码-->
        <div class="col-xs-12 col-sm-6 col-md-4 col-lg-3">
            <label class="form-label"> <span class="text-danger">*</span> @Html.DisplayNameFor(model => model.code)</label>
			@Html.EditorFor(x => x.code, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.code) } })
      
         </div>

        <!--中文名称-->
        <div class="col-xs-12 col-sm-6 col-md-4 col-lg-3">
            <label class="form-label">  @Html.DisplayNameFor(model => model.cn_name)</label>
			@Html.EditorFor(x => x.cn_name, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.cn_name) } })
      
         </div>

        <!--英文名称-->
        <div class="col-xs-12 col-sm-6 col-md-4 col-lg-3">
            <label class="form-label">  @Html.DisplayNameFor(model => model.en_name)</label>
			@Html.EditorFor(x => x.en_name, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.en_name) } })
      
         </div>

	    
</div>

