﻿@model WebApp.Models.ActionLog
<!-- 弹出编辑窗体表单 -->
 <div id="actionlogdetailwindow" class="easyui-window" 
      title="明细数据" 
      data-options="modal:true,
                    closed:true,
                    minimizable:false,
                    collapsible:false,
                    maximized:false,
                    iconCls:'fal fa-window',
                    onBeforeClose:function(){
                      var that = $(this);
                      if(actionloghasmodified()){
                        $.messager.confirm('确认','你确定要放弃保存修改的记录?',function(r){
                        if (r){
                          var opts = that.panel('options');
                          var onBeforeClose = opts.onBeforeClose;
                          opts.onBeforeClose = function(){};
                          that.panel('close');
                          opts.onBeforeClose = onBeforeClose;
                          hook = false;
                        }
                        });
                        return false;
                      }
                    },
                    onOpen:function(){
                       $(this).window('vcenter');
                       $(this).window('hcenter');
                    },
                    onRestore:function(){
                    },
                    onMaximize:function(){
                    }
                    " style="width:800px;height:450px;display:none">
  <!-- toolbar -->
  <div class="panel-content py-2 rounded-bottom border-faded border-left-0 border-right-0  text-muted bg-subtlelight-fade sticky-top">
  <div class="d-flex flex-row-reverse pr-4">
        <div class="btn-group btn-group-sm mr-1">
          <button name="saveitembutton" onclick="saveactionlogitem()" class="btn btn-default">
            <i class="fal fa-save"></i> @Html.L("Save")
          </button>
        </div>
        <div class="btn-group btn-group-sm mr-1" id="deleteitem-btn-group">
          <button onclick="deleteactionlogitem()" class="btn btn-danger">
            <i class="fal fa-trash-alt"></i> @Html.L("Delete")
          </button>
        </div>
    </div>
  </div>
 <!-- panel container form  -->
 <div class="panel-container show">
   <div class="container">
    <div class="panel-content">
           <form id="actionlog_form" 
              class="easyui-form form-horizontal padding-10" 
              method="post" 
              data-options="novalidate:true,
                            onChange: function(target){
                              hook = true;
                              $('button[name*=\'saveitembutton\']').prop('disabled', false);
                             },
                             onLoadSuccess:function(data){
                               hook = false;
                               $('button[name*=\'saveitembutton\']').prop('disabled', true);
                             }">
  @Html.AntiForgeryToken()
   <!--Primary Key-->
  @Html.HiddenFor(model=>model.Id)
   <fieldset class="form-group">
   <div class="row h-100 align-items-center">

   <!--关联ID-->
       <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"><span class="text-danger">*</span> @Html.DisplayNameFor(model => model.RefId)</label>
	   <div class="col-md-4 mb-1 pl-1">  
			<input id="@Html.IdFor(model => model.RefId)"
				   name="@Html.NameFor(model => model.RefId)" 
				   value="@Html.ValueFor(model => model.RefId)"
				   tabindex="0" 
				   class="easyui-numberbox" 
                   style="width:100%"
				   type="text" 
				   data-options="prompt:'@Html.DescriptionFor(model => model.RefId)',
								 required:true,formatter:intformatter,
                                 parser:parsernumber,
                                 " />
      </div>
				   
   <!--关联单号-->
        <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"> @Html.DisplayNameFor(model => model.RekKey)</label>
		<div class="col-md-4 mb-1 pl-1">  
			<input id="@Html.IdFor(model => model.RekKey)" 
				   name="@Html.NameFor(model => model.RekKey)" 
				   value="@Html.ValueFor(model => model.RekKey)"
				   tabindex="1" 
				   class="easyui-textbox" 
                   style="width:100%"
				   type="text" 
				   data-options="prompt:'@Html.DescriptionFor(model => model.RekKey)',
								 required:false, 
                                 validType: 'length[0,128]'
                                 " />
       </div>
				   

   <!--操作事件-->
      <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"><span class="text-danger">*</span> @Html.DisplayNameFor(model => model.ActionDateTime)</label>
		<div class="col-md-4 mb-1 pl-1">  
			<input id="@Html.IdFor(model => model.ActionDateTime)" 
			       name="@Html.NameFor(model => model.ActionDateTime)" 
                   value="@Html.ValueFor(model => model.ActionDateTime)"
				   tabindex="2" required
				   class="easyui-datetimebox" 
                   style="width:100%"
				   type="text" 
				   data-options="prompt:'@Html.DescriptionFor(model => model.ActionDateTime)',
								 required:true,
								 formatter:datetimeformatter" />
    </div>
				   
   <!--操作人员-->
        <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"> @Html.DisplayNameFor(model => model.User)</label>
		<div class="col-md-4 mb-1 pl-1">  
			<input id="@Html.IdFor(model => model.User)" 
				   name="@Html.NameFor(model => model.User)" 
				   value="@Html.ValueFor(model => model.User)"
				   tabindex="3" 
				   class="easyui-textbox" 
                   style="width:100%"
				   type="text" 
				   data-options="prompt:'@Html.DescriptionFor(model => model.User)',
								 required:false, 
                                 validType: 'length[0,20]'
                                 " />
       </div>
				   

   <!--操作类型-->
        <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"> @Html.DisplayNameFor(model => model.Action)</label>
		<div class="col-md-4 mb-1 pl-1">  
			<input id="@Html.IdFor(model => model.Action)" 
				   name="@Html.NameFor(model => model.Action)" 
				   value="@Html.ValueFor(model => model.Action)"
				   tabindex="4" 
				   class="easyui-textbox" 
                   style="width:100%"
				   type="text" 
				   data-options="prompt:'@Html.DescriptionFor(model => model.Action)',
								 required:false, 
                                 validType: 'length[0,20]'
                                 " />
       </div>
				   
   <!--操作内容-->
        <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"> @Html.DisplayNameFor(model => model.Content)</label>
		<div class="col-md-4 mb-1 pl-1">  
			<input id="@Html.IdFor(model => model.Content)" 
				   name="@Html.NameFor(model => model.Content)" 
				   value="@Html.ValueFor(model => model.Content)"
				   tabindex="5" 
				   class="easyui-textbox" 
                   style="width:100%"
				   type="text" 
				   data-options="prompt:'@Html.DescriptionFor(model => model.Content)',
								 required:false, 
                                 validType: 'length[0,128]'
                                 " />
       </div>
				   

     <!--同步标志-->
       <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"><span class="text-danger">*</span> @Html.DisplayNameFor(model => model.Flag)</label>
	   <div class="col-md-4 mb-1 pl-1">      
               <div class="custom-control custom-checkbox pt-1">
                            <input id="@Html.IdFor(model => model.Flag)"
                                   name="@Html.NameFor(model => model.Flag)"
                                   value="true" @(Model.Flag ? "checked=\"checked\"" : "")
                                   data-unchecked-value="false"
                                   tabindex="6"
                                   class="custom-control-input"
                                   type="checkbox" />
                            <label class="custom-control-label" for="@Html.NameFor(model => model.Flag)"> @Html.DisplayNameFor(model => model.Flag)</label>
              </div>
        </div>
				   
	    </div> 
      </fieldset>
   </form>
    </div>
    </div>
    </div>
</div>

<!-- 弹出窗体form表单 -->
<!-- 弹出编辑对话框 -->

<!--begin popup detailview javascript block -->
<script type="text/javascript">
    //判断新增编辑状态
    var MODELSTATE = 'Added';
    var actionlogid = null;
    function openactionlogdetailwindow(data,state) {
         MODELSTATE = state;
         initactionlogdetailview();
         actionlogid = (data.Id || 0);
         $('#actionlogdetailwindow').window('open');
         $('#actionlog_form').form('reset');
         $('#actionlog_form').form('load', data);
             }
  //删除当前记录
  function deleteactionlogitem() {
    $.messager.confirm('确认', '你确定要删除该记录?', result => {
      if (result) {
        const url = `/ActionLogs/Delete/${actionlogid}`;
        $.get(url).done(res => {
          if (res.success) {
            toastr.success("删除成功");
            $('#actionlogdetailwindow').window('close');
            reloadData();
          } else {
            $.messager.alert('错误', res.err, 'error');
          }
        });
      }
    });
  }
    //async 保存数据
    async function saveactionlogitem() { 
      const $actionlogform = $('#actionlog_form');
      if ($actionlogform.form('enableValidation').form('validate')) {
            let actionlog = $actionlogform.serializeJSON();
            let url = '/ActionLogs/Edit';
            //判断是新增或是修改方法
            if (MODELSTATE === 'Added') {
                url = '/ActionLogs/Create';
            }
            var token = $('input[name="__RequestVerificationToken"]', $actionlogform).val();
            $.ajax({
                    type: "POST",
                    url: url,
                    data: {
                        __RequestVerificationToken: token,
                        actionlog:actionlog
                    },
                    dataType: 'json',
                    contentType: 'application/x-www-form-urlencoded; charset=utf-8'
                })
                .done(response => {
                    if (response.success) {
                        hook = false;
                        $actionlogform.form('disableValidation');
                        $('#actionlogdetailwindow').window("close");
                        toastr.success("保存成功"); 
                        reloadData();
                    } else {
                        $.messager.alert("错误",   response.err, "error");
                    }
                    })
                .fail((jqXHR, textStatus, errorThrown) => {
                       $.messager.alert('异常', `${jqXHR.status}: ${jqXHR.statusText} `, 'error');
                    });
        }
    }
    //关闭窗口
    function closeactionlogdetailwindow() {
        $('#actionlogdetailwindow').window('close');
    }
     //判断是否有没有保存的记录
     function actionloghasmodified() {
            return hook;

     }


function initactionlogdetailview() {
  //判断是否显示功能按钮
  if (MODELSTATE === 'Added') {
    $('#deleteitem-btn-group').hide();
  } else {
    $('#deleteitem-btn-group').show();
  }

//回车光标移动到下个输入控件
    //如果是枚举类型需要把numberbox改成combobox
    //关联ID
	$('#RefId').numberbox('textbox').bind('keydown', function (e) {
      if (e.keyCode == 13) {
        $(e.target).emulateTab();
      }
    });
    //日期类型 操作事件
	$('#ActionDateTime').datebox('textbox').bind('keydown', function (e) {
      if (e.keyCode == 13) {
        $(e.target).emulateTab();
      }
    });
}
</script>

