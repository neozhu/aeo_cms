﻿@model WebApp.Models.ActionLog
  <div class="form-row">
   @Html.HiddenFor(x=>x.Id)
 		<!--关联ID-->
        <div class="col-xs-12 col-sm-6 col-md-4 col-lg-3">
            <label class="form-label"> <span class="text-danger">*</span> @Html.DisplayNameFor(model => model.RefId)</label>
            @Html.EditorFor(x => x.RefId, new { htmlAttributes = new { @class = "form-control",@type="number", placeholder = Html.DisplayNameFor(x => x.RefId) } })

        </div>

        <!--关联单号-->
        <div class="col-xs-12 col-sm-6 col-md-4 col-lg-3">
            <label class="form-label">  @Html.DisplayNameFor(model => model.RekKey)</label>
			@Html.EditorFor(x => x.RekKey, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.RekKey) } })
      
         </div>

       <!--操作事件-->
       <div class="col-xs-12 col-sm-6 col-md-4 col-lg-3">
            <label class="form-label"> <span class="text-danger">*</span> @Html.DisplayNameFor(model => model.ActionDateTime)</label>
            <div class="input-group">
			  @Html.EditorFor(x => x.ActionDateTime, 
                         new { htmlAttributes = new { @class = "form-control datepicker",
                               placeholder = Html.DisplayNameFor(x => x.ActionDateTime ) } })
               <div class="input-group-append">
                                                            <span class="input-group-text fs-xl">
                                                                <i class="fal fa-calendar-alt"></i>
                                                            </span>
                                                        </div>
			 </div>
         </div>

        <!--操作人员-->
        <div class="col-xs-12 col-sm-6 col-md-4 col-lg-3">
            <label class="form-label">  @Html.DisplayNameFor(model => model.User)</label>
			@Html.EditorFor(x => x.User, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.User) } })
      
         </div>

        <!--操作类型-->
        <div class="col-xs-12 col-sm-6 col-md-4 col-lg-3">
            <label class="form-label">  @Html.DisplayNameFor(model => model.Action)</label>
			@Html.EditorFor(x => x.Action, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.Action) } })
      
         </div>

        <!--操作内容-->
        <div class="col-xs-12 col-sm-6 col-md-4 col-lg-3">
            <label class="form-label">  @Html.DisplayNameFor(model => model.Content)</label>
			@Html.EditorFor(x => x.Content, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.Content) } })
      
         </div>

		
      <!--同步标志-->
      <div class="col-xs-12 col-sm-6 col-md-4 col-lg-3">
              <label class="form-label"> <span class="text-danger">*</span> @Html.DisplayNameFor(model => model.Flag)</label>
              <div class="custom-control custom-checkbox">
                 <input id="@Html.IdFor(model => model.Flag)"
                       name="@Html.NameFor(model => model.Flag)"
                       value="true" @(Model.Flag ? "checked=\"checked\"" : "")
                       class="custom-control-input"
                       tabindex="6"
                       type="checkbox" />
                <label class="custom-control-label" for="@Html.IdFor(model => model.Flag)">@Html.DisplayNameFor(model => model.Flag)</label>
            </div>
      </div>

	    
</div>

