﻿@model WebApp.Models.CustomerFile
<!-- 弹出编辑窗体表单 -->
 <div id="customerfiledetailwindow" class="easyui-window" 
      title="明细数据" 
      data-options="modal:true,
                    closed:true,
                    minimizable:false,
                    collapsible:false,
                    maximized:false,
                    iconCls:'fal fa-window',
                    onBeforeClose:function(){
                      var that = $(this);
                      if(customerfilehasmodified()){
                        $.messager.confirm('确认','你确定要放弃保存修改的记录?',function(r){
                        if (r){
                          var opts = that.panel('options');
                          var onBeforeClose = opts.onBeforeClose;
                          opts.onBeforeClose = function(){};
                          that.panel('close');
                          opts.onBeforeClose = onBeforeClose;
                          hook = false;
                        }
                        });
                        return false;
                      }
                    },
                    onOpen:function(){
                       $(this).window('vcenter');
                       $(this).window('hcenter');
                    },
                    onRestore:function(){
                    },
                    onMaximize:function(){
                    }
                    " style="width:800px;height:450px;display:none">
  <!-- toolbar -->
  <div class="panel-content py-2 rounded-bottom border-faded border-left-0 border-right-0  text-muted bg-subtlelight-fade sticky-top">
  <div class="d-flex flex-row-reverse pr-4">
        <div class="btn-group btn-group-sm mr-1">
          <button name="saveitembutton" onclick="savecustomerfileitem()" class="btn btn-default">
            <i class="fal fa-save"></i> @Html.L("Save")
          </button>
        </div>
        <div class="btn-group btn-group-sm mr-1" id="deleteitem-btn-group">
          <button onclick="deletecustomerfileitem()" class="btn btn-danger">
            <i class="fal fa-trash-alt"></i> @Html.L("Delete")
          </button>
        </div>
    </div>
  </div>
 <!-- panel container form  -->
 <div class="panel-container show">
   <div class="container">
    <div class="panel-content">
           <form id="customerfile_form" 
              class="easyui-form form-horizontal padding-10" 
              method="post" 
              data-options="novalidate:true,
                            onChange: function(target){
                              hook = true;
                              $('button[name*=\'saveitembutton\']').prop('disabled', false);
                             },
                             onLoadSuccess:function(data){
                               hook = false;
                               $('button[name*=\'saveitembutton\']').prop('disabled', true);
                             }">
  @Html.AntiForgeryToken()
   <!--Primary Key-->
  @Html.HiddenFor(model=>model.Id)
   <fieldset class="form-group">
   <div class="row h-100 align-items-center">

   <!--文件名-->
        <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"><span class="text-danger">*</span> @Html.DisplayNameFor(model => model.FileName)</label>
		<div class="col-md-4 mb-1 pl-1">  
			<input id="@Html.IdFor(model => model.FileName)" 
				   name="@Html.NameFor(model => model.FileName)" 
				   value="@Html.ValueFor(model => model.FileName)"
				   tabindex="0" required
				   class="easyui-textbox" 
                   style="width:100%"
				   type="text" 
				   data-options="prompt:'@Html.DescriptionFor(model => model.FileName)',
								 required:true, 
                                 validType: 'length[0,100]'
                                 " />
       </div>
				   
   <!--大小-->
       <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"><span class="text-danger">*</span> @Html.DisplayNameFor(model => model.Size)</label>
	   <div class="col-md-4 mb-1 pl-1">  
             <input id="@Html.IdFor(model => model.Size)"
				   name="@Html.NameFor(model => model.Size)" 
				   value="@Html.ValueFor(model => model.Size)"
				   tabindex="1" 
				   class="easyui-numberbox" 
                   style="width:100%"
				   type="text" 
				   data-options="prompt:'@Html.DescriptionFor(model => model.Size)',
								 required:true,formatter:numberformatter,
                                 parser:parsernumber,precision:2,
                                 
                                 "  />

        </div>
				   

   <!--目录-->
        <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"> @Html.DisplayNameFor(model => model.Folder)</label>
		<div class="col-md-4 mb-1 pl-1">  
			<input id="@Html.IdFor(model => model.Folder)" 
				   name="@Html.NameFor(model => model.Folder)" 
				   value="@Html.ValueFor(model => model.Folder)"
				   tabindex="2" 
				   class="easyui-textbox" 
                   style="width:100%"
				   type="text" 
				   data-options="prompt:'@Html.DescriptionFor(model => model.Folder)',
								 required:false, 
                                 validType: 'length[0,20]'
                                 " />
       </div>
				   
   <!--保存路径-->
        <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"> @Html.DisplayNameFor(model => model.FilePath)</label>
		<div class="col-md-4 mb-1 pl-1">  
			<input id="@Html.IdFor(model => model.FilePath)" 
				   name="@Html.NameFor(model => model.FilePath)" 
				   value="@Html.ValueFor(model => model.FilePath)"
				   tabindex="3" 
				   class="easyui-textbox" 
                   style="width:100%"
				   type="text" 
				   data-options="prompt:'@Html.DescriptionFor(model => model.FilePath)',
								 required:false, 
                                 validType: 'length[0,50]'
                                 " />
       </div>
				   

   <!--相对路径-->
        <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"> @Html.DisplayNameFor(model => model.RelativePath)</label>
		<div class="col-md-4 mb-1 pl-1">  
			<input id="@Html.IdFor(model => model.RelativePath)" 
				   name="@Html.NameFor(model => model.RelativePath)" 
				   value="@Html.ValueFor(model => model.RelativePath)"
				   tabindex="4" 
				   class="easyui-textbox" 
                   style="width:100%"
				   type="text" 
				   data-options="prompt:'@Html.DescriptionFor(model => model.RelativePath)',
								 required:false, 
                                 validType: 'length[0,50]'
                                 " />
       </div>
				   
   <!--上传用户-->
        <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"> @Html.DisplayNameFor(model => model.Owner)</label>
		<div class="col-md-4 mb-1 pl-1">  
			<input id="@Html.IdFor(model => model.Owner)" 
				   name="@Html.NameFor(model => model.Owner)" 
				   value="@Html.ValueFor(model => model.Owner)"
				   tabindex="5" 
				   class="easyui-textbox" 
                   style="width:100%"
				   type="text" 
				   data-options="prompt:'@Html.DescriptionFor(model => model.Owner)',
								 required:false, 
                                 validType: 'length[0,20]'
                                 " />
       </div>
				   

   <!--上传时间-->
        <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"><span class="text-danger">*</span> @Html.DisplayNameFor(model => model.Upload)</label>
		<div class="col-md-4 mb-1 pl-1">  
                <input id="@Html.IdFor(model => model.Upload)" 
			       name="@Html.NameFor(model => model.Upload)"
                   value="@Html.ValueFor(model => model.Upload)"
           		   tabindex="6"  required
				   class="easyui-datebox" 
                   style="width:100%"
				   type="text" 
				   data-options="prompt:'@Html.DescriptionFor(model => model.Upload)',
								 required:true,
								 formatter:dateformatter" />
     </div>
				   
   <!--附件类型-->
        <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"> @Html.DisplayNameFor(model => model.Ext)</label>
		<div class="col-md-4 mb-1 pl-1">  
			<input id="@Html.IdFor(model => model.Ext)" 
				   name="@Html.NameFor(model => model.Ext)" 
				   value="@Html.ValueFor(model => model.Ext)"
				   tabindex="7" 
				   class="easyui-textbox" 
                   style="width:100%"
				   type="text" 
				   data-options="prompt:'@Html.DescriptionFor(model => model.Ext)',
								 required:false, 
                                 validType: 'length[0,100]'
                                 " />
       </div>
				   

   <!--文件ID-->
        <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"> @Html.DisplayNameFor(model => model.FileId)</label>
		<div class="col-md-4 mb-1 pl-1">  
			<input id="@Html.IdFor(model => model.FileId)" 
				   name="@Html.NameFor(model => model.FileId)" 
				   value="@Html.ValueFor(model => model.FileId)"
				   tabindex="8" 
				   class="easyui-textbox" 
                   style="width:100%"
				   type="text" 
				   data-options="prompt:'@Html.DescriptionFor(model => model.FileId)',
								 required:false, 
                                 validType: 'length[0,100]'
                                 " />
       </div>
				   
   <!--关联单号-->
        <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"> @Html.DisplayNameFor(model => model.RefKey)</label>
		<div class="col-md-4 mb-1 pl-1">  
			<input id="@Html.IdFor(model => model.RefKey)" 
				   name="@Html.NameFor(model => model.RefKey)" 
				   value="@Html.ValueFor(model => model.RefKey)"
				   tabindex="9" 
				   class="easyui-textbox" 
                   style="width:100%"
				   type="text" 
				   data-options="prompt:'@Html.DescriptionFor(model => model.RefKey)',
								 required:false, 
                                 validType: 'length[0,100]'
                                 " />
       </div>
				   

   <!--客户编号-->
        <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"><span class="text-danger">*</span> @Html.DisplayNameFor(model => model.CustomerCode)</label>
		<div class="col-md-4 mb-1 pl-1">  
			<input id="@Html.IdFor(model => model.CustomerCode)" 
				   name="@Html.NameFor(model => model.CustomerCode)" 
				   value="@Html.ValueFor(model => model.CustomerCode)"
				   tabindex="10" required
				   class="easyui-textbox" 
                   style="width:100%"
				   type="text" 
				   data-options="prompt:'@Html.DescriptionFor(model => model.CustomerCode)',
								 required:true, 
                                 validType: 'length[0,20]'
                                 " />
       </div>
				   
   <!--客户名称-->
        <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"><span class="text-danger">*</span> @Html.DisplayNameFor(model => model.CustomerName)</label>
		<div class="col-md-4 mb-1 pl-1">  
			<input id="@Html.IdFor(model => model.CustomerName)" 
				   name="@Html.NameFor(model => model.CustomerName)" 
				   value="@Html.ValueFor(model => model.CustomerName)"
				   tabindex="11" required
				   class="easyui-textbox" 
                   style="width:100%"
				   type="text" 
				   data-options="prompt:'@Html.DescriptionFor(model => model.CustomerName)',
								 required:true, 
                                 validType: 'length[0,80]'
                                 " />
       </div>
				   

    <!--所属客户-->
        <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"><span class="text-danger">*</span> @Html.DisplayNameFor(model => model.CustomerId)</label>
		<div class="col-md-4 mb-1 pl-1">   	
            <input id="@Html.IdFor(model => model.CustomerId)"
			       name="@Html.NameFor(model => model.CustomerId)"
				   value="@Html.ValueFor(model => model.CustomerId)"
                   tabindex="12" required
              	   class="easyui-combobox"      
                   style="width:100%"
                   data-options="prompt:'@Html.DescriptionFor(model => model.CustomerId)' ,
						required:true ,
						valueField: 'Id',
						textField:  'CustomerCode' ,
                        validateOnCreate:false,
                        validateOnBlur:true,
                        validType:'combocheck[\'#CustomerId\',\'请选择所属客户\']',
						url: '/CustomerFiles/GetCustomers' ,
						onSelect: function(item){
						  //console.log(item);
				        }">
       </div>
	   
	    </div> 
      </fieldset>
   </form>
    </div>
    </div>
    </div>
</div>

<!-- 弹出窗体form表单 -->
<!-- 弹出编辑对话框 -->

<!--begin popup detailview javascript block -->
<script type="text/javascript">
    //判断新增编辑状态
    var MODELSTATE = 'Added';
    var customerfileid = null;
    function opencustomerfiledetailwindow(data,state) {
         MODELSTATE = state;
         initcustomerfiledetailview();
         customerfileid = (data.Id || 0);
         $('#customerfiledetailwindow').window('open');
         $('#customerfile_form').form('reset');
         $('#customerfile_form').form('load', data);
             }
  //删除当前记录
  function deletecustomerfileitem() {
    $.messager.confirm('确认', '你确定要删除该记录?', result => {
      if (result) {
        const url = `/CustomerFiles/Delete/${customerfileid}`;
        $.get(url).done(res => {
          if (res.success) {
            toastr.success("删除成功");
            $('#customerfiledetailwindow').window('close');
            reloadData();
          } else {
            $.messager.alert('错误', res.err, 'error');
          }
        });
      }
    });
  }
    //async 保存数据
    async function savecustomerfileitem() { 
      const $customerfileform = $('#customerfile_form');
      if ($customerfileform.form('enableValidation').form('validate')) {
            let customerfile = $customerfileform.serializeJSON();
            let url = '/CustomerFiles/Edit';
            //判断是新增或是修改方法
            if (MODELSTATE === 'Added') {
                url = '/CustomerFiles/Create';
            }
            var token = $('input[name="__RequestVerificationToken"]', $customerfileform).val();
            $.ajax({
                    type: "POST",
                    url: url,
                    data: {
                        __RequestVerificationToken: token,
                        customerfile:customerfile
                    },
                    dataType: 'json',
                    contentType: 'application/x-www-form-urlencoded; charset=utf-8'
                })
                .done(response => {
                    if (response.success) {
                        hook = false;
                        $customerfileform.form('disableValidation');
                        $('#customerfiledetailwindow').window("close");
                        toastr.success("保存成功"); 
                        reloadData();
                    } else {
                        $.messager.alert("错误",   response.err, "error");
                    }
                    })
                .fail((jqXHR, textStatus, errorThrown) => {
                       $.messager.alert('异常', `${jqXHR.status}: ${jqXHR.statusText} `, 'error');
                    });
        }
    }
    //关闭窗口
    function closecustomerfiledetailwindow() {
        $('#customerfiledetailwindow').window('close');
    }
     //判断是否有没有保存的记录
     function customerfilehasmodified() {
            return hook;

     }


function initcustomerfiledetailview() {
  //判断是否显示功能按钮
  if (MODELSTATE === 'Added') {
    $('#deleteitem-btn-group').hide();
  } else {
    $('#deleteitem-btn-group').show();
  }

//回车光标移动到下个输入控件
    //如果是枚举类型需要把numberbox改成combobox
    //大小
	$('#Size').numberbox('textbox').bind('keydown', function (e) {
      if (e.keyCode == 13) {
        $(e.target).emulateTab();
      }
    });
    //日期类型 上传时间
	$('#Upload').datebox('textbox').bind('keydown', function (e) {
      if (e.keyCode == 13) {
        $(e.target).emulateTab();
      }
    });
    //所属客户默认外键使用combobox,也可以使用combogrid
	$('#CustomerId').combobox('textbox').bind('keydown', function (e) {
      if (e.keyCode == 13) {
        $(e.target).emulateTab();
      }
    });
}
</script>

