@model WebApp.Models.InquiryProduct
<script type="text/javascript">
  //全屏事件
  document.addEventListener('panel.onfullscreen', () => {
       $inquiryproductdg.datagrid('resize');
   });
    //是否开启行内编辑
    var SUBEDITINLINE = true;
   //初始化 InquiryProduct datagrid
   var $inquiryproductdg = $('#inquiryproduct_datagrid');
   //当前行记录
   var inquiryproduct = {};
   //datagrid CRUD method
    var inquiryproduct_editIndex = undefined;
    //取消编辑恢复状态
    function inquiryproduct_rejectChanges() {
		$inquiryproductdg.datagrid('rejectChanges');
		inquiryproduct_editIndex = undefined;
    }
    //重新加载数据
    function inquiryproduct_reloadData() {
			    $inquiryproductdg.datagrid('unselectAll');
            $inquiryproductdg.datagrid('uncheckAll');
	        $inquiryproductdg.datagrid('reload');
	}

    //双击弹出编辑当前行对话框
    function inquiryproduct_onDblClickRow(index, row) {
            open_inquiryproductdlg(index, row, 'Modified');
    }
    //订阅对话框新增返回事件
    $(document).on('inquiryproduct_form.add', (e, index,item) => {
        $inquiryproductdg.datagrid("insertRow",
            {
                index: 0,
                row: item
            });
        $("button[name*='inquiryproduct_cancelchangesbutton']").prop('disabled', false);
        $("button[name*='inquiryproduct_savechangesbutton']").prop('disabled', false);
    });
    //订阅对话框修改返回事件
    $(document).on('inquiryproduct_form.edit', (e,index, item) => {
        $inquiryproductdg.datagrid('updateRow', {
            index: index,
            row: item
        });
        $("button[name*='inquiryproduct_cancelchangesbutton']").prop('disabled', false);
        $("button[name*='inquiryproduct_savechangesbutton']").prop('disabled', false);
    });
  //复制新增
  function inquiryproduct_copyItem() {
    var items = $inquiryproductdg.datagrid('getChecked');
    if (items.length > 0) {
      items.map(item => {
         var product = {
          InquiryId: $('#inquiry_form #Id').val(),
          InquiryNo: $('#inquiry_form #InquiryNo').textbox('getValue'),
          ProductNo: item.ProductNo,
          ProductName: item.ProductName,
          CategoryName: item.CategoryName,
          Qty:item.Qty,
          ProductEnName: item.ProductEnName,
          CnDescription: item.CnDescription,
          EnDescription: item.EnDescription,
          Unit: item.Unit,
          SamplePic: item.SamplePic,
          Executor: $.getusername(),
          TaskNo:item.TaskNo,
        };
        $inquiryproductdg.datagrid("insertRow",
          {
            index: 0,
            row: product
          });
      });
      $("button[name*='saveitembutton']").prop('disabled', false);
      $("button[name*='_deleterowbutton']").prop('disabled', false);
      $("button[name*='_cancelchangesbutton']").prop('disabled', false);
      $("button[name*='_savechangesbutton']").prop('disabled', false);
    } else {
      $.messager.alert('提示', '请选择需要复制的记录');
    }
  }
    //新增记录
    function inquiryproduct_appendItem() {
      const $inquiryform = $('#inquiry_form');
      if ($inquiryform.form('enableValidation').form('validate')) {
        const inquiry = $inquiryform.serializeJSON();
        const item = {
          Price: null,
          InquiryId: inquiry.Id,
          InquiryNo: inquiry.InquiryNo,
          Qty:null,
        };
        $('#selectproductwindow').dialog('open')
      }

	 }
    //删除编辑的行
	function inquiryproduct_removeItem() {
    inquiryproduct_deleteChecked()
	}
    //删除选中的行
    function inquiryproduct_deleteChecked() {
            const rows = $inquiryproductdg.datagrid('getChecked');
            if (rows.length > 0) {
                var id = rows.filter(item=>item.Id!=null).map(item => {
                    return item.Id;
                });
                $.messager.confirm('确认', `你确定要删除这 <span class='badge bg-color-red'>${id.length}</span> 行记录?`,result => {
                    if (result) {
                        $.post('/InquiryProducts/DeleteChecked', { id: id })
                         .done(response => {
                            if (response.success) {
                                $inquiryproductdg.datagrid('reload');
                            } else {
                                $.messager.alert('错误', response.err,'error');
                            }
                         });
                    }
                });
            } else {
                $.messager.alert('提示', '请先选择要删除的记录!','question');
            }
      }
  //获取修改的行
  function inquiryproduct_getChanges() {
    if ($inquiryproductdg.datagrid('getChanges').length > 0) {
      const inserted = $inquiryproductdg.datagrid('getChanges', 'inserted').map(item => {
        item.TrackingState = 1;
        return item;
      });
      const deleted = $inquiryproductdg.datagrid('getChanges', 'deleted').map(item => {
        item.TrackingState = 3;
        return item;
      });
      const updated = $inquiryproductdg.datagrid('getChanges', 'updated').map(item => {
        item.TrackingState = 2;
        return item;
      });
      //过滤已删除的重复项
      const changed = inserted.concat(updated.filter(item => {
        return !deleted.includes(item);
      })).concat(deleted);
      return { success: true, changed };
    } else {
      return { success: true, changed: undefined };
    }

  }
  //提交修改的数据
  //function inquiryproduct_acceptChanges() {
  //  $inquiryproductdg.datagrid('acceptChanges');
  //}
  //提交保存后台数据库
  async function inquiryproduct_acceptChanges() {
    if ($inquiryproductdg.datagrid('getChanges').length > 0) {
      const inserted = $inquiryproductdg.datagrid('getChanges', 'inserted').map(item => {
        item.TrackingState = 1;
        return item;
      });
      const deleted = $inquiryproductdg.datagrid('getChanges', 'deleted').map(item => {
        item.TrackingState = 3;
        return item;
      });
      const updated = $inquiryproductdg.datagrid('getChanges', 'updated').map(item => {
        item.TrackingState = 2;
        return item;
      });
      //过滤已删除的重复项
      const changed = inserted.concat(updated.filter(item => {
        return !deleted.includes(item);
      })).concat(deleted);
      //console.table(changed);
      if (MODELSTATE === 'Added') {
        return { success: true, changed };
      } else {
        const response = await $.post('/InquiryProducts/AcceptChanges', { inquiryproducts: changed });
        response.changed = undefined;
        if (response.success) {
          toastr.success('保存明细成功');
          $inquiryproductdg.datagrid('acceptChanges');
          inquiryproduct_reloadData()
          return { success: true };
        } else {
          $.messager.alert('错误', response.err, 'error');
          return { success: false, err: response.err };
        }
      }
    } else {
      return { success: true, changed: undefined };
    }

  }


  $(() => {
    $inquiryproductdg.datagrid({
      fit: false,
      height: 300,
      rownumbers: true,
      striped: true,
      idField: 'Id',
      sortName: 'Id',
      sortOrder: 'desc',
      remoteFilter: true,
      singleSelect: true,
      checkOnSelect: false,
      selectOnCheck: false,
      method: 'get',
      pageList: [10, 20, 50, 100, 1000],
      pagination: true,
      clientPaging: false,
      pagination: true,
      onDblClickRow: inquiryproduct_onDblClickRow,
      onBeforeLoad: function () {

      },
      onLoadSuccess: function (data) {
        inquiryproduct_editIndex = undefined;
        $("button[name*='inquiryproduct_deleterowbutton']").prop('disabled', true);
        $("button[name*='inquiryproduct_cancelchangesbutton']").prop('disabled', true);
        $("button[name*='inquiryproduct_savechangesbutton']").prop('disabled', true);
      },
      onCheck: function () {
        $("button[name*='inquiryproduct_deleterowbutton']").prop('disabled', false);
      },
      onUncheck: function () {
        const checked = $(this).datagrid('getChecked').length > 0;
        $("button[name*='inquiryproduct_deleterowbutton']").prop('disabled', !checked);
      },
      onCheckAll: function (rows) {
        if (rows.length > 0) {
          $("button[name*='inquiryproduct_deleterowbutton']").prop('disabled', false);
        }
      },
      onUncheckAll: function () {
        $("button[name*='inquiryproduct_deleterowbutton']").prop('disabled', true);
      },
      onSelect: function (index, row) {
        inquiryproduct = row;
      },
      onBeforeEdit: function (index, row) {
        inquiryproduct_editIndex = index;
        row.editing = true;
        $("button[name*='inquiryproduct_deleterowbutton']").prop('disabled', false);
        $("button[name*='inquiryproduct_cancelchangesbutton']").prop('disabled', false);
        $("button[name*='inquiryproduct_savechangesbutton']").prop('disabled', false);
        $(this).datagrid('refreshRow', index);
      },
      onBeginEdit: function (index, row) {
        //const editors = $(this).datagrid('getEditors', index);

      },
      onEndEdit: function (index, row) {

      },
      onAfterEdit: function (index, row) {
        row.editing = false;
        inquiryproduct_editIndex = undefined;
        $(this).datagrid('refreshRow', index);
      },
      onCancelEdit: function (index, row) {
        inquiryproduct_editIndex = undefined;
        row.editing = false;
        $("button[name*='inquiryproduct_deleterowbutton']").prop('disabled', true);
        $("button[name*='inquiryproduct_cancelchangesbutton']").prop('disabled', true);
        $("button[name*='inquiryproduct_savechangesbutton']").prop('disabled', true);
        $(this).datagrid('refreshRow', index);
      },
      columns: [[
        { field: 'ck', checkbox: true },

        {    /*产品编号(自动生成,可手工修改)*/
          field: 'ProductNo',
          title: '<span class="text-danger">*</span> @Html.DisplayNameFor(model => model.ProductNo)',
          width: 120,
          sortable: true,
          hidden: false,
          resizable: true
        },
        {    /*中文品名*/
          field: 'ProductName',
          title: '@Html.DisplayNameFor(model => model.ProductName)',
          width: 200,
          sortable: true,
          hidden: false,
          resizable: true
        },
        {    /*询价数量*/
          field: 'Qty',
          title: '<span class="text-danger">*</span>  @Html.DisplayNameFor(model => model.Qty)',
          width: 100,
          align: 'right',
          hidden: false,
          sortable: true,
          resizable: true,
          formatter: numberformatter
        },
        {    /*报价金额*/
          field: 'Price',
          title: '<span class="text-danger">*</span>  @Html.DisplayNameFor(model => model.Price)',
          width: 100,
          align: 'right',
          hidden: false,
          sortable: true,
          resizable: true,
          formatter: numberformatter
        },
        {    /*币种*/
          field: 'Cur',
          title: '  @Html.DisplayNameFor(model => model.Cur)',
          width: 120,
          sortable: true,
          hidden: false,
          resizable: true
        },
         {    /*价格类型*/
          field: 'PriceType',
          title: '<span class="text-danger">*</span>  @Html.DisplayNameFor(model => model.PriceType)',
          width: 120,
          sortable: true,
          hidden: false,
          resizable: true
        },
        {    /*单位*/
          field: 'Unit',
          title: '@Html.DisplayNameFor(model => model.Unit)',
          width: 120,
          sortable: true,
          hidden: false,
          resizable: true
        },
        {    /*执行人*/
          field: 'Executor',
          title: '<span class="text-danger">*</span>  @Html.DisplayNameFor(model => model.Executor)',
          width: 120,
          sortable: true,
          hidden: false,
          resizable: true
        },
        {    /*产品类别*/
          field: 'CategoryName',
          title: '@Html.DisplayNameFor(model => model.CategoryName)',
          width: 160,
          sortable: true,
          hidden: false,
          resizable: true
        },
        {    /*客户货号*/
          field: 'ThirdProductNo',
          title: '@Html.DisplayNameFor(model => model.ThirdProductNo)',
          width: 130,
          sortable: true,
          hidden: false,
          resizable: true
        },
        {    /*厂商名称*/
          field: 'SupplierName',
          title: '<span class="text-danger">*</span>  @Html.DisplayNameFor(model => model.SupplierName)',
          width: 200,
          sortable: true,
          hidden: false,
          resizable: true
        },
        {    /*厂商货号*/
          field: 'SupplierProductNo',
          title: '@Html.DisplayNameFor(model => model.SupplierProductNo)',
          width: 200,
          sortable: true,
          hidden: false,
          resizable: true
        },

        {    /*最小订单量*/
          field: 'MinQty',
          title: '@Html.DisplayNameFor(model => model.MinQty)',
          width: 100,
          align: 'right',
          hidden: false,
          sortable: true,
          resizable: true,
          formatter: numberformatter
        },
        {   /*厂价有效期*/
          field: 'PriceDate',
          title: '@Html.DisplayNameFor(model => model.PriceDate)',
          width: 100,
          align: 'right',
          hidden: false,
          sortable: true,
          resizable: true,
          formatter: dateformatter
        },
        {    /*反馈说明*/
          field: 'Feedback',
          title: '@Html.DisplayNameFor(model => model.Feedback)',
          width: 160,
          sortable: true,
          hidden: false,
          resizable: true
        },
        {  /*推荐采纳*/
          field: 'Recommended',
          title: '<span class="text-danger">*</span>  @Html.DisplayNameFor(model => model.Recommended)',
          width: 90,
          align: 'center',
          hidden: false,
          formatter: booleanformatter,
          sortable: true,
          resizable: true
        },




      ]]
    })
      .datagrid('enableFilter', [
        {    /*询价数量*/
          field: 'Qty',
          type: 'numberbox',
          op: ['equal', 'notequal', 'less', 'lessorequal', 'greater', 'greaterorequal']
        },
        {    /*报价金额*/
          field: 'Price',
          type: 'numberbox',
          op: ['equal', 'notequal', 'less', 'lessorequal', 'greater', 'greaterorequal']
        },
        {    /*最小订单量*/
          field: 'MinQty',
          type: 'numberbox',
          op: ['equal', 'notequal', 'less', 'lessorequal', 'greater', 'greaterorequal']
        },
        {    /*系统版本号*/
          field: 'Ver',
          type: 'numberbox',
          op: ['equal', 'notequal', 'less', 'lessorequal', 'greater', 'greaterorequal']
        },
        {     /*厂价有效期*/
          field: 'PriceDate',
          type: 'dateRange',
          options: {
          }
        },
        {     /*推荐采纳*/
          field: 'Recommended',
          type: 'booleanfilter'
        },
      ]);
  });

</script>


 