@model WebApp.Models.InquiryProduct
<script type="text/javascript">
  //全屏事件
  document.addEventListener('panel.onfullscreen', () => {
       $inquiryproductdg.datagrid('resize');
   });
    //是否开启行内编辑
    var SUBEDITINLINE = true;
   //初始化 InquiryProduct datagrid
   var $inquiryproductdg = $('#inquiryproduct_datagrid');
   //当前行记录
   var inquiryproduct = {};
   //datagrid CRUD method
    var inquiryproduct_editIndex = undefined;
    //取消编辑恢复状态
    function inquiryproduct_rejectChanges() {
		$inquiryproductdg.datagrid('rejectChanges');
		inquiryproduct_editIndex = undefined;
    }
    //重新加载数据
    function inquiryproduct_reloadData() {
			$inquiryproductdg.datagrid('unselectAll');
            $inquiryproductdg.datagrid('uncheckAll');
	        $inquiryproductdg.datagrid('reload');
	}
    //关闭编辑状态
	function inquiryproduct_endEditing() {
			if (inquiryproduct_editIndex === undefined) {
                return true; 
            }
			if ($inquiryproductdg.datagrid('validateRow', inquiryproduct_editIndex)) {
				$inquiryproductdg.datagrid('endEdit', inquiryproduct_editIndex);
				inquiryproduct_editIndex = undefined;
                return true;
			} else {
				const invalidinput = $('input.validatebox-invalid',$inquiryproductdg.datagrid('getPanel'));
                const fieldnames = invalidinput.map((index, item) => {
                  return $(item).attr('placeholder') || $(item).attr('id');
                });
                $.messager.alert('提示', `${Array.from(fieldnames)} 输入有误.`, 'error');
				return false;
			}
		}
    //单击列开启编辑功能
	function inquiryproduct_onClickCell(index, field) {
			const _operates = ['_operate1', 'ck'];
             $('button[name*=\'inquiryproductdeleterowbutton\']').prop('disabled', false);
			if (!SUBEDITINLINE || $.inArray(field, _operates) >= 0) {
				return false;
			}
			if (inquiryproduct_editIndex !== index) {
				if (inquiryproduct_endEditing()) {
					$inquiryproductdg.datagrid('selectRow', index)
							.datagrid('beginEdit', index);
                    //inquiryproduct_editIndex = index;
					var ed = $inquiryproductdg.datagrid('getEditor', { index: index, field: field });
					if (ed) {
						($(ed.target).data('textbox') ? $(ed.target).textbox('textbox') : $(ed.target)).focus();
					}
				} else {
					$inquiryproductdg.datagrid('selectRow', inquiryproduct_editIndex);
				}
			}
		}
    //双击弹出编辑当前行对话框
    function inquiryproduct_onDblClickRow(index, row) {
        if (!SUBEDITINLINE) {
            open_inquiryproductdlg(index, row, 'Modified');
        }
    }
    //订阅对话框新增返回事件
    $(document).on('inquiryproduct_form.add', (e, index,item) => {
        $inquiryproductdg.datagrid("insertRow",
            {
                index: 0,
                row: item
            });
        $("button[name*='inquiryproduct_cancelchangesbutton']").prop('disabled', false);
        $("button[name*='inquiryproduct_savechangesbutton']").prop('disabled', false);
    });
    //订阅对话框修改返回事件
    $(document).on('inquiryproduct_form.edit', (e,index, item) => {
        $inquiryproductdg.datagrid('updateRow', {
            index: index,
            row: item
        });
        $("button[name*='inquiryproduct_cancelchangesbutton']").prop('disabled', false);
        $("button[name*='inquiryproduct_savechangesbutton']").prop('disabled', false);
    });
    //新增记录
    function inquiryproduct_appendItem() {
       const $inquiryform = $('#inquiry_form');
       if ($inquiryform.form('enableValidation').form('validate')) {
          const inquiry = $inquiryform.serializeJSON();
       const item = {
          Price: null, 
Cur: null, 
MinQty: null, 
PriceDate: null, 
Recommended: false, 

          InquiryId:inquiry.Id
        };
      if (!SUBEDITINLINE) {
        open_inquiryproductdlg(0, item, 'Added');
      } else {
			if (inquiryproduct_endEditing()) {
				//对必填字段进行默认值初始化
				$inquiryproductdg.datagrid('insertRow', 
                               { index: 0,
                                  row: item 
                               });
				inquiryproduct_editIndex = 0;
				$inquiryproductdg.datagrid('selectRow', inquiryproduct_editIndex)
						.datagrid('beginEdit', inquiryproduct_editIndex);
			}
        }
        }
	 }
    //删除编辑的行
	function inquiryproduct_removeItem() {
		if (inquiryproduct_editIndex !== undefined) {  
            const delindex = inquiryproduct_editIndex;
			$inquiryproductdg.datagrid('cancelEdit', delindex)
					           .datagrid('deleteRow', delindex);
            $("button[name*='inquiryproduct_cancelchangesbutton']").prop('disabled', false);
            $("button[name*='inquiryproduct_savechangesbutton']").prop('disabled', false);
        } else {
           const rows = $inquiryproductdg.datagrid('getChecked');
           rows.slice().reverse().forEach(row => {
                const rowindex = $inquiryproductdg.datagrid('getRowIndex', row);
                $inquiryproductdg.datagrid('deleteRow', rowindex);
                $("button[name*='inquiryproduct_cancelchangesbutton']").prop('disabled', false);
                $("button[name*='inquiryproduct_savechangesbutton']").prop('disabled', false);
            });
        }
	}
    //删除选中的行
    function inquiryproduct_deleteChecked() {
            const rows = $inquiryproductdg.datagrid('getChecked');
            if (rows.length > 0) {
                var id = rows.filter(item=>item.Id!=null).map(item => {
                    return item.Id;
                });
                $.messager.confirm('确认', `你确定要删除这 <span class='badge bg-color-red'>${id.length}</span> 行记录?`,result => {
                    if (result) {
                        $.post('/InquiryProducts/DeleteChecked', { id: id })
                         .done(response => {
                            if (response.success) {
                                $inquiryproductdg.datagrid('reload');
                            } else {
                                $.messager.alert('错误', response.err,'error');
                            }
                         });
                    }
                });  
            } else {
                $.messager.alert('提示', '请先选择要删除的记录!','question');
            }
      }
  //获取修改的行
  function inquiryproduct_getChanges() {
    if (inquiryproduct_endEditing()) {
      if ($inquiryproductdg.datagrid('getChanges').length > 0) {
        const inserted = $inquiryproductdg.datagrid('getChanges', 'inserted').map(item => {
          item.TrackingState = 1;
          return item;
        });
        const deleted = $inquiryproductdg.datagrid('getChanges', 'deleted').map(item => {
          item.TrackingState = 3;
          return item;
        });
        const updated = $inquiryproductdg.datagrid('getChanges', 'updated').map(item => {
          item.TrackingState = 2;
          return item;
        });
        //过滤已删除的重复项
        const changed = inserted.concat(updated.filter(item => {
          return !deleted.includes(item);
        })).concat(deleted);
        return { success: true, changed };
      } else {
        return { success: true, changed:undefined};
      }
    } else {
      return { success: false,changed:undefined };
    }
  }
  //提交修改的数据
  //function inquiryproduct_acceptChanges() {
  //  $inquiryproductdg.datagrid('acceptChanges');
  //}
  //提交保存后台数据库
  async function inquiryproduct_acceptChanges() {
			if (inquiryproduct_endEditing()) {
				if ($inquiryproductdg.datagrid('getChanges').length > 0) {
					const inserted = $inquiryproductdg.datagrid('getChanges', 'inserted').map(item => {
                       item.TrackingState = 1;
                       return item;
                    });
					const deleted = $inquiryproductdg.datagrid('getChanges', 'deleted').map(item => {
                       item.TrackingState = 3;
                       return item;
                    });
					const updated = $inquiryproductdg.datagrid('getChanges', 'updated').map(item => {
                       item.TrackingState = 2;
                       return item;
                    });
					//过滤已删除的重复项
                    const changed = inserted.concat(updated.filter(item => {
                           return !deleted.includes(item);
                         })).concat(deleted);
                   //console.table(changed);
				  if (MODELSTATE === 'Added') {
                    return { success:true, changed };
                  } else {
                    const response = await $.post('/InquiryProducts/AcceptChanges', {inquiryproducts:changed});
                    response.changed = undefined;
    				if (response.success) {
							toastr.success('保存明细成功'); 
							$inquiryproductdg.datagrid('acceptChanges');
							inquiryproduct_reloadData()
                            return { success:true}; 
				    } else {
                           $.messager.alert('错误', response.err ,'error');
                           return { success:false, err:response.err };
                    }
                   }
				} else {
                  return { success: true, changed: undefined};
                }
			} else {
               return { success: false };
            }
      }


