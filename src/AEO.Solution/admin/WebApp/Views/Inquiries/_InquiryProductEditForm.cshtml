<script type="text/javascript">
     var form_state = 'Added';
     var current_index = -1;
     var inquiryproduct = {};
 
     function open_inquiryproductdlg(index, row, state) {
         form_state = state;
         current_index = index;
         inquiryproduct = row;
         $('#inquiryproductdlg').dialog('open');
         if (form_state === 'Added') {
             $('#inquiryproductdlg').dialog('setTitle', '新增明细');
         } else {
             $('#inquiryproductdlg').dialog('setTitle', '修改明细');
         }
         $('#inquiryproduct_form').form('reset');
         $('#inquiryproduct_form').form('load', inquiryproduct);
     }
     function confirm_inquiryproductform() {
         $inquiryproductform = $('#inquiryproduct_form');
         if ($inquiryproductform.form('enableValidation').form('validate')) {
             inquiryproduct = $inquiryproductform.serializeJSON();
             if (form_state === 'Added') {
                 $(document).trigger('inquiryproduct_form.add', [current_index, inquiryproduct])
             } else {
                 $(document).trigger('inquiryproduct_form.edit', [current_index, inquiryproduct])
             }
             $('#inquiryproductdlg').dialog('close');
         }
     }
 </script>

 