@model WebApp.Models.InquiryProduct
<div id="inquiryproductdlg" class="easyui-dialog"
     title="编辑产品信息" style="display:none"
     data-options="
                iconCls: 'fal fa-window',
                modal:true,
                closed:true,
                cache: false,
                resizable:true,
                width:820,
                height:450,
                onOpen:function(){
                   $('#inquiryproduct_form').form('disableValidation');
                },
                buttons: [{
                    text:'确认',
                    handler:function(){
                        confirm_inquiryproductform();
                    }
                },{
                    text:'取消',
                    handler:function(){
                        $('#inquiryproductdlg').dialog('close');
                    }
                }]
            ">
  <div class="panel-container show">
    <div class="panel-content p-0">
      <form id="inquiryproduct_form" class="form-horizontal needs-validation" novalidate>
        <div class="d-flex">
          <fieldset class="form-group flex-grow-1">
            <div class="row h-100 align-items-center m-0 pt-1">
              <!--系统主键-->
              @Html.HiddenFor(model => model.Id)
              @Html.HiddenFor(model => model.SupplierName)
              @Html.HiddenFor(model => model.SamplePic)
              @Html.HiddenFor(model => model.InquiryNo)
              @Html.HiddenFor(model => model.InquiryId)
              @Html.HiddenFor(model => model.ThirdProductNo)
              <!--产品类别-->
              <label class="col-md-2 form-label text-right p-0" for="@Html.IdFor(model => model.CategoryName)"> @Html.DisplayNameFor(model => model.CategoryName) </label>
              <div class="col-md-4 mb-1">
                <input id="@Html.IdFor(model => model.CategoryName)"
                       name="@Html.NameFor(model => model.CategoryName)"
                       value="@Html.ValueFor(model => model.CategoryName)"
                       tabindex="3"
                       class="easyui-textbox"
                       type="text"
                       style="width:100%"
                       data-options="prompt:'@Html.DisplayNameFor(model => model.CategoryName)',
     						 required:false ,validType:'length[0,50]',readonly:true" />
              </div>
              <!--产品编号(自动生成,可手工修改)-->
              <label class="col-md-2 form-label text-right p-0" for="@Html.IdFor(model => model.ProductNo)"> @Html.DisplayNameFor(model => model.ProductNo) </label>
              <div class="col-md-4 mb-1">
                <input id="@Html.IdFor(model => model.ProductNo)"
                       name="@Html.NameFor(model => model.ProductNo)"
                       value="@Html.ValueFor(model => model.ProductNo)"
                       tabindex="1"
                       class="easyui-textbox"
                       type="text"
                       style="width:100%"
                       data-options="prompt:'@Html.DisplayNameFor(model => model.ProductNo)',
     						      required:false ,validType:'length[0,50]',readonly:true" />
              </div>

              <!--中文品名-->
              <label class="col-md-2 form-label text-right p-0" for="@Html.IdFor(model => model.ProductName)"> @Html.DisplayNameFor(model => model.ProductName) </label>
              <div class="col-md-4 mb-1">
                <input id="@Html.IdFor(model => model.ProductName)"
                       name="@Html.NameFor(model => model.ProductName)"
                       value="@Html.ValueFor(model => model.ProductName)"
                       tabindex="2"
                       class="easyui-textbox"
                       type="text"
                       style="width:100%"
                       data-options="prompt:'@Html.DisplayNameFor(model => model.ProductName)',
     						 required:false ,validType:'length[0,200]',readonly:true" />
              </div>

              <!--英文品名-->
              <label class="col-md-2 form-label text-right p-0" for="@Html.IdFor(model => model.ProductEnName)"> @Html.DisplayNameFor(model => model.ProductEnName) </label>
              <div class="col-md-4 mb-1">
                <input id="@Html.IdFor(model => model.ProductEnName)"
                       name="@Html.NameFor(model => model.ProductEnName)"
                       value="@Html.ValueFor(model => model.ProductEnName)"
                       tabindex="4"
                       class="easyui-textbox"
                       type="text"
                       style="width:100%"
                       data-options="prompt:'@Html.DisplayNameFor(model => model.ProductEnName)',
     						 required:false ,validType:'length[0,200]'" />
              </div>

              <!--中文描述-->
              <label class="col-md-2 form-label text-right p-0" for="@Html.IdFor(model => model.CnDescription)"> @Html.DisplayNameFor(model => model.CnDescription) </label>
              <div class="col-md-10 mb-1">
                <input id="@Html.IdFor(model => model.CnDescription)"
                       name="@Html.NameFor(model => model.CnDescription)"
                       value="@Html.ValueFor(model => model.CnDescription)"
                       tabindex="5"
                       class="easyui-textbox"
                       type="text"
                       style="width:100%"
                       data-options="prompt:'@Html.DisplayNameFor(model => model.CnDescription)',
     						 required:false " />
              </div>

              <!--英文描述-->
              <label class="col-md-2 form-label text-right p-0" for="@Html.IdFor(model => model.EnDescription)"> @Html.DisplayNameFor(model => model.EnDescription) </label>
              <div class="col-md-10 mb-1">
                <input id="@Html.IdFor(model => model.EnDescription)"
                       name="@Html.NameFor(model => model.EnDescription)"
                       value="@Html.ValueFor(model => model.EnDescription)"
                       tabindex="6"
                       class="easyui-textbox"
                       type="text"
                       style="width:100%"
                       data-options="prompt:'@Html.DisplayNameFor(model => model.EnDescription)',
     						 required:false " />
              </div>



              <label class="col-md-2 form-label text-right p-0" for="@Html.IdFor(model => model.SupplierCode)"><span class="text-danger">*</span> @Html.DisplayNameFor(model => model.SupplierCode) </label>
              <div class="col-md-4 mb-1">
                <input id="@Html.IdFor(model => model.SupplierCode)"
                       name="@Html.NameFor(model => model.SupplierCode)"
                       value="@Html.ValueFor(model => model.SupplierCode)"
                       tabindex="6"
                       class="easyui-combogrid"
                       type="text"
                       style="width:100%"
                       data-options="prompt:'@Html.DisplayNameFor(model => model.SupplierCode)',
                        required:true,
     						          idField: 'CustomerCode',
						              textField:  'CustomerName' ,
                          panelHeight:'auto',
                          panelWidth:490,
                          editable:true,
                          method:'get',
                          mode: 'remote',
                          fitColumns:true,
                          pagination: true,
                           clientPaging:false,
                          pageList: [10, 20, 50, 100, 500],
						              url: '/Customers/GetSupplierComboGridData' ,
                          columns:[[
                           {field:'CustomerCode',title:'客户编码',width:90},
                           {field:'CustomerName',title:'客户名称',width:150}
                          ]],
						              onClickRow: function(index,item){
                              console.log(item)
						                  $('#inquiryproduct_form #SupplierName').val(item.CustomerName);


                       } " />
              </div>
              <!--厂商货号-->
              <label class="col-md-2 form-label text-right p-0" for="@Html.IdFor(model => model.SupplierProductNo)"> @Html.DisplayNameFor(model => model.SupplierProductNo) </label>
              <div class="col-md-4 mb-1">
                <input id="@Html.IdFor(model => model.SupplierProductNo)"
                       name="@Html.NameFor(model => model.SupplierProductNo)"
                       value="@Html.ValueFor(model => model.SupplierProductNo)"
                       tabindex="13"
                       class="easyui-textbox"
                       type="text"
                       style="width:100%"
                       data-options="prompt:'@Html.DisplayNameFor(model => model.SupplierProductNo)',
     						 required:false ,validType:'length[0,128]'" />
              </div>
              <!--询价数量-->
              <label class="col-md-2 form-label text-right p-0" for="@Html.IdFor(model => model.Qty)"><span class="text-danger">*</span> @Html.DisplayNameFor(model => model.Qty) </label>
              <div class="col-md-4 mb-1">
                <input id="@Html.IdFor(model => model.Qty)"
                       name="@Html.NameFor(model => model.Qty)"
                       value="@Html.ValueFor(model => model.Qty)"
                       tabindex="8"
                       class="easyui-numberbox"
                       type="text"
                       style="width:100%"
                       data-options="prompt:'@Html.DisplayNameFor(model => model.Qty)',
                                 precision:2,
								 required:true,validType:'integer',
                                 formatter:intformatter,
                                 parser:parsernumber
                                 " />
              </div>

              <!--单位-->
              <label class="col-md-2 form-label text-right p-0" for="@Html.IdFor(model => model.Unit)"> @Html.DisplayNameFor(model => model.Unit) </label>
              <div class="col-md-4 mb-1">
                <input id="@Html.IdFor(model => model.Unit)"
                       name="@Html.NameFor(model => model.Unit)"
                       value="@Html.ValueFor(model => model.Unit)"
                       tabindex="9"
                       class="easyui-textbox"
                       type="text"
                       style="width:100%"
                       data-options="prompt:'@Html.DisplayNameFor(model => model.Unit)',
     						 required:false ,validType:'length[0,10]'" />
              </div>

              <!--执行人-->
              <label class="col-md-2 form-label text-right p-0" for="@Html.IdFor(model => model.Executor)"><span class="text-danger">*</span> @Html.DisplayNameFor(model => model.Executor) </label>
              <div class="col-md-4 mb-1">
                <input id="@Html.IdFor(model => model.Executor)"
                       name="@Html.NameFor(model => model.Executor)"
                       value="@Html.ValueFor(model => model.Executor)"
                       tabindex="10"
                       class="easyui-textbox"
                       type="text"
                       style="width:100%"
                       data-options="prompt:'@Html.DisplayNameFor(model => model.Executor)',
     						 required:true ,validType:'length[0,20]'" />
              </div>




              <!--价格类型-->
              <label class="col-md-2 form-label text-right p-0" for="@Html.IdFor(model => model.PriceType)"><span class="text-danger">*</span> @Html.DisplayNameFor(model => model.PriceType) </label>
              <div class="col-md-4 mb-1">
                <input id="@Html.IdFor(model => model.PriceType)"
                       name="@Html.NameFor(model => model.PriceType)"
                       value="@Html.ValueFor(model => model.PriceType)"
                       tabindex="14"
                       class="easyui-combobox"
                       type="text"
                       style="width:100%"
                       data-options="prompt:'@Html.DisplayNameFor(model => model.PriceType)',
     						 required:true ,validType:'length[0,30]',data:pricetypedatasource,panelHeight:'auto'" />
              </div>

              <!--报价金额-->
              <label class="col-md-2 form-label text-right p-0" for="@Html.IdFor(model => model.Price)"><span class="text-danger">*</span> @Html.DisplayNameFor(model => model.Price) </label>
              <div class="col-md-4 mb-1">
                <input id="@Html.IdFor(model => model.Price)"
                       name="@Html.NameFor(model => model.Price)"
                       value="@Html.ValueFor(model => model.Price)"
                       tabindex="15"
                       class="easyui-numberbox"
                       type="text"
                       style="width:100%"
                       data-options="prompt:'@Html.DisplayNameFor(model => model.Price)',
                                 precision:2,
								 required:true,
                                 formatter:intformatter,
                                 parser:parsernumber
                                 " />
              </div>

              <!--币种-->
              <label class="col-md-2 form-label text-right p-0" for="@Html.IdFor(model => model.Cur)"><span class="text-danger">*</span> @Html.DisplayNameFor(model => model.Cur) </label>
              <div class="col-md-4 mb-1">
                <input id="@Html.IdFor(model => model.Cur)"
                       name="@Html.NameFor(model => model.Cur)"
                       value="@Html.ValueFor(model => model.Cur)"
                       tabindex="16"
                       class="easyui-combobox"
                       type="text"
                       style="width:100%"
                       data-options="prompt:'@Html.DisplayNameFor(model => model.Cur)',
     						 required:true ,validType:'length[0,20]',data:curdatasource,panelHeight:'auto'" />
              </div>

              <!--最小订单量-->
              <label class="col-md-2 form-label text-right p-0" for="@Html.IdFor(model => model.MinQty)"> @Html.DisplayNameFor(model => model.MinQty) </label>
              <div class="col-md-4 mb-1">
                <input id="@Html.IdFor(model => model.MinQty)"
                       name="@Html.NameFor(model => model.MinQty)"
                       value="@Html.ValueFor(model => model.MinQty)"
                       tabindex="17"
                       class="easyui-numberbox"
                       type="text"
                       style="width:100%"
                       data-options="prompt:'@Html.DisplayNameFor(model => model.MinQty)',
                                 precision:2,
								 required:false,
                                 formatter:intformatter,
                                 parser:parsernumber
                                 " />
              </div>

              <!--厂价有效期-->
              <label class="col-md-2 form-label text-right p-0" for="@Html.IdFor(model => model.PriceDate)"> @Html.DisplayNameFor(model => model.PriceDate) </label>
              <div class="col-md-4 mb-1">
                <input id="@Html.IdFor(model => model.PriceDate)"
                       name="@Html.NameFor(model => model.PriceDate)"
                       tabindex="18"
                       class="easyui-datebox"
                       type="text"
                       style="width:100%"
                       value="@Html.ValueFor(model => model.PriceDate)"
                       data-options="prompt:'@Html.DisplayNameFor(model => model.PriceDate)',
								 formatter:dateformatter,
                                 required:false " />
              </div>
              <!--推荐采纳-->
              <label class="col-md-2 form-label text-right p-0" for="@Html.IdFor(model => model.Recommended)"><span class="text-danger">*</span> @Html.DisplayNameFor(model => model.Recommended) </label>
              <div class="col-md-4 mb-1">
                <div class="custom-control custom-checkbox pt-1">
                  <input id="@Html.IdFor(model => model.Recommended)"
                         name="@Html.NameFor(model => model.Recommended)"
                         value="true" @(Model.Recommended ? "checked=\"checked\"" : "")
                         data-unchecked-value="false"
                         tabindex="20"
                         class="custom-control-input"
                         type="checkbox" />
                  <label class="custom-control-label" for="@Html.NameFor(model => model.Recommended)"> @Html.DisplayNameFor(model => model.Recommended)</label>

                </div>
              </div>
              <label class="col-md-2 form-label text-right p-0" ></label>
              <div class="col-md-4 mb-1">
           
              </div>
              <!--反馈说明-->
              <label class="col-md-2 form-label text-right p-0" for="@Html.IdFor(model => model.Feedback)"> @Html.DisplayNameFor(model => model.Feedback) </label>
              <div class="col-md-10 mb-1">
                <input id="@Html.IdFor(model => model.Feedback)"
                       name="@Html.NameFor(model => model.Feedback)"
                       value="@Html.ValueFor(model => model.Feedback)"
                       tabindex="19"
                       class="easyui-textbox"
                       type="text"
                       style="width:100%"
                       data-options="prompt:'@Html.DisplayNameFor(model => model.Feedback)',
     						 required:false " />
              </div>








            </div>
          </fieldset>
          <div class="p-2 align-content-center text-center">
            <input type="file" id="samplepricturefile" style="display:none" />
            <img id="sampleimg" data-src="holder.js/160x160"
                 class="rounded mx-auto d-block"
                 alt="160x160"
                 src="~/Scripts/holder.js"
                 data-holder-rendered="true" style="width: 160px; height: 160px;">
            <button type="button" class="mt-1 ml-auto btn btn-outline-primary btn-sm btn-pills waves-effect waves-themed" onclick="uploadsamplepric()">上传图片</button>
          </div>
        </div>
      </form>
    </div>
  </div>
</div>
<script type="text/javascript">
  var form_state = 'Added';
  var current_index = -1;
  var inquiryproduct = {};
  document.getElementById('samplepricturefile').addEventListener('change', function (e) {
    //console.log('samplepricturefile', e);
    if (e.target.files.length > 0) {
      //console.log(e.target.files[0])
      var formData = new FormData();
      formData.append('id', $('#inquiryproduct_form #Id').val());
      formData.append('samplepicture', e.target.files[0]);
      $.ajax({
        type: "POST",
        url: '/InquiryProducts/UploadPicture',
        //dataType: 'json', //not sure but works for me without this
        data: formData,
        contentType: false, //this is requireded please see answers above
        processData: false, //this is requireded please see answers above
        //cache: false, //not sure but works for me without this
        error: function () {
          $.messager.alert('异常', '上传失败', 'error');
        },
        success: function (res) {
          $("#sampleimg").attr("src", res.path);
          $("#inquiryproduct_form #SamplePic").val(res.path);
        }
      });
    }
  });


  //上传图片
  function uploadsamplepric() {
    $('#samplepricturefile').click();
  };
  function open_inquiryproductdlg(index, row, state) {
    form_state = state;
    current_index = index;
    inquiryproduct = row;
    $('#inquiryproductdlg').dialog('open');
    if (form_state === 'Added') {
      var myImage = document.getElementById('sampleimg');
      Holder.run({
        images: myImage
      });
    } else {
      if (row.SamplePic != null && row.SamplePic.length > 0) {
        $("#sampleimg").attr("src", row.SamplePic);
      } else {
        var myImage = document.getElementById('sampleimg');
        Holder.run({
          images: myImage
        });
      }
    }
    $('#inquiryproduct_form').form('reset');
    $('#inquiryproduct_form').form('load', inquiryproduct);
  }
  function confirm_inquiryproductform() {
    $inquiryproductform = $('#inquiryproduct_form');
    if ($inquiryproductform.form('enableValidation').form('validate')) {
      inquiryproduct = $inquiryproductform.serializeJSON();
      if (form_state === 'Added') {
        $(document).trigger('inquiryproduct_form.add', [current_index, inquiryproduct])
      } else {
        $(document).trigger('inquiryproduct_form.edit', [current_index, inquiryproduct])
      }
      $('#inquiryproductdlg').dialog('close');
    }
  }
</script>

