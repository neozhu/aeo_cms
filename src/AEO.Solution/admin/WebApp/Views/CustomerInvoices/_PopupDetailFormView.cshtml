﻿@model WebApp.Models.CustomerInvoice
<!-- 弹出编辑窗体表单 -->
 <div id="customerinvoicedetailwindow" class="easyui-window" 
      title="明细数据" 
      data-options="modal:true,
                    closed:true,
                    minimizable:false,
                    collapsible:false,
                    maximized:false,
                    iconCls:'fal fa-window',
                    onBeforeClose:function(){
                      var that = $(this);
                      if(customerinvoicehasmodified()){
                        $.messager.confirm('确认','你确定要放弃保存修改的记录?',function(r){
                        if (r){
                          var opts = that.panel('options');
                          var onBeforeClose = opts.onBeforeClose;
                          opts.onBeforeClose = function(){};
                          that.panel('close');
                          opts.onBeforeClose = onBeforeClose;
                          hook = false;
                        }
                        });
                        return false;
                      }
                    },
                    onOpen:function(){
                       $(this).window('vcenter');
                       $(this).window('hcenter');
                    },
                    onRestore:function(){
                    },
                    onMaximize:function(){
                    }
                    " style="width:800px;height:450px;display:none">
  <!-- toolbar -->
  <div class="panel-content py-2 rounded-bottom border-faded border-left-0 border-right-0  text-muted bg-subtlelight-fade sticky-top">
  <div class="d-flex flex-row-reverse pr-4">
        <div class="btn-group btn-group-sm mr-1">
          <button name="saveitembutton" onclick="savecustomerinvoiceitem()" class="btn btn-default">
            <i class="fal fa-save"></i> @Html.L("Save")
          </button>
        </div>
        <div class="btn-group btn-group-sm mr-1" id="deleteitem-btn-group">
          <button onclick="deletecustomerinvoiceitem()" class="btn btn-danger">
            <i class="fal fa-trash-alt"></i> @Html.L("Delete")
          </button>
        </div>
    </div>
  </div>
 <!-- panel container form  -->
 <div class="panel-container show">
   <div class="container">
    <div class="panel-content">
           <form id="customerinvoice_form" 
              class="easyui-form form-horizontal padding-10" 
              method="post" 
              data-options="novalidate:true,
                            onChange: function(target){
                              hook = true;
                              $('button[name*=\'saveitembutton\']').prop('disabled', false);
                             },
                             onLoadSuccess:function(data){
                               hook = false;
                               $('button[name*=\'saveitembutton\']').prop('disabled', true);
                             }">
  @Html.AntiForgeryToken()
   <!--Primary Key-->
  @Html.HiddenFor(model=>model.Id)
   <fieldset class="form-group">
   <div class="row h-100 align-items-center">

   <!--发票名称-->
        <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"> @Html.DisplayNameFor(model => model.InvName)</label>
		<div class="col-md-4 mb-1 pl-1">  
			<input id="@Html.IdFor(model => model.InvName)" 
				   name="@Html.NameFor(model => model.InvName)" 
				   value="@Html.ValueFor(model => model.InvName)"
				   tabindex="0" 
				   class="easyui-textbox" 
                   style="width:100%"
				   type="text" 
				   data-options="prompt:'@Html.DescriptionFor(model => model.InvName)',
								 required:false, 
                                 validType: 'length[0,80]'
                                 " />
       </div>
				   
   <!--发票类型-->
        <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"><span class="text-danger">*</span> @Html.DisplayNameFor(model => model.InvType)</label>
		<div class="col-md-4 mb-1 pl-1">  
			<input id="@Html.IdFor(model => model.InvType)" 
				   name="@Html.NameFor(model => model.InvType)" 
				   value="@Html.ValueFor(model => model.InvType)"
				   tabindex="1" required
				   class="easyui-textbox" 
                   style="width:100%"
				   type="text" 
				   data-options="prompt:'@Html.DescriptionFor(model => model.InvType)',
								 required:true, 
                                 validType: 'length[0,100]'
                                 " />
       </div>
				   

   <!--发票国家-->
        <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"> @Html.DisplayNameFor(model => model.InvCountry)</label>
		<div class="col-md-4 mb-1 pl-1">  
			<input id="@Html.IdFor(model => model.InvCountry)" 
				   name="@Html.NameFor(model => model.InvCountry)" 
				   value="@Html.ValueFor(model => model.InvCountry)"
				   tabindex="2" 
				   class="easyui-textbox" 
                   style="width:100%"
				   type="text" 
				   data-options="prompt:'@Html.DescriptionFor(model => model.InvCountry)',
								 required:false, 
                                 validType: 'length[0,100]'
                                 " />
       </div>
				   
   <!--发票税点-->
       <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"><span class="text-danger">*</span> @Html.DisplayNameFor(model => model.InvTax)</label>
	   <div class="col-md-4 mb-1 pl-1">  
             <input id="@Html.IdFor(model => model.InvTax)"
				   name="@Html.NameFor(model => model.InvTax)" 
				   value="@Html.ValueFor(model => model.InvTax)"
				   tabindex="3" 
				   class="easyui-numberbox" 
                   style="width:100%"
				   type="text" 
				   data-options="prompt:'@Html.DescriptionFor(model => model.InvTax)',
								 required:true,formatter:numberformatter,
                                 parser:parsernumber,precision:2,
                                 
                                 "  />

        </div>
				   

   <!--税务等级号-->
        <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"> @Html.DisplayNameFor(model => model.TaxNo)</label>
		<div class="col-md-4 mb-1 pl-1">  
			<input id="@Html.IdFor(model => model.TaxNo)" 
				   name="@Html.NameFor(model => model.TaxNo)" 
				   value="@Html.ValueFor(model => model.TaxNo)"
				   tabindex="4" 
				   class="easyui-textbox" 
                   style="width:100%"
				   type="text" 
				   data-options="prompt:'@Html.DescriptionFor(model => model.TaxNo)',
								 required:false, 
                                 validType: 'length[0,100]'
                                 " />
       </div>
				   
   <!--发票用途-->
        <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"> @Html.DisplayNameFor(model => model.InvUse)</label>
		<div class="col-md-4 mb-1 pl-1">  
			<input id="@Html.IdFor(model => model.InvUse)" 
				   name="@Html.NameFor(model => model.InvUse)" 
				   value="@Html.ValueFor(model => model.InvUse)"
				   tabindex="5" 
				   class="easyui-textbox" 
                   style="width:100%"
				   type="text" 
				   data-options="prompt:'@Html.DescriptionFor(model => model.InvUse)',
								 required:false, 
                                 validType: 'length[0,256]'
                                 " />
       </div>
				   

   <!--备注说明-->
        <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"> @Html.DisplayNameFor(model => model.Remark)</label>
		<div class="col-md-4 mb-1 pl-1">  
			<input id="@Html.IdFor(model => model.Remark)" 
				   name="@Html.NameFor(model => model.Remark)" 
				   value="@Html.ValueFor(model => model.Remark)"
				   tabindex="6" 
				   class="easyui-textbox" 
                   style="width:100%"
				   type="text" 
				   data-options="prompt:'@Html.DescriptionFor(model => model.Remark)',
								 required:false, 
                                 validType: 'length[0,256]'
                                 " />
       </div>
				   
   <!--客户编号-->
        <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"><span class="text-danger">*</span> @Html.DisplayNameFor(model => model.CustomerCode)</label>
		<div class="col-md-4 mb-1 pl-1">  
			<input id="@Html.IdFor(model => model.CustomerCode)" 
				   name="@Html.NameFor(model => model.CustomerCode)" 
				   value="@Html.ValueFor(model => model.CustomerCode)"
				   tabindex="7" required
				   class="easyui-textbox" 
                   style="width:100%"
				   type="text" 
				   data-options="prompt:'@Html.DescriptionFor(model => model.CustomerCode)',
								 required:true, 
                                 validType: 'length[0,20]'
                                 " />
       </div>
				   

   <!--客户名称-->
        <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"><span class="text-danger">*</span> @Html.DisplayNameFor(model => model.CustomerName)</label>
		<div class="col-md-4 mb-1 pl-1">  
			<input id="@Html.IdFor(model => model.CustomerName)" 
				   name="@Html.NameFor(model => model.CustomerName)" 
				   value="@Html.ValueFor(model => model.CustomerName)"
				   tabindex="8" required
				   class="easyui-textbox" 
                   style="width:100%"
				   type="text" 
				   data-options="prompt:'@Html.DescriptionFor(model => model.CustomerName)',
								 required:true, 
                                 validType: 'length[0,80]'
                                 " />
       </div>
				   
    <!--所属客户-->
        <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"><span class="text-danger">*</span> @Html.DisplayNameFor(model => model.CustomerId)</label>
		<div class="col-md-4 mb-1 pl-1">   	
            <input id="@Html.IdFor(model => model.CustomerId)"
			       name="@Html.NameFor(model => model.CustomerId)"
				   value="@Html.ValueFor(model => model.CustomerId)"
                   tabindex="9" required
              	   class="easyui-combobox"      
                   style="width:100%"
                   data-options="prompt:'@Html.DescriptionFor(model => model.CustomerId)' ,
						required:true ,
						valueField: 'Id',
						textField:  'CustomerCode' ,
                        validateOnCreate:false,
                        validateOnBlur:true,
                        validType:'combocheck[\'#CustomerId\',\'请选择所属客户\']',
						url: '/CustomerInvoices/GetCustomers' ,
						onSelect: function(item){
						  //console.log(item);
				        }">
       </div>
	   
	    </div> 
      </fieldset>
   </form>
    </div>
    </div>
    </div>
</div>

<!-- 弹出窗体form表单 -->
<!-- 弹出编辑对话框 -->

<!--begin popup detailview javascript block -->
<script type="text/javascript">
    //判断新增编辑状态
    var MODELSTATE = 'Added';
    var customerinvoiceid = null;
    function opencustomerinvoicedetailwindow(data,state) {
         MODELSTATE = state;
         initcustomerinvoicedetailview();
         customerinvoiceid = (data.Id || 0);
         $('#customerinvoicedetailwindow').window('open');
         $('#customerinvoice_form').form('reset');
         $('#customerinvoice_form').form('load', data);
             }
  //删除当前记录
  function deletecustomerinvoiceitem() {
    $.messager.confirm('确认', '你确定要删除该记录?', result => {
      if (result) {
        const url = `/CustomerInvoices/Delete/${customerinvoiceid}`;
        $.get(url).done(res => {
          if (res.success) {
            toastr.success("删除成功");
            $('#customerinvoicedetailwindow').window('close');
            reloadData();
          } else {
            $.messager.alert('错误', res.err, 'error');
          }
        });
      }
    });
  }
    //async 保存数据
    async function savecustomerinvoiceitem() { 
      const $customerinvoiceform = $('#customerinvoice_form');
      if ($customerinvoiceform.form('enableValidation').form('validate')) {
            let customerinvoice = $customerinvoiceform.serializeJSON();
            let url = '/CustomerInvoices/Edit';
            //判断是新增或是修改方法
            if (MODELSTATE === 'Added') {
                url = '/CustomerInvoices/Create';
            }
            var token = $('input[name="__RequestVerificationToken"]', $customerinvoiceform).val();
            $.ajax({
                    type: "POST",
                    url: url,
                    data: {
                        __RequestVerificationToken: token,
                        customerinvoice:customerinvoice
                    },
                    dataType: 'json',
                    contentType: 'application/x-www-form-urlencoded; charset=utf-8'
                })
                .done(response => {
                    if (response.success) {
                        hook = false;
                        $customerinvoiceform.form('disableValidation');
                        $('#customerinvoicedetailwindow').window("close");
                        toastr.success("保存成功"); 
                        reloadData();
                    } else {
                        $.messager.alert("错误",   response.err, "error");
                    }
                    })
                .fail((jqXHR, textStatus, errorThrown) => {
                       $.messager.alert('异常', `${jqXHR.status}: ${jqXHR.statusText} `, 'error');
                    });
        }
    }
    //关闭窗口
    function closecustomerinvoicedetailwindow() {
        $('#customerinvoicedetailwindow').window('close');
    }
     //判断是否有没有保存的记录
     function customerinvoicehasmodified() {
            return hook;

     }


function initcustomerinvoicedetailview() {
  //判断是否显示功能按钮
  if (MODELSTATE === 'Added') {
    $('#deleteitem-btn-group').hide();
  } else {
    $('#deleteitem-btn-group').show();
  }

//回车光标移动到下个输入控件
    //如果是枚举类型需要把numberbox改成combobox
    //发票税点
	$('#InvTax').numberbox('textbox').bind('keydown', function (e) {
      if (e.keyCode == 13) {
        $(e.target).emulateTab();
      }
    });
    //所属客户默认外键使用combobox,也可以使用combogrid
	$('#CustomerId').combobox('textbox').bind('keydown', function (e) {
      if (e.keyCode == 13) {
        $(e.target).emulateTab();
      }
    });
}
</script>

