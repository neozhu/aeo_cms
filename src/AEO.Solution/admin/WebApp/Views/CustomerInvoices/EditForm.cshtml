﻿@model WebApp.Models.CustomerInvoice
  <div class="form-row">
   @Html.HiddenFor(x=>x.Id)
         <!--发票名称-->
        <div class="col-xs-12 col-sm-6 col-md-4 col-lg-3">
            <label class="form-label">  @Html.DisplayNameFor(model => model.InvName)</label>
			@Html.EditorFor(x => x.InvName, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.InvName) } })
      
         </div>

        <!--发票类型-->
        <div class="col-xs-12 col-sm-6 col-md-4 col-lg-3">
            <label class="form-label"> <span class="text-danger">*</span> @Html.DisplayNameFor(model => model.InvType)</label>
			@Html.EditorFor(x => x.InvType, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.InvType) } })
      
         </div>

        <!--发票国家-->
        <div class="col-xs-12 col-sm-6 col-md-4 col-lg-3">
            <label class="form-label">  @Html.DisplayNameFor(model => model.InvCountry)</label>
			@Html.EditorFor(x => x.InvCountry, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.InvCountry) } })
      
         </div>

		<!--发票税点-->
        <div class="col-xs-12 col-sm-6 col-md-4 col-lg-3">
            <label class="form-label"> <span class="text-danger">*</span> @Html.DisplayNameFor(model => model.InvTax)</label>
            @Html.EditorFor(x => x.InvTax, new { htmlAttributes = new { @class = "form-control",@type="number", placeholder = Html.DisplayNameFor(x => x.InvTax) } })

        </div>

        <!--税务等级号-->
        <div class="col-xs-12 col-sm-6 col-md-4 col-lg-3">
            <label class="form-label">  @Html.DisplayNameFor(model => model.TaxNo)</label>
			@Html.EditorFor(x => x.TaxNo, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.TaxNo) } })
      
         </div>

        <!--发票用途-->
        <div class="col-xs-12 col-sm-6 col-md-4 col-lg-3">
            <label class="form-label">  @Html.DisplayNameFor(model => model.InvUse)</label>
			@Html.EditorFor(x => x.InvUse, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.InvUse) } })
      
         </div>

        <!--备注说明-->
        <div class="col-xs-12 col-sm-6 col-md-4 col-lg-3">
            <label class="form-label">  @Html.DisplayNameFor(model => model.Remark)</label>
			@Html.EditorFor(x => x.Remark, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.Remark) } })
      
         </div>

        <!--客户编号-->
        <div class="col-xs-12 col-sm-6 col-md-4 col-lg-3">
            <label class="form-label"> <span class="text-danger">*</span> @Html.DisplayNameFor(model => model.CustomerCode)</label>
			@Html.EditorFor(x => x.CustomerCode, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.CustomerCode) } })
      
         </div>

        <!--客户名称-->
        <div class="col-xs-12 col-sm-6 col-md-4 col-lg-3">
            <label class="form-label"> <span class="text-danger">*</span> @Html.DisplayNameFor(model => model.CustomerName)</label>
			@Html.EditorFor(x => x.CustomerName, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.CustomerName) } })
      
         </div>

     
       <!--所属客户-->
       <div class="col-xs-12 col-sm-6 col-md-4 col-lg-3">
            <label class="form-label"> <span class="text-danger">*</span> @Html.DisplayNameFor(model => model.CustomerId)</label>
   	        @Html.DropDownListFor(model => model.CustomerId, ViewBag.CustomerId as List<SelectListItem>, htmlAttributes: new { @class = "form-control" }) 
       </div>

	    
</div>

