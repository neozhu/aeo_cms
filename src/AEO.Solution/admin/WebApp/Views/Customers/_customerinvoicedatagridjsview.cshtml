@model WebApp.Models.CustomerInvoice
<script type="text/javascript">
    //是否开启行内编辑
    var SUBEDITINLINE = false;
   //初始化 CustomerInvoice datagrid
   var $customerinvoicedg = $('#customerinvoice_datagrid');
   //当前行记录
   var customerinvoice = {};
   //datagrid CRUD method
    var customerinvoice_editIndex = undefined;
    //取消
    function customerinvoice_reject() {
		$customerinvoicedg.datagrid('rejectChanges');
		customerinvoice_editIndex = undefined;
    }
    //重新加载数据
    function customerinvoice_reload() {
			if (customerinvoice_endEditing()) {
				$customerinvoicedg.datagrid('reload');
			}
	}
    //关闭编辑状态
	function customerinvoice_endEditing() {
			if (customerinvoice_editIndex === undefined) {
                return true; 
            }
			if ($customerinvoicedg.datagrid('validateRow', customerinvoice_editIndex)) {
				$customerinvoicedg.datagrid('endEdit', customerinvoice_editIndex);
				customerinvoice_editIndex = undefined;
                return true;
			} else {
				const invalidinput = $('input.validatebox-invalid',$customerinvoicedg.datagrid('getPanel'));
                const fieldnames = invalidinput.map((index, item) => {
                  return $(item).attr('placeholder') || $(item).attr('id');
                });
                $.messager.alert('提示', `${Array.from(fieldnames)} 输入有误.`, 'error');
				return false;
			}
		}
    //单击列开启编辑功能
	function customerinvoice_onClickCell(index, field) {
			const _operates = ['_operate1', 'ck'];
             $('button[name*=\'customerinvoicedeletebutton\']').prop('disabled', false);
			if (!SUBEDITINLINE || $.inArray(field, _operates) >= 0) {
				return false;
			}
			if (customerinvoice_editIndex !== index) {
				if (customerinvoice_endEditing()) {
					$customerinvoicedg.datagrid('selectRow', index)
							.datagrid('beginEdit', index);
                    //customerinvoice_editIndex = index;
					var ed = $customerinvoicedg.datagrid('getEditor', { index: index, field: field });
					if (ed) {
						($(ed.target).data('textbox') ? $(ed.target).textbox('textbox') : $(ed.target)).focus();
					}
				} else {
					$customerinvoicedg.datagrid('selectRow', customerinvoice_editIndex);
				}
			}
		}
    //双击弹出编辑当前行对话框
    function customerinvoice_onDblClickRow(index, row) {
        if (!SUBEDITINLINE) {
            open_customerinvoicedlg(index, row, 'Modified');
        }
    }
    //订阅对话框新增返回事件
    $(document).on('customerinvoice_form.add', (e, index,item) => {
        $customerinvoicedg.datagrid("insertRow",
            {
                index: 0,
                row: item
            });
    });
    //订阅对话框修改返回事件
    $(document).on('customerinvoice_form.edit', (e,index, item) => {
        $customerinvoicedg.datagrid('updateRow', {
            index: index,
            row: item
        });
    });
    //新增记录
    function customerinvoice_append() {
       const $customerform = $('#customer_form');
       if ($customerform.form('enableValidation').form('validate')) {
          const customer = $customerform.serializeJSON();
       const item = {
          CustomerCode: 'customer.CustomerCode', 
CustomerName: 'customer.CustomerName', 
CustomerId: customer.Id, 

          CustomerId:customer.Id
        };
      if (!SUBEDITINLINE) {
        open_customerinvoicedlg(0, item, 'Added');
      } else {
			if (customerinvoice_endEditing()) {
				//对必填字段进行默认值初始化
				$customerinvoicedg.datagrid('insertRow', 
                               { index: 0,
                                  row: item 
                               });
				customerinvoice_editIndex = 0;
				$customerinvoicedg.datagrid('selectRow', customerinvoice_editIndex)
						.datagrid('beginEdit', customerinvoice_editIndex);
			}
        }
        }
	 }
    //删除编辑的行
	function customerinvoice_removeit() {
		if (customerinvoice_editIndex !== undefined) {  
            const delindex = orderdetail_editIndex;
			$customerinvoicedg.datagrid('cancelEdit', delindex)
					           .datagrid('deleteRow', delindex);

        } else {
           const row = $customerinvoicedg.datagrid('getSelected');
           if(row){
             const rowindex = $customerinvoicedg.datagrid('getRowIndex', row);
             $customerinvoicedg.datagrid('deleteRow', rowindex);
           }else{
             $.messager.alert('提示', '没有选中删除的记录.', 'info');
           }
        }
	}
    //删除选中的行
    function customerinvoice_deletechecked() {
            const rows = $customerinvoicedg.datagrid('getChecked');
            if (rows.length > 0) {
                var id = rows.filter(item=>item.Id!=null).map(item => {
                    return item.Id;
                });
                $.messager.confirm('确认', `你确定要删除这 <span class='badge bg-color-red'>${id.length}</span> 行记录?`,result => {
                    if (result) {
                        $.post('/CustomerInvoices/DeleteChecked', { id: id })
                         .done(response => {
                            if (response.success) {
                                $customerinvoicedg.datagrid('reload');
                            } else {
                                $.messager.alert('错误', response.err,'error');
                            }
                         });
                    }
                });  
            } else {
                $.messager.alert('提示', '请先选择要删除的记录!','question');
            }
      }
  //获取修改的行
  function customerinvoice_getchanges() {
    if (customerinvoice_endEditing()) {
      if ($customerinvoicedg.datagrid('getChanges').length > 0) {
        const inserted = $customerinvoicedg.datagrid('getChanges', 'inserted').map(item => {
          item.TrackingState = 1;
          return item;
        });
        const deleted = $customerinvoicedg.datagrid('getChanges', 'deleted').map(item => {
          item.TrackingState = 3;
          return item;
        });
        const updated = $customerinvoicedg.datagrid('getChanges', 'updated').map(item => {
          item.TrackingState = 2;
          return item;
        });
        //过滤已删除的重复项
        const changed = inserted.concat(updated.filter(item => {
          return !deleted.includes(item);
        })).concat(deleted);
        return { success: true, changed };
      } else {
        return { success: true, changed:undefined};
      }
    } else {
      return { success: false,changed:undefined };
    }
  }
  //提交修改的数据
  function customerinvoice_acceptchanges() {
    $customerinvoicedg.datagrid('acceptChanges');
  }
    //提交保存后台数据库
  async function customerinvoice_accept() {
			if (customerinvoice_endEditing()) {
				if ($customerinvoicedg.datagrid('getChanges').length > 0) {
					const inserted = $customerinvoicedg.datagrid('getChanges', 'inserted').map(item => {
                       item.TrackingState = 1;
                       return item;
                    });
					const deleted = $customerinvoicedg.datagrid('getChanges', 'deleted').map(item => {
                       item.TrackingState = 3;
                       return item;
                    });
					const updated = $customerinvoicedg.datagrid('getChanges', 'updated').map(item => {
                       item.TrackingState = 2;
                       return item;
                    });
					//过滤已删除的重复项
                    const changed = inserted.concat(updated.filter(item => {
                           return !deleted.includes(item);
                         })).concat(deleted);
                   //console.table(changed);
				  if (MODELSTATE === 'Added') {
                    return { success:true, changed };
                  } else {
                    const response = await $.post('/CustomerInvoices/SaveData', {customerinvoices:changed});
                    response.changed = undefined;
    				if (response.success) {
							toastr.success('保存明细成功'); 
							$customerinvoicedg.datagrid('acceptChanges');
							$customerinvoicedg.datagrid('reload');
                            return { success:true}; 
				    } else {
                           $.messager.alert('错误', response.err ,'error');
                           return { success:false, err:response.err };
                    }
                   }
				} else {
                  return { success: true, changed: undefined};
                }
			} else {
               return { success: false };
            }
      }


$(() => {
    $customerinvoicedg.datagrid({
            fit: false,
            height: 300,
            rownumbers: true,
            idField: 'Id',
            sortName: 'Id',
            sortOrder: 'asc',
            remoteFilter: true,
            singleSelect: true,
            checkOnSelect: false,
		    selectOnCheck: false,
            method: 'get',
            pageList: [10, 20, 50, 100,1000],
            pagination: true,
            clientPaging:false,
            onDblClickRow: customerinvoice_onDblClickRow,
            onClickCell: customerinvoice_onClickCell,
            onSelect: function(index,row) {
              customerinvoice = row;
            },
            onLoadSuccess: function (data) {
              customerinvoice_editIndex = undefined;
            },
            onBeginEdit: function (index, row) {
               //const editors = $(this).datagrid('getEditors', index);
  
            },
            onEndEdit: function (index, row) {

             },
             onBeforeEdit: function (index, row) {
                 customerinvoice_editIndex = index;
                 row.editing = true;
                 $(this).datagrid('refreshRow', index);
             },
             onAfterEdit: function (index, row) {
                   row.editing = false;
                   customerinvoice_editIndex = undefined;
                   $(this).datagrid('refreshRow', index);
             },
             onCancelEdit: function (index, row) {
                customerinvoice_editIndex = undefined;
                row.editing = false;
                $(this).datagrid('refreshRow', index);
            },
            pagination: true,
            striped: true,
            columns: [[
		     
			{    /*发票名称*/
                 field:'InvName', 
                 title:'  @Html.DisplayNameFor(model => model.InvName)', 
                 width:160,
                 editor:{
                          type:'textbox',
                          options:{ 
                                 id:'editor_InvName',
                                 prompt:'@Html.DescriptionFor(model => model.InvName)',
                                 required:false, 
                                 validType: 'length[0,80]' 
                                 }  
                       },
                 sortable:true,
                 hidden:false,
                 resizable:true 
			},
			{    /*发票类型*/
                 field:'InvType', 
                 title:'<span class="text-danger">*</span>  @Html.DisplayNameFor(model => model.InvType)', 
                 width:160,
                 editor:{
                          type:'textbox',
                          options:{ 
                                 id:'editor_InvType',
                                 prompt:'@Html.DescriptionFor(model => model.InvType)',
                                 required:true, 
                                 validType: 'length[0,100]' 
                                 }  
                       },
                 sortable:true,
                 hidden:false,
                 resizable:true 
			},
			{    /*发票国家*/
                 field:'InvCountry', 
                 title:'  @Html.DisplayNameFor(model => model.InvCountry)', 
                 width:160,
                 editor:{
                          type:'textbox',
                          options:{ 
                                 id:'editor_InvCountry',
                                 prompt:'@Html.DescriptionFor(model => model.InvCountry)',
                                 required:false, 
                                 validType: 'length[0,100]' 
                                 }  
                       },
                 sortable:true,
                 hidden:false,
                 resizable:true 
			},
			{    /*发票税点*/
                 field:'InvTax', 
                 title:'<span class="text-danger">*</span>  @Html.DisplayNameFor(model => model.InvTax)', 
                 width:100, 
                 align:'right',
                 hidden:false,
                 editor:{
                        type:'numberbox',
                        options:{ 
                                  id:'editor_InvTax',
                                  prompt:'@Html.DescriptionFor(model => model.InvTax)',
                                  required:true,
                                  precision:2,
                                  validType:'decimal',
                                  
                                 } 
                        },
                sortable:true,
                resizable:true,
                formatter:numberformatter
			},
			{    /*税务等级号*/
                 field:'TaxNo', 
                 title:'  @Html.DisplayNameFor(model => model.TaxNo)', 
                 width:160,
                 editor:{
                          type:'textbox',
                          options:{ 
                                 id:'editor_TaxNo',
                                 prompt:'@Html.DescriptionFor(model => model.TaxNo)',
                                 required:false, 
                                 validType: 'length[0,100]' 
                                 }  
                       },
                 sortable:true,
                 hidden:false,
                 resizable:true 
			},
			{    /*发票用途*/
                 field:'InvUse', 
                 title:'  @Html.DisplayNameFor(model => model.InvUse)', 
                 width:200,
                 editor:{
                          type:'textbox',
                          options:{ 
                                 id:'editor_InvUse',
                                 prompt:'@Html.DescriptionFor(model => model.InvUse)',
                                 required:false, 
                                 validType: 'length[0,256]' 
                                 }  
                       },
                 sortable:true,
                 hidden:false,
                 resizable:true 
			},
			{    /*备注说明*/
                 field:'Remark', 
                 title:'  @Html.DisplayNameFor(model => model.Remark)', 
                 width:200,
                 editor:{
                          type:'textbox',
                          options:{ 
                                 id:'editor_Remark',
                                 prompt:'@Html.DescriptionFor(model => model.Remark)',
                                 required:false, 
                                 validType: 'length[0,256]' 
                                 }  
                       },
                 sortable:true,
                 hidden:false,
                 resizable:true 
			},
			{    /*客户编号*/
                 field:'CustomerCode', 
                 title:'<span class="text-danger">*</span>  @Html.DisplayNameFor(model => model.CustomerCode)', 
                 width:120,
                 editor:{
                          type:'textbox',
                          options:{ 
                                 id:'editor_CustomerCode',
                                 prompt:'@Html.DescriptionFor(model => model.CustomerCode)',
                                 required:true, 
                                 validType: 'length[0,20]' 
                                 }  
                       },
                 sortable:true,
                 hidden:false,
                 resizable:true 
			},
			{    /*客户名称*/
                 field:'CustomerName', 
                 title:'<span class="text-danger">*</span>  @Html.DisplayNameFor(model => model.CustomerName)', 
                 width:160,
                 editor:{
                          type:'textbox',
                          options:{ 
                                 id:'editor_CustomerName',
                                 prompt:'@Html.DescriptionFor(model => model.CustomerName)',
                                 required:true, 
                                 validType: 'length[0,80]' 
                                 }  
                       },
                 sortable:true,
                 hidden:false,
                 resizable:true 
			},
            ]]
            })
            .datagrid('enableFilter',[
				{    /*发票税点*/
					  field: 'InvTax',
					  type: 'numberbox',
					  op:['equal','notequal','less','lessorequal','greater','greaterorequal']
				  },
		   ]);
  });
      
</script>


 