@model WebApp.Models.CustomerCommunication
<div id="customercommunicationdlg" class="easyui-dialog"
     title="CustomerCommunication" style="width:600px;height:300px; display:none"
     data-options="
                iconCls: 'fal fa-window',
                modal:true,
                closed:true,
                cache: false,
                resizable:true,
                width:620,
                height:300,
                onOpen:function(){
                   $('#customercommunication_form').form('disableValidation');
                },
                buttons: [{
                    text:'确认',
                    handler:function(){
                        confirm_customercommunicationform();
                    }
                },{
                    text:'取消',
                    handler:function(){
                        $('#customercommunicationdlg').dialog('close');
                    }
                }]
            ">
<div class="panel-container show">
      <div class="panel-content p-0">
        <form id="customercommunication_form" class="form-horizontal needs-validation" novalidate>
          <fieldset class="form-group">
            <div class="row h-100 align-items-center m-0 pt-1">
    <!--Id-->
	@Html.HiddenFor(model => model.Id)		
             
    <!--会议主题-->
        <label class="col-md-2 form-label text-right p-0" for="@Html.IdFor(model => model.Title)" >@Html.DisplayNameFor(model => model.Title) <span class="text-danger">*</span></label>
<div class="col-md-4 mb-1">
		<input id="@Html.IdFor(model => model.Title)" 
							name="@Html.NameFor(model => model.Title)" 
							value="@Html.ValueFor(model => model.Title)"
							tabindex="1" 
			     			class="easyui-textbox" 
							type="text" 
                            style="width:100%"
							data-options="prompt:'@Html.DisplayNameFor(model => model.Title)',
     						 required:true ,validType:'length[0,128]'" />
    </div>
             
    <!--沟通类型-->
        <label class="col-md-2 form-label text-right p-0" for="@Html.IdFor(model => model.CommType)" >@Html.DisplayNameFor(model => model.CommType) <span class="text-danger">*</span></label>
<div class="col-md-4 mb-1">
		<input id="@Html.IdFor(model => model.CommType)" 
							name="@Html.NameFor(model => model.CommType)" 
							value="@Html.ValueFor(model => model.CommType)"
							tabindex="2" 
			     			class="easyui-textbox" 
							type="text" 
                            style="width:100%"
							data-options="prompt:'@Html.DisplayNameFor(model => model.CommType)',
     						 required:true ,validType:'length[0,20]'" />
    </div>
             
    <!--状态-->
        <label class="col-md-2 form-label text-right p-0" for="@Html.IdFor(model => model.Status)" >@Html.DisplayNameFor(model => model.Status) </label>
<div class="col-md-4 mb-1">
		<input id="@Html.IdFor(model => model.Status)" 
							name="@Html.NameFor(model => model.Status)" 
							value="@Html.ValueFor(model => model.Status)"
							tabindex="3" 
			     			class="easyui-textbox" 
							type="text" 
                            style="width:100%"
							data-options="prompt:'@Html.DisplayNameFor(model => model.Status)',
     						 required:false ,validType:'length[0,20]'" />
    </div>
             
    <!--业务员-->
        <label class="col-md-2 form-label text-right p-0" for="@Html.IdFor(model => model.Salesman)" >@Html.DisplayNameFor(model => model.Salesman) </label>
<div class="col-md-4 mb-1">
		<input id="@Html.IdFor(model => model.Salesman)" 
							name="@Html.NameFor(model => model.Salesman)" 
							value="@Html.ValueFor(model => model.Salesman)"
							tabindex="4" 
			     			class="easyui-textbox" 
							type="text" 
                            style="width:100%"
							data-options="prompt:'@Html.DisplayNameFor(model => model.Salesman)',
     						 required:false ,validType:'length[0,20]'" />
    </div>
             
    <!--参与人-->
        <label class="col-md-2 form-label text-right p-0" for="@Html.IdFor(model => model.RefUsers)" >@Html.DisplayNameFor(model => model.RefUsers) </label>
<div class="col-md-4 mb-1">
		<input id="@Html.IdFor(model => model.RefUsers)" 
							name="@Html.NameFor(model => model.RefUsers)" 
							value="@Html.ValueFor(model => model.RefUsers)"
							tabindex="5" 
			     			class="easyui-textbox" 
							type="text" 
                            style="width:100%"
							data-options="prompt:'@Html.DisplayNameFor(model => model.RefUsers)',
     						 required:false ,validType:'length[0,128]'" />
    </div>
             
     <!--开始日期-->
          <label class="col-md-2 form-label text-right p-0" for="@Html.IdFor(model => model.BeginDate)" >@Html.DisplayNameFor(model => model.BeginDate) </label>
		  <div class="col-md-4 mb-1">
          <input id="@Html.IdFor(model => model.BeginDate)" 
							name="@Html.NameFor(model => model.BeginDate)" 
							tabindex="6" 
							class="easyui-datebox" 
                            type="text"
                            style="width:100%"
							value="@Html.ValueFor(model => model.BeginDate)"
							data-options="prompt:'@Html.DisplayNameFor(model => model.BeginDate)',
								 formatter:dateformatter,
                                 required:false " />
     </div>
             
     <!--结束日期-->
          <label class="col-md-2 form-label text-right p-0" for="@Html.IdFor(model => model.EndDate)" >@Html.DisplayNameFor(model => model.EndDate) </label>
		  <div class="col-md-4 mb-1">
          <input id="@Html.IdFor(model => model.EndDate)" 
							name="@Html.NameFor(model => model.EndDate)" 
							tabindex="7" 
							class="easyui-datebox" 
                            type="text"
                            style="width:100%"
							value="@Html.ValueFor(model => model.EndDate)"
							data-options="prompt:'@Html.DisplayNameFor(model => model.EndDate)',
								 formatter:dateformatter,
                                 required:false " />
     </div>
             
    <!--备注-->
        <label class="col-md-2 form-label text-right p-0" for="@Html.IdFor(model => model.Remark)" >@Html.DisplayNameFor(model => model.Remark) </label>
<div class="col-md-4 mb-1">
		<input id="@Html.IdFor(model => model.Remark)" 
							name="@Html.NameFor(model => model.Remark)" 
							value="@Html.ValueFor(model => model.Remark)"
							tabindex="8" 
			     			class="easyui-textbox" 
							type="text" 
                            style="width:100%"
							data-options="prompt:'@Html.DisplayNameFor(model => model.Remark)',
     						 required:false ,validType:'length[0,20]'" />
    </div>
             
    <!--客户编号-->
        <label class="col-md-2 form-label text-right p-0" for="@Html.IdFor(model => model.CustomerCode)" >@Html.DisplayNameFor(model => model.CustomerCode) <span class="text-danger">*</span></label>
<div class="col-md-4 mb-1">
		<input id="@Html.IdFor(model => model.CustomerCode)" 
							name="@Html.NameFor(model => model.CustomerCode)" 
							value="@Html.ValueFor(model => model.CustomerCode)"
							tabindex="9" 
			     			class="easyui-textbox" 
							type="text" 
                            style="width:100%"
							data-options="prompt:'@Html.DisplayNameFor(model => model.CustomerCode)',
     						 required:true ,validType:'length[0,20]'" />
    </div>
             
    <!--客户名称-->
        <label class="col-md-2 form-label text-right p-0" for="@Html.IdFor(model => model.CustomerName)" >@Html.DisplayNameFor(model => model.CustomerName) <span class="text-danger">*</span></label>
<div class="col-md-4 mb-1">
		<input id="@Html.IdFor(model => model.CustomerName)" 
							name="@Html.NameFor(model => model.CustomerName)" 
							value="@Html.ValueFor(model => model.CustomerName)"
							tabindex="10" 
			     			class="easyui-textbox" 
							type="text" 
                            style="width:100%"
							data-options="prompt:'@Html.DisplayNameFor(model => model.CustomerName)',
     						 required:true ,validType:'length[0,80]'" />
    </div>
             
      <!--所属客户-->
      <input type="hidden" id="CustomerCustomerCode" name="CustomerCustomerCode" value="">
	  <input id="@Html.IdFor(model => model.CustomerId)"
			       name="@Html.NameFor(model => model.CustomerId)"
				   value="@Html.ValueFor(model => model.CustomerId)"
                   type="hidden" />
             
  
           </div>
       </fieldset>
    </form>
  </div>
</div>
</div>
<script type="text/javascript">
     var form_state = 'Added';
     var current_index = -1;
     var customercommunication = {};
 
     function open_customercommunicationdlg(index, row, state) {
         form_state = state;
         current_index = index;
         customercommunication = row;
         $('#customercommunicationdlg').dialog('open');
         if (form_state === 'Added') {
             $('#customercommunicationdlg').dialog('setTitle', '新增明细');
         } else {
             $('#customercommunicationdlg').dialog('setTitle', '修改明细');
         }
         $('#customercommunication_form').form('reset');
         $('#customercommunication_form').form('load', customercommunication);
     }
     function confirm_customercommunicationform() {
         $customercommunicationform = $('#customercommunication_form');
         if ($customercommunicationform.form('enableValidation').form('validate')) {
             customercommunication = $customercommunicationform.serializeJSON();
             if (form_state === 'Added') {
                 $(document).trigger('customercommunication_form.add', [current_index, customercommunication])
             } else {
                 $(document).trigger('customercommunication_form.edit', [current_index, customercommunication])
             }
             $('#customercommunicationdlg').dialog('close');
         }
     }
 </script>

 