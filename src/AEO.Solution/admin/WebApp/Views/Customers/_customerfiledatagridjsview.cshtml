@model WebApp.Models.CustomerFile
<script type="text/javascript">
    //是否开启行内编辑
    var SUBEDITINLINE = false;
   //初始化 CustomerFile datagrid
   var $customerfiledg = $('#customerfile_datagrid');
   //当前行记录
   var customerfile = {};
   //datagrid CRUD method
    var customerfile_editIndex = undefined;
    //取消
    function customerfile_reject() {
		$customerfiledg.datagrid('rejectChanges');
		customerfile_editIndex = undefined;
    }
    //重新加载数据
    function customerfile_reload() {
			if (customerfile_endEditing()) {
				$customerfiledg.datagrid('reload');
			}
	}
    //关闭编辑状态
	function customerfile_endEditing() {
			if (customerfile_editIndex === undefined) {
                return true; 
            }
			if ($customerfiledg.datagrid('validateRow', customerfile_editIndex)) {
				$customerfiledg.datagrid('endEdit', customerfile_editIndex);
				customerfile_editIndex = undefined;
                return true;
			} else {
				const invalidinput = $('input.validatebox-invalid',$customerfiledg.datagrid('getPanel'));
                const fieldnames = invalidinput.map((index, item) => {
                  return $(item).attr('placeholder') || $(item).attr('id');
                });
                $.messager.alert('提示', `${Array.from(fieldnames)} 输入有误.`, 'error');
				return false;
			}
		}
    //单击列开启编辑功能
	function customerfile_onClickCell(index, field) {
			const _operates = ['_operate1', 'ck'];
             $('button[name*=\'customerfiledeletebutton\']').prop('disabled', false);
			if (!SUBEDITINLINE || $.inArray(field, _operates) >= 0) {
				return false;
			}
			if (customerfile_editIndex !== index) {
				if (customerfile_endEditing()) {
					$customerfiledg.datagrid('selectRow', index)
							.datagrid('beginEdit', index);
                    //customerfile_editIndex = index;
					var ed = $customerfiledg.datagrid('getEditor', { index: index, field: field });
					if (ed) {
						($(ed.target).data('textbox') ? $(ed.target).textbox('textbox') : $(ed.target)).focus();
					}
				} else {
					$customerfiledg.datagrid('selectRow', customerfile_editIndex);
				}
			}
		}
    //双击弹出编辑当前行对话框
    function customerfile_onDblClickRow(index, row) {
        if (!SUBEDITINLINE) {
            open_customerfiledlg(index, row, 'Modified');
        }
    }
    //订阅对话框新增返回事件
    $(document).on('customerfile_form.add', (e, index,item) => {
        $customerfiledg.datagrid("insertRow",
            {
                index: 0,
                row: item
            });
    });
    //订阅对话框修改返回事件
    $(document).on('customerfile_form.edit', (e,index, item) => {
        $customerfiledg.datagrid('updateRow', {
            index: index,
            row: item
        });
    });
    //新增记录
    function customerfile_append() {
       const $customerform = $('#customer_form');
       if ($customerform.form('enableValidation').form('validate')) {
          const customer = $customerform.serializeJSON();
       const item = {
          CustomerCode: 'customer.CustomerCode', 
CustomerName: 'customer.CustomerName', 
CustomerId: customer.Id, 

          CustomerId:customer.Id
        };
      if (!SUBEDITINLINE) {
        open_customerfiledlg(0, item, 'Added');
      } else {
			if (customerfile_endEditing()) {
				//对必填字段进行默认值初始化
				$customerfiledg.datagrid('insertRow', 
                               { index: 0,
                                  row: item 
                               });
				customerfile_editIndex = 0;
				$customerfiledg.datagrid('selectRow', customerfile_editIndex)
						.datagrid('beginEdit', customerfile_editIndex);
			}
        }
        }
	 }
    //删除编辑的行
	function customerfile_removeit() {
		if (customerfile_editIndex !== undefined) {  
            const delindex = orderdetail_editIndex;
			$customerfiledg.datagrid('cancelEdit', delindex)
					           .datagrid('deleteRow', delindex);

        } else {
           const row = $customerfiledg.datagrid('getSelected');
           if(row){
             const rowindex = $customerfiledg.datagrid('getRowIndex', row);
             $customerfiledg.datagrid('deleteRow', rowindex);
           }else{
             $.messager.alert('提示', '没有选中删除的记录.', 'info');
           }
        }
	}
    //删除选中的行
    function customerfile_deletechecked() {
            const rows = $customerfiledg.datagrid('getChecked');
            if (rows.length > 0) {
                var id = rows.filter(item=>item.Id!=null).map(item => {
                    return item.Id;
                });
                $.messager.confirm('确认', `你确定要删除这 <span class='badge bg-color-red'>${id.length}</span> 行记录?`,result => {
                    if (result) {
                        $.post('/CustomerFiles/DeleteChecked', { id: id })
                         .done(response => {
                            if (response.success) {
                                $customerfiledg.datagrid('reload');
                            } else {
                                $.messager.alert('错误', response.err,'error');
                            }
                         });
                    }
                });  
            } else {
                $.messager.alert('提示', '请先选择要删除的记录!','question');
            }
      }
  //获取修改的行
  function customerfile_getchanges() {
    if (customerfile_endEditing()) {
      if ($customerfiledg.datagrid('getChanges').length > 0) {
        const inserted = $customerfiledg.datagrid('getChanges', 'inserted').map(item => {
          item.TrackingState = 1;
          return item;
        });
        const deleted = $customerfiledg.datagrid('getChanges', 'deleted').map(item => {
          item.TrackingState = 3;
          return item;
        });
        const updated = $customerfiledg.datagrid('getChanges', 'updated').map(item => {
          item.TrackingState = 2;
          return item;
        });
        //过滤已删除的重复项
        const changed = inserted.concat(updated.filter(item => {
          return !deleted.includes(item);
        })).concat(deleted);
        return { success: true, changed };
      } else {
        return { success: true, changed:undefined};
      }
    } else {
      return { success: false,changed:undefined };
    }
  }
  //提交修改的数据
  function customerfile_acceptchanges() {
    $customerfiledg.datagrid('acceptChanges');
  }
    //提交保存后台数据库
  async function customerfile_accept() {
			if (customerfile_endEditing()) {
				if ($customerfiledg.datagrid('getChanges').length > 0) {
					const inserted = $customerfiledg.datagrid('getChanges', 'inserted').map(item => {
                       item.TrackingState = 1;
                       return item;
                    });
					const deleted = $customerfiledg.datagrid('getChanges', 'deleted').map(item => {
                       item.TrackingState = 3;
                       return item;
                    });
					const updated = $customerfiledg.datagrid('getChanges', 'updated').map(item => {
                       item.TrackingState = 2;
                       return item;
                    });
					//过滤已删除的重复项
                    const changed = inserted.concat(updated.filter(item => {
                           return !deleted.includes(item);
                         })).concat(deleted);
                   //console.table(changed);
				  if (MODELSTATE === 'Added') {
                    return { success:true, changed };
                  } else {
                    const response = await $.post('/CustomerFiles/SaveData', {customerfiles:changed});
                    response.changed = undefined;
    				if (response.success) {
							toastr.success('保存明细成功'); 
							$customerfiledg.datagrid('acceptChanges');
							$customerfiledg.datagrid('reload');
                            return { success:true}; 
				    } else {
                           $.messager.alert('错误', response.err ,'error');
                           return { success:false, err:response.err };
                    }
                   }
				} else {
                  return { success: true, changed: undefined};
                }
			} else {
               return { success: false };
            }
      }


$(() => {
    $customerfiledg.datagrid({
            fit: false,
            height: 300,
            rownumbers: true,
            idField: 'Id',
            sortName: 'Id',
            sortOrder: 'asc',
            remoteFilter: true,
            singleSelect: true,
            checkOnSelect: false,
		    selectOnCheck: false,
            method: 'get',
            pageList: [10, 20, 50, 100,1000],
            pagination: true,
            clientPaging:false,
            onDblClickRow: customerfile_onDblClickRow,
            onClickCell: customerfile_onClickCell,
            onSelect: function(index,row) {
              customerfile = row;
            },
            onLoadSuccess: function (data) {
              customerfile_editIndex = undefined;
            },
            onBeginEdit: function (index, row) {
               //const editors = $(this).datagrid('getEditors', index);
  
            },
            onEndEdit: function (index, row) {

             },
             onBeforeEdit: function (index, row) {
                 customerfile_editIndex = index;
                 row.editing = true;
                 $(this).datagrid('refreshRow', index);
             },
             onAfterEdit: function (index, row) {
                   row.editing = false;
                   customerfile_editIndex = undefined;
                   $(this).datagrid('refreshRow', index);
             },
             onCancelEdit: function (index, row) {
                customerfile_editIndex = undefined;
                row.editing = false;
                $(this).datagrid('refreshRow', index);
            },
            pagination: true,
            striped: true,
            columns: [[
		     
			{    /*文件名*/
                 field:'FileName', 
                 title:'<span class="text-danger">*</span>  @Html.DisplayNameFor(model => model.FileName)', 
                 width:160,
                 editor:{
                          type:'textbox',
                          options:{ 
                                 id:'editor_FileName',
                                 prompt:'@Html.DescriptionFor(model => model.FileName)',
                                 required:true, 
                                 validType: 'length[0,100]' 
                                 }  
                       },
                 sortable:true,
                 hidden:false,
                 resizable:true 
			},
			{    /*大小*/
                 field:'Size', 
                 title:'<span class="text-danger">*</span>  @Html.DisplayNameFor(model => model.Size)', 
                 width:100, 
                 align:'right',
                 hidden:false,
                 editor:{
                        type:'numberbox',
                        options:{ 
                                  id:'editor_Size',
                                  prompt:'@Html.DescriptionFor(model => model.Size)',
                                  required:true,
                                  precision:2,
                                  validType:'decimal',
                                  
                                 } 
                        },
                sortable:true,
                resizable:true,
                formatter:numberformatter
			},
			{    /*目录*/
                 field:'Folder', 
                 title:'  @Html.DisplayNameFor(model => model.Folder)', 
                 width:120,
                 editor:{
                          type:'textbox',
                          options:{ 
                                 id:'editor_Folder',
                                 prompt:'@Html.DescriptionFor(model => model.Folder)',
                                 required:false, 
                                 validType: 'length[0,20]' 
                                 }  
                       },
                 sortable:true,
                 hidden:false,
                 resizable:true 
			},
			{    /*保存路径*/
                 field:'FilePath', 
                 title:'  @Html.DisplayNameFor(model => model.FilePath)', 
                 width:160,
                 editor:{
                          type:'textbox',
                          options:{ 
                                 id:'editor_FilePath',
                                 prompt:'@Html.DescriptionFor(model => model.FilePath)',
                                 required:false, 
                                 validType: 'length[0,50]' 
                                 }  
                       },
                 sortable:true,
                 hidden:false,
                 resizable:true 
			},
			{    /*相对路径*/
                 field:'RelativePath', 
                 title:'  @Html.DisplayNameFor(model => model.RelativePath)', 
                 width:160,
                 editor:{
                          type:'textbox',
                          options:{ 
                                 id:'editor_RelativePath',
                                 prompt:'@Html.DescriptionFor(model => model.RelativePath)',
                                 required:false, 
                                 validType: 'length[0,50]' 
                                 }  
                       },
                 sortable:true,
                 hidden:false,
                 resizable:true 
			},
			{    /*上传用户*/
                 field:'Owner', 
                 title:'  @Html.DisplayNameFor(model => model.Owner)', 
                 width:120,
                 editor:{
                          type:'textbox',
                          options:{ 
                                 id:'editor_Owner',
                                 prompt:'@Html.DescriptionFor(model => model.Owner)',
                                 required:false, 
                                 validType: 'length[0,20]' 
                                 }  
                       },
                 sortable:true,
                 hidden:false,
                 resizable:true 
			},
            {   /*上传时间*/
                field:'Upload', 
                title:'<span class="text-danger">*</span>  @Html.DisplayNameFor(model => model.Upload)', 
                width:100, 
                align:'right', 
                hidden:false,
                editor:{
                      type:'datebox',
                      options:{
                           id:'editor_Upload',
                           prompt:'@Html.DescriptionFor(model => model.Upload)',
                           required:true
                           }  
                      },
                sortable:true, 
                resizable:true, 
                formatter:dateformatter 
			} ,
			{    /*附件类型*/
                 field:'Ext', 
                 title:'  @Html.DisplayNameFor(model => model.Ext)', 
                 width:160,
                 editor:{
                          type:'textbox',
                          options:{ 
                                 id:'editor_Ext',
                                 prompt:'@Html.DescriptionFor(model => model.Ext)',
                                 required:false, 
                                 validType: 'length[0,100]' 
                                 }  
                       },
                 sortable:true,
                 hidden:false,
                 resizable:true 
			},
			{    /*文件ID*/
                 field:'FileId', 
                 title:'  @Html.DisplayNameFor(model => model.FileId)', 
                 width:160,
                 editor:{
                          type:'textbox',
                          options:{ 
                                 id:'editor_FileId',
                                 prompt:'@Html.DescriptionFor(model => model.FileId)',
                                 required:false, 
                                 validType: 'length[0,100]' 
                                 }  
                       },
                 sortable:true,
                 hidden:false,
                 resizable:true 
			},
			{    /*关联单号*/
                 field:'RefKey', 
                 title:'  @Html.DisplayNameFor(model => model.RefKey)', 
                 width:160,
                 editor:{
                          type:'textbox',
                          options:{ 
                                 id:'editor_RefKey',
                                 prompt:'@Html.DescriptionFor(model => model.RefKey)',
                                 required:false, 
                                 validType: 'length[0,100]' 
                                 }  
                       },
                 sortable:true,
                 hidden:false,
                 resizable:true 
			},
			{    /*客户编号*/
                 field:'CustomerCode', 
                 title:'<span class="text-danger">*</span>  @Html.DisplayNameFor(model => model.CustomerCode)', 
                 width:120,
                 editor:{
                          type:'textbox',
                          options:{ 
                                 id:'editor_CustomerCode',
                                 prompt:'@Html.DescriptionFor(model => model.CustomerCode)',
                                 required:true, 
                                 validType: 'length[0,20]' 
                                 }  
                       },
                 sortable:true,
                 hidden:false,
                 resizable:true 
			},
			{    /*客户名称*/
                 field:'CustomerName', 
                 title:'<span class="text-danger">*</span>  @Html.DisplayNameFor(model => model.CustomerName)', 
                 width:160,
                 editor:{
                          type:'textbox',
                          options:{ 
                                 id:'editor_CustomerName',
                                 prompt:'@Html.DescriptionFor(model => model.CustomerName)',
                                 required:true, 
                                 validType: 'length[0,80]' 
                                 }  
                       },
                 sortable:true,
                 hidden:false,
                 resizable:true 
			},
            ]]
            })
            .datagrid('enableFilter',[
				{    /*大小*/
					  field: 'Size',
					  type: 'numberbox',
					  op:['equal','notequal','less','lessorequal','greater','greaterorequal']
				  },
				{     /*上传时间*/
					  field: 'Upload',
					  type: 'dateRange',
					  options: {
					  }
				  },
		   ]);
  });
      
</script>


 