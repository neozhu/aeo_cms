             }
            const customersales = $customersalesdg.datagrid("getChanges");
            if (MODELSTATE == 'Modified' && customersales.length > 0) {
                return true;
            }
            if (!customershare_endEditing()) {
                 return true;
             }
            const customershares = $customersharedg.datagrid("getChanges");
            if (MODELSTATE == 'Modified' && customershares.length > 0) {
                return true;
            }
            if (!customerwarehouse_endEditing()) {
                 return true;
             }
            const customerwarehouses = $customerwarehousedg.datagrid("getChanges");
            if (MODELSTATE == 'Modified' && customerwarehouses.length > 0) {
                return true;
            }
            return false;
         } else {
            return hook;
         }

     }


