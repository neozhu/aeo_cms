  //删除当前记录
  function deletecustomeritem() {
    $.messager.confirm('确认', '你确定要删除该记录?', result => {
      if (result) {
        const url = `/Customers/Delete/${customerid}`;
        $.get(url).done(res => {
          if (res.success) {
            toastr.success("删除成功");
            $('#customerdetailwindow').window('close');
            reloadData();
          } else {
            $.messager.alert('错误', res.err, 'error');
          }
        });
      }
    });
  }
    //async 保存数据
    async function savecustomeritem() { 
      const $customerform = $('#customer_form');
      if ($customerform.form('enableValidation').form('validate')) {
            let customer = $customerform.serializeJSON();
				  //获取明细表数据
 
                      const customerattentionproduct_result = await customerattentionproduct_accept();
                      if (!customerattentionproduct_result.success) {
                         return false;
                      } else {
                         customer.CustomerAttentionProducts = customerattentionproduct_result.changed;
                      }
                      
 
                      const customerbank_result = await customerbank_accept();
                      if (!customerbank_result.success) {
                         return false;
                      } else {
                         customer.CustomerBanks = customerbank_result.changed;
                      }
                      
 
                      const customercommunication_result = await customercommunication_accept();
                      if (!customercommunication_result.success) {
                         return false;
                      } else {
                         customer.CustomerCommunications = customercommunication_result.changed;
                      }
                      
 
                      const customercontact_result = await customercontact_accept();
                      if (!customercontact_result.success) {
                         return false;
                      } else {
                         customer.CustomerContacts = customercontact_result.changed;
                      }
                      
 
                      const customerfile_result = await customerfile_accept();
                      if (!customerfile_result.success) {
                         return false;
                      } else {
                         customer.CustomerFiles = customerfile_result.changed;
                      }
                      
 
                      const customerfollow_result = await customerfollow_accept();
                      if (!customerfollow_result.success) {
                         return false;
                      } else {
                         customer.CustomerFollows = customerfollow_result.changed;
                      }
                      
 
                      const customerinvoice_result = await customerinvoice_accept();
                      if (!customerinvoice_result.success) {
                         return false;
                      } else {
                         customer.CustomerInvoices = customerinvoice_result.changed;
                      }
                      
 
                      const customersales_result = await customersales_accept();
                      if (!customersales_result.success) {
                         return false;
                      } else {
                         customer.CustomerSales = customersales_result.changed;
                      }
                      
 
                      const customershare_result = await customershare_accept();
                      if (!customershare_result.success) {
                         return false;
                      } else {
                         customer.CustomerShares = customershare_result.changed;
                      }
                      
 
                      const customerwarehouse_result = await customerwarehouse_accept();
                      if (!customerwarehouse_result.success) {
                         return false;
                      } else {
                         customer.CustomerWarehouses = customerwarehouse_result.changed;
                      }
                      
            let url = '/Customers/Edit';
            //判断是新增或是修改方法
            if (MODELSTATE === 'Added') {
                url = '/Customers/Create';
            }
            var token = $('input[name="__RequestVerificationToken"]', $customerform).val();
            $.ajax({
                    type: "POST",
                    url: url,
                    data: {
                        __RequestVerificationToken: token,
                        customer:customer
                    },
                    dataType: 'json',
                    contentType: 'application/x-www-form-urlencoded; charset=utf-8'
                })
                .done(response => {
                    if (response.success) {
                        hook = false;
                        $customerform.form('disableValidation');
                        $('#customerdetailwindow').window("close");
                        toastr.success("保存成功"); 
                        reloadData();
                    } else {
                        $.messager.alert("错误",   response.err, "error");
                    }
                    })
                .fail((jqXHR, textStatus, errorThrown) => {
                       $.messager.alert('异常', `${jqXHR.status}: ${jqXHR.statusText} `, 'error');
                    });
        }
    }
    //关闭窗口
    function closecustomerdetailwindow() {
        $('#customerdetailwindow').window('close');
    }
     //判断是否有没有保存的记录
     function customerhasmodified() {
      if(!hook) {
            if (!customerattentionproduct_endEditing()) {
                 return true;
             }
            const customerattentionproducts = $customerattentionproductdg.datagrid("getChanges");
            if (MODELSTATE == 'Modified' && customerattentionproducts.length > 0) {
                return true;
            }
            if (!customerbank_endEditing()) {
                 return true;
             }
            const customerbanks = $customerbankdg.datagrid("getChanges");
            if (MODELSTATE == 'Modified' && customerbanks.length > 0) {
                return true;
            }
            if (!customercommunication_endEditing()) {
                 return true;
             }
            const customercommunications = $customercommunicationdg.datagrid("getChanges");
            if (MODELSTATE == 'Modified' && customercommunications.length > 0) {
                return true;
