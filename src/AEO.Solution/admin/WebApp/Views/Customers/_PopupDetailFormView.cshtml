                 return true;
             }
            const customercontacts = $customercontactdg.datagrid("getChanges");
            if (MODELSTATE == 'Modified' && customercontacts.length > 0) {
                return true;
            }
            if (!customerfile_endEditing()) {
                 return true;
             }
            const customerfiles = $customerfiledg.datagrid("getChanges");
            if (MODELSTATE == 'Modified' && customerfiles.length > 0) {
                return true;
            }
            if (!customerfollow_endEditing()) {
                 return true;
             }
            const customerfollows = $customerfollowdg.datagrid("getChanges");
            if (MODELSTATE == 'Modified' && customerfollows.length > 0) {
                return true;
            }
            if (!customerinvoice_endEditing()) {
