    $('button[name="customerfile_appenditembutton"]').on('click', customerfile_appendItem);
    $('button[name="customerfile_deleterowbutton"]').on('click', customerfile_removeItem);
    $('button[name="customerfile_cancelchangesbutton"]').on('click', customerfile_rejectChanges);
    $('button[name="customerfile_savechangesbutton"]').on('click', customerfile_acceptChanges);
    $('button[name="customerfollow_searchbutton"]').on('click', customerfollow_reloadData);
    $('button[name="customerfollow_appenditembutton"]').on('click', customerfollow_appendItem);
    $('button[name="customerfollow_deleterowbutton"]').on('click', customerfollow_removeItem);
    $('button[name="customerfollow_cancelchangesbutton"]').on('click', customerfollow_rejectChanges);
    $('button[name="customerfollow_savechangesbutton"]').on('click', customerfollow_acceptChanges);
    $('button[name="customersales_searchbutton"]').on('click', customersales_reloadData);
    $('button[name="customersales_appenditembutton"]').on('click', customersales_appendItem);
    $('button[name="customersales_deleterowbutton"]').on('click', customersales_removeItem);
    $('button[name="customersales_cancelchangesbutton"]').on('click', customersales_rejectChanges);
    $('button[name="customersales_savechangesbutton"]').on('click', customersales_acceptChanges);
    $('button[name="customershare_searchbutton"]').on('click', customershare_reloadData);
    $('button[name="customershare_appenditembutton"]').on('click', customershare_appendItem);
    $('button[name="customershare_deleterowbutton"]').on('click', customershare_removeItem);
    $('button[name="customershare_cancelchangesbutton"]').on('click', customershare_rejectChanges);
    $('button[name="customershare_savechangesbutton"]').on('click', customershare_acceptChanges);
    $('button[name="customerwarehouse_searchbutton"]').on('click', customerwarehouse_reloadData);
    $('button[name="customerwarehouse_appenditembutton"]').on('click', customerwarehouse_appendItem);
    $('button[name="customerwarehouse_deleterowbutton"]').on('click', customerwarehouse_removeItem);
    $('button[name="customerwarehouse_cancelchangesbutton"]').on('click', customerwarehouse_rejectChanges);
    $('button[name="customerwarehouse_savechangesbutton"]').on('click', customerwarehouse_acceptChanges);
    $('a[data-toggle="tab"]').on('shown.bs.tab', (e) => {
      const model = $(e.target).data('model');
      $(`#${model}_datagrid`).datagrid('resize');

      
     
    })
  });
  //判断新增编辑状态
  var MODELSTATE = 'Added';
  var customerid = null;
  function opencustomerdetailwindow(data, state) {
    MODELSTATE = state;
    //判断是否显示功能按钮
    if (MODELSTATE === 'Added') {
      $('#deleteitem-btn-group').hide();
      $('#follow-btn-group').hide();
      $('#more-btn-group').hide();

    } else {
      $('#deleteitem-btn-group').show();
      $('#follow-btn-group').show();
      $('#more-btn-group').show();
    }
    initcustomerdetailview();
    customerid = (data.Id || 0);
    $('#customerdetailwindow').window('open');
    $('#customer_form').form('reset');
    $('#customer_form').form('load', data);
    var url = '/CustomerAttentionProducts/GetDataByCustomerId?customerid=' + customerid;
    $customerattentionproductdg.datagrid('load', url);
    $customerattentionproductdg.datagrid('resize');
    var url = '/CustomerBanks/GetDataByCustomerId?customerid=' + customerid;
    $customerbankdg.datagrid('load', url);
    $customerbankdg.datagrid('resize');
    var url = '/CustomerContacts/GetDataByCustomerId?customerid=' + customerid;
    $customercontactdg.datagrid('load', url);
    $customercontactdg.datagrid('resize');
    var url = '/CustomerFiles/GetDataByCustomerId?customerid=' + customerid;
    $customerfiledg.datagrid('load', url);
    $customerfiledg.datagrid('resize');
    var url = '/CustomerFollows/GetDataByCustomerId?customerid=' + customerid;
    $customerfollowdg.datagrid('load', url);
    $customerfollowdg.datagrid('resize');
    //var url = '/CustomerSaleses/GetDataByCustomerId?customerid=' + customerid;
    //$customersalesdg.datagrid('load', url);
    //$customersalesdg.datagrid('resize');
    var url = '/CustomerShares/GetDataByCustomerId?customerid=' + customerid;
    $customersharedg.datagrid('load', url);
    $customersharedg.datagrid('resize');
    var url = '/CustomerWarehouses/GetDataByCustomerId?customerid=' + customerid;
    $customerwarehousedg.datagrid('load', url);
    $customerwarehousedg.datagrid('resize');
    var url = '/ActionLogs/GetDataByRefKey?refkey=' + data.CustomerCode;
    $actionlogdg.datagrid('load', url);
    $actionlogdg.datagrid('resize');
  }
  //删除当前记录
  function deletecustomeritem() {
    $.messager.confirm('确认', '你确定要删除该记录?', result => {
      if (result) {
        const url = `/Customers/Delete/${customerid}`;
        $.get(url).done(res => {
          if (res.success) {
            toastr.success("删除成功");
            $('#customerdetailwindow').window('close');
            reloadData();
          } else {
            $.messager.alert('错误', res.err, 'error');
          }
        });
      }
    });
  }
  //async 保存数据
  async function savecustomeritem() {
    const $customerform = $('#customer_form');
    if ($customerform.form('enableValidation').form('validate')) {
      let customer = $customerform.serializeJSON();
      //获取明细表数据

      const customerattentionproduct_result = await customerattentionproduct_acceptChanges();
      if (!customerattentionproduct_result.success) {
        return false;
      } else {
        customer.CustomerAttentionProducts = customerattentionproduct_result.changed;
      }


      const customerbank_result = await customerbank_acceptChanges();
      if (!customerbank_result.success) {
        return false;
      } else {
        customer.CustomerBanks = customerbank_result.changed;
      }


      const customercontact_result = await customercontact_acceptChanges();
      if (!customercontact_result.success) {
        return false;
      } else {
        customer.CustomerContacts = customercontact_result.changed;
      }


      const customerfile_result = await customerfile_acceptChanges();
      if (!customerfile_result.success) {
        return false;
      } else {
        customer.CustomerFiles = customerfile_result.changed;
      }





      //const customersales_result = await customersales_acceptChanges();
      //if (!customersales_result.success) {
      //  return false;
      //} else {
      //  customer.CustomerSales = customersales_result.changed;
      //}


      const customershare_result = await customershare_acceptChanges();
      if (!customershare_result.success) {
        return false;
      } else {
        customer.CustomerShares = customershare_result.changed;
      }


      const customerwarehouse_result = await customerwarehouse_acceptChanges();
      if (!customerwarehouse_result.success) {
        return false;
      } else {
        customer.CustomerWarehouses = customerwarehouse_result.changed;
      }

      let url = '/Customers/Edit';
      //判断是新增或是修改方法
      if (MODELSTATE === 'Added') {
        url = '/Customers/Create';
      }
      var token = $('input[name="__RequestVerificationToken"]', $customerform).val();
      $.ajax({
        type: "POST",
        url: url,
        data: {
          __RequestVerificationToken: token,
          customer: customer
        },
        dataType: 'json',
        contentType: 'application/x-www-form-urlencoded; charset=utf-8'
      })
        .done(response => {
          if (response.success) {
            hook = false;
            $customerform.form('disableValidation');
            $('#customerdetailwindow').window("close");
            toastr.success("保存成功");
            reloadData();
          } else {
            $.messager.alert("错误", response.err, "error");
          }
        })
        .fail((jqXHR, textStatus, errorThrown) => {
          $.messager.alert('异常', `${jqXHR.status}: ${jqXHR.statusText} `, 'error');
        });
    }
  }
  //判断是否有没有保存的记录
  function customerhasmodified() {
    if (!hook) {
      if (!customerattentionproduct_endEditing()) {
        return true;
      }
      const customerattentionproducts = $customerattentionproductdg.datagrid("getChanges");
      if (MODELSTATE == 'Modified' && customerattentionproducts.length > 0) {
        return true;
      }
      if (!customerbank_endEditing()) {
        return true;
      }
      const customerbanks = $customerbankdg.datagrid("getChanges");
      if (MODELSTATE == 'Modified' && customerbanks.length > 0) {
        return true;
      }
      if (!customercontact_endEditing()) {
        return true;
      }
      const customercontacts = $customercontactdg.datagrid("getChanges");
      if (MODELSTATE == 'Modified' && customercontacts.length > 0) {
        return true;
      }
      if (!customerfile_endEditing()) {
        return true;
      }
      const customerfiles = $customerfiledg.datagrid("getChanges");
      if (MODELSTATE == 'Modified' && customerfiles.length > 0) {
        return true;
      }
      if (!customerfollow_endEditing()) {
        return true;
      }

      if (!customersales_endEditing()) {
        return true;
      }
      //const customersales = $customersalesdg.datagrid("getChanges");
      //if (MODELSTATE == 'Modified' && customersales.length > 0) {
      //  return true;
      //}
      if (!customershare_endEditing()) {
        return true;
      }
      const customershares = $customersharedg.datagrid("getChanges");
      if (MODELSTATE == 'Modified' && customershares.length > 0) {
        return true;
      }
      if (!customerwarehouse_endEditing()) {
        return true;
      }
      const customerwarehouses = $customerwarehousedg.datagrid("getChanges");
      if (MODELSTATE == 'Modified' && customerwarehouses.length > 0) {
        return true;
      }
      return false;
    } else {
      return hook;
    }

