<script type="text/javascript">
     var form_state = 'Added';
     var current_index = -1;
     var customercontact = {};
 
     function open_customercontactdlg(index, row, state) {
         form_state = state;
         current_index = index;
         customercontact = row;
         $('#customercontactdlg').dialog('open');
         if (form_state === 'Added') {
             $('#customercontactdlg').dialog('setTitle', '新增明细');
         } else {
             $('#customercontactdlg').dialog('setTitle', '修改明细');
         }
         $('#customercontact_form').form('reset');
         $('#customercontact_form').form('load', customercontact);
     }
     function confirm_customercontactform() {
         $customercontactform = $('#customercontact_form');
         if ($customercontactform.form('enableValidation').form('validate')) {
             customercontact = $customercontactform.serializeJSON();
             if (form_state === 'Added') {
                 $(document).trigger('customercontact_form.add', [current_index, customercontact])
             } else {
                 $(document).trigger('customercontact_form.edit', [current_index, customercontact])
             }
             $('#customercontactdlg').dialog('close');
         }
     }
 </script>

 