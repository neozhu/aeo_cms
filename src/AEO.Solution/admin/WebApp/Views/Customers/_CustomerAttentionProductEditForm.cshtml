@model WebApp.Models.CustomerAttentionProduct
<div id="customerattentionproductdlg" class="easyui-dialog"
     title="CustomerAttentionProduct" style="width:600px;height:300px; display:none"
     data-options="
                iconCls: 'fal fa-window',
                modal:true,
                closed:true,
                cache: false,
                resizable:true,
                width:620,
                height:300,
                onOpen:function(){
                   $('#customerattentionproduct_form').form('disableValidation');
                },
                buttons: [{
                    text:'确认',
                    handler:function(){
                        confirm_customerattentionproductform();
                    }
                },{
                    text:'取消',
                    handler:function(){
                        $('#customerattentionproductdlg').dialog('close');
                    }
                }]
            ">
<div class="panel-container show">
      <div class="panel-content p-0">
        <form id="customerattentionproduct_form" class="form-horizontal needs-validation" novalidate>
          <fieldset class="form-group">
            <div class="row h-100 align-items-center m-0 pt-1">
    <!--Id-->
	@Html.HiddenFor(model => model.Id)		
             
    <!--客户编号(保存时系统自动分配也可以手工选择)-->
        <label class="col-md-2 form-label text-right p-0" for="@Html.IdFor(model => model.CustomerCode)" >@Html.DisplayNameFor(model => model.CustomerCode) </label>
<div class="col-md-4 mb-1">
		<input id="@Html.IdFor(model => model.CustomerCode)" 
							name="@Html.NameFor(model => model.CustomerCode)" 
							value="@Html.ValueFor(model => model.CustomerCode)"
							tabindex="1" 
			     			class="easyui-textbox" 
							type="text" 
                            style="width:100%"
							data-options="prompt:'@Html.DisplayNameFor(model => model.CustomerCode)',
     						 required:false ,validType:'length[0,20]'" />
    </div>
             
    <!--客户名称-->
        <label class="col-md-2 form-label text-right p-0" for="@Html.IdFor(model => model.CustomerName)" >@Html.DisplayNameFor(model => model.CustomerName) <span class="text-danger">*</span></label>
<div class="col-md-4 mb-1">
		<input id="@Html.IdFor(model => model.CustomerName)" 
							name="@Html.NameFor(model => model.CustomerName)" 
							value="@Html.ValueFor(model => model.CustomerName)"
							tabindex="2" 
			     			class="easyui-textbox" 
							type="text" 
                            style="width:100%"
							data-options="prompt:'@Html.DisplayNameFor(model => model.CustomerName)',
     						 required:true ,validType:'length[0,80]'" />
    </div>
             
    <!--产品编号(自动生成,可手工修改)-->
        <label class="col-md-2 form-label text-right p-0" for="@Html.IdFor(model => model.ProductNo)" >@Html.DisplayNameFor(model => model.ProductNo) </label>
<div class="col-md-4 mb-1">
		<input id="@Html.IdFor(model => model.ProductNo)" 
							name="@Html.NameFor(model => model.ProductNo)" 
							value="@Html.ValueFor(model => model.ProductNo)"
							tabindex="3" 
			     			class="easyui-textbox" 
							type="text" 
                            style="width:100%"
							data-options="prompt:'@Html.DisplayNameFor(model => model.ProductNo)',
     						 required:false ,validType:'length[0,50]'" />
    </div>
             
    <!--中文品名-->
        <label class="col-md-2 form-label text-right p-0" for="@Html.IdFor(model => model.ProductName)" >@Html.DisplayNameFor(model => model.ProductName) </label>
<div class="col-md-4 mb-1">
		<input id="@Html.IdFor(model => model.ProductName)" 
							name="@Html.NameFor(model => model.ProductName)" 
							value="@Html.ValueFor(model => model.ProductName)"
							tabindex="4" 
			     			class="easyui-textbox" 
							type="text" 
                            style="width:100%"
							data-options="prompt:'@Html.DisplayNameFor(model => model.ProductName)',
     						 required:false ,validType:'length[0,200]'" />
    </div>
             
    <!--币种-->
        <label class="col-md-2 form-label text-right p-0" for="@Html.IdFor(model => model.CUR)" >@Html.DisplayNameFor(model => model.CUR) </label>
<div class="col-md-4 mb-1">
		<input id="@Html.IdFor(model => model.CUR)" 
							name="@Html.NameFor(model => model.CUR)" 
							value="@Html.ValueFor(model => model.CUR)"
							tabindex="5" 
			     			class="easyui-textbox" 
							type="text" 
                            style="width:100%"
							data-options="prompt:'@Html.DisplayNameFor(model => model.CUR)',
     						 required:false ,validType:'length[0,10]'" />
    </div>
             
    <!--单价-->
         <label class="col-md-2 form-label text-right p-0" for="@Html.IdFor(model => model.Pric)" >@Html.DisplayNameFor(model => model.Pric) <span class="text-danger">*</span></label>
<div class="col-md-4 mb-1">
         <input id="@Html.IdFor(model => model.Pric)"
							name="@Html.NameFor(model => model.Pric)" 
							value="@Html.ValueFor(model => model.Pric)"
							tabindex="6" 
							class="easyui-numberbox" 
							type="text" 
                            style="width:100%"
							data-options="prompt:'@Html.DisplayNameFor(model => model.Pric)',
                                 precision:2,
								 required:true,
                                 formatter:intformatter,
                                 parser:parsernumber
                                 " />
    </div>
             
    <!--报价次数-->
        <label class="col-md-2 form-label text-right p-0" for="@Html.IdFor(model => model.SummaryQuote)" >@Html.DisplayNameFor(model => model.SummaryQuote) <span class="text-danger">*</span></label>
<div class="col-md-4 mb-1">
		<input id="@Html.IdFor(model => model.SummaryQuote)"
							name="@Html.NameFor(model => model.SummaryQuote)" 
							value="@Html.ValueFor(model => model.SummaryQuote)"
							tabindex="7" 
							class="easyui-numberbox" 
							type="text" 
                            style="width:100%"
							data-options="prompt:'@Html.DisplayNameFor(model => model.SummaryQuote)',
								 required:true,
                                 formatter:intformatter,
                                 parser:parsernumber
                                 " />
    </div>
             
    <!--订单次数-->
        <label class="col-md-2 form-label text-right p-0" for="@Html.IdFor(model => model.SummaryOrders)" >@Html.DisplayNameFor(model => model.SummaryOrders) <span class="text-danger">*</span></label>
<div class="col-md-4 mb-1">
		<input id="@Html.IdFor(model => model.SummaryOrders)"
							name="@Html.NameFor(model => model.SummaryOrders)" 
							value="@Html.ValueFor(model => model.SummaryOrders)"
							tabindex="8" 
							class="easyui-numberbox" 
							type="text" 
                            style="width:100%"
							data-options="prompt:'@Html.DisplayNameFor(model => model.SummaryOrders)',
								 required:true,
                                 formatter:intformatter,
                                 parser:parsernumber
                                 " />
    </div>
             
      <!--所属客户-->
      <input type="hidden" id="CustomerCustomerCode" name="CustomerCustomerCode" value="">
	  <input id="@Html.IdFor(model => model.CustomerId)"
			       name="@Html.NameFor(model => model.CustomerId)"
				   value="@Html.ValueFor(model => model.CustomerId)"
                   type="hidden" />
             
  
           </div>
       </fieldset>
    </form>
  </div>
</div>
</div>
<script type="text/javascript">
     var form_state = 'Added';
     var current_index = -1;
     var customerattentionproduct = {};
 
     function open_customerattentionproductdlg(index, row, state) {
         form_state = state;
         current_index = index;
         customerattentionproduct = row;
         $('#customerattentionproductdlg').dialog('open');
         if (form_state === 'Added') {
             $('#customerattentionproductdlg').dialog('setTitle', '新增明细');
         } else {
             $('#customerattentionproductdlg').dialog('setTitle', '修改明细');
         }
         $('#customerattentionproduct_form').form('reset');
         $('#customerattentionproduct_form').form('load', customerattentionproduct);
     }
     function confirm_customerattentionproductform() {
         $customerattentionproductform = $('#customerattentionproduct_form');
         if ($customerattentionproductform.form('enableValidation').form('validate')) {
             customerattentionproduct = $customerattentionproductform.serializeJSON();
             if (form_state === 'Added') {
                 $(document).trigger('customerattentionproduct_form.add', [current_index, customerattentionproduct])
             } else {
                 $(document).trigger('customerattentionproduct_form.edit', [current_index, customerattentionproduct])
             }
             $('#customerattentionproductdlg').dialog('close');
         }
     }
 </script>

 