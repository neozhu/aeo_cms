@model WebApp.Models.CustomerContact
<script type="text/javascript">
    //是否开启行内编辑
    var SUBEDITINLINE = false;
   //初始化 CustomerContact datagrid
   var $customercontactdg = $('#customercontact_datagrid');
   //当前行记录
   var customercontact = {};
   //datagrid CRUD method
    var customercontact_editIndex = undefined;
    //取消
    function customercontact_reject() {
		$customercontactdg.datagrid('rejectChanges');
		customercontact_editIndex = undefined;
    }
    //重新加载数据
    function customercontact_reload() {
			if (customercontact_endEditing()) {
				$customercontactdg.datagrid('reload');
			}
	}
    //关闭编辑状态
	function customercontact_endEditing() {
			if (customercontact_editIndex === undefined) {
                return true; 
            }
			if ($customercontactdg.datagrid('validateRow', customercontact_editIndex)) {
				$customercontactdg.datagrid('endEdit', customercontact_editIndex);
				customercontact_editIndex = undefined;
                return true;
			} else {
				const invalidinput = $('input.validatebox-invalid',$customercontactdg.datagrid('getPanel'));
                const fieldnames = invalidinput.map((index, item) => {
                  return $(item).attr('placeholder') || $(item).attr('id');
                });
                $.messager.alert('提示', `${Array.from(fieldnames)} 输入有误.`, 'error');
				return false;
			}
		}
    //单击列开启编辑功能
	function customercontact_onClickCell(index, field) {
			const _operates = ['_operate1', 'ck'];
             $('button[name*=\'customercontactdeletebutton\']').prop('disabled', false);
			if (!SUBEDITINLINE || $.inArray(field, _operates) >= 0) {
				return false;
			}
			if (customercontact_editIndex !== index) {
				if (customercontact_endEditing()) {
					$customercontactdg.datagrid('selectRow', index)
							.datagrid('beginEdit', index);
                    //customercontact_editIndex = index;
					var ed = $customercontactdg.datagrid('getEditor', { index: index, field: field });
					if (ed) {
						($(ed.target).data('textbox') ? $(ed.target).textbox('textbox') : $(ed.target)).focus();
					}
				} else {
					$customercontactdg.datagrid('selectRow', customercontact_editIndex);
				}
			}
		}
    //双击弹出编辑当前行对话框
    function customercontact_onDblClickRow(index, row) {
        if (!SUBEDITINLINE) {
            open_customercontactdlg(index, row, 'Modified');
        }
    }
    //订阅对话框新增返回事件
    $(document).on('customercontact_form.add', (e, index,item) => {
        $customercontactdg.datagrid("insertRow",
            {
                index: 0,
                row: item
            });
    });
    //订阅对话框修改返回事件
    $(document).on('customercontact_form.edit', (e,index, item) => {
        $customercontactdg.datagrid('updateRow', {
            index: index,
            row: item
        });
    });
    //新增记录
    function customercontact_append() {
       const $customerform = $('#customer_form');
       if ($customerform.form('enableValidation').form('validate')) {
          const customer = $customerform.serializeJSON();
       const item = {
          Status: '启用', 
Sex: '男', 
CustomerCode: 'customer.CustomerCode', 
CustomerName: 'customer.CustomerName', 
CustomerId: customer.Id, 

          CustomerId:customer.Id
        };
      if (!SUBEDITINLINE) {
        open_customercontactdlg(0, item, 'Added');
      } else {
			if (customercontact_endEditing()) {
				//对必填字段进行默认值初始化
				$customercontactdg.datagrid('insertRow', 
                               { index: 0,
                                  row: item 
                               });
				customercontact_editIndex = 0;
				$customercontactdg.datagrid('selectRow', customercontact_editIndex)
						.datagrid('beginEdit', customercontact_editIndex);
			}
        }
        }
	 }
    //删除编辑的行
	function customercontact_removeit() {
		if (customercontact_editIndex !== undefined) {  
            const delindex = orderdetail_editIndex;
			$customercontactdg.datagrid('cancelEdit', delindex)
					           .datagrid('deleteRow', delindex);

        } else {
           const row = $customercontactdg.datagrid('getSelected');
           if(row){
             const rowindex = $customercontactdg.datagrid('getRowIndex', row);
             $customercontactdg.datagrid('deleteRow', rowindex);
           }else{
             $.messager.alert('提示', '没有选中删除的记录.', 'info');
           }
        }
	}
    //删除选中的行
    function customercontact_deletechecked() {
            const rows = $customercontactdg.datagrid('getChecked');
            if (rows.length > 0) {
                var id = rows.filter(item=>item.Id!=null).map(item => {
                    return item.Id;
                });
                $.messager.confirm('确认', `你确定要删除这 <span class='badge bg-color-red'>${id.length}</span> 行记录?`,result => {
                    if (result) {
                        $.post('/CustomerContacts/DeleteChecked', { id: id })
                         .done(response => {
                            if (response.success) {
                                $customercontactdg.datagrid('reload');
                            } else {
                                $.messager.alert('错误', response.err,'error');
                            }
                         });
                    }
                });  
            } else {
                $.messager.alert('提示', '请先选择要删除的记录!','question');
            }
      }
  //获取修改的行
  function customercontact_getchanges() {
    if (customercontact_endEditing()) {
      if ($customercontactdg.datagrid('getChanges').length > 0) {
        const inserted = $customercontactdg.datagrid('getChanges', 'inserted').map(item => {
          item.TrackingState = 1;
          return item;
        });
        const deleted = $customercontactdg.datagrid('getChanges', 'deleted').map(item => {
          item.TrackingState = 3;
          return item;
        });
        const updated = $customercontactdg.datagrid('getChanges', 'updated').map(item => {
          item.TrackingState = 2;
          return item;
        });
        //过滤已删除的重复项
        const changed = inserted.concat(updated.filter(item => {
          return !deleted.includes(item);
        })).concat(deleted);
        return { success: true, changed };
      } else {
        return { success: true, changed:undefined};
      }
    } else {
      return { success: false,changed:undefined };
    }
  }
  //提交修改的数据
  function customercontact_acceptchanges() {
    $customercontactdg.datagrid('acceptChanges');
  }
    //提交保存后台数据库
  async function customercontact_accept() {
			if (customercontact_endEditing()) {
				if ($customercontactdg.datagrid('getChanges').length > 0) {
					const inserted = $customercontactdg.datagrid('getChanges', 'inserted').map(item => {
                       item.TrackingState = 1;
                       return item;
                    });
					const deleted = $customercontactdg.datagrid('getChanges', 'deleted').map(item => {
                       item.TrackingState = 3;
                       return item;
                    });
					const updated = $customercontactdg.datagrid('getChanges', 'updated').map(item => {
                       item.TrackingState = 2;
                       return item;
                    });
					//过滤已删除的重复项
                    const changed = inserted.concat(updated.filter(item => {
                           return !deleted.includes(item);
                         })).concat(deleted);
                   //console.table(changed);
				  if (MODELSTATE === 'Added') {
                    return { success:true, changed };
                  } else {
                    const response = await $.post('/CustomerContacts/SaveData', {customercontacts:changed});
                    response.changed = undefined;
    				if (response.success) {
							toastr.success('保存明细成功'); 
							$customercontactdg.datagrid('acceptChanges');
							$customercontactdg.datagrid('reload');
                            return { success:true}; 
				    } else {
                           $.messager.alert('错误', response.err ,'error');
                           return { success:false, err:response.err };
                    }
                   }
				} else {
                  return { success: true, changed: undefined};
                }
			} else {
               return { success: false };
            }
      }


