@model WebApp.Models.CustomerBank
<script type="text/javascript">
  //全屏事件
  document.addEventListener('panel.onfullscreen', () => {
       $customerbankdg.datagrid('resize');
   });
    //是否开启行内编辑
    var SUBEDITINLINE = true;
   //初始化 CustomerBank datagrid
   var $customerbankdg = $('#customerbank_datagrid');
   //当前行记录
   var customerbank = {};
   //datagrid CRUD method
    var customerbank_editIndex = undefined;
    //取消编辑恢复状态
    function customerbank_rejectChanges() {
		$customerbankdg.datagrid('rejectChanges');
		customerbank_editIndex = undefined;
    }
    //重新加载数据
    function customerbank_reloadData() {
			$customerbankdg.datagrid('unselectAll');
            $customerbankdg.datagrid('uncheckAll');
	        $customerbankdg.datagrid('reload');
	}
    //关闭编辑状态
	function customerbank_endEditing() {
			if (customerbank_editIndex === undefined) {
                return true; 
            }
			if ($customerbankdg.datagrid('validateRow', customerbank_editIndex)) {
				$customerbankdg.datagrid('endEdit', customerbank_editIndex);
				customerbank_editIndex = undefined;
                return true;
			} else {
				const invalidinput = $('input.validatebox-invalid',$customerbankdg.datagrid('getPanel'));
                const fieldnames = invalidinput.map((index, item) => {
                  return $(item).attr('placeholder') || $(item).attr('id');
                });
                $.messager.alert('提示', `${Array.from(fieldnames)} 输入有误.`, 'error');
				return false;
			}
		}
    //单击列开启编辑功能
	function customerbank_onClickCell(index, field) {
			const _operates = ['_operate1', 'ck'];
             $('button[name*=\'customerbankdeleterowbutton\']').prop('disabled', false);
			if (!SUBEDITINLINE || $.inArray(field, _operates) >= 0) {
				return false;
			}
			if (customerbank_editIndex !== index) {
				if (customerbank_endEditing()) {
					$customerbankdg.datagrid('selectRow', index)
							.datagrid('beginEdit', index);
                    //customerbank_editIndex = index;
					var ed = $customerbankdg.datagrid('getEditor', { index: index, field: field });
					if (ed) {
						($(ed.target).data('textbox') ? $(ed.target).textbox('textbox') : $(ed.target)).focus();
					}
				} else {
					$customerbankdg.datagrid('selectRow', customerbank_editIndex);
				}
			}
		}
    //双击弹出编辑当前行对话框
    function customerbank_onDblClickRow(index, row) {
        if (!SUBEDITINLINE) {
            open_customerbankdlg(index, row, 'Modified');
        }
    }
    //订阅对话框新增返回事件
    $(document).on('customerbank_form.add', (e, index,item) => {
        $customerbankdg.datagrid("insertRow",
            {
                index: 0,
                row: item
            });
    });
    //订阅对话框修改返回事件
    $(document).on('customerbank_form.edit', (e,index, item) => {
        $customerbankdg.datagrid('updateRow', {
            index: index,
            row: item
        });
    });
    //新增记录
    function customerbank_appendItem() {
       const $customerform = $('#customer_form');
       if ($customerform.form('enableValidation').form('validate')) {
          const customer = $customerform.serializeJSON();
       const item = {
          CustomerId: customer.Id, 
CustomerCode: 'customer.CustomerCode', 
CustomerName: 'customer.CustomerName', 

          CustomerId:customer.Id
        };
      if (!SUBEDITINLINE) {
        open_customerbankdlg(0, item, 'Added');
      } else {
			if (customerbank_endEditing()) {
				//对必填字段进行默认值初始化
				$customerbankdg.datagrid('insertRow', 
                               { index: 0,
                                  row: item 
                               });
				customerbank_editIndex = 0;
				$customerbankdg.datagrid('selectRow', customerbank_editIndex)
						.datagrid('beginEdit', customerbank_editIndex);
			}
        }
        }
	 }
    //删除编辑的行
	function customerbank_removeItem() {
		if (customerbank_editIndex !== undefined) {  
            const delindex = orderdetail_editIndex;
			$customerbankdg.datagrid('cancelEdit', delindex)
					           .datagrid('deleteRow', delindex);
            $("button[name*='customerbank_cancelchangesbutton']").prop('disabled', false);
            $("button[name*='customerbank_savechangesbutton']").prop('disabled', false);
        } else {
           const rows = $customerbankdg.datagrid('getChecked');
           rows.slice().reverse().forEach(row => {
                const rowindex = $customerbankdg.datagrid('getRowIndex', row);
                $customerbankdg.datagrid('deleteRow', rowindex);
                $("button[name*='customerbank_cancelchangesbutton']").prop('disabled', false);
                $("button[name*='customerbank_savechangesbutton']").prop('disabled', false);
            });
        }
	}
    //删除选中的行
    function customerbank_deleteChecked() {
            const rows = $customerbankdg.datagrid('getChecked');
            if (rows.length > 0) {
                var id = rows.filter(item=>item.Id!=null).map(item => {
                    return item.Id;
                });
                $.messager.confirm('确认', `你确定要删除这 <span class='badge bg-color-red'>${id.length}</span> 行记录?`,result => {
                    if (result) {
                        $.post('/CustomerBanks/DeleteChecked', { id: id })
                         .done(response => {
                            if (response.success) {
                                $customerbankdg.datagrid('reload');
                            } else {
                                $.messager.alert('错误', response.err,'error');
                            }
                         });
                    }
                });  
            } else {
                $.messager.alert('提示', '请先选择要删除的记录!','question');
            }
      }
  //获取修改的行
  function customerbank_getChanges() {
    if (customerbank_endEditing()) {
      if ($customerbankdg.datagrid('getChanges').length > 0) {
        const inserted = $customerbankdg.datagrid('getChanges', 'inserted').map(item => {
          item.TrackingState = 1;
          return item;
        });
        const deleted = $customerbankdg.datagrid('getChanges', 'deleted').map(item => {
          item.TrackingState = 3;
          return item;
        });
        const updated = $customerbankdg.datagrid('getChanges', 'updated').map(item => {
          item.TrackingState = 2;
          return item;
        });
        //过滤已删除的重复项
        const changed = inserted.concat(updated.filter(item => {
          return !deleted.includes(item);
        })).concat(deleted);
        return { success: true, changed };
      } else {
        return { success: true, changed:undefined};
      }
    } else {
      return { success: false,changed:undefined };
    }
  }
  //提交修改的数据
  //function customerbank_acceptChanges() {
  //  $customerbankdg.datagrid('acceptChanges');
  //}
  //提交保存后台数据库
  async function customerbank_acceptChanges() {
			if (customerbank_endEditing()) {
				if ($customerbankdg.datagrid('getChanges').length > 0) {
					const inserted = $customerbankdg.datagrid('getChanges', 'inserted').map(item => {
                       item.TrackingState = 1;
                       return item;
                    });
					const deleted = $customerbankdg.datagrid('getChanges', 'deleted').map(item => {
                       item.TrackingState = 3;
                       return item;
                    });
					const updated = $customerbankdg.datagrid('getChanges', 'updated').map(item => {
                       item.TrackingState = 2;
                       return item;
                    });
					//过滤已删除的重复项
                    const changed = inserted.concat(updated.filter(item => {
                           return !deleted.includes(item);
                         })).concat(deleted);
                   //console.table(changed);
				  if (MODELSTATE === 'Added') {
                    return { success:true, changed };
                  } else {
                    const response = await $.post('/CustomerBanks/SaveData', {customerbanks:changed});
                    response.changed = undefined;
    				if (response.success) {
							toastr.success('保存明细成功'); 
							$customerbankdg.datagrid('acceptChanges');
							customerbank_reloadData()
                            return { success:true}; 
				    } else {
                           $.messager.alert('错误', response.err ,'error');
                           return { success:false, err:response.err };
                    }
                   }
				} else {
                  return { success: true, changed: undefined};
                }
			} else {
               return { success: false };
            }
      }


$(() => {
    $customerbankdg.datagrid({
            fit: false,
            height: 300,
            rownumbers: true,
            striped: true,
            idField: 'Id',
            sortName: 'Id',
            sortOrder: 'asc',
            remoteFilter: true,
            singleSelect: true,
            checkOnSelect: false,
		    selectOnCheck: false,
            method: 'get',
            pageList: [10, 20, 50, 100,1000],
            pagination: true,
            clientPaging:false,
            pagination: true,
            onDblClickRow: customerbank_onDblClickRow,
            onClickCell: customerbank_onClickCell,
            onBeforeLoad: function () {

            },
            onLoadSuccess: function (data) {
              customerbank_editIndex = undefined;
              $("button[name*='customerbank_deleterowbutton']").prop('disabled', true);
              $("button[name*='customerbank_cancelchangesbutton']").prop('disabled', true);
              $("button[name*='customerbank_savechangesbutton']").prop('disabled', true);
            },
            onCheck: function () {
                $("button[name*='customerbank_deleterowbutton']").prop('disabled', false);
            },
            onUncheck: function () {
               const checked = $(this).datagrid('getChecked').length > 0;
               $("button[name*='customerbank_deleterowbutton']").prop('disabled', !checked);
            },
           onCheckAll: function (rows) {
              if (rows.length > 0) {
                 $("button[name*='customerbank_deleterowbutton']").prop('disabled', false);
              }
           },
           onUncheckAll: function () {
              $("button[name*='customerbank_deleterowbutton']").prop('disabled', true);           
           },
            onSelect: function(index,row) {
              customerbank = row;
            },
            onBeforeEdit: function (index, row) {
                 customerbank_editIndex = index;
                 row.editing = true;
                 $("button[name*='customerbank_deleterowbutton']").prop('disabled', false);
                 $("button[name*='customerbank_cancelchangesbutton']").prop('disabled', false);
                 $("button[name*='customerbank_savechangesbutton']").prop('disabled', false);
                 $(this).datagrid('refreshRow', index);
             },
            onBeginEdit: function (index, row) {
               //const editors = $(this).datagrid('getEditors', index);
  
            },
            onEndEdit: function (index, row) {

             },
             onAfterEdit: function (index, row) {
                   row.editing = false;
                   customerbank_editIndex = undefined;
                   $(this).datagrid('refreshRow', index);
             },
             onCancelEdit: function (index, row) {
                customerbank_editIndex = undefined;
                row.editing = false;
                $("button[name*='customerbank_deleterowbutton']").prop('disabled', true);
              $("button[name*='customerbank_cancelchangesbutton']").prop('disabled', true);
              $("button[name*='customerbank_savechangesbutton']").prop('disabled', true);
                $(this).datagrid('refreshRow', index);
            },
            columns: [[
            { field: 'ck', checkbox: true },
		     
			{    /*开户名称*/
                 field:'AccountName', 
                 title:'<span class="text-danger">*</span>  @Html.DisplayNameFor(model => model.AccountName)', 
                 width:160,
                 editor:{
                          type:'textbox',
                          options:{ 
                                 id:'editor_AccountName',
                                 prompt:'@Html.DescriptionFor(model => model.AccountName)',
                                 required:true, 
                                 validType: 'length[0,100]' 
                                 }  
                       },
                 sortable:true,
                 hidden:false,
                 resizable:true 
			},
			{    /*银行名称*/
                 field:'Bank', 
                 title:'  @Html.DisplayNameFor(model => model.Bank)', 
                 width:160,
                 editor:{
                          type:'textbox',
                          options:{ 
                                 id:'editor_Bank',
                                 prompt:'@Html.DescriptionFor(model => model.Bank)',
                                 required:false, 
                                 validType: 'length[0,100]' 
                                 }  
                       },
                 sortable:true,
                 hidden:false,
                 resizable:true 
			},
			{    /*银行账号*/
                 field:'AccountNo', 
                 title:'<span class="text-danger">*</span>  @Html.DisplayNameFor(model => model.AccountNo)', 
                 width:160,
                 editor:{
                          type:'textbox',
                          options:{ 
                                 id:'editor_AccountNo',
                                 prompt:'@Html.DescriptionFor(model => model.AccountNo)',
                                 required:true, 
                                 validType: 'length[0,100]' 
                                 }  
                       },
                 sortable:true,
                 hidden:false,
                 resizable:true 
			},
			{    /*账户用途*/
                 field:'BankUse', 
                 title:'  @Html.DisplayNameFor(model => model.BankUse)', 
                 width:160,
                 editor:{
                          type:'textbox',
                          options:{ 
                                 id:'editor_BankUse',
                                 prompt:'@Html.DescriptionFor(model => model.BankUse)',
                                 required:false, 
                                 validType: 'length[0,100]' 
                                 }  
                       },
                 sortable:true,
                 hidden:false,
                 resizable:true 
			},
			{    /*SWIFT号*/
                 field:'SWIFT', 
                 title:'  @Html.DisplayNameFor(model => model.SWIFT)', 
                 width:160,
                 editor:{
                          type:'textbox',
                          options:{ 
                                 id:'editor_SWIFT',
                                 prompt:'@Html.DescriptionFor(model => model.SWIFT)',
                                 required:false, 
                                 validType: 'length[0,50]' 
                                 }  
                       },
                 sortable:true,
                 hidden:false,
                 resizable:true 
			},
			{    /*币值*/
                 field:'CUR', 
                 title:'  @Html.DisplayNameFor(model => model.CUR)', 
                 width:120,
                 editor:{
                          type:'textbox',
                          options:{ 
                                 id:'editor_CUR',
                                 prompt:'@Html.DescriptionFor(model => model.CUR)',
                                 required:false, 
                                 validType: 'length[0,10]' 
                                 }  
                       },
                 sortable:true,
                 hidden:false,
                 resizable:true 
			},
			{    /*备注说明*/
                 field:'Remark', 
                 title:'  @Html.DisplayNameFor(model => model.Remark)', 
                 width:200,
                 editor:{
                          type:'textbox',
                          options:{ 
                                 id:'editor_Remark',
                                 prompt:'@Html.DescriptionFor(model => model.Remark)',
                                 required:false, 
                                 validType: 'length[0,50]' 
                                 }  
                       },
                 sortable:true,
                 hidden:false,
                 resizable:true 
			},
			{    /*客户编号(保存时系统自动分配也可以手工选择)*/
                 field:'CustomerCode', 
                 title:'  @Html.DisplayNameFor(model => model.CustomerCode)', 
                 width:120,
                 editor:{
                          type:'textbox',
                          options:{ 
                                 id:'editor_CustomerCode',
                                 prompt:'@Html.DescriptionFor(model => model.CustomerCode)',
                                 required:false, 
                                 validType: 'length[0,20]' 
                                 }  
                       },
                 sortable:true,
                 hidden:false,
                 resizable:true 
			},
			{    /*单位名称*/
                 field:'CustomerName', 
                 title:'<span class="text-danger">*</span>  @Html.DisplayNameFor(model => model.CustomerName)', 
                 width:160,
                 editor:{
                          type:'textbox',
                          options:{ 
                                 id:'editor_CustomerName',
