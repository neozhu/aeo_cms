            onClickCell: customercommunication_onClickCell,
            onSelect: function(index,row) {
              customercommunication = row;
            },
            onLoadSuccess: function (data) {
              customercommunication_editIndex = undefined;
            },
            onBeginEdit: function (index, row) {
               //const editors = $(this).datagrid('getEditors', index);
  
            },
            onEndEdit: function (index, row) {

             },
             onBeforeEdit: function (index, row) {
                 customercommunication_editIndex = index;
                 row.editing = true;
                 $(this).datagrid('refreshRow', index);
             },
             onAfterEdit: function (index, row) {
                   row.editing = false;
                   customercommunication_editIndex = undefined;
                   $(this).datagrid('refreshRow', index);
             },
             onCancelEdit: function (index, row) {
                customercommunication_editIndex = undefined;
                row.editing = false;
                $(this).datagrid('refreshRow', index);
            },
            pagination: true,
            striped: true,
            columns: [[
		     
			{    /*会议主题*/
                 field:'Title', 
                 title:'<span class="text-danger">*</span>  @Html.DisplayNameFor(model => model.Title)', 
                 width:200,
