                      },
                sortable:true, 
                resizable:true, 
                formatter:dateformatter 
			} ,
			{    /*备注*/
                 field:'Remark', 
                 title:'  @Html.DisplayNameFor(model => model.Remark)', 
                 width:120,
                 editor:{
                          type:'textbox',
                          options:{ 
                                 id:'editor_Remark',
                                 prompt:'@Html.DescriptionFor(model => model.Remark)',
                                 required:false, 
                                 validType: 'length[0,20]' 
                                 }  
                       },
                 sortable:true,
                 hidden:false,
                 resizable:true 
			},
			{    /*客户编号*/
                 field:'CustomerCode', 
                 title:'<span class="text-danger">*</span>  @Html.DisplayNameFor(model => model.CustomerCode)', 
                 width:120,
                 editor:{
                          type:'textbox',
                          options:{ 
                                 id:'editor_CustomerCode',
                                 prompt:'@Html.DescriptionFor(model => model.CustomerCode)',
                                 required:true, 
                                 validType: 'length[0,20]' 
                                 }  
                       },
                 sortable:true,
                 hidden:false,
                 resizable:true 
			},
			{    /*客户名称*/
                 field:'CustomerName', 
                 title:'<span class="text-danger">*</span>  @Html.DisplayNameFor(model => model.CustomerName)', 
                 width:160,
                 editor:{
