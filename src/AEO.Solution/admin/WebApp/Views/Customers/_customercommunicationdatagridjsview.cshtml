                formatter:dateformatter 
			} ,
            {   /*结束日期*/
                field:'EndDate', 
                title:'  @Html.DisplayNameFor(model => model.EndDate)', 
                width:100, 
                align:'right', 
                hidden:false,
                editor:{
                      type:'datebox',
                      options:{
                           id:'editor_EndDate',
                           prompt:'@Html.DescriptionFor(model => model.EndDate)',
