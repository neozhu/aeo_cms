@model WebApp.Models.CustomerCommunication
<script type="text/javascript">
    //是否开启行内编辑
    var SUBEDITINLINE = false;
   //初始化 CustomerCommunication datagrid
   var $customercommunicationdg = $('#customercommunication_datagrid');
   //当前行记录
   var customercommunication = {};
   //datagrid CRUD method
    var customercommunication_editIndex = undefined;
    //取消
    function customercommunication_reject() {
		$customercommunicationdg.datagrid('rejectChanges');
		customercommunication_editIndex = undefined;
    }
    //重新加载数据
    function customercommunication_reload() {
			if (customercommunication_endEditing()) {
				$customercommunicationdg.datagrid('reload');
			}
	}
    //关闭编辑状态
	function customercommunication_endEditing() {
			if (customercommunication_editIndex === undefined) {
                return true; 
            }
			if ($customercommunicationdg.datagrid('validateRow', customercommunication_editIndex)) {
				$customercommunicationdg.datagrid('endEdit', customercommunication_editIndex);
				customercommunication_editIndex = undefined;
                return true;
			} else {
				const invalidinput = $('input.validatebox-invalid',$customercommunicationdg.datagrid('getPanel'));
                const fieldnames = invalidinput.map((index, item) => {
                  return $(item).attr('placeholder') || $(item).attr('id');
                });
                $.messager.alert('提示', `${Array.from(fieldnames)} 输入有误.`, 'error');
				return false;
			}
		}
    //单击列开启编辑功能
	function customercommunication_onClickCell(index, field) {
			const _operates = ['_operate1', 'ck'];
             $('button[name*=\'customercommunicationdeletebutton\']').prop('disabled', false);
			if (!SUBEDITINLINE || $.inArray(field, _operates) >= 0) {
				return false;
			}
			if (customercommunication_editIndex !== index) {
				if (customercommunication_endEditing()) {
					$customercommunicationdg.datagrid('selectRow', index)
							.datagrid('beginEdit', index);
                    //customercommunication_editIndex = index;
					var ed = $customercommunicationdg.datagrid('getEditor', { index: index, field: field });
					if (ed) {
						($(ed.target).data('textbox') ? $(ed.target).textbox('textbox') : $(ed.target)).focus();
					}
				} else {
					$customercommunicationdg.datagrid('selectRow', customercommunication_editIndex);
				}
			}
		}
    //双击弹出编辑当前行对话框
    function customercommunication_onDblClickRow(index, row) {
        if (!SUBEDITINLINE) {
            open_customercommunicationdlg(index, row, 'Modified');
        }
    }
    //订阅对话框新增返回事件
    $(document).on('customercommunication_form.add', (e, index,item) => {
        $customercommunicationdg.datagrid("insertRow",
            {
                index: 0,
                row: item
            });
    });
    //订阅对话框修改返回事件
    $(document).on('customercommunication_form.edit', (e,index, item) => {
        $customercommunicationdg.datagrid('updateRow', {
            index: index,
            row: item
        });
    });
    //新增记录
    function customercommunication_append() {
       const $customerform = $('#customer_form');
       if ($customerform.form('enableValidation').form('validate')) {
          const customer = $customerform.serializeJSON();
       const item = {
          CommType: '', 
Status: '', 
Salesman: $.getusername(), 
BeginDate: null, 
EndDate: null, 
CustomerCode: 'customer.CustomerCode', 
CustomerName: 'customer.CustomerName', 
CustomerId: customer.Id, 

          CustomerId:customer.Id
        };
      if (!SUBEDITINLINE) {
        open_customercommunicationdlg(0, item, 'Added');
      } else {
			if (customercommunication_endEditing()) {
				//对必填字段进行默认值初始化
				$customercommunicationdg.datagrid('insertRow', 
                               { index: 0,
                                  row: item 
                               });
				customercommunication_editIndex = 0;
				$customercommunicationdg.datagrid('selectRow', customercommunication_editIndex)
						.datagrid('beginEdit', customercommunication_editIndex);
			}
        }
        }
	 }
    //删除编辑的行
	function customercommunication_removeit() {
		if (customercommunication_editIndex !== undefined) {  
            const delindex = orderdetail_editIndex;
			$customercommunicationdg.datagrid('cancelEdit', delindex)
					           .datagrid('deleteRow', delindex);

        } else {
           const row = $customercommunicationdg.datagrid('getSelected');
           if(row){
             const rowindex = $customercommunicationdg.datagrid('getRowIndex', row);
             $customercommunicationdg.datagrid('deleteRow', rowindex);
           }else{
             $.messager.alert('提示', '没有选中删除的记录.', 'info');
           }
        }
	}
    //删除选中的行
    function customercommunication_deletechecked() {
            const rows = $customercommunicationdg.datagrid('getChecked');
            if (rows.length > 0) {
                var id = rows.filter(item=>item.Id!=null).map(item => {
                    return item.Id;
                });
                $.messager.confirm('确认', `你确定要删除这 <span class='badge bg-color-red'>${id.length}</span> 行记录?`,result => {
                    if (result) {
                        $.post('/CustomerCommunications/DeleteChecked', { id: id })
                         .done(response => {
                            if (response.success) {
                                $customercommunicationdg.datagrid('reload');
                            } else {
                                $.messager.alert('错误', response.err,'error');
                            }
                         });
                    }
                });  
            } else {
                $.messager.alert('提示', '请先选择要删除的记录!','question');
            }
      }
  //获取修改的行
  function customercommunication_getchanges() {
    if (customercommunication_endEditing()) {
      if ($customercommunicationdg.datagrid('getChanges').length > 0) {
        const inserted = $customercommunicationdg.datagrid('getChanges', 'inserted').map(item => {
          item.TrackingState = 1;
          return item;
        });
        const deleted = $customercommunicationdg.datagrid('getChanges', 'deleted').map(item => {
          item.TrackingState = 3;
          return item;
        });
        const updated = $customercommunicationdg.datagrid('getChanges', 'updated').map(item => {
          item.TrackingState = 2;
          return item;
        });
        //过滤已删除的重复项
        const changed = inserted.concat(updated.filter(item => {
          return !deleted.includes(item);
        })).concat(deleted);
        return { success: true, changed };
      } else {
        return { success: true, changed:undefined};
      }
    } else {
      return { success: false,changed:undefined };
    }
  }
  //提交修改的数据
  function customercommunication_acceptchanges() {
    $customercommunicationdg.datagrid('acceptChanges');
  }
    //提交保存后台数据库
  async function customercommunication_accept() {
			if (customercommunication_endEditing()) {
				if ($customercommunicationdg.datagrid('getChanges').length > 0) {
					const inserted = $customercommunicationdg.datagrid('getChanges', 'inserted').map(item => {
                       item.TrackingState = 1;
                       return item;
                    });
					const deleted = $customercommunicationdg.datagrid('getChanges', 'deleted').map(item => {
                       item.TrackingState = 3;
                       return item;
                    });
					const updated = $customercommunicationdg.datagrid('getChanges', 'updated').map(item => {
                       item.TrackingState = 2;
                       return item;
                    });
					//过滤已删除的重复项
                    const changed = inserted.concat(updated.filter(item => {
                           return !deleted.includes(item);
                         })).concat(deleted);
                   //console.table(changed);
				  if (MODELSTATE === 'Added') {
                    return { success:true, changed };
                  } else {
                    const response = await $.post('/CustomerCommunications/SaveData', {customercommunications:changed});
                    response.changed = undefined;
    				if (response.success) {
							toastr.success('保存明细成功'); 
							$customercommunicationdg.datagrid('acceptChanges');
							$customercommunicationdg.datagrid('reload');
                            return { success:true}; 
				    } else {
                           $.messager.alert('错误', response.err ,'error');
                           return { success:false, err:response.err };
                    }
                   }
				} else {
                  return { success: true, changed: undefined};
                }
			} else {
               return { success: false };
            }
      }


$(() => {
