<script type="text/javascript">
     var form_state = 'Added';
     var current_index = -1;
     var customerwarehouse = {};
 
     function open_customerwarehousedlg(index, row, state) {
         form_state = state;
         current_index = index;
         customerwarehouse = row;
         $('#customerwarehousedlg').dialog('open');
         if (form_state === 'Added') {
             $('#customerwarehousedlg').dialog('setTitle', '新增明细');
         } else {
             $('#customerwarehousedlg').dialog('setTitle', '修改明细');
         }
         $('#customerwarehouse_form').form('reset');
         $('#customerwarehouse_form').form('load', customerwarehouse);
     }
     function confirm_customerwarehouseform() {
         $customerwarehouseform = $('#customerwarehouse_form');
         if ($customerwarehouseform.form('enableValidation').form('validate')) {
             customerwarehouse = $customerwarehouseform.serializeJSON();
             if (form_state === 'Added') {
                 $(document).trigger('customerwarehouse_form.add', [current_index, customerwarehouse])
             } else {
                 $(document).trigger('customerwarehouse_form.edit', [current_index, customerwarehouse])
             }
             $('#customerwarehousedlg').dialog('close');
         }
     }
 </script>

 