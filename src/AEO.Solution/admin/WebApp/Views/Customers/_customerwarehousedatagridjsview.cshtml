    //新增记录
    function customerwarehouse_append() {
       const $customerform = $('#customer_form');
       if ($customerform.form('enableValidation').form('validate')) {
          const customer = $customerform.serializeJSON();
       const item = {
          CustomerCode: 'customer.CustomerCode', 
CustomerName: 'customer.CustomerName', 
CustomerId: customer.Id, 

          CustomerId:customer.Id
        };
      if (!SUBEDITINLINE) {
        open_customerwarehousedlg(0, item, 'Added');
      } else {
			if (customerwarehouse_endEditing()) {
				//对必填字段进行默认值初始化
				$customerwarehousedg.datagrid('insertRow', 
                               { index: 0,
                                  row: item 
                               });
				customerwarehouse_editIndex = 0;
				$customerwarehousedg.datagrid('selectRow', customerwarehouse_editIndex)
						.datagrid('beginEdit', customerwarehouse_editIndex);
			}
        }
        }
	 }
    //删除编辑的行
	function customerwarehouse_removeit() {
		if (customerwarehouse_editIndex !== undefined) {  
            const delindex = orderdetail_editIndex;
			$customerwarehousedg.datagrid('cancelEdit', delindex)
					           .datagrid('deleteRow', delindex);

        } else {
           const row = $customerwarehousedg.datagrid('getSelected');
           if(row){
             const rowindex = $customerwarehousedg.datagrid('getRowIndex', row);
             $customerwarehousedg.datagrid('deleteRow', rowindex);
           }else{
             $.messager.alert('提示', '没有选中删除的记录.', 'info');
           }
        }
	}
    //删除选中的行
    function customerwarehouse_deletechecked() {
            const rows = $customerwarehousedg.datagrid('getChecked');
            if (rows.length > 0) {
                var id = rows.filter(item=>item.Id!=null).map(item => {
                    return item.Id;
                });
                $.messager.confirm('确认', `你确定要删除这 <span class='badge bg-color-red'>${id.length}</span> 行记录?`,result => {
                    if (result) {
                        $.post('/CustomerWarehouses/DeleteChecked', { id: id })
                         .done(response => {
                            if (response.success) {
                                $customerwarehousedg.datagrid('reload');
                            } else {
                                $.messager.alert('错误', response.err,'error');
                            }
                         });
                    }
                });  
            } else {
                $.messager.alert('提示', '请先选择要删除的记录!','question');
            }
      }
  //获取修改的行
  function customerwarehouse_getchanges() {
    if (customerwarehouse_endEditing()) {
      if ($customerwarehousedg.datagrid('getChanges').length > 0) {
        const inserted = $customerwarehousedg.datagrid('getChanges', 'inserted').map(item => {
          item.TrackingState = 1;
          return item;
        });
        const deleted = $customerwarehousedg.datagrid('getChanges', 'deleted').map(item => {
          item.TrackingState = 3;
          return item;
        });
        const updated = $customerwarehousedg.datagrid('getChanges', 'updated').map(item => {
          item.TrackingState = 2;
          return item;
        });
        //过滤已删除的重复项
        const changed = inserted.concat(updated.filter(item => {
          return !deleted.includes(item);
        })).concat(deleted);
        return { success: true, changed };
      } else {
        return { success: true, changed:undefined};
      }
    } else {
      return { success: false,changed:undefined };
    }
  }
  //提交修改的数据
  function customerwarehouse_acceptchanges() {
    $customerwarehousedg.datagrid('acceptChanges');
  }
    //提交保存后台数据库
  async function customerwarehouse_accept() {
			if (customerwarehouse_endEditing()) {
				if ($customerwarehousedg.datagrid('getChanges').length > 0) {
					const inserted = $customerwarehousedg.datagrid('getChanges', 'inserted').map(item => {
                       item.TrackingState = 1;
                       return item;
                    });
					const deleted = $customerwarehousedg.datagrid('getChanges', 'deleted').map(item => {
                       item.TrackingState = 3;
                       return item;
                    });
					const updated = $customerwarehousedg.datagrid('getChanges', 'updated').map(item => {
                       item.TrackingState = 2;
                       return item;
                    });
					//过滤已删除的重复项
                    const changed = inserted.concat(updated.filter(item => {
                           return !deleted.includes(item);
                         })).concat(deleted);
                   //console.table(changed);
				  if (MODELSTATE === 'Added') {
                    return { success:true, changed };
                  } else {
                    const response = await $.post('/CustomerWarehouses/SaveData', {customerwarehouses:changed});
                    response.changed = undefined;
    				if (response.success) {
							toastr.success('保存明细成功'); 
							$customerwarehousedg.datagrid('acceptChanges');
							$customerwarehousedg.datagrid('reload');
                            return { success:true}; 
				    } else {
                           $.messager.alert('错误', response.err ,'error');
                           return { success:false, err:response.err };
                    }
                   }
				} else {
                  return { success: true, changed: undefined};
                }
			} else {
               return { success: false };
            }
      }


