@model WebApp.Models.CustomerWarehouse
<script type="text/javascript">
    //是否开启行内编辑
    var SUBEDITINLINE = false;
   //初始化 CustomerWarehouse datagrid
   var $customerwarehousedg = $('#customerwarehouse_datagrid');
   //当前行记录
   var customerwarehouse = {};
   //datagrid CRUD method
    var customerwarehouse_editIndex = undefined;
    //取消
    function customerwarehouse_reject() {
		$customerwarehousedg.datagrid('rejectChanges');
		customerwarehouse_editIndex = undefined;
    }
    //重新加载数据
    function customerwarehouse_reload() {
			if (customerwarehouse_endEditing()) {
				$customerwarehousedg.datagrid('reload');
			}
	}
    //关闭编辑状态
	function customerwarehouse_endEditing() {
			if (customerwarehouse_editIndex === undefined) {
                return true; 
            }
			if ($customerwarehousedg.datagrid('validateRow', customerwarehouse_editIndex)) {
				$customerwarehousedg.datagrid('endEdit', customerwarehouse_editIndex);
				customerwarehouse_editIndex = undefined;
                return true;
			} else {
				const invalidinput = $('input.validatebox-invalid',$customerwarehousedg.datagrid('getPanel'));
                const fieldnames = invalidinput.map((index, item) => {
                  return $(item).attr('placeholder') || $(item).attr('id');
                });
                $.messager.alert('提示', `${Array.from(fieldnames)} 输入有误.`, 'error');
				return false;
			}
		}
    //单击列开启编辑功能
	function customerwarehouse_onClickCell(index, field) {
			const _operates = ['_operate1', 'ck'];
             $('button[name*=\'customerwarehousedeletebutton\']').prop('disabled', false);
			if (!SUBEDITINLINE || $.inArray(field, _operates) >= 0) {
				return false;
			}
			if (customerwarehouse_editIndex !== index) {
				if (customerwarehouse_endEditing()) {
					$customerwarehousedg.datagrid('selectRow', index)
							.datagrid('beginEdit', index);
                    //customerwarehouse_editIndex = index;
					var ed = $customerwarehousedg.datagrid('getEditor', { index: index, field: field });
					if (ed) {
						($(ed.target).data('textbox') ? $(ed.target).textbox('textbox') : $(ed.target)).focus();
					}
				} else {
					$customerwarehousedg.datagrid('selectRow', customerwarehouse_editIndex);
				}
			}
		}
    //双击弹出编辑当前行对话框
    function customerwarehouse_onDblClickRow(index, row) {
        if (!SUBEDITINLINE) {
