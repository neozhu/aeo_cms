<!--begin popup detailview javascript block -->
<script type="text/javascript">
 //当初始的 HTML 文档被完全加载和解析完成之后
 document.addEventListener('DOMContentLoaded', function () {
     //绑定按钮事件
    $('button[name="saveitembutton"]').on('click', savehscodeitem);
    $('button[name="deleteitembutton"]').on('click', deletehscodeitem);
  });
    //判断新增编辑状态
    var MODELSTATE = 'Added';
    var hscodeid = null;
    function openhscodedetailwindow(data,state) {
         MODELSTATE = state;
         //判断是否显示功能按钮
        if (MODELSTATE === 'Added') {
          $('#deleteitem-btn-group').hide();
        } else {
          $('#deleteitem-btn-group').show();
        }
        inithscodedetailview();
         hscodeid = (data.Id || 0);
         $('#hscodedetailwindow').window('open');
         $('#hscode_form').form('reset');
         $('#hscode_form').form('load', data);
             }
  //删除当前记录
  function deletehscodeitem() {
    $.messager.confirm('确认', '你确定要删除该记录?', result => {
      if (result) {
        const url = `/HSCodes/Delete/${hscodeid}`;
        $.get(url).done(res => {
          if (res.success) {
            toastr.success("删除成功");
            $('#hscodedetailwindow').window('close');
            reloadData();
          } else {
            $.messager.alert('错误', res.err, 'error');
          }
        });
      }
    });
  }
    //async 保存数据
    async function savehscodeitem() { 
      const $hscodeform = $('#hscode_form');
      if ($hscodeform.form('enableValidation').form('validate')) {
            let hscode = $hscodeform.serializeJSON();
            let url = '/HSCodes/Edit';
            //判断是新增或是修改方法
            if (MODELSTATE === 'Added') {
                url = '/HSCodes/Create';
            }
            var token = $('input[name="__RequestVerificationToken"]', $hscodeform).val();
            $.ajax({
                    type: "POST",
                    url: url,
                    data: {
                        __RequestVerificationToken: token,
                        hscode:hscode
                    },
                    dataType: 'json',
                    contentType: 'application/x-www-form-urlencoded; charset=utf-8'
                })
                .done(response => {
                    if (response.success) {
                        hook = false;
                        $hscodeform.form('disableValidation');
                        $('#hscodedetailwindow').window("close");
                        toastr.success("保存成功"); 
                        reloadData();
                    } else {
                        $.messager.alert("错误",   response.err, "error");
                    }
                    })
                .fail((jqXHR, textStatus, errorThrown) => {
                       $.messager.alert('异常', `${jqXHR.status}: ${jqXHR.statusText} `, 'error');
                    });
        }
    }
     //判断是否有没有保存的记录
     function hscodehasmodified() {
            return hook;

     }


function inithscodedetailview() {
//回车光标移动到下个输入控件
}
</script>

