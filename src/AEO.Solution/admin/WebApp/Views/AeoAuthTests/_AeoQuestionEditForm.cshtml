@model WebApp.Models.AeoQuestion
<div id="aeoquestiondlg" class="easyui-dialog"
     title="AeoQuestion" style="width:600px;height:300px; display:none"
     data-options="
                iconCls: 'fal fa-window',
                modal:true,
                closed:true,
                cache: false,
                resizable:true,
                width:620,
                height:300,
                onOpen:function(){
                   $('#aeoquestion_form').form('disableValidation');
                },
                buttons: [{
                    text:'确认',
                    handler:function(){
                        confirm_aeoquestionform();
                    }
                },{
                    text:'取消',
