</div>
<script type="text/javascript">
     var form_state = 'Added';
     var current_index = -1;
     var aeoquestion = {};
 
     function open_aeoquestiondlg(index, row, state) {
         form_state = state;
         current_index = index;
         aeoquestion = row;
         $('#aeoquestiondlg').dialog('open');
         if (form_state === 'Added') {
             $('#aeoquestiondlg').dialog('setTitle', '新增明细');
         } else {
             $('#aeoquestiondlg').dialog('setTitle', '修改明细');
         }
         $('#aeoquestion_form').form('reset');
         $('#aeoquestion_form').form('load', aeoquestion);
     }
     function confirm_aeoquestionform() {
         $aeoquestionform = $('#aeoquestion_form');
         if ($aeoquestionform.form('enableValidation').form('validate')) {
             aeoquestion = $aeoquestionform.serializeJSON();
             if (form_state === 'Added') {
                 $(document).trigger('aeoquestion_form.add', [current_index, aeoquestion])
             } else {
                 $(document).trigger('aeoquestion_form.edit', [current_index, aeoquestion])
             }
             $('#aeoquestiondlg').dialog('close');
         }
     }
 </script>

 