<!-- 弹出编辑对话框 -->
<!-- aeoquestion datagrid  javascript block -->
@Html.Partial("_AeoQuestionEditForm", new WebApp.Models.AeoQuestion())

<!--begin popup detailview javascript block -->
<script type="text/javascript">
 //当初始的 HTML 文档被完全加载和解析完成之后
 document.addEventListener('DOMContentLoaded', function () {
     //绑定按钮事件
    $('button[name="saveitembutton"]').on('click', saveaeoauthtestitem);
    $('button[name="deleteitembutton"]').on('click', deleteaeoauthtestitem);
 $('button[name="aeoquestion_searchbutton"]').on('click', aeoquestion_reloadData);
 $('button[name="aeoquestion_appenditembutton"]').on('click', aeoquestion_appendItem);
 $('button[name="aeoquestion_deleterowbutton"]').on('click', aeoquestion_removeItem);
 $('button[name="aeoquestion_cancelchangesbutton"]').on('click', aeoquestion_rejectChanges);
 $('button[name="aeoquestion_savechangesbutton"]').on('click', aeoquestion_acceptChanges);
 $('a[data-toggle="tab"]').on('shown.bs.tab', (e)=> {
    const model = $(e.target).data('model');
    $(`#${model}dg`).datagrid('resize');
 })
  });
    //判断新增编辑状态
    var MODELSTATE = 'Added';
    var aeoauthtestid = null;
    function openaeoauthtestdetailwindow(data,state) {
         MODELSTATE = state;
         //判断是否显示功能按钮
        if (MODELSTATE === 'Added') {
          $('#deleteitem-btn-group').hide();
        } else {
          $('#deleteitem-btn-group').show();
        }
        initaeoauthtestdetailview();
         aeoauthtestid = (data.Id || 0);
         $('#aeoauthtestdetailwindow').window('open');
         $('#aeoauthtest_form').form('reset');
         $('#aeoauthtest_form').form('load', data);
                   var url='/AeoQuestions/GetDataByAeoAuthTestId?aeoauthtestid=' +  aeoauthtestid;
          $aeoquestiondg.datagrid('load',url);
          $aeoquestiondg.datagrid('resize');
             }
  //删除当前记录
  function deleteaeoauthtestitem() {
    $.messager.confirm('确认', '你确定要删除该记录?', result => {
      if (result) {
        const url = `/AeoAuthTests/Delete/${aeoauthtestid}`;
        $.get(url).done(res => {
          if (res.success) {
            toastr.success("删除成功");
            $('#aeoauthtestdetailwindow').window('close');
            reloadData();
          } else {
            $.messager.alert('错误', res.err, 'error');
          }
        });
      }
    });
  }
    //async 保存数据
    async function saveaeoauthtestitem() { 
      const $aeoauthtestform = $('#aeoauthtest_form');
      if ($aeoauthtestform.form('enableValidation').form('validate')) {
            let aeoauthtest = $aeoauthtestform.serializeJSON();
				  //获取明细表数据
 
                      const aeoquestion_result = await aeoquestion_acceptChanges();
                      if (!aeoquestion_result.success) {
                         return false;
                      } else {
                         aeoauthtest.Aeoquestions = aeoquestion_result.changed;
                      }
                      
            let url = '/AeoAuthTests/Edit';
            //判断是新增或是修改方法
            if (MODELSTATE === 'Added') {
                url = '/AeoAuthTests/Create';
            }
            var token = $('input[name="__RequestVerificationToken"]', $aeoauthtestform).val();
            $.ajax({
                    type: "POST",
                    url: url,
                    data: {
                        __RequestVerificationToken: token,
                        aeoauthtest:aeoauthtest
                    },
                    dataType: 'json',
                    contentType: 'application/x-www-form-urlencoded; charset=utf-8'
                })
                .done(response => {
                    if (response.success) {
                        hook = false;
                        $aeoauthtestform.form('disableValidation');
                        $('#aeoauthtestdetailwindow').window("close");
                        toastr.success("保存成功"); 
                        reloadData();
                    } else {
                        $.messager.alert("错误",   response.err, "error");
                    }
                    })
                .fail((jqXHR, textStatus, errorThrown) => {
                       $.messager.alert('异常', `${jqXHR.status}: ${jqXHR.statusText} `, 'error');
                    });
        }
    }
     //判断是否有没有保存的记录
     function aeoauthtesthasmodified() {
      if(!hook) {
            if (!aeoquestion_endEditing()) {
                 return true;
             }
            const aeoquestions = $aeoquestiondg.datagrid("getChanges");
            if (MODELSTATE == 'Modified' && aeoquestions.length > 0) {
                return true;
            }
            return false;
         } else {
            return hook;
         }

     }


function initaeoauthtestdetailview() {
//回车光标移动到下个输入控件
    //如果是枚举类型需要把numberbox改成combobox
    //海关注册时长
	$('#RegistedTime').numberbox('textbox').bind('keydown', function (e) {
      if (e.keyCode == 13) {
        $(e.target).emulateTab();
      }
    });
    //如果是枚举类型需要把numberbox改成combobox
    //年份
	$('#Year').numberbox('textbox').bind('keydown', function (e) {
      if (e.keyCode == 13) {
        $(e.target).emulateTab();
      }
    });
    //如果是枚举类型需要把numberbox改成combobox
    //合格分数
	$('#StdScore').numberbox('textbox').bind('keydown', function (e) {
      if (e.keyCode == 13) {
        $(e.target).emulateTab();
      }
    });
    //如果是枚举类型需要把numberbox改成combobox
    //分数
	$('#Score').numberbox('textbox').bind('keydown', function (e) {
      if (e.keyCode == 13) {
        $(e.target).emulateTab();
      }
    });
    //日期类型 海关注册日期
	$('#RegistDate').datebox('textbox').bind('keydown', function (e) {
      if (e.keyCode == 13) {
        $(e.target).emulateTab();
      }
    });
    //日期类型 自评日期
	$('#AuthDate').datebox('textbox').bind('keydown', function (e) {
      if (e.keyCode == 13) {
        $(e.target).emulateTab();
      }
    });
    //日期类型 评定开始日期
	$('#BeginDate').datebox('textbox').bind('keydown', function (e) {
      if (e.keyCode == 13) {
        $(e.target).emulateTab();
      }
    });
    //日期类型 评定结束日期
	$('#EndDate').datebox('textbox').bind('keydown', function (e) {
      if (e.keyCode == 13) {
        $(e.target).emulateTab();
      }
    });
}
</script>

