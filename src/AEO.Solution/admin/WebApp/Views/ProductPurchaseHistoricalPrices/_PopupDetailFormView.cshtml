﻿@model WebApp.Models.ProductPurchaseHistoricalPrice
<!-- 弹出编辑窗体表单 -->
 <div id="productpurchasehistoricalpricedetailwindow" class="easyui-window" 
      title="明细数据" 
      data-options="modal:true,
                    closed:true,
                    minimizable:false,
                    collapsible:false,
                    maximized:false,
                    iconCls:'fal fa-window',
                    onBeforeClose:function(){
                      var that = $(this);
                      if(productpurchasehistoricalpricehasmodified()){
                        $.messager.confirm('确认','你确定要放弃保存修改的记录?',function(r){
                        if (r){
                          var opts = that.panel('options');
                          var onBeforeClose = opts.onBeforeClose;
                          opts.onBeforeClose = function(){};
                          that.panel('close');
                          opts.onBeforeClose = onBeforeClose;
                          hook = false;
                        }
                        });
                        return false;
                      }
                    },
                    onOpen:function(){
                       $(this).window('vcenter');
                       $(this).window('hcenter');
                    },
                    onRestore:function(){
                    },
                    onMaximize:function(){
                    }
                    " style="width:800px;height:450px;display:none">
  <!-- toolbar -->
  <div class="panel-content py-2 rounded-bottom border-faded border-left-0 border-right-0  text-muted bg-subtlelight-fade sticky-top">
  <div class="d-flex flex-row-reverse pr-4">
        <div class="btn-group btn-group-sm mr-1">
          <button name="saveitembutton" onclick="saveproductpurchasehistoricalpriceitem()" class="btn btn-default">
            <i class="fal fa-save"></i> @Html.L("Save")
          </button>
        </div>
        <div class="btn-group btn-group-sm mr-1" id="deleteitem-btn-group">
          <button onclick="deleteproductpurchasehistoricalpriceitem()" class="btn btn-danger">
            <i class="fal fa-trash-alt"></i> @Html.L("Delete")
          </button>
        </div>
    </div>
  </div>
 <!-- panel container form  -->
 <div class="panel-container show">
   <div class="container">
    <div class="panel-content">
           <form id="productpurchasehistoricalprice_form" 
              class="easyui-form form-horizontal padding-10" 
              method="post" 
              data-options="novalidate:true,
                            onChange: function(target){
                              hook = true;
                              $('button[name*=\'saveitembutton\']').prop('disabled', false);
                             },
                             onLoadSuccess:function(data){
                               hook = false;
                               $('button[name*=\'saveitembutton\']').prop('disabled', true);
                             }">
  @Html.AntiForgeryToken()
   <!--Primary Key-->
  @Html.HiddenFor(model=>model.Id)
   <fieldset class="form-group">
   <div class="row h-100 align-items-center">

   <!--供应商代码-->
        <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"><span class="text-danger">*</span> @Html.DisplayNameFor(model => model.SupplierCode)</label>
		<div class="col-md-4 mb-1 pl-1">  
			<input id="@Html.IdFor(model => model.SupplierCode)" 
				   name="@Html.NameFor(model => model.SupplierCode)" 
				   value="@Html.ValueFor(model => model.SupplierCode)"
				   tabindex="0" required
				   class="easyui-textbox" 
                   style="width:100%"
				   type="text" 
				   data-options="prompt:'@Html.DescriptionFor(model => model.SupplierCode)',
								 required:true, 
                                 validType: 'length[0,20]'
                                 " />
       </div>
				   
   <!--供应商名称-->
        <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"> @Html.DisplayNameFor(model => model.SupplierName)</label>
		<div class="col-md-4 mb-1 pl-1">  
			<input id="@Html.IdFor(model => model.SupplierName)" 
				   name="@Html.NameFor(model => model.SupplierName)" 
				   value="@Html.ValueFor(model => model.SupplierName)"
				   tabindex="1" 
				   class="easyui-textbox" 
                   style="width:100%"
				   type="text" 
				   data-options="prompt:'@Html.DescriptionFor(model => model.SupplierName)',
								 required:false, 
                                 validType: 'length[0,80]'
                                 " />
       </div>
				   

   <!--工厂货号-->
        <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"> @Html.DisplayNameFor(model => model.ThirdProductNo)</label>
		<div class="col-md-4 mb-1 pl-1">  
			<input id="@Html.IdFor(model => model.ThirdProductNo)" 
				   name="@Html.NameFor(model => model.ThirdProductNo)" 
				   value="@Html.ValueFor(model => model.ThirdProductNo)"
				   tabindex="2" 
				   class="easyui-textbox" 
                   style="width:100%"
				   type="text" 
				   data-options="prompt:'@Html.DescriptionFor(model => model.ThirdProductNo)',
								 required:false, 
                                 validType: 'length[0,80]'
                                 " />
       </div>
				   
   <!--询价时间-->
        <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"><span class="text-danger">*</span> @Html.DisplayNameFor(model => model.QuoteDate)</label>
		<div class="col-md-4 mb-1 pl-1">  
                <input id="@Html.IdFor(model => model.QuoteDate)" 
			       name="@Html.NameFor(model => model.QuoteDate)"
                   value="@Html.ValueFor(model => model.QuoteDate)"
           		   tabindex="3"  required
				   class="easyui-datebox" 
                   style="width:100%"
				   type="text" 
				   data-options="prompt:'@Html.DescriptionFor(model => model.QuoteDate)',
								 required:true,
								 formatter:dateformatter" />
     </div>
				   

   <!--币种-->
        <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"> @Html.DisplayNameFor(model => model.CUR)</label>
		<div class="col-md-4 mb-1 pl-1">  
			<input id="@Html.IdFor(model => model.CUR)" 
				   name="@Html.NameFor(model => model.CUR)" 
				   value="@Html.ValueFor(model => model.CUR)"
				   tabindex="4" 
				   class="easyui-textbox" 
                   style="width:100%"
				   type="text" 
				   data-options="prompt:'@Html.DescriptionFor(model => model.CUR)',
								 required:false, 
                                 validType: 'length[0,10]'
                                 " />
       </div>
				   
   <!--单价-->
       <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"><span class="text-danger">*</span> @Html.DisplayNameFor(model => model.UnitPrice)</label>
	   <div class="col-md-4 mb-1 pl-1">  
             <input id="@Html.IdFor(model => model.UnitPrice)"
				   name="@Html.NameFor(model => model.UnitPrice)" 
				   value="@Html.ValueFor(model => model.UnitPrice)"
				   tabindex="5" 
				   class="easyui-numberbox" 
                   style="width:100%"
				   type="text" 
				   data-options="prompt:'@Html.DescriptionFor(model => model.UnitPrice)',
								 required:true,formatter:numberformatter,
                                 parser:parsernumber,precision:2,
                                 
                                 "  />

        </div>
				   

   <!--数量-->
       <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"><span class="text-danger">*</span> @Html.DisplayNameFor(model => model.Qty)</label>
	   <div class="col-md-4 mb-1 pl-1">  
             <input id="@Html.IdFor(model => model.Qty)"
				   name="@Html.NameFor(model => model.Qty)" 
				   value="@Html.ValueFor(model => model.Qty)"
				   tabindex="6" 
				   class="easyui-numberbox" 
                   style="width:100%"
				   type="text" 
				   data-options="prompt:'@Html.DescriptionFor(model => model.Qty)',
								 required:true,formatter:numberformatter,
                                 parser:parsernumber,precision:2,
                                 
                                 "  />

        </div>
				   
   <!--来源-->
        <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"> @Html.DisplayNameFor(model => model.Source)</label>
		<div class="col-md-4 mb-1 pl-1">  
			<input id="@Html.IdFor(model => model.Source)" 
				   name="@Html.NameFor(model => model.Source)" 
				   value="@Html.ValueFor(model => model.Source)"
				   tabindex="7" 
				   class="easyui-textbox" 
                   style="width:100%"
				   type="text" 
				   data-options="prompt:'@Html.DescriptionFor(model => model.Source)',
								 required:false, 
                                 validType: 'length[0,10]'
                                 " />
       </div>
				   

   <!--单据号-->
        <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"> @Html.DisplayNameFor(model => model.DocNo)</label>
		<div class="col-md-4 mb-1 pl-1">  
			<input id="@Html.IdFor(model => model.DocNo)" 
				   name="@Html.NameFor(model => model.DocNo)" 
				   value="@Html.ValueFor(model => model.DocNo)"
				   tabindex="8" 
				   class="easyui-textbox" 
                   style="width:100%"
				   type="text" 
				   data-options="prompt:'@Html.DescriptionFor(model => model.DocNo)',
								 required:false, 
                                 validType: 'length[0,100]'
                                 " />
       </div>
				   
   <!--备注-->
        <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"> @Html.DisplayNameFor(model => model.Remark)</label>
		<div class="col-md-4 mb-1 pl-1">  
			<input id="@Html.IdFor(model => model.Remark)" 
				   name="@Html.NameFor(model => model.Remark)" 
				   value="@Html.ValueFor(model => model.Remark)"
				   tabindex="9" 
				   class="easyui-textbox" 
                   style="width:100%"
				   type="text" 
				   data-options="prompt:'@Html.DescriptionFor(model => model.Remark)',
								 required:false, 
                                 validType: 'length[0,50]'
                                 " />
       </div>
				   

   <!--产品编号(自动生成,可手工修改)-->
        <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"><span class="text-danger">*</span> @Html.DisplayNameFor(model => model.ProductNo)</label>
		<div class="col-md-4 mb-1 pl-1">  
			<input id="@Html.IdFor(model => model.ProductNo)" 
				   name="@Html.NameFor(model => model.ProductNo)" 
				   value="@Html.ValueFor(model => model.ProductNo)"
				   tabindex="10" required
				   class="easyui-textbox" 
                   style="width:100%"
				   type="text" 
				   data-options="prompt:'@Html.DescriptionFor(model => model.ProductNo)',
								 required:true, 
                                 validType: 'length[0,128]'
                                 " />
       </div>
				   
   <!--产品名称-->
        <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"> @Html.DisplayNameFor(model => model.ProductName)</label>
		<div class="col-md-4 mb-1 pl-1">  
			<input id="@Html.IdFor(model => model.ProductName)" 
				   name="@Html.NameFor(model => model.ProductName)" 
				   value="@Html.ValueFor(model => model.ProductName)"
				   tabindex="11" 
				   class="easyui-textbox" 
                   style="width:100%"
				   type="text" 
				   data-options="prompt:'@Html.DescriptionFor(model => model.ProductName)',
								 required:false, 
                                 validType: 'length[0,200]'
                                 " />
       </div>
				   

    <!--所属产品-->
        <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"><span class="text-danger">*</span> @Html.DisplayNameFor(model => model.ProductId)</label>
		<div class="col-md-4 mb-1 pl-1">   	
            <input id="@Html.IdFor(model => model.ProductId)"
			       name="@Html.NameFor(model => model.ProductId)"
				   value="@Html.ValueFor(model => model.ProductId)"
                   tabindex="12" required
              	   class="easyui-combobox"      
                   style="width:100%"
                   data-options="prompt:'@Html.DescriptionFor(model => model.ProductId)' ,
						required:true ,
						valueField: 'Id',
						textField:  'ProductNo' ,
                        panelHeight:'auto',
                        editable:false,
						url: '/ProductPurchaseHistoricalPrices/GetProducts' ,
						onSelect: function(item){
						  //console.log(item);
				        }">
       </div>
	   
	    </div> 
      </fieldset>
   </form>
    </div>
    </div>
    </div>
</div>

<!-- 弹出窗体form表单 -->
<!-- 弹出编辑对话框 -->

<!--begin popup detailview javascript block -->
<script type="text/javascript">
    //判断新增编辑状态
    var MODELSTATE = 'Added';
    var productpurchasehistoricalpriceid = null;
    function openproductpurchasehistoricalpricedetailwindow(data,state) {
         MODELSTATE = state;
         initproductpurchasehistoricalpricedetailview();
         productpurchasehistoricalpriceid = (data.Id || 0);
         $('#productpurchasehistoricalpricedetailwindow').window('open');
         $('#productpurchasehistoricalprice_form').form('reset');
         $('#productpurchasehistoricalprice_form').form('load', data);
             }
  //删除当前记录
  function deleteproductpurchasehistoricalpriceitem() {
    $.messager.confirm('确认', '你确定要删除该记录?', result => {
      if (result) {
        const url = `/ProductPurchaseHistoricalPrices/Delete/${productpurchasehistoricalpriceid}`;
        $.get(url).done(res => {
          if (res.success) {
            toastr.success("删除成功");
            $('#productpurchasehistoricalpricedetailwindow').window('close');
            reloadData();
          } else {
            $.messager.alert('错误', res.err, 'error');
          }
        });
      }
    });
  }
    //async 保存数据
    async function saveproductpurchasehistoricalpriceitem() { 
      const $productpurchasehistoricalpriceform = $('#productpurchasehistoricalprice_form');
      if ($productpurchasehistoricalpriceform.form('enableValidation').form('validate')) {
            let productpurchasehistoricalprice = $productpurchasehistoricalpriceform.serializeJSON();
            let url = '/ProductPurchaseHistoricalPrices/Edit';
            //判断是新增或是修改方法
            if (MODELSTATE === 'Added') {
                url = '/ProductPurchaseHistoricalPrices/Create';
            }
            var token = $('input[name="__RequestVerificationToken"]', $productpurchasehistoricalpriceform).val();
            $.ajax({
                    type: "POST",
                    url: url,
                    data: {
                        __RequestVerificationToken: token,
                        productpurchasehistoricalprice:productpurchasehistoricalprice
                    },
                    dataType: 'json',
                    contentType: 'application/x-www-form-urlencoded; charset=utf-8'
                })
                .done(response => {
                    if (response.success) {
                        hook = false;
                        $productpurchasehistoricalpriceform.form('disableValidation');
                        $('#productpurchasehistoricalpricedetailwindow').window("close");
                        toastr.success("保存成功"); 
                        reloadData();
                    } else {
                        $.messager.alert("错误",   response.err, "error");
                    }
                    })
                .fail((jqXHR, textStatus, errorThrown) => {
                       $.messager.alert('异常', `${jqXHR.status}: ${jqXHR.statusText} `, 'error');
                    });
        }
    }
    //关闭窗口
    function closeproductpurchasehistoricalpricedetailwindow() {
        $('#productpurchasehistoricalpricedetailwindow').window('close');
    }
     //判断是否有没有保存的记录
     function productpurchasehistoricalpricehasmodified() {
            return hook;

     }


function initproductpurchasehistoricalpricedetailview() {
  //判断是否显示功能按钮
  if (MODELSTATE === 'Added') {
    $('#deleteitem-btn-group').hide();
  } else {
    $('#deleteitem-btn-group').show();
  }

//回车光标移动到下个输入控件
    //如果是枚举类型需要把numberbox改成combobox
    //单价
	$('#UnitPrice').numberbox('textbox').bind('keydown', function (e) {
      if (e.keyCode == 13) {
        $(e.target).emulateTab();
      }
    });
    //如果是枚举类型需要把numberbox改成combobox
    //数量
	$('#Qty').numberbox('textbox').bind('keydown', function (e) {
      if (e.keyCode == 13) {
        $(e.target).emulateTab();
      }
    });
    //日期类型 询价时间
	$('#QuoteDate').datebox('textbox').bind('keydown', function (e) {
      if (e.keyCode == 13) {
        $(e.target).emulateTab();
      }
    });
    //所属产品默认外键使用combobox,也可以使用combogrid
	$('#ProductId').combobox('textbox').bind('keydown', function (e) {
      if (e.keyCode == 13) {
        $(e.target).emulateTab();
      }
    });
}
</script>

