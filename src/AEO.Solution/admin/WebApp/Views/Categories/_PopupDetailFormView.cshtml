﻿@model WebApp.Models.Category
<!-- 弹出编辑窗体表单 -->
<div id="categorydetailwindow" class="easyui-window"
     title="新增产品类别"
     data-options="modal:true,
                    closed:true,
                    minimizable:false,
                    collapsible:false,
                    maximized:false,
                    iconCls:'fal fa-window',
                    onBeforeClose:function(){

                    },
                    onOpen:function(){
                       $(this).window('vcenter');
                       $(this).window('hcenter');
                    },
                    onRestore:function(){
                    },
                    onMaximize:function(){
                    }
                    " style="width:400px;height:250px;display:none">
  <!-- toolbar -->
  <div class="panel-content py-2 rounded-bottom border-faded border-left-0 border-right-0  text-muted bg-subtlelight-fade sticky-top">
    <div class="d-flex flex-row-reverse pr-4">
      <div class="btn-group btn-group-sm mr-1">
        <button name="saveitembutton" onclick="savecategoryitem()" class="btn btn-default">
          <i class="fal fa-save"></i> @Html.L("Save")
        </button>
      </div>
      <div class="btn-group btn-group-sm mr-1" id="deleteitem-btn-group">
        <button onclick="deletecategoryitem()" class="btn btn-danger">
          <i class="fal fa-trash-alt"></i> @Html.L("Delete")
        </button>
      </div>
    </div>
  </div>
  <!-- panel container form  -->
  <div class="panel-container show">
    <div class="container">
      <div class="panel-content">
        <form id="category_form"
              class="easyui-form form-horizontal padding-10"
              method="post"
              data-options="novalidate:true,
                            onChange: function(target){
                              $('button[name*=\'saveitembutton\']').prop('disabled', false);
                             },
                             onLoadSuccess:function(data){
                               $('button[name*=\'saveitembutton\']').prop('disabled', true);
                             }">
          @Html.AntiForgeryToken()
          <!--Primary Key-->
          @Html.HiddenFor(model => model.Id)
          <fieldset class="form-group">
            <div class="row h-100 align-items-center">

              <!--类别名称-->
              <label class="col-md-3  pt-1 pl-0 pr-0 form-label text-right"> @Html.DisplayNameFor(model => model.Name)</label>
              <div class="col-md-9 mb-1 pl-1">
                <input id="@Html.IdFor(model => model.Name)"
                       name="@Html.NameFor(model => model.Name)"
                       value="@Html.ValueFor(model => model.Name)"
                       tabindex="0"
                       class="easyui-textbox"
                       style="width:100%"
                       type="text"
                       data-options="prompt:'@Html.DescriptionFor(model => model.Name)',
								 required:false,
                                 validType: 'length[0,128]'
                                 " />
              </div>

              <!--英文名称-->
              <label class="col-md-3  pt-1 pl-0 pr-0 form-label text-right"> @Html.DisplayNameFor(model => model.EName)</label>
              <div class="col-md-9 mb-1 pl-1">
                <input id="@Html.IdFor(model => model.EName)"
                       name="@Html.NameFor(model => model.EName)"
                       value="@Html.ValueFor(model => model.EName)"
                       tabindex="1"
                       class="easyui-textbox"
                       style="width:100%"
                       type="text"
                       data-options="prompt:'@Html.DescriptionFor(model => model.EName)',
								 required:false,
                                 validType: 'length[0,128]'
                                 " />
              </div>


              <!--图标-->
              <label class="col-md-3  pt-1 pl-0 pr-0 form-label text-right"> @Html.DisplayNameFor(model => model.Icon)</label>
              <div class="col-md-9 mb-1 pl-1">
                <input id="@Html.IdFor(model => model.Icon)"
                       name="@Html.NameFor(model => model.Icon)"
                       value="@Html.ValueFor(model => model.Icon)"
                       tabindex="2"
                       class="easyui-textbox"
                       style="width:100%"
                       type="text"
                       data-options="prompt:'@Html.DescriptionFor(model => model.Icon)',
								 required:false,
                                 validType: 'length[0,30]'
                                 " />
              </div>

              <!--上级类别-->
              <label class="col-md-3  pt-1 pl-0 pr-0 form-label text-right"> @Html.DisplayNameFor(model => model.ParentId)</label>
              <div class="col-md-9 mb-1 pl-1">
                <input id="@Html.IdFor(model => model.ParentId)"
                       name="@Html.NameFor(model => model.ParentId)"
                       value="@Html.ValueFor(model => model.ParentId)"
                       tabindex="3"
                       class="easyui-combotree"
                       style="width:100%"
                       data-options="prompt:'@Html.DescriptionFor(model => model.ParentId)' ,
						required:false ,
						valueField: 'id',
						textField:  'text' ,
                        panelHeight:'auto',
                        editable:true,
						url: '/Categories/GetComboTreeData' ,
                   method:'get',
						onSelect: function(item){
						  //console.log(item);
				        }">
              </div>

            </div>
          </fieldset>
        </form>
      </div>
    </div>
  </div>
</div>

<!-- 弹出窗体form表单 -->
<!-- 弹出编辑对话框 -->
<!--begin popup detailview javascript block -->
<script type="text/javascript">
  //判断新增编辑状态
  var MODELSTATE = 'Added';
  var parentid = null;
  function opencategorydetailwindow(data, state) {
    MODELSTATE = state;
    initcategorydetailview();

    $('#categorydetailwindow').window('open');
    $('#category_form').form('reset');
    if (data && data.Id) {
      $('#ParentId').combotree('setValue', data.Id);
    }
  }
  //删除当前记录
  function deletecategoryitem() {
    $.messager.confirm('确认', '你确定要删除该记录?', result => {
      if (result) {
        const url = `/Categories/Delete/${categoryid}`;
        $.get(url).done(res => {
          if (res.success) {
            toastr.success("删除成功");
            $('#categorydetailwindow').window('close');
            reloadData();
          } else {
            $.messager.alert('错误', res.err, 'error');
          }
        });
      }
    });
  }
  //async 保存数据
  async function savecategoryitem() {
    const $categoryform = $('#category_form');
    if ($categoryform.form('enableValidation').form('validate')) {
      let category = $categoryform.serializeJSON();
      let url = '/Categories/Edit';
      //判断是新增或是修改方法
      if (MODELSTATE === 'Added') {
        url = '/Categories/Create';
      }
      var token = $('input[name="__RequestVerificationToken"]', $categoryform).val();
      $.ajax({
        type: "POST",
        url: url,
        data: {
          __RequestVerificationToken: token,
          category: category
        },
        dataType: 'json',
        contentType: 'application/x-www-form-urlencoded; charset=utf-8'
      })
        .done(response => {
          if (response.success) {
            hook = false;
            $categoryform.form('disableValidation');
            $('#categorydetailwindow').window("close");
            toastr.success("保存成功");
            reloadData();
          } else {
            $.messager.alert("错误", response.err, "error");
          }
        })
        .fail((jqXHR, textStatus, errorThrown) => {
          $.messager.alert('异常', `${jqXHR.status}: ${jqXHR.statusText} `, 'error');
        });
    }
  }
  //关闭窗口
  function closecategorydetailwindow() {
    $('#categorydetailwindow').window('close');
  }
  //判断是否有没有保存的记录
  function categoryhasmodified() {
    return hook;

  }


  function initcategorydetailview() {
    //判断是否显示功能按钮
    if (MODELSTATE === 'Added') {
      $('#deleteitem-btn-group').hide();
    } else {
      $('#deleteitem-btn-group').show();
    }

    //回车光标移动到下个输入控件
    //上级类别默认外键使用combobox,也可以使用combogrid
    $('#ParentId').combobox('textbox').bind('keydown', function (e) {
      if (e.keyCode == 13) {
        $(e.target).emulateTab();
      }
    });
  }
</script>

