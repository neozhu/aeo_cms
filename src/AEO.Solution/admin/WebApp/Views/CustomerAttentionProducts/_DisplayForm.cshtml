﻿@model WebApp.Models.CustomerAttentionProduct
  <div class="form-row">
   @Html.HiddenFor(x=>x.Id)
         <!--产品类别-->
        <div class="col-xs-12 col-md-6">
            <label class="form-label ">@Html.DisplayNameFor(model => model.Category)</label>
			@Html.EditorFor(x => x.Category, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.Category) } })
      
         </div>

		<!--产品类别-->
        <div class="col-xs-12 col-md-6">
            <label class="form-label ">@Html.DisplayNameFor(model => model.CategoryId)</label>
            @Html.EditorFor(x => x.CategoryId, new { htmlAttributes = new { @class = "form-control",@type="number", placeholder = Html.DisplayNameFor(x => x.CategoryId) } })

        </div>

        <!--产品编号-->
        <div class="col-xs-12 col-md-6">
            <label class="form-label ">@Html.DisplayNameFor(model => model.ProductNo)</label>
			@Html.EditorFor(x => x.ProductNo, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.ProductNo) } })
      
         </div>

        <!--中文品名-->
        <div class="col-xs-12 col-md-6">
            <label class="form-label ">@Html.DisplayNameFor(model => model.ProductName)</label>
			@Html.EditorFor(x => x.ProductName, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.ProductName) } })
      
         </div>

        <!--币种-->
        <div class="col-xs-12 col-md-6">
            <label class="form-label ">@Html.DisplayNameFor(model => model.CUR)</label>
			@Html.EditorFor(x => x.CUR, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.CUR) } })
      
         </div>

		<!--单价-->
        <div class="col-xs-12 col-md-6">
            <label class="form-label text-danger">@Html.DisplayNameFor(model => model.Pric)</label>
            @Html.EditorFor(x => x.Pric, new { htmlAttributes = new { @class = "form-control",@type="number", placeholder = Html.DisplayNameFor(x => x.Pric) } })

        </div>

		<!--报价次数-->
        <div class="col-xs-12 col-md-6">
            <label class="form-label text-danger">@Html.DisplayNameFor(model => model.SummaryQuote)</label>
            @Html.EditorFor(x => x.SummaryQuote, new { htmlAttributes = new { @class = "form-control",@type="number", placeholder = Html.DisplayNameFor(x => x.SummaryQuote) } })

        </div>

		<!--订单次数-->
        <div class="col-xs-12 col-md-6">
            <label class="form-label text-danger">@Html.DisplayNameFor(model => model.SummaryOrders)</label>
            @Html.EditorFor(x => x.SummaryOrders, new { htmlAttributes = new { @class = "form-control",@type="number", placeholder = Html.DisplayNameFor(x => x.SummaryOrders) } })

        </div>

     
       <!--所属客户-->
       <div class="col-xs-12 col-md-6">
            <label class="form-label text-danger">@Html.DisplayNameFor(model => model.CustomerId)</label>
   	        @Html.DropDownListFor(model => model.CustomerId, ViewBag.CustomerId as List<SelectListItem>, htmlAttributes: new { @class = "form-control" }) 
       </div>

        <!--客户编号(保存时系统自动分配也可以手工选择)-->
        <div class="col-xs-12 col-md-6">
            <label class="form-label ">@Html.DisplayNameFor(model => model.CustomerCode)</label>
			@Html.EditorFor(x => x.CustomerCode, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.CustomerCode) } })
      
         </div>

        <!--客户名称-->
        <div class="col-xs-12 col-md-6">
            <label class="form-label text-danger">@Html.DisplayNameFor(model => model.CustomerName)</label>
			@Html.EditorFor(x => x.CustomerName, new { htmlAttributes = new { @class = "form-control", placeholder = Html.DisplayNameFor(x => x.CustomerName) } })
      
         </div>

	    
</div>

