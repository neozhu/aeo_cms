@model WebApp.Models.Quotation
@{
  ViewData["Title"] = "报价单";
  ViewData["PageName"] = "Quotations_Index";
  ViewData["Heading"] = "<i class='fal fa-window text-primary'></i>  报价单";
  ViewData["Category1"] = "出口管理";
  ViewData["PageDescription"] = "";
}
@section HeadBlock {
  <link href="@Fingerprint.Tag("/Content/css/notifications/toastr/toastr.css")" rel="stylesheet" />
  <link href="@Fingerprint.Tag("/Scripts/easyui/themes/insdep/easyui.css")" rel="stylesheet" />
  <link href="@Fingerprint.Tag("/Content/css/formplugins/bootstrap-daterangepicker/bootstrap-daterangepicker.css")" rel="stylesheet" />
  <style>
    legend {
      color: #323a4d;
      font-size: 14px;
      font-family: "微软雅黑";
      font-weight: bold;
      padding-left: 12px;
      height: 16px;
      line-height: 15px;
      display: inline-block;
    }

    .numberbox .textbox-text {
      text-align: right;
    }
  </style>
}
<div class="row">
  <div class="col-lg-12 col-xl-12">
    <div id="panel-1" class="panel">
      <div class="panel-hdr">
        <h2>
          报价单
        </h2>
        <div class="panel-toolbar">
          <button class="btn btn-panel bg-transparent fs-xl w-auto h-auto rounded-0" data-action="panel-collapse" data-toggle="tooltip" data-offset="0,10" data-original-title="Collapse"><i class="fal fa-window-minimize"></i></button>
          <button class="btn btn-panel bg-transparent fs-xl w-auto h-auto rounded-0" data-action="panel-fullscreen" data-toggle="tooltip" data-offset="0,10" data-original-title="Fullscreen"><i class="fal fa-expand"></i></button>
          @*<button class="btn btn-panel bg-transparent fs-xl w-auto h-auto rounded-0" data-action="panel-close" data-toggle="tooltip" data-offset="0,10" data-original-title="Close"><i class="fal fa-trash-alt"></i></button>*@
        </div>

      </div>
      <div class="panel-container enable-loader show">
        <div class="loader"><i class="fal fa-spinner-third fa-spin-4x fs-xxl"></i></div>
        <div class="panel-content py-2 rounded-bottom border-faded border-left-0 border-right-0  text-muted bg-faded bg-subtlelight-fade">
          <div class="row no-gutters align-items-center">
            <div class="col">
              <!-- 开启授权控制请参考 @@if (Html.IsAuthorize("Create") -->
              <div class="btn-group btn-group-sm">
                <button name="searchbutton" class="btn btn-default"> <span class="fal fa-search mr-1"></span> @Html.L("Refresh") </button>
              </div>
              <div class="btn-group btn-group-sm">
                <button name="appendbutton" class="btn btn-default"> <span class="fal fa-plus mr-1"></span> @Html.L("Add") </button>
              </div>
              <div class="btn-group btn-group-sm">
                <button name="deleterowbutton" disabled class="btn btn-default"> <span class="fal fa-trash-alt mr-1"></span> @Html.L("Delete") </button>
              </div>

              <div class="btn-group btn-group-sm hidden-xs">
                <button name="importexcelbutton" type="button" class="btn btn-default"><span class="fal fa-cloud-upload mr-1"></span> @Html.L("Import") </button>
                <button type="button" class="btn btn-default dropdown-toggle dropdown-toggle-split" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                  <span class="sr-only">Toggle Dropdown</span>
                </button>
                <div class="dropdown-menu">
                  <button name="downloadtemplatebutton" class="dropdown-item js-waves-on"><span class="fal fa-download"></span> @Html.L("Download") </button>
                </div>
              </div>
              <div class="btn-group btn-group-sm ">
                <button name="exportexcelbutton" class="btn btn-default"> <span class="fal fa-file-excel mr-1"></span>  @Html.L("Export") </button>
              </div>
              <div class="btn-group btn-group-sm ">
                <button name="helpbutton" class="btn btn-default"> <span class="fal fa-question-circle mr-1"></span> @Html.L("Help") </button>
              </div>
            </div>
          </div>
        </div>
        <div class="panel-content">
          <div class="table-responsive">
            <table id="quotations_datagrid">
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

@section ScriptsBlock {

  <script src="@Fingerprint.Tag("/Scripts/notifications/toastr/toastr.js")"></script>
  <script src="@Fingerprint.Tag("/Scripts/formplugins/bootstrap-daterangepicker/bootstrap-daterangepicker.js")"></script>
  <script src="@Fingerprint.Tag("/Scripts/easyui/jquery.easyui.min.js")"></script>
  <script src="@Fingerprint.Tag("/Scripts/easyui/plugins/datagrid-filter.js")"></script>
  <script src="@Fingerprint.Tag("/Scripts/easyui/plugins/columns-ext.js")"></script>
  <script src="@Fingerprint.Tag("/Scripts/easyui/plugins/columns-reset.js")"></script>
  <script src="@Fingerprint.Tag("/Scripts/easyui/locale/easyui-lang-zh_CN.js")"></script>
  <script src="@Fingerprint.Tag("/Scripts/jquery.easyui.component.js")"></script>
  <script src="@Fingerprint.Tag("/Scripts/jquery.extend.formatter.js")"></script>
  <script src="@Fingerprint.Tag("/Scripts/jquery.custom.extend.js")"></script>
  <script src="@Fingerprint.Tag("/Scripts/plugin/jquery.serializejson/jquery.serializejson.min.js")"></script>
  <script src="@Fingerprint.Tag("/Scripts/plugin/filesaver/FileSaver.min.js")"></script>
  <script src="@Fingerprint.Tag("/Scripts/plugin/filesaver/jquery.fileDownload.js")"></script>
  <script type="text/javascript">
    //绑定按钮事件
    $('button[name="searchbutton"]').on('click', reloadData);
    $('button[name="appendbutton"]').on('click', appendData);
    $('button[name="deleterowbutton"]').on('click', deleteRow);
    $('button[name="exportexcelbutton"]').on('click', exportExcel);
    $('button[name="importexcelbutton"]').on('click', () => {
      importExcel('Quotation')
    });
    $('button[name="downloadtemplatebutton"]').on('click', () => {
      downloadTemplate('Quotation')
    });
    //全屏事件
    document.addEventListener('panel.onfullscreen', () => {
         $dg.datagrid('resize');
     });
      //是否强制从后台取值
      const REQUIRBACKEND = false;
      //是否开启行内编辑
      const EDITINLINE = false;
      var quotation = {};

       //执行导出下载Excel
       function exportExcel() {
                const filterRules = JSON.stringify($dg.datagrid('options').filterRules);
                //console.log(filterRules);
                const dialog = bootbox.dialog({
                    message: '<div class="text-center"><i class="fal fa-spinner fa-pulse fa-lg mr-1"></i> 正在执行...</div>',
                    closeButton: false
                 });
                let formData = new FormData();
                formData.append('filterRules', filterRules);
                formData.append('sort', 'Id');
                formData.append('order', 'asc');
                $.postDownload('/Quotations/ExportExcel', formData).then(res => {
                    setTimeout(() => {
                       dialog.modal('hide')
                     }, 300);
                    toastr.success('导出成功!');
                }).catch(err => {
                    setTimeout(() => {
                       dialog.modal('hide')
                     }, 300);
                    $.messager.alert('导出失败', err.statusText, 'error');
                });

        }
        //显示帮助信息
        function dohelp() {
            toastr.info('有问题请联系管理员 <br><i class="fa fa-envelope-o" aria-hidden="true"></i> : demo@admin.com','帮助');
        }
       var editIndex = undefined;
       //重新加载数据
       function reloadData() {
            $dg.datagrid('unselectAll');
            $dg.datagrid('uncheckAll');
            $dg.datagrid('reload');
       }
    //新增记录
    async function appendData() {
      quotation = {
        FormName:'新报价单格式',
        Status:'草拟',
        Country: '中国',
QuoteDate: moment().format('YYYY-MM-DD HH:mm:ss'),
ExpiryDate: moment().format('YYYY-MM-DD HH:mm:ss'),
         Cur: null,
         Salesman: $.getusername(),
Initiator: $.getusername(),
SubmitDate: null,
         ApprovedDate: null,
         CompanyId: 1,
  CustomerId:null
 };
        //需要后台创建对象
       if (REQUIRBACKEND) {
         quotation = await $.get('/Quotations/NewItem');
       }
           //弹出新增窗口
           openquotationdetailwindow(quotation, 'Added');
    }
    //删除编辑的行
    function deleteRow() {
    deleteChecked();
    }
    //删除选中的行
    function deleteChecked() {
        const checked = $dg.datagrid('getChecked').filter(item=>item.Id!=null && item.Id > 0).map(item => {
                   return item.Id;
                });;
        if (checked.length > 0) {
              deleteRows(checked);
         } else {
                $.messager.alert('提示', '请先选择要删除的记录!','question');
         }
     }
    //执行删除
    function deleteRows(selected){
      $.messager.confirm('确认', `你确定要删除这 <span class='badge badge-icon position-relative'>${selected.length} </span> 行记录?`, result => {
       if (result) {
         $.post('/Quotations/DeleteChecked', { id: selected })
                         .done(response => {
                                if (response.success) {
                                    toastr.error(`成功删除 [${selected.length}] 行记录`);
                                    reloadData();
                                } else {
                                    $.messager.alert('错误', response.err,'error');
                                }
                          })
                          .fail((jqXHR, textStatus, errorThrown) => {
                             $.messager.alert('异常', `${jqXHR.status}: ${jqXHR.statusText} `, 'error');
                          });
        }
      });
    }
    //弹出明细信息
    async function showdetailsWindow(id,index) {
        const quotation = $dg.datagrid('getRows')[index];
        if (REQUIRBACKEND) {
           quotation = await $.get('/Quotations/GetItem/' + id);
        }
        openquotationdetailwindow(quotation,'Modified');
    }

    //初始化定义datagrid
    var $dg = $('#quotations_datagrid');
  $(() => {
    //定义datagrid结构
    $dg.datagrid({
      //fit: false,
      //height: window.innerHeight - 385,
      rownumbers: true,
      checkOnSelect: false,
      selectOnCheck: false,
      idField: 'Id',
      sortName: 'Id',
      sortOrder: 'desc',
      remoteFilter: true,
      singleSelect: true,
      //url: '/Quotations/GetData',
      method: 'get',
      pagination: true,
      clientPaging: false,
      striped: true,
      pageList: [10, 20, 50, 100, 500, 2000],
      filterRules: [],
      onHeaderContextMenu: function (e, field) {
        e.preventDefault();
        $(this).datagrid('columnMenu').menu('show', {
          left: e.pageX,
          top: e.pageY
        });
      },
      onBeforeLoad: function () {
        $('.enable-loader').removeClass('enable-loader')
      },
      onLoadSuccess: function (data) {
        $("button[name*='deleterowbutton']").prop('disabled', true);
      },
      onCheck: function () {
        $("button[name*='deleterowbutton']").prop('disabled', false);
      },
      onUncheck: function () {
        const checked = $(this).datagrid('getChecked').length > 0;
        $("button[name*='deleterowbutton']").prop('disabled', !checked);
      },
      onCheckAll: function (rows) {
        if (rows.length > 0) {
          $("button[name*='deleterowbutton']").prop('disabled', false);
        }
      },
      onUncheckAll: function () {
        $("button[name*='deleterowbutton']").prop('disabled', true);
      },
      onSelect: function (index, row) {
        quotation = row;
      },
      frozenColumns: [[
        /*开启CheckBox选择功能*/
        { field: 'ck', checkbox: true },
        {
          field: 'action',
          title: '@Html.L("Command")',
          align: 'center',
          width: 85,
          sortable: false,
          resizable: true,
          formatter: function showdetailsformatter(value, row, index) {
            if (!row.editing) {
              return `<div class="btn-group">\
                                                         <button onclick="showdetailsWindow('${row.Id}',  ${index})" class="btn btn-outline-info btn-sm btn-icon waves-effect waves-themed" data-toggle="tooltip" data-placement="right" title="@Html.L("EditDetail")" ><i class="fal fa-edit"></i> </button>\
                                                         <button onclick="deleteRows(['${row.Id}'],${index})" class="btn btn-outline-info btn-sm btn-icon waves-effect waves-themed" data-toggle="tooltip" data-placement="right" title="@Html.L("Delete")" ><i class="fal fa-trash-alt"></i> </button>\
                                                    </div>`;
            } else {
              return `<button class="btn btn-outline-info btn-sm btn-icon waves-effect waves-themed" disabled title="查看明细"  ><i class="fal fa-edit"></i> </button>`;
            }
          }
        }
      ]],
      columns: [[

        {    /*报价单号*/
          field: 'QpNo',
          title: '@Html.DisplayNameFor(model => model.QpNo)',
          width: 120,
          hidden: false,
          sortable: true,
          resizable: true
        },
        {    /*业务员*/
          field: 'Salesman',
          title: '@Html.DisplayNameFor(model => model.Salesman)',
          width: 120,
          hidden: false,
          sortable: true,
          resizable: true
        },
        {   /*公司*/
          field: 'CompanyId',
          title: '@Html.DisplayNameFor(model => model.CompanyId)',
          width: 160,
          sortable: true,
          resizable: true,
          hidden: false,
          formatter: (value, row) => {
            return row.CompanyName;
          },
        },

        {   /*客户*/
          field: 'CustomerId',
          title: '@Html.DisplayNameFor(model => model.CustomerId)',
          width: 160,
          sortable: true,
          resizable: true,
          hidden: false,
          formatter: (value, row) => {
            return row.CustomerName;
          },
        },

        {    /*国家地区*/
          field: 'Country',
          title: '@Html.DisplayNameFor(model => model.Country)',
          width: 200,
          hidden: false,
          sortable: true,
          resizable: true
        },
        {    /*联系人*/
          field: 'ContactName',
          title: '@Html.DisplayNameFor(model => model.ContactName)',
          width: 200,
          hidden: false,
          sortable: true,
          resizable: true
        },
        {    /*联系方式*/
          field: 'ContactInfo',
          title: '@Html.DisplayNameFor(model => model.ContactInfo)',
          width: 260,
          hidden: false,
          sortable: true,
          resizable: true
        },
        {   /*报价日期*/
          field: 'QuoteDate',
          title: '@Html.DisplayNameFor(model => model.QuoteDate)',
          width: 100,
          align: 'right',
          hidden: false,
          formatter: dateformatter,
          sortable: true,
          resizable: true
        },
        {   /*有效日期*/
          field: 'ExpiryDate',
          title: '@Html.DisplayNameFor(model => model.ExpiryDate)',
          width: 100,
          align: 'right',
          hidden: false,
          formatter: dateformatter,
          sortable: true,
          resizable: true
        },
        {    /*装货港*/
          field: 'LoadingPort',
          title: '@Html.DisplayNameFor(model => model.LoadingPort)',
          width: 260,
          hidden: false,
          sortable: true,
          resizable: true
        },
        {    /*卸货港*/
          field: 'DischargePort',
          title: '@Html.DisplayNameFor(model => model.DischargePort)',
          width: 260,
          hidden: false,
          sortable: true,
          resizable: true
        },
        {    /*币种*/
          field: 'Cur',
          title: '@Html.DisplayNameFor(model => model.Cur)',
          width: 120,
          hidden: false,
          sortable: true,
          resizable: true
        },
        {    /*汇率*/
          field: 'ExchangeRate',
          title: '@Html.DisplayNameFor(model => model.ExchangeRate)',
          width: 100,
          align: 'right',
          hidden: false,
          formatter: numberformatter,
          sortable: true,
          resizable: true
        },
        {    /*价格条款*/
          field: 'PriceTerm',
          title: '@Html.DisplayNameFor(model => model.PriceTerm)',
          width: 120,
          hidden: false,
          sortable: true,
          resizable: true
        },
        {    /*付款条件*/
          field: 'PayMode',
          title: '@Html.DisplayNameFor(model => model.PayMode)',
          width: 260,
          hidden: false,
          sortable: true,
          resizable: true
        },
        {    /*货值金额*/
          field: 'GoodsAmount',
          title: '@Html.DisplayNameFor(model => model.GoodsAmount)',
          width: 100,
          align: 'right',
          hidden: false,
          formatter: numberformatter,
          sortable: true,
          resizable: true
        },
        {    /*附加费*/
          field: 'ChargeAmount',
          title: '@Html.DisplayNameFor(model => model.ChargeAmount)',
          width: 100,
          align: 'right',
          hidden: false,
          formatter: numberformatter,
          sortable: true,
          resizable: true
        },
        {    /*总费用*/
          field: 'TotalAmount',
          title: '@Html.DisplayNameFor(model => model.TotalAmount)',
          width: 100,
          align: 'right',
          hidden: false,
          formatter: numberformatter,
          sortable: true,
          resizable: true
        },
        {    /*报价单格式*/
          field: 'FormName',
          title: '@Html.DisplayNameFor(model => model.FormName)',
          width: 120,
          hidden: false,
          sortable: true,
          resizable: true
        },
        {    /*备注*/
          field: 'Remark',
          title: '@Html.DisplayNameFor(model => model.Remark)',
          width: 260,
          hidden: false,
          sortable: true,
          resizable: true
        },



      ]]
    }).datagrid('columnMoving')
      .datagrid('resetColumns')
      .datagrid('enableFilter', [
        {   /*汇率*/
          field: 'ExchangeRate',
          type: 'numberbox',
          op: ['equal', 'notequal', 'less', 'lessorequal', 'greater', 'greaterorequal']
        },
        {   /*货值金额*/
          field: 'GoodsAmount',
          type: 'numberbox',
          op: ['equal', 'notequal', 'less', 'lessorequal', 'greater', 'greaterorequal']
        },
        {   /*附加费*/
          field: 'ChargeAmount',
          type: 'numberbox',
          op: ['equal', 'notequal', 'less', 'lessorequal', 'greater', 'greaterorequal']
        },
        {   /*总费用*/
          field: 'TotalAmount',
          type: 'numberbox',
          op: ['equal', 'notequal', 'less', 'lessorequal', 'greater', 'greaterorequal']
        },
        {   /*系统版本号*/
          field: 'Ver',
          type: 'numberbox',
          op: ['equal', 'notequal', 'less', 'lessorequal', 'greater', 'greaterorequal']
        },
        {     /*报价日期*/
          field: 'QuoteDate',
          type: 'dateRange',
          options: {
          }
        },
        {     /*有效日期*/
          field: 'ExpiryDate',
          type: 'dateRange',
          options: {
          }
        },
        {     /*提交时间*/
          field: 'SubmitDate',
          type: 'dateRange',
          options: {
          }
        },
        {     /*审批时间*/
          field: 'ApprovedDate',
          type: 'dateRange',
          options: {
          }
        },
        {   /*公司*/
          field: 'CompanyId',
          type: 'combobox',
          options: {
            panelHeight: 'auto',
            valueField: 'Id',
            textField: 'Name',
            method: 'get',
            url: '/Quotations/GetCompanies',
            onChange: value => {
              if (value === '' || value === null) {
                $dg.datagrid('removeFilterRule', 'CompanyId');
              } else {
                $dg.datagrid('addFilterRule', {
                  field: 'CompanyId',
                  op: 'equal',
                  value: value
                });
              }
              $dg.datagrid('doFilter');
            }
          }
        },
        {   /*客户*/
          field: 'CustomerId',
          type: 'combobox',
          options: {
            panelHeight: 'auto',
            valueField: 'Id',
            textField: 'CustomerCode',
            method: 'get',
            url: '/Quotations/GetCustomers',
            onChange: value => {
              if (value === '' || value === null) {
                $dg.datagrid('removeFilterRule', 'CustomerId');
              } else {
                $dg.datagrid('addFilterRule', {
                  field: 'CustomerId',
                  op: 'equal',
                  value: value
                });
              }
              $dg.datagrid('doFilter');
            }
          }
        },
      ])
      .datagrid('load', '/Quotations/GetData');

  });

  </script>


  @{ Html.RenderPartial("_ImportWindow", new { model = "Quotation", url = "/Quotations/ImportData", callback = "reloadData()", autosave = false }); }
  @{ Html.RenderPartial("_PopupDetailFormView", new WebApp.Models.Quotation()); }
  <!-- quotationfile datagrid  javascript block -->
  @Html.Partial("_quotationfiledatagridjsview", new WebApp.Models.QuotationFile())
  <!-- quotationproduct datagrid  javascript block -->
  @Html.Partial("_quotationproductdatagridjsview", new WebApp.Models.QuotationProduct())

  @Html.Partial("_SelectProductWindow")
  <!--end popup detailview javascript block -->
}


