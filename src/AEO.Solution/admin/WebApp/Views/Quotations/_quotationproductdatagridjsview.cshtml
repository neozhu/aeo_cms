@model WebApp.Models.QuotationProduct
<script type="text/javascript">
  //全屏事件
  document.addEventListener('panel.onfullscreen', () => {
       $quotationproductdg.datagrid('resize');
   });
    //是否开启行内编辑
    var SUBEDITINLINE = true;
   //初始化 QuotationProduct datagrid
   var $quotationproductdg = $('#quotationproduct_datagrid');
   //当前行记录
   var quotationproduct = {};
   //datagrid CRUD method
    var quotationproduct_editIndex = undefined;
    //取消编辑恢复状态
    function quotationproduct_rejectChanges() {
		$quotationproductdg.datagrid('rejectChanges');
		quotationproduct_editIndex = undefined;
    }
    //重新加载数据
    function quotationproduct_reloadData() {
			$quotationproductdg.datagrid('unselectAll');
            $quotationproductdg.datagrid('uncheckAll');
	        $quotationproductdg.datagrid('reload');
	}
    //关闭编辑状态
	function quotationproduct_endEditing() {
			if (quotationproduct_editIndex === undefined) {
                return true; 
            }
			if ($quotationproductdg.datagrid('validateRow', quotationproduct_editIndex)) {
				$quotationproductdg.datagrid('endEdit', quotationproduct_editIndex);
				quotationproduct_editIndex = undefined;
                return true;
			} else {
				const invalidinput = $('input.validatebox-invalid',$quotationproductdg.datagrid('getPanel'));
                const fieldnames = invalidinput.map((index, item) => {
                  return $(item).attr('placeholder') || $(item).attr('id');
                });
                $.messager.alert('提示', `${Array.from(fieldnames)} 输入有误.`, 'error');
				return false;
			}
		}
    //单击列开启编辑功能
	function quotationproduct_onClickCell(index, field) {
			const _operates = ['_operate1', 'ck'];
             $('button[name*=\'quotationproductdeleterowbutton\']').prop('disabled', false);
			if (!SUBEDITINLINE || $.inArray(field, _operates) >= 0) {
				return false;
			}
			if (quotationproduct_editIndex !== index) {
				if (quotationproduct_endEditing()) {
					$quotationproductdg.datagrid('selectRow', index)
							.datagrid('beginEdit', index);
                    //quotationproduct_editIndex = index;
					var ed = $quotationproductdg.datagrid('getEditor', { index: index, field: field });
					if (ed) {
						($(ed.target).data('textbox') ? $(ed.target).textbox('textbox') : $(ed.target)).focus();
					}
				} else {
					$quotationproductdg.datagrid('selectRow', quotationproduct_editIndex);
				}
			}
		}
    //双击弹出编辑当前行对话框
    function quotationproduct_onDblClickRow(index, row) {
        if (!SUBEDITINLINE) {
            open_quotationproductdlg(index, row, 'Modified');
        }
    }
    //订阅对话框新增返回事件
    $(document).on('quotationproduct_form.add', (e, index,item) => {
        $quotationproductdg.datagrid("insertRow",
            {
                index: 0,
                row: item
            });
        $("button[name*='quotationproduct_cancelchangesbutton']").prop('disabled', false);
        $("button[name*='quotationproduct_savechangesbutton']").prop('disabled', false);
    });
    //订阅对话框修改返回事件
    $(document).on('quotationproduct_form.edit', (e,index, item) => {
        $quotationproductdg.datagrid('updateRow', {
            index: index,
            row: item
        });
        $("button[name*='quotationproduct_cancelchangesbutton']").prop('disabled', false);
        $("button[name*='quotationproduct_savechangesbutton']").prop('disabled', false);
    });
    //新增记录
    function quotationproduct_appendItem() {
       const $quotationform = $('#quotation_form');
       if ($quotationform.form('enableValidation').form('validate')) {
          const quotation = $quotationform.serializeJSON();
       const item = {
          Price: null, 
Cur: null, 

          QuotationId:quotation.Id
        };
      if (!SUBEDITINLINE) {
        open_quotationproductdlg(0, item, 'Added');
      } else {
			if (quotationproduct_endEditing()) {
				//对必填字段进行默认值初始化
				$quotationproductdg.datagrid('insertRow', 
                               { index: 0,
                                  row: item 
                               });
				quotationproduct_editIndex = 0;
				$quotationproductdg.datagrid('selectRow', quotationproduct_editIndex)
						.datagrid('beginEdit', quotationproduct_editIndex);
			}
        }
        }
	 }
    //删除编辑的行
	function quotationproduct_removeItem() {
		if (quotationproduct_editIndex !== undefined) {  
            const delindex = quotationproduct_editIndex;
			$quotationproductdg.datagrid('cancelEdit', delindex)
					           .datagrid('deleteRow', delindex);
            $("button[name*='quotationproduct_cancelchangesbutton']").prop('disabled', false);
            $("button[name*='quotationproduct_savechangesbutton']").prop('disabled', false);
        } else {
           const rows = $quotationproductdg.datagrid('getChecked');
           rows.slice().reverse().forEach(row => {
                const rowindex = $quotationproductdg.datagrid('getRowIndex', row);
                $quotationproductdg.datagrid('deleteRow', rowindex);
                $("button[name*='quotationproduct_cancelchangesbutton']").prop('disabled', false);
                $("button[name*='quotationproduct_savechangesbutton']").prop('disabled', false);
            });
        }
	}
    //删除选中的行
    function quotationproduct_deleteChecked() {
            const rows = $quotationproductdg.datagrid('getChecked');
            if (rows.length > 0) {
                var id = rows.filter(item=>item.Id!=null).map(item => {
                    return item.Id;
                });
                $.messager.confirm('确认', `你确定要删除这 <span class='badge bg-color-red'>${id.length}</span> 行记录?`,result => {
                    if (result) {
                        $.post('/QuotationProducts/DeleteChecked', { id: id })
                         .done(response => {
                            if (response.success) {
                                $quotationproductdg.datagrid('reload');
                            } else {
                                $.messager.alert('错误', response.err,'error');
                            }
                         });
                    }
                });  
            } else {
                $.messager.alert('提示', '请先选择要删除的记录!','question');
            }
      }
  //获取修改的行
  function quotationproduct_getChanges() {
    if (quotationproduct_endEditing()) {
      if ($quotationproductdg.datagrid('getChanges').length > 0) {
        const inserted = $quotationproductdg.datagrid('getChanges', 'inserted').map(item => {
          item.TrackingState = 1;
          return item;
        });
        const deleted = $quotationproductdg.datagrid('getChanges', 'deleted').map(item => {
          item.TrackingState = 3;
          return item;
        });
        const updated = $quotationproductdg.datagrid('getChanges', 'updated').map(item => {
          item.TrackingState = 2;
          return item;
        });
        //过滤已删除的重复项
        const changed = inserted.concat(updated.filter(item => {
          return !deleted.includes(item);
        })).concat(deleted);
        return { success: true, changed };
      } else {
        return { success: true, changed:undefined};
      }
    } else {
      return { success: false,changed:undefined };
    }
  }
  //提交修改的数据
  //function quotationproduct_acceptChanges() {
  //  $quotationproductdg.datagrid('acceptChanges');
  //}
  //提交保存后台数据库
  async function quotationproduct_acceptChanges() {
			if (quotationproduct_endEditing()) {
				if ($quotationproductdg.datagrid('getChanges').length > 0) {
					const inserted = $quotationproductdg.datagrid('getChanges', 'inserted').map(item => {
                       item.TrackingState = 1;
                       return item;
                    });
					const deleted = $quotationproductdg.datagrid('getChanges', 'deleted').map(item => {
                       item.TrackingState = 3;
                       return item;
                    });
					const updated = $quotationproductdg.datagrid('getChanges', 'updated').map(item => {
                       item.TrackingState = 2;
                       return item;
                    });
					//过滤已删除的重复项
                    const changed = inserted.concat(updated.filter(item => {
                           return !deleted.includes(item);
                         })).concat(deleted);
                   //console.table(changed);
				  if (MODELSTATE === 'Added') {
                    return { success:true, changed };
                  } else {
                    const response = await $.post('/QuotationProducts/AcceptChanges', {quotationproducts:changed});
                    response.changed = undefined;
    				if (response.success) {
							toastr.success('保存明细成功'); 
							$quotationproductdg.datagrid('acceptChanges');
							quotationproduct_reloadData()
                            return { success:true}; 
				    } else {
                           $.messager.alert('错误', response.err ,'error');
                           return { success:false, err:response.err };
                    }
                   }
				} else {
                  return { success: true, changed: undefined};
                }
			} else {
               return { success: false };
            }
      }


