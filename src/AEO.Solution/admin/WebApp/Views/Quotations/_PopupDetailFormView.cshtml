    //判断新增编辑状态
    var MODELSTATE = 'Added';
    var quotationid = null;
  function openquotationdetailwindow(data, state) {
    MODELSTATE = state;
    //判断是否显示功能按钮
    if (MODELSTATE === 'Added') {
      $('#deleteitem-btn-group').hide();
    } else {
      $('#deleteitem-btn-group').show();
    }
    initquotationdetailview();
    quotationid = (data.Id || 0);
    $('#quotationdetailwindow').window('open');
    $('#quotation_form').form('reset');
    $('#quotation_form').form('load', data);
    var url = '/QuotationFiles/GetDataByQuotationId?quotationid=' + quotationid;
    $quotationfiledg.datagrid('load', url);
    $quotationfiledg.datagrid('resize');
    url = '/QuotationProducts/GetDataByQuotationId?quotationid=' + quotationid;
    $quotationproductdg.datagrid('load', url);
    $quotationproductdg.datagrid('resize');
    url = '/QuotationCharges/GetDataByQuotationId?quotationid=' + quotationid;
    $chargedg.datagrid('load', url);
    $chargedg.datagrid('resize');
  }
  //删除当前记录
  function deletequotationitem() {
    $.messager.confirm('确认', '你确定要删除该记录?', result => {
      if (result) {
        const url = `/Quotations/Delete/${quotationid}`;
        $.get(url).done(res => {
          if (res.success) {
            toastr.success("删除成功");
            $('#quotationdetailwindow').window('close');
            reloadData();
          } else {
            $.messager.alert('错误', res.err, 'error');
          }
        });
      }
    });
  }
    //async 保存数据
    async function savequotationitem() { 
      const $quotationform = $('#quotation_form');
      if ($quotationform.form('enableValidation').form('validate')) {
            let quotation = $quotationform.serializeJSON();
				  //获取明细表数据
 
                      const quotationfile_result = await quotationfile_acceptChanges();
                      if (!quotationfile_result.success) {
                         return false;
                      } else {
                         quotation.QuotationFiles = quotationfile_result.changed;
                      }
                      
 
                      const quotationproduct_result = await quotationproduct_acceptChanges();
                      if (!quotationproduct_result.success) {
                         return false;
                      } else {
                         quotation.QuotationProducts = quotationproduct_result.changed;
                      }
                      
            let url = '/Quotations/Edit';
            //判断是新增或是修改方法
        if (MODELSTATE === 'Added') {
          url = '/Quotations/Create';
          quotation.QuotationCharges = charges_getChanges();
        } else {
          charges_acceptChanges();
        }
            var token = $('input[name="__RequestVerificationToken"]', $quotationform).val();
            $.ajax({
                    type: "POST",
                    url: url,
                    data: {
                        __RequestVerificationToken: token,
                        quotation:quotation
                    },
                    dataType: 'json',
                    contentType: 'application/x-www-form-urlencoded; charset=utf-8'
                })
                .done(response => {
                    if (response.success) {
                        hook = false;
                        $quotationform.form('disableValidation');
                        $('#quotationdetailwindow').window("close");
                        toastr.success("保存成功"); 
                        reloadData();
                    } else {
                        $.messager.alert("错误",   response.err, "error");
                    }
                    })
                .fail((jqXHR, textStatus, errorThrown) => {
                       $.messager.alert('异常', `${jqXHR.status}: ${jqXHR.statusText} `, 'error');
                    });
        }
    }
     //判断是否有没有保存的记录
     function quotationhasmodified() {
      if(!hook) {
            if (!quotationfile_endEditing()) {
                 return true;
             }
            const quotationfiles = $quotationfiledg.datagrid("getChanges");
            if (MODELSTATE == 'Modified' && quotationfiles.length > 0) {
                return true;
            }
            if (!quotationproduct_endEditing()) {
                 return true;
             }
            const quotationproducts = $quotationproductdg.datagrid("getChanges");
            if (MODELSTATE == 'Modified' && quotationproducts.length > 0) {
                return true;
            }
            return false;
         } else {
            return hook;
         }

     }


