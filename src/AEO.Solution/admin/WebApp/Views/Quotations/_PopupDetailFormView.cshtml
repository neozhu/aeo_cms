<script>
  var $chargedg = $('#quotationcharges_datagrid');
  var charges_editIndex = undefined;
  function append_charges() {
    quotationcharge = {
      QuotationId: $('#quotation_form #Id').val()
    };
    if (charges_endEditing()) {
      //对必填字段进行默认值初始化
      $chargedg.datagrid('insertRow',
        {
          index: 0,
          row: quotationcharge
        });
      charges_editIndex = 0;
      $chargedg.datagrid('selectRow', charges_editIndex)
        .datagrid('beginEdit', charges_editIndex);

    }
  }
  function charges_endEditing() {
    if (charges_editIndex === undefined) {
      return true;
    }
    if ($chargedg.datagrid('validateRow', charges_editIndex)) {
      $chargedg.datagrid('endEdit', charges_editIndex);
      return true;
    } else {
      const invalidinput = $('input.validatebox-invalid', $chargedg.datagrid('getPanel'));
      const fieldnames = invalidinput.map((index, item) => {
        return $(item).attr('placeholder') || $(item).attr('id');
      });
      $.messager.alert('提示', `${Array.from(fieldnames)} 输入有误.`, 'error');
      return false;
    }
  }
  function charges_deleteRows(id, index) {
    if (index == charges_editIndex) {
      $chargedg.datagrid('cancelEdit', index)
        .datagrid('deleteRow', index);
      charges_editIndex = undefined;
    } else {
      $chargedg.datagrid('deleteRow', index);
    }
    $('button[name*="saveitembutton"]').prop('disabled', false);
  }
  function charges_onClickCell(index,field) {
    if (charges_editIndex !== index) {
      if (charges_endEditing()) {
        $chargedg.datagrid('selectRow', index)
          .datagrid('beginEdit', index);
        charges_editIndex = index;

      } else {
        $chargedg.datagrid('selectRow', charges_editIndex);
      }
    } else {
      $chargedg.datagrid('selectRow', index)
        .datagrid('beginEdit', index);
    }
  }
  function totalamount() {
    const data = $chargedg.datagrid('getRows');
    let total = 0;
    data.map(item => {
      total += parseFloat(item.Amount);
    })
    console.log(total);
    const goodsamount = parseFloat( $('#quotation_form #GoodsAmount').numberbox('getValue'));
    $('#quotation_form #ChargeAmount').numberbox('setValue', total)
    $('#quotation_form #TotalAmount').numberbox('setValue', total + goodsamount)
  }

  function charges_getChanges() {
    if (charges_endEditing()) {
      const inserted = $chargedg.datagrid('getChanges', 'inserted').map(item => {
        item.TrackingState = 1;
        return item;
      });
      return inserted;
    }
  }
  function charges_acceptChanges() {
    if (charges_endEditing()) {
      if ($chargedg.datagrid('getChanges').length > 0) {
        const inserted = $chargedg.datagrid('getChanges', 'inserted').map(item => {
          item.TrackingState = 1;
          return item;
        });
        const updated = $chargedg.datagrid('getChanges', 'updated').map(item => {
          item.TrackingState = 2
          return item;
        });
        const deleted = $chargedg.datagrid('getChanges', 'deleted').map(item => {
          item.TrackingState = 3
          return item;
        });
        //过滤已删除的重复项
        const changed = inserted.concat(updated.filter(item => {
          return !deleted.includes(item);
        })).concat(deleted);
        //console.table(changed);
        $.post('/QuotationCharges/AcceptChanges', { quotationcharges: changed })
          .done(response => {
            //console.log(response);
            if (response.success) {
             
            } else {
              $.messager.alert('错误', response.err, 'error');
            }
          })
          .fail((jqXHR, textStatus, errorThrown) => {
            $.messager.alert('异常', `${jqXHR.status}: ${jqXHR.statusText} `, 'error');
          });
      }
    }
  }
  $chargedg.datagrid({
    //fit: false,
    //height: window.innerHeight - 385,
    rownumbers: true,
    checkOnSelect: false,
    selectOnCheck: false,
    idField: 'Id',
    sortName: 'Id',
    sortOrder: 'desc',
    remoteFilter: true,
    singleSelect: true,
    onClickCell: charges_onClickCell,
    method: 'get',
    pagination: true,
    clientPaging: false,
    striped: true,
    pageSize:20,
    pageList: [20, 50, 100, 500, 2000],
    onBeginEdit: function (index, row) {
      //const editors = $(this).datagrid('getEditors', index);
      const editor = $(this).datagrid('getEditor', { index: index, field: 'Amount' });
       
      $(editor.target).numberbox('textbox').bind('change', function (e) {
        var amount = parseFloat($(e.target).val());
        row.Amount = amount;
        totalamount();
      });
    

    },
    onBeforeEdit: function (index, row) {
      console.log('onBeforeEdit')
    },
    columns: [[

      {    /*费用名称(中文)*/
        field: 'Name',
        title: '费用名称(中文)',
        width: 260,
        hidden: false,
        editor: {
          type: 'textbox',
          options: {
            id: 'editor_Name',
            prompt: '费用名称(中文)费用名称(中文)',
            required: true,
            validType: 'length[0,128]'
          }
        },
        sortable: true,
        resizable: true
      },
      {    /*费用名称(英文)*/
        field: 'EName',
        title: '费用名称(英文)',
        width: 260,
        hidden: false,
        editor: {
          type: 'textbox',
          options: {
            id: 'editor_EName',
            prompt: '费用名称(英文)',
            required: false,
            validType: 'length[0,128]'
          }
        },
        sortable: true,
        resizable: true
      },
      {    /*金额*/
        field: 'Amount',
        title: '金额金额',
        width: 100,
        align: 'right',
        hidden: false,
        editor: {
          type: 'numberbox',
          options: {
            id: 'editor_Amount',
            prompt: '金额金额',
            required: true,
            precision: 2,
          }
        },
        formatter: numberformatter,
        sortable: true,
        resizable: true
      },
      {
        field: 'action',
        title: '@Html.L("Command")',
        align: 'center',
        width: 85,
        sortable: false,
        resizable: true,
        formatter: function showdetailsformatter(value, row, index) {
            return `<div class="btn-group">\
                      <button name="cmdbutton" onclick="charges_deleteRows(['${row.Id}'],${index})" class="btn btn-danger btn-sm btn-icon waves-effect waves-themed" data-toggle="tooltip" data-placement="right" title="@Html.L("Delete")" ><i class="fal fa-times"></i> </button>\
                    </div>`;

        }
      }
    ]]
  })

</script>

