﻿@model WebApp.Models.Quotation
<!-- 弹出编辑窗体表单 -->
 <div id="quotationdetailwindow" class="easyui-window" 
      title="编辑报价单" 
      data-options="modal:true,
                    closed:true,
                    minimizable:false,
                    collapsible:false,
                    maximized:true,
                    iconCls:'fal fa-window',
                    onBeforeClose:function(){
                      var that = $(this);
                      if(quotationhasmodified()){
                        $.messager.confirm('确认','你确定要放弃保存修改的记录?',function(r){
                        if (r){
                          var opts = that.panel('options');
                          var onBeforeClose = opts.onBeforeClose;
                          opts.onBeforeClose = function(){};
                          that.panel('close');
                          opts.onBeforeClose = onBeforeClose;
                          hook = false;
                        }
                        });
                        return false;
                      }
                    },
                    onOpen:function(){
                       $(this).window('vcenter');
                       $(this).window('hcenter');
                    },
                    onRestore:function(){
                      $quotationfiledg.datagrid('resize');
                      $quotationproductdg.datagrid('resize');
                    },
                    onMaximize:function(){
                      $quotationfiledg.datagrid('resize');
                      $quotationproductdg.datagrid('resize');
                    }
                    " style="width:800px;height:450px;display:none">
  <!-- toolbar -->
  <div class="panel-content py-2 rounded-bottom border-faded border-left-0 border-right-0  text-muted bg-subtlelight-fade sticky-top">
  <div class="d-flex justify-content-end pr-4">
        <div class="btn-group btn-group-sm mr-1">
          <button name="saveitembutton"   class="btn btn-default">
            <i class="fal fa-save"></i> @Html.L("Save")
          </button>
        </div>
        <div class="btn-group btn-group-sm mr-1" id="deleteitem-btn-group">
          <button  name="deleteitembutton" class="btn btn-danger">
            <i class="fal fa-trash-alt"></i> @Html.L("Delete")
          </button>
        </div>
    </div>
  </div>
 <!-- panel container form  -->
 <div class="panel-container show">
   <div class="container">
    <div class="panel-content">
           
      <ul class="nav nav-tabs nav-tabs-clean" role="tablist">
        <li class="nav-item">
          <a class="nav-link active"
             data-toggle="tab"
             data-model="quotation"
             href="#tab-quotation"
             role="tab">报价单</a>
        </li>
        <li class="nav-item">
          <a class="nav-link "
             data-toggle="tab"
             data-model="quotationproduct"
             href="#tab-quotationproduct"
             role="tab">产品信息</a>
        </li>
        <li class="nav-item">
          <a class="nav-link"
             data-toggle="tab"
             data-model="quotationfile"
             href="#tab-quotationfile"
             role="tab">附件信息</a>
        </li>

      </ul>
 <div class="tab-content p-0">
   <div class="tab-pane fade show active"
        id="tab-quotation"
        data-model="quotation"
        role="tabpanel"
        aria-labelledby="tab-quotation">
     <div class="d-flex justify-content-start flex-wrap p-2">
       <form id="quotation_form"
             class="easyui-form form-horizontal padding-10"
             method="post"
             data-options="novalidate:true,
                            onChange: function(target){
                              hook = true;
                              $('button[name*=\'saveitembutton\']').prop('disabled', false);
                             },
                             onLoadSuccess:function(data){
                               hook = false;
                               $('button[name*=\'saveitembutton\']').prop('disabled', true);
                             }">
         @Html.AntiForgeryToken()
         <!--Primary Key-->
         @Html.HiddenFor(model => model.Id)
         @Html.HiddenFor(model => model.CompanyCode)
         @Html.HiddenFor(model => model.CompanyName)
         @Html.HiddenFor(model => model.CustomerCode)
         @Html.HiddenFor(model => model.CustomerName)
         <fieldset class="form-group">
           <div class="row h-100 align-items-center">

             <!--报价单号-->
             <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"> @Html.DisplayNameFor(model => model.QpNo)</label>
             <div class="col-md-4 mb-1 pl-1">
               <input id="@Html.IdFor(model => model.QpNo)"
                      name="@Html.NameFor(model => model.QpNo)"
                      value="@Html.ValueFor(model => model.QpNo)"
                      tabindex="0"
                      class="easyui-textbox"
                      style="width:100%"
                      type="text"
                      data-options="prompt:'@Html.DescriptionFor(model => model.QpNo)',
								 required:false,
                                 validType: 'length[0,20]'
                                 " />
             </div>
             <!--报价单格式-->
             <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"> @Html.DisplayNameFor(model => model.FormName)</label>
             <div class="col-md-4 mb-1 pl-1">
               <input id="@Html.IdFor(model => model.FormName)"
                      name="@Html.NameFor(model => model.FormName)"
                      value="@Html.ValueFor(model => model.FormName)"
                      tabindex="22"
                      class="easyui-combobox"
                      style="width:100%"
                      type="text"
                      data-options="prompt:'@Html.DescriptionFor(model => model.FormName)',
								 required:false,data:qformdatasource,panelHeight:'auto',
                                 validType: 'length[0,20]'
                                 " />
             </div>
             <!--状态-->
             <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"> @Html.DisplayNameFor(model => model.Status)</label>
             <div class="col-md-4 mb-1 pl-1">
               <input id="@Html.IdFor(model => model.Status)"
                      name="@Html.NameFor(model => model.Status)"
                      value="@Html.ValueFor(model => model.Status)"
                      tabindex="22"
                      class="easyui-textbox"
                      style="width:100%"
                      type="text"
                      data-options="prompt:'@Html.DescriptionFor(model => model.Status)',
								 required:false,readonly:true,
                                 validType: 'length[0,20]'
                                 " />
             </div>
             <!--业务员-->
             <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"><span class="text-danger">*</span> @Html.DisplayNameFor(model => model.Salesman)</label>
             <div class="col-md-4 mb-1 pl-1">
               <input id="@Html.IdFor(model => model.Salesman)"
                      name="@Html.NameFor(model => model.Salesman)"
                      value="@Html.ValueFor(model => model.Salesman)"
                      tabindex="1" required
                      class="easyui-textbox"
                      style="width:100%"
                      type="text"
                      data-options="prompt:'@Html.DescriptionFor(model => model.Salesman)',
								 required:true,
                                 validType: 'length[0,20]'
                                 " />
             </div>


             <!--公司-->
             <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"><span class="text-danger">*</span> @Html.DisplayNameFor(model => model.CompanyId)</label>
             <div class="col-md-4 mb-1 pl-1">
               <input id="@Html.IdFor(model => model.CompanyId)"
                      name="@Html.NameFor(model => model.CompanyId)"
                      value="@Html.ValueFor(model => model.CompanyId)"
                      tabindex="2" required
                      class="easyui-combobox"
                      style="width:100%"
                      data-options="prompt:'@Html.DescriptionFor(model => model.CompanyId)' ,
						            required:true ,
						            valueField: 'Id',
						            textField:  'Name' ,
                        panelHeight:'auto',
                        editable:false,
						            url: '/Companies/GetComboData' ,
						            onSelect: function(item){
						              $('#quotation_form #CompanyCode').val(item.Code)
                          $('#quotation_form #CompanyName').val(item.Name)
				        }">
             </div>



             <!--客户-->
             <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"><span class="text-danger">*</span> @Html.DisplayNameFor(model => model.CustomerId)</label>
             <div class="col-md-4 mb-1 pl-1">
               <input id="@Html.IdFor(model => model.CustomerId)"
                      name="@Html.NameFor(model => model.CustomerId)"
                      value="@Html.ValueFor(model => model.CustomerId)"
                      tabindex="5" required
                      class="easyui-combogrid"
                      style="width:100%"
                      data-options="prompt:'@Html.DescriptionFor(model => model.CustomerId)' ,
						              required:true ,
						              idField: 'Id',
						              textField:  'CustomerName' ,
                          panelHeight:'auto',
                          panelWidth:490,
                          editable:true,
                          method:'get',
                          mode: 'remote',
                          fitColumns:true,
                          pagination: true,
                           clientPaging:false,
                          pageList: [10, 20, 50, 100, 500],
						              url: '/Customers/GetCustomerComboGridData' ,
                          columns:[[
                           {field:'CustomerCode',title:'客户编码',width:90},
                           {field:'CustomerName',title:'客户名称',width:150}
                          ]],
						              onClickRow: function(index,item){
         						                  $('#quotation_form #CustomerCode').val(item.CustomerCode);
                              $('#quotation_form #CustomerName').val(item.CustomerName);
                              $('#quotation_form #Country').textbox('setValue',item.Country);
                              $('#quotation_form #ContactName').combobox('reload','/CustomerContacts/GetComboData?customerId=' + item.Id);
                              $('#quotation_form #ContactName').combobox('setValue',item.ContactName)
                              $('#quotation_form #ContactInfo').textbox('setValue',item.Telephone)
                       }">
             </div>





             <!--国家地区-->
             <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"> @Html.DisplayNameFor(model => model.Country)</label>
             <div class="col-md-4 mb-1 pl-1">
               <input id="@Html.IdFor(model => model.Country)"
                      name="@Html.NameFor(model => model.Country)"
                      value="@Html.ValueFor(model => model.Country)"
                      tabindex="8"
                      class="easyui-textbox"
                      style="width:100%"
                      type="text"
                      data-options="prompt:'@Html.DescriptionFor(model => model.Country)',
								 required:false,
                                 validType: 'length[0,50]'
                                 " />
             </div>
             <!--币种-->
             <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"> @Html.DisplayNameFor(model => model.Cur)</label>
             <div class="col-md-4 mb-1 pl-1">
               <div class="row">
                 <div class="col-md-6">
                   <input id="@Html.IdFor(model => model.Cur)"
                          name="@Html.NameFor(model => model.Cur)"
                          value="@Html.ValueFor(model => model.Cur)"
                          tabindex="15"
                          class="easyui-combobox"
                          style="width:100%"
                          type="text"
                          data-options="prompt:'@Html.DescriptionFor(model => model.Cur)',
								 required:false,data:curdatasource,panelHeight:'auto',
                                 validType: 'length[0,20]'
                                 " />
                  </div>
                   <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"><span class="text-danger">*</span> @Html.DisplayNameFor(model => model.ExchangeRate)</label>
                   <div class="col-md-4 mb-1 pl-1">
                     <input id="@Html.IdFor(model => model.ExchangeRate)"
                            name="@Html.NameFor(model => model.ExchangeRate)"
                            value="@Html.ValueFor(model => model.ExchangeRate)"
                            tabindex="16"
                            class="easyui-numberbox"
                            style="width:100%"
                            type="text"
                            data-options="prompt:'@Html.DescriptionFor(model => model.ExchangeRate)',
								 required:true,readonly:true,formatter:numberformatter,
                                 parser:parsernumber,precision:2,

                                 " />

                   </div>
                 </div>
               </div>
        


             <!--汇率-->
             
             <!--联系人-->
             <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"><span class="text-danger">*</span> @Html.DisplayNameFor(model => model.ContactName)</label>
             <div class="col-md-4 mb-1 pl-1">
               <input id="@Html.IdFor(model => model.ContactName)"
                      name="@Html.NameFor(model => model.ContactName)"
                      value="@Html.ValueFor(model => model.ContactName)"
                      tabindex="9" required
                      class="easyui-combobox"
                      style="width:100%"
                      type="text"
                      data-options="prompt:'@Html.DescriptionFor(model => model.ContactName)',
								 required:true,panelHeight:'auto',valueField:'Name',textField:'Name',
                                 validType: 'length[0,80]',
                     onSelect:function(item){
                                    $('#quotation_form #ContactInfo').textbox('setValue',item.PhoneNumber||item.Email)
                                 }
                                 " />
             </div>


             <!--联系方式-->
             <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"> @Html.DisplayNameFor(model => model.ContactInfo)</label>
             <div class="col-md-4 mb-1 pl-1">
               <input id="@Html.IdFor(model => model.ContactInfo)"
                      name="@Html.NameFor(model => model.ContactInfo)"
                      value="@Html.ValueFor(model => model.ContactInfo)"
                      tabindex="10"
                      class="easyui-textbox"
                      style="width:100%"
                      type="text"
                      data-options="prompt:'@Html.DescriptionFor(model => model.ContactInfo)',
								 required:false,
                                 validType: 'length[0,128]'
                                 " />
             </div>

             <!--报价日期-->
             <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"> @Html.DisplayNameFor(model => model.QuoteDate)</label>
             <div class="col-md-4 mb-1 pl-1">
               <input id="@Html.IdFor(model => model.QuoteDate)"
                      name="@Html.NameFor(model => model.QuoteDate)"
                      value="@Html.ValueFor(model => model.QuoteDate)"
                      tabindex="11"
                      class="easyui-datebox"
                      style="width:100%"
                      type="text"
                      data-options="prompt:'@Html.DescriptionFor(model => model.QuoteDate)',
								 required:false,
								 formatter:dateformatter" />
             </div>


             <!--有效日期-->
             <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"> @Html.DisplayNameFor(model => model.ExpiryDate)</label>
             <div class="col-md-4 mb-1 pl-1">
               <input id="@Html.IdFor(model => model.ExpiryDate)"
                      name="@Html.NameFor(model => model.ExpiryDate)"
                      value="@Html.ValueFor(model => model.ExpiryDate)"
                      tabindex="12"
                      class="easyui-datebox"
                      style="width:100%"
                      type="text"
                      data-options="prompt:'@Html.DescriptionFor(model => model.ExpiryDate)',
								 required:false,
								 formatter:dateformatter" />
             </div>

             <!--装货港-->
             <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"> @Html.DisplayNameFor(model => model.LoadingPort)</label>
             <div class="col-md-4 mb-1 pl-1">
               <input id="@Html.IdFor(model => model.LoadingPort)"
                      name="@Html.NameFor(model => model.LoadingPort)"
                      value="@Html.ValueFor(model => model.LoadingPort)"
                      tabindex="13"
                      class="easyui-combogrid"
                      style="width:100%"
                      type="text"
                      data-options="prompt:'@Html.DescriptionFor(model => model.LoadingPort)',
								          required:false ,
						              idField: 'code',
						              textField:  'cn_name' ,
                          panelHeight:'auto',
                          panelWidth:490,
                          editable:true,
                          method:'get',
                          mode: 'remote',
                          fitColumns:true,
                          pagination: true,
                           clientPaging:false,
                          pageList: [10, 20, 50, 100, 500],
						              url: '/GPorts/GetComboGridData' ,
                          columns:[[
                           {field:'code',title:'代码',width:80},
                           {field:'cn_name',title:'名称(中文)',width:150},
                           {field:'en_name',title:'名称(英文)',width:150}
                          ]],
                                 " />
             </div>


             <!--卸货港-->
             <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"> @Html.DisplayNameFor(model => model.DischargePort)</label>
             <div class="col-md-4 mb-1 pl-1">
               <input id="@Html.IdFor(model => model.DischargePort)"
                      name="@Html.NameFor(model => model.DischargePort)"
                      value="@Html.ValueFor(model => model.DischargePort)"
                      tabindex="14"
                      class="easyui-combogrid"
                      style="width:100%"
                      type="text"
                      data-options="prompt:'@Html.DescriptionFor(model => model.DischargePort)',
								          required:false ,
						              idField: 'code',
						              textField:  'cn_name' ,
                          panelHeight:'auto',
                          panelWidth:490,
                          editable:true,
                          method:'get',
                          mode: 'remote',
                          fitColumns:true,
                          pagination: true,
                           clientPaging:false,
                          pageList: [10, 20, 50, 100, 500],
						              url: '/GPorts/GetComboGridData' ,
                          columns:[[
                           {field:'code',title:'代码',width:80},
                           {field:'cn_name',title:'名称(中文)',width:150},
                           {field:'en_name',title:'名称(英文)',width:150}
                          ]],
                                 " />
             </div>



             <!--价格条款-->
             <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"> @Html.DisplayNameFor(model => model.PriceTerm)</label>
             <div class="col-md-4 mb-1 pl-1">
               <input id="@Html.IdFor(model => model.PriceTerm)"
                      name="@Html.NameFor(model => model.PriceTerm)"
                      value="@Html.ValueFor(model => model.PriceTerm)"
                      tabindex="17"
                      class="easyui-combobox"
                      style="width:100%"
                      type="text"
                      data-options="prompt:'@Html.DescriptionFor(model => model.PriceTerm)',
								 required:false,data:pricetermdatasource,panelHeight:'auto',
                                 validType: 'length[0,20]'
                                 " />
             </div>


             <!--付款条件-->
             <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"> @Html.DisplayNameFor(model => model.PayMode)</label>
             <div class="col-md-4 mb-1 pl-1">
               <input id="@Html.IdFor(model => model.PayMode)"
                      name="@Html.NameFor(model => model.PayMode)"
                      value="@Html.ValueFor(model => model.PayMode)"
                      tabindex="18"
                      class="easyui-combobox"
                      style="width:100%"
                      type="text"
                      data-options="prompt:'@Html.DescriptionFor(model => model.PayMode)',
								 required:false,data:paymodedatasource,panelHeight:'auto',
                                 validType: 'length[0,128]'
                                 " />
             </div>

             <!--货值金额-->
             <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"><span class="text-danger">*</span> @Html.DisplayNameFor(model => model.GoodsAmount)</label>
             <div class="col-md-4 mb-1 pl-1">
               <input id="@Html.IdFor(model => model.GoodsAmount)"
                      name="@Html.NameFor(model => model.GoodsAmount)"
                      value="@Html.ValueFor(model => model.GoodsAmount)"
                      tabindex="19"
                      class="easyui-numberbox"
                      style="width:100%"
                      type="text"
                      data-options="prompt:'@Html.DescriptionFor(model => model.GoodsAmount)',
								 required:true,formatter:numberformatter,readonly:true,
                                 parser:parsernumber,precision:2,

                                 " />

             </div>


             <!--附加费-->
             <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"><span class="text-danger">*</span> @Html.DisplayNameFor(model => model.ChargeAmount)</label>
             <div class="col-md-4 mb-1 pl-1">
               <input id="@Html.IdFor(model => model.ChargeAmount)"
                      name="@Html.NameFor(model => model.ChargeAmount)"
                      value="@Html.ValueFor(model => model.ChargeAmount)"
                      tabindex="20"
                      class="easyui-numberbox"
                      style="width:100%"
                      type="text"
                      data-options="prompt:'@Html.DescriptionFor(model => model.ChargeAmount)',
								 required:true,formatter:numberformatter,readonly:true,
                                 parser:parsernumber,precision:2,

                                 " />

             </div>

             <!--总费用-->
             <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"><span class="text-danger">*</span> @Html.DisplayNameFor(model => model.TotalAmount)</label>
             <div class="col-md-4 mb-1 pl-1">
               <input id="@Html.IdFor(model => model.TotalAmount)"
                      name="@Html.NameFor(model => model.TotalAmount)"
                      value="@Html.ValueFor(model => model.TotalAmount)"
                      tabindex="21"
                      class="easyui-numberbox"
                      style="width:100%"
                      type="text"
                      data-options="prompt:'@Html.DescriptionFor(model => model.TotalAmount)',
								 required:true,formatter:numberformatter,readonly:true,
                                 parser:parsernumber,precision:2,

                                 " />

             </div>




             <!--备注-->
             <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"> @Html.DisplayNameFor(model => model.Remark)</label>
             <div class="col-md-4 mb-1 pl-1">
               <input id="@Html.IdFor(model => model.Remark)"
                      name="@Html.NameFor(model => model.Remark)"
                      value="@Html.ValueFor(model => model.Remark)"
                      tabindex="23"
                      class="easyui-textbox"
                      style="width:100%"
                      type="text"
                      data-options="prompt:'@Html.DescriptionFor(model => model.Remark)',
								 required:false,
                                 validType: 'length[0,256]'
                                 " />
             </div>
             <div style="display:none">

               <!--询价单号-->
               <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"> @Html.DisplayNameFor(model => model.InquiryNo)</label>
               <div class="col-md-4 mb-1 pl-1">
                 <input id="@Html.IdFor(model => model.InquiryNo)"
                        name="@Html.NameFor(model => model.InquiryNo)"
                        value="@Html.ValueFor(model => model.InquiryNo)"
                        tabindex="24"
                        class="easyui-textbox"
                        style="width:100%"
                        type="text"
                        data-options="prompt:'@Html.DescriptionFor(model => model.InquiryNo)',
								 required:false,
                                 validType: 'length[0,20]'
                                 " />
               </div>

               <!--任务单号-->
               <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"> @Html.DisplayNameFor(model => model.TaskNo)</label>
               <div class="col-md-4 mb-1 pl-1">
                 <input id="@Html.IdFor(model => model.TaskNo)"
                        name="@Html.NameFor(model => model.TaskNo)"
                        value="@Html.ValueFor(model => model.TaskNo)"
                        tabindex="25"
                        class="easyui-textbox"
                        style="width:100%"
                        type="text"
                        data-options="prompt:'@Html.DescriptionFor(model => model.TaskNo)',
								 required:false,
                                 validType: 'length[0,20]'
                                 " />
               </div>


               <!--系统版本号-->
               <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"><span class="text-danger">*</span> @Html.DisplayNameFor(model => model.Ver)</label>
               <div class="col-md-4 mb-1 pl-1">
                 <input id="@Html.IdFor(model => model.Ver)"
                        name="@Html.NameFor(model => model.Ver)"
                        value="@Html.ValueFor(model => model.Ver)"
                        tabindex="26"
                        class="easyui-numberbox"
                        style="width:100%"
                        type="text"
                        data-options="prompt:'@Html.DescriptionFor(model => model.Ver)',
								 required:true,formatter:intformatter,
                                 parser:parsernumber,
                                 " />
               </div>

               <!--发起人-->
               <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"> @Html.DisplayNameFor(model => model.Initiator)</label>
               <div class="col-md-4 mb-1 pl-1">
                 <input id="@Html.IdFor(model => model.Initiator)"
                        name="@Html.NameFor(model => model.Initiator)"
                        value="@Html.ValueFor(model => model.Initiator)"
                        tabindex="27"
                        class="easyui-textbox"
                        style="width:100%"
                        type="text"
                        data-options="prompt:'@Html.DescriptionFor(model => model.Initiator)',
								 required:false,
                                 validType: 'length[0,32]'
                                 " />
               </div>


               <!--提交时间-->
               <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"> @Html.DisplayNameFor(model => model.SubmitDate)</label>
               <div class="col-md-4 mb-1 pl-1">
                 <input id="@Html.IdFor(model => model.SubmitDate)"
                        name="@Html.NameFor(model => model.SubmitDate)"
                        value="@Html.ValueFor(model => model.SubmitDate)"
                        tabindex="28"
                        class="easyui-datebox"
                        style="width:100%"
                        type="text"
                        data-options="prompt:'@Html.DescriptionFor(model => model.SubmitDate)',
								 required:false,
								 formatter:dateformatter" />
               </div>

               <!--待审人-->
               <label class="col-md-2  pt-1 pl-0 pr-0 form-label text-right"> @Html.DisplayNameFor(model => model.ToAuditor)</label>
